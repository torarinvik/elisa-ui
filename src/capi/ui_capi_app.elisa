# The C APP adapter.
#
# A backend calls the Elisa app contract (app_init / app_event / app_frame /
# app_widget_event). A C app cannot implement `app_event`, whose parameter is a
# sealed hierarchy. This file supplies the contract and forwards each call to a
# C-visible callback, flattening the event on the way -- so a C app implements
# `elisa_ui_on_event` and never sees an Elisa type.
#
# Link this INSTEAD of writing an Elisa app, together with a backend. See
# include/elisa_ui.h for the callbacks to implement.
#
# NAMESPACES. The same split every backend in this library makes. Two kinds of
# name are dictated by the linker and cannot be qualified: the `extern`s below,
# which are C symbols and global by nature, and the six `app_*` functions,
# which a backend calls bare because ui_core.elisa declares them that way. A
# module prefix on either would only pretend to a scoping the ABI does not have.
# Everything that is CODE rather than a dictated name lives in `UiCapiApp`, and
# the six contract functions are one delegating call each.

include "../core/ui_core.elisa"
include "./ui_capi_widget.elisa"

# The C app's half. `EventRecord&` is a borrow, so C sees `const elisa_ui_event *`.
extern elisa_ui_on_init() -> void
extern elisa_ui_on_event(event: UiCore::EventRecord&) -> void
extern elisa_ui_on_text_input(text: cstr, length: usize) -> void
extern elisa_ui_on_text_editing(text: cstr, length: usize, selected_start: i32, selected_length: i32) -> void
extern elisa_ui_on_frame() -> void
extern elisa_ui_on_widget_event(widget: u64, event: i32) -> void

# The forwarding, named for the C callbacks it reaches. Public rather than
# private because the shims below are top-level and therefore outside this
# module; an Elisa app that wants to hand a single event to a C layer can call
# them directly for the same reason.
module UiCapiApp:
    public:
        def on_init() -> void:
            elisa_ui_on_init()

        # The record is a local, so its address is this frame's: the callback must
        # not retain it. That matches the C signature, which takes it `const *`
        # for the duration of the call.
        def on_event(event: UiCore::Event) -> void:
            record: mutable UiCore::EventRecord = UiCore::to_record(event)
            elisa_ui_on_event(record)

        def on_text_input(text: sview) -> void:
            # Text views may originate at another backend's counted ABI. Bound
            # the signed extent before converting it to C's size_t so a
            # malformed negative or oversized view cannot wrap at this seam.
            safe_text: sview = UiCore::bounded_text(text)
            pointer: cstr = safe_text.data.cast[cstr] can Unsafe.PointerCast
            elisa_ui_on_text_input(pointer, safe_text.len.usize())

        def on_text_editing(text: sview, selected_start: i32, selected_length: i32) -> void:
            safe_text: sview = UiCore::bounded_text(text)
            pointer: cstr = safe_text.data.cast[cstr] can Unsafe.PointerCast
            # Keep the marked range inside the same bounded view that crosses
            # the C boundary. A hostile native backend can provide negative or
            # oversized offsets; forwarding them unchanged would make the C
            # app interpret a range that cannot exist in `safe_text`.
            # The public C contract uses UTF-8 scalar offsets for composition;
            # bound against the number of encoded scalars rather than the
            # number of bytes in the borrowed payload.
            limit: i32 = UiText::utf8_scalar_count(safe_text).i32()
            safe_start: mutable i32 = selected_start if selected_start > 0 else 0
            safe_start <- limit if safe_start > limit else safe_start
            remaining: i32 = limit - safe_start
            safe_length: mutable i32 = selected_length if selected_length > 0 else 0
            safe_length <- remaining if safe_length > remaining else safe_length
            elisa_ui_on_text_editing(pointer, safe_text.len.usize(), safe_start, safe_length)

        def on_frame() -> void:
            elisa_ui_on_frame()

        def on_widget_event(widget: usize, code: i32) -> void:
            # Convert the compatibility layer's internal slot exactly once.
            # The C callback receives an opaque generation-scoped token, never
            # a retained-arena index that could be mistaken for a stable ABI.
            elisa_ui_on_widget_event(UiCapiWidget::token_for_index(widget), code)

# The application half of the contract from ui_core.elisa. Top-level by name,
# like the platform half in each backend, and delegating into the module.
def app_init() -> void:
    UiCapiApp::on_init()

def app_event(event: UiCore::Event) -> void:
    UiCapiApp::on_event(event)

def app_text_input(text: sview) -> void:
    UiCapiApp::on_text_input(text)

def app_text_editing(text: sview, selected_start: i32, selected_length: i32) -> void:
    UiCapiApp::on_text_editing(text, selected_start, selected_length)

def app_frame() -> void:
    UiCapiApp::on_frame()

def app_widget_event(widget: usize, event: i32) -> void:
    UiCapiApp::on_widget_event(widget, event)
