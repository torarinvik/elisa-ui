# The C boundary.
#
# C has no variants, so a C host meets the library at `UiCore::EventRecord` -- a
# POD struct of six scalars whose `kind` is the published wire ordinal. These
# entry points are TOP-LEVEL on purpose: a module member's symbol carries its
# module, while a bare `def` is the plain C name a header can declare.
#
# Nothing here is a second event model. It is one call each way over the
# conversions in UiCore, so the ordinal encoding stays written down in exactly
# one place and a kind added to the hierarchy reaches C without touching this
# file.
#
# NAMESPACES. Every name a C program links against is dictated, so the public
# ABI functions stay top-level. `UiCapi` owns the event conversion; viewport
# accessors forward directly to `UiCore`. The counted text entry point also
# stays top-level because its Elisa-owned copy must be adjacent to the C ABI
# boundary and must never construct a view directly from foreign memory.
#
# A C header for this is:
#
#   typedef struct { int32_t kind; float x, y, dx, dy; int32_t code; } elisa_ui_event;
#   void elisa_ui_dispatch_event(int32_t kind, float x, float y,
#                                float dx, float dy, int32_t code);
#   void elisa_ui_dispatch_text_input(const char *text, size_t length);
#   void elisa_ui_dispatch_text_editing(const char *text, size_t length,
#                                       int32_t selected_start,
#                                       int32_t selected_length);
#   void elisa_ui_set_viewport(float width, float height);
#   float elisa_ui_viewport_width(void);
#   float elisa_ui_viewport_height(void);

include "../core/ui_core.elisa"
include "../core/ui_lifecycle.elisa"

module UiCapi:
    public:
        # The C header exposes this packed tuple so an embedding can reject a
        # mismatched library before sending events. Version arithmetic is kept
        # in Elisa beside the actual boundary, not duplicated in a C shim.
        const ABI_VERSION_MAJOR: u32 = 1
        const ABI_VERSION_MINOR: u32 = 0
        const ABI_VERSION_PATCH: u32 = 0

        def abi_version() -> u32:
            return (ABI_VERSION_MAJOR << 16) | (ABI_VERSION_MINOR << 8) | ABI_VERSION_PATCH

        # Deliver one event from a C host. The scalars are the EventRecord fields;
        # an ordinal this library does not model arrives as `Event.None`, which an
        # app ignores, rather than as a trap.
        def dispatch_event(kind: i32, x: f32, y: f32, dx: f32, dy: f32, code: i32) -> void:
            # Pointer coordinates and wheel deltas are physical input facts.
            # Do not let the core's value-level sanitizers turn a malformed C
            # payload into a real hit at the origin; native backends apply the
            # same fail-closed rule before they construct a typed event.
            pointer_kind: bool = kind == UiCore::WireKind.PointerMove.i32() or kind == UiCore::WireKind.PointerDown.i32() or kind == UiCore::WireKind.PointerUp.i32() or kind == UiCore::WireKind.Scroll.i32()
            return if pointer_kind and (not UiCore::is_finite(x) or not UiCore::is_finite(y) or (kind == UiCore::WireKind.Scroll.i32() and (not UiCore::is_finite(dx) or not UiCore::is_finite(dy))))
            record: UiCore::EventRecord = UiCore::EventRecord{kind: UiCore::WireKind(kind), x: x, y: y, dx: dx, dy: dy, code: code}
            return if not UiEvents::enqueue(UiCore::from_record(record))
            # Event payloads are copied into the bounded queue, so a callback
            # may safely submit a synthetic event. Keep that event for the
            # current outer drain instead of recursively entering app_event;
            # an app that chains callbacks can therefore not grow the native
            # stack without bound.
            return if elisa_ui_event_dispatch_active
            elisa_ui_event_dispatch_active <- true
            # A callback may stop the current owner or begin a replacement
            # session before returning. Capture the session identity at drain
            # start so queued events cannot cross that lifecycle boundary.
            # The phase-New case remains usable for embedders that use this
            # pure C adapter without a lifecycle owner. Once a session has
            # stopped, however, late callbacks must be discarded just like
            # callbacks from any other dead owner; only the explicit New
            # compatibility mode may dispatch without a live lifecycle.
            allow_unowned_dispatch: bool = UiLifecycle::phase() == UiLifecycle::Phase.New
            drain_generation: u32 = UiLifecycle::generation()
            event: mutable UiCore::Event = UiCore::Event.None
            while UiEvents::dequeue(event):
                continue if UiLifecycle::generation() != drain_generation
                if not allow_unowned_dispatch:
                    continue if not UiLifecycle::is_started()
                    continue if UiCore::is_input_event(event) and not UiLifecycle::accepts_input()
                app_event(event)
            elisa_ui_event_dispatch_active <- false

    private:
        global mutable elisa_ui_event_dispatch_active: bool = false

include "./ui_capi_text.elisa"

# The C entry points. Top-level by name, each one a single call.
def elisa_ui_dispatch_event(kind: i32, x: f32, y: f32, dx: f32, dy: f32, code: i32) -> void:
    UiCapi::dispatch_event(kind, x, y, dx, dy, code)

def elisa_ui_abi_version() -> u32:
    return UiCapi::abi_version()

# The C entry point receives a counted pointer, which is not required to be
# NUL-terminated. Copy only the validated bounded prefix into Elisa-owned
# storage so neither view construction nor the callback boundary can retain a
# foreign pointer.
def elisa_ui_dispatch_text_input(text: cstr?, length: usize) -> void can Unsafe.PointerCast:
    UiCapi::dispatch_text_input(text, length)

def elisa_ui_dispatch_text_editing(text: cstr?, length: usize, selected_start: i32, selected_length: i32) -> void can Unsafe.PointerCast:
    UiCapi::dispatch_text_editing(text, length, selected_start, selected_length)

# The viewport, for a C host that owns the window. State lives in UiCore, so
# these reach it directly.
def elisa_ui_set_viewport(width: f32, height: f32) -> void:
    UiCore::set_viewport(width, height)

def elisa_ui_viewport_width() -> f32:
    return UiCore::viewport_width()

def elisa_ui_viewport_height() -> f32:
    return UiCore::viewport_height()
