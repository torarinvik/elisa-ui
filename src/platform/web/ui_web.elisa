# elisa-ui web backend: the drawing contract is imported from the JS host
# (WASM `env` imports — the generated loader lets the page override them).
# The host drives the loop: it calls the exported ui_init/ui_frame/ui_pointer
# entry points (see examples/*/web_main.elisa), so unlike the SDL3 backend
# there is no ui_run here.

include "../../core/ui_core.elisa"

extern ui_host_clear(r: u8, g: u8, b: u8, a: u8) -> void
extern ui_host_fill_rect(x: f32, y: f32, w: f32, h: f32, r: u8, g: u8, b: u8, a: u8) -> void

def ui_clear(r: u8, g: u8, b: u8, a: u8) -> void:
    ui_host_clear(r, g, b, a)

def ui_fill_rect(x: f32, y: f32, w: f32, h: f32, r: u8, g: u8, b: u8, a: u8) -> void:
    ui_host_fill_rect(x, y, w, h, r, g, b, a)
