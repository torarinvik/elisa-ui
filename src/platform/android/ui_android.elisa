# The Android backend: the Skia painter behind a NativeActivity.
#
# Android has no CoreGraphics and no view that paints itself, so the picture
# is made the way the headless fixtures make it: the host locks the window's
# buffer, wraps it in a Skia surface, and the retained command list is
# replayed onto it by the same UiSkia painter every Skia frame in this
# repository goes through. Nothing below is appearance: every alpha, radius
# and ramp comes from UiPaint, exactly as on every other backend.
#
# The host is C++ (android_skia_host.cpp) and owns the window, the input
# queue, the looper and the fonts. It calls the entry points at the foot of
# this file and nothing else; the application is reached only through the
# app_* hooks, as on iOS and macOS. Coordinates cross this boundary in
# logical points -- the host divides by the density scale before calling.

include "../skia/ui_skia.elisa"
include "../mobile/ui_mobile_surface.elisa"
# The same include the UIKit flat adapter takes, and for the same reason: the
# keyboard follows the retained focus, and only the widget layer knows where
# that is.
include "../../widgets/ui_handles.elisa"

# The text metric hooks a retained layout asks its painter for.
def ui_measure_text_width(text: sview, size: f32, weighted: bool) -> f32:
    return UiSkia::active_measure_text_width(text, size, weighted)

def ui_measure_text_height(text: sview, size: f32) -> f32:
    return UiSkia::active_text_line_height(size)

def ui_font_ascent(size: f32) -> f32:
    return UiSkia::active_font_ascent(size)

def ui_text_line_height(size: f32) -> f32:
    return UiSkia::active_text_line_height(size)

# No clipboard yet: a NativeActivity reaches the system clipboard only
# through JNI, and nothing this backend runs asks for it.
def ui_clipboard_has_text() -> bool:
    return false

def ui_clipboard_write(bytes: u8&, length: usize) -> bool:
    return false

def ui_clipboard_read(buffer: mutable u8&, capacity: usize) -> usize:
    return 0

module UiAndroid:
    private:
        global mutable android_started: bool = false
        # Touch phases, as the host reports them. Tokens match the UIKit
        # callback so the two mobile hosts read the same.
        const TOUCH_DOWN: i32 = 0
        const TOUCH_MOVE: i32 = 1
        const TOUCH_UP: i32 = 2
        const TOUCH_CANCEL: i32 = 3
        # The portable mobile lifecycle vocabulary, numbered as the UIKit
        # backend numbers its signals, because it is the same vocabulary.
        const FOCUS_GAINED: i32 = 0
        const FOCUS_LOST: i32 = 1
        const BACKGROUND: i32 = 2
        const FOREGROUND: i32 = 3
        const SURFACE_LOST: i32 = 4
        const SURFACE_RESTORED: i32 = 5
        # Committed text crosses as ONE CODE POINT, which is what an Android
        # key event yields, and is encoded to UTF-8 here. Nothing on this side
        # has to trust a host's buffer or cast a pointer for a keystroke.
        global mutable android_text_bytes: u8[4] = zeroed

        # The system bars are edges the page must keep clear of, and on a
        # phone that is edge to edge they lie over the window. The insets
        # become content insets the layout keeps its children inside of.
        def publish_content_insets() -> bool:
            snapshot: UiMobileSurface::Snapshot = UiMobileSurface::snapshot()
            area: UiResponsive::ContentArea = snapshot.content
            viewport: UiResponsive::Viewport = snapshot.viewport
            top: f32 = area.origin.y
            left: f32 = area.origin.x
            right: f32 = viewport.width - left - area.size.width
            bottom: f32 = viewport.height - top - area.size.height
            return UiCore::set_content_insets(top, UiCore::nonnegative_extent(right), UiCore::nonnegative_extent(bottom), left)

        def dispatch(event: UiCore::Event) -> void can[Ui.Input]:
            return if not android_started or not UiLifecycle::accepts_input()
            app_event(event)

    public:
        def live() -> bool:
            return android_started and UiLifecycle::is_started()

        # Called once the host has a window with a real size. The lifecycle
        # transition completes before the application is initialised, so the
        # tree is built against a viewport that exists -- which is what lets
        # a composition choose its phone form.
        def start(width: f32, height: f32, scale: f32, safe: UiResponsive::Insets) -> bool:
            can Ui.Window, Ui.Draw, Ui.Text, Ui.Input, Unsafe.PointerCast:
                return false if android_started
                return false if not UiMobileSurface::start(width, height, scale, safe)
                UiCapabilities::use_appkit_canvas()
                _ = UiCapabilities::select_skia_renderer()
                UiCore::set_viewport(width, height)
                _ = publish_content_insets()
                android_started <- true
                app_init()
                return true

        # FOCUS IS NOT COSMETIC. UiLifecycle takes input only while the phase
        # is Active, a session that has started is Active only if it was told
        # it has focus, and `begin` clears the flag -- so a host that never
        # says this paints a perfect window that answers no touch at all.
        # That was the Android backend until this existed.
        def lifecycle(signal: i32) -> bool:
            return false if not android_started
            return UiMobileSurface::focus_gained() if signal == FOCUS_GAINED
            return UiMobileSurface::focus_lost() if signal == FOCUS_LOST
            return UiMobileSurface::background() if signal == BACKGROUND
            return UiMobileSurface::foreground() if signal == FOREGROUND
            return UiMobileSurface::surface_lost() if signal == SURFACE_LOST
            return UiMobileSurface::surface_restored() if signal == SURFACE_RESTORED
            return false

        def resize(width: f32, height: f32, scale: f32, safe: UiResponsive::Insets) -> bool:
            return false if not android_started
            return false if not UiMobileSurface::resize(width, height, scale)
            _ = UiMobileSurface::set_safe_area(safe)
            UiCore::set_viewport(width, height)
            return publish_content_insets()

        def stop() -> void:
            return if not android_started
            android_started <- false
            UiMobileSurface::reset()

        # One frame onto a Skia canvas the host wrapped around the window's
        # buffer. The shape is the headless fixture's: a deferred frame, the
        # application's paint, then the replay through the painter at the
        # backing scale.
        def render(canvas: usize, font: usize, width: f32, height: f32, scale: f32) -> i32:
            can Ui.Draw, Ui.Text, Ui.Input, Unsafe.PointerCast:
                return UiSkia::RenderStatus.SkippedNoSurface.i32() if not android_started or canvas == 0
                previous_font: usize = UiSkia::begin_frame_font(font)
                _ = UiTextMetrics::set_context(UiSkia::font_generation(), UiSkia::scale_generation())
                UiCore::set_viewport(width, height)
                UiSkia::begin_deferred_frame()
                UiCore::begin_frame()
                app_frame()
                UiSkia::attach_scaled(canvas, scale)
                status: UiSkia::RenderStatus = UiSkia::render_status_with_font(font)
                UiSkia::detach()
                UiSkia::end_deferred_frame()
                UiSkia::end_frame_font(previous_font)
                return status.i32()

        # A touch is the pointer. A press supplies the move a mouse would have
        # delivered first, so a control sees the pointer arrive before the
        # press; a cancel releases without activating.
        def touch(phase: i32, x: f32, y: f32) -> void can[Ui.Input]:
            return if not UiCore::is_finite(x) or not UiCore::is_finite(y)
            at: UiCore::Vec2 = UiCore::Vec2(x, y)
            if phase == TOUCH_DOWN:
                dispatch(UiCore::PointerEvent.Move(at: at))
                dispatch(UiCore::PointerEvent.Down(at: at, button: UiCore::PointerButton.Primary.i32()))
                return
            if phase == TOUCH_MOVE:
                dispatch(UiCore::PointerEvent.Move(at: at))
                return
            if phase == TOUCH_UP:
                dispatch(UiCore::PointerEvent.Up(at: at, button: UiCore::PointerButton.Primary.i32()))
                return
            dispatch(UiCore::PointerEvent.Leave) if phase == TOUCH_CANCEL

        # A key in the framework's own vocabulary. The host maps Android's
        # numbering, so nothing about Android's keycodes crosses this line.
        def key(code: i32, down: bool) -> void can[Ui.Input]:
            return if not UiCore::key_is_valid(code)
            dispatch((UiCore::KeyEvent.Down(code: code.Key())) if down else (UiCore::KeyEvent.Up(code: code.Key())))

        def text(scalar: u32) -> void can[Ui.Input]:
            return if not android_started or not UiLifecycle::accepts_input()
            return if scalar == 0 or scalar > 1114111
            # A surrogate is not a character, and a host that hands one over
            # has already lost the pair it belonged to.
            return if scalar >= 55296 and scalar <= 57343
            length: mutable usize = 4
            if scalar < 128:
                length <- 1
                android_text_bytes[0] <- scalar.u8()
            elif scalar < 2048:
                length <- 2
                android_text_bytes[0] <- (192 | (scalar >> 6)).u8()
                android_text_bytes[1] <- (128 | (scalar & 63)).u8()
            elif scalar < 65536:
                length <- 3
                android_text_bytes[0] <- (224 | (scalar >> 12)).u8()
                android_text_bytes[1] <- (128 | ((scalar >> 6) & 63)).u8()
                android_text_bytes[2] <- (128 | (scalar & 63)).u8()
            else:
                android_text_bytes[0] <- (240 | (scalar >> 18)).u8()
                android_text_bytes[1] <- (128 | ((scalar >> 12) & 63)).u8()
                android_text_bytes[2] <- (128 | ((scalar >> 6) & 63)).u8()
                android_text_bytes[3] <- (128 | (scalar & 63)).u8()
            UiFlat::insert_text(sview(&android_text_bytes[0], 0, length.i64()))

        # Whether the focused widget wants a keyboard. The host raises and
        # lowers the on-screen one from this and from nothing else: the
        # retained focus is the only thing that knows.
        def wants_keyboard() -> bool:
            return android_started and UiFlat::accepts_text()

        def scroll(x: f32, y: f32, dx: f32, dy: f32) -> void can[Ui.Input]:
            return if not UiCore::is_finite(x) or not UiCore::is_finite(y) or not UiCore::is_finite(dx) or not UiCore::is_finite(dy)
            dispatch(UiCore::PointerEvent.Scroll(at: UiCore::Vec2(x, y), delta: UiCore::Vec2(dx, dy)))

def android_start(width: f32, height: f32, scale: f32, top: f32, right: f32, bottom: f32, left: f32) -> i32:
    can Ui.Window, Ui.Draw, Ui.Text, Ui.Input, Unsafe.PointerCast:
        return 1 if UiAndroid::start(width, height, scale, UiResponsive::insets(top, right, bottom, left)) else 0

def android_resize(width: f32, height: f32, scale: f32, top: f32, right: f32, bottom: f32, left: f32) -> i32:
    return 1 if UiAndroid::resize(width, height, scale, UiResponsive::insets(top, right, bottom, left)) else 0

def android_stop() -> void:
    UiAndroid::stop()

def android_lifecycle(signal: i32) -> i32:
    return 1 if UiAndroid::lifecycle(signal) else 0

def android_render(canvas: usize, font: usize, width: f32, height: f32, scale: f32) -> i32:
    can Ui.Draw, Ui.Text, Ui.Input, Unsafe.PointerCast:
        return UiAndroid::render(canvas, font, width, height, scale)

# Seconds until the frame just drawn wants the next one; zero is idle.
def android_frame_delay() -> f32:
    return UiCore::frame_delay()

def android_touch(phase: i32, x: f32, y: f32) -> void:
    can Ui.Input:
        UiAndroid::touch(phase, x, y)

def android_scroll(x: f32, y: f32, dx: f32, dy: f32) -> void:
    can Ui.Input:
        UiAndroid::scroll(x, y, dx, dy)

def android_key(code: i32, down: i32) -> void:
    can Ui.Input:
        UiAndroid::key(code, down != 0)

def android_text(scalar: u32) -> void:
    can Ui.Input:
        UiAndroid::text(scalar)

def android_wants_keyboard() -> i32:
    return 1 if UiAndroid::wants_keyboard() else 0

export fn elisa_android_start(width: f32, height: f32, scale: f32, top: f32, right: f32, bottom: f32, left: f32) -> i32 = android_start
export fn elisa_android_resize(width: f32, height: f32, scale: f32, top: f32, right: f32, bottom: f32, left: f32) -> i32 = android_resize
export fn elisa_android_stop() -> void = android_stop
export fn elisa_android_lifecycle(signal: i32) -> i32 = android_lifecycle
export fn elisa_android_render(canvas: usize, font: usize, width: f32, height: f32, scale: f32) -> i32 = android_render
export fn elisa_android_frame_delay() -> f32 = android_frame_delay
export fn elisa_android_touch(phase: i32, x: f32, y: f32) -> void = android_touch
export fn elisa_android_scroll(x: f32, y: f32, dx: f32, dy: f32) -> void = android_scroll
export fn elisa_android_key(code: i32, down: i32) -> void = android_key
export fn elisa_android_text(scalar: u32) -> void = android_text
export fn elisa_android_wants_keyboard() -> i32 = android_wants_keyboard
