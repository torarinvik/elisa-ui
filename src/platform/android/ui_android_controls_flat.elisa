# The retained layer, on Android, as real android.widget views.
#
# The sibling of the iOS file of the same shape, and for the same reason: the
# controls seam has two application layers, a program links one of them, and
# the compiler declines a unit holding both. This is the half that knows the
# retained tree -- the one every application in this repository builds, and
# the one the Skia backend paints.

include "./ui_android_controls.elisa"
include "../../widgets/ui_controls_flat.elisa"

extend UiAndroidControls:
    public:
        # THE PLATFORM'S MINIMUMS, BEFORE THE LAYOUT RUNS.
        #
        # An application declares how big its controls are in the terms of the
        # backend it was written for, and this one was written for a painted
        # canvas: a thirty-two point button is a perfectly good button to
        # draw. Android builds a Button larger than that, with the padding and
        # the touch target its own guidelines ask for, and a widget given less
        # room than it needs does not shrink -- it clips its own words.
        #
        # So the platform's answer is raised into the layout's own numbers
        # before it runs. Only ever raised: an application that already asks
        # for more than Android's minimum keeps what it asked for.
        def apply_platform_minimums() -> void:
            can[Ui.Controls]:
                for index in 0..<UiFlat::count():
                    kind: UiControls::ControlKind = UiControls::retained_control_kind(index)
                    continue if kind == UiControls::ControlKind.Panel or kind == UiControls::ControlKind.ScrollView or kind == UiControls::ControlKind.Window
                    wanted: f32 = minimum_height(kind)
                    continue if wanted <= 0.0
                    node: UiFlat::Widget = UiFlat::widget(index)
                    continue if node.declared_min_height >= wanted
                    UiFlat::set_min_size(index, node.declared_min_width, wanted)

        def realize_retained() -> void:
            can[Ui.Controls]:
                remember_focus()
                # The iOS file of this shape carries the reasoning: the
                # retained path keeps the controls that did not change rather
                # than tearing the whole interface down for every event.
                UiControls::begin_reconcile()
                UiControls::realize_retained()
                UiControls::adopt_unchanged()
                discard_unadopted()
                UiControls::apply[AndroidControls]()
                finish_realize()
                restore_focus()

        # The retained control arena copies this view synchronously. Keep the
        # borrowed JNI text only for dispatch, and scrub even stale callbacks.
        def dispatch_native_text(handle: i32, text: cstr, length: i32) -> i32 can[Memory.Allocate, Abort.Panic, Ui.Controls, Unsafe.PointerCast, Ui.Window, Ui.Draw, Ui.Text, Ui.Input]:
            result: i32 = UiControls::NO_PARENT
            if handle > 0:
                copied: sview = copy_native_text(text, length)
                result <- UiControls::dispatch_native_text(handle.usize(), copied)
            clear_native_text_staging()
            return result

        # Release exactly what the new list did not adopt, children first.
        def discard_unadopted() -> void can[Ui.Controls]:
            count: usize = UiControls::discarded_count()
            index: mutable usize = count
            for _ in 0..<count:
                index <- index - 1
                handle: usize = UiControls::discarded_handle_at(index)
                continue if handle == 0
                elisa_android_controls_release(handle.i32())

    private:
        # FOCUS OUTLIVES THE INTERFACE THAT HELD IT. The iOS file of this shape
        # carries the reasoning; the policy is the same one and only the two
        # platform calls differ. The remembered identity is the retained
        # WIDGET, because a control index belongs to one realization.
        global mutable android_focus_widget: usize = 0
        global mutable android_focus_known: bool = false
        global mutable android_focus_caret: i32 = 0

        def remember_focus() -> void can[Ui.Controls]:
            android_focus_known <- false
            for slot in 0..<UiControls::count():
                continue if UiControls::kind_at(slot) != UiControls::ControlKind.TextField
                handle: i32 = UiAndroidControls::native_handle(slot.i32())
                continue if handle == 0
                continue if elisa_android_controls_is_focused(handle) == 0
                widget: usize = UiControls::retained_index_at(slot)
                continue if widget >= UiFlat::count()
                android_focus_widget <- widget
                android_focus_caret <- elisa_android_controls_caret(handle)
                android_focus_known <- true
                return

        def restore_focus() -> void can[Ui.Controls]:
            return if not android_focus_known
            android_focus_known <- false
            for slot in 0..<UiControls::count():
                continue if UiControls::retained_index_at(slot) != android_focus_widget
                handle: i32 = UiAndroidControls::native_handle(slot.i32())
                return if handle == 0
                # ALREADY THERE IS NOT A MOVE. Reconciliation usually adopts
                # the field being typed into, so it never lost focus -- and
                # putting focus back on a control that has it is not free:
                # Android's restartInput tears the IME's connection down and
                # builds it again, mid-word, on every keystroke. Ask first.
                return if elisa_android_controls_is_focused(handle) != 0
                elisa_android_controls_focus(handle, android_focus_caret)
                return

# The Activity's own moments, and a control's. Each is one call from Java, and
# the application's entry point decides what happens next -- which is the same
# contract every other backend here offers.
def android_controls_start(width: f32, height: f32) -> i32:
    can Memory.Allocate, Abort.Panic, Ui.Controls, Unsafe.PointerCast, Ui.Window, Ui.Draw, Ui.Text, Ui.Input:
        return 0 if not UiAndroidControls::set_surface(width, height)
        UiCapabilities::use_android_controls()
        app_controls_realize()
        return 1

def android_controls_resize(width: f32, height: f32) -> void:
    can Memory.Allocate, Abort.Panic, Ui.Controls, Unsafe.PointerCast, Ui.Window, Ui.Draw, Ui.Text, Ui.Input:
        return if not UiAndroidControls::live()
        return if not UiAndroidControls::set_surface(width, height)
        app_controls_realize()

def android_controls_stop() -> void:
    can Ui.Controls:
        UiAndroidControls::stop()

# A view reported something. The seam resolves the handle back to the control
# index, records the new value, and calls the application -- the same path
# every other native backend's action callback takes.
def android_controls_event(handle: i32, event: i32, value: f32, selected: i32) -> void:
    can Memory.Allocate, Abort.Panic, Ui.Controls, Unsafe.PointerCast, Ui.Window, Ui.Draw, Ui.Text, Ui.Input:
        return if handle <= 0
        kind: UiConst::WidgetEvent = UiConst::WidgetEvent.Change if event == UiConst::WidgetEvent.Change.i32() else UiConst::WidgetEvent.Click
        _ = UiControls::dispatch_native_action(handle.usize(), kind, value, selected != 0)

# A field reported what it now holds. The text takes a channel of its own: the
# numeric event carries a value and a flag, and neither can hold a string.
def android_controls_text(handle: i32, text: cstr, length: i32) -> void:
    can Memory.Allocate, Abort.Panic, Ui.Controls, Unsafe.PointerCast, Ui.Window, Ui.Draw, Ui.Text, Ui.Input:
        _ = UiAndroidControls::dispatch_native_text(handle, text, length)

export fn elisa_android_controls_start(width: f32, height: f32) -> i32 = android_controls_start
export fn elisa_android_controls_resize(width: f32, height: f32) -> void = android_controls_resize
export fn elisa_android_controls_stop() -> void = android_controls_stop
export fn elisa_android_controls_event(handle: i32, event: i32, value: f32, selected: i32) -> void = android_controls_event
export fn elisa_android_controls_text(handle: i32, text: cstr, length: i32) -> void = android_controls_text
