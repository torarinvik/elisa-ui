# elisa-ui native backend: SDL3 (system libSDL3 via extern declarations).
# `module UiSdl3` implements the platform contract from ui_core.elisa and owns
# the main loop: `UiSdl3::run` polls SDL events, translates them to
# `UiCore::Event` or committed UTF-8, and drives the application contract.
#
# The extern declarations stay at file scope: they name C symbols, which are
# global by nature, and a module prefix would only pretend otherwise. The four
# text-metric hooks are the platform's half of the contract and are likewise
# top-level by name; they delegate into the module.

include "../../core/ui_core.elisa"
include "../../core/ui_lifecycle.elisa"
include "../../core/ui_raster.elisa"
include "../../core/ui_paint.elisa"

# `impl UiPaint::Painter for T:` is the one shape no compiler takes -- stage0's
# parser wants a `:` where the `for` is -- so the impl at the foot of this module
# names `Painter` unqualified and this is what makes that resolve.
using UiPaint

extern SDL_Init(flags: u32) -> bool
extern SDL_CreateWindow(title: cstr, w: i32, h: i32, flags: u64) -> void&?
extern SDL_CreateRenderer(window: void&, name: void&?) -> void&?
extern SDL_PollEvent(event: void&) -> bool
extern SDL_WaitEventTimeout(event: void&?, timeout_ms: i32) -> bool
extern SDL_GetTicks() -> u64
extern SDL_StartTextInput(window: void&) -> bool
extern SDL_StopTextInput(window: void&) -> bool
extern SDL_SetRenderDrawColor(renderer: void&, r: u8, g: u8, b: u8, a: u8) -> bool
extern SDL_RenderClear(renderer: void&) -> bool
extern SDL_RenderFillRect(renderer: void&, rect: void&) -> bool
extern SDL_RenderLine(renderer: void&, x1: f32, y1: f32, x2: f32, y2: f32) -> bool
extern SDL_SetRenderClipRect(renderer: void&, rect: void&?) -> bool
extern SDL_GetRenderClipRect(renderer: void&, rect: void&) -> bool
extern SDL_RenderClipEnabled(renderer: void&) -> bool
extern SDL_RenderPresent(renderer: void&) -> bool
extern SDL_DestroyRenderer(renderer: void&) -> void
extern SDL_DestroyWindow(window: void&) -> void
extern SDL_Quit() -> void
extern SDL_GetError() -> cstr
extern SDL_CreateTextureFromSurface(renderer: void&, surface: void&) -> void&?
extern SDL_RenderTexture(renderer: void&, texture: void&, source: void&?, destination: void&) -> bool
extern SDL_DestroySurface(surface: void&) -> void
extern SDL_DestroyTexture(texture: void&) -> void
extern puts(text: cstr) -> i64
extern getenv(name: cstr) -> cstr?
# SDL returns NUL-terminated UTF-8 for committed text and clipboard reads.
# Keep the tiny scan in Elisa so the backend does not acquire a libc dependency
# for a primitive whose policy (the backend's bounded text input) already lives here.
const SDL_TEXT_SCAN_CAPACITY: usize = 4096
def sdl_cstr_byte(text: cstr, index: usize) -> u8:
    pointer: uintptr = text.cast[uintptr] can Unsafe.PointerCast
    return 0 if pointer == 0.uintptr()
    trusted [Unsafe.PointerCast, Unsafe.PointerArithmetic]:
        byte: u8& = (pointer + index.uintptr()).cast[u8&]
        return byte
def sdl_cstr_length(text: cstr) -> usize:
    pointer: uintptr = text.cast[uintptr] can Unsafe.PointerCast
    return 0 if pointer == 0.uintptr()
    length: mutable usize = 0
    while length < SDL_TEXT_SCAN_CAPACITY |length|:
        byte: u8 = sdl_cstr_byte(text, length)
        return length if byte == 0
        length <- length + 1
    return length
# SDL_ttf 3.x. Lengths are byte counts, and a zero length means "NUL-terminated";
# every call here passes an explicit length so an sview needs no terminator.
extern TTF_Init() -> bool
extern TTF_Quit() -> void
extern TTF_OpenFont(file: cstr, size: f32) -> void&?
extern TTF_CloseFont(font: void&) -> void
extern TTF_GetStringSize(font: void&, text: cstr, length: usize, width: mutable i32&, height: mutable i32&) -> bool
extern TTF_GetFontHeight(font: void&) -> i32
extern TTF_GetFontAscent(font: void&) -> i32
extern TTF_RenderText_Blended(font: void&, text: cstr, length: usize, color: u32) -> void&?
# Renderer, font, and painter state live in their own cohesive module.
include "./ui_sdl3_draw.elisa"
# The platform half of the contract: text metrics from the font SDL_ttf
# rasterizes with.
def ui_measure_text_width(text: sview, size: f32) -> f32:
    return UiSdl3::measure_text_width(text, size)
def ui_measure_text_height(text: sview, size: f32) -> f32:
    return UiSdl3::text_line_height(size)
def ui_font_ascent(size: f32) -> f32:
    return UiSdl3::font_ascent(size)
def ui_text_line_height(size: f32) -> f32:
    return UiSdl3::text_line_height(size)

module UiSdl3:
    private:
        const INIT_VIDEO: u32 = 0x20
        const WINDOW_RESIZABLE: u64 = 0x20
        const EVENT_QUIT: u32 = 0x100
        const EVENT_WINDOW_RESIZED: u32 = 0x206
        const EVENT_WINDOW_MOUSE_LEAVE: u32 = 0x20d
        const EVENT_WINDOW_FOCUS_GAINED: u32 = 0x20e
        const EVENT_WINDOW_FOCUS_LOST: u32 = 0x20f
        const EVENT_KEY_DOWN: u32 = 0x300
        const EVENT_KEY_UP: u32 = 0x301
        const EVENT_TEXT_EDITING: u32 = 0x302
        const EVENT_TEXT_INPUT: u32 = 0x303

        # SDL spells every non-ASCII key as (1 << 30) | <USB HID scancode>.
        const SDL_SCANCODE_MASK: i32 = 1073741824
        # The scancodes this backend names, in SDL's (USB HID) numbering.
        const SDL_SCAN_F1: i32 = 58
        const SDL_SCAN_F12: i32 = 69
        const SDL_SCAN_INSERT: i32 = 73
        const SDL_SCAN_HOME: i32 = 74
        const SDL_SCAN_PAGE_UP: i32 = 75
        const SDL_SCAN_DELETE: i32 = 76
        const SDL_SCAN_END: i32 = 77
        const SDL_SCAN_PAGE_DOWN: i32 = 78
        const SDL_SCAN_RIGHT: i32 = 79
        const SDL_SCAN_UP: i32 = 82
        const SDL_SCAN_LEFT_CONTROL: i32 = 224
        const SDL_SCAN_LEFT_SHIFT: i32 = 225
        const SDL_SCAN_LEFT_ALT: i32 = 226
        const SDL_SCAN_LEFT_SUPER: i32 = 227
        const SDL_SCAN_RIGHT_CONTROL: i32 = 228
        const SDL_SCAN_RIGHT_SHIFT: i32 = 229
        const SDL_SCAN_RIGHT_ALT: i32 = 230
        const SDL_SCAN_RIGHT_SUPER: i32 = 231
        const EVENT_MOUSE_MOTION: u32 = 0x400
        const EVENT_MOUSE_BUTTON_DOWN: u32 = 0x401
        const EVENT_MOUSE_BUTTON_UP: u32 = 0x402
        const EVENT_MOUSE_WHEEL: u32 = 0x403

        global mutable window: void&? = null
        # SDL_Event is a 128-byte union; poll into this buffer and read typed
        # fields at their SDL3 offsets (type@0; pointer events keep x@28 and
        # y@32 as f32).
        global mutable event_buffer: u8[128] = zeroed

        def event_button() -> i32:
            return event_buffer[24].i32()
    public:
        def font_count() -> usize:
            return UiSdl3Draw::font_count()

        def fonts_close() -> void:
            UiSdl3Draw::fonts_close()

        def measure_text_width(text: sview, size: f32) -> f32:
            return UiSdl3Draw::measure_text_width(text, size)

        def font_ascent(size: f32) -> f32:
            return UiSdl3Draw::font_ascent(size)

        def text_line_height(size: f32) -> f32:
            return UiSdl3Draw::text_line_height(size)


    private:
        def event_type() -> u32:
            type_ref: mutable u32& = (&event_buffer[0]).cast[u32&] can Unsafe.PointerCast
            return type_ref[0]

        def event_x() -> f32:
            x_ref: mutable f32& = (&event_buffer[28]).cast[f32&] can Unsafe.PointerCast
            return x_ref[0]

        def event_y() -> f32:
            y_ref: mutable f32& = (&event_buffer[32]).cast[f32&] can Unsafe.PointerCast
            return y_ref[0]

        def event_window_data1() -> i32:
            value_ref: mutable i32& = (&event_buffer[20]).cast[i32&] can Unsafe.PointerCast
            return value_ref[0]

        def event_window_data2() -> i32:
            value_ref: mutable i32& = (&event_buffer[24]).cast[i32&] can Unsafe.PointerCast
            return value_ref[0]

        # SDL_MouseWheelEvent has a different layout from mouse motion:
        # delta at 24/28 and the pointer position at 36/40.
        def event_wheel_x() -> f32:
            value_ref: mutable f32& = (&event_buffer[24]).cast[f32&] can Unsafe.PointerCast
            return value_ref[0]

        def event_wheel_y() -> f32:
            value_ref: mutable f32& = (&event_buffer[28]).cast[f32&] can Unsafe.PointerCast
            return value_ref[0]

        def event_wheel_mouse_x() -> f32:
            value_ref: mutable f32& = (&event_buffer[36]).cast[f32&] can Unsafe.PointerCast
            return value_ref[0]

        def event_wheel_mouse_y() -> f32:
            value_ref: mutable f32& = (&event_buffer[40]).cast[f32&] can Unsafe.PointerCast
            return value_ref[0]

        # SDL_KeyboardEvent: type 0, reserved 4, timestamp 8, windowID 16,
        # which 20, scancode 24, key 28. The KEYCODE is what carries the layout,
        # so that is what translates into the UiCore::Key space.
        def event_keycode() -> i32:
            key_ref: mutable i32& = (&event_buffer[28]).cast[i32&] can Unsafe.PointerCast
            return key_ref[0]

        def event_text_pointer() -> cstr:
            text_ref: mutable cstr& = (&event_buffer[24]).cast[mutable cstr&] can Unsafe.PointerCast
            return text_ref[0]

        def event_text_editing_start() -> i32:
            value_ref: mutable i32& = (&event_buffer[32]).cast[i32&] can Unsafe.PointerCast
            return value_ref[0]

        def event_text_editing_length() -> i32:
            value_ref: mutable i32& = (&event_buffer[36]).cast[i32&] can Unsafe.PointerCast
            return value_ref[0]

    public:
        # SDL's keycode -> the UiCore::Key space, which is GLFW's numbering (Escape 256,
        # Enter 257, F1 290) and NOT SDL's. The two agree on printable ASCII and
        # disagree on everything else, so this is a translation, not a cast.
        #
        # Public so it can be tested directly: a headless run never produces a key
        # event, and a table nothing exercises is a table that rots.
        def key_from_sdl(code: i32) -> i32:
            # SDL reports the LOWERCASE keycode for an unshifted letter; UiCore::Key names
            # the uppercase one, as GLFW does.
            return code - 32 if code >= 97 and code <= 122
            # The rest of printable ASCII is shared. A code in this range that UiCore::Key
            # does not name still passes through: it is an i32 underneath, and a
            # caller comparing against UiCore::Key members simply matches none of them.
            return code if code >= 32 and code <= 96
            # The control codes SDL uses where GLFW uses its own high numbers.
            return UiCore::Key.Backspace.i32() if code == 8
            return UiCore::Key.Tab.i32() if code == 9
            return UiCore::Key.Enter.i32() if code == 13
            return UiCore::Key.Escape.i32() if code == 27
            return UiCore::Key.Delete.i32() if code == 127
            # Everything else is (1 << 30) | scancode.
            return 0 if code < SDL_SCANCODE_MASK
            scancode: i32 = code - SDL_SCANCODE_MASK
            # Both runs are contiguous in both numberings, so they translate by offset
            # rather than key by key: F1..F12, and Right/Left/Down/Up.
            return UiCore::Key.F1.i32() + (scancode - SDL_SCAN_F1) if scancode >= SDL_SCAN_F1 and scancode <= SDL_SCAN_F12
            return UiCore::Key.Right.i32() + (scancode - SDL_SCAN_RIGHT) if scancode >= SDL_SCAN_RIGHT and scancode <= SDL_SCAN_UP
            return UiCore::Key.Insert.i32() if scancode == SDL_SCAN_INSERT
            return UiCore::Key.Home.i32() if scancode == SDL_SCAN_HOME
            return UiCore::Key.PageUp.i32() if scancode == SDL_SCAN_PAGE_UP
            return UiCore::Key.Delete.i32() if scancode == SDL_SCAN_DELETE
            return UiCore::Key.End.i32() if scancode == SDL_SCAN_END
            return UiCore::Key.PageDown.i32() if scancode == SDL_SCAN_PAGE_DOWN
            return UiCore::Key.LeftControl.i32() if scancode == SDL_SCAN_LEFT_CONTROL
            return UiCore::Key.LeftShift.i32() if scancode == SDL_SCAN_LEFT_SHIFT
            return UiCore::Key.LeftAlt.i32() if scancode == SDL_SCAN_LEFT_ALT
            return UiCore::Key.LeftSuper.i32() if scancode == SDL_SCAN_LEFT_SUPER
            return UiCore::Key.RightControl.i32() if scancode == SDL_SCAN_RIGHT_CONTROL
            return UiCore::Key.RightShift.i32() if scancode == SDL_SCAN_RIGHT_SHIFT
            return UiCore::Key.RightAlt.i32() if scancode == SDL_SCAN_RIGHT_ALT
            return UiCore::Key.RightSuper.i32() if scancode == SDL_SCAN_RIGHT_SUPER
            # A key this backend does not model. 0 is not a UiCore::Key member, so an app
            # comparing against one matches nothing -- the same outcome as before,
            # now stated rather than implied.
            return 0

        # SDL button constants are 1-based (left=1); UiCore uses zero for the
        # portable primary button, matching AppKit and browser events.
        def button_from_sdl(button: i32) -> i32:
            return button - 1 if button > 0 else UiCore::NO_POINTER_BUTTON

        def seconds_from_ticks(ticks: u64) -> f64:
            return ticks.f64() / 1000.0

        # Compatibility name for existing SDL callers; timeout policy itself
        # is centralized in UiCore so other event-loop backends can share it.
        def animation_timeout(delay: f32) -> i32:
            return UiCore::frame_timeout_ms(delay)

        # SDL supplies committed input as a NUL-terminated UTF-8 string. Keep
        # key events and text separate: key codes express navigation/shortcuts,
        # while this path preserves composed and non-ASCII text verbatim.
        def text_input(text: cstr) -> void:
            length: usize = sdl_cstr_length(text)
            return if length == 0
            app_text_input(sview(text, 0, length.i64()))

        def text_editing(text: cstr, selected_start: i32, selected_length: i32) -> void:
            length: usize = sdl_cstr_length(text)
            app_text_editing(sview(text, 0, length.i64()), selected_start, selected_length)

    private:
        # Poll one SDL event and translate it. Returns false when the queue is
        # empty; events outside the modeled set come back as `Event.None` for the
        # app to skip.
        def next_event(out_event: mutable UiCore::Event&) -> bool:
            buffer_pointer: void& = (&event_buffer[0]).cast[void&] can Unsafe.PointerCast
            has_event: bool = SDL_PollEvent(buffer_pointer)
            return false if not has_event
            kind: u32 = event_type()
            out_event <- (UiCore::Event.None)
            if kind == EVENT_QUIT:
                out_event <- (UiCore::Event.Quit)
            elif kind == EVENT_WINDOW_RESIZED:
                out_event <- (UiCore::Event.Resize(size: UiCore::Size(event_window_data1().f32(), event_window_data2().f32())))
            elif kind == EVENT_WINDOW_MOUSE_LEAVE:
                out_event <- (UiCore::PointerEvent.Leave)
            elif kind == EVENT_WINDOW_FOCUS_GAINED:
                out_event <- (UiCore::Event.FocusGained)
            elif kind == EVENT_WINDOW_FOCUS_LOST:
                out_event <- (UiCore::Event.FocusLost)
            elif kind == EVENT_MOUSE_MOTION:
                out_event <- (UiCore::PointerEvent.Move(at: UiCore::Vec2(event_x(), event_y())))
            elif kind == EVENT_MOUSE_BUTTON_DOWN:
                out_event <- (UiCore::PointerEvent.Down(at: UiCore::Vec2(event_x(), event_y()), button: button_from_sdl(event_button())))
            elif kind == EVENT_MOUSE_BUTTON_UP:
                out_event <- (UiCore::PointerEvent.Up(at: UiCore::Vec2(event_x(), event_y()), button: button_from_sdl(event_button())))
            elif kind == EVENT_MOUSE_WHEEL:
                out_event <- (UiCore::PointerEvent.Scroll(at: UiCore::Vec2(event_wheel_mouse_x(), event_wheel_mouse_y()), delta: UiCore::Vec2(event_wheel_x(), event_wheel_y())))
            elif kind == EVENT_KEY_DOWN:
                out_event <- (UiCore::KeyEvent.Down(code: UiCore::Key(key_from_sdl(event_keycode()))))
            elif kind == EVENT_KEY_UP:
                out_event <- (UiCore::KeyEvent.Up(code: UiCore::Key(key_from_sdl(event_keycode()))))
            return true

    public:
        # max_frames <= 0 runs until quit; a positive value exits after that
        # many frames (headless smoke runs use it together with
        # SDL_VIDEODRIVER=dummy).
        def run(title: cstr, width: i32, height: i32, max_frames: i64) -> i64:
            UiLifecycle::reset()
            if not SDL_Init(INIT_VIDEO):
                _ = puts(SDL_GetError())
                return 1
            window_opt: void&? = SDL_CreateWindow(title, width, height, WINDOW_RESIZABLE)
            if window_opt == null:
                _ = puts(SDL_GetError())
                SDL_Quit()
                return 1
            window <- window_opt
            if window is created_window:
                if not UiSdl3Draw::create_renderer(created_window):
                    _ = puts(SDL_GetError())
                    SDL_DestroyWindow(created_window)
                    SDL_Quit()
                    return 1
            # Text is optional: a host without the font still runs, it just
            # measures every run as zero-width.
            if not TTF_Init():
                _ = puts(SDL_GetError())
            path_override: cstr? = getenv("ELISA_UI_FONT")
            if path_override is override:
                UiSdl3Draw::set_font_override(override)
            UiCore::set_viewport(width.f32(), height.f32())
            return 1 if not UiLifecycle::begin()
            app_init()
            _ = UiLifecycle::ready()
            if window is text_window:
                if not SDL_StartTextInput(text_window):
                    _ = puts(SDL_GetError())
            running: mutable bool = true
            frames: mutable i64 = 0
            while running |frames|:
                event: mutable UiCore::Event = (UiCore::Event.None)
                while next_event(event) |event, running|:
                    if event_type() == EVENT_TEXT_INPUT:
                        text_input(event_text_pointer())
                    elif event_type() == EVENT_TEXT_EDITING:
                        text_editing(event_text_pointer(), event_text_editing_start(), event_text_editing_length())
                    else:
                        match event:
                            UiCore::Event.Quit:
                                running <- false
                            UiCore::Event.Resize(size):
                                UiCore::set_viewport(size.width, size.height)
                            UiCore::Event.FocusGained:
                                _ = UiLifecycle::focus_gained()
                            UiCore::Event.FocusLost:
                                _ = UiLifecycle::focus_lost()
                            _:
                                pass
                        app_event(event)
                # Same retained contract as the component backend: the app
                # fills a command batch, then the backend consumes it. SDL3
                # replays immediately.
                UiCore::set_frame_time(seconds_from_ticks(SDL_GetTicks()))
                UiCore::begin_frame()
                app_frame()
                UiPaint::replay[UiSdl3Draw::Sdl3Painter]()
                UiSdl3Draw::present()
                frames <- frames + 1
                running <- false if max_frames > 0 and frames >= max_frames
                if running and max_frames <= 0:
                    _ = SDL_WaitEventTimeout(null, UiCore::frame_timeout_ms(UiCore::frame_delay()))
            UiSdl3Draw::fonts_close()
            TTF_Quit()
            if window is text_window:
                _ = SDL_StopTextInput(text_window)
            UiSdl3Draw::destroy_renderer()
            if window is done_window:
                SDL_DestroyWindow(done_window)
            SDL_Quit()
            _ = UiLifecycle::stop()
            return 0
