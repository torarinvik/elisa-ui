# SDL_ttf 3.x boundary types and functions shared by the font and draw modules.

struct SdlColor:
    r: u8
    g: u8
    b: u8
    a: u8

extern TTF_Init() -> bool
extern TTF_Quit() -> void
extern TTF_OpenFont(file: cstr, size: f32) -> void&?
extern TTF_CloseFont(font: void&) -> void
extern TTF_GetStringSize(font: void&, text: cstr, length: usize, width: mutable i32&, height: mutable i32&) -> bool
extern TTF_GetFontHeight(font: void&) -> i32
extern TTF_GetFontAscent(font: void&) -> i32
extern TTF_SetFontDirection(font: void&, direction: i32) -> bool
extern TTF_GetFontDirection(font: void&) -> i32
extern TTF_SetFontLanguage(font: void&, language: cstr?) -> bool
extern TTF_SetFontScript(font: void&, script: u32) -> bool
extern TTF_GetFontScript(font: void&) -> u32
extern TTF_StringToTag(script: cstr) -> u32
extern TTF_RenderText_Blended(font: void&, text: cstr, length: usize, color: SdlColor) -> void&?
