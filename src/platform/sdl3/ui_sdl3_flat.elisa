# Ready-to-use SDL3 adapter for UiFlat's platform byte services. SDL owns the
# process clipboard allocation; Elisa owns shortcut and editing semantics.

include "./ui_sdl3.elisa"
include "../../widgets/ui_handles.elisa"

extern SDL_SetClipboardText(text: cstr) -> bool
extern SDL_GetClipboardText() -> cstr?
extern SDL_free(memory: cstr) -> void

global mutable sdl_flat_clipboard_write: u8[UiFlat::TEXT_CAPACITY + 1] = zeroed
global mutable sdl_flat_clipboard_read: u8[UiFlat::TEXT_CAPACITY] = zeroed
global mutable sdl_flat_clipboard_length: usize = 0
global mutable sdl_flat_clipboard_cache_valid: bool = false
global mutable sdl_flat_clipboard_generation: u32 = 0

def sdl_flat_scrub_buffer(buffer: mutable u8&, capacity: usize) -> void:
    for index in 0..<capacity:
        buffer[index] <- 0

def sdl_flat_fetch_clipboard() -> usize:
    text_opt: cstr? = SDL_GetClipboardText()
    sdl_flat_scrub_buffer(&sdl_flat_clipboard_read[0], UiFlat::TEXT_CAPACITY)
    sdl_flat_clipboard_length <- 0
    sdl_flat_clipboard_cache_valid <- true
    sdl_flat_clipboard_generation <- UiLifecycle::generation()
    if text_opt is text:
        length: usize = UiSdl3Text::length(text)
        take: usize = length if length < UiFlat::TEXT_CAPACITY else UiFlat::TEXT_CAPACITY
        for index in 0..<take:
            sdl_flat_clipboard_read[index] <- UiSdl3Text::byte(text, index)
        copied: sview = sview(&sdl_flat_clipboard_read[0], 0, take.i64())
        sdl_flat_clipboard_length <- UiText::valid_utf8_prefix(copied, take)
        SDL_free(text)
    return sdl_flat_clipboard_length

def sdl_flat_clipboard_cache_current() -> bool:
    return false if not sdl_flat_clipboard_cache_valid
    return true if sdl_flat_clipboard_generation == UiLifecycle::generation()
    # A new owner/session must never consume bytes captured by the previous
    # one. Invalidate and scrub the old snapshot before the caller fetches a
    # fresh native value; this also bounds the lifetime of sensitive clipboard
    # data when a host stops between `has_text` and `read`.
    sdl_flat_scrub_buffer(&sdl_flat_clipboard_read[0], UiFlat::TEXT_CAPACITY)
    sdl_flat_clipboard_length <- 0
    sdl_flat_clipboard_cache_valid <- false
    return false

def ui_clipboard_has_text() -> bool:
    return sdl_flat_clipboard_length > 0 if sdl_flat_clipboard_cache_current()
    return sdl_flat_fetch_clipboard() > 0

def ui_clipboard_write(bytes: u8&, length: usize) -> bool:
    return false if length > 0 and bytes == null
    take: usize = length if length < UiFlat::TEXT_CAPACITY else UiFlat::TEXT_CAPACITY
    for index in 0..<take:
        sdl_flat_clipboard_write[index] <- bytes[index]
    copied: sview = sview(&sdl_flat_clipboard_write[0], 0, take.i64())
    valid_length: usize = UiText::valid_utf8_prefix(copied, take)
    sdl_flat_clipboard_write[valid_length] <- 0
    pointer: cstr = (&sdl_flat_clipboard_write[0]).cast[cstr] can Unsafe.PointerCast
    written: bool = SDL_SetClipboardText(pointer)
    sdl_flat_scrub_buffer(&sdl_flat_clipboard_write[0], UiFlat::TEXT_CAPACITY + 1)
    sdl_flat_clipboard_cache_valid <- false
    sdl_flat_clipboard_length <- 0
    sdl_flat_clipboard_generation <- UiLifecycle::generation()
    return written

def ui_clipboard_read(buffer: mutable u8&, capacity: usize) -> usize:
    return 0 if capacity > 0 and buffer == null
    cached: bool = sdl_flat_clipboard_cache_current()
    available: mutable usize = sdl_flat_clipboard_length if cached else 0
    if not cached:
        available <- sdl_flat_fetch_clipboard()
    take: mutable usize = available if available < capacity else capacity
    source: sview = sview(&sdl_flat_clipboard_read[0], 0, take.i64())
    take <- UiText::valid_utf8_prefix(source, take)
    for index in 0..<take:
        buffer[index] <- sdl_flat_clipboard_read[index]
    sdl_flat_clipboard_cache_valid <- false
    sdl_flat_clipboard_length <- 0
    sdl_flat_clipboard_generation <- UiLifecycle::generation()
    sdl_flat_scrub_buffer(&sdl_flat_clipboard_read[0], UiFlat::TEXT_CAPACITY)
    return take
