# SDL3 lifecycle loop for the native backend.
#
# Event decoding, text bounds and renderer state stay in UiSdl3's companion
# modules; this extension owns only session startup, frame scheduling and the
# one centralized native teardown path.

extend UiSdl3:
    private:
        # Dispatch one event while SDL's borrowed union is still alive. Text
        # callbacks read pointers from the current buffer, whereas typed
        # events are queued and delivered through the shared framework queue.
        # Keeping this in one helper makes polled and waited events identical.
        def dispatch_current_event(event: UiCore::Event, running: mutable bool&) -> void:
            # `decode_event` returns Event.None for window events addressed to
            # another SDL window. Text input/editing are the one event family
            # handled directly from the borrowed SDL union, so also repeat the
            # ownership check here; otherwise a foreign text event could bypass
            # the typed queue filter solely because its raw kind is still in
            # `event_buffer`.
            belongs_to_window: bool = window_event_matches(window_id, event_window_id())
            if event_type() == EVENT_TEXT_INPUT and belongs_to_window and UiLifecycle::accepts_input():
                text_input(event_text_pointer())
            elif event_type() == EVENT_TEXT_EDITING and belongs_to_window and UiLifecycle::accepts_input():
                text_editing(event_text_pointer(), event_text_editing_start(), event_text_editing_length())
            elif UiCore::wire_kind(event) != UiCore::WireKind.None:
                _ = UiEvents::enqueue(event)
            # `event` is now represented by the typed UiCore value (or has
            # already been delivered to the text callback). Do not keep SDL's
            # borrowed pointer-bearing union alive while application code
            # dispatches the event.
            clear_event_buffer()
            dispatch_queued_events(running)

    public:
        # max_frames <= 0 runs until quit; a positive value exits after that
        # many frames (headless smoke runs use it together with
        # SDL_VIDEODRIVER=dummy).
        def run(title: cstr, width: i32, height: i32, max_frames: i64) -> i64:
            safe_title: cstr = UiSdl3Text::bounded_title(title)
            UiLifecycle::reset()
            UiCapabilities::use_sdl3()
            UiEvents::reset()
            UiMetrics::reset()
            clear_event_buffer()
            if not SDL_Init(INIT_VIDEO):
                _ = puts(SDL_GetError())
                return 1
            safe_width: i32 = window_extent(width)
            safe_height: i32 = window_extent(height)
            window_opt: void&? = SDL_CreateWindow(safe_title, safe_width, safe_height, WINDOW_RESIZABLE)
            if window_opt == null:
                _ = puts(SDL_GetError())
                SDL_Quit()
                return 1
            window <- window_opt
            if window is created_window:
                window_id <- SDL_GetWindowID(created_window)
                if not UiSdl3Draw::create_renderer(created_window):
                    _ = puts(SDL_GetError())
                    SDL_DestroyWindow(created_window)
                    window <- null
                    window_id <- 0
                    SDL_Quit()
                    return 1
            # Text is optional: a host without the font still runs, it just
            # measures every run as zero-width.
            if not TTF_Init():
                _ = puts(SDL_GetError())
            path_override: cstr? = getenv("ELISA_UI_FONT")
            if path_override is override:
                UiSdl3Draw::set_font_override(override)
            UiCore::set_viewport(safe_width.f32(), safe_height.f32())
            if not UiLifecycle::begin():
                release_native()
                _ = UiLifecycle::stop()
                return 1
            app_init()
            _ = UiLifecycle::ready()
            # SDL does not guarantee a separate initial focus event after a
            # freshly created window is shown. Treat the newly owned window as
            # focused; later SDL focus transitions still update this state.
            _ = UiLifecycle::focus_gained()
            if not UiLifecycle::can_render():
                release_native()
                _ = UiLifecycle::stop()
                return 0
            if window is text_window:
                if not SDL_StartTextInput(text_window):
                    _ = puts(SDL_GetError())
            running: mutable bool = true
            frames: mutable i64 = 0
            while running |frames|:
                event: mutable UiCore::Event = (UiCore::Event.None)
                while next_event(event) |event, running|:
                    dispatch_current_event(event, &running)
                    break if not running
                break if not running
                # Same retained contract as the component backend: the app
                # fills a command batch, then the backend consumes it. SDL3
                # replays immediately.
                frame_start: f64 = seconds_from_ticks(SDL_GetTicks())
                UiCore::set_frame_time(frame_start)
                UiMetrics::begin_frame(frame_start)
                UiCore::begin_frame()
                frame_generation: u32 = UiLifecycle::generation()
                app_frame()
                # Application code may stop the session synchronously while
                # building its frame. Finish the diagnostic sample, but do
                # not replay or present commands after the lifecycle has
                # made the native renderer unavailable. A callback may also
                # start a replacement session; its generation owns the new
                # metrics and command batch, so the old loop must not publish
                # into it.
                same_session: bool = UiLifecycle::generation() == frame_generation
                if same_session and UiLifecycle::can_render():
                    UiMetrics::mark_application(seconds_from_ticks(SDL_GetTicks()))
                    UiMetrics::mark_semantics(seconds_from_ticks(SDL_GetTicks()))
                    UiPaint::replay[UiSdl3Draw::Sdl3Painter]()
                    UiMetrics::mark_paint(seconds_from_ticks(SDL_GetTicks()))
                    UiSdl3Draw::present()
                else:
                    running <- false
                if same_session:
                    UiMetrics::finish_frame(seconds_from_ticks(SDL_GetTicks()))
                break if not running
                frames <- frames + 1
                running <- false if max_frames > 0 and frames >= max_frames
                if running and max_frames <= 0:
                    if wait_event(UiCore::frame_timeout_ms(UiCore::frame_delay()), event):
                        dispatch_current_event(event, &running)
            if window is text_window:
                _ = SDL_StopTextInput(text_window)
            release_native()
            _ = UiLifecycle::stop()
            return 0
