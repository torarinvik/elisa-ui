# SDL's committed text and clipboard values are bounded NUL-terminated UTF-8.
# The pointer scan stays private to this utility; the backend only receives the
# validated length and keeps all text policy in Elisa.

module UiSdl3Text:
    public:
        # SDL's window title API accepts a raw NUL-terminated pointer. Copy it
        # into framework-owned storage first so a caller-supplied title cannot
        # make SDL scan an arbitrarily long or unterminated foreign buffer.
        # The returned pointer remains stable until the next title preparation
        # and is always terminated inside the fixed arena.
        def bounded_title(title: cstr) -> cstr:
            length_value: usize = length(title)
            safe_length: usize = length_value if length_value < TITLE_CAPACITY else TITLE_CAPACITY
            for index in 0..<TITLE_STORAGE_CAPACITY:
                title_storage[index] <- 0
            for index in 0..<safe_length:
                title_storage[index] <- byte(title, index)
            copied: sview = sview(&title_storage[0], 0, safe_length.i64())
            valid_length: usize = UiText::valid_utf8_prefix(copied, safe_length)
            title_storage[valid_length] <- 0
            pointer: cstr = (&title_storage[0]).cast[cstr] can Unsafe.PointerCast
            return pointer

        def byte(text: cstr, index: usize) -> u8:
            pointer: uintptr = text.cast[uintptr] can Unsafe.PointerCast
            return 0 if pointer == 0.uintptr()
            return byte_at(pointer, index)

        def length(text: cstr) -> usize:
            pointer: uintptr = text.cast[uintptr] can Unsafe.PointerCast
            return 0 if pointer == 0.uintptr()
            count: mutable usize = 0
            while count < MAX_SCAN_BYTES |count|:
                return count if byte_at(pointer, count) == 0
                count <- count + 1
            return count

    private:
        # No SDL text path can deliver more bytes to the framework than its
        # shared bounded text view. Stopping at that boundary also prevents a
        # malformed unterminated host pointer from turning one event callback
        # into an unbounded native-memory walk.
        const MAX_SCAN_BYTES: usize = UiCore::MAX_TEXT_BYTES
        const TITLE_CAPACITY: usize = UiCore::MAX_TEXT_BYTES
        const TITLE_STORAGE_CAPACITY: usize = TITLE_CAPACITY + 1
        global mutable title_storage: u8[TITLE_STORAGE_CAPACITY] = zeroed

        def byte_at(pointer: uintptr, index: usize) -> u8:
            trusted [Unsafe.PointerCast, Unsafe.PointerArithmetic]:
                byte: u8& = (pointer + index.uintptr()).cast[u8&]
                return byte
