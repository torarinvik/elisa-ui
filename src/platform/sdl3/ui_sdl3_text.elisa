# SDL's committed text and clipboard values are bounded NUL-terminated UTF-8.
# The pointer scan stays private to this utility; the backend only receives the
# validated length and keeps all text policy in Elisa.

module UiSdl3Text:
    public:
        # SDL's window title API accepts a raw NUL-terminated pointer. Copy it
        # into framework-owned storage first so a caller-supplied title cannot
        # make SDL scan an arbitrarily long or unterminated foreign buffer.
        # The returned pointer remains stable until the next title preparation
        # and is always terminated inside the fixed arena.
        def bounded_title(title: cstr) -> cstr:
            length_value: usize = length(title)
            safe_length: usize = length_value if length_value < TITLE_CAPACITY else TITLE_CAPACITY
            for index in 0..<TITLE_STORAGE_CAPACITY:
                title_storage[index] <- 0
            for index in 0..<safe_length:
                title_storage[index] <- byte(title, index)
            # A counted view may borrow this storage because the bound above
            # is no larger than the fixed array. Build it through the narrow
            # unsafe bridge directly: the stage1 product cannot currently
            # monomorphize this fixed-array helper when its size is passed as
            # a named const-generic argument.
            copied: mutable sview = ""
            if safe_length > 0:
                can Unsafe.PointerCast:
                    copied <- UiText::unsafe_sview_bounded_bytes(&title_storage[0], safe_length)
            valid_length: usize = UiText::valid_utf8_prefix(copied, safe_length)
            title_storage[valid_length] <- 0
            can Unsafe.PointerCast:
                return (&title_storage[0]).cast[cstr]

        # SDL text callbacks expose a borrowed NUL-terminated pointer, but a
        # malformed host event may omit that terminator. Copy the bounded
        # prefix into framework-owned storage and return a counted fixed-array view; this
        # keeps the callback path from rebuilding a view through the scanning
        # `sview(cstr, ...)` constructor.
        def bounded_view(text: cstr) -> sview:
            length_value: usize = length(text)
            safe_length: usize = length_value if length_value < EVENT_TEXT_CAPACITY else EVENT_TEXT_CAPACITY
            for index in 0..<EVENT_TEXT_STORAGE_CAPACITY:
                event_text_storage[index] <- 0
            for index in 0..<safe_length:
                event_text_storage[index] <- byte(text, index)
            # `safe_length` is bounded by the capacity and the array is owned
            # by this module, so the view cannot escape its valid storage.
            copied: mutable sview = ""
            if safe_length > 0:
                can Unsafe.PointerCast:
                    copied <- UiText::unsafe_sview_bounded_bytes(&event_text_storage[0], safe_length)
            valid_length: usize = UiText::valid_utf8_prefix(copied, safe_length)
            return "" if valid_length == 0
            can Unsafe.PointerCast:
                return UiText::unsafe_sview_bounded_bytes(&event_text_storage[0], valid_length)

        def byte(text: cstr, index: usize) -> u8:
            pointer: uintptr = text.cast[uintptr] can Unsafe.PointerCast
            return 0 if pointer == 0.uintptr()
            return byte_at(pointer, index)

        def length(text: cstr) -> usize:
            pointer: uintptr = text.cast[uintptr] can Unsafe.PointerCast
            return 0 if pointer == 0.uintptr()
            count: usize =
                for index in 0..<MAX_SCAN_BYTES |count = MAX_SCAN_BYTES| -> count:
                    value: u8 = byte_at(pointer, index)
                    count <- index if value == 0
                    break if value == 0
            return count

    private:
        # No SDL text path can deliver more bytes to the framework than its
        # shared bounded text view. Stopping at that boundary also prevents a
        # malformed unterminated host pointer from turning one event callback
        # into an unbounded native-memory walk.
        const MAX_SCAN_BYTES: usize = UiCore::MAX_TEXT_BYTES
        const TITLE_CAPACITY: usize = UiCore::MAX_TEXT_BYTES
        const TITLE_STORAGE_CAPACITY: usize = TITLE_CAPACITY + 1
        const EVENT_TEXT_CAPACITY: usize = UiCore::MAX_TEXT_BYTES
        const EVENT_TEXT_STORAGE_CAPACITY: usize = EVENT_TEXT_CAPACITY + 1
        global mutable title_storage: u8[TITLE_STORAGE_CAPACITY] = zeroed
        global mutable event_text_storage: u8[EVENT_TEXT_STORAGE_CAPACITY] = zeroed

        def byte_at(pointer: uintptr, index: usize) -> u8:
            trusted [Unsafe.PointerCast, Unsafe.PointerArithmetic]:
                byte: u8& = (pointer + index.uintptr()).cast[u8&]
                return byte
