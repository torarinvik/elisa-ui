# SDL3 drawing service for the native elisa-ui backend.
#
# This module owns renderer state, SDL_ttf font lifetime, raster-backed shape
# drawing, and the UiPaint painter specialization. UiSdl3 owns the window,
# event queue, and lifecycle loop; keeping those responsibilities separate
# makes the native boundary explicit without hiding it behind a facade.

module UiSdl3Draw:
    private:
        global mutable renderer: void&? = null
        global mutable saved_clip_rect: i32[4] = zeroed
        global mutable saved_clip_enabled: bool = false
        global mutable sdl3_clip_depth: usize = 0

        def ren() -> void&:
            if renderer is active_renderer:
                return active_renderer
            return zeroed

        # Text comes from SDL_ttf. A TTF_Font is tied to one point size, so
        # fonts are opened on demand and kept in a small table keyed by size;
        # fonts_close releases them at shutdown.
        const MAX_FONTS: usize = 8
        const DEFAULT_FONT: cstr = "/System/Library/Fonts/Supplemental/Arial.ttf"

        global mutable font_handles: (void&?)[MAX_FONTS] = zeroed
        global mutable font_sizes: f32[MAX_FONTS] = zeroed
        global mutable font_total: usize = 0
        global mutable font_override: cstr? = null

        def font_path() -> cstr:
            if font_override is override:
                return override
            return DEFAULT_FONT

        def font_for(size: f32) -> void&?:
            safe_size: f32 = UiCore::bounded_extent(size)
            for index in 0..<font_total:
                return font_handles[index] if font_sizes[index] == safe_size
            return null if font_total >= MAX_FONTS
            opened: void&? = TTF_OpenFont(font_path(), safe_size)
            return null if opened == null
            font_handles[font_total] <- opened
            font_sizes[font_total] <- safe_size
            font_total <- font_total + 1
            return opened

        # A rendered glyph surface and its texture are released by destructors
        # rather than by hand. This keeps every early-return path safe.
        struct Surface:
            handle: void&

        def __drop__(self: Surface) -> void:
            SDL_DestroySurface(self.handle)

        struct Texture:
            handle: void&

        def __drop__(self: Texture) -> void:
            SDL_DestroyTexture(self.handle)

        def packed_color(color: UiCore::Color) -> u32:
            return color.r.u32() | (color.g.u32() << 8) | (color.b.u32() << 16) | (color.a.u32() << 24)

        def blit_text(run: UiCore::TextRun, color: UiCore::Color) -> void:
            return if run.text.len <= 0 or run.text.data == null
            safe_text: sview = UiCore::bounded_text(run.text)
            return if safe_text.len <= 0 or safe_text.data == null
            if font_for(run.size) is font:
                pointer: cstr = safe_text.data.cast[cstr] can Unsafe.PointerCast
                surface_opt: void&? = TTF_RenderText_Blended(font, pointer, safe_text.len.usize(), packed_color(color))
                if surface_opt is surface_handle:
                    surface: Surface = Surface{handle: surface_handle}
                    texture_opt: void&? = SDL_CreateTextureFromSurface(ren(), surface.handle)
                    if texture_opt is texture_handle:
                        texture: Texture = Texture{handle: texture_handle}
                        width: f32 = measure_text_width(safe_text, run.size)
                        height: f32 = text_line_height(run.size)
                        destination: mutable array[f32, 4] = [run.origin.x, run.origin.y, width, height]
                        destination_pointer: void& = (&destination[0]).cast[void&] can Unsafe.PointerCast
                        _ = SDL_RenderTexture(ren(), texture.handle, null, destination_pointer)

        def paint_rect(box_rect: UiCore::Rect, color: UiCore::Color) -> void:
            box: mutable array[f32, 4] = [box_rect.origin.x, box_rect.origin.y, box_rect.size.width, box_rect.size.height]
            _ = SDL_SetRenderDrawColor(ren(), color.r, color.g, color.b, color.a)
            rect_pointer: void& = (&box[0]).cast[void&] can Unsafe.PointerCast
            _ = SDL_RenderFillRect(ren(), rect_pointer)

        def fill_span(x0: f32, x1: f32, y: f32) -> void:
            return if x1 <= x0
            span: mutable array[f32, 4] = [x0, y, x1 - x0, 1.0]
            span_pointer: void& = (&span[0]).cast[void&] can Unsafe.PointerCast
            _ = SDL_RenderFillRect(ren(), span_pointer)

        # A minimized or not-yet-sized surface has no drawable pixels. Keep
        # this check in the framework so shape rasterizers do not scan a huge
        # finite geometry range merely to have SDL clip every span away.
        def viewport_is_drawable() -> bool:
            return UiCore::viewport_width() > 0.0 and UiCore::viewport_height() > 0.0

        def paint_circle(disc: UiCore::Circle, color: UiCore::Color) -> void:
            return if not viewport_is_drawable()
            return if disc.radius <= 0.0
            _ = SDL_SetRenderDrawColor(ren(), color.r, color.g, color.b, color.a)
            top: mutable f32 = disc.center.y - disc.radius
            bottom: mutable f32 = disc.center.y + disc.radius
            viewport_height: f32 = UiCore::viewport_height()
            return if bottom < 0.0 or top > viewport_height
            top <- 0.0 if top < 0.0
            bottom <- viewport_height if bottom > viewport_height
            # Iterate with an integer row index. At the f32 geometry cap
            # (2^24), adding 1.0 no longer changes a float, so a f32 loop
            # would never make progress on a perfectly finite circle.
            first: i64 = UiRaster::first_scanline(top).i64()
            last: i64 = UiRaster::last_scanline(bottom).i64()
            for y in first..<(last + 1):
                row: f32 = y.f32()
                offset: f32 = UiRaster::scanline_centre(row) - disc.center.y
                half: f32 = UiRaster::circle_half_width(disc.radius, offset)
                fill_span(disc.center.x - half, disc.center.x + half, row) if half > 0.0
                y <- y + 1

        def paint_triangle(tri: UiCore::Triangle, color: UiCore::Color) -> void:
            return if not viewport_is_drawable()
            _ = SDL_SetRenderDrawColor(ren(), color.r, color.g, color.b, color.a)
            xs: array[f32, 3] = [tri.a.x, tri.b.x, tri.c.x]
            ys: array[f32, 3] = [tri.a.y, tri.b.y, tri.c.y]
            ay: f32 = tri.a.y
            by: f32 = tri.b.y
            cy: f32 = tri.c.y
            lowest: f32 = ay if ay < by else by
            highest: f32 = ay if ay > by else by
            top: mutable f32 = lowest if lowest < cy else cy
            bottom: mutable f32 = highest if highest > cy else cy
            viewport_height: f32 = UiCore::viewport_height()
            return if bottom < 0.0 or top > viewport_height
            top <- 0.0 if top < 0.0
            bottom <- viewport_height if bottom > viewport_height
            # Keep the scanline counter integral for the same 2^24 progress
            # reason as circles: finite f32 coordinates must not turn into an
            # endless native render callback when y + 1.0 rounds back to y.
            first: i64 = UiRaster::first_scanline(top).i64()
            last: i64 = UiRaster::last_scanline(bottom).i64()
            for y in first..<(last + 1):
                sample: f32 = UiRaster::scanline_centre(y.f32())
                span_lo: mutable f32 = 0.0
                span_hi: mutable f32 = 0.0
                crossings: mutable i32 = 0
                for edge in 0..<3:
                    corner: usize = edge
                    next_corner: usize = (edge + 1) % 3
                    continue if not UiRaster::edge_straddles(ys[corner], ys[next_corner], sample)
                    crossed: f32 = UiRaster::edge_crossing(xs[corner], ys[corner], xs[next_corner], ys[next_corner], sample)
                    span_lo <- crossed if crossings == 0 or crossed < span_lo else span_lo
                    span_hi <- crossed if crossings == 0 or crossed > span_hi else span_hi
                    crossings <- crossings + 1
                fill_span(span_lo, span_hi, y) if crossings > 0

        def paint_clear(color: UiCore::Color) -> void:
            _ = SDL_SetRenderDrawColor(ren(), color.r, color.g, color.b, color.a)
            _ = SDL_RenderClear(ren())

        def paint_line(segment: UiCore::Line, color: UiCore::Color) -> void:
            _ = SDL_SetRenderDrawColor(ren(), color.r, color.g, color.b, color.a)
            _ = SDL_RenderLine(ren(), segment.from_point.x, segment.from_point.y, segment.to_point.x, segment.to_point.y)

    public:
        def has_drawable_viewport() -> bool:
            return viewport_is_drawable()

        def create_renderer(window: void&) -> bool:
            renderer <- SDL_CreateRenderer(window, null)
            return renderer != null

        def destroy_renderer() -> void:
            if renderer is done_renderer:
                SDL_DestroyRenderer(done_renderer)
            renderer <- null
            sdl3_clip_depth <- 0

        def present() -> void:
            _ = SDL_RenderPresent(ren())

        def set_font_override(path: cstr) -> void:
            font_override <- path

        def font_count() -> usize:
            return font_total

        def fonts_close() -> void:
            for index in 0..<font_total:
                if font_handles[index] is handle:
                    TTF_CloseFont(handle)
                font_handles[index] <- null
            font_total <- 0
            # The override is borrowed from getenv(). Do not retain that
            # process-owned pointer across a later backend run after the
            # previous font table has been torn down.
            font_override <- null

        def measure_text_width(text: sview, size: f32) -> f32:
            return 0.0 if text.len <= 0 or text.data == null
            safe_text: sview = UiCore::bounded_text(text)
            return 0.0 if safe_text.len <= 0 or safe_text.data == null
            if font_for(size) is font:
                measured_width: mutable i32 = 0
                measured_height: mutable i32 = 0
                pointer: cstr = safe_text.data.cast[cstr] can Unsafe.PointerCast
                if TTF_GetStringSize(font, pointer, safe_text.len.usize(), &measured_width, &measured_height):
                    return UiCore::bounded_extent(measured_width.f32())
            return 0.0

        def font_ascent(size: f32) -> f32:
            if font_for(size) is font:
                return UiCore::bounded_extent(TTF_GetFontAscent(font).f32())
            return UiCore::bounded_extent(size)

        def text_line_height(size: f32) -> f32:
            if font_for(size) is font:
                return UiCore::bounded_extent(TTF_GetFontHeight(font).f32())
            return UiCore::bounded_extent(size)

        struct Sdl3Painter:
            unused: i32

        impl Painter for Sdl3Painter:
            def push_clip(box: UiCore::Rect) -> void can[Ui.Draw]:
                if sdl3_clip_depth == 0:
                    saved_clip_enabled <- SDL_RenderClipEnabled(ren())
                    _ = SDL_GetRenderClipRect(ren(), (&saved_clip_rect[0]).cast[void&] can Unsafe.PointerCast)
                sdl3_clip_depth <- sdl3_clip_depth + 1
                left: f32 = floorf(box.origin.x)
                top: f32 = floorf(box.origin.y)
                right: f32 = ceilf(box.origin.x + box.size.width)
                bottom: f32 = ceilf(box.origin.y + box.size.height)
                clip: mutable i32[4] = [left.i32(), top.i32(), (right - left).i32(), (bottom - top).i32()]
                _ = SDL_SetRenderClipRect(ren(), (&clip[0]).cast[void&] can Unsafe.PointerCast)

            def pop_clip() -> void can[Ui.Draw]:
                return if sdl3_clip_depth == 0
                sdl3_clip_depth <- sdl3_clip_depth - 1
                return if sdl3_clip_depth != 0
                if saved_clip_enabled:
                    _ = SDL_SetRenderClipRect(ren(), (&saved_clip_rect[0]).cast[void&] can Unsafe.PointerCast)
                else:
                    _ = SDL_SetRenderClipRect(ren(), null)

            def clear(color: UiCore::Color) -> void can[Ui.Draw]:
                paint_clear(color)

            def fill_rect(box: UiCore::Rect, color: UiCore::Color) -> void can[Ui.Draw]:
                paint_rect(box, color)

            def fill_circle(disc: UiCore::Circle, color: UiCore::Color) -> void can[Ui.Draw]:
                paint_circle(disc, color)

            def fill_triangle(tri: UiCore::Triangle, color: UiCore::Color) -> void can[Ui.Draw]:
                paint_triangle(tri, color)

            def fill_line(segment: UiCore::Line, color: UiCore::Color) -> void can[Ui.Draw]:
                paint_line(segment, color)

            def draw_text(run: UiCore::TextRun, color: UiCore::Color) -> void can[Ui.Draw, Ui.Text]:
                blit_text(run, color)
