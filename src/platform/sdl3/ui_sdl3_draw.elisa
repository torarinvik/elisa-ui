# SDL3 drawing service for the native elisa-ui backend.
#
# This module owns renderer state, SDL_ttf font lifetime, raster-backed shape
# drawing, and the UiPaint painter specialization. UiSdl3 owns the window,
# event queue, and lifecycle loop; keeping those responsibilities separate
# makes the native boundary explicit without hiding it behind a facade.

module UiSdl3Draw:
    private:
        global mutable renderer: void&? = null
        # SDL object identities are kept as opaque integers so global state
        # does not extend an Elisa borrow past SDL's owning lifecycle.
        global mutable active_window: uintptr = 0.uintptr()
        global mutable saved_clip_rect: i32[4] = zeroed
        global mutable saved_clip_enabled: bool = false
        global mutable sdl3_clip_depth: usize = 0

        def ren() -> void&?:
            return renderer

        def blit_text(run: UiCore::TextRun, color: UiCore::Color) -> void:
            return if renderer == null
            return if run.text.len <= 0 or run.text.data == null
            safe_text: sview = UiCore::bounded_text(run.text)
            return if safe_text.len <= 0 or safe_text.data == null
            if UiSdl3Fonts::font_for(run.size) is font:
                if active_window != 0.uintptr():
                    can Unsafe.PointerCast:
                        window: void& = active_window.cast[void&]
                        UiSdl3TextCache::draw_text(ren(), window, font, run, color, safe_text)

        def paint_rect(box_rect: UiCore::Rect, color: UiCore::Color) -> void:
            return if renderer == null
            box: mutable array[f32, 4] = [box_rect.origin.x, box_rect.origin.y, box_rect.size.width, box_rect.size.height]
            _ = SDL_SetRenderDrawColor(ren(), color.r, color.g, color.b, color.a)
            rect_pointer: void& = (&box[0]).cast[void&] can Unsafe.PointerCast
            _ = SDL_RenderFillRect(ren(), rect_pointer)

        def fill_span(x0: f32, x1: f32, y: f32) -> void:
            return if x1 <= x0 or renderer == null
            span: mutable array[f32, 4] = [x0, y, x1 - x0, 1.0]
            span_pointer: void& = (&span[0]).cast[void&] can Unsafe.PointerCast
            _ = SDL_RenderFillRect(ren(), span_pointer)

        # A minimized or not-yet-sized surface has no drawable pixels. Keep
        # this check in the framework so shape rasterizers do not scan a huge
        # finite geometry range merely to have SDL clip every span away.
        def viewport_is_drawable() -> bool:
            return UiCore::viewport_width() > 0.0 and UiCore::viewport_height() > 0.0

        def paint_circle(disc: UiCore::Circle, color: UiCore::Color) -> void:
            return if renderer == null or not viewport_is_drawable()
            return if disc.radius <= 0.0
            _ = SDL_SetRenderDrawColor(ren(), color.r, color.g, color.b, color.a)
            top: mutable f32 = disc.center.y - disc.radius
            bottom: mutable f32 = disc.center.y + disc.radius
            viewport_height: f32 = UiCore::viewport_height()
            return if bottom < 0.0 or top > viewport_height
            top <- 0.0 if top < 0.0
            bottom <- viewport_height if bottom > viewport_height
            # Use an integer row index: f32 stops advancing at the geometry cap.
            first: i64 = UiRaster::first_scanline(top).i64()
            last: i64 = UiRaster::last_scanline(bottom).i64()
            for y in first..<(last + 1):
                row: f32 = y.f32()
                offset: f32 = UiRaster::scanline_centre(row) - disc.center.y
                half: f32 = UiRaster::circle_half_width(disc.radius, offset)
                fill_span(disc.center.x - half, disc.center.x + half, row) if half > 0.0

        def paint_triangle(tri: UiCore::Triangle, color: UiCore::Color) -> void:
            return if renderer == null or not viewport_is_drawable()
            _ = SDL_SetRenderDrawColor(ren(), color.r, color.g, color.b, color.a)
            xs: array[f32, 3] = [tri.a.x, tri.b.x, tri.c.x]
            ys: array[f32, 3] = [tri.a.y, tri.b.y, tri.c.y]
            ay: f32 = tri.a.y
            by: f32 = tri.b.y
            cy: f32 = tri.c.y
            lowest: f32 = ay if ay < by else by
            highest: f32 = ay if ay > by else by
            top: mutable f32 = lowest if lowest < cy else cy
            bottom: mutable f32 = highest if highest > cy else cy
            viewport_height: f32 = UiCore::viewport_height()
            return if bottom < 0.0 or top > viewport_height
            top <- 0.0 if top < 0.0
            bottom <- viewport_height if bottom > viewport_height
            # Keep the scanline counter integral for the same 2^24 progress
            # reason as circles: finite f32 coordinates must not turn into an
            # endless native render callback when y + 1.0 rounds back to y.
            first: i64 = UiRaster::first_scanline(top).i64()
            last: i64 = UiRaster::last_scanline(bottom).i64()
            for y in first..<(last + 1):
                sample: f32 = UiRaster::scanline_centre(y.f32())
                span_lo: mutable f32 = 0.0
                span_hi: mutable f32 = 0.0
                crossings: mutable i32 = 0
                for edge in 0..<3:
                    corner: usize = edge
                    next_corner: usize = (edge + 1) % 3
                    continue if not UiRaster::edge_straddles(ys[corner], ys[next_corner], sample)
                    crossed: f32 = UiRaster::edge_crossing(xs[corner], ys[corner], xs[next_corner], ys[next_corner], sample)
                    span_lo <- crossed if crossings == 0 or crossed < span_lo else span_lo
                    span_hi <- crossed if crossings == 0 or crossed > span_hi else span_hi
                    crossings <- crossings + 1
                fill_span(span_lo, span_hi, y) if crossings > 0

        def paint_clear(color: UiCore::Color) -> void:
            return if renderer == null
            _ = SDL_SetRenderDrawColor(ren(), color.r, color.g, color.b, color.a)
            _ = SDL_RenderClear(ren())

        def paint_line(segment: UiCore::Line, color: UiCore::Color) -> void:
            return if renderer == null
            _ = SDL_SetRenderDrawColor(ren(), color.r, color.g, color.b, color.a)
            _ = SDL_RenderLine(ren(), segment.from_point.x, segment.from_point.y, segment.to_point.x, segment.to_point.y)

        # SDL lines are one pixel; UiPaint owns pass spacing, this owns normal.
        def paint_stroke(segment: UiCore::Line, color: UiCore::Color, width: f32) -> void:
            return if renderer == null
            passes: usize = UiPaint::stroke_pass_count(width)
            return paint_line(segment, color) if passes <= 1
            dx: f32 = segment.to_point.x - segment.from_point.x
            dy: f32 = segment.to_point.y - segment.from_point.y
            length: f32 = UiCore::finite_or_zero(sqrtf(dx * dx + dy * dy))
            return paint_line(segment, color) if length <= 0.0
            normal_x: f32 = (0.0 - dy) / length
            normal_y: f32 = dx / length
            _ = SDL_SetRenderDrawColor(ren(), color.r, color.g, color.b, color.a)
            for pass_index in 0..<passes:
                shift: f32 = UiPaint::stroke_pass_offset(width, pass_index)
                _ = SDL_RenderLine(ren(),
                    segment.from_point.x + normal_x * shift, segment.from_point.y + normal_y * shift,
                    segment.to_point.x + normal_x * shift, segment.to_point.y + normal_y * shift)

    public:
        def has_drawable_viewport() -> bool:
            return viewport_is_drawable()

        def read_pixel_rgba(x: i32, y: i32, r: mutable u8&, g: mutable u8&, b: mutable u8&, a: mutable u8&) -> bool:
            return false if renderer == null
            if renderer is active_renderer:
                return UiSdl3Images::read_pixel_rgba(active_renderer, x, y, r, g, b, a)
            return false

        # Upload a caller-owned RGBA byte array into the renderer's retained
        # texture table. SDL_UpdateTexture copies the pixels before this call
        # returns, so the caller can release or reuse its buffer afterwards.
        # The explicit byte_length is part of the API safety contract: without
        # it row-stride validation cannot prove that SDL's read stays inside the
        # supplied allocation.
        def bind_image_rgba32(image: UiCore::ImageRef, pixels: u8&?, byte_length: usize, width: usize, height: usize, row_stride: usize) -> bool:
            return false if renderer == null
            if renderer is active_renderer:
                return UiSdl3Images::bind_image_rgba32(active_renderer, image, pixels, byte_length, width, height, row_stride)
            return false

        # Unbind only the exact slot+generation key supplied by the caller. A
        # stale handle cannot evict a newer generation occupying that slot.
        def unbind_image(image: UiCore::ImageRef) -> bool:
            return UiSdl3Images::unbind_image(image)

        # The query also lazily releases a matching texture when its logical
        # resource has been disposed or moved out of Ready state.
        def is_image_bound(image: UiCore::ImageRef) -> bool:
            return UiSdl3Images::is_image_bound(image)

        def image_binding_count() -> usize:
            return UiSdl3Images::image_binding_count()

        # These counters make retained-text reuse and its memory bound
        # observable to off-screen backend tests and profiling tools.
        def text_cache_count() -> usize:
            return UiSdl3TextCache::entry_count()

        def text_cache_bytes() -> usize:
            return UiSdl3TextCache::estimated_bytes()

        def text_cache_hits() -> u64:
            return UiSdl3TextCache::hits()

        def text_cache_misses() -> u64:
            return UiSdl3TextCache::misses()

        # Renderer loss invalidates every texture at once. Logical
        # UiResources identities survive and the host can upload them again
        # after the renderer has been recreated.
        def clear_image_bindings() -> void:
            UiSdl3Images::clear_image_bindings()

        def create_renderer(window: void&) -> bool:
            # A direct second create is treated like recreation; no texture may
            # outlive the renderer that created it.
            destroy_renderer() if renderer != null
            renderer <- SDL_CreateRenderer(window, null)
            if renderer != null:
                active_window <- window.cast[uintptr] can Unsafe.PointerCast
            return renderer != null

        def destroy_renderer() -> void:
            UiSdl3TextCache::clear()
            UiSdl3Images::clear_image_bindings()
            if renderer is done_renderer:
                SDL_DestroyRenderer(done_renderer)
            renderer <- null
            active_window <- 0.uintptr()
            sdl3_clip_depth <- 0

        # GPU device loss discards the renderer but not the window or the
        # application model. Recreate the renderer from the surviving window;
        # retained textures are destroyed before the old renderer and must be
        # rebound by the image owner after the new renderer is available.
        def recreate_renderer(window: void&) -> bool:
            destroy_renderer()
            return create_renderer(window)

        def present() -> void:
            return if renderer == null
            _ = SDL_RenderPresent(ren())

        def set_font_override(path: cstr) -> void:
            UiSdl3TextCache::clear()
            UiSdl3Fonts::set_font_override(path)

        def font_generation() -> u32:
            return UiSdl3Fonts::font_generation()

        def font_count() -> usize:
            return UiSdl3Fonts::font_count()

        def fonts_close() -> void:
            UiSdl3TextCache::clear()
            UiSdl3Fonts::fonts_close()

        def measure_text_width(text: sview, size: f32) -> f32:
            return UiSdl3Fonts::measure_text_width(text, size)

        def font_ascent(size: f32) -> f32:
            return UiSdl3Fonts::font_ascent(size)

        def text_line_height(size: f32) -> f32:
            return UiSdl3Fonts::text_line_height(size)

        struct Sdl3Painter:
            unused: i32

        def painter() -> Sdl3Painter:
            return Sdl3Painter{unused: 0}

        impl Painter for Sdl3Painter:
            def push_clip(self: Self, box: UiCore::Rect) -> void can[Ui.Draw]:
                return if renderer == null
                if sdl3_clip_depth == 0:
                    saved_clip_enabled <- SDL_RenderClipEnabled(ren())
                    _ = SDL_GetRenderClipRect(ren(), (&saved_clip_rect[0]).cast[void&] can Unsafe.PointerCast)
                sdl3_clip_depth <- sdl3_clip_depth + 1
                left: f32 = floorf(box.origin.x)
                top: f32 = floorf(box.origin.y)
                right: f32 = ceilf(box.origin.x + box.size.width)
                bottom: f32 = ceilf(box.origin.y + box.size.height)
                clip: mutable i32[4] = [left.i32(), top.i32(), (right - left).i32(), (bottom - top).i32()]
                _ = SDL_SetRenderClipRect(ren(), (&clip[0]).cast[void&] can Unsafe.PointerCast)

            def pop_clip(self: Self) -> void can[Ui.Draw]:
                return if sdl3_clip_depth == 0 or renderer == null
                sdl3_clip_depth <- sdl3_clip_depth - 1
                return if sdl3_clip_depth != 0
                if saved_clip_enabled:
                    _ = SDL_SetRenderClipRect(ren(), (&saved_clip_rect[0]).cast[void&] can Unsafe.PointerCast)
                else:
                    _ = SDL_SetRenderClipRect(ren(), null)

            def clear(self: Self, color: UiCore::Color) -> void can[Ui.Draw]:
                paint_clear(color)

            def fill_rect(self: Self, box: UiCore::Rect, color: UiCore::Color, style: UiCore::SurfaceStyle) -> void can[Ui.Draw]:
                paint_rect(box, color)

            def draw_image(self: Self, draw: UiCore::ImageDraw) -> void can[Ui.Draw]:
                return if renderer == null
                if renderer is active_renderer:
                    UiSdl3Images::draw_image(active_renderer, draw)

            def fill_circle(self: Self, disc: UiCore::Circle, color: UiCore::Color, depth: UiCore::SurfaceDepth) -> void can[Ui.Draw]:
                # SDL3's renderer has no shaded primitive, so a raised disc is
                # painted flat here exactly as a raised rectangle is.
                paint_circle(disc, color)

            def fill_triangle(self: Self, tri: UiCore::Triangle, color: UiCore::Color) -> void can[Ui.Draw]:
                paint_triangle(tri, color)

            def fill_line(self: Self, segment: UiCore::Line, color: UiCore::Color, width: f32) -> void can[Ui.Draw]:
                # Weight used to be recorded and lost here. It cost the
                # checkmark: two weighted diagonals drawn as hairlines is a
                # tick you cannot see, which is the defect the weight
                # vocabulary exists to fix.
                paint_stroke(segment, color, width)

            def draw_text(self: Self, run: UiCore::TextRun, color: UiCore::Color) -> void can[Ui.Draw, Ui.Text]:
                blit_text(run, color)
