# WHAT THE PLATFORM WANTS, ASKED OF THE PLATFORM.
#
# The framework lays out before a control exists, so without these an entry
# point has to invent a character width and a line height -- and a control
# handed a box smaller than UIKit builds its own for does not shrink, it
# truncates its words. Android was given real measurements and stopped clipping;
# iOS kept the guesses, and raising Dynamic Type is where that stops being
# survivable: the text grows and the boxes do not.
#
# A file of its own because ui_uikit_controls.elisa is at the length this
# project holds a source to, and measurement is a coherent piece of it.

extend UiUIKitControls:
    public:
        # WHAT THE PLATFORM WANTS, asked of the platform. The framework lays
        # out before a control exists, so without these an entry point has to
        # invent a character width and a line height -- and a control handed a
        # box smaller than UIKit builds its own for does not shrink, it
        # truncates its words. Raising Dynamic Type is where invented numbers
        # stop being survivable: the text grows and the boxes do not.
        def measure_text(text: sview, size: f32, weighted: bool) -> f32:
            safe: sview = UiCore::bounded_text(text)
            return 0.0 if safe.len <= 0
            empty: cstr = ""
            pointer: mutable cstr = empty
            pointer <- safe.data.cast[cstr] can Unsafe.PointerCast
            return elisa_uikit_controls_measure_text(pointer, safe.len.i32(), size, 1 if weighted else 0)

        def line_height(size: f32) -> f32:
            measured: f32 = elisa_uikit_controls_line_height(size)
            return measured if measured > 0.0
            return size * 1.3

        def minimum_height(kind: UiControls::ControlKind) -> f32:
            return elisa_uikit_controls_minimum_height(kind.i32())

        # The other dimension, for the kinds whose width is a property of the
        # control rather than of its words. A UISwitch is about 51 points wide
        # whatever box it is given, so a toggle sized for a painted tick mark
        # cut the switch in half -- the height lesson, one dimension over.
        def minimum_width(kind: UiControls::ControlKind) -> f32:
            return elisa_uikit_controls_minimum_width(kind.i32())
