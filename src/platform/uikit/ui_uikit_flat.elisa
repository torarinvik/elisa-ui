# Ready-to-use UIKit adapter for the allocation-free UiFlat layer.
#
# The generic UIKit host deliberately knows only UiCore. These callbacks
# connect touch, hardware keys, the software keyboard and VoiceOver actions to
# UiFlat, so an application entry point needs one include instead of repeating
# ABI glue.

include "./ui_uikit.elisa"
include "./ui_uikit_clipboard.elisa"
include "../../widgets/ui_handles.elisa"

# A touch is both a pointer transition and a text-selection click. Keeping that
# ordering here means every native host reports the same interaction; the shim
# only forwards UIKit's raw phase and location.
def uikit_flat_touch(view_handle: usize, phase: i32, x: f32, y: f32, tap_count: i32) -> void:
    return if not UiUIKit::live() or not UiLifecycle::accepts_input()
    return if view_handle != UiUIKit::view_handle()
    return if not UiUIKit::touch_phase_is_valid(phase)
    return if not UiCore::is_finite(x) or not UiCore::is_finite(y)
    if UiUIKit::phase_needs_synthetic_move(phase):
        lifetime: usize = UiFlat::lifetime()
        uikit_touch(view_handle, phase, x, y, tap_count)
        # The press may synchronously dispatch an application callback that
        # rebuilds the retained tree or stops the session. The original touch
        # must not then select text in the replacement tree.
        return if UiFlat::lifetime() != lifetime or not UiUIKit::live() or not UiLifecycle::accepts_input()
        UiFlat::select_text_click_at_pointer(x, y, UiUIKit::touch_button(), tap_count)
        # Selection runs after the pointer router's redraw, so ask for one more
        # paint for the selection change itself.
        UiUIKit::redraw() if UiUIKit::live()
        uikit_flat_sync_keyboard()
        return
    uikit_touch(view_handle, phase, x, y, tap_count)

# The software keyboard follows focus. UIKit only raises it for a first
# responder that reports it accepts text, so the framework asks for -- and
# resigns -- first responder as the retained focus changes.
def uikit_flat_sync_keyboard() -> void:
    return if not UiUIKit::live()
    UiUIKit::set_text_input(UiFlat::accepts_text())

def uikit_flat_wants_keyboard(view_handle: usize) -> i32:
    return 0 if not UiUIKit::live() or view_handle != UiUIKit::view_handle()
    return 1 if UiFlat::accepts_text() else 0

def uikit_flat_has_text(view_handle: usize) -> i32:
    return 0 if not UiUIKit::live() or view_handle != UiUIKit::view_handle()
    return 0 if not UiFlat::accepts_text()
    return 1 if UiFlat::accessibility_text_value(UiFlat::focused()).len > 0 else 0

# UIKeyInput's insertText: is the software keyboard's only text entry point. It
# carries a plain string; Elisa copies it into its own bounded staging buffer
# before UiFlat sees it, so no borrowed UIKit text is retained.
def uikit_flat_insert_text(view_handle: usize, text: usize) -> void:
    return if not UiUIKit::live() or view_handle != UiUIKit::view_handle()
    return if not UiLifecycle::accepts_input() or not UiFlat::accepts_text() or text == 0
    length: usize = UiUIKitClipboard::copy_native_text(text)
    lifetime: usize = UiFlat::lifetime()
    UiFlat::insert_text(UiUIKitClipboard::native_text_view(length))
    UiUIKitClipboard::scrub_native_text()
    return if UiFlat::lifetime() != lifetime or not UiUIKit::live()
    UiUIKit::redraw()

def uikit_flat_delete_backward(view_handle: usize) -> void:
    return if not UiUIKit::live() or view_handle != UiUIKit::view_handle()
    return if not UiLifecycle::accepts_input() or not UiFlat::accepts_text()
    lifetime: usize = UiFlat::lifetime()
    UiFlat::keyboard(UiCore::KeyEvent.Down(code: UiCore::Key.Backspace))
    return if UiFlat::lifetime() != lifetime or not UiUIKit::live()
    UiUIKit::redraw()

# Hardware keys arrive as UIPress. Elisa decides whether a chord is an editing
# action, ordinary text, or a raw key the application should see.
def uikit_flat_press(view_handle: usize, usage: i32, flags: i64, down: i32) -> void:
    return if not UiUIKit::live() or not UiLifecycle::accepts_input()
    return if view_handle != UiUIKit::view_handle()
    return if not uikit_boolean_flag_is_valid(down)
    if down == 1:
        route: i32 = UiUIKit::press_route(UiFlat::accepts_text(), usage, flags)
        if route >= 2:
            _ = uikit_flat_perform_text_action(route - 1)
            return
    uikit_press(view_handle, usage, flags, down)
    uikit_flat_sync_keyboard()

def uikit_flat_perform_text_action(action: i32) -> i32:
    return 0 if not UiUIKit::live() or not UiLifecycle::accepts_input()
    lifetime: usize = UiFlat::lifetime()
    performed: bool = UiFlat::perform_text_action(action)
    return 0 if not performed
    return 0 if UiFlat::lifetime() != lifetime or not UiUIKit::live()
    UiUIKit::redraw()
    return 1

# The iOS edit menu. UIKit asks a responder which standard editing actions it
# can perform and then sends the matching selector. Elisa decodes the opaque
# SEL through the runtime C ABI, maps the runtime spelling to its own action
# vocabulary, and answers from the retained text state -- so the shim never
# holds an action table or an enabled-ness rule.
def uikit_flat_text_action_for_selector(selector: cstr) -> i32:
    return 1 if uikit_cstr_equals(selector, "selectAll:")
    return 2 if uikit_cstr_equals(selector, "copy:")
    return 3 if uikit_cstr_equals(selector, "cut:")
    return 4 if uikit_cstr_equals(selector, "paste:")
    return 5 if uikit_cstr_equals(selector, "undo:")
    return 6 if uikit_cstr_equals(selector, "redo:")
    return 0

def uikit_flat_text_action_selector(view_handle: usize, selector: usize) -> void:
    return if not UiUIKit::live() or view_handle != UiUIKit::view_handle() or selector == 0
    action: i32 = uikit_flat_text_action_for_selector(sel_getName(selector))
    return if action == 0
    _ = uikit_flat_perform_text_action(action)

def uikit_flat_text_action_valid_selector(view_handle: usize, selector: usize) -> i32:
    return 0 if not UiUIKit::live() or view_handle != UiUIKit::view_handle() or selector == 0
    action: i32 = uikit_flat_text_action_for_selector(sel_getName(selector))
    return 0 if action == 0
    return 1 if UiFlat::text_action_enabled(action) else 0

# VoiceOver activation and adjustment. The native element is an opaque callback
# target; resolving it to a retained widget action happens in Elisa.
def uikit_flat_accessibility_activate(view_handle: usize, handle: usize) -> i32:
    return 0 if not UiUIKit::live() or view_handle != UiUIKit::view_handle() or not UiLifecycle::accepts_input()
    index: usize = UiUIKit::accessibility_action_for_handle(handle)
    return 0 if index == UiUIKit::not_found()
    activated: bool = UiFlat::activate(index)
    return 0 if not activated or not UiUIKit::live()
    UiUIKit::redraw()
    uikit_flat_sync_keyboard()
    return 1

def uikit_flat_accessibility_adjust(view_handle: usize, handle: usize, direction: i32) -> i32:
    return 0 if not UiUIKit::live() or view_handle != UiUIKit::view_handle() or not UiLifecycle::accepts_input()
    return 0 if direction != 1 and direction != -1
    index: usize = UiUIKit::accessibility_action_for_handle(handle)
    return 0 if index == UiUIKit::not_found()
    adjusted: bool = UiFlat::adjust_step(index, direction)
    return 0 if not adjusted or not UiUIKit::live()
    UiUIKit::redraw()
    return 1

# UIKit's increment/decrement selectors carry no direction argument, so the two
# tokens are framework facts the shim asks for rather than constants it holds.
def uikit_flat_accessibility_increment_direction() -> i32:
    return 1

def uikit_flat_accessibility_decrement_direction() -> i32:
    return -1

# An iPad with a trackpad or mouse does have hover, and a pointer whose shape
# follows the control under it. Both reuse the retained policy the macOS canvas
# already uses: the same Move event and the same cursor tokens
# (0 default, 1 an activating control, 2 text).
def uikit_flat_hover(view_handle: usize, x: f32, y: f32) -> void:
    return if not UiUIKit::live() or view_handle != UiUIKit::view_handle()
    return if not UiLifecycle::accepts_input()
    return if not UiCore::is_finite(x) or not UiCore::is_finite(y)
    uikit_dispatch_input_event(UiCore::PointerEvent.Move(at: UiCore::Vec2(x, y)))

def uikit_flat_hover_ended(view_handle: usize) -> void:
    return if not UiUIKit::live() or view_handle != UiUIKit::view_handle()
    return if not UiLifecycle::accepts_input()
    uikit_dispatch_input_event(UiCore::PointerEvent.Leave)

# The pointer's shape and the rectangle it snaps to are both retained-layout
# facts. Reporting the control's own frame is what lets iPadOS morph the
# pointer into it, so the geometry is resolved here rather than guessed from a
# touch radius in the shim.
def uikit_flat_pointer_region(view_handle: usize, x: f32, y: f32,
                              region_x: mutable f32&, region_y: mutable f32&,
                              region_width: mutable f32&, region_height: mutable f32&) -> i32:
    return -1 if region_x == null or region_y == null or region_width == null or region_height == null
    region_x <- 0.0
    region_y <- 0.0
    region_width <- 0.0
    region_height <- 0.0
    return -1 if not UiUIKit::live() or view_handle != UiUIKit::view_handle()
    return -1 if not UiCore::is_finite(x) or not UiCore::is_finite(y)
    target: usize = UiFlat::hit(x, y)
    return -1 if target == UiFlat::NONE
    widget: UiFlat::Widget = UiFlat::widget(target)
    region_x <- widget.x
    region_y <- widget.y
    region_width <- widget.width
    region_height <- widget.height
    return UiFlat::cursor_at(x, y)

include "./ui_uikit_flat_text.elisa"
include "./ui_uikit_flat_exports.elisa"
