# Externally mandated UIKit callback exports.
#
# Keeping this ABI-only surface separate makes it obvious which names are
# dictated by the Objective-C shim. The implementation and all policy remain in
# the Elisa adapter modules.

export fn elisa_uikit_touch(view_handle: usize, phase: i32, x: f32, y: f32, tap_count: i32) -> void = uikit_flat_touch
export fn elisa_uikit_press(view_handle: usize, usage: i32, flags: i64, down: i32) -> void = uikit_flat_press
export fn elisa_uikit_wants_keyboard(view_handle: usize) -> i32 = uikit_flat_wants_keyboard
export fn elisa_uikit_has_text(view_handle: usize) -> i32 = uikit_flat_has_text
export fn elisa_uikit_insert_text(view_handle: usize, text: usize) -> void = uikit_flat_insert_text
export fn elisa_uikit_delete_backward(view_handle: usize) -> void = uikit_flat_delete_backward
export fn elisa_uikit_accessibility_activate(view_handle: usize, handle: usize) -> i32 = uikit_flat_accessibility_activate
export fn elisa_uikit_accessibility_adjust(view_handle: usize, handle: usize, direction: i32) -> i32 = uikit_flat_accessibility_adjust
export fn elisa_uikit_accessibility_increment_direction() -> i32 = uikit_flat_accessibility_increment_direction
export fn elisa_uikit_accessibility_decrement_direction() -> i32 = uikit_flat_accessibility_decrement_direction
