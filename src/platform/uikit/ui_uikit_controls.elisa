# elisa-ui UIKit backend: the widget tree as real iOS controls.
#
# The sibling of the AppKit controls backend, and the opposite of the UIKit
# canvas. This one owns no pixels: it creates UILabels, UIButtons, UISliders and
# UITextFields and lets UIKit lay out their text, run the IME, mirror
# right-to-left, scale with Dynamic Type and talk to VoiceOver. None of that is
# reachable by drawing rectangles, which is the whole reason to want native
# controls.
#
# UiControls owns the index -> opaque handle table. The Objective-C shim
# resolves handles only at the UIKit boundary and keeps no second arena.

include "../../widgets/ui_controls.elisa"
include "../../core/ui_capabilities.elisa"

# `impl UiControls::Controls for T:` is rejected by stage0's parser, so the impl
# below names `Controls` unqualified and this is what resolves it.
using UiControls

include "./ui_uikit_controls_native.elisa"

module UiUIKitControls:
    public:
        # The UIKit controls backend. A TYPE, not a value: native handles live
        # in UiControls' retained records, so methods are static and the
        # specialization inlines straight through to typed C entry points.
        struct UiKitControls:
            unused: i32

        def native_handle(index: i32) -> usize:
            return 0 if index < 0
            return 0 if index.usize() >= UiControls::count()
            return UiControls::native_handle_at(index.usize())

    private:
        # iOS has exactly one window, supplied by the scene. A `Window` control
        # therefore becomes an ordinary container view: the framework keeps the
        # hierarchy it was given rather than inventing a second UIWindow that
        # the platform would never show.
        global mutable uikit_controls_root: usize = 0
        # The scene's own geometry, as UIKit last reported it. The tree is laid
        # out against the usable part of it, not against a size an application
        # guessed at build time.
        global mutable uikit_controls_width: f32 = 0.0
        global mutable uikit_controls_height: f32 = 0.0
        global mutable uikit_controls_inset_top: f32 = 0.0
        global mutable uikit_controls_inset_right: f32 = 0.0
        global mutable uikit_controls_inset_bottom: f32 = 0.0
        global mutable uikit_controls_inset_left: f32 = 0.0
        # An edit arrives as borrowed bytes; the seam keeps its view until the
        # next one, so they are copied here rather than into a caller's frame.
        global mutable uikit_controls_text_bytes: u8[UiCore::MAX_TEXT_BYTES] = zeroed

        # Keep the retained UIKit identity in the same Elisa record that owns
        # the control index. A child is attached only after its constructor
        # returned a non-zero handle, and the list is emitted parent-first, so
        # its parent already exists.
        def record_created(index: i32, handle: usize, parent: i32) -> void:
            return if handle == 0 or index < 0
            UiControls::set_native_handle(index.usize(), handle)
            parent_handle: usize = native_handle(parent)
            elisa_uikit_controls_add_child(parent_handle, handle) if parent >= 0 and parent_handle != 0

        # UIProgressView has no range of its own. Normalizing here keeps the
        # native bridge free of framework value policy, and matches what the
        # canvas backend speaks to VoiceOver.
        def progress_fraction(value: f32, low: f32, high: f32) -> f32:
            return 0.0 if not UiCore::is_finite(value) or not UiCore::is_finite(low) or not UiCore::is_finite(high)
            span: f32 = high - low
            return 0.0 if span <= 0.0
            fraction: f32 = (value - low) / span
            return 0.0 if fraction < 0.0
            return 1.0 if fraction > 1.0
            return fraction

        # A push button is the only kind whose selection UIKit must not toggle
        # for itself; the other three are selectable controls.
        def usable(value: f32) -> f32:
            return 0.0 if not UiCore::is_finite(value) or value < 0.0
            return value

        # WHICH MARK a selectable button wears when it has no caption to show.
        # Decided here rather than in the shim: the shim knows SF Symbols, this
        # knows widget kinds. Zero is a push button, which wears none -- and is
        # also why the old boolean spelling still reads correctly, since any
        # non-zero value means selectable to UIKit's selection behaviour.
        def button_mark_style(kind: UiControls::ControlKind) -> i32:
            return 1 if kind == UiControls::ControlKind.ToggleButton
            return 2 if kind == UiControls::ControlKind.CheckBox
            return 3 if kind == UiControls::ControlKind.RadioButton
            return 0

        def button_is_selectable(kind: UiControls::ControlKind) -> bool:
            return kind != UiControls::ControlKind.PushButton

        def packed_argb(color: UiCore::Color) -> u32:
            return (color.a.u32() << 24) | (color.r.u32() << 16) | (color.g.u32() << 8) | color.b.u32()

        def kind_is_button(kind: UiControls::ControlKind) -> bool:
            return kind == UiControls::ControlKind.PushButton or kind == UiControls::ControlKind.ToggleButton or kind == UiControls::ControlKind.CheckBox or kind == UiControls::ControlKind.RadioButton

    public:
        impl Controls for UiKitControls:
            def create(index: i32, kind: UiControls::ControlKind, parent: i32, window_mode: UiControls::WindowMode, axis: UiConst::Axis, state: UiControls::ControlState) -> void:
                can Ui.Controls:
                    # A window's decoration mode has no iOS meaning: the scene
                    # owns the only surface. Accepting the value and ignoring
                    # it is honest; refusing to realize the tree would not be.
                    _ = window_mode
                    if kind == UiControls::ControlKind.Window or kind == UiControls::ControlKind.Panel:
                        record_created(index, elisa_uikit_controls_create_view(), parent)
                        return
                    if kind == UiControls::ControlKind.ScrollView:
                        vertical: i32 = 0 if axis == UiConst::Axis.Row else 1
                        horizontal: i32 = 1 if axis == UiConst::Axis.Row else 0
                        record_created(index, elisa_uikit_controls_create_scroll_view(vertical, horizontal), parent)
                        return
                    if kind == UiControls::ControlKind.Label:
                        record_created(index, elisa_uikit_controls_create_label(), parent)
                        return
                    if kind_is_button(kind):
                        # A UISwitch is the iOS control for a bare boolean, but
                        # it carries no caption of its own. A selectable
                        # UIButton keeps the widget's text visible and is the
                        # same control iOS itself uses for check and radio
                        # rows, so a labelled boolean stays readable.
                        record_created(index, elisa_uikit_controls_create_button(button_mark_style(kind)), parent)
                        return
                    if kind == UiControls::ControlKind.TextField:
                        record_created(index, elisa_uikit_controls_create_text_field(), parent)
                        return
                    if kind == UiControls::ControlKind.Slider:
                        record_created(index, elisa_uikit_controls_create_slider(state.low, state.high, state.value), parent)
                        return
                    if kind == UiControls::ControlKind.ProgressBar:
                        record_created(index, elisa_uikit_controls_create_progress(), parent)

            def set_frame(index: i32, kind: UiControls::ControlKind, box: UiCore::Rect) -> void:
                can Ui.Controls:
                    handle: usize = native_handle(index)
                    return if handle == 0
                    elisa_uikit_controls_set_frame(handle, box.origin.x, box.origin.y, box.size.width, box.size.height)
                    if kind == UiControls::ControlKind.ScrollView:
                        elisa_uikit_controls_set_content_size(handle, box.size.width, box.size.height)

            # WHICH SLOT A COLOUR GOES IN is decided here, in typed Elisa, so
            # the shim stays a bridge with four setters and no policy: text
            # colour for anything that shows words, a background for anything
            # that is a surface, and a tint and a track for the two controls
            # that are a bar on a groove. A colour the hierarchy did not name
            # arrives with alpha zero and is not applied at all, which is what
            # leaves an unstyled control looking like iOS drew it -- because
            # iOS did.
            def set_colors(index: i32, kind: UiControls::ControlKind, ink: UiCore::Color, fill: UiCore::Color) -> void:
                can Ui.Controls:
                    handle: usize = native_handle(index)
                    return if handle == 0
                    if kind == UiControls::ControlKind.Slider or kind == UiControls::ControlKind.ProgressBar:
                        elisa_uikit_controls_set_tint_color(handle, packed_argb(ink)) if ink.a != 0
                        elisa_uikit_controls_set_track_color(handle, packed_argb(fill)) if fill.a != 0
                        return
                    if kind == UiControls::ControlKind.Label or kind == UiControls::ControlKind.TextField or kind_is_button(kind):
                        elisa_uikit_controls_set_text_color(handle, packed_argb(ink)) if ink.a != 0
                    elisa_uikit_controls_set_background_color(handle, packed_argb(fill)) if fill.a != 0

            def set_text(index: i32, kind: UiControls::ControlKind, text: sview) -> void:
                # Native controls copy this borrowed CoreFoundation string in
                # their own setter, so the bridge performs only the assignment.
                value: usize = native_string(text)
                return if value == 0
                handle: usize = native_handle(index)
                if kind_is_button(kind):
                    elisa_uikit_controls_set_button_title(handle, value)
                if kind == UiControls::ControlKind.Label:
                    elisa_uikit_controls_set_label_text(handle, value)
                if kind == UiControls::ControlKind.TextField:
                    elisa_uikit_controls_set_field_text(handle, value)
                # A window has no title bar on iOS and a slider or progress bar
                # has no caption, so the text becomes what VoiceOver reads.
                if kind == UiControls::ControlKind.Window or kind == UiControls::ControlKind.Slider or kind == UiControls::ControlKind.ProgressBar:
                    elisa_uikit_controls_set_accessibility_label(handle, value)
                CFRelease(value)

            def set_action(index: i32, kind: UiControls::ControlKind) -> void:
                can Ui.Controls:
                    handle: usize = native_handle(index)
                    return if handle == 0
                    # A slider drags and a field types: both are value changes.
                    # A button is a primary action. The choice is the shared
                    # policy's, not UIKit's.
                    value_change: bool = UiControls::action_event_for(kind) == UiConst::WidgetEvent.Change
                    elisa_uikit_controls_set_action(handle, 1 if value_change else 0)

            def set_state(index: i32, kind: UiControls::ControlKind, state: UiControls::ControlState) -> void:
                can Ui.Controls:
                    handle: usize = native_handle(index)
                    return if handle == 0
                    # Enabled first, and for every kind: a disabled control has
                    # its own iOS look, its own contrast and its own answer for
                    # VoiceOver, and gets none of them by being drawn greyer.
                    elisa_uikit_controls_set_enabled(handle, 1 if state.enabled else 0)
                    if kind == UiControls::ControlKind.TextField:
                        # secureTextEntry is a property here, so a "show
                        # password" toggle needs no new control.
                        elisa_uikit_controls_set_secure(handle, 1 if state.secure else 0)
                        return
                    if kind == UiControls::ControlKind.ToggleButton or kind == UiControls::ControlKind.CheckBox or kind == UiControls::ControlKind.RadioButton:
                        elisa_uikit_controls_set_button_selected(handle, 1 if state.selected else 0)
                        return
                    if kind == UiControls::ControlKind.Slider:
                        elisa_uikit_controls_set_slider_state(handle, state.low, state.high, state.value)
                        return
                    if kind == UiControls::ControlKind.ProgressBar:
                        elisa_uikit_controls_set_progress(handle, progress_fraction(state.value, state.low, state.high))

            # A PLACEHOLDER IS THE FIELD'S OWN AFFORDANCE and the hint is what
            # VoiceOver adds after the label. Only a field has somewhere to put
            # the first; everything gets the second.
            def set_help(index: i32, kind: UiControls::ControlKind, placeholder: sview, help: sview) -> void:
                can Ui.Controls:
                    handle: usize = native_handle(index)
                    return if handle == 0
                    if kind == UiControls::ControlKind.TextField:
                        prompt: usize = native_string(placeholder)
                        if prompt != 0:
                            elisa_uikit_controls_set_placeholder(handle, prompt)
                            CFRelease(prompt)
                    hint: usize = native_string(help)
                    return if hint == 0
                    elisa_uikit_controls_set_accessibility_hint(handle, hint)
                    CFRelease(hint)

        # UIKit reports which control acted and what it now holds. Turning
        # that into a control index, recording the value and choosing the event
        # are all shared with every other native backend.
        def controls_action(handle: usize, value: f32, selected: bool) -> i32:
            index: i32 = UiControls::index_for_native_handle(handle)
            return index if index == UiControls::NO_PARENT
            kind: UiControls::ControlKind = UiControls::kind_at(index.usize())
            return UiControls::dispatch_native_action(handle, UiControls::action_event_for(kind), value, selected)

        # WHAT UIKIT'S OWN EDITOR PRODUCED. A UITextField reports an edit
        # after the IME, autocorrect, dictation or a paste have already had
        # their say, so what arrives here is the finished string and not a
        # keystroke. Copy it before dispatching: the bytes belong to a
        # CoreFoundation string the shim releases as soon as this returns, and
        # the seam keeps the view it is given until the next edit.
        def copy_native_text(text: cstr, length: i32) -> sview:
            return "" if length < 0
            room: usize = length.usize() if length.usize() < UiCore::MAX_TEXT_BYTES else UiCore::MAX_TEXT_BYTES
            for index in 0..<room:
                uikit_controls_text_bytes[index] <- uikit_controls_cstr_byte(text, index)
            return sview(&uikit_controls_text_bytes[0], 0, room.i64())

        def controls_text_action(handle: usize, text: cstr, length: i32) -> i32:
            return UiControls::dispatch_native_text(handle, copy_native_text(text, length))

        # Release the retained handles before the next realization. Children may
        # still be retained by their old superview, but dropping every Elisa
        # ownership reference lets ARC tear the old tree down without a second
        # native lifetime table.
        def release_native_handles() -> void:
            # UiControls emits parents before children, so release in reverse:
            # a parent's deallocation must not invalidate a child handle Elisa
            # still has to release.
            count: usize = UiControls::count()
            index: mutable usize = count
            for _ in 0..<count:
                index <- index - 1
                handle: usize = UiControls::native_handle_at(index)
                # Clear the ownership slot before crossing the boundary, so a
                # re-entrant lookup during teardown fails closed rather than
                # observing a handle whose retain is being relinquished.
                UiControls::set_native_handle(index, 0) if handle != 0
                elisa_uikit_controls_release(handle)

        # Realize a laid-out widget tree as native controls. Run
        # UiWidgets::layout first: every control is placed at the box it
        # computed.
        # REALIZING TWICE REPLACES THE INTERFACE. The scene calls this again
        # whenever its geometry changes -- a rotation, a split view -- and
        # releasing the bridge's retain does not take the old tree off the
        # screen: the scene's own view is still holding it. Detaching the old
        # root first is what makes the second call a replacement instead of a
        # second interface stacked on the first, with the dead one taking the
        # touches.
        #
        # The two halves are named because there are two ways to fill the
        # control list -- a UiWidgets hierarchy and the retained UiFlat tree --
        # and everything around the filling is the same for both.
        def begin_realize() -> void:
            can[Ui.Controls]:
                elisa_uikit_controls_remove_from_parent(native_handle(0)) if UiControls::count() > 0
                release_native_handles()

        def finish_realize() -> void:
            can[Ui.Controls]:
                # The realized root is emitted at index zero. Attaching it to
                # the scene's view is the one step neither walk can do,
                # because that view belongs to UIKit.
                root_handle: usize = native_handle(0)
                elisa_uikit_controls_add_child(uikit_controls_root, root_handle)
                # The walk placed the root at the origin of the box it was laid
                # out in. That box is the safe area, so the root moves to where
                # the safe area actually starts -- but only once the scene has
                # reported a geometry. Without one there is no safe area to
                # move to, and overriding the laid-out frame with zero would
                # hide the whole tree.
                if root_handle != 0 and scene_geometry_is_known():
                    elisa_uikit_controls_set_frame(root_handle, content_origin_x(), content_origin_y(), content_width(), content_height())

        def start() -> void:
            UiCapabilities::use_uikit_controls()

        def set_scene_root(view: usize) -> bool:
            return false if view == 0
            uikit_controls_root <- view
            return true

        # The scene's geometry, validated once. A malformed size is rejected
        # rather than laid out against.
        def set_scene_geometry(width: f32, height: f32, top: f32, right: f32, bottom: f32, left: f32) -> bool:
            return false if not UiCore::is_finite(width) or not UiCore::is_finite(height)
            return false if width <= 0.0 or height <= 0.0
            return false if not UiCore::is_finite(top) or not UiCore::is_finite(right)
            return false if not UiCore::is_finite(bottom) or not UiCore::is_finite(left)
            return false if top < 0.0 or right < 0.0 or bottom < 0.0 or left < 0.0
            uikit_controls_width <- width
            uikit_controls_height <- height
            uikit_controls_inset_top <- top
            uikit_controls_inset_right <- right
            uikit_controls_inset_bottom <- bottom
            uikit_controls_inset_left <- left
            return true

        # What an application should lay its tree out against: the scene minus
        # the notch, the home indicator and any rounded corner.
        def scene_geometry_is_known() -> bool:
            return uikit_controls_width > 0.0 and uikit_controls_height > 0.0

        def content_width() -> f32:
            return usable(uikit_controls_width - uikit_controls_inset_left - uikit_controls_inset_right)

        def content_height() -> f32:
            return usable(uikit_controls_height - uikit_controls_inset_top - uikit_controls_inset_bottom)

        def content_origin_x() -> f32:
            return uikit_controls_inset_left

        def content_origin_y() -> f32:
            return uikit_controls_inset_top

        def scene_root() -> usize:
            return uikit_controls_root

        def run() -> i64:
            start()
            return 0 if elisa_uikit_controls_run() == 0 else 1

# iOS hands the surface over after launch, so an application cannot realize its
# tree before entering UIKit the way the macOS entry point does. The scene calls
# this once its view has a real size; `app_controls_realize` is where the
# application builds, lays out and realizes.
def uikit_controls_realize(root_view: usize, width: f32, height: f32, safe_top: f32, safe_right: f32, safe_bottom: f32, safe_left: f32) -> i32:
    can Memory.Allocate, Abort.Panic, Ui.Controls, Unsafe.PointerCast:
        return 0 if not UiUIKitControls::set_scene_root(root_view)
        return 0 if not UiUIKitControls::set_scene_geometry(width, height, safe_top, safe_right, safe_bottom, safe_left)
        app_controls_realize()
        return 1

export fn elisa_uikit_controls_realize(root_view: usize, width: f32, height: f32, safe_top: f32, safe_right: f32, safe_bottom: f32, safe_left: f32) -> i32 = uikit_controls_realize

def uikit_controls_action(handle: usize, value: f32, selected: i32) -> i32:
    return UiUIKitControls::controls_action(handle, value, selected != 0)

export fn elisa_uikit_controls_action(handle: usize, value: f32, selected: i32) -> i32 = uikit_controls_action

# A field's text needs a channel of its own: the numeric action carries a value
# and a flag, and neither can hold a string.
def uikit_controls_text_action(handle: usize, text: cstr, length: i32) -> i32:
    return UiUIKitControls::controls_text_action(handle, text, length)

export fn elisa_uikit_controls_text_action(handle: usize, text: cstr, length: i32) -> i32 = uikit_controls_text_action

include "./ui_uikit_controls_metrics.elisa"
