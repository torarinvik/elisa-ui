# UIPasteboard access and the transient text staging buffer.
#
# The shim only hands over pasteboard objects and copied bytes. Elisa owns the
# bounded cache, its lifecycle invalidation and the scrubbing policy, so the
# flat adapter never retains borrowed UIKit text or stale session contents.

module UiUIKitClipboard:
    public:
        def has_text() -> bool:
            if uikit_cache_valid and uikit_cache_generation != UiLifecycle::generation():
                invalidate_cache()
            return uikit_cached_length > 0 if uikit_cache_valid
            # Read once and retain the bytes so UiFlat's enabled check and the
            # Paste action observe one native snapshot.
            scrub_buffer(&uikit_clipboard_buffer[0], UiFlat::TEXT_CAPACITY)
            native_text: usize = elisa_uikit_clipboard_read()
            uikit_cached_length <- UiUIKit::copy_native_string(native_text, &uikit_clipboard_buffer[0], UiFlat::TEXT_CAPACITY)
            CFRelease(native_text) if native_text != 0
            uikit_cache_valid <- true
            uikit_cache_generation <- UiLifecycle::generation()
            return uikit_cached_length > 0

        def write(bytes: u8&, length: usize) -> bool:
            return false if length > 0 and bytes == null
            native_text: usize = UiUIKit::native_string_bytes(bytes, length)
            return false if native_text == 0
            written: bool = elisa_uikit_clipboard_write(native_text) != 0
            CFRelease(native_text)
            invalidate_cache()
            return written

        def read(buffer: mutable u8&, capacity: usize) -> usize:
            return 0 if capacity > 0 and buffer == null
            if uikit_cache_valid and uikit_cache_generation != UiLifecycle::generation():
                invalidate_cache()
            available: mutable usize = uikit_cached_length if uikit_cache_valid else 0
            if not uikit_cache_valid:
                scrub_buffer(&uikit_clipboard_buffer[0], UiFlat::TEXT_CAPACITY)
                native_text: usize = elisa_uikit_clipboard_read()
                available <- UiUIKit::copy_native_string(native_text, &uikit_clipboard_buffer[0], UiFlat::TEXT_CAPACITY)
                CFRelease(native_text) if native_text != 0
            take: mutable usize = available if available < capacity else capacity
            source: sview = uikit_clipboard_buffer[0:take]
            take <- UiText::valid_utf8_prefix(source, take)
            for index in 0..<take:
                buffer[index] <- uikit_clipboard_buffer[index]
            invalidate_cache()
            return take

        # Native text callbacks use one private scratch arena. A returned view
        # is consumed synchronously before another callback can overwrite it,
        # so no transient native pointer escapes this module.
        def copy_native_text(native_text: usize) -> usize:
            return UiUIKit::copy_native_string(native_text, &uikit_native_text_buffer[0], UiFlat::TEXT_CAPACITY)

        def native_text_view(length: usize) -> sview:
            safe_length: usize = length if length < UiFlat::TEXT_CAPACITY else UiFlat::TEXT_CAPACITY
            return uikit_native_text_buffer[0:safe_length]

        def scrub_native_text() -> void:
            scrub_buffer(&uikit_native_text_buffer[0], UiFlat::TEXT_CAPACITY)

    private:
        global mutable uikit_clipboard_buffer: u8[UiFlat::TEXT_CAPACITY] = zeroed
        global mutable uikit_native_text_buffer: u8[UiFlat::TEXT_CAPACITY] = zeroed
        global mutable uikit_cached_length: usize = 0
        global mutable uikit_cache_valid: bool = false
        global mutable uikit_cache_generation: u32 = 0

        def scrub_buffer(buffer: mutable u8&, capacity: usize) -> void:
            for index in 0..<capacity:
                buffer[index] <- 0

        def invalidate_cache() -> void:
            scrub_buffer(&uikit_clipboard_buffer[0], UiFlat::TEXT_CAPACITY)
            uikit_cached_length <- 0
            uikit_cache_valid <- false
            uikit_cache_generation <- UiLifecycle::generation()

def ui_clipboard_has_text() -> bool:
    return UiUIKitClipboard::has_text()

def ui_clipboard_write(bytes: u8&, length: usize) -> bool:
    return UiUIKitClipboard::write(bytes, length)

def ui_clipboard_read(buffer: mutable u8&, capacity: usize) -> usize:
    return UiUIKitClipboard::read(buffer, capacity)
