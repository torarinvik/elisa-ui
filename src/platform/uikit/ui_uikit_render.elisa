# The UIKit painter. One CoreGraphics implementation of UiPaint::Painter that
# replays the retained command batch into the context UIKit supplies.

extend UiUIKit:
    public:
        struct UiKitPainter:
            unused: i32

        impl Painter for UiKitPainter:
            def push_clip(box: UiCore::Rect) -> void can[Ui.Draw]:
                context: usize = current_context()
                CGContextSaveGState(context)
                CGContextBeginPath(context)
                CGContextMoveToPoint(context, box.origin.x.f64(), box.origin.y.f64())
                CGContextAddLineToPoint(context, (box.origin.x + box.size.width).f64(), box.origin.y.f64())
                CGContextAddLineToPoint(context, (box.origin.x + box.size.width).f64(), (box.origin.y + box.size.height).f64())
                CGContextAddLineToPoint(context, box.origin.x.f64(), (box.origin.y + box.size.height).f64())
                CGContextClosePath(context)
                CGContextClip(context)
            def pop_clip() -> void can[Ui.Draw]:
                CGContextRestoreGState(current_context())
            def clear(color: UiCore::Color) -> void can[Ui.Draw]:
                context: usize = current_context()
                set_fill_color(context, color)
                CGContextBeginPath(context)
                CGContextMoveToPoint(context, 0.0, 0.0)
                CGContextAddLineToPoint(context, UiCore::viewport_width().f64(), 0.0)
                CGContextAddLineToPoint(context, UiCore::viewport_width().f64(), UiCore::viewport_height().f64())
                CGContextAddLineToPoint(context, 0.0, UiCore::viewport_height().f64())
                CGContextClosePath(context)
                CGContextFillPath(context)
            # The colour is passed to the STYLE, not just to the fill: the whole
            # depth policy is weighted by how light the surface is, and this
            # painter used to ask for a style that could not know.
            def fill_rect(box: UiCore::Rect, color: UiCore::Color, style: UiCore::SurfaceStyle) -> void can[Ui.Draw]:
                # An invisible fill must stay invisible. The depth treatment
                # paints a white sheen and a white rim that are NOT scaled by
                # the fill's alpha, so a transparent rect -- which the widget
                # layer emits for a ring that is currently off -- would come out
                # as a visible outline. Skia has guarded this since it grew the
                # gradients; this painter is where the frame is decided for
                # CoreGraphics.
                return if color.a == 0
                return if box.size.width <= 0.0 or box.size.height <= 0.0
                treatment: UiPaint::RoundedRectStyle = UiPaint::rounded_rect_style_for_shaped(box, style.depth, style.corner, color)
                draw_styled_depth_surface(current_context(), box, treatment, color, style)
            # No image support: this painter has none, so it draws nothing rather
            # than a placeholder. A grey rectangle where a thumbnail should be is
            # a worse frame than a gap, and it hides that the image never arrived.
            def draw_image(draw: UiCore::ImageDraw) -> void can[Ui.Draw]:
                _ = draw

            def fill_circle(disc: UiCore::Circle, color: UiCore::Color, depth: UiCore::SurfaceDepth) -> void can[Ui.Draw]:
                return if color.a == 0 or disc.radius <= 0.0
                if depth != UiCore::SurfaceDepth.Flat:
                    draw_depth_disc(current_context(), disc, color, depth)
                    return
                context: usize = current_context()
                set_fill_color(context, color)
                CGContextBeginPath(context)
                CGContextAddArc(context, disc.center.x.f64(), disc.center.y.f64(), disc.radius.f64(), 0.0, 6.283185307179586, 0)
                CGContextFillPath(context)
            def fill_triangle(tri: UiCore::Triangle, color: UiCore::Color) -> void can[Ui.Draw]:
                context: usize = current_context()
                set_fill_color(context, color)
                CGContextBeginPath(context)
                CGContextMoveToPoint(context, tri.a.x.f64(), tri.a.y.f64())
                CGContextAddLineToPoint(context, tri.b.x.f64(), tri.b.y.f64())
                CGContextAddLineToPoint(context, tri.c.x.f64(), tri.c.y.f64())
                CGContextClosePath(context)
                CGContextFillPath(context)
            def fill_line(segment: UiCore::Line, color: UiCore::Color, width: f32) -> void can[Ui.Draw]:
                return if color.a == 0 or width <= 0.0
                context: usize = current_context()
                set_stroke_color(context, color)
                CGContextSetLineWidth(context, width.f64())
                CGContextSetLineCap(context, CG_LINE_CAP_ROUND if UiPaint::stroke_cap_is_round(width) else CG_LINE_CAP_BUTT)
                CGContextBeginPath(context)
                CGContextMoveToPoint(context, segment.from_point.x.f64(), segment.from_point.y.f64())
                CGContextAddLineToPoint(context, segment.to_point.x.f64(), segment.to_point.y.f64())
                CGContextStrokePath(context)
            def draw_text(run: UiCore::TextRun, color: UiCore::Color) -> void can[Ui.Draw, Ui.Text]:
                return if run.text.len == 0
                safe_text: sview = UiCore::bounded_text(run.text)
                pointer: cstr = safe_text.data.cast[cstr] can Unsafe.PointerCast
                # WEIGHT IS THE FLAG, and only the flag.
                #
                # This used to read `run.weighted or run.size >= 19.0`. The size
                # half of that is older than the flag and outlived it: a large
                # label came out semibold here and regular under Skia, with
                # nothing in the model saying which was intended. An app that
                # wants a heavy heading marks it, and then every backend agrees.
                semibold: i32 = 1 if run.weighted else 0
                draw_text_line(pointer, safe_text.len, run.size, semibold, run.origin.x, run.origin.y, color)
