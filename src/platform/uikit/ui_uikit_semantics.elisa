# Publish the semantic frame to UIKit.
#
# Identity is decided here, from Elisa's own history of stable IDs, and sent to
# the shim as an explicit token. The bridge never infers reuse by probing an
# opaque element. The child list is replaced in one transaction: if it fails,
# the previous committed list and its ownership are left exactly as they were.

extend UiUIKit:
    private:
        # Resolve a bounded relationship ID to the staged semantic slot. A
        # missing parent is treated as a root: UiCore uses the max-node
        # sentinel for "no relationship", and an application may publish a
        # node before its optional container in a frame.
        def next_parent_index(index: usize, count: usize) -> usize:
            return UiCore::MAX_ACCESSIBILITY_NODES if index >= count
            parent_id: usize = uikit_accessibility_next_parent_ids[index]
            return UiCore::MAX_ACCESSIBILITY_NODES if parent_id >= UiCore::MAX_ACCESSIBILITY_NODES
            for candidate in 0..<count:
                return candidate if uikit_accessibility_next_ids[candidate] == parent_id
            return UiCore::MAX_ACCESSIBILITY_NODES

        # UIKit only sees roots through the view container. Reject a malformed
        # cycle before replacing that root array; otherwise a valid previous
        # tree could be hidden behind an unreachable accessibility island.
        def next_node_reaches_root(index: usize, count: usize) -> bool:
            return false if index >= count
            current: mutable usize = index
            for _ in 0..<count:
                parent: usize = next_parent_index(current, count)
                return true if parent >= count
                return false if parent == current
                current <- parent
            return false

        # Ordinary children are real UIAccessibilityElement objects, but their
        # parent container is still assigned by Elisa. Headless tests have no
        # native view, so the callback is deliberately skipped there.
        def apply_accessibility_containers(requested_count: usize) -> bool can Unsafe.PointerCast:
            return true if uikit_canvas_view == 0
            for index in 0..<requested_count:
                parent_index: usize = next_parent_index(index, requested_count)
                child: usize = uikit_accessibility_next_handles[index]
                return false if child == 0
                if parent_index >= requested_count:
                    return false if elisa_uikit_accessibility_set_container(uikit_canvas_view, child, uikit_canvas_view) == 0
                else:
                    parent: usize = uikit_accessibility_next_handles[parent_index]
                    return false if parent == 0
                    return false if elisa_uikit_accessibility_set_container(uikit_canvas_view, child, parent) == 0
            return true

        # Reused UIKit elements stay untouched while the replacement child list
        # is validated and committed. Applying their staged metadata afterward
        # keeps a failed commit from mutating the tree VoiceOver is still
        # reading, matching AppKit's two-phase accessibility transaction.
        def update_committed_elements(requested_count: usize) -> void can Unsafe.PointerCast:
            for index in 0..<requested_count:
                continue if not uikit_accessibility_next_needs_update[index]
                node: UiCore::AccessibilityNode = UiCore::accessibility_at(index)
                native_identifier: usize = native_string(accessibility_identifier(node.id))
                native_label: usize = native_string(node.label)
                native_hint: mutable usize = 0
                native_hint <- native_string(node.help) if node.help.len > 0
                native_value: usize = accessibility_value_string(node)
                _ = elisa_uikit_accessibility_update(uikit_canvas_view, uikit_accessibility_next_handles[index],
                    native_identifier, accessibility_traits(node.role, node.enabled, node.selected),
                    native_label, native_hint, native_value,
                    node.frame.origin.x, node.frame.origin.y,
                    node.frame.size.width, node.frame.size.height,
                    1 if node.enabled else 0)
                CFRelease(native_identifier) if native_identifier != 0
                CFRelease(native_label) if native_label != 0
                CFRelease(native_hint) if native_hint != 0
                CFRelease(native_value) if native_value != 0

        def commit_accessibility_children(requested_count: usize) -> bool can Unsafe.PointerCast:
            return false if requested_count > UiCore::MAX_ACCESSIBILITY_NODES
            for index in 0..<requested_count:
                return false if not next_node_reaches_root(index, requested_count)
            count: mutable usize = 0
            for index in 0..<requested_count:
                handle: usize = uikit_accessibility_next_handles[index]
                # A semantic frame is all-or-nothing. Compacting away a missing
                # element would let UIKit accept a shorter list than the one
                # Elisa published, leaving nodes assistive clients can never
                # reach.
                return false if handle == 0
                parent_index: usize = next_parent_index(index, requested_count)
                if parent_index >= requested_count:
                    uikit_accessibility_commit_handles[count] <- handle
                    count <- count + 1
            return false if count > UiCore::MAX_ACCESSIBILITY_NODES
            return false if requested_count > 0 and count == 0
            values_pointer: usize& = (&uikit_accessibility_commit_handles[0]).cast[usize&] can Unsafe.PointerCast
            children: usize = CFArrayCreate(0, values_pointer, count.i64(), 0)
            return false if children == 0
            committed: bool = elisa_uikit_accessibility_commit(uikit_canvas_view, children) != 0
            CFRelease(children)
            return committed

    public:
        def sync_accessibility() -> void can Unsafe.PointerCast:
            # Published unconditionally, as the macOS canvas does. Assistive
            # technology is not the only reader: Voice Control, Full Keyboard
            # Access, the accessibility inspector and UI automation all consume
            # this tree, and several of them have no public "is running" flag to
            # gate on. Skipping the pass when VoiceOver happens to be off made
            # the app invisible to every one of them.
            next_count: usize = UiCore::accessibility_count()
            previous_count: usize = uikit_accessibility_previous_count
            # A fresh tree is a new screen, not a layout change: VoiceOver
            # should announce it and move to its first element rather than
            # keep a cursor pointing into the retired one.
            screen_changed: bool = uikit_accessibility_force_layout
            layout_changed: mutable bool = screen_changed or next_count != previous_count
            focused_id: mutable usize = 0
            has_focus: mutable bool = false
            for retained_index in 0..<previous_count:
                uikit_accessibility_previous_retained[retained_index] <- false
            for index in 0..<next_count:
                node: UiCore::AccessibilityNode = UiCore::accessibility_at(index)
                traits: u64 = accessibility_traits(node.role, node.enabled, node.selected)
                native_identifier: usize = native_string(accessibility_identifier(node.id))
                native_label: usize = native_string(node.label)
                native_hint: mutable usize = 0
                native_hint <- native_string(node.help) if node.help.len > 0
                native_value: usize = accessibility_value_string(node)
                previous_index: usize = previous_accessibility_index(node.id)
                existed: bool = previous_index < previous_count
                previous_handle: usize = uikit_accessibility_previous_handles[previous_index] if existed else 0
                layout_changed <- true if index >= previous_count or uikit_accessibility_previous_ids[index] != node.id
                layout_changed <- true if existed and uikit_accessibility_previous_traits[previous_index] != traits
                layout_changed <- true if existed and uikit_accessibility_previous_parent_ids[previous_index] != node.parent_id
                layout_changed <- true if existed and uikit_accessibility_previous_first_child_ids[previous_index] != node.first_child_id
                layout_changed <- true if existed and uikit_accessibility_previous_next_sibling_ids[previous_index] != node.next_sibling_id
                layout_changed <- true if existed and uikit_accessibility_previous_has_collection_position[previous_index] != node.has_collection_position
                layout_changed <- true if existed and uikit_accessibility_previous_collection_positions[previous_index] != node.collection_position
                layout_changed <- true if existed and uikit_accessibility_previous_collection_sizes[previous_index] != node.collection_size
                layout_changed <- true if existed and uikit_accessibility_previous_collection_counts[previous_index] != node.collection_count
                is_new: i32 = 1 if not existed or previous_handle == 0 else 0
                handle: usize = elisa_uikit_accessibility_add(uikit_canvas_view, previous_handle, is_new,
                    native_identifier, traits, native_label, native_hint, native_value,
                    node.frame.origin.x, node.frame.origin.y,
                    node.frame.size.width, node.frame.size.height,
                    1 if node.enabled else 0)
                uikit_accessibility_next_ids[index] <- node.id
                uikit_accessibility_next_parent_ids[index] <- node.parent_id
                uikit_accessibility_next_first_child_ids[index] <- node.first_child_id
                uikit_accessibility_next_next_sibling_ids[index] <- node.next_sibling_id
                uikit_accessibility_next_handles[index] <- handle
                uikit_accessibility_next_needs_update[index] <- is_new == 0 and previous_handle != 0 and handle == previous_handle
                uikit_accessibility_next_traits[index] <- traits
                uikit_accessibility_next_has_collection_position[index] <- node.has_collection_position
                uikit_accessibility_next_collection_positions[index] <- node.collection_position
                uikit_accessibility_next_collection_sizes[index] <- node.collection_size
                uikit_accessibility_next_collection_counts[index] <- node.collection_count
                uikit_accessibility_next_actions[index] <- node.action
                if node.focused and not has_focus:
                    focused_id <- node.id
                    has_focus <- true
                uikit_accessibility_previous_retained[previous_index] <- true if existed and previous_handle != 0 and handle == previous_handle
                CFRelease(native_identifier) if native_identifier != 0
                CFRelease(native_label) if native_label != 0
                CFRelease(native_hint) if native_hint != 0
                CFRelease(native_value) if native_value != 0
            uikit_accessibility_stale_count <- 0
            for previous_index in 0..<previous_count:
                previous_handle: usize = uikit_accessibility_previous_handles[previous_index]
                if not uikit_accessibility_previous_retained[previous_index] and uikit_accessibility_stale_count < UiCore::MAX_ACCESSIBILITY_NODES:
                    uikit_accessibility_stale_handles[uikit_accessibility_stale_count] <- previous_handle
                    uikit_accessibility_stale_count <- uikit_accessibility_stale_count + 1
            if commit_accessibility_children(next_count):
                update_committed_elements(next_count)
                _ = apply_accessibility_containers(next_count)
                publish_accessibility_history(next_count)
                for stale_index in 0..<uikit_accessibility_stale_count:
                    stale_handle: usize = uikit_accessibility_stale_handles[stale_index]
                    elisa_uikit_accessibility_release(stale_handle) if stale_handle != 0
                    uikit_accessibility_stale_handles[stale_index] <- 0
                if screen_changed:
                    elisa_uikit_accessibility_post_screen_changed(uikit_canvas_view)
                elif layout_changed:
                    elisa_uikit_accessibility_post_layout_changed(uikit_canvas_view)
                # Moving the assistive cursor is a change in what the user is
                # on, not a repaint, so it is reported only when the retained
                # focus actually moved.
                if has_focus != uikit_accessibility_has_focus or focused_id != uikit_accessibility_focused_id:
                    uikit_accessibility_has_focus <- has_focus
                    uikit_accessibility_focused_id <- focused_id
                    elisa_uikit_accessibility_focus(uikit_canvas_view, focused_handle(focused_id)) if has_focus
                uikit_accessibility_force_layout <- false
            else:
                # Keep the old list and its ownership. Elements created during
                # this pass are not reachable from it, so release them; reused
                # handles remain owned by the previous-frame table.
                discard_uncommitted_elements(next_count, previous_count)
            uikit_accessibility_stale_count <- 0

    private:
        # Resolve a stable semantic ID to the element just committed for it.
        def focused_handle(id: usize) -> usize:
            for index in 0..<uikit_accessibility_previous_count:
                return uikit_accessibility_previous_handles[index] if uikit_accessibility_previous_ids[index] == id
            return 0

        def publish_accessibility_history(next_count: usize) -> void:
            uikit_accessibility_previous_count <- next_count
            for index in 0..<next_count:
                id: usize = uikit_accessibility_next_ids[index]
                uikit_accessibility_previous_ids[index] <- id
                uikit_accessibility_previous_slot_by_id[id] <- index if id < UiCore::MAX_ACCESSIBILITY_NODES
                uikit_accessibility_previous_parent_ids[index] <- uikit_accessibility_next_parent_ids[index]
                uikit_accessibility_previous_first_child_ids[index] <- uikit_accessibility_next_first_child_ids[index]
                uikit_accessibility_previous_next_sibling_ids[index] <- uikit_accessibility_next_next_sibling_ids[index]
                uikit_accessibility_previous_handles[index] <- uikit_accessibility_next_handles[index]
                uikit_accessibility_previous_traits[index] <- uikit_accessibility_next_traits[index]
                uikit_accessibility_previous_has_collection_position[index] <- uikit_accessibility_next_has_collection_position[index]
                uikit_accessibility_previous_collection_positions[index] <- uikit_accessibility_next_collection_positions[index]
                uikit_accessibility_previous_collection_sizes[index] <- uikit_accessibility_next_collection_sizes[index]
                uikit_accessibility_previous_collection_counts[index] <- uikit_accessibility_next_collection_counts[index]
                uikit_accessibility_previous_actions[index] <- uikit_accessibility_next_actions[index]

        def discard_uncommitted_elements(next_count: usize, previous_count: usize) -> void:
            for next_index in 0..<next_count:
                candidate: usize = uikit_accessibility_next_handles[next_index]
                known: mutable bool = false
                for known_index in 0..<previous_count:
                    known <- true if candidate != 0 and candidate == uikit_accessibility_previous_handles[known_index]
                if candidate != 0 and not known:
                    elisa_uikit_accessibility_release(candidate)
                uikit_accessibility_next_handles[next_index] <- 0
            for stale_index in 0..<uikit_accessibility_stale_count:
                uikit_accessibility_stale_handles[stale_index] <- 0
