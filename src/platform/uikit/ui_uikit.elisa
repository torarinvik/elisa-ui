# UIKit facade. Implementation is grouped by native boundary, retained state,
# input policy, text, rendering, surface facts, semantics, off-screen frames,
# session lifecycle and the ABI callbacks.

include "./ui_uikit_native.elisa"
include "./ui_uikit_types.elisa"
include "./ui_uikit_state.elisa"
include "./ui_uikit_input.elisa"
include "./ui_uikit_text.elisa"
include "./ui_uikit_render.elisa"
include "./ui_uikit_surface.elisa"
include "./ui_uikit_accessibility.elisa"
include "./ui_uikit_semantics.elisa"
include "./ui_uikit_snapshot.elisa"
include "./ui_uikit_app.elisa"
include "./ui_uikit_callbacks.elisa"

# Text metrics the core asks for by name. CoreText is the authority on both
# Apple platforms, so these forward straight into the UIKit text module.
def ui_measure_text_width(text: sview, size: f32) -> f32:
    return 0.0 if text.len <= 0 or text.data == null
    safe_text: sview = UiCore::bounded_text(text)
    return 0.0 if safe_text.len <= 0 or safe_text.data == null
    pointer: cstr = safe_text.data.cast[cstr] can Unsafe.PointerCast
    safe_size: f32 = UiCore::bounded_extent(size)
    semibold: i32 = 1 if safe_size >= 19.0 else 0
    return UiCore::bounded_extent(UiUIKit::text_width(pointer, safe_text.len, safe_size, semibold))

def ui_measure_text_height(text: sview, size: f32) -> f32:
    return UiUIKit::font_line_height(UiCore::bounded_extent(size))

def ui_font_ascent(size: f32) -> f32:
    return UiUIKit::font_ascent(UiCore::bounded_extent(size))

def ui_text_line_height(size: f32) -> f32:
    return UiUIKit::font_line_height(UiCore::bounded_extent(size))
