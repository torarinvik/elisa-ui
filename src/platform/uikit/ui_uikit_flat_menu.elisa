# Canvas edit-menu schema. UIKit presents objects; Elisa chooses the actions.
def uikit_text_menu_count() -> usize:
    return 4

def uikit_text_menu_selector(index: usize) -> cstr:
    return "selectAll:" if index == 0
    return "copy:" if index == 1
    return "cut:" if index == 2
    return "paste:" if index == 3
    return ""

def uikit_text_menu_title(index: usize) -> usize:
    return UiUIKit::native_string("Select All") if index == 0
    return UiUIKit::native_string("Copy") if index == 1
    return UiUIKit::native_string("Cut") if index == 2
    return UiUIKit::native_string("Paste") if index == 3
    return 0

def uikit_text_menu_keeps_open(index: usize) -> i32:
    return 1 if index == 0 else 0

export fn elisa_uikit_text_menu_count() -> usize = uikit_text_menu_count
export fn elisa_uikit_text_menu_selector(index: usize) -> cstr = uikit_text_menu_selector
export fn elisa_uikit_text_menu_title(index: usize) -> usize = uikit_text_menu_title
export fn elisa_uikit_text_menu_keeps_open(index: usize) -> i32 = uikit_text_menu_keeps_open
