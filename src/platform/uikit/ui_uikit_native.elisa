# UIKit native boundary.
#
# Every symbol the iOS host needs, declared once. The Objective-C shim owns
# object and protocol plumbing only: it creates the application, window, view
# controller and accessibility elements, and forwards raw facts. Sizing,
# routing, identity and lifecycle policy stay in the Elisa modules that extend
# UiUIKit.
#
# CoreGraphics and CoreText are shared by both Apple platforms, so the
# declarations below deliberately match the macOS canvas boundary exactly. The
# retained command batch is replayed through the same calls on both.

include "../../core/ui_paint.elisa"
include "../../core/ui_lifecycle.elisa"
include "../../core/ui_metrics.elisa"
include "../../core/ui_capabilities.elisa"
include "../mobile/ui_mobile_surface.elisa"
include "../../widgets/ui_theme.elisa"
