extern elisa_uikit_accessibility_release(handle: usize) -> void
extern elisa_uikit_accessibility_commit(view_handle: usize, children: usize) -> i32
extern elisa_uikit_accessibility_post_layout_changed(view_handle: usize) -> void
extern elisa_uikit_accessibility_post_screen_changed(view_handle: usize) -> void
# Move the assistive cursor to one committed element.
extern elisa_uikit_accessibility_focus(view_handle: usize, handle: usize) -> void
extern elisa_uikit_accessibility_is_running() -> i32

