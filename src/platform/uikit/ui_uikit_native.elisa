# Accessibility. Same identity contract as the macOS canvas: Elisa decides
# reuse and passes an explicit token; the shim never probes a handle.
extern elisa_uikit_accessibility_add(view_handle: usize, previous_handle: usize, is_new: i32, identifier: usize, traits: u64, label: usize, hint: usize, value: usize, x: f32, y: f32, width: f32, height: f32, enabled: i32) -> usize
