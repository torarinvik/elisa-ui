# Snapshot paths come from the process environment and are bounded by the
# platform's path limits in normal use. Keep the scan in Elisa so this backend
# does not acquire a libc dependency for one small string primitive, while the
# bound prevents an unterminated value from becoming an unbounded memory walk.
const UIKIT_PATH_SCAN_CAPACITY: usize = 4096

def uikit_cstr_byte(text: cstr, index: usize) -> u8:
    pointer: uintptr = text.cast[uintptr] can Unsafe.PointerCast
    return 0 if pointer == 0.uintptr()
    trusted [Unsafe.PointerCast, Unsafe.PointerArithmetic]:
        byte: u8& = (pointer + index.uintptr()).cast[u8&]
        return byte

def uikit_path_length(text: cstr) -> usize:
    pointer: uintptr = text.cast[uintptr] can Unsafe.PointerCast
    return 0 if pointer == 0.uintptr()
    length: usize =
        for index in 0..<UIKIT_PATH_SCAN_CAPACITY |length = UIKIT_PATH_SCAN_CAPACITY| -> length:
            value: u8 = uikit_cstr_byte(text, index)
            length <- index if value == 0
            break if value == 0
    # CAPACITY + 1 is an explicit invalid sentinel: a valid path can be exactly
    # CAPACITY bytes long, but this value had no terminator in the scan window.
    return UIKIT_PATH_SCAN_CAPACITY + 1 if length == UIKIT_PATH_SCAN_CAPACITY else length

def uikit_path_within_budget(length: usize) -> bool:
    return length <= UiCore::MAX_TEXT_BYTES

# Objective-C selector identity is irreducibly native; its editor meaning is
# not. Elisa decodes the opaque SEL through the runtime C ABI and owns what the
# runtime spelling means.
def uikit_cstr_equals(left: cstr, right: cstr) -> bool:
    left_pointer: uintptr = left.cast[uintptr] can Unsafe.PointerCast
    right_pointer: uintptr = right.cast[uintptr] can Unsafe.PointerCast
    return false if left_pointer == 0.uintptr() or right_pointer == 0.uintptr()
    condition: bool =
        for index in 0..<UIKIT_PATH_SCAN_CAPACITY |condition = false| -> condition:
            left_byte: u8 = uikit_cstr_byte(left, index)
            right_byte: u8 = uikit_cstr_byte(right, index)
            condition <- false if left_byte != right_byte
            break if left_byte != right_byte
            condition <- true if left_byte == 0
            break if left_byte == 0
    return condition
