# The immediate hierarchy, on iOS, as real UIKit controls.
#
# The half of the controls backend that knows UiWidgets. Its sibling next door
# knows the retained layer instead, and a program links one of the two --
# which is why this is a file rather than a branch.

include "./ui_uikit_controls.elisa"
include "../../widgets/ui_controls_hierarchy.elisa"

extend UiUIKitControls:
    public:
        def realize(root: UiWidgets::Widget) -> void:
            can[Ui.Controls]:
                begin_realize()
                UiControls::reset()
                UiControls::realize(root, UiControls::NO_PARENT, 0)
                UiControls::apply[UiKitControls]()
                finish_realize()
