# Surface facts from UIKit, layered onto the portable mobile surface policy.
#
# UIKit reports safe-area insets, a keyboard frame, a display scale and an
# interface orientation. None of those are decisions: this module validates
# them, feeds UiMobileSurface, and publishes the logical viewport the retained
# layout is built against. Applications read UiResponsive, never UIKit.

extend UiUIKit:
    public:
        def surface_started() -> bool:
            return UiLifecycle::surface_available()

        # A scene becomes usable once UIKit has given the view a real size.
        # Everything before that -- application launch, window construction --
        # is deliberately not a frame the retained model may be asked for.
        def begin_surface(width: f32, height: f32, scale: f32,
                          safe_top: f32, safe_right: f32, safe_bottom: f32, safe_left: f32) -> bool:
            return false if not surface_values_are_valid(width, height)
            return false if not insets_are_valid(safe_top, safe_right, safe_bottom, safe_left)
            safe: UiResponsive::Insets = UiResponsive::insets(safe_top, safe_right, safe_bottom, safe_left)
            return false if not UiMobileSurface::start(width, height, bounded_scale(scale), safe)
            UiCore::set_viewport(width, height)
            return true

        def resize_surface(width: f32, height: f32, scale: f32) -> bool:
            return false if not surface_values_are_valid(width, height)
            return false if not UiMobileSurface::resize(width, height, bounded_scale(scale))
            UiCore::set_viewport(width, height)
            return true

        def set_safe_area(top: f32, right: f32, bottom: f32, left: f32) -> bool:
            return false if not insets_are_valid(top, right, bottom, left)
            return UiMobileSurface::set_safe_area(UiResponsive::insets(top, right, bottom, left))

        # The software keyboard covers the bottom of the surface rather than
        # shrinking it. Publish it as an inset so a form can scroll its focused
        # field into the remaining content area.
        def set_keyboard(bottom: f32, visible: bool) -> bool:
            return false if not UiCore::is_finite(bottom) or bottom < 0.0
            return UiMobileSurface::set_keyboard(bottom, visible)

        def content_area() -> UiResponsive::ContentArea:
            return UiMobileSurface::snapshot().content

        def orientation() -> UiResponsive::Orientation:
            return UiMobileSurface::snapshot().orientation

        def scale() -> f32:
            return UiMobileSurface::snapshot().viewport.scale

    private:
        def surface_values_are_valid(width: f32, height: f32) -> bool:
            return UiCore::is_finite(width) and UiCore::is_finite(height) and width > 0.0 and height > 0.0

        def insets_are_valid(top: f32, right: f32, bottom: f32, left: f32) -> bool:
            return false if not UiCore::is_finite(top) or not UiCore::is_finite(right)
            return false if not UiCore::is_finite(bottom) or not UiCore::is_finite(left)
            return top >= 0.0 and right >= 0.0 and bottom >= 0.0 and left >= 0.0
