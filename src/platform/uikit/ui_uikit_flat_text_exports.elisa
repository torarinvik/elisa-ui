# Externally mandated UITextInput callback exports.

export fn elisa_uikit_text_length(view_handle: usize) -> usize = uikit_text_length
export fn elisa_uikit_text_clamp_offset(view_handle: usize, offset: usize) -> usize = uikit_text_clamp_offset
export fn elisa_uikit_text_offset_position(view_handle: usize, offset: usize, delta: i64) -> usize = uikit_text_offset_position
export fn elisa_uikit_text_in_range(view_handle: usize, location: usize, length: usize) -> usize = uikit_text_in_range
export fn elisa_uikit_text_replace_range(view_handle: usize, location: usize, length: usize, text: usize) -> void = uikit_text_replace_range
export fn elisa_uikit_text_selection_location(view_handle: usize) -> usize = uikit_text_selection_location
export fn elisa_uikit_text_selection_length(view_handle: usize) -> usize = uikit_text_selection_length
export fn elisa_uikit_text_set_selection(view_handle: usize, location: usize, length: usize) -> i32 = uikit_text_set_selection
export fn elisa_uikit_text_has_marked(view_handle: usize) -> i32 = uikit_text_has_marked
export fn elisa_uikit_text_marked_location(view_handle: usize) -> usize = uikit_text_marked_location
export fn elisa_uikit_text_marked_length(view_handle: usize) -> usize = uikit_text_marked_length
export fn elisa_uikit_text_set_marked(view_handle: usize, text: usize, selected_location: usize, selected_length: usize) -> void = uikit_text_set_marked
export fn elisa_uikit_text_unmark(view_handle: usize) -> void = uikit_text_unmark
export fn elisa_uikit_text_rect(view_handle: usize, location: usize, length: usize, x: mutable f32&, y: mutable f32&, width: mutable f32&, height: mutable f32&) -> i32 = uikit_text_rect
export fn elisa_uikit_text_offset_at_x(view_handle: usize, x: f32) -> usize = uikit_text_offset_at_x
