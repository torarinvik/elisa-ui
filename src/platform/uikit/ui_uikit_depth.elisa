# The CoreGraphics depth painter: UiPaint's style record turned into Quartz.
#
# WHY THIS FILE EXISTS. The custom UIKit painter used to ask for a style with
# `rounded_rect_style(box, elevated)` -- no colour, no recess -- and then draw
# two of the four things the record describes: the shadow and a flat white
# hairline. The sheen and the bevel were simply dropped. Skia drew all four, so
# one command list produced two different pictures depending on which custom
# backend the app was built against, which is the exact drift the shared
# `RoundedRectStyle` was introduced to prevent.
#
# WHY IT IS NOT SHARED CODE WITH SKIA. The policy IS shared -- every alpha,
# tint and direction below comes from UiPaint, and this file contains no
# appearance decision of its own. What cannot be shared is the primitive: Skia
# takes a gradient-shaded round rect directly, while Quartz has no such call and
# must clip to a path and fill it. That is the whole difference, and it is
# confined to `vertical_gradient` below.

include "../../core/ui_paint.elisa"

extend UiUIKit:
    private:
        # A linear gradient is defined by unpremultiplied RGBA in the space it
        # is created in, and by two points rather than a rectangle. UIKit hands
        # the view a top-left context already, so `near` is the top edge, the
        # same end the Skia and AppKit gradients start at.
        # Three stops, the middle at a position. Same call, one more colour
        # and one more location; see UiCore::SurfaceStyle for why a line is
        # not enough.
        def vertical_gradient3(context: usize, box: UiCore::Rect, near: UiCore::Color, mid: UiCore::Color, mid_at: f32, far: UiCore::Color, horizontal: bool) -> void can[Ui.Draw]:
            space: usize = CGColorSpaceCreateDeviceRGB()
            return if space == 0
            components: f64[12] = [
                color_component(near.r).f64(), color_component(near.g).f64(), color_component(near.b).f64(), color_component(near.a).f64(),
                color_component(mid.r).f64(), color_component(mid.g).f64(), color_component(mid.b).f64(), color_component(mid.a).f64(),
                color_component(far.r).f64(), color_component(far.g).f64(), color_component(far.b).f64(), color_component(far.a).f64(),
            ]
            locations: f64[3] = [0.0, mid_at.f64(), 1.0]
            component_pointer: f64& = (&components[0]).cast[f64&] can Unsafe.PointerCast
            location_pointer: f64& = (&locations[0]).cast[f64&] can Unsafe.PointerCast
            gradient: usize = CGGradientCreateWithColorComponents(space, component_pointer, location_pointer, 3)
            CGColorSpaceRelease(space)
            return if gradient == 0
            start: NativePoint = NativePoint{x: box.origin.x.f64(), y: box.origin.y.f64()}
            stop: NativePoint = NativePoint{x: (box.origin.x + box.size.width).f64() if horizontal else box.origin.x.f64(), y: box.origin.y.f64() if horizontal else (box.origin.y + box.size.height).f64()}
            CGContextDrawLinearGradient(context, gradient, start, stop, 0)
            CGGradientRelease(gradient)

        # AN INNER SHADOW IS INSIDE: clip to the shape, then fill the shape's
        # OUTSIDE -- a big rectangle with the shape cut out, even-odd -- with a
        # shadow attached. The fill lands outside the clip and only its
        # shadow falls in, which is a shadow cast by the lip onto the face.
        def inner_shadow(context: usize, box: UiCore::Rect, radius: f32, offset_y: f32, blur: f32, tint: UiCore::Color) -> void can[Ui.Draw]:
            return if tint.a == 0
            CGContextSaveGState(context)
            rounded_path(context, box, radius)
            CGContextClip(context)
            set_colored_shadow(context, 0.0, offset_y, blur, tint)
            set_fill_color(context, tint)
            margin: f32 = blur * 4.0 + 8.0
            CGContextBeginPath(context)
            CGContextMoveToPoint(context, (box.origin.x - margin).f64(), (box.origin.y - margin).f64())
            CGContextAddLineToPoint(context, (box.origin.x + box.size.width + margin).f64(), (box.origin.y - margin).f64())
            CGContextAddLineToPoint(context, (box.origin.x + box.size.width + margin).f64(), (box.origin.y + box.size.height + margin).f64())
            CGContextAddLineToPoint(context, (box.origin.x - margin).f64(), (box.origin.y + box.size.height + margin).f64())
            CGContextClosePath(context)
            rounded_subpath(context, box, radius)
            CGContextEOFillPath(context)
            CGContextRestoreGState(context)

        def vertical_gradient(context: usize, box: UiCore::Rect, near: UiCore::Color, far: UiCore::Color) -> void can[Ui.Draw]:
            space: usize = CGColorSpaceCreateDeviceRGB()
            return if space == 0
            components: f64[8] = [
                color_component(near.r).f64(), color_component(near.g).f64(),
                color_component(near.b).f64(), color_component(near.a).f64(),
                color_component(far.r).f64(), color_component(far.g).f64(),
                color_component(far.b).f64(), color_component(far.a).f64(),
            ]
            locations: f64[2] = [0.0, 1.0]
            component_pointer: f64& = (&components[0]).cast[f64&] can Unsafe.PointerCast
            location_pointer: f64& = (&locations[0]).cast[f64&] can Unsafe.PointerCast
            gradient: usize = CGGradientCreateWithColorComponents(space, component_pointer, location_pointer, 2)
            CGColorSpaceRelease(space)
            return if gradient == 0
            top: NativePoint = NativePoint{x: box.origin.x.f64(), y: box.origin.y.f64()}
            bottom: NativePoint = NativePoint{x: box.origin.x.f64(), y: (box.origin.y + box.size.height).f64()}
            CGContextDrawLinearGradient(context, gradient, top, bottom, 0)
            CGGradientRelease(gradient)

        # Light across the face of the surface, clipped to its own shape so the
        # wash cannot square off the corners the fill just rounded.
        def draw_surface_sheen(context: usize, box: UiCore::Rect, style: UiPaint::RoundedRectStyle) -> void can[Ui.Draw]:
            return if not UiPaint::has_sheen(style)
            CGContextSaveGState(context)
            rounded_path(context, box, style.radius)
            CGContextClip(context)
            vertical_gradient(context, box, UiPaint::sheen_near_color(style), UiPaint::sheen_far_color(style))
            CGContextRestoreGState(context)

        # The outline and the rim light are one stroke, so they are one gradient.
        # Quartz cannot shade a stroke, so the stroked outline is converted into
        # an area, clipped to, and filled with the gradient instead -- the same
        # pixels a shaded stroke would have covered.
        def draw_surface_rim(context: usize, box: UiCore::Rect, style: UiPaint::RoundedRectStyle) -> void can[Ui.Draw]:
            CGContextSaveGState(context)
            rounded_path(context, box, style.radius)
            CGContextSetLineWidth(context, style.hairline_width.f64())
            CGContextReplacePathWithStrokedPath(context)
            CGContextClip(context)
            vertical_gradient(context, box, UiPaint::rim_near_color(style), UiPaint::rim_far_color(style))
            CGContextRestoreGState(context)

        # One primitive, two meanings: see UiPaint::glow_shadow. Quartz hangs a
        # shadow off a drawing op, so the light is a fill of the surface's own
        # path with the glow attached -- and the fill that follows covers it.
        def draw_glow(context: usize, box: UiCore::Rect, style: UiPaint::RoundedRectStyle, glow: UiCore::Color) -> void can[Ui.Draw]:
            halo: UiPaint::RoundedRectStyle = UiPaint::glow_shadow(style, box)
            CGContextSaveGState(context)
            set_colored_shadow(context, halo.shadow_offset_x, halo.shadow_offset_y, halo.shadow_blur, glow)
            set_fill_color(context, glow)
            rounded_path(context, box, halo.radius)
            CGContextFillPath(context)
            CGContextRestoreGState(context)
            # ...and the core, tight to the edge. See UiPaint::glow_core.
            core: UiPaint::RoundedRectStyle = UiPaint::glow_core(style, box)
            CGContextSaveGState(context)
            set_colored_shadow(context, 0.0, 0.0, core.shadow_blur, glow)
            set_fill_color(context, glow)
            rounded_path(context, box, core.radius)
            CGContextFillPath(context)
            CGContextRestoreGState(context)

        # The ramp across a surface's own fill, clipped to its shape for the
        # same reason the sheen is: a wash cannot square off the corners the
        # fill just rounded.
        def draw_surface_ramp(context: usize, box: UiCore::Rect, style: UiPaint::RoundedRectStyle, color: UiCore::Color, surface: UiCore::SurfaceStyle) -> void can[Ui.Draw]:
            CGContextSaveGState(context)
            rounded_path(context, box, style.radius)
            CGContextClip(context)
            if UiCore::has_mid_stop(surface):
                vertical_gradient3(context, box, color, surface.gradient_mid, surface.gradient_mid_at, surface.gradient, surface.gradient_horizontal)
            elif surface.gradient_horizontal:
                vertical_gradient3(context, box, color, color, 0.5, surface.gradient, true)
            else:
                vertical_gradient(context, box, color, surface.gradient)
            CGContextRestoreGState(context)

        def draw_shadowed_body(context: usize, box: UiCore::Rect, style: UiPaint::RoundedRectStyle, color: UiCore::Color) -> void can[Ui.Draw]:
            shadow_alpha: f32 = style.shadow_alpha.f32() / 255.0
            CGContextSaveGState(context)
            set_shadow(context, style.shadow_offset_x, style.shadow_offset_y, style.shadow_blur, shadow_alpha) if shadow_alpha > 0.0
            set_fill_color(context, color)
            rounded_path(context, box, style.radius)
            CGContextFillPath(context)
            CGContextRestoreGState(context)

        # One rounded surface, in UiPaint's order: the shadow it casts, its own
        # fill, the light falling on it, and last the rim -- an edge that
        # anything else paints over stops being an edge.
        #
        # Named for the depth policy rather than for elevation because UiSkia
        # has a `draw_elevated_surface` of its own, and the AppKit+Skia
        # compositor puts both painters in one translation unit: the shared
        # name there resolved to the other backend and declined to compile.
        def draw_depth_surface(context: usize, box: UiCore::Rect, style: UiPaint::RoundedRectStyle, color: UiCore::Color) -> void can[Ui.Draw]:
            draw_styled_depth_surface(context, box, style, color, UiCore::surface_style(UiCore::SurfaceDepth.Flat))

        # ...and the same surface with the application's own paint record. The
        # ramp and the light are opt-in and a zeroed record has neither, which
        # is why the call above is the whole of the old behaviour.
        def draw_styled_depth_surface(context: usize, box: UiCore::Rect, style: UiPaint::RoundedRectStyle, color: UiCore::Color, surface: UiCore::SurfaceStyle) -> void can[Ui.Draw]:
            draw_glow(context, box, style, surface.glow) if UiCore::has_glow(surface)
            # CoreGraphics attaches a shadow to a DRAWING OP, so the two
            # layers are two fills of the same path. The second covers the
            # first's body exactly, and each shadow lands under its own fill,
            # which is the composite the single-pass Skia path produces.
            #
            # ...as long as the body is OPAQUE. Filling a translucent surface
            # twice composites its colour with itself, and the widget comes out
            # darker than the one the application asked for -- a visible bug
            # traded for an invisible shadow. Skia has no such constraint: its
            # shadow is a shape of its own, drawn before the one fill. This is
            # the one place the two cannot draw the identical picture, and a
            # translucent surface is the case where the contact layer is worth
            # least anyway.
            contact: UiPaint::RoundedRectStyle = UiPaint::contact_shadow(style)
            draw_shadowed_body(context, box, contact, color) if UiPaint::has_contact_shadow(style) and color.a == 255
            draw_shadowed_body(context, box, style, color)
            # Quartz cannot shade a fill and shadow it in one op, so the ramp
            # is a second, clipped pass over the body the shadow just placed.
            # A HORIZONTAL ramp is not expressible with the vertical helper
            # this painter has, so it is drawn vertically here and the
            # difference is recorded rather than hidden -- see docs/ui-glow.md.
            draw_surface_ramp(context, box, style, color, surface) if UiCore::has_gradient(surface)
            draw_surface_sheen(context, box, style)
            # GLASS HAS A THICKNESS. See UiPaint::is_glass and the Skia painter.
            if UiPaint::is_glass(style, color):
                inner_shadow(context, box, style.radius, UiPaint::glass_light_offset(box), UiPaint::glass_edge_blur(box), UiCore::rgba(255, 255, 255, UiPaint::GLASS_LIGHT_ALPHA))
                inner_shadow(context, box, style.radius, UiPaint::glass_shade_offset(box), UiPaint::glass_edge_blur(box), UiCore::rgba(0, 0, 0, UiPaint::GLASS_SHADE_ALPHA))
            draw_surface_rim(context, box, style)

        # A DISC is a rounded rectangle whose corner is its own radius.
        #
        # That identity is what lets a raised thumb reuse the whole surface
        # treatment -- shadow, fill, sheen, rim -- without one new primitive in
        # any backend. A slider thumb is the one control that is unambiguously
        # ON the surface rather than part of it, and it was the last thing in
        # the framework still painted as a flat disc of colour.
        def draw_depth_disc(context: usize, disc: UiCore::Circle, color: UiCore::Color, depth: UiCore::SurfaceDepth) -> void can[Ui.Draw]:
            box: UiCore::Rect = UiCore::Rect(disc.center.x - disc.radius, disc.center.y - disc.radius, disc.radius * 2.0, disc.radius * 2.0)
            style: UiPaint::RoundedRectStyle = UiPaint::rounded_rect_style_for_with_radius(box, depth, disc.radius, color)
            draw_depth_surface(context, box, style, color)

        # RETAINED IMAGES. A command names a picture by slot and generation;
        # this table is where the host said which CGImage that is, at the
        # moment it became ready. Nothing above the painter sees the handle.
        const MAX_IMAGE_BINDINGS: usize = 64
        global mutable uikit_image_slots: u32[64] = zeroed
        global mutable uikit_image_generations: u32[64] = zeroed
        global mutable uikit_image_handles: usize[64] = zeroed
        global mutable uikit_image_bound: bool[64] = zeroed

        # A slot and a generation, NOT a resource handle: the painter must
        # not depend on the resource subsystem -- the simulator smoke unit
        # does not carry it -- and those two numbers are all the command has.
        def bind_image(slot: u32, generation: u32, image: usize) -> bool:
            return false if image == 0 or generation == 0
            resource: UiCore::ImageRef = UiCore::image_ref(slot, generation)
            for index in 0..<MAX_IMAGE_BINDINGS:
                if uikit_image_bound[index] and uikit_image_slots[index] == resource.slot:
                    uikit_image_generations[index] <- resource.generation
                    uikit_image_handles[index] <- image
                    return true
            for index in 0..<MAX_IMAGE_BINDINGS:
                if not uikit_image_bound[index]:
                    uikit_image_bound[index] <- true
                    uikit_image_slots[index] <- resource.slot
                    uikit_image_generations[index] <- resource.generation
                    uikit_image_handles[index] <- image
                    return true
            return false

        def bound_image(image: UiCore::ImageRef) -> usize:
            for index in 0..<MAX_IMAGE_BINDINGS:
                if uikit_image_bound[index] and uikit_image_slots[index] == image.slot and uikit_image_generations[index] == image.generation:
                    return uikit_image_handles[index]
            return 0

        # A CGImage is drawn y-up; the painter's space is y-down. Flip about
        # the box so the picture lands upright, clip to the stated shape, and
        # let the fit policy -- shared with Skia -- say where it lands.
        def draw_bound_picture(context: usize, draw: UiCore::ImageDraw) -> void can[Ui.Draw]:
            image: usize = bound_image(draw.image)
            return if image == 0 or draw.alpha == 0
            radius: f32 = UiPaint::corner_radius_for(draw.box, draw.corner)
            CGContextSaveGState(context)
            rounded_path(context, draw.box, radius)
            CGContextClip(context)
            CGContextSetAlpha(context, color_component(draw.alpha).f64())
            source: UiCore::Size = UiCore::Size(CGImageGetWidth(image).f32(), CGImageGetHeight(image).f32())
            target: UiCore::Rect = UiPaint::fitted_rect(draw.box, source, draw.fit)
            CGContextTranslateCTM(context, 0.0, (target.origin.y * 2.0 + target.size.height).f64())
            CGContextScaleCTM(context, 1.0, -1.0)
            if draw.fit == UiCore::PictureFit.Tile:
                CGContextDrawTiledImage(context, NativeImageRect{x: target.origin.x.f64(), y: target.origin.y.f64(), width: source.width.f64(), height: source.height.f64()}, image)
            else:
                CGContextDrawImage(context, NativeImageRect{x: target.origin.x.f64(), y: target.origin.y.f64(), width: target.size.width.f64(), height: target.size.height.f64()}, image)
            CGContextRestoreGState(context)
