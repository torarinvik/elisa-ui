# Public records for the remote-rendering contract.

include "../../core/ui_core.elisa"

module UiRemote:
    public:
        const MAX_SCALE: f32 = 16.0

        const enum Presentation of i32:
            Unknown = 0
            TypedCommands = 1
            Framebuffer = 2
            Video = 3

        const enum ConnectionState of i32:
            Disconnected = 0
            Connecting = 1
            Connected = 2
            Suspended = 3

        struct Offer:
            typed_commands: bool
            framebuffer: bool
            video: bool
            physical_width: u32
            physical_height: u32
            scale: f32
            # Remote profiles are not all equal. These are the service facts a
            # host must declare before the UI can claim local-like behavior;
            # `limitations` turns a missing one into an explicit report instead
            # of a silent feature-parity claim.
            text_input: bool
            ime: bool
            semantics: bool
            clipboard: bool
            file_dialogs: bool

        # True means the feature is UNAVAILABLE. `any` is the quick gate for a
        # host that needs to warn before the session starts.
        struct Limitations:
            text_input: bool
            ime: bool
            semantics: bool
            clipboard: bool
            file_dialogs: bool
            any: bool

        struct Selection:
            accepted: bool
            presentation: Presentation
            scale: f32
            physical_width: f32
            physical_height: f32
            logical_width: f32
            logical_height: f32

        struct InputResult:
            accepted: bool
            stale: bool

        struct Snapshot:
            state: ConnectionState
            generation: u32
            selection: Selection
            input_sent: u64
            input_acked: u64
            input_pending: bool
            stale_input: bool
            overlay_visible: bool
