# Portable remote-rendering/input policy.
#
# The host still owns transport, sockets, video/framebuffer surfaces, and
# packet I/O. Elisa owns the negotiated presentation facts and the lifecycle
# rules that keep scale, disconnect overlays, and input acknowledgements
# consistent with the retained application state.

include "./ui_remote_types.elisa"
include "./ui_remote_policy.elisa"
include "./ui_remote_session.elisa"
