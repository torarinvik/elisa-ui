# Win32 native-controls boundary. One typed C entry per Win32 operation; every
# one receives values Elisa already decided.

extern elisa_win32_init() -> i32
extern elisa_win32_create_window(resizable: i32) -> usize
extern elisa_win32_create_panel(parent: usize) -> usize
extern elisa_win32_create_scroll(parent: usize, vertical: i32) -> usize
extern elisa_win32_create_label(parent: usize) -> usize
extern elisa_win32_create_button(parent: usize) -> usize
extern elisa_win32_create_check(parent: usize) -> usize
extern elisa_win32_create_radio(parent: usize) -> usize
extern elisa_win32_create_entry(parent: usize, secure: i32) -> usize
extern elisa_win32_create_slider(parent: usize, low: f32, high: f32, value: f32) -> usize
extern elisa_win32_create_progress(parent: usize) -> usize
extern elisa_win32_set_frame(handle: usize, x: f32, y: f32, width: f32, height: f32) -> void
extern elisa_win32_set_text(handle: usize, text: cstr) -> void
extern elisa_win32_set_help(handle: usize, placeholder: cstr, help: cstr) -> void
extern elisa_win32_set_state(handle: usize, value: f32, selected: i32, enabled: i32, secure: i32) -> void
extern elisa_win32_set_action(handle: usize) -> void
extern elisa_win32_is_class(handle: usize, name: cstr) -> i32
extern elisa_win32_is_enabled(handle: usize) -> i32
extern elisa_win32_is_checked(handle: usize) -> i32
extern elisa_win32_destroy_window(handle: usize) -> void
