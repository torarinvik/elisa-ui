# Pure WIT-to-UiCore input vocabulary conversions.
#
# WIT enums are ordinal values. Keeping their translation in this small
# backend-neutral module makes the ABI mapping testable without instantiating a
# Wasm component or importing host functions.

include "../../core/ui_core.elisa"

module UiWasmInput:
    public:
        def key_from_host(code: i32) -> i32:
            return UiCore::Key.Up.i32() if code == 1
            return UiCore::Key.Down.i32() if code == 2
            return UiCore::Key.Left.i32() if code == 3
            return UiCore::Key.Right.i32() if code == 4
            return UiCore::Key.Space.i32() if code == 5
            return UiCore::Key.Enter.i32() if code == 6
            return UiCore::Key.Escape.i32() if code == 7
            return UiCore::Key.W.i32() if code == 8
            return UiCore::Key.A.i32() if code == 9
            return UiCore::Key.S.i32() if code == 10
            return UiCore::Key.D.i32() if code == 11
            return UiCore::Key.Q.i32() if code == 12
            return UiCore::Key.E.i32() if code == 13
            return UiCore::Key.LeftShift.i32() if code == 14
            return UiCore::Key.LeftControl.i32() if code == 15
            return 0

        # The WIT pointer-button enum excludes primary because the original
        # pointer callback owns that path. Its ordinal maps to UiCore's
        # secondary button at +1.
        def button_from_host(button: i32) -> i32:
            return UiCore::NO_POINTER_BUTTON if button < 0 or button > 3
            return button + 1

        def gamepad_button_from_host(button: i32) -> i32:
            return UiCore::Pad.South.i32() if button == 0
            return UiCore::Pad.East.i32() if button == 1
            return UiCore::Pad.North.i32() if button == 2
            return UiCore::Pad.West.i32() if button == 3
            return UiCore::Pad.C.i32() if button == 4
            return UiCore::Pad.Z.i32() if button == 5
            return UiCore::Pad.LeftTrigger.i32() if button == 6
            return UiCore::Pad.LeftTrigger2.i32() if button == 7
            return UiCore::Pad.RightTrigger.i32() if button == 8
            return UiCore::Pad.RightTrigger2.i32() if button == 9
            return UiCore::Pad.Back.i32() if button == 10
            return UiCore::Pad.Start.i32() if button == 11
            return UiCore::Pad.Guide.i32() if button == 12
            return UiCore::Pad.LeftStick.i32() if button == 13
            return UiCore::Pad.RightStick.i32() if button == 14
            return UiCore::Pad.DPadUp.i32() if button == 15
            return UiCore::Pad.DPadDown.i32() if button == 16
            return UiCore::Pad.DPadLeft.i32() if button == 17
            return UiCore::Pad.DPadRight.i32() if button == 18
            return -1

        def gamepad_axis_from_host(axis: i32) -> i32:
            return UiCore::PadAxis.LeftX.i32() if axis == 0
            return UiCore::PadAxis.LeftY.i32() if axis == 1
            return UiCore::PadAxis.LeftZ.i32() if axis == 2
            return UiCore::PadAxis.RightX.i32() if axis == 3
            return UiCore::PadAxis.RightY.i32() if axis == 4
            return UiCore::PadAxis.RightZ.i32() if axis == 5
            return UiCore::PadAxis.DPadX.i32() if axis == 6
            return UiCore::PadAxis.DPadY.i32() if axis == 7
            return -1
