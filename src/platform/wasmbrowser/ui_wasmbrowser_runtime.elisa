module UiWasmBrowser:
    private:
        const WIRE_STRIDE: usize = 32
        const WIRE_CAPACITY: usize = UiCore::MAX_COMMANDS * WIRE_STRIDE
        const SEMANTIC_HEADER_BYTES: usize = 8
        const SEMANTIC_RECORD_BYTES: usize = 120
        const SEMANTIC_TEXT_CAPACITY: usize = UiCore::MAX_TEXT_BYTES * 3
        const SEMANTIC_CAPACITY: usize = SEMANTIC_HEADER_BYTES + UiCore::MAX_ACCESSIBILITY_NODES * SEMANTIC_RECORD_BYTES + SEMANTIC_TEXT_CAPACITY
        global mutable semantic_buffer: u8[SEMANTIC_CAPACITY] = zeroed
        global mutable semantic_sequence: u64 = 0
        global mutable diagnostics_published_sequence: u32 = 0

        global mutable wire_buffer: u8[WIRE_CAPACITY] = zeroed
        global mutable wire_cursor: usize = 0
        global mutable elapsed_time: f64 = 0.0

        const HOST_POINTER_DOWN: i32 = 0
        const HOST_POINTER_UP: i32 = 1
        const HOST_POINTER_MOVE: i32 = 2
        const HOST_POINTER_LEAVE: i32 = 3

        def wire_f32(base: usize, offset: usize, value: f32) -> void:
            trusted [Unsafe.PointerCast, Unsafe.PointerArithmetic, Unsafe.UncheckedIndex]:
                slot: mutable f32& = (&wire_buffer[base + offset]).cast[mutable f32&]
                slot[0] <- value

        def wire_color(base: usize, offset: usize, color: UiCore::Color) -> void:
            wire_buffer[base + offset] <- color.r
            wire_buffer[base + offset + 1] <- color.g
            wire_buffer[base + offset + 2] <- color.b
            wire_buffer[base + offset + 3] <- color.a

        def wire_u32(base: usize, offset: usize, value: uintptr) -> void:
            trusted [Unsafe.PointerCast, Unsafe.PointerArithmetic, Unsafe.UncheckedIndex]:
                slot: mutable u32& = (&wire_buffer[base + offset]).cast[mutable u32&]
                slot[0] <- value.u32()

        def wire_discriminant(base: usize, value: u8) -> void:
            wire_buffer[base] <- value
            wire_buffer[base + 1] <- 0
            wire_buffer[base + 2] <- 0
            wire_buffer[base + 3] <- 0

    private:
        def wire_reset() -> void:
            wire_cursor <- 0

        def wire_take_slot() -> usize:
            base: usize = wire_cursor
            wire_cursor <- wire_cursor + WIRE_STRIDE
            return base

        def encode_clear(base: usize, color: UiCore::Color) -> void:
            wire_discriminant(base, 0)
            wire_color(base, 4, color)

        def encode_fill_rect(base: usize, box: UiCore::Rect, color: UiCore::Color) -> void:
            wire_discriminant(base, 1)
            wire_f32(base, 4, box.origin.x)
            wire_f32(base, 8, box.origin.y)
            wire_f32(base, 12, box.size.width)
            wire_f32(base, 16, box.size.height)
            wire_color(base, 20, color)

        def encode_fill_circle(base: usize, disc: UiCore::Circle, color: UiCore::Color) -> void:
            wire_discriminant(base, 2)
            wire_f32(base, 4, disc.center.x)
            wire_f32(base, 8, disc.center.y)
            wire_f32(base, 12, disc.radius)
            wire_color(base, 16, color)

        def encode_fill_triangle(base: usize, tri: UiCore::Triangle, color: UiCore::Color) -> void:
            wire_discriminant(base, 3)
            wire_f32(base, 4, tri.a.x)
            wire_f32(base, 8, tri.a.y)
            wire_f32(base, 12, tri.b.x)
            wire_f32(base, 16, tri.b.y)
            wire_f32(base, 20, tri.c.x)
            wire_f32(base, 24, tri.c.y)
            wire_color(base, 28, color)

        # Line lowers to two points, the colour, and the stroke weight: 24
        # payload bytes, still inside the 28 the largest case (triangle) already
        # reserves, so the record's size and every earlier field keep their
        # offsets. A host that decoded lines before this reads exactly what it
        # read before and ignores the tail.
        def encode_fill_line(base: usize, segment: UiCore::Line, color: UiCore::Color, width: f32) -> void:
            wire_discriminant(base, 4)
            wire_f32(base, 4, segment.from_point.x)
            wire_f32(base, 8, segment.from_point.y)
            wire_f32(base, 12, segment.to_point.x)
            wire_f32(base, 16, segment.to_point.y)
            wire_color(base, 20, color)
            wire_f32(base, 24, width)

        # DISCRIMINANT SIX, and the record is additive: every field of every
        # other record stays where it was, so a host built before images
        # existed reads the same bytes at the same offsets and skips this one
        # by its unknown tag. What it must NOT do is go missing -- the host is
        # handed a COUNT, so a command that writes no record leaves it reading
        # one slot of whatever was there last frame. That is why this encoder
        # exists at all for a painter that cannot draw an image: the wire
        # carries the whole command list or it carries a lie.
        def encode_draw_image(base: usize, draw: UiCore::ImageDraw) -> void:
            wire_discriminant(base, 6)
            wire_f32(base, 4, draw.box.origin.x)
            wire_f32(base, 8, draw.box.origin.y)
            wire_f32(base, 12, draw.box.size.width)
            wire_f32(base, 16, draw.box.size.height)
            wire_u32(base, 20, draw.image.slot.uintptr())
            wire_u32(base, 24, draw.image.generation.uintptr())
            wire_buffer[base + 28] <- draw.alpha
            wire_buffer[base + 29] <- draw.corner.i32().u8()
            wire_buffer[base + 30] <- draw.fit.i32().u8()
            wire_buffer[base + 31] <- 0

        def encode_draw_text(base: usize, run: UiCore::TextRun, color: UiCore::Color) -> void:
            # text-run lowers to x, y, size, color, then the string's pointer and
            # length: 24 payload bytes, which still fits the 28 the largest case
            # (triangle) already reserves.
            wire_discriminant(base, 5)
            wire_f32(base, 4, run.origin.x)
            wire_f32(base, 8, run.origin.y)
            wire_f32(base, 12, run.size)
            wire_color(base, 16, color)
            safe_text: sview = UiCore::bounded_text(run.text)
            text_pointer: uintptr = safe_text.data.cast[uintptr] can Unsafe.PointerCast
            wire_u32(base, 20, text_pointer)
            wire_u32(base, 24, safe_text.len.u32().uintptr())

        def present() -> void:
            total: usize = UiCore::command_count()
            wire_reset()
            UiPaint::replay(painter())
            commands: void& = (&wire_buffer[0]).cast[void&] can Unsafe.PointerCast
            can Host.Present:
                host_present_commands(UiCore::viewport_width().u32(), UiCore::viewport_height().u32(), commands, total.u32())

        def semantic_u32(offset: usize, value: uintptr) -> void:
            trusted [Unsafe.PointerCast, Unsafe.PointerArithmetic, Unsafe.UncheckedIndex]:
                slot: mutable u32& = (&semantic_buffer[offset]).cast[mutable u32&]
                slot[0] <- value.u32()

        def semantic_f32(offset: usize, value: f32) -> void:
            trusted [Unsafe.PointerCast, Unsafe.PointerArithmetic, Unsafe.UncheckedIndex]:
                slot: mutable f32& = (&semantic_buffer[offset]).cast[mutable f32&]
                slot[0] <- value

        def present_semantics() -> void:
            total: mutable usize = UiCore::accessibility_count()
            total <- UiCore::MAX_ACCESSIBILITY_NODES if total > UiCore::MAX_ACCESSIBILITY_NODES
            sequence: u64 = semantic_sequence + 1
            semantic_sequence <- sequence
            semantic_u32(0, 1.uintptr())
            semantic_u32(4, total.u32().uintptr())
            text_cursor: mutable usize = SEMANTIC_HEADER_BYTES + total * SEMANTIC_RECORD_BYTES
            for index in 0..<total:
                node: UiCore::AccessibilityNode = UiCore::accessibility_at(index)
                base: usize = SEMANTIC_HEADER_BYTES + index * SEMANTIC_RECORD_BYTES
                semantic_u32(base + 0, node.id.uintptr())
                semantic_u32(base + 4, node.role.i32().u32().uintptr())
                semantic_f32(base + 8, node.frame.origin.x)
                semantic_f32(base + 12, node.frame.origin.y)
                semantic_f32(base + 16, node.frame.size.width)
                semantic_f32(base + 20, node.frame.size.height)
                semantic_u32(base + 24, node.action.uintptr())
                semantic_f32(base + 28, node.value)
                semantic_u32(base + 32, node.parent_id.uintptr())
                semantic_u32(base + 36, node.first_child_id.uintptr())
                semantic_u32(base + 40, node.next_sibling_id.uintptr())
                semantic_u32(base + 44, node.enabled.i32().u32().uintptr())
                semantic_u32(base + 48, node.focused.i32().u32().uintptr())
                semantic_u32(base + 52, node.selected.i32().u32().uintptr())
                safe_label: sview = UiCore::bounded_text(node.label)
                label_length: usize = safe_label.len if text_cursor + safe_label.len <= SEMANTIC_CAPACITY else 0
                semantic_u32(base + 56, node.revision.uintptr())
                semantic_u32(base + 60, node.selection_location.uintptr())
                semantic_u32(base + 64, node.selection_length.uintptr())
                semantic_u32(base + 68, node.has_range.i32().u32().uintptr())
                semantic_f32(base + 72, node.range_min)
                semantic_f32(base + 76, node.range_max)
                semantic_u32(base + 80, node.has_collection_position.i32().u32().uintptr())
                semantic_u32(base + 84, node.collection_position.uintptr())
                semantic_u32(base + 88, node.collection_size.uintptr())
                semantic_u32(base + 92, node.collection_count.uintptr())
                semantic_u32(base + 96, text_cursor.u32().uintptr())
                semantic_u32(base + 100, label_length.u32().uintptr())
                for byte_index in 0..<label_length:
                    semantic_buffer[text_cursor + byte_index] <- safe_label.data[byte_index]
                text_cursor <- text_cursor + label_length
                safe_help: sview = UiCore::bounded_text(node.help)
                help_length: usize = safe_help.len if text_cursor + safe_help.len <= SEMANTIC_CAPACITY else 0
                semantic_u32(base + 104, text_cursor.u32().uintptr())
                semantic_u32(base + 108, help_length.u32().uintptr())
                for byte_index in 0..<help_length:
                    semantic_buffer[text_cursor + byte_index] <- safe_help.data[byte_index]
                text_cursor <- text_cursor + help_length
                safe_value_text: sview = UiCore::bounded_text(node.text_value)
                value_text_length: usize = safe_value_text.len if text_cursor + safe_value_text.len <= SEMANTIC_CAPACITY else 0
                semantic_u32(base + 112, text_cursor.u32().uintptr())
                semantic_u32(base + 116, value_text_length.u32().uintptr())
                for byte_index in 0..<value_text_length:
                    semantic_buffer[text_cursor + byte_index] <- safe_value_text.data[byte_index]
                text_cursor <- text_cursor + value_text_length
            snapshot: mutable cstr = ""
            can Unsafe.PointerCast:
                snapshot <- (&semantic_buffer[0]).cast[cstr]
            can Host.Present:
                host_present_semantics(sequence, true, snapshot, text_cursor.u32())

        def publish_diagnostics() -> void:
            for index in 0..<UiDiagnostics::count():
                entry: UiDiagnostics::Record = UiDiagnostics::at(index)
                return if entry.sequence <= diagnostics_published_sequence
                source: mutable cstr = ""
                message: mutable cstr = ""
                can Unsafe.PointerCast:
                    source <- UiDiagnostics::source_data(entry).cast[cstr]
                    message <- UiDiagnostics::message_data(entry).cast[cstr]
                can Host.Log:
                    host_log_diagnostic(entry.severity.i32().u32(), entry.code, source, UiDiagnostics::source_length(entry).u32(), entry.line, entry.column, message, UiDiagnostics::message_length(entry).u32(), entry.redacted)
                diagnostics_published_sequence <- entry.sequence

        def dispatch(event: UiCore::Event) -> void:
            UiWasmDispatch::dispatch(event)

        def dispatch_input(event: UiCore::Event) -> void:
            UiWasmDispatch::dispatch_input(event)

        def dispatch_record(kind: i32, x: f32, y: f32, dx: f32, dy: f32, code: i32) -> void:
            record: UiCore::EventRecord = UiCore::EventRecord{kind: kind.WireKind(), x: x, y: y, dx: dx, dy: dy, code: code}
            dispatch(UiCore::from_record(record))

    public:
        def start(width: u32, height: u32) -> void:
            UiLifecycle::reset()
            UiCapabilities::use_wasm_browser()
            UiEvents::reset()
            UiMetrics::reset()
            UiDiagnostics::reset()
            UiCore::discard_frame()
            UiCore::clear_all_invalidations()
            return if not UiLifecycle::begin()
            UiWasmHostState::reset_clipboard()
            elapsed_time <- 0.0
            semantic_sequence <- 0
            diagnostics_published_sequence <- 0
            UiCore::set_frame_time(0.0)
            UiCore::set_viewport(width.f32(), height.f32())
            app_init()
            _ = UiLifecycle::ready()
            _ = UiLifecycle::focus_gained()

        def resize(width: u32, height: u32) -> void:
            return if not UiLifecycle::is_started()
            UiCore::set_viewport(width.f32(), height.f32())
            dispatch_record(UiCore::WireKind.Resize.i32(), width.f32(), height.f32(), 0.0, 0.0, 0)

        def frame(dt: f64) -> void:
            return if not UiLifecycle::can_render()
            safe_dt: f64 = UiCore::finite_or_zero_f64(dt)
            if safe_dt > 0.0:
                candidate: f64 = elapsed_time + safe_dt
                elapsed_time <- candidate if UiCore::finite_or_zero_f64(candidate) == candidate
            UiCore::set_frame_time(elapsed_time)
            UiMetrics::begin_frame(elapsed_time)
            UiCore::begin_frame()
            frame_generation: u32 = UiLifecycle::generation()
            app_frame()
            same_session: bool = UiLifecycle::generation() == frame_generation
            if same_session and UiLifecycle::can_render():
                UiMetrics::mark_application(elapsed_time)
                UiMetrics::mark_semantics(elapsed_time)
                publish_diagnostics()
                present_semantics()
                present()
                UiMetrics::mark_paint(elapsed_time)
            if same_session:
                UiMetrics::finish_frame(elapsed_time)

        def pointer(x: f32, y: f32, kind: i32) -> void:
            return if not UiWasmInput::pointer_values_are_finite(x, y, 0.0, 0.0)
            dispatch_record(UiCore::WireKind.PointerDown.i32(), x, y, 0.0, 0.0, UiCore::PointerButton.Primary.i32()) if kind == HOST_POINTER_DOWN
            dispatch_record(UiCore::WireKind.PointerUp.i32(), x, y, 0.0, 0.0, UiCore::PointerButton.Primary.i32()) if kind == HOST_POINTER_UP
            dispatch_record(UiCore::WireKind.PointerMove.i32(), x, y, 0.0, 0.0, 0) if kind == HOST_POINTER_MOVE
            dispatch_record(UiCore::WireKind.PointerLeave.i32(), 0.0, 0.0, 0.0, 0.0, 0) if kind == HOST_POINTER_LEAVE

        def key(code: i32, pressed: bool) -> void:
            mapped: i32 = UiWasmInput::key_from_host(code)
            return if mapped == 0
            dispatch_input((UiCore::KeyEvent.Down(code: UiCore::Key(mapped)))) if pressed
            dispatch_input((UiCore::KeyEvent.Up(code: UiCore::Key(mapped)))) if not pressed

        def pointer_button_input(x: f32, y: f32, button: i32, pressed: bool) -> void:
            return if not UiWasmInput::pointer_values_are_finite(x, y, 0.0, 0.0)
            at: UiCore::Vec2 = UiCore::Vec2(x, y)
            mapped: i32 = UiWasmInput::button_from_host(button)
            return if mapped < 0
            dispatch_input((UiCore::PointerEvent.Down(at: at, button: mapped))) if pressed
            dispatch_input((UiCore::PointerEvent.Up(at: at, button: mapped))) if not pressed

        def scroll_input(x: f32, y: f32, delta_x: f32, delta_y: f32) -> void:
            return if not UiWasmInput::pointer_values_are_finite(x, y, delta_x, delta_y)
            dispatch_input((UiCore::PointerEvent.Scroll(at: UiCore::Vec2(x, y), delta: UiCore::Vec2(delta_x, delta_y))))

        def gamepad_button_input(index: u32, button: i32, value: f32) -> void:
            mapped: i32 = UiWasmInput::gamepad_button_from_host(button)
            return if mapped < 0
            dispatch_input((UiCore::GamepadEvent.Button(button: UiCore::Pad(mapped), value: UiCore::normalized_unit(value))))

        def gamepad_axis_input(index: u32, axis: i32, value: f32) -> void:
            mapped: i32 = UiWasmInput::gamepad_axis_from_host(axis)
            return if mapped < 0
            dispatch_input((UiCore::GamepadEvent.Axis(axis: UiCore::PadAxis(mapped), value: UiWasmInput::axis_value(value))))

        def suspend() -> void:
            # Losing a WasmBrowser tab's presentation focus must release
            # transient pointer/keyboard capture while retaining the logical
            # focused widget, exactly like the native backends.
            return if not UiLifecycle::suspend()
            dispatch((UiCore::Event.FocusLost))

        def resume() -> void:
            return if not UiLifecycle::resume()
            dispatch((UiCore::Event.FocusGained))

    public:
        # The component painter. Where SDL3 rasterizes, this ENCODES: each command
        # becomes one fixed-stride wire record for the host to draw. Two backends
        # with nothing in common but this protocol is the test of whether the
        # abstraction is real -- one puts pixels on a renderer, the other serializes
        # for a host that has never heard of Elisa.
        #
        # Inside the module now, so the encoders it drives no longer have to be
        # public for it to reach them.
        struct WasmPainter:
            unused: i32

        def painter() -> WasmPainter:
            return WasmPainter{unused: 0}

        impl Painter for WasmPainter:
            # Clip metadata is intentionally side-band to the render-command
            # ABI. The browser host keeps the existing wire layout; it can
            # evolve clipping independently without changing these records.
            def push_clip(self: Self, box: UiCore::Rect) -> void can[Ui.Draw]:
                pass

            def pop_clip(self: Self) -> void can[Ui.Draw]:
                pass

            def clear(self: Self, color: UiCore::Color) -> void can[Ui.Draw]:
                encode_clear(wire_take_slot(), color)

            def fill_rect(self: Self, box: UiCore::Rect, color: UiCore::Color, style: UiCore::SurfaceStyle) -> void can[Ui.Draw]:
                encode_fill_rect(wire_take_slot(), box, color)

            # The wire carries the command whether or not this side can draw
            # it: the host is handed a count, and a command that writes no
            # record leaves the host reading a stale slot. Whether a browser
            # canvas has the image is the host's question, not this side's.
            def draw_image(self: Self, draw: UiCore::ImageDraw) -> void can[Ui.Draw]:
                encode_draw_image(wire_take_slot(), draw)

            def fill_circle(self: Self, disc: UiCore::Circle, color: UiCore::Color, depth: UiCore::SurfaceDepth) -> void can[Ui.Draw]:
                # The wire carries geometry, not lighting; the host canvas
                # applies its own treatment, as it does for rectangles.
                encode_fill_circle(wire_take_slot(), disc, color)

            def fill_triangle(self: Self, tri: UiCore::Triangle, color: UiCore::Color) -> void can[Ui.Draw]:
                encode_fill_triangle(wire_take_slot(), tri, color)

            def fill_line(self: Self, segment: UiCore::Line, color: UiCore::Color, width: f32) -> void can[Ui.Draw]:
                encode_fill_line(wire_take_slot(), segment, color, width)

            def draw_text(self: Self, run: UiCore::TextRun, color: UiCore::Color) -> void can[Ui.Draw, Ui.Text]:
                encode_draw_text(wire_take_slot(), run, color)
