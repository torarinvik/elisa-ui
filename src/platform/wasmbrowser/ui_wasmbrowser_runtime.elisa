# WasmBrowser component runtime: retained frame state, event translation, and
# the fixed-stride render-command encoder. Host imports and WIT export glue stay
# in ui_wasmbrowser.elisa; this module owns the implementation behind them.
#
# The module is private by default. Only lifecycle methods and the painter type
# are public because the top-level WIT boundary forwards to those names.
module UiWasmBrowser:
    private:
        const WIRE_STRIDE: usize = 32
        const WIRE_CAPACITY: usize = UiCore::MAX_COMMANDS * WIRE_STRIDE

        global mutable wire_buffer: u8[WIRE_CAPACITY] = zeroed
        # Where the next command is written. Advanced by wire_take_slot, reset by
        # present(): a protocol painter method receives no index, so the position
        # has to be backend state.
        global mutable wire_cursor: usize = 0
        # WasmBrowser supplies a frame delta rather than an absolute clock.
        # Accumulate it here so shared animation policy (caret blinking and
        # future controls) sees the same monotonic seconds as native backends.
        global mutable elapsed_time: f64 = 0.0

        # Host pointer-kind ordinals (wit enum pointer-kind { down, up, move, leave }).
        const HOST_POINTER_DOWN: i32 = 0
        const HOST_POINTER_UP: i32 = 1
        const HOST_POINTER_MOVE: i32 = 2
        const HOST_POINTER_LEAVE: i32 = 3

        def wire_f32(base: usize, offset: usize, value: f32) -> void:
            trusted [Unsafe.PointerCast, Unsafe.PointerArithmetic, Unsafe.UncheckedIndex]:
                slot: mutable f32& = (&wire_buffer[base + offset]).cast[mutable f32&]
                slot[0] <- value

        def wire_color(base: usize, offset: usize, color: UiCore::Color) -> void:
            wire_buffer[base + offset] <- color.r
            wire_buffer[base + offset + 1] <- color.g
            wire_buffer[base + offset + 2] <- color.b
            wire_buffer[base + offset + 3] <- color.a

        def wire_u32(base: usize, offset: usize, value: uintptr) -> void:
            trusted [Unsafe.PointerCast, Unsafe.PointerArithmetic, Unsafe.UncheckedIndex]:
                slot: mutable u32& = (&wire_buffer[base + offset]).cast[mutable u32&]
                slot[0] <- value.u32()

        def wire_discriminant(base: usize, value: u8) -> void:
            wire_buffer[base] <- value
            wire_buffer[base + 1] <- 0
            wire_buffer[base + 2] <- 0
            wire_buffer[base + 3] <- 0

    private:
        # One operation per drawing command, each writing the next wire slot. The
        # MATCH that used to live here is now ui_paint.elisa's single
        # UiPaint::replay, shared with SDL3 -- the two backends read the command
        # list through the same code, so they cannot disagree about it again.
        #
        # Private, because the only callers are present() and the impl below, and
        # the impl now lives inside this module. The public surface of a component
        # backend is the guest lifecycle further down, nothing else.
        #
        # `base` used to come from the loop index. A protocol method is not handed
        # one, so the cursor is backend state now, reset by present() before the
        # replay -- the same shape as SDL3's renderer handle.
        def wire_reset() -> void:
            wire_cursor <- 0

        def wire_take_slot() -> usize:
            base: usize = wire_cursor
            wire_cursor <- wire_cursor + WIRE_STRIDE
            return base

        # One encoder per command, each writing one fixed-stride wire record.
        #
        # These used to be the arms of a single match over the command enum. Through
        # the protocol that cost a round trip -- UiPaint::replay destructured the
        # command, the painter rebuilt it, and the encoder destructured it again --
        # so the arms became functions and the match went away entirely. The BYTE
        # LAYOUT is unchanged; the host reads the same records at the same offsets.
        def encode_clear(base: usize, color: UiCore::Color) -> void:
            wire_discriminant(base, 0)
            wire_color(base, 4, color)

        def encode_fill_rect(base: usize, box: UiCore::Rect, color: UiCore::Color) -> void:
            wire_discriminant(base, 1)
            wire_f32(base, 4, box.origin.x)
            wire_f32(base, 8, box.origin.y)
            wire_f32(base, 12, box.size.width)
            wire_f32(base, 16, box.size.height)
            wire_color(base, 20, color)

        def encode_fill_circle(base: usize, disc: UiCore::Circle, color: UiCore::Color) -> void:
            wire_discriminant(base, 2)
            wire_f32(base, 4, disc.center.x)
            wire_f32(base, 8, disc.center.y)
            wire_f32(base, 12, disc.radius)
            wire_color(base, 16, color)

        def encode_fill_triangle(base: usize, tri: UiCore::Triangle, color: UiCore::Color) -> void:
            wire_discriminant(base, 3)
            wire_f32(base, 4, tri.a.x)
            wire_f32(base, 8, tri.a.y)
            wire_f32(base, 12, tri.b.x)
            wire_f32(base, 16, tri.b.y)
            wire_f32(base, 20, tri.c.x)
            wire_f32(base, 24, tri.c.y)
            wire_color(base, 28, color)

        def encode_fill_line(base: usize, segment: UiCore::Line, color: UiCore::Color) -> void:
            wire_discriminant(base, 4)
            wire_f32(base, 4, segment.from_point.x)
            wire_f32(base, 8, segment.from_point.y)
            wire_f32(base, 12, segment.to_point.x)
            wire_f32(base, 16, segment.to_point.y)
            wire_color(base, 20, color)

        def encode_draw_text(base: usize, run: UiCore::TextRun, color: UiCore::Color) -> void:
            # text-run lowers to x, y, size, color, then the string's pointer and
            # length: 24 payload bytes, which still fits the 28 the largest case
            # (triangle) already reserves.
            wire_discriminant(base, 5)
            wire_f32(base, 4, run.origin.x)
            wire_f32(base, 8, run.origin.y)
            wire_f32(base, 12, run.size)
            wire_color(base, 16, color)
            safe_text: sview = UiCore::bounded_text(run.text)
            text_pointer: uintptr = safe_text.data.cast[uintptr] can Unsafe.PointerCast
            wire_u32(base, 20, text_pointer)
            wire_u32(base, 24, safe_text.len.u32().uintptr())

        def present() -> void:
            total: usize = UiCore::command_count()
            wire_reset()
            UiPaint::replay[WasmPainter]()
            commands: void& = (&wire_buffer[0]).cast[void&] can Unsafe.PointerCast
            can Host.Present:
                host_present_commands(UiCore::viewport_width().u32(), UiCore::viewport_height().u32(), commands, total.u32())

        # Each host callback below knows its own kind, so it builds the variant
        # directly and no ordinal round-trip happens on this path. The flat
        # UiCore::from_record is there for a host that can only hand over an
        # ordinal plus scalars; see dispatch_record.
        def dispatch(event: UiCore::Event) -> void:
            UiWasmDispatch::dispatch(event)

        def dispatch_input(event: UiCore::Event) -> void:
            UiWasmDispatch::dispatch_input(event)

        # The generic WIT path: ordinal in, event out. Unused by the callbacks
        # below, and kept because the wire encoding is the host's to change --
        # a host that grows a kind can route it through here without this
        # backend growing a callback for it.
        def dispatch_record(kind: i32, x: f32, y: f32, dx: f32, dy: f32, code: i32) -> void:
            record: UiCore::EventRecord = UiCore::EventRecord{kind: kind.WireKind(), x: x, y: y, dx: dx, dy: dy, code: code}
            dispatch(UiCore::from_record(record))

    public:
        # The guest lifecycle, one function per WIT export.
        def start(width: u32, height: u32) -> void:
            UiLifecycle::reset()
            UiCapabilities::use_wasm_browser()
            UiEvents::reset()
            UiMetrics::reset()
            # A guest can be started more than once by a host that reuses the
            # component instance. Clear the old retained batch before the new
            # app_init callback runs, so no retired commands or semantic nodes
            # are observable during startup.
            UiCore::discard_frame()
            UiCore::clear_all_invalidations()
            return if not UiLifecycle::begin()
            ui_wasm_clipboard_cache_valid <- false
            ui_wasm_clipboard_length <- 0
            ui_wasm_scrub_clipboard_buffer()
            elapsed_time <- 0.0
            UiCore::set_frame_time(0.0)
            UiCore::set_viewport(width.f32(), height.f32())
            app_init()
            _ = UiLifecycle::ready()
            # The browser guest has no separate focus callback in the WIT
            # surface. A started guest owns its presentation surface, so mark
            # it focused here; otherwise dispatch_input would reject every
            # key and pointer event until a focus signal that can never arrive.
            _ = UiLifecycle::focus_gained()

        def resize(width: u32, height: u32) -> void:
            return if not UiLifecycle::is_started()
            UiCore::set_viewport(width.f32(), height.f32())
            dispatch((UiCore::Event.Resize(size: UiCore::Size(width.f32(), height.f32()))))

        def frame(dt: f64) -> void:
            return if not UiLifecycle::can_render()
            safe_dt: f64 = UiCore::finite_or_zero_f64(dt)
            if safe_dt > 0.0:
                # Keep the accumulated clock finite. A very large but finite
                # host delta can overflow the sum to +Inf; accepting that
                # value would make UiCore::set_frame_time sanitize it to zero
                # and silently rewind all animation state on the next frame.
                candidate: f64 = elapsed_time + safe_dt
                elapsed_time <- candidate if UiCore::finite_or_zero_f64(candidate) == candidate
            UiCore::set_frame_time(elapsed_time)
            UiMetrics::begin_frame(elapsed_time)
            UiCore::begin_frame()
            frame_generation: u32 = UiLifecycle::generation()
            app_frame()
            # `app_frame` is application-owned and may stop the guest during
            # its callback. Keep the frame sample complete, but never publish
            # a command batch after the presentation lifecycle is gone.
            same_session: bool = UiLifecycle::generation() == frame_generation
            if same_session and UiLifecycle::can_render():
                UiMetrics::mark_application(elapsed_time)
                UiMetrics::mark_semantics(elapsed_time)
                present()
                UiMetrics::mark_paint(elapsed_time)
            if same_session:
                UiMetrics::finish_frame(elapsed_time)

        # The host's pointer-kind ordinal is ITS encoding, not ours; translate it
        # into a variant here and an unmodeled kind simply produces no event.
        def pointer(x: f32, y: f32, kind: i32) -> void:
            return if not UiWasmInput::pointer_values_are_finite(x, y, 0.0, 0.0)
            at: UiCore::Vec2 = UiCore::Vec2(x, y)
            dispatch_input((UiCore::PointerEvent.Down(at: at, button: UiCore::PointerButton.Primary.i32()))) if kind == HOST_POINTER_DOWN
            dispatch_input((UiCore::PointerEvent.Up(at: at, button: UiCore::PointerButton.Primary.i32()))) if kind == HOST_POINTER_UP
            dispatch_input((UiCore::PointerEvent.Move(at: at))) if kind == HOST_POINTER_MOVE
            dispatch_input((UiCore::PointerEvent.Leave)) if kind == HOST_POINTER_LEAVE

        def key(code: i32, pressed: bool) -> void:
            mapped: i32 = UiWasmInput::key_from_host(code)
            return if mapped == 0
            dispatch_input((UiCore::KeyEvent.Down(code: UiCore::Key(mapped)))) if pressed
            dispatch_input((UiCore::KeyEvent.Up(code: UiCore::Key(mapped)))) if not pressed

        def pointer_button_input(x: f32, y: f32, button: i32, pressed: bool) -> void:
            return if not UiWasmInput::pointer_values_are_finite(x, y, 0.0, 0.0)
            at: UiCore::Vec2 = UiCore::Vec2(x, y)
            mapped: i32 = UiWasmInput::button_from_host(button)
            return if mapped < 0
            dispatch_input((UiCore::PointerEvent.Down(at: at, button: mapped))) if pressed
            dispatch_input((UiCore::PointerEvent.Up(at: at, button: mapped))) if not pressed

        def scroll_input(x: f32, y: f32, delta_x: f32, delta_y: f32) -> void:
            return if not UiWasmInput::pointer_values_are_finite(x, y, delta_x, delta_y)
            dispatch_input((UiCore::PointerEvent.Scroll(at: UiCore::Vec2(x, y), delta: UiCore::Vec2(delta_x, delta_y))))

        def gamepad_button_input(index: u32, button: i32, value: f32) -> void:
            mapped: i32 = UiWasmInput::gamepad_button_from_host(button)
            return if mapped < 0
            dispatch_input((UiCore::GamepadEvent.Button(button: UiCore::Pad(mapped), value: UiCore::normalized_unit(value))))

        def gamepad_axis_input(index: u32, axis: i32, value: f32) -> void:
            mapped: i32 = UiWasmInput::gamepad_axis_from_host(axis)
            return if mapped < 0
            dispatch_input((UiCore::GamepadEvent.Axis(axis: UiCore::PadAxis(mapped), value: UiWasmInput::axis_value(value))))

        def suspend() -> void:
            # Losing a WasmBrowser tab's presentation focus must release
            # transient pointer/keyboard capture while retaining the logical
            # focused widget, exactly like the native backends.
            return if not UiLifecycle::suspend()
            dispatch((UiCore::Event.FocusLost))

        def resume() -> void:
            return if not UiLifecycle::resume()
            dispatch((UiCore::Event.FocusGained))

    public:
        # The component painter. Where SDL3 rasterizes, this ENCODES: each command
        # becomes one fixed-stride wire record for the host to draw. Two backends
        # with nothing in common but this protocol is the test of whether the
        # abstraction is real -- one puts pixels on a renderer, the other serializes
        # for a host that has never heard of Elisa.
        #
        # Inside the module now, so the encoders it drives no longer have to be
        # public for it to reach them.
        struct WasmPainter:
            unused: i32

        impl Painter for WasmPainter:
            # Clip metadata is intentionally side-band to the render-command
            # ABI. The browser host keeps the existing wire layout; it can
            # evolve clipping independently without changing these records.
            def push_clip(box: UiCore::Rect) -> void can[Ui.Draw]:
                pass

            def pop_clip() -> void can[Ui.Draw]:
                pass

            def clear(color: UiCore::Color) -> void can[Ui.Draw]:
                encode_clear(wire_take_slot(), color)

            def fill_rect(box: UiCore::Rect, color: UiCore::Color, elevated: bool) -> void can[Ui.Draw]:
                encode_fill_rect(wire_take_slot(), box, color)

            def fill_circle(disc: UiCore::Circle, color: UiCore::Color) -> void can[Ui.Draw]:
                encode_fill_circle(wire_take_slot(), disc, color)

            def fill_triangle(tri: UiCore::Triangle, color: UiCore::Color) -> void can[Ui.Draw]:
                encode_fill_triangle(wire_take_slot(), tri, color)

            def fill_line(segment: UiCore::Line, color: UiCore::Color) -> void can[Ui.Draw]:
                encode_fill_line(wire_take_slot(), segment, color)

            def draw_text(run: UiCore::TextRun, color: UiCore::Color) -> void can[Ui.Draw, Ui.Text]:
                encode_draw_text(wire_take_slot(), run, color)
