# elisa-ui WasmBrowser backend: a Wasm component against wasmbrowser:window@0.1.0.
#
# WasmBrowser is a Wasmtime component host and loads .wapp packages whose only
# payload is manifest.json plus this component. There is deliberately no
# JavaScript, ESM loader, or TypeScript facade anywhere in this path.
#
# The host drives the loop: it calls the exported guest lifecycle and input
# functions, and `module UiWasmBrowser` translates them onto the app contract.
# Unlike the SDL3 backend there is no run loop here.
#
# Canonical-ABI encoding is confined to this module. `present-commands` takes a
# list<render-command>, lowered as a pointer/count pair over 32-byte elements:
# a u32 discriminant at byte 0 followed by the payload from byte 4, sized for
# the largest case (triangle).
#
# The host imports, the platform half of the contract, and the guest exports
# stay at file scope: they are the component's boundary, named by the WIT
# world, and a module prefix would only pretend otherwise.

include "../../core/ui_core.elisa"

@wasm_import_module("wasmbrowser:window/host@0.1.0")
@link_name("present-commands")
extern host_present_commands(width: u32, height: u32, commands: void&, count: u32) -> void

# Canonical strings cross as a pointer/length pair. These are the measurement
# side of the text contract: layout must know a run's extent before anything is
# drawn, and the host answers from the same font it rasterizes with.
@wasm_import_module("wasmbrowser:window/host@0.1.0")
@link_name("measure-text-width")
extern host_measure_text_width(text: cstr, length: u32, size: f32) -> f32

@wasm_import_module("wasmbrowser:window/host@0.1.0")
@link_name("measure-text-height")
extern host_measure_text_height(text: cstr, length: u32, size: f32) -> f32

@wasm_import_module("wasmbrowser:window/host@0.1.0")
@link_name("font-ascent")
extern host_font_ascent(size: f32) -> f32

@wasm_import_module("wasmbrowser:window/host@0.1.0")
@link_name("font-line-height")
extern host_font_line_height(size: f32) -> f32

def ui_measure_text_width(text: sview, size: f32) -> f32:
    return 0.0 if text.len == 0
    pointer: cstr = text.data.cast[cstr] can Unsafe.PointerCast
    return host_measure_text_width(pointer, text.len.u32(), size)

def ui_measure_text_height(text: sview, size: f32) -> f32:
    return 0.0 if text.len == 0
    pointer: cstr = text.data.cast[cstr] can Unsafe.PointerCast
    return host_measure_text_height(pointer, text.len.u32(), size)

def ui_font_ascent(size: f32) -> f32:
    return host_font_ascent(size)

def ui_text_line_height(size: f32) -> f32:
    return host_font_line_height(size)


module UiWasmBrowser:
    private:
        const WIRE_STRIDE: usize = 32
        const WIRE_CAPACITY: usize = UiCore::MAX_COMMANDS * WIRE_STRIDE

        global mutable wire_buffer: u8[WIRE_CAPACITY] = zeroed

        # Host pointer-kind ordinals (wit enum pointer-kind { down, up, move, leave }).
        const HOST_POINTER_DOWN: i32 = 0
        const HOST_POINTER_UP: i32 = 1
        const HOST_POINTER_MOVE: i32 = 2
        const HOST_POINTER_LEAVE: i32 = 3

        def wire_f32(base: usize, offset: usize, value: f32) -> void:
            trusted [Unsafe.PointerCast, Unsafe.PointerArithmetic, Unsafe.UncheckedIndex]:
                slot: mutable f32& = (&wire_buffer[base + offset]).cast[mutable f32&]
                slot[0] <- value

        def wire_color(base: usize, offset: usize, color: UiCore::Color) -> void:
            wire_buffer[base + offset] <- color.r
            wire_buffer[base + offset + 1] <- color.g
            wire_buffer[base + offset + 2] <- color.b
            wire_buffer[base + offset + 3] <- color.a

        def wire_u32(base: usize, offset: usize, value: uintptr) -> void:
            trusted [Unsafe.PointerCast, Unsafe.PointerArithmetic, Unsafe.UncheckedIndex]:
                slot: mutable u32& = (&wire_buffer[base + offset]).cast[mutable u32&]
                slot[0] <- value.u32()

        def wire_discriminant(base: usize, value: u8) -> void:
            wire_buffer[base] <- value
            wire_buffer[base + 1] <- 0
            wire_buffer[base + 2] <- 0
            wire_buffer[base + 3] <- 0

        def encode_command(command: UiCore::Command, base: usize) -> void:
            match command:
                UiCore::Command.Clear(color):
                    wire_discriminant(base, 0)
                    wire_color(base, 4, color)
                UiCore::Command.FillRect(box, color):
                    wire_discriminant(base, 1)
                    wire_f32(base, 4, box.origin.x)
                    wire_f32(base, 8, box.origin.y)
                    wire_f32(base, 12, box.size.width)
                    wire_f32(base, 16, box.size.height)
                    wire_color(base, 20, color)
                UiCore::Command.FillCircle(disc, color):
                    wire_discriminant(base, 2)
                    wire_f32(base, 4, disc.center.x)
                    wire_f32(base, 8, disc.center.y)
                    wire_f32(base, 12, disc.radius)
                    wire_color(base, 16, color)
                UiCore::Command.FillTriangle(tri, color):
                    wire_discriminant(base, 3)
                    wire_f32(base, 4, tri.a.x)
                    wire_f32(base, 8, tri.a.y)
                    wire_f32(base, 12, tri.b.x)
                    wire_f32(base, 16, tri.b.y)
                    wire_f32(base, 20, tri.c.x)
                    wire_f32(base, 24, tri.c.y)
                    wire_color(base, 28, color)
                UiCore::Command.FillLine(segment, color):
                    wire_discriminant(base, 4)
                    wire_f32(base, 4, segment.from_point.x)
                    wire_f32(base, 8, segment.from_point.y)
                    wire_f32(base, 12, segment.to_point.x)
                    wire_f32(base, 16, segment.to_point.y)
                    wire_color(base, 20, color)
                UiCore::Command.DrawText(run, color):
                    # text-run lowers to x, y, size, color, then the string's
                    # pointer and length: 24 payload bytes, which still fits
                    # the 28 the largest case (triangle) already reserves.
                    wire_discriminant(base, 5)
                    wire_f32(base, 4, run.origin.x)
                    wire_f32(base, 8, run.origin.y)
                    wire_f32(base, 12, run.size)
                    wire_color(base, 16, color)
                    text_pointer: uintptr = run.text.data.cast[uintptr] can Unsafe.PointerCast
                    wire_u32(base, 20, text_pointer)
                    wire_u32(base, 24, run.text.len.u32().uintptr())

        def present() -> void:
            total: usize = UiCore::command_count()
            return if total == 0
            for index in 0..<total:
                encode_command(UiCore::command_at(index), index * WIRE_STRIDE)
            commands: void& = (&wire_buffer[0]).cast[void&] can Unsafe.PointerCast
            host_present_commands(UiCore::viewport_width().u32(), UiCore::viewport_height().u32(), commands, total.u32())

        # Each host callback below knows its own kind, so it builds the variant
        # directly and no ordinal round-trip happens on this path. The flat
        # UiCore::from_record is there for a host that can only hand over an
        # ordinal plus scalars; see dispatch_record.
        def dispatch(event: UiCore::Event) -> void:
            app_event(event)

        # The generic WIT path: ordinal in, event out. Unused by the callbacks
        # below, and kept because the wire encoding is the host's to change --
        # a host that grows a kind can route it through here without this
        # backend growing a callback for it.
        def dispatch_record(kind: i32, x: f32, y: f32, dx: f32, dy: f32, code: i32) -> void:
            record: UiCore::EventRecord = UiCore::EventRecord{kind: kind, x: x, y: y, dx: dx, dy: dy, code: code}
            app_event(UiCore::from_record(record))

    public:
        # The guest lifecycle, one function per WIT export.
        def start(width: u32, height: u32) -> void:
            UiCore::set_viewport(width.f32(), height.f32())
            app_init()

        def resize(width: u32, height: u32) -> void:
            UiCore::set_viewport(width.f32(), height.f32())
            dispatch((UiCore::Event.Resize(size: UiCore::Size(width.f32(), height.f32()))))

        def frame(dt: f64) -> void:
            UiCore::begin_frame()
            app_frame()
            present()

        # The host's pointer-kind ordinal is ITS encoding, not ours; translate it
        # into a variant here and an unmodeled kind simply produces no event.
        def pointer(x: f32, y: f32, kind: i32) -> void:
            at: UiCore::Vec2 = UiCore::Vec2(x, y)
            dispatch((UiCore::PointerEvent.Down(at: at, button: 0))) if kind == HOST_POINTER_DOWN
            dispatch((UiCore::PointerEvent.Up(at: at, button: 0))) if kind == HOST_POINTER_UP
            dispatch((UiCore::PointerEvent.Move(at: at))) if kind == HOST_POINTER_MOVE
            dispatch((UiCore::PointerEvent.Leave)) if kind == HOST_POINTER_LEAVE

        # The host reports GLFW-numbered key codes, which IS the UiKey space, so
        # this names them rather than translating (the SDL3 backend, whose codes
        # are a different space, translates in key_from_sdl).
        def key(code: i32, pressed: bool) -> void:
            dispatch((UiCore::KeyEvent.Down(code: code.UiKey()))) if pressed
            dispatch((UiCore::KeyEvent.Up(code: code.UiKey()))) if not pressed

        def pointer_button_input(x: f32, y: f32, button: i32, pressed: bool) -> void:
            at: UiCore::Vec2 = UiCore::Vec2(x, y)
            dispatch((UiCore::PointerEvent.Down(at: at, button: button))) if pressed
            dispatch((UiCore::PointerEvent.Up(at: at, button: button))) if not pressed

        def scroll_input(x: f32, y: f32, delta_x: f32, delta_y: f32) -> void:
            dispatch((UiCore::PointerEvent.Scroll(at: UiCore::Vec2(x, y), delta: UiCore::Vec2(delta_x, delta_y))))

        def gamepad_button_input(index: u32, button: i32, value: f32) -> void:
            dispatch((UiCore::GamepadEvent.Button(button: button.UiPad(), value: value)))

        def gamepad_axis_input(index: u32, axis: i32, value: f32) -> void:
            dispatch((UiCore::GamepadEvent.Axis(axis: axis.UiPadAxis(), value: value)))

        def suspend() -> void:
            pass

        def resume() -> void:
            pass


# The component boundary: one top-level function per WIT export, forwarding
# into the module.
def guest_start(width: u32, height: u32) -> void:
    UiWasmBrowser::start(width, height)

def guest_resize(width: u32, height: u32) -> void:
    UiWasmBrowser::resize(width, height)

def guest_frame(dt: f64) -> void:
    UiWasmBrowser::frame(dt)

def guest_pointer(x: f32, y: f32, kind: i32) -> void:
    UiWasmBrowser::pointer(x, y, kind)

def guest_key(code: i32, pressed: bool) -> void:
    UiWasmBrowser::key(code, pressed)

def guest_pointer_button_input(x: f32, y: f32, button: i32, pressed: bool) -> void:
    UiWasmBrowser::pointer_button_input(x, y, button, pressed)

def guest_scroll_input(x: f32, y: f32, delta_x: f32, delta_y: f32) -> void:
    UiWasmBrowser::scroll_input(x, y, delta_x, delta_y)

def guest_gamepad_button_input(index: u32, button: i32, value: f32) -> void:
    UiWasmBrowser::gamepad_button_input(index, button, value)

def guest_gamepad_axis_input(index: u32, axis: i32, value: f32) -> void:
    UiWasmBrowser::gamepad_axis_input(index, axis, value)

def guest_suspend() -> void:
    UiWasmBrowser::suspend()

def guest_resume() -> void:
    UiWasmBrowser::resume()

@link_name("wasmbrowser:window/guest@0.1.0#start")
export fn start(width: u32, height: u32) -> void = guest_start
@link_name("wasmbrowser:window/guest@0.1.0#resize")
export fn resize(width: u32, height: u32) -> void = guest_resize
@link_name("wasmbrowser:window/guest@0.1.0#frame")
export fn frame(dt: f64) -> void = guest_frame
@link_name("wasmbrowser:window/guest@0.1.0#suspend")
export fn suspend() -> void = guest_suspend
@link_name("wasmbrowser:window/guest@0.1.0#resume")
export fn resume() -> void = guest_resume
@link_name("wasmbrowser:window/guest@0.1.0#key")
export fn key(code: i32, pressed: bool) -> void = guest_key
@link_name("wasmbrowser:window/guest@0.1.0#pointer")
export fn pointer(x: f32, y: f32, kind: i32) -> void = guest_pointer
@link_name("wasmbrowser:window/guest@0.1.0#pointer-button-input")
export fn pointer_button_input(x: f32, y: f32, button: i32, pressed: bool) -> void = guest_pointer_button_input
@link_name("wasmbrowser:window/guest@0.1.0#scroll-input")
export fn scroll_input(x: f32, y: f32, delta_x: f32, delta_y: f32) -> void = guest_scroll_input
@link_name("wasmbrowser:window/guest@0.1.0#gamepad-button-input")
export fn gamepad_button_input(index: u32, button: i32, value: f32) -> void = guest_gamepad_button_input
@link_name("wasmbrowser:window/guest@0.1.0#gamepad-axis-input")
export fn gamepad_axis_input(index: u32, axis: i32, value: f32) -> void = guest_gamepad_axis_input
