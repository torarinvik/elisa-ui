# elisa-ui WasmBrowser backend: a Wasm component against wasmbrowser:window@0.1.0.
#
# WasmBrowser is a Wasmtime component host and loads .wapp packages whose only
# payload is manifest.json plus this component. There is deliberately no
# JavaScript, ESM loader, or TypeScript facade anywhere in this path.
#
# The host drives the loop: it calls the exported guest lifecycle and input
# functions, and `module UiWasmBrowser` translates them onto the app contract.
# Unlike the SDL3 backend there is no run loop here.
#
# Canonical-ABI encoding is confined to this module. `present-commands` takes a
# list<render-command>, lowered as a pointer/count pair over 32-byte elements:
# a u32 discriminant at byte 0 followed by the payload from byte 4, sized for
# the largest case (triangle).
#
# The host imports, the platform half of the contract, and the guest exports
# stay at file scope: they are the component's boundary, named by the WIT
# world, and a module prefix would only pretend otherwise.

include "../../core/ui_core.elisa"
include "../../core/ui_paint.elisa"

# The impl at the foot of this module names `Painter` unqualified: `impl
# UiPaint::Painter for T:` is rejected by stage0's parser, and this is what makes
# the bare name resolve.
using UiPaint

@wasm_import_module("wasmbrowser:window/host@0.1.0")
@link_name("present-commands")
extern host_present_commands(width: u32, height: u32, commands: void&, count: u32) -> void can[Host.Present]

# Canonical strings cross as a pointer/length pair. These are the measurement
# side of the text contract: layout must know a run's extent before anything is
# drawn, and the host answers from the same font it rasterizes with.
@wasm_import_module("wasmbrowser:window/host@0.1.0")
@link_name("measure-text-width")
extern host_measure_text_width(text: cstr, length: u32, size: f32) -> f32 can[Host.Layout]

@wasm_import_module("wasmbrowser:window/host@0.1.0")
@link_name("measure-text-height")
extern host_measure_text_height(text: cstr, length: u32, size: f32) -> f32 can[Host.Layout]

@wasm_import_module("wasmbrowser:window/host@0.1.0")
@link_name("font-ascent")
extern host_font_ascent(size: f32) -> f32 can[Host.Layout]

@wasm_import_module("wasmbrowser:window/host@0.1.0")
@link_name("font-line-height")
extern host_font_line_height(size: f32) -> f32 can[Host.Layout]

# Clipboard is the only platform service used directly by the shared flat
# widget layer. Keep its WIT result area and ownership rules at this boundary:
# UiFlat deals in borrowed bytes, while the host deals in canonical
# result<string,string> values allocated in guest linear memory.
@wasm_import_module("wasmbrowser:window/host@0.1.0")
@link_name("clipboard-get")
extern host_clipboard_get(result: mutable void&) -> void can[Host.Clipboard]

@wasm_import_module("wasmbrowser:window/host@0.1.0")
@link_name("clipboard-set")
extern host_clipboard_set(text: cstr, text_length: u32, result: mutable void&) -> void can[Host.Clipboard]

# Canonical result strings are returned through the component's allocator. A
# zero-size realloc releases the allocation after Elisa has copied its bytes.
@link_name("cabi_realloc")
extern host_component_realloc(old_pointer: u32, old_size: u32, alignment: u32, new_size: u32) -> u32

@intrinsic("llvm.wasm.memory.size.i32")
extern ui_wasm_memory_size_pages(memory_index: u32) -> u32

const UI_WASM_HOST_MAX_ALLOCATION: u32 = 67108864
const UI_WASM_CLIPBOARD_WIRE_SIZE: usize = 64

global mutable ui_wasm_clipboard_buffer: u8[UiFlat::TEXT_CAPACITY] = zeroed
global mutable ui_wasm_clipboard_length: usize = 0
global mutable ui_wasm_clipboard_cache_valid: bool = false

def ui_wasm_read_wire_u32(wire: mutable u8[UI_WASM_CLIPBOARD_WIRE_SIZE]&, offset: usize) -> u32:
    trusted [Unsafe.PointerCast, Unsafe.PointerArithmetic, Unsafe.UncheckedIndex]:
        slot: u32& = (&wire[offset]).cast[u32&]
        return slot

def ui_wasm_host_memory_range_valid(pointer: u32, byte_count: u32) -> bool:
    start: u64 = pointer.u64()
    end: u64 = start + byte_count.u64()
    memory_end: u64 = ui_wasm_memory_size_pages(0).u64() * 65536
    return end >= start and end <= memory_end and (byte_count == 0 or pointer != 0)

def ui_wasm_memory_byte(pointer: u32) -> u8:
    trusted Unsafe.PointerCast:
        slot: u8& = pointer.cast[u8&]
        return slot

# The freestanding component runtime intentionally has no libc. The shared
# widget layer still accepts string literals as sviews, whose lowering uses the
# conventional `strlen` symbol; keep that tiny primitive in Elisa so the Wasm
# component has no accidental env::strlen import.
def strlen(text: cstr) -> usize:
    pointer: uintptr = text.cast[uintptr] can Unsafe.PointerCast
    return 0 if pointer == 0.uintptr()
    length: mutable usize = 0
    while ui_wasm_memory_byte(pointer.u32() + length.u32()) != 0 |length|:
        length <- length + 1
    return length

def ui_wasm_release_clipboard_allocation(pointer: u32, length: u32) -> void:
    if length <= UI_WASM_HOST_MAX_ALLOCATION and pointer != 0 and ui_wasm_host_memory_range_valid(pointer, length):
        host_component_realloc(pointer, length, 1, 0)

# Fetch one host string, copy at most the flat layer's capacity, and release the
# host-owned allocation on every accepted or rejected path. The cache lets
# UiFlat's enabled check and paste operation share one host read without
# changing its byte-oriented API.
def ui_wasm_fetch_clipboard() -> usize:
    result_wire: mutable u8[UI_WASM_CLIPBOARD_WIRE_SIZE] = zeroed
    ui_wasm_clipboard_length <- 0
    ui_wasm_clipboard_cache_valid <- true
    can Host.Clipboard:
        trusted [Unsafe.PointerCast]:
            host_clipboard_get((&result_wire[0]).cast[mutable void&])
    if ui_wasm_read_wire_u32(result_wire, 0) != 0:
        error_pointer: u32 = ui_wasm_read_wire_u32(result_wire, 4)
        error_length: u32 = ui_wasm_read_wire_u32(result_wire, 8)
        ui_wasm_release_clipboard_allocation(error_pointer, error_length)
        ui_wasm_clipboard_cache_valid <- false
        return 0
    pointer: u32 = ui_wasm_read_wire_u32(result_wire, 4)
    length: u32 = ui_wasm_read_wire_u32(result_wire, 8)
    if length == 0:
        ui_wasm_release_clipboard_allocation(pointer, length)
        ui_wasm_clipboard_cache_valid <- false
        return 0
    if pointer == 0:
        ui_wasm_clipboard_cache_valid <- false
        return 0
    if length > UI_WASM_HOST_MAX_ALLOCATION or not ui_wasm_host_memory_range_valid(pointer, length):
        ui_wasm_release_clipboard_allocation(pointer, length)
        ui_wasm_clipboard_cache_valid <- false
        return 0
    take: usize = length.usize() if length.usize() < UiFlat::TEXT_CAPACITY else UiFlat::TEXT_CAPACITY
    for index in 0..<take:
        trusted Unsafe.PointerCast:
            source: u8& = (pointer + index.u32()).cast[u8&]
            ui_wasm_clipboard_buffer[index] <- source
    ui_wasm_clipboard_length <- take
    ui_wasm_release_clipboard_allocation(pointer, length)
    return take

def ui_clipboard_has_text() -> bool:
    return ui_wasm_clipboard_length > 0 if ui_wasm_clipboard_cache_valid
    return ui_wasm_fetch_clipboard() > 0

def ui_clipboard_write(bytes: u8&, length: usize) -> bool:
    take: usize = length if length < UiFlat::TEXT_CAPACITY else UiFlat::TEXT_CAPACITY
    result_wire: mutable u8[UI_WASM_CLIPBOARD_WIRE_SIZE] = zeroed
    pointer: cstr = bytes.cast[cstr] can Unsafe.PointerCast
    can Host.Clipboard:
        trusted [Unsafe.PointerCast]:
            host_clipboard_set(pointer, take.u32(), (&result_wire[0]).cast[mutable void&])
    if ui_wasm_read_wire_u32(result_wire, 0) != 0:
        error_pointer: u32 = ui_wasm_read_wire_u32(result_wire, 4)
        error_length: u32 = ui_wasm_read_wire_u32(result_wire, 8)
        ui_wasm_release_clipboard_allocation(error_pointer, error_length)
        ui_wasm_clipboard_cache_valid <- false
        return false
    ui_wasm_clipboard_cache_valid <- false
    return true

def ui_clipboard_read(buffer: mutable u8&, capacity: usize) -> usize:
    available: usize = ui_wasm_fetch_clipboard() if not ui_wasm_clipboard_cache_valid else ui_wasm_clipboard_length
    take: usize = available if available < capacity else capacity
    for index in 0..<take:
        buffer[index] <- ui_wasm_clipboard_buffer[index]
    ui_wasm_clipboard_cache_valid <- false
    ui_wasm_clipboard_length <- 0
    return take

def ui_measure_text_width(text: sview, size: f32) -> f32:
    return 0.0 if text.len == 0
    pointer: cstr = text.data.cast[cstr] can Unsafe.PointerCast
    measured: mutable f32 = 0.0
    can Host.Layout:
        measured <- host_measure_text_width(pointer, text.len.u32(), size)
    return measured

def ui_measure_text_height(text: sview, size: f32) -> f32:
    return 0.0 if text.len == 0
    pointer: cstr = text.data.cast[cstr] can Unsafe.PointerCast
    measured: mutable f32 = 0.0
    can Host.Layout:
        measured <- host_measure_text_height(pointer, text.len.u32(), size)
    return measured

def ui_font_ascent(size: f32) -> f32:
    measured: mutable f32 = 0.0
    can Host.Layout:
        measured <- host_font_ascent(size)
    return measured

def ui_text_line_height(size: f32) -> f32:
    measured: mutable f32 = 0.0
    can Host.Layout:
        measured <- host_font_line_height(size)
    return measured


module UiWasmBrowser:
    private:
        const WIRE_STRIDE: usize = 32
        const WIRE_CAPACITY: usize = UiCore::MAX_COMMANDS * WIRE_STRIDE

        global mutable wire_buffer: u8[WIRE_CAPACITY] = zeroed
        # Where the next command is written. Advanced by wire_take_slot, reset by
        # present(): a protocol painter method receives no index, so the position
        # has to be backend state.
        global mutable wire_cursor: usize = 0

        # Host pointer-kind ordinals (wit enum pointer-kind { down, up, move, leave }).
        const HOST_POINTER_DOWN: i32 = 0
        const HOST_POINTER_UP: i32 = 1
        const HOST_POINTER_MOVE: i32 = 2
        const HOST_POINTER_LEAVE: i32 = 3

        def wire_f32(base: usize, offset: usize, value: f32) -> void:
            trusted [Unsafe.PointerCast, Unsafe.PointerArithmetic, Unsafe.UncheckedIndex]:
                slot: mutable f32& = (&wire_buffer[base + offset]).cast[mutable f32&]
                slot[0] <- value

        def wire_color(base: usize, offset: usize, color: UiCore::Color) -> void:
            wire_buffer[base + offset] <- color.r
            wire_buffer[base + offset + 1] <- color.g
            wire_buffer[base + offset + 2] <- color.b
            wire_buffer[base + offset + 3] <- color.a

        def wire_u32(base: usize, offset: usize, value: uintptr) -> void:
            trusted [Unsafe.PointerCast, Unsafe.PointerArithmetic, Unsafe.UncheckedIndex]:
                slot: mutable u32& = (&wire_buffer[base + offset]).cast[mutable u32&]
                slot[0] <- value.u32()

        def wire_discriminant(base: usize, value: u8) -> void:
            wire_buffer[base] <- value
            wire_buffer[base + 1] <- 0
            wire_buffer[base + 2] <- 0
            wire_buffer[base + 3] <- 0

    private:
        # One operation per drawing command, each writing the next wire slot. The
        # MATCH that used to live here is now ui_paint.elisa's single
        # UiPaint::replay, shared with SDL3 -- the two backends read the command
        # list through the same code, so they cannot disagree about it again.
        #
        # Private, because the only callers are present() and the impl below, and
        # the impl now lives inside this module. The public surface of a component
        # backend is the guest lifecycle further down, nothing else.
        #
        # `base` used to come from the loop index. A protocol method is not handed
        # one, so the cursor is backend state now, reset by present() before the
        # replay -- the same shape as SDL3's renderer handle.
        def wire_reset() -> void:
            wire_cursor <- 0

        def wire_take_slot() -> usize:
            base: usize = wire_cursor
            wire_cursor <- wire_cursor + WIRE_STRIDE
            return base

        # One encoder per command, each writing one fixed-stride wire record.
        #
        # These used to be the arms of a single match over the command enum. Through
        # the protocol that cost a round trip -- UiPaint::replay destructured the
        # command, the painter rebuilt it, and the encoder destructured it again --
        # so the arms became functions and the match went away entirely. The BYTE
        # LAYOUT is unchanged; the host reads the same records at the same offsets.
        def encode_clear(base: usize, color: UiCore::Color) -> void:
            wire_discriminant(base, 0)
            wire_color(base, 4, color)

        def encode_fill_rect(base: usize, box: UiCore::Rect, color: UiCore::Color) -> void:
            wire_discriminant(base, 1)
            wire_f32(base, 4, box.origin.x)
            wire_f32(base, 8, box.origin.y)
            wire_f32(base, 12, box.size.width)
            wire_f32(base, 16, box.size.height)
            wire_color(base, 20, color)

        def encode_fill_circle(base: usize, disc: UiCore::Circle, color: UiCore::Color) -> void:
            wire_discriminant(base, 2)
            wire_f32(base, 4, disc.center.x)
            wire_f32(base, 8, disc.center.y)
            wire_f32(base, 12, disc.radius)
            wire_color(base, 16, color)

        def encode_fill_triangle(base: usize, tri: UiCore::Triangle, color: UiCore::Color) -> void:
            wire_discriminant(base, 3)
            wire_f32(base, 4, tri.a.x)
            wire_f32(base, 8, tri.a.y)
            wire_f32(base, 12, tri.b.x)
            wire_f32(base, 16, tri.b.y)
            wire_f32(base, 20, tri.c.x)
            wire_f32(base, 24, tri.c.y)
            wire_color(base, 28, color)

        def encode_fill_line(base: usize, segment: UiCore::Line, color: UiCore::Color) -> void:
            wire_discriminant(base, 4)
            wire_f32(base, 4, segment.from_point.x)
            wire_f32(base, 8, segment.from_point.y)
            wire_f32(base, 12, segment.to_point.x)
            wire_f32(base, 16, segment.to_point.y)
            wire_color(base, 20, color)

        def encode_draw_text(base: usize, run: UiCore::TextRun, color: UiCore::Color) -> void:
            # text-run lowers to x, y, size, color, then the string's pointer and
            # length: 24 payload bytes, which still fits the 28 the largest case
            # (triangle) already reserves.
            wire_discriminant(base, 5)
            wire_f32(base, 4, run.origin.x)
            wire_f32(base, 8, run.origin.y)
            wire_f32(base, 12, run.size)
            wire_color(base, 16, color)
            text_pointer: uintptr = run.text.data.cast[uintptr] can Unsafe.PointerCast
            wire_u32(base, 20, text_pointer)
            wire_u32(base, 24, run.text.len.u32().uintptr())

        def present() -> void:
            total: usize = UiCore::command_count()
            return if total == 0
            wire_reset()
            UiPaint::replay[WasmPainter]()
            commands: void& = (&wire_buffer[0]).cast[void&] can Unsafe.PointerCast
            can Host.Present:
                host_present_commands(UiCore::viewport_width().u32(), UiCore::viewport_height().u32(), commands, total.u32())

        # Each host callback below knows its own kind, so it builds the variant
        # directly and no ordinal round-trip happens on this path. The flat
        # UiCore::from_record is there for a host that can only hand over an
        # ordinal plus scalars; see dispatch_record.
        def dispatch(event: UiCore::Event) -> void:
            app_event(event)

        # The generic WIT path: ordinal in, event out. Unused by the callbacks
        # below, and kept because the wire encoding is the host's to change --
        # a host that grows a kind can route it through here without this
        # backend growing a callback for it.
        def dispatch_record(kind: i32, x: f32, y: f32, dx: f32, dy: f32, code: i32) -> void:
            record: UiCore::EventRecord = UiCore::EventRecord{kind: kind.WireKind(), x: x, y: y, dx: dx, dy: dy, code: code}
            app_event(UiCore::from_record(record))

    public:
        # The guest lifecycle, one function per WIT export.
        def start(width: u32, height: u32) -> void:
            ui_wasm_clipboard_cache_valid <- false
            ui_wasm_clipboard_length <- 0
            UiCore::set_viewport(width.f32(), height.f32())
            app_init()

        def resize(width: u32, height: u32) -> void:
            UiCore::set_viewport(width.f32(), height.f32())
            dispatch((UiCore::Event.Resize(size: UiCore::Size(width.f32(), height.f32()))))

        def frame(dt: f64) -> void:
            UiCore::begin_frame()
            app_frame()
            present()

        # The host's pointer-kind ordinal is ITS encoding, not ours; translate it
        # into a variant here and an unmodeled kind simply produces no event.
        def pointer(x: f32, y: f32, kind: i32) -> void:
            at: UiCore::Vec2 = UiCore::Vec2(x, y)
            dispatch((UiCore::PointerEvent.Down(at: at, button: 0))) if kind == HOST_POINTER_DOWN
            dispatch((UiCore::PointerEvent.Up(at: at, button: 0))) if kind == HOST_POINTER_UP
            dispatch((UiCore::PointerEvent.Move(at: at))) if kind == HOST_POINTER_MOVE
            dispatch((UiCore::PointerEvent.Leave)) if kind == HOST_POINTER_LEAVE

        # The host reports GLFW-numbered key codes, which IS the UiCore::Key space, so
        # this names them rather than translating (the SDL3 backend, whose codes
        # are a different space, translates in key_from_sdl).
        def key(code: i32, pressed: bool) -> void:
            dispatch((UiCore::KeyEvent.Down(code: UiCore::Key(code)))) if pressed
            dispatch((UiCore::KeyEvent.Up(code: UiCore::Key(code)))) if not pressed

        def pointer_button_input(x: f32, y: f32, button: i32, pressed: bool) -> void:
            at: UiCore::Vec2 = UiCore::Vec2(x, y)
            dispatch((UiCore::PointerEvent.Down(at: at, button: button))) if pressed
            dispatch((UiCore::PointerEvent.Up(at: at, button: button))) if not pressed

        def scroll_input(x: f32, y: f32, delta_x: f32, delta_y: f32) -> void:
            dispatch((UiCore::PointerEvent.Scroll(at: UiCore::Vec2(x, y), delta: UiCore::Vec2(delta_x, delta_y))))

        def gamepad_button_input(index: u32, button: i32, value: f32) -> void:
            dispatch((UiCore::GamepadEvent.Button(button: UiCore::Pad(button), value: value)))

        def gamepad_axis_input(index: u32, axis: i32, value: f32) -> void:
            dispatch((UiCore::GamepadEvent.Axis(axis: UiCore::PadAxis(axis), value: value)))

        def suspend() -> void:
            # Losing a WasmBrowser tab's presentation focus must release
            # transient pointer/keyboard capture while retaining the logical
            # focused widget, exactly like the native backends.
            dispatch((UiCore::Event.FocusLost))

        def resume() -> void:
            dispatch((UiCore::Event.FocusGained))

    public:
        # The component painter. Where SDL3 rasterizes, this ENCODES: each command
        # becomes one fixed-stride wire record for the host to draw. Two backends
        # with nothing in common but this protocol is the test of whether the
        # abstraction is real -- one puts pixels on a renderer, the other serializes
        # for a host that has never heard of Elisa.
        #
        # Inside the module now, so the encoders it drives no longer have to be
        # public for it to reach them.
        struct WasmPainter:
            unused: i32

        impl Painter for WasmPainter:
            def clear(color: UiCore::Color) -> void can[Ui.Draw]:
                encode_clear(wire_take_slot(), color)

            def fill_rect(box: UiCore::Rect, color: UiCore::Color) -> void can[Ui.Draw]:
                encode_fill_rect(wire_take_slot(), box, color)

            def fill_circle(disc: UiCore::Circle, color: UiCore::Color) -> void can[Ui.Draw]:
                encode_fill_circle(wire_take_slot(), disc, color)

            def fill_triangle(tri: UiCore::Triangle, color: UiCore::Color) -> void can[Ui.Draw]:
                encode_fill_triangle(wire_take_slot(), tri, color)

            def fill_line(segment: UiCore::Line, color: UiCore::Color) -> void can[Ui.Draw]:
                encode_fill_line(wire_take_slot(), segment, color)

            def draw_text(run: UiCore::TextRun, color: UiCore::Color) -> void can[Ui.Draw, Ui.Text]:
                encode_draw_text(wire_take_slot(), run, color)

# The component boundary: one top-level function per WIT export, forwarding
# into the module.
def guest_start(width: u32, height: u32) -> void:
    UiWasmBrowser::start(width, height)

def guest_resize(width: u32, height: u32) -> void:
    UiWasmBrowser::resize(width, height)

def guest_frame(dt: f64) -> void:
    UiWasmBrowser::frame(dt)

def guest_pointer(x: f32, y: f32, kind: i32) -> void:
    UiWasmBrowser::pointer(x, y, kind)

def guest_key(code: i32, pressed: bool) -> void:
    UiWasmBrowser::key(code, pressed)

def guest_pointer_button_input(x: f32, y: f32, button: i32, pressed: bool) -> void:
    UiWasmBrowser::pointer_button_input(x, y, button, pressed)

def guest_scroll_input(x: f32, y: f32, delta_x: f32, delta_y: f32) -> void:
    UiWasmBrowser::scroll_input(x, y, delta_x, delta_y)

def guest_gamepad_button_input(index: u32, button: i32, value: f32) -> void:
    UiWasmBrowser::gamepad_button_input(index, button, value)

def guest_gamepad_axis_input(index: u32, axis: i32, value: f32) -> void:
    UiWasmBrowser::gamepad_axis_input(index, axis, value)

def guest_suspend() -> void:
    UiWasmBrowser::suspend()

def guest_resume() -> void:
    UiWasmBrowser::resume()

@link_name("wasmbrowser:window/guest@0.1.0#start")
export fn start(width: u32, height: u32) -> void = guest_start
@link_name("wasmbrowser:window/guest@0.1.0#resize")
export fn resize(width: u32, height: u32) -> void = guest_resize
@link_name("wasmbrowser:window/guest@0.1.0#frame")
export fn frame(dt: f64) -> void = guest_frame
@link_name("wasmbrowser:window/guest@0.1.0#suspend")
export fn suspend() -> void = guest_suspend
@link_name("wasmbrowser:window/guest@0.1.0#resume")
export fn resume() -> void = guest_resume
@link_name("wasmbrowser:window/guest@0.1.0#key")
export fn key(code: i32, pressed: bool) -> void = guest_key
@link_name("wasmbrowser:window/guest@0.1.0#pointer")
export fn pointer(x: f32, y: f32, kind: i32) -> void = guest_pointer
@link_name("wasmbrowser:window/guest@0.1.0#pointer-button-input")
export fn pointer_button_input(x: f32, y: f32, button: i32, pressed: bool) -> void = guest_pointer_button_input
@link_name("wasmbrowser:window/guest@0.1.0#scroll-input")
export fn scroll_input(x: f32, y: f32, delta_x: f32, delta_y: f32) -> void = guest_scroll_input
@link_name("wasmbrowser:window/guest@0.1.0#gamepad-button-input")
export fn gamepad_button_input(index: u32, button: i32, value: f32) -> void = guest_gamepad_button_input
@link_name("wasmbrowser:window/guest@0.1.0#gamepad-axis-input")
export fn gamepad_axis_input(index: u32, axis: i32, value: f32) -> void = guest_gamepad_axis_input
