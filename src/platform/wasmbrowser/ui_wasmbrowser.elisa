# elisa-ui WasmBrowser backend: a Wasm component against wasmbrowser:window@0.1.0.
#
# WasmBrowser is a Wasmtime component host and loads .wapp packages whose only
# payload is manifest.json plus this component. There is deliberately no
# JavaScript, ESM loader, or TypeScript facade anywhere in this path.
#
# The host drives the loop: it calls the exported guest lifecycle and input
# functions, and `module UiWasmBrowser` translates them onto the app contract.
# Unlike the SDL3 backend there is no run loop here.
#
# Canonical-ABI encoding is confined to this module. `present-commands` takes a
# list<render-command>, lowered as a pointer/count pair over 32-byte elements:
# a u32 discriminant at byte 0 followed by the payload from byte 4, sized for
# the largest case (triangle).
#
# The host imports, the platform half of the contract, and the guest exports
# stay at file scope: they are the component's boundary, named by the WIT
# world, and a module prefix would only pretend otherwise.

include "../../core/ui_core.elisa"
include "../../core/ui_capabilities.elisa"
include "../../core/ui_lifecycle.elisa"
include "../../core/ui_metrics.elisa"
include "../../core/ui_paint.elisa"
include "./ui_wasm_input.elisa"
include "./ui_wasm_dispatch.elisa"

# These are framework-declared effects for calls that cross the WasmBrowser
# boundary. They are intentionally separate from manifest capabilities: the
# compiler uses this family to make host interaction visible in Elisa source,
# while WasmBrowser remains the authority that grants or denies the capability
# at runtime.
permission Host:
    Present
    Layout
    Clock
    Log
    Notify
    Storage
    Files
    Navigation
    Network
    Clipboard
    Commerce
    Audio

# These are generated from the pinned WasmBrowser WIT contract in the staged
# SDK source root. Keeping the import surface authoritative prevents this
# backend from drifting into a second hand-written ABI while the UI-specific
# policy below remains local to elisa-ui.
include "../../../../sdk/elisa/wasmbrowser/host_bindings.elisa"

# The impl at the foot of this module names `Painter` unqualified: `impl
# UiPaint::Painter for T:` is rejected by stage0's parser, and this is what makes
# the bare name resolve.
using UiPaint

@intrinsic("llvm.wasm.memory.size.i32")
extern ui_wasm_memory_size_pages(memory_index: u32) -> u32

const UI_WASM_HOST_MAX_ALLOCATION: u32 = 67108864
# C strings crossing the component boundary are bounded independently of the
# host result allocation cap. Keep the scan at the framework's counted-text
# budget: callers that need more data use an explicit pointer/count pair, while
# a malformed unterminated C string cannot consume tens of megabytes of guest
# CPU time before being rejected.
const UI_WASM_CSTR_SCAN_CAPACITY: u32 = UiCore::MAX_TEXT_BYTES.u32()
const UI_WASM_CLIPBOARD_WIRE_SIZE: usize = 64

global mutable ui_wasm_clipboard_buffer: u8[UiFlat::TEXT_CAPACITY] = zeroed
global mutable ui_wasm_clipboard_length: usize = 0
global mutable ui_wasm_clipboard_cache_valid: bool = false

def ui_wasm_scrub_clipboard_buffer() -> void:
    index: mutable u32 = 0
    while index < UiFlat::TEXT_CAPACITY.u32():
        ui_wasm_clipboard_buffer[index.usize()] <- 0
        index <- index + 1

def ui_wasm_read_wire_u32(wire: mutable u8[UI_WASM_CLIPBOARD_WIRE_SIZE]&, offset: usize) -> u32:
    trusted [Unsafe.PointerCast, Unsafe.PointerArithmetic, Unsafe.UncheckedIndex]:
        slot: u32& = (&wire[offset]).cast[u32&]
        return slot

def ui_wasm_host_memory_end() -> u64:
    return ui_wasm_memory_size_pages(0).u64() * 65536

def ui_wasm_host_memory_range_valid(pointer: u32, byte_count: u32) -> bool:
    start: u64 = pointer.u64()
    end: u64 = start + byte_count.u64()
    memory_end: u64 = ui_wasm_host_memory_end()
    return end >= start and end <= memory_end and (byte_count == 0 or pointer != 0)

def ui_wasm_memory_byte(pointer: u32) -> u8:
    trusted Unsafe.PointerCast:
        slot: u8& = pointer.cast[u8&]
        return slot

# The freestanding component runtime intentionally has no libc. The shared
# widget layer still accepts string literals as sviews, whose lowering uses the
# conventional `strlen` symbol; keep that tiny primitive in Elisa so the Wasm
# component has no accidental env::strlen import.
def strlen(text: cstr) -> usize:
    pointer_value: uintptr = text.cast[uintptr] can Unsafe.PointerCast
    return 0 if pointer_value == 0.uintptr()
    pointer: u32 = pointer_value.u32()
    memory_end: u64 = ui_wasm_host_memory_end()
    length: u32 =
        for index in 0..<UI_WASM_CSTR_SCAN_CAPACITY |length = UI_WASM_CSTR_SCAN_CAPACITY| -> length:
            # Compute in u64 before converting back to a wasm32 pointer. This
            # prevents pointer+length wraparound from turning a malformed string
            # into a read near address zero.
            address: u64 = pointer.u64() + index.u64()
            length <- index if address >= memory_end
            break if address >= memory_end
            value: u8 = ui_wasm_memory_byte(address.u32())
            length <- index if value == 0
            break if value == 0
    return length.usize()

def ui_wasm_release_clipboard_allocation(pointer: u32, length: u32) -> void:
    if length <= UI_WASM_HOST_MAX_ALLOCATION and pointer != 0 and ui_wasm_host_memory_range_valid(pointer, length):
        host_component_realloc(pointer, length, 1, 0)

# Fetch one host string, copy at most the flat layer's capacity, and release the
# host-owned allocation on every accepted or rejected path. The cache lets
# UiFlat's enabled check and paste operation share one host read without
# changing its byte-oriented API.
def ui_wasm_fetch_clipboard() -> usize:
    ui_wasm_scrub_clipboard_buffer()
    result_wire: mutable u8[UI_WASM_CLIPBOARD_WIRE_SIZE] = zeroed
    ui_wasm_clipboard_length <- 0
    ui_wasm_clipboard_cache_valid <- true
    can Host.Clipboard:
        trusted [Unsafe.PointerCast]:
            host_clipboard_get((&result_wire[0]).cast[mutable void&])
    if ui_wasm_read_wire_u32(result_wire, 0) != 0:
        error_pointer: u32 = ui_wasm_read_wire_u32(result_wire, 4)
        error_length: u32 = ui_wasm_read_wire_u32(result_wire, 8)
        ui_wasm_release_clipboard_allocation(error_pointer, error_length)
        ui_wasm_clipboard_cache_valid <- false
        return 0
    pointer: u32 = ui_wasm_read_wire_u32(result_wire, 4)
    length: u32 = ui_wasm_read_wire_u32(result_wire, 8)
    if length == 0:
        ui_wasm_release_clipboard_allocation(pointer, length)
        ui_wasm_clipboard_cache_valid <- false
        return 0
    if pointer == 0:
        ui_wasm_clipboard_cache_valid <- false
        return 0
    if length > UI_WASM_HOST_MAX_ALLOCATION or not ui_wasm_host_memory_range_valid(pointer, length):
        ui_wasm_release_clipboard_allocation(pointer, length)
        ui_wasm_clipboard_cache_valid <- false
        return 0
    take: usize = length.usize() if length.usize() < UiFlat::TEXT_CAPACITY else UiFlat::TEXT_CAPACITY
    for index in 0..<take:
        trusted Unsafe.PointerCast:
            source: u8& = (pointer + index.u32()).cast[u8&]
            ui_wasm_clipboard_buffer[index] <- source
    copied: sview = ui_wasm_clipboard_buffer[0:take]
    ui_wasm_clipboard_length <- UiText::valid_utf8_prefix(copied, take)
    ui_wasm_release_clipboard_allocation(pointer, length)
    return ui_wasm_clipboard_length

def ui_clipboard_has_text() -> bool:
    return ui_wasm_clipboard_length > 0 if ui_wasm_clipboard_cache_valid
    return ui_wasm_fetch_clipboard() > 0

def ui_clipboard_write(bytes: u8&, length: usize) -> bool:
    return false if length > 0 and bytes == null
    take: usize = length if length < UiFlat::TEXT_CAPACITY else UiFlat::TEXT_CAPACITY
    result_wire: mutable u8[UI_WASM_CLIPBOARD_WIRE_SIZE] = zeroed
    # Keep clipboard payloads on complete UTF-8 scalar boundaries just like
    # the AppKit and SDL adapters. The selected-text path normally supplies a
    # valid range already, but this boundary also handles foreign callers that
    # pass a byte prefix ending in the middle of a scalar.
    safe_bytes: mutable u8[UiFlat::TEXT_CAPACITY] = zeroed
    for index in 0..<take:
        safe_bytes[index] <- bytes[index]
    copied: sview = safe_bytes[0:take]
    valid_length: usize = UiText::valid_utf8_prefix(copied, take)
    pointer: cstr = (&safe_bytes[0]).cast[cstr] can Unsafe.PointerCast
    can Host.Clipboard:
        trusted [Unsafe.PointerCast]:
            host_clipboard_set(pointer, valid_length.u32(), (&result_wire[0]).cast[mutable void&])
    if ui_wasm_read_wire_u32(result_wire, 0) != 0:
        error_pointer: u32 = ui_wasm_read_wire_u32(result_wire, 4)
        error_length: u32 = ui_wasm_read_wire_u32(result_wire, 8)
        ui_wasm_release_clipboard_allocation(error_pointer, error_length)
        ui_wasm_clipboard_cache_valid <- false
        return false
    ui_wasm_clipboard_cache_valid <- false
    return true

def ui_clipboard_read(buffer: mutable u8&, capacity: usize) -> usize:
    return 0 if capacity > 0 and buffer == null
    available: usize = ui_wasm_fetch_clipboard() if not ui_wasm_clipboard_cache_valid else ui_wasm_clipboard_length
    take: mutable usize = available if available < capacity else capacity
    source: sview = ui_wasm_clipboard_buffer[0:take]
    take <- UiText::valid_utf8_prefix(source, take)
    for index in 0..<take:
        buffer[index] <- ui_wasm_clipboard_buffer[index]
    ui_wasm_clipboard_cache_valid <- false
    ui_wasm_clipboard_length <- 0
    ui_wasm_scrub_clipboard_buffer()
    return take

def ui_measure_text_width(text: sview, size: f32) -> f32:
    return 0.0 if text.len <= 0 or text.data == null
    safe_text: sview = UiCore::bounded_text(text)
    return 0.0 if safe_text.len <= 0 or safe_text.data == null
    pointer: cstr = safe_text.data.cast[cstr] can Unsafe.PointerCast
    measured: mutable f32 = 0.0
    can Host.Layout:
        measured <- host_measure_text_width(pointer, safe_text.len.u32(), UiCore::bounded_extent(size))
    return UiCore::bounded_extent(measured)

def ui_measure_text_height(text: sview, size: f32) -> f32:
    return 0.0 if text.len <= 0 or text.data == null
    safe_text: sview = UiCore::bounded_text(text)
    return 0.0 if safe_text.len <= 0 or safe_text.data == null
    pointer: cstr = safe_text.data.cast[cstr] can Unsafe.PointerCast
    measured: mutable f32 = 0.0
    can Host.Layout:
        measured <- host_measure_text_height(pointer, safe_text.len.u32(), UiCore::bounded_extent(size))
    return UiCore::bounded_extent(measured)

def ui_font_ascent(size: f32) -> f32:
    measured: mutable f32 = 0.0
    can Host.Layout:
        measured <- host_font_ascent(UiCore::bounded_extent(size))
    return UiCore::bounded_extent(measured)

def ui_text_line_height(size: f32) -> f32:
    measured: mutable f32 = 0.0
    can Host.Layout:
        measured <- host_font_line_height(UiCore::bounded_extent(size))
    return UiCore::bounded_extent(measured)


# The component runtime is isolated from the WIT export glue so its state and
# encoders remain private to one cohesive module.
include "./ui_wasmbrowser_runtime.elisa"

# The component boundary: one top-level function per WIT export, forwarding
# into the module.
def guest_start(width: u32, height: u32) -> void:
    UiWasmBrowser::start(width, height)

def guest_resize(width: u32, height: u32) -> void:
    UiWasmBrowser::resize(width, height)

def guest_frame(dt: f64) -> void:
    UiWasmBrowser::frame(dt)

def guest_pointer(x: f32, y: f32, kind: i32) -> void:
    UiWasmBrowser::pointer(x, y, kind)

def guest_key(code: i32, pressed: bool) -> void:
    UiWasmBrowser::key(code, pressed)

def guest_pointer_button_input(x: f32, y: f32, button: i32, pressed: bool) -> void:
    UiWasmBrowser::pointer_button_input(x, y, button, pressed)

def guest_scroll_input(x: f32, y: f32, delta_x: f32, delta_y: f32) -> void:
    UiWasmBrowser::scroll_input(x, y, delta_x, delta_y)

def guest_gamepad_button_input(index: u32, button: i32, value: f32) -> void:
    UiWasmBrowser::gamepad_button_input(index, button, value)

def guest_gamepad_axis_input(index: u32, axis: i32, value: f32) -> void:
    UiWasmBrowser::gamepad_axis_input(index, axis, value)

def guest_suspend() -> void:
    UiWasmBrowser::suspend()

def guest_resume() -> void:
    UiWasmBrowser::resume()

@link_name("wasmbrowser:window/guest@0.1.0#start")
export fn start(width: u32, height: u32) -> void = guest_start
@link_name("wasmbrowser:window/guest@0.1.0#resize")
export fn resize(width: u32, height: u32) -> void = guest_resize
@link_name("wasmbrowser:window/guest@0.1.0#frame")
export fn frame(dt: f64) -> void = guest_frame
@link_name("wasmbrowser:window/guest@0.1.0#suspend")
export fn suspend() -> void = guest_suspend
@link_name("wasmbrowser:window/guest@0.1.0#resume")
export fn resume() -> void = guest_resume
@link_name("wasmbrowser:window/guest@0.1.0#key")
export fn key(code: i32, pressed: bool) -> void = guest_key
@link_name("wasmbrowser:window/guest@0.1.0#pointer")
export fn pointer(x: f32, y: f32, kind: i32) -> void = guest_pointer
@link_name("wasmbrowser:window/guest@0.1.0#pointer-button-input")
export fn pointer_button_input(x: f32, y: f32, button: i32, pressed: bool) -> void = guest_pointer_button_input
@link_name("wasmbrowser:window/guest@0.1.0#scroll-input")
export fn scroll_input(x: f32, y: f32, delta_x: f32, delta_y: f32) -> void = guest_scroll_input
@link_name("wasmbrowser:window/guest@0.1.0#gamepad-button-input")
export fn gamepad_button_input(index: u32, button: i32, value: f32) -> void = guest_gamepad_button_input
@link_name("wasmbrowser:window/guest@0.1.0#gamepad-axis-input")
export fn gamepad_axis_input(index: u32, axis: i32, value: f32) -> void = guest_gamepad_axis_input
