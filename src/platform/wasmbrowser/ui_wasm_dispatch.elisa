# Synchronous WasmBrowser event delivery.
#
# The host invokes guest exports synchronously. Keeping the queue drain in this
# small backend module makes re-entrant application callbacks safe without
# pulling any WIT imports or render state into the testable event policy.

include "../../core/ui_core.elisa"
include "../../core/ui_lifecycle.elisa"
include "../../widgets/ui_back.elisa"

module UiWasmDispatch:
    private:
        global mutable wasm_event_dispatch_active: bool = false

        def drain() -> void:
            return if wasm_event_dispatch_active
            wasm_event_dispatch_active <- true
            # A synchronous callback may stop the guest or rotate the session
            # before returning. Drain and discard the remaining queue once that
            # happens so events from the old owner never reach a replacement.
            drain_generation: u32 = UiLifecycle::generation()
            queued: mutable UiCore::Event = UiCore::Event.None
            while UiEvents::dequeue(queued):
                continue if not UiLifecycle::is_started() or UiLifecycle::generation() != drain_generation
                continue if UiCore::is_input_event(queued) and not UiLifecycle::accepts_input()
                match queued:
                    UiCore::KeyEvent.Down(code):
                        if code == UiCore::Key.Escape:
                            back_action: UiBack::Action = UiBack::request()
                            if back_action == UiBack::Action.Consumed:
                                pass
                            else:
                                app_event(queued)
                        else:
                            app_event(queued)
                    _:
                        app_event(queued)
            wasm_event_dispatch_active <- false

    public:
        def dispatch(event: UiCore::Event) -> void:
            return if not UiLifecycle::is_started()
            return if not UiEvents::enqueue(event)
            drain()

        def dispatch_input(event: UiCore::Event) -> void:
            return if not UiLifecycle::accepts_input()
            return if not UiEvents::enqueue(event)
            drain()
