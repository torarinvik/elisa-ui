# Ready-to-use AppKit canvas adapter for the allocation-free UiFlat layer.
#
# The generic canvas host deliberately knows only UiCore. These exported
# callbacks connect native accessibility, input and lifecycle actions to UiFlat,
# so an application entry point needs one include instead of repeating ABI glue.

include "./ui_appkit_canvas.elisa"
include "./ui_appkit_canvas_text.elisa"
include "./ui_appkit_canvas_clipboard.elisa"

include "../../widgets/ui_handles.elisa"

def appkit_flat_accessibility_activate(index: usize) -> i32:
    return 0 if not UiAppKitCanvas::live() or not UiLifecycle::accepts_input()
    activated: bool = UiFlat::activate(index)
    return 0 if activated and not UiAppKitCanvas::live()
    UiAppKitCanvas::redraw() if activated
    return 1 if activated else 0

# Native accessibility callbacks carry an opaque element handle. Resolve it to
# the retained widget action in Elisa before entering UiFlat's index API.
def appkit_flat_accessibility_activate_handle(window_handle: usize, handle: usize) -> i32:
    return 0 if not UiAppKitCanvas::live() or window_handle != UiAppKitCanvas::window_handle() or not UiLifecycle::accepts_input()
    index: usize = UiAppKitCanvas::accessibility_action_for_handle(handle)
    return 0 if index == UiAppKitCanvas::not_found()
    return appkit_flat_accessibility_activate(index)

def appkit_flat_accessibility_adjust(index: usize, direction: i32) -> i32:
    return 0 if not UiAppKitCanvas::live() or not UiLifecycle::accepts_input()
    adjusted: bool = UiFlat::adjust_step(index, direction)
    return 0 if adjusted and not UiAppKitCanvas::live()
    UiAppKitCanvas::redraw() if adjusted
    return 1 if adjusted else 0

def appkit_flat_accessibility_adjust_handle(window_handle: usize, handle: usize, direction: i32) -> i32:
    return 0 if not UiAppKitCanvas::live() or window_handle != UiAppKitCanvas::window_handle() or not UiLifecycle::accepts_input()
    index: usize = UiAppKitCanvas::accessibility_action_for_handle(handle)
    return 0 if index == UiAppKitCanvas::not_found()
    return appkit_flat_accessibility_adjust(index, direction)

def appkit_flat_accessibility_set_numeric_value(index: usize, value: f32) -> usize can Unsafe.PointerCast:
    return 0 if not UiAppKitCanvas::live() or not UiLifecycle::accepts_input()
    accepted: bool = UiFlat::set_accessibility_value(index, value)
    return 0 if not accepted or not UiAppKitCanvas::live()
    UiAppKitCanvas::redraw()
    # The returned +1 is released by the Cocoa protocol adapter after it has
    # mirrored the accepted normalized value into the native element.
    return UiAppKitCanvas::native_float_value(UiFlat::widget(index).value)

def appkit_flat_window_closed(window_handle: usize) -> void:
    return if not UiAppKitCanvas::live()
    return if window_handle != UiAppKitCanvas::window_handle()
    UiAppKitCanvas::cancel_redraw()
    UiFlat::cancel_interaction()
    UiAppKitCanvas::stop()

def appkit_flat_key_down_route(character: i32, modifiers: usize) -> i32:
    return UiAppKitCanvas::key_down_route(UiFlat::accepts_text(), character,
        UiAppKitCanvas::native_shift(modifiers), UiAppKitCanvas::native_control(modifiers),
        UiAppKitCanvas::native_option(modifiers), UiAppKitCanvas::native_command(modifiers))

def appkit_flat_key_down_event(window_handle: usize, event: usize, key_code: i32, character_native: usize, modifiers: usize) -> void:
    return if not UiAppKitCanvas::live() or not UiLifecycle::accepts_input()
    return if window_handle != UiAppKitCanvas::window_handle()
    character: i32 = UiAppKitCanvas::native_event_character(character_native)
    route: i32 = appkit_flat_key_down_route(character, modifiers)
    if route >= 2:
        _ = appkit_flat_perform_text_action(route - 1)
        return
    if route == 1:
        UiAppKitCanvas::interpret_key_event(event, UiAppKitCanvas::window_handle())
        return
    appkit_canvas_raw_key_callback(window_handle, 1, key_code, character)

def appkit_flat_key_up(window_handle: usize, key_code: i32, character_native: usize) -> void:
    return if not UiAppKitCanvas::live() or not UiLifecycle::accepts_input()
    return if window_handle != UiAppKitCanvas::window_handle()
    character: i32 = UiAppKitCanvas::native_event_character(character_native)
    return if UiFlat::accepts_text()
    appkit_canvas_raw_key_callback(window_handle, 0, key_code, character)

def appkit_flat_text_click(x: f32, y: f32, button: i32, click_count: i32) -> void:
    # Text selection is pointer input too. Keep it behind the same lifecycle
    # gate as the raw pointer event; otherwise a click arriving after focus
    # loss would still mutate the retained text field directly here.
    return if not UiAppKitCanvas::live() or not UiLifecycle::accepts_input()
    UiFlat::select_text_click_at_pointer(x, y, button, click_count)

def appkit_flat_pointer_button(window_handle: usize, x: f32, y: f32, button: i32, down: i32, click_count: i32) -> void:
    return if not UiAppKitCanvas::live() or not UiLifecycle::accepts_input()
    return if window_handle != UiAppKitCanvas::window_handle()
    # The native view forwards a BOOL, but this export is also an FFI seam.
    # Reject non-canonical values instead of treating every nonzero integer as
    # a press and mutating focus, capture, or text selection.
    return if not appkit_canvas_boolean_flag_is_valid(down)
    normalized_button: i32 = UiAppKitCanvas::button_from_appkit(button)
    # A press is both a pointer transition and a text-selection click. Keep
    # that ordering in Elisa so every native host reports the same interaction;
    # the Objective-C view only forwards Cocoa's raw button facts.
    if down == 1:
        lifetime: usize = UiFlat::lifetime()
        appkit_canvas_pointer_down_callback(window_handle, x, y, normalized_button)
        # Pointer-down may synchronously dispatch a slider change callback.
        # If that callback rebuilt the retained tree (or stopped the window),
        # the original click must not select text in the replacement tree.
        return if UiFlat::lifetime() != lifetime or not UiAppKitCanvas::live() or not UiLifecycle::accepts_input()
        appkit_flat_text_click(x, y, normalized_button, click_count)
        # Text selection runs after the pointer router's redraw, so request one
        # more paint for the selection change itself.
        UiAppKitCanvas::redraw() if UiAppKitCanvas::live()
        return
    appkit_canvas_pointer_up_callback(window_handle, x, y, normalized_button)

def appkit_flat_pointer_move_event(window_handle: usize, x: f32, y: f32) -> usize:
    # A stale or detached view must not install a cursor globally while its
    # event is being rejected. Returning zero makes the Cocoa shim leave the
    # current cursor untouched; only a live, matching window may supply one.
    return 0 if not UiAppKitCanvas::live()
    return 0 if window_handle != UiAppKitCanvas::window_handle()
    # Hover state changes before cursor selection, so the pointer and cursor
    # always describe the same retained frame. Cocoa receives only the opaque
    # cursor object it must install.
    appkit_canvas_pointer_move_callback(window_handle, x, y)
    return 0 if not UiAppKitCanvas::live()
    return UiAppKitCanvas::native_cursor(UiFlat::cursor_at(x, y))

def appkit_flat_pointer_leave_event(window_handle: usize) -> usize:
    return 0 if not UiAppKitCanvas::live()
    return 0 if window_handle != UiAppKitCanvas::window_handle()
    # Update retained hover state before returning the cursor Cocoa should
    # install. The native view supplies only the final opaque cursor object.
    appkit_canvas_pointer_leave_callback(window_handle)
    return 0 if not UiAppKitCanvas::live()
    return UiAppKitCanvas::native_cursor(0)

def appkit_flat_set_text(index: usize, text: usize) -> i32:
    return 0 if not UiAppKitCanvas::live() or not UiLifecycle::accepts_input() or text == 0 or not UiFlat::text_editable(index)
    length: usize = UiAppKitCanvasClipboard::copy_native_text(text)
    lifetime: usize = UiFlat::lifetime()
    UiFlat::replace_text(index, UiAppKitCanvasClipboard::native_text_view(length))
    UiAppKitCanvasClipboard::scrub_native_text()
    # Text replacement emits the application callback synchronously. If that
    # callback rebuilds the flat tree or stops the canvas, the native element
    # that requested the edit is no longer the live source of truth. Do not
    # report success or mirror the stale value back into Cocoa in that case.
    return 0 if UiFlat::lifetime() != lifetime or not UiAppKitCanvas::live() or not UiLifecycle::accepts_input()
    UiAppKitCanvas::redraw()
    return 1

def appkit_flat_set_text_handle(window_handle: usize, handle: usize, text: usize) -> i32:
    return 0 if not UiAppKitCanvas::live() or window_handle != UiAppKitCanvas::window_handle() or not UiLifecycle::accepts_input()
    index: usize = UiAppKitCanvas::accessibility_action_for_handle(handle)
    return 0 if index == UiAppKitCanvas::not_found()
    return appkit_flat_set_text(index, text)

# One protocol callback handles both writable text and numeric accessibility
# values. Elisa owns object classification, conversion and widget policy; the
# native adapter only mirrors the retained object returned for an accepted
# edit.
def appkit_flat_accessibility_set_value_handle(window_handle: usize, handle: usize, value: usize) -> usize can Unsafe.PointerCast:
    return 0 if not UiAppKitCanvas::live() or window_handle != UiAppKitCanvas::window_handle() or not UiLifecycle::accepts_input()
    index: usize = UiAppKitCanvas::accessibility_action_for_handle(handle)
    return 0 if index == UiAppKitCanvas::not_found()
    kind: i32 = UiAppKitCanvas::native_accessibility_value_kind(value)
    if kind == 1:
        accepted: i32 = appkit_flat_set_text(index, value)
        return 0 if accepted == 0
        # Mirror Elisa's retained result, not the borrowed object supplied by
        # Cocoa. The edit may have been UTF-8/truncation-normalized, and secure
        # fields must never put their private bytes back into AppKit's
        # accessibility value slot.
        normalized: sview = UiFlat::accessibility_text_value(index)
        return UiAppKitCanvas::native_string(normalized)
    if kind == 2:
        scalar: mutable f32 = 0.0
        return 0 if not UiAppKitCanvas::native_number_value(value, &scalar)
        return appkit_flat_accessibility_set_numeric_value(index, scalar)
    return 0

def appkit_flat_selection_location(window_handle: usize) -> usize:
    return UiAppKitCanvas::not_found() if not UiAppKitCanvas::live() or window_handle != UiAppKitCanvas::window_handle() or not UiFlat::accepts_text()
    return UiFlat::selection_utf16_location(UiFlat::focused())

def appkit_flat_selection_length(window_handle: usize) -> usize:
    return 0 if not UiAppKitCanvas::live() or window_handle != UiAppKitCanvas::window_handle() or not UiFlat::accepts_text()
    return UiFlat::selection_utf16_length(UiFlat::focused())

def appkit_flat_set_selected_range(index: usize, location: usize, length: usize) -> i32:
    return 0 if not UiAppKitCanvas::live() or not UiLifecycle::accepts_input() or location == UiAppKitCanvas::not_found() or not UiFlat::text_editable(index)
    UiFlat::set_selection_utf16(index, location, length)
    UiAppKitCanvas::redraw()
    return 1

# Return the range after Elisa has normalized it to the retained field's
# UTF-16 boundaries. AppKit's accessibility setter must mirror this result,
# rather than the caller's potentially oversized request, or Cocoa can retain a
# selection that disagrees with the framework's text state.
def appkit_flat_selected_range_handle(window_handle: usize, handle: usize,
                                       actual_location: mutable usize&,
                                       actual_length: mutable usize&) -> i32:
    return 0 if actual_location == null or actual_length == null
    actual_location <- UiAppKitCanvas::not_found()
    actual_length <- 0
    return 0 if not UiAppKitCanvas::live() or window_handle != UiAppKitCanvas::window_handle()
    index: usize = UiAppKitCanvas::accessibility_action_for_handle(handle)
    return 0 if index == UiAppKitCanvas::not_found() or not UiFlat::text_editable(index)
    actual_location <- UiFlat::selection_utf16_location(index)
    actual_length <- UiFlat::selection_utf16_length(index)
    return 1

def appkit_flat_set_selected_range_handle(window_handle: usize, handle: usize, location: usize, length: usize) -> i32:
    return 0 if not UiAppKitCanvas::live() or window_handle != UiAppKitCanvas::window_handle()
    index: usize = UiAppKitCanvas::accessibility_action_for_handle(handle)
    return 0 if index == UiAppKitCanvas::not_found()
    return appkit_flat_set_selected_range(index, location, length)

def appkit_flat_marked_location(window_handle: usize) -> usize:
    return UiAppKitCanvas::not_found() if not UiAppKitCanvas::live() or window_handle != UiAppKitCanvas::window_handle() or not UiFlat::accepts_text()
    index: usize = UiFlat::focused()
    return UiAppKitCanvas::not_found() if UiFlat::marked_utf16_length(index) == 0
    return UiFlat::marked_utf16_location(index)

def appkit_flat_has_marked_text(window_handle: usize) -> i32:
    return 0 if not UiAppKitCanvas::live() or window_handle != UiAppKitCanvas::window_handle() or not UiFlat::accepts_text()
    return 1 if UiFlat::marked_utf16_length(UiFlat::focused()) > 0 else 0

def appkit_flat_marked_length(window_handle: usize) -> usize:
    return 0 if not UiAppKitCanvas::live() or window_handle != UiAppKitCanvas::window_handle() or not UiFlat::accepts_text()
    return UiFlat::marked_utf16_length(UiFlat::focused())

def appkit_flat_commit_text(window_handle: usize, text: usize, replacement_location: usize, replacement_length: usize) -> void:
    return if not UiAppKitCanvas::live() or window_handle != UiAppKitCanvas::window_handle() or not UiLifecycle::accepts_input()
    plain: usize = UiAppKitCanvas::native_input_string(text)
    return if plain == 0
    length: usize = UiAppKitCanvasClipboard::copy_native_text(plain)
    has_replacement: bool = replacement_location != UiAppKitCanvas::not_found()
    lifetime: usize = UiFlat::lifetime()
    UiFlat::commit_text(UiAppKitCanvasClipboard::native_text_view(length), replacement_location, replacement_length, has_replacement)
    UiAppKitCanvasClipboard::scrub_native_text()
    # Text insertion emits the application callback synchronously. A callback
    # may replace the retained tree or stop the window, so do not repaint a
    # stale surface after that callback returns.
    return if UiFlat::lifetime() != lifetime or not UiAppKitCanvas::live() or not UiLifecycle::accepts_input()
    UiAppKitCanvas::redraw()

def appkit_flat_update_marked_text(window_handle: usize, text: usize, selected_location: usize, selected_length: usize, replacement_location: usize, replacement_length: usize) -> void:
    return if not UiAppKitCanvas::live() or window_handle != UiAppKitCanvas::window_handle() or not UiLifecycle::accepts_input()
    plain: usize = UiAppKitCanvas::native_input_string(text)
    return if plain == 0
    length: usize = UiAppKitCanvasClipboard::copy_native_text(plain)
    has_replacement: bool = replacement_location != UiAppKitCanvas::not_found()
    lifetime: usize = UiFlat::lifetime()
    UiFlat::update_marked_text(UiAppKitCanvasClipboard::native_text_view(length), selected_location, selected_length, replacement_location, replacement_length, has_replacement)
    UiAppKitCanvasClipboard::scrub_native_text()
    # Composition updates can also run the application callback. Keep the
    # native redraw tied to the same live retained session as the edit.
    return if UiFlat::lifetime() != lifetime or not UiAppKitCanvas::live() or not UiLifecycle::accepts_input()
    UiAppKitCanvas::redraw()

def appkit_flat_unmark_text(window_handle: usize) -> void:
    return if not UiAppKitCanvas::live() or window_handle != UiAppKitCanvas::window_handle() or not UiLifecycle::accepts_input()
    UiFlat::unmark_text()
    UiAppKitCanvas::redraw()

def appkit_flat_character_at_x(window_handle: usize, x: f32) -> usize:
    return UiAppKitCanvas::not_found() if not UiAppKitCanvas::live() or window_handle != UiAppKitCanvas::window_handle() or not UiFlat::accepts_text()
    index: usize = UiFlat::focused()
    return UiFlat::text_utf16_offset(index, UiFlat::text_position_at(index, x))

def appkit_flat_range_location(location: usize) -> usize:
    return 0 if not UiAppKitCanvas::live() or not UiFlat::accepts_text()
    return UiFlat::selection_utf16_location(UiFlat::focused()) if location == UiAppKitCanvas::not_found()
    return UiFlat::text_range_location(UiFlat::focused(), location)

def appkit_flat_range_length(location: usize, length: usize) -> usize:
    return 0 if not UiAppKitCanvas::live() or not UiFlat::accepts_text()
    return 0 if location == UiAppKitCanvas::not_found()
    return UiFlat::text_range_length(UiFlat::focused(), location, length)

def appkit_flat_first_rect(window_handle: usize, range_location: usize, range_length: usize,
                           actual_location: mutable usize&, actual_length: mutable usize&,
                           x: mutable f32&, y: mutable f32&,
                           width: mutable f32&, height: mutable f32&) -> i32:
    # These output references are part of the exported C ABI. The Cocoa shim
    # always supplies storage, but foreign callers may pass a null slot; fail
    # closed before the initial sentinel writes rather than dereferencing it.
    return 0 if actual_location == null or actual_length == null or x == null or y == null or width == null or height == null
    actual_location <- UiAppKitCanvas::not_found()
    actual_length <- 0
    return 0 if not UiAppKitCanvas::live() or window_handle != UiAppKitCanvas::window_handle() or not UiFlat::accepts_text()
    index: usize = UiFlat::focused()
    actual_location <- appkit_flat_range_location(range_location)
    actual_length <- appkit_flat_range_length(range_location, range_length)
    x <- UiFlat::text_character_x(index, actual_location)
    y <- UiFlat::text_caret_y(index)
    width <- UiAppKitCanvas::caret_width()
    height <- UiFlat::text_caret_height(index)
    return 1

def appkit_flat_attributed_substring(window_handle: usize, location: usize, length: usize,
                                     actual_location: mutable usize&, actual_length: mutable usize&) -> usize:
    # Keep optional C output storage genuinely optional. The native adapter
    # passes both addresses, while a direct foreign caller may omit either;
    # no semantic work should occur before that contract is checked.
    return 0 if actual_location == null or actual_length == null
    actual_location <- UiAppKitCanvas::not_found()
    actual_length <- 0
    return 0 if not UiAppKitCanvas::live() or window_handle != UiAppKitCanvas::window_handle() or not UiFlat::accepts_text() or not UiFlat::allows_text_readback()
    return 0 if location == UiAppKitCanvas::not_found()
    index: usize = UiFlat::focused()
    actual_location <- UiFlat::text_range_location(index, location)
    actual_length <- UiFlat::text_range_length(index, location, length)
    byte_length: usize = UiFlat::text_range_byte_length(index, location, length)
    pointer: u8& = UiFlat::text_range_pointer(index, location)
    native: usize = UiAppKitCanvas::native_string_bytes(pointer, byte_length)
    return 0 if native == 0
    attributed: usize = UiAppKitCanvas::native_attributed_string(native)
    CFRelease(native)
    return attributed

include "./ui_appkit_canvas_flat_exports.elisa"
