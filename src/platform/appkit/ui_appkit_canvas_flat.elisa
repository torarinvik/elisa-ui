# Ready-to-use AppKit canvas adapter for the allocation-free UiFlat layer.
#
# The generic canvas host deliberately knows only UiCore. These three exported
# callbacks connect its native accessibility/lifecycle actions to UiFlat, so an
# application entry point needs one include instead of repeating ABI glue.

include "./ui_appkit_canvas.elisa"

extern elisa_appkit_canvas_interpret_key_event(event: usize, window_handle: usize) -> void
include "../../widgets/ui_widget.elisa"

global mutable appkit_clipboard_buffer: u8[UiFlat::TEXT_CAPACITY] = zeroed
global mutable appkit_native_text_buffer: u8[UiFlat::TEXT_CAPACITY] = zeroed
global mutable appkit_clipboard_length: usize = 0
global mutable appkit_clipboard_cache_valid: bool = false

def appkit_scrub_buffer(buffer: mutable u8&, capacity: usize) -> void:
    for index in 0..<capacity:
        buffer[index] <- 0

def ui_clipboard_has_text() -> bool:
    return appkit_clipboard_length > 0 if appkit_clipboard_cache_valid
    # Read once and retain the bytes so UiFlat's enabled check and Paste action
    # observe one native snapshot, matching the Wasm adapter's host cache.
    appkit_scrub_buffer(&appkit_clipboard_buffer[0], UiFlat::TEXT_CAPACITY)
    native_text: usize = elisa_appkit_canvas_clipboard_read(elisa_appkit_canvas_pasteboard_type_string())
    appkit_clipboard_length <- UiAppKitCanvas::copy_native_string(native_text, &appkit_clipboard_buffer[0], UiFlat::TEXT_CAPACITY)
    CFRelease(native_text) if native_text != 0
    appkit_clipboard_cache_valid <- true
    return appkit_clipboard_length > 0

def ui_clipboard_write(bytes: u8&, length: usize) -> bool:
    native_text: usize = UiAppKitCanvas::native_string_bytes(bytes, length)
    return false if native_text == 0
    written: bool = elisa_appkit_canvas_clipboard_write(native_text, elisa_appkit_canvas_pasteboard_type_string()) != 0
    CFRelease(native_text)
    appkit_scrub_buffer(&appkit_clipboard_buffer[0], UiFlat::TEXT_CAPACITY)
    appkit_clipboard_cache_valid <- false
    appkit_clipboard_length <- 0
    return written

def ui_clipboard_read(buffer: mutable u8&, capacity: usize) -> usize:
    available: mutable usize = appkit_clipboard_length if appkit_clipboard_cache_valid else 0
    if not appkit_clipboard_cache_valid:
        appkit_scrub_buffer(&appkit_clipboard_buffer[0], UiFlat::TEXT_CAPACITY)
        native_text: usize = elisa_appkit_canvas_clipboard_read(elisa_appkit_canvas_pasteboard_type_string())
        available <- UiAppKitCanvas::copy_native_string(native_text, &appkit_clipboard_buffer[0], UiFlat::TEXT_CAPACITY)
        CFRelease(native_text) if native_text != 0
    take: usize = available if available < capacity else capacity
    for index in 0..<take:
        buffer[index] <- appkit_clipboard_buffer[index]
    appkit_clipboard_cache_valid <- false
    appkit_clipboard_length <- 0
    appkit_scrub_buffer(&appkit_clipboard_buffer[0], UiFlat::TEXT_CAPACITY)
    return take

def appkit_flat_accessibility_activate(index: usize) -> i32:
    activated: bool = UiFlat::activate(index)
    UiAppKitCanvas::redraw() if activated
    return 1 if activated else 0

def appkit_flat_accessibility_adjust(index: usize, direction: i32) -> i32:
    adjusted: bool = UiFlat::adjust_step(index, direction)
    UiAppKitCanvas::redraw() if adjusted
    return 1 if adjusted else 0

def appkit_flat_accessibility_set_numeric_value(index: usize, value: f32, normalized: mutable f32&) -> i32:
    accepted: bool = UiFlat::set_accessibility_value(index, value)
    return 0 if not accepted
    normalized <- UiFlat::widget(index).value
    UiAppKitCanvas::redraw()
    return 1

def appkit_flat_window_closed() -> void:
    UiAppKitCanvas::cancel_redraw()
    UiFlat::cancel_interaction()
    UiAppKitCanvas::stop()

def appkit_flat_accepts_text() -> i32:
    return 1 if UiFlat::accepts_text() else 0

def appkit_flat_key_down_route(character: i32, modifiers: usize) -> i32:
    return UiAppKitCanvas::key_down_route(UiFlat::accepts_text(), character,
        UiAppKitCanvas::native_shift(modifiers), UiAppKitCanvas::native_control(modifiers),
        UiAppKitCanvas::native_option(modifiers), UiAppKitCanvas::native_command(modifiers))

def appkit_flat_key_down_event(event: usize, key_code: i32, character_native: usize, modifiers: usize) -> void:
    character: i32 = UiAppKitCanvas::native_event_character(character_native)
    route: i32 = appkit_flat_key_down_route(character, modifiers)
    if route >= 2:
        _ = appkit_flat_perform_text_action(route - 1)
        return
    if route == 1:
        elisa_appkit_canvas_interpret_key_event(event, UiAppKitCanvas::window_handle())
        return
    appkit_canvas_raw_key_callback(1, key_code, character)

def appkit_flat_key_up(key_code: i32, character_native: usize) -> void:
    character: i32 = UiAppKitCanvas::native_event_character(character_native)
    return if UiFlat::accepts_text()
    appkit_canvas_raw_key_callback(0, key_code, character)

def appkit_flat_allows_text_readback() -> i32:
    return 1 if UiFlat::allows_text_readback() else 0

def appkit_flat_cursor_at(x: f32, y: f32) -> usize:
    return UiAppKitCanvas::native_cursor(UiFlat::cursor_at(x, y))

def appkit_flat_text_click(x: f32, y: f32, button: i32, click_count: i32) -> void:
    UiFlat::select_text_click_at_pointer(x, y, button, click_count)

def appkit_flat_pointer_button(x: f32, y: f32, button: i32, down: i32, click_count: i32) -> void:
    # A press is both a pointer transition and a text-selection click. Keep
    # that ordering in Elisa so every native host reports the same interaction;
    # the Objective-C view only forwards Cocoa's raw button facts.
    appkit_canvas_pointer_down_callback(x, y, button) if down != 0
    appkit_flat_text_click(x, y, button, click_count) if down != 0
    appkit_canvas_pointer_up_callback(x, y, button) if down == 0

def appkit_flat_pointer_move_event(x: f32, y: f32) -> usize:
    # Hover state changes before cursor selection, so the pointer and cursor
    # always describe the same retained frame. Cocoa receives only the opaque
    # cursor object it must install.
    appkit_canvas_pointer_move_callback(x, y)
    return UiAppKitCanvas::native_cursor(UiFlat::cursor_at(x, y))

def appkit_flat_pointer_leave_event() -> usize:
    # Update retained hover state before returning the cursor Cocoa should
    # install. The native view supplies only the final opaque cursor object.
    appkit_canvas_pointer_leave_callback()
    return UiAppKitCanvas::native_cursor(0)

def appkit_canvas_text_click_callback(x: f32, button: i32, click_count: i32) -> void:
    UiFlat::select_text_click_at(x, button, click_count)

def appkit_flat_set_text(index: usize, text: usize) -> i32:
    return 0 if text == 0 or not UiFlat::text_editable(index)
    length: usize = UiAppKitCanvas::copy_native_string(text, &appkit_native_text_buffer[0], UiFlat::TEXT_CAPACITY)
    UiFlat::replace_text(index, sview(&appkit_native_text_buffer[0], 0, length.i64()))
    appkit_scrub_buffer(&appkit_native_text_buffer[0], UiFlat::TEXT_CAPACITY)
    UiAppKitCanvas::redraw()
    return 1

def appkit_flat_selection_location() -> usize:
    return UiAppKitCanvas::not_found() if not UiFlat::accepts_text()
    return UiFlat::selection_utf16_location(UiFlat::focused())

def appkit_flat_selection_length() -> usize:
    return 0 if not UiFlat::accepts_text()
    return UiFlat::selection_utf16_length(UiFlat::focused())

def appkit_flat_set_selected_range(index: usize, location: usize, length: usize) -> i32:
    return 0 if location == UiAppKitCanvas::not_found() or not UiFlat::text_editable(index)
    UiFlat::set_selection_utf16(index, location, length)
    UiAppKitCanvas::redraw()
    return 1

def appkit_flat_marked_location() -> usize:
    return UiAppKitCanvas::not_found() if not UiFlat::accepts_text()
    index: usize = UiFlat::focused()
    return UiAppKitCanvas::not_found() if UiFlat::marked_utf16_length(index) == 0
    return UiFlat::marked_utf16_location(index)

def appkit_flat_has_marked_text() -> i32:
    return 0 if not UiFlat::accepts_text()
    return 1 if UiFlat::marked_utf16_length(UiFlat::focused()) > 0 else 0

def appkit_flat_marked_length() -> usize:
    return 0 if not UiFlat::accepts_text()
    return UiFlat::marked_utf16_length(UiFlat::focused())

def appkit_flat_commit_text(text: usize, replacement_location: usize, replacement_length: usize) -> void:
    return if text == 0
    length: usize = UiAppKitCanvas::copy_native_string(text, &appkit_native_text_buffer[0], UiFlat::TEXT_CAPACITY)
    has_replacement: bool = replacement_location != UiAppKitCanvas::not_found()
    UiFlat::commit_text(sview(&appkit_native_text_buffer[0], 0, length.i64()), replacement_location, replacement_length, has_replacement)
    appkit_scrub_buffer(&appkit_native_text_buffer[0], UiFlat::TEXT_CAPACITY)
    UiAppKitCanvas::redraw()

def appkit_flat_update_marked_text(text: usize, selected_location: usize, selected_length: usize, replacement_location: usize, replacement_length: usize) -> void:
    return if text == 0
    length: usize = UiAppKitCanvas::copy_native_string(text, &appkit_native_text_buffer[0], UiFlat::TEXT_CAPACITY)
    has_replacement: bool = replacement_location != UiAppKitCanvas::not_found()
    UiFlat::update_marked_text(sview(&appkit_native_text_buffer[0], 0, length.i64()), selected_location, selected_length, replacement_location, replacement_length, has_replacement)
    appkit_scrub_buffer(&appkit_native_text_buffer[0], UiFlat::TEXT_CAPACITY)
    UiAppKitCanvas::redraw()

def appkit_flat_unmark_text() -> void:
    UiFlat::unmark_text()
    UiAppKitCanvas::redraw()

# NSTextInputClient selectors are reduced to this small FFI vocabulary. Elisa
# owns the UiCore key mapping and modifier sequencing.
def appkit_flat_text_command(command: i32, modify_selection: i32) -> void:
    if command == 10:
        UiFlat::move_word_left(modify_selection != 0)
        return
    if command == 11:
        UiFlat::move_word_right(modify_selection != 0)
        return
    if command == 12:
        UiFlat::delete_word_backward()
        return
    if command == 13:
        UiFlat::delete_word_forward()
        return
    key: mutable UiCore::Key = UiCore::Key.Escape
    key <- UiCore::Key.Left if command == 1
    key <- UiCore::Key.Right if command == 2
    key <- UiCore::Key.Home if command == 3
    key <- UiCore::Key.End if command == 4
    key <- UiCore::Key.Backspace if command == 5
    key <- UiCore::Key.Delete if command == 6
    key <- UiCore::Key.Enter if command == 7
    key <- UiCore::Key.Tab if command == 8 or command == 9
    return if command < 1 or command > 9
    shifted: bool = modify_selection != 0 or command == 9
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.LeftShift))) if shifted
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: key)))
    UiFlat::keyboard((UiCore::KeyEvent.Up(code: key)))
    UiFlat::keyboard((UiCore::KeyEvent.Up(code: UiCore::Key.LeftShift))) if shifted

def appkit_flat_text_selector(selector: cstr) -> void:
    token: i32 = UiAppKitCanvas::text_selector_token(selector)
    command: i32 = UiAppKitCanvas::text_selector_command(token)
    return if command == 0
    appkit_flat_text_command(command, 1 if UiAppKitCanvas::text_selector_modifies_selection(token) else 0)
    UiAppKitCanvas::redraw()

def appkit_flat_text_action(selector: cstr) -> i32:
    return UiAppKitCanvas::text_action_for_selector(selector)

# Cocoa passes selector identity as an opaque SEL handle. Resolve its runtime
# spelling through the Objective-C runtime C ABI here, so the native shim does
# not perform selector-to-string conversion before crossing into Elisa.
def appkit_flat_text_selector_handle(selector: usize) -> void:
    return if selector == 0
    appkit_flat_text_selector(sel_getName(selector))

def appkit_flat_text_action_handle(selector: usize) -> i32:
    return 0 if selector == 0
    return appkit_flat_text_action(sel_getName(selector))

def appkit_flat_text_action_enabled(action: i32) -> i32:
    return 1 if UiFlat::text_action_enabled(action) else 0

def appkit_flat_text_action_valid(action: i32) -> i32:
    # Unknown Cocoa actions retain AppKit's default validation behavior; known
    # framework actions are enabled only when Elisa's retained state allows it.
    return 1 if action == 0 or UiFlat::text_action_enabled(action) else 0

def appkit_flat_perform_text_action(action: i32) -> i32:
    changed: bool = UiFlat::perform_text_action(action)
    UiAppKitCanvas::redraw() if changed
    return 1 if changed else 0

def appkit_flat_text_action_selector(selector: usize) -> void:
    action: i32 = appkit_flat_text_action_handle(selector)
    return if action == 0
    _ = appkit_flat_perform_text_action(action)

def appkit_flat_text_action_valid_selector(selector: usize) -> i32:
    action: i32 = appkit_flat_text_action_handle(selector)
    return appkit_flat_text_action_valid(action)

def appkit_flat_character_x(location: usize) -> f32:
    return 0.0 if not UiFlat::accepts_text()
    return UiFlat::text_character_x(UiFlat::focused(), location)

def appkit_flat_caret_y() -> f32:
    return 0.0 if not UiFlat::accepts_text()
    return UiFlat::text_caret_y(UiFlat::focused())

def appkit_flat_caret_height() -> f32:
    return 0.0 if not UiFlat::accepts_text()
    return UiFlat::text_caret_height(UiFlat::focused())

def appkit_flat_character_at_x(x: f32) -> usize:
    return UiAppKitCanvas::not_found() if not UiFlat::accepts_text()
    index: usize = UiFlat::focused()
    return UiFlat::text_utf16_offset(index, UiFlat::text_position_at(index, x))

def appkit_flat_range_location(location: usize) -> usize:
    return 0 if not UiFlat::accepts_text()
    return UiFlat::selection_utf16_location(UiFlat::focused()) if location == UiAppKitCanvas::not_found()
    return UiFlat::text_range_location(UiFlat::focused(), location)

def appkit_flat_range_length(location: usize, length: usize) -> usize:
    return 0 if not UiFlat::accepts_text()
    return 0 if location == UiAppKitCanvas::not_found()
    return UiFlat::text_range_length(UiFlat::focused(), location, length)

def appkit_flat_first_rect(range_location: usize, range_length: usize,
                           actual_location: mutable usize&, actual_length: mutable usize&,
                           x: mutable f32&, y: mutable f32&,
                           width: mutable f32&, height: mutable f32&) -> i32:
    return 0 if not UiFlat::accepts_text()
    index: usize = UiFlat::focused()
    actual_location <- appkit_flat_range_location(range_location)
    actual_length <- appkit_flat_range_length(range_location, range_length)
    x <- UiFlat::text_character_x(index, actual_location)
    y <- UiFlat::text_caret_y(index)
    width <- UiAppKitCanvas::caret_width()
    height <- UiFlat::text_caret_height(index)
    return 1

def appkit_flat_range_string(location: usize, length: usize) -> usize:
    return 0 if not UiFlat::accepts_text() or not UiFlat::allows_text_readback()
    return 0 if location == UiAppKitCanvas::not_found()
    index: usize = UiFlat::focused()
    byte_length: usize = UiFlat::text_range_byte_length(index, location, length)
    pointer: u8& = UiFlat::text_range_pointer(index, location)
    return UiAppKitCanvas::native_string_bytes(pointer, byte_length)

export fn elisa_appkit_canvas_accessibility_activate(index: usize) -> i32 = appkit_flat_accessibility_activate
export fn elisa_appkit_canvas_accessibility_adjust(index: usize, direction: i32) -> i32 = appkit_flat_accessibility_adjust
export fn elisa_appkit_canvas_accessibility_set_numeric_value(index: usize, value: f32, normalized: mutable f32&) -> i32 = appkit_flat_accessibility_set_numeric_value
export fn elisa_appkit_canvas_window_closed() -> void = appkit_flat_window_closed
export fn elisa_appkit_canvas_pointer_move_event(x: f32, y: f32) -> usize = appkit_flat_pointer_move_event
export fn elisa_appkit_canvas_pointer_button(x: f32, y: f32, button: i32, down: i32, click_count: i32) -> void = appkit_flat_pointer_button
export fn elisa_appkit_canvas_pointer_leave_event() -> usize = appkit_flat_pointer_leave_event
export fn elisa_appkit_canvas_accepts_text() -> i32 = appkit_flat_accepts_text
export fn elisa_appkit_canvas_key_down_route(character: i32, modifiers: usize) -> i32 = appkit_flat_key_down_route
export fn elisa_appkit_canvas_key_down_event(event: usize, key_code: i32, character: i32, modifiers: usize) -> void = appkit_flat_key_down_event
export fn elisa_appkit_canvas_key_up(key_code: i32, character: i32) -> void = appkit_flat_key_up
export fn elisa_appkit_canvas_allows_text_readback() -> i32 = appkit_flat_allows_text_readback
export fn elisa_appkit_canvas_cursor_at(x: f32, y: f32) -> usize = appkit_flat_cursor_at
export fn elisa_appkit_canvas_text_click(x: f32, button: i32, click_count: i32) -> void = appkit_canvas_text_click_callback
export fn elisa_appkit_canvas_set_text(index: usize, text: usize) -> i32 = appkit_flat_set_text
export fn elisa_appkit_canvas_selection_location() -> usize = appkit_flat_selection_location
export fn elisa_appkit_canvas_selection_length() -> usize = appkit_flat_selection_length
export fn elisa_appkit_canvas_set_selected_range(index: usize, location: usize, length: usize) -> i32 = appkit_flat_set_selected_range
export fn elisa_appkit_canvas_marked_location() -> usize = appkit_flat_marked_location
export fn elisa_appkit_canvas_marked_length() -> usize = appkit_flat_marked_length
export fn elisa_appkit_canvas_has_marked_text() -> i32 = appkit_flat_has_marked_text
export fn elisa_appkit_canvas_commit_text(text: usize, replacement_location: usize, replacement_length: usize) -> void = appkit_flat_commit_text
export fn elisa_appkit_canvas_update_marked_text(text: usize, selected_location: usize, selected_length: usize, replacement_location: usize, replacement_length: usize) -> void = appkit_flat_update_marked_text
export fn elisa_appkit_canvas_unmark_text() -> void = appkit_flat_unmark_text
export fn elisa_appkit_canvas_text_selector_handle(selector: usize) -> void = appkit_flat_text_selector_handle
export fn elisa_appkit_canvas_text_action_selector(selector: usize) -> void = appkit_flat_text_action_selector
export fn elisa_appkit_canvas_text_action_valid_selector(selector: usize) -> i32 = appkit_flat_text_action_valid_selector
export fn elisa_appkit_canvas_character_x(location: usize) -> f32 = appkit_flat_character_x
export fn elisa_appkit_canvas_caret_y() -> f32 = appkit_flat_caret_y
export fn elisa_appkit_canvas_caret_height() -> f32 = appkit_flat_caret_height
export fn elisa_appkit_canvas_character_at_x(x: f32) -> usize = appkit_flat_character_at_x
export fn elisa_appkit_canvas_range_location(location: usize) -> usize = appkit_flat_range_location
export fn elisa_appkit_canvas_range_length(location: usize, length: usize) -> usize = appkit_flat_range_length
export fn elisa_appkit_canvas_range_string(location: usize, length: usize) -> usize = appkit_flat_range_string
export fn elisa_appkit_canvas_first_rect(location: usize, length: usize, actual_location: mutable usize&, actual_length: mutable usize&, x: mutable f32&, y: mutable f32&, width: mutable f32&, height: mutable f32&) -> i32 = appkit_flat_first_rect
