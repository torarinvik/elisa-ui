# AppKit native read-back facts for diagnostics and headless verification.
#
# These wrappers intentionally live outside the production realization module.
# They read the live Cocoa objects through the same opaque handles as the
# control backend, but never become a second native control table or policy
# source. Each query brackets its bridge call with an autorelease pool.

extend UiAppKitNative:
    public:
        def native_subview_count(handle: usize) -> i32:
            pool: usize = objc_autoreleasePoolPush()
            result: i32 = elisa_appkit_subview_count(handle)
            objc_autoreleasePoolPop(pool)
            return result

        def native_is_class(handle: usize, class_name: usize) -> i32:
            pool: usize = objc_autoreleasePoolPush()
            result: i32 = elisa_appkit_is_class(handle, class_name)
            objc_autoreleasePoolPop(pool)
            return result

        def native_window_is_resizable(handle: usize) -> i32:
            pool: usize = objc_autoreleasePoolPush()
            result: i32 = elisa_appkit_window_is_resizable(handle)
            objc_autoreleasePoolPop(pool)
            return result

        def native_window_is_floating(handle: usize) -> i32:
            pool: usize = objc_autoreleasePoolPush()
            result: i32 = elisa_appkit_window_is_floating(handle)
