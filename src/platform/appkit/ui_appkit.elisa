# elisa-ui AppKit backend: the widget tree as real macOS controls.
#
# The first NATIVE backend. SDL3 and WasmBrowser both draw -- they consume the
# command list and own every pixel. This one owns none: it creates NSWindows,
# NSButtons and NSTextFields and lets AppKit draw them, lay out their text,
# handle the IME, mirror right-to-left and talk to VoiceOver. That is the whole
# reason to want native controls, and none of it is reachable by drawing
# rectangles.
#
# The Objective-C lives in appkit_shim.m, not here. objc_msgSend has no single
# signature -- on arm64 each call must be cast to the exact prototype of the
# method being sent, and a wrong cast is a silent ABI mismatch, not a link error.
# That cast is a C operation, so Elisa sees a flat typed C API exactly as it does
# for SDL3.
#
# The shim also owns the index -> NSView* table. UiControls hands out dense
# indices for precisely this reason; every real toolkit keeps such a table.

include "../../widgets/ui_controls.elisa"

# `impl UiControls::Controls for T:` is rejected by stage0's parser, so the impl
# below names `Controls` unqualified and this is what resolves it.
using UiControls

extern elisa_appkit_init() -> void
extern elisa_appkit_create_window(index: i32) -> void
extern elisa_appkit_create_panel(index: i32, parent: i32, parent_is_window: i32) -> void
extern elisa_appkit_create_scroll_view(index: i32, parent: i32, parent_is_window: i32) -> void
extern elisa_appkit_create_label(index: i32, parent: i32, parent_is_window: i32) -> void
extern elisa_appkit_create_push_button(index: i32, parent: i32, parent_is_window: i32) -> void
extern elisa_appkit_create_toggle_button(index: i32, parent: i32, parent_is_window: i32) -> void
extern elisa_appkit_create_checkbox(index: i32, parent: i32, parent_is_window: i32) -> void
extern elisa_appkit_create_radio_button(index: i32, parent: i32, parent_is_window: i32) -> void
extern elisa_appkit_create_text_field(index: i32, parent: i32, parent_is_window: i32) -> void
extern elisa_appkit_create_slider(index: i32, parent: i32, parent_is_window: i32) -> void
extern elisa_appkit_create_progress_bar(index: i32, parent: i32, parent_is_window: i32) -> void
extern elisa_appkit_set_window_frame(index: i32, width: f32, height: f32) -> void
extern elisa_appkit_set_view_frame(index: i32, x: f32, y: f32, width: f32, height: f32) -> void
extern elisa_appkit_set_window_title(index: i32, text: cstr, length: usize) -> void
extern elisa_appkit_set_button_title(index: i32, text: cstr, length: usize) -> void
extern elisa_appkit_set_field_text(index: i32, text: cstr, length: usize) -> void
extern elisa_appkit_present() -> void
extern elisa_appkit_run() -> void

# Read back from the live AppKit objects, for the headless check.
extern elisa_appkit_control_count() -> i32
extern elisa_appkit_subview_count(index: i32) -> i32
extern elisa_appkit_is_class(index: i32, class_name: cstr) -> i32
extern elisa_appkit_frame_width(index: i32) -> f32
extern elisa_appkit_frame_x(index: i32) -> f32
extern elisa_appkit_frame_y(index: i32) -> f32
extern elisa_appkit_is_flipped(index: i32) -> i32

module UiAppKit:
    public:
        # The AppKit controls backend. A TYPE, not a value: every native handle
        # lives in the shim's index table, so the methods are static and the
        # specialization inlines straight through to the C entry points.
        struct AppKitControls:
            unused: i32

        impl Controls for AppKitControls:
            def create(index: i32, kind: UiControls::Kind, parent: i32) -> void:
                can Ui.Controls:
                    parent_is_window: mutable i32 = 0
                    if parent >= 0:
                        parent_is_window <- 1 if UiControls::kind_at(parent.usize()) == UiControls::Kind.Window
                    if kind == UiControls::Kind.Window:
                        elisa_appkit_create_window(index)
                        return
                    if kind == UiControls::Kind.Panel:
                        elisa_appkit_create_panel(index, parent, parent_is_window)
                        return
                    if kind == UiControls::Kind.ScrollView:
                        elisa_appkit_create_scroll_view(index, parent, parent_is_window)
                        return
                    if kind == UiControls::Kind.Label:
                        elisa_appkit_create_label(index, parent, parent_is_window)
                        return
                    if kind == UiControls::Kind.PushButton:
                        elisa_appkit_create_push_button(index, parent, parent_is_window)
                        return
                    if kind == UiControls::Kind.ToggleButton:
                        elisa_appkit_create_toggle_button(index, parent, parent_is_window)
                        return
                    if kind == UiControls::Kind.CheckBox:
                        elisa_appkit_create_checkbox(index, parent, parent_is_window)
                        return
                    if kind == UiControls::Kind.RadioButton:
                        elisa_appkit_create_radio_button(index, parent, parent_is_window)
                        return
                    if kind == UiControls::Kind.TextField:
                        elisa_appkit_create_text_field(index, parent, parent_is_window)
                        return
                    if kind == UiControls::Kind.Slider:
                        elisa_appkit_create_slider(index, parent, parent_is_window)
                        return
                    if kind == UiControls::Kind.ProgressBar:
                        elisa_appkit_create_progress_bar(index, parent, parent_is_window)

            def set_frame(index: i32, kind: UiControls::Kind, box: UiCore::Rect) -> void:
                can Ui.Controls:
                    if kind == UiControls::Kind.Window:
                        elisa_appkit_set_window_frame(index, box.size.width, box.size.height)
                        return
                    elisa_appkit_set_view_frame(index, box.origin.x, box.origin.y, box.size.width, box.size.height)

            def set_text(index: i32, kind: UiControls::Kind, text: sview) -> void:
                # A `sview` is a pointer and a length, which is exactly what the
                # shim's NSString initializer wants -- so no NUL-terminated copy is
                # made, and a label's text may contain one. Use a stable empty
                # literal for zero-length views so clearing a native control is
                # observable instead of being mistaken for a no-op.
                empty: cstr = ""
                pointer: mutable cstr = empty
                pointer <- text.data.cast[cstr] can Unsafe.PointerCast if text.len > 0
                if kind == UiControls::Kind.Window:
                    elisa_appkit_set_window_title(index, pointer, text.len)
                    return
                if kind == UiControls::Kind.PushButton or kind == UiControls::Kind.ToggleButton or kind == UiControls::Kind.CheckBox or kind == UiControls::Kind.RadioButton:
                    elisa_appkit_set_button_title(index, pointer, text.len)
                    return
                if kind == UiControls::Kind.Label or kind == UiControls::Kind.TextField:
                    elisa_appkit_set_field_text(index, pointer, text.len)

        # Realize a laid-out widget tree as native controls. Run UiWidgets::layout
        # first: every control is placed at the box it computed.
        def realize(root: UiWidgets::Widget) -> void:
            can[Ui.Controls]:
                UiControls::reset()
                UiControls::realize(root, UiControls::NO_PARENT)
                UiControls::apply[AppKitControls]()

        def start() -> void:
            elisa_appkit_init()

        def present() -> void:
            elisa_appkit_present()

        def run() -> void:
            elisa_appkit_run()
