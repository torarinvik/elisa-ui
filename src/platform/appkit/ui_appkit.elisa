# elisa-ui AppKit backend: the widget tree as real macOS controls.
#
# The first NATIVE backend. SDL3 and WasmBrowser both draw -- they consume the
# command list and own every pixel. This one owns none: it creates NSWindows,
# NSButtons and NSTextFields and lets AppKit draw them, lay out their text,
# handle the IME, mirror right-to-left and talk to VoiceOver. That is the whole
# reason to want native controls, and none of it is reachable by drawing
# rectangles.
#
# The Objective-C lives in appkit_shim.m, not here. objc_msgSend has no single
# signature -- on arm64 each call must be cast to the exact prototype of the
# method being sent, and a wrong cast is a silent ABI mismatch, not a link error.
# That cast is a C operation, so Elisa sees a flat typed C API exactly as it does
# for SDL3.
#
# UiControls owns the index -> opaque handle table. The Objective-C shim resolves
# handles only at the Cocoa boundary and does not duplicate the framework arena.

include "../../widgets/ui_controls.elisa"

# `impl UiControls::Controls for T:` is rejected by stage0's parser, so the impl
# below names `Controls` unqualified and this is what resolves it.
using UiControls

extern elisa_appkit_init() -> void
extern elisa_appkit_activation_policy_regular: i32
extern elisa_appkit_set_activation_policy(policy: i32) -> void
extern elisa_appkit_window_style_titled: i32
extern elisa_appkit_window_style_closable: i32
extern elisa_appkit_window_style_miniaturizable: i32
extern elisa_appkit_window_style_resizable: i32
extern elisa_appkit_window_style_utility: i32
extern elisa_appkit_bezel_style_rounded: i32
extern elisa_appkit_button_type_push_on_push_off: i32
extern elisa_appkit_control_state_on: i32
extern elisa_appkit_control_state_off: i32
extern elisa_appkit_progress_style_bar: i32
extern elisa_appkit_backing_store_buffered: i32
extern elisa_appkit_create_window_with_style(style: i32, backing: i32, width: f32, height: f32) -> usize
extern elisa_appkit_create_panel_window(style: i32, backing: i32, floating: i32, becomes_key_only: i32, width: f32, height: f32) -> usize
extern elisa_appkit_create_panel() -> usize
extern elisa_appkit_create_scroll_view(vertical: i32, horizontal: i32) -> usize
extern elisa_appkit_create_label(text: usize) -> usize
extern elisa_appkit_create_push_button(bezel_style: i32, text: usize) -> usize
extern elisa_appkit_create_toggle_button(button_type: i32, text: usize) -> usize
extern elisa_appkit_create_checkbox(text: usize) -> usize
extern elisa_appkit_create_radio_button(text: usize) -> usize
extern elisa_appkit_create_text_field(text: usize) -> usize
extern elisa_appkit_create_slider(low: f32, high: f32, value: f32) -> usize
extern elisa_appkit_create_progress_bar(progress_style: i32, indeterminate: i32) -> usize
extern elisa_appkit_attach_to_window(handle: usize, parent: usize) -> void
extern elisa_appkit_attach_to_scroll_view(handle: usize, parent: usize) -> void
extern elisa_appkit_attach_to_view(handle: usize, parent: usize) -> void
extern elisa_appkit_set_window_frame(handle: usize, width: f32, height: f32) -> void
extern elisa_appkit_set_view_frame(handle: usize, x: f32, y: f32, width: f32, height: f32) -> void
extern elisa_appkit_set_scroll_document_frame(handle: usize, width: f32, height: f32) -> void
extern elisa_appkit_set_window_title(handle: usize, text: usize) -> void
extern elisa_appkit_set_button_title(handle: usize, text: usize) -> void
extern elisa_appkit_set_field_text(handle: usize, text: usize) -> void
extern elisa_appkit_set_button_state(handle: usize, state: i32) -> void
extern elisa_appkit_set_slider_state(handle: usize, low: f32, high: f32, value: f32) -> void
extern elisa_appkit_set_progress_value(handle: usize, value: f32) -> void
extern elisa_appkit_present(handle: usize) -> void
extern elisa_appkit_activate() -> void
extern elisa_appkit_run() -> void
extern CFStringCreateWithBytes(allocator: usize, bytes: cstr, length: i64, encoding: u32, external: bool) -> usize
extern CFRelease(value: usize) -> void
extern objc_autoreleasePoolPush() -> usize
extern objc_autoreleasePoolPop(pool: usize) -> void

# The retained widget model uses top-left coordinates on every backend. Keep
# that convention in Elisa; the native view merely adapts Cocoa's protocol
# callback to this framework fact.
def appkit_view_is_flipped() -> i32:
    return 1

export fn elisa_appkit_view_is_flipped() -> i32 = appkit_view_is_flipped

# Read back from the live AppKit objects, for the headless check.
extern elisa_appkit_subview_count(handle: usize) -> i32
extern elisa_appkit_is_class(handle: usize, class_name: usize) -> i32
extern elisa_appkit_window_is_resizable(handle: usize) -> i32
extern elisa_appkit_window_is_floating(handle: usize) -> i32
extern elisa_appkit_panel_becomes_key_only(handle: usize) -> i32
extern elisa_appkit_button_is_on(handle: usize) -> i32
extern elisa_appkit_button_bezel_style(handle: usize) -> i32
extern elisa_appkit_button_toggles(handle: usize) -> i32
extern elisa_appkit_scroll_has_vertical(handle: usize) -> i32
extern elisa_appkit_scroll_has_horizontal(handle: usize) -> i32
extern elisa_appkit_frame_width(handle: usize) -> f32
extern elisa_appkit_frame_x(handle: usize) -> f32
extern elisa_appkit_frame_y(handle: usize) -> f32
extern elisa_appkit_is_flipped(handle: usize) -> i32
extern elisa_appkit_progress_is_indeterminate(handle: usize) -> i32
extern elisa_appkit_progress_style(handle: usize) -> i32


# Objective-C/CFString calls live behind one explicit native module.
include "./ui_appkit_native.elisa"

module UiAppKit:
    private:
        const STANDARD_WINDOW_WIDTH: f32 = 640.0
        const STANDARD_WINDOW_HEIGHT: f32 = 480.0
        const FLOATING_PANEL_WIDTH: f32 = 480.0
        const FLOATING_PANEL_HEIGHT: f32 = 320.0

    public:
        # The AppKit controls backend. A TYPE, not a value: native handles live
        # in UiControls' retained records, so methods are static and the
        # specialization inlines straight through to typed C entry points.
        struct AppKitControls:
            unused: i32

        def native_handle(index: i32) -> usize:
            return 0 if index < 0
            return 0 if index.usize() >= UiControls::count()
            return UiControls::native_handle_at(index.usize())

        # Keep the retained Cocoa identity in the same Elisa record that owns
        # the control index. Children are attached only after their constructor
        # has returned a non-zero handle and their parent was created earlier in
        # the parent-first control walk.
        def record_created(index: i32, handle: usize, parent: i32, parent_kind: UiControls::Kind) -> void:
            return if index < 0
            UiControls::set_native_handle(index.usize(), handle)
            return if handle == 0 or parent < 0
            parent_handle: usize = native_handle(parent)
            return if parent_handle == 0
            if parent_kind == UiControls::Kind.Window:
                UiAppKitNative::native_attach_to_window(handle, parent_handle)
                return
            if parent_kind == UiControls::Kind.ScrollView:
                UiAppKitNative::native_attach_to_scroll_view(handle, parent_handle)
                return
            UiAppKitNative::native_attach_to_view(handle, parent_handle)

        # Class names used by the headless read-back check are framework text
        # too. Build them as counted CoreFoundation strings so the native shim
        # only resolves an already-constructed NSString class identity.
        def class_is(index: i32, name: sview) -> i32 can Unsafe.PointerCast:
            native: usize = UiAppKitNative::native_string(name)
            return 0 if native == 0
            result: i32 = elisa_appkit_is_class(native_handle(index), native)
            CFRelease(native)
            return result

        # Introspection also resolves through Elisa's handle table. Keeping the
        # index-shaped helpers here lets headless checks talk about the retained
        # control list without teaching the native shim anything about indices.
        def subview_count(index: i32) -> i32:
            return elisa_appkit_subview_count(native_handle(index))

        def window_is_resizable(index: i32) -> i32:
            return elisa_appkit_window_is_resizable(native_handle(index))

        def window_is_floating(index: i32) -> i32:
            return elisa_appkit_window_is_floating(native_handle(index))

        def panel_becomes_key_only(index: i32) -> i32:
            return elisa_appkit_panel_becomes_key_only(native_handle(index))

        def button_is_on(index: i32) -> i32:
            return elisa_appkit_button_is_on(native_handle(index))

        def button_bezel_style(index: i32) -> i32:
            return elisa_appkit_button_bezel_style(native_handle(index))

        def button_toggles(index: i32) -> i32:
            return elisa_appkit_button_toggles(native_handle(index))

        def scroll_has_vertical(index: i32) -> i32:
            return elisa_appkit_scroll_has_vertical(native_handle(index))

        def scroll_has_horizontal(index: i32) -> i32:
            return elisa_appkit_scroll_has_horizontal(native_handle(index))

        def frame_width(index: i32) -> f32:
            return elisa_appkit_frame_width(native_handle(index))

        def frame_x(index: i32) -> f32:
            return elisa_appkit_frame_x(native_handle(index))

        def frame_y(index: i32) -> f32:
            return elisa_appkit_frame_y(native_handle(index))

        def is_flipped(index: i32) -> i32:
            return elisa_appkit_is_flipped(native_handle(index))

        def progress_is_indeterminate(index: i32) -> i32:
            return elisa_appkit_progress_is_indeterminate(native_handle(index))

        def progress_style(index: i32) -> i32:
            return elisa_appkit_progress_style(native_handle(index))

        impl Controls for AppKitControls:
            def create(index: i32, kind: UiControls::Kind, parent: i32, window_mode: UiControls::WindowMode, axis: UiConst::Axis, state: UiControls::ControlState) -> void:
                can Ui.Controls:
                    # Parent placement is decided from the Elisa control list;
                    # native constructors return only a retained opaque object.
                    parent_kind: mutable UiControls::Kind = UiControls::Kind.Panel
                    if parent >= 0:
                        parent_kind <- UiControls::kind_at(parent.usize())
                    if kind == UiControls::Kind.Window:
                        if window_mode == UiControls::WindowMode.Floating:
                            handle: usize = UiAppKitNative::native_create_panel_window(UiAppKitNative::floating_panel_style(), elisa_appkit_backing_store_buffered, 1, 1, FLOATING_PANEL_WIDTH, FLOATING_PANEL_HEIGHT)
                            record_created(index, handle, parent, parent_kind)
                            return
                        handle: usize = UiAppKitNative::native_create_window(UiAppKitNative::standard_window_style(window_mode == UiControls::WindowMode.Resizable), elisa_appkit_backing_store_buffered, STANDARD_WINDOW_WIDTH, STANDARD_WINDOW_HEIGHT)
                        record_created(index, handle, parent, parent_kind)
                        return
                    if kind == UiControls::Kind.Panel:
                        handle: usize = UiAppKitNative::native_create_panel()
                        record_created(index, handle, parent, parent_kind)
                        return
                    if kind == UiControls::Kind.ScrollView:
                        vertical: i32 = 0 if axis == UiConst::Axis.Row else 1
                        horizontal: i32 = 1 if axis == UiConst::Axis.Row else 0
                        handle: usize = UiAppKitNative::native_create_scroll_view(vertical, horizontal)
                        record_created(index, handle, parent, parent_kind)
                        return
                    if kind == UiControls::Kind.Label:
                        empty: usize = UiAppKitNative::empty_native_string()
                        return if empty == 0
                        handle: usize = UiAppKitNative::native_create_label(empty)
                        CFRelease(empty)
                        record_created(index, handle, parent, parent_kind)
                        return
                    if kind == UiControls::Kind.PushButton:
                        empty: usize = UiAppKitNative::empty_native_string()
                        return if empty == 0
                        handle: usize = UiAppKitNative::native_create_push_button(elisa_appkit_bezel_style_rounded, empty)
                        CFRelease(empty)
                        record_created(index, handle, parent, parent_kind)
                        return
                    if kind == UiControls::Kind.ToggleButton:
                        empty: usize = UiAppKitNative::empty_native_string()
                        return if empty == 0
                        handle: usize = UiAppKitNative::native_create_toggle_button(elisa_appkit_button_type_push_on_push_off, empty)
                        CFRelease(empty)
                        record_created(index, handle, parent, parent_kind)
                        return
                    if kind == UiControls::Kind.CheckBox:
                        empty: usize = UiAppKitNative::empty_native_string()
                        return if empty == 0
                        handle: usize = UiAppKitNative::native_create_checkbox(empty)
                        CFRelease(empty)
                        record_created(index, handle, parent, parent_kind)
                        return
                    if kind == UiControls::Kind.RadioButton:
                        empty: usize = UiAppKitNative::empty_native_string()
                        return if empty == 0
                        handle: usize = UiAppKitNative::native_create_radio_button(empty)
                        CFRelease(empty)
                        record_created(index, handle, parent, parent_kind)
                        return
                    if kind == UiControls::Kind.TextField:
                        empty: usize = UiAppKitNative::empty_native_string()
                        return if empty == 0
                        handle: usize = UiAppKitNative::native_create_text_field(empty)
                        CFRelease(empty)
                        record_created(index, handle, parent, parent_kind)
                        return
                    if kind == UiControls::Kind.Slider:
                        handle: usize = UiAppKitNative::native_create_slider(state.low, state.high, state.value)
                        record_created(index, handle, parent, parent_kind)
                        return
                    if kind == UiControls::Kind.ProgressBar:
                        handle: usize = UiAppKitNative::native_create_progress_bar(elisa_appkit_progress_style_bar, 0)
                        record_created(index, handle, parent, parent_kind)

            def set_frame(index: i32, kind: UiControls::Kind, box: UiCore::Rect) -> void:
                can Ui.Controls:
                    handle: usize = native_handle(index)
                    return if handle == 0
                    if kind == UiControls::Kind.Window:
                        UiAppKitNative::native_set_window_frame(handle, box.size.width, box.size.height)
                        return
                    UiAppKitNative::native_set_view_frame(handle, box.origin.x, box.origin.y, box.size.width, box.size.height)
                    if kind == UiControls::Kind.ScrollView:
                        UiAppKitNative::native_set_scroll_document_frame(handle, box.size.width, box.size.height)

            def set_text(index: i32, kind: UiControls::Kind, text: sview) -> void:
                # Native controls copy this borrowed CoreFoundation string in
                # their Cocoa setter. The bridge therefore performs only the
                # object assignment, not framework-side text conversion.
                value: usize = UiAppKitNative::native_string(text)
                return if value == 0
                handle: usize = native_handle(index)
                if kind == UiControls::Kind.Window:
                    UiAppKitNative::native_set_window_title(handle, value)
                if kind == UiControls::Kind.PushButton or kind == UiControls::Kind.ToggleButton or kind == UiControls::Kind.CheckBox or kind == UiControls::Kind.RadioButton:
                    UiAppKitNative::native_set_button_title(handle, value)
                if kind == UiControls::Kind.Label or kind == UiControls::Kind.TextField:
                    UiAppKitNative::native_set_field_text(handle, value)
                CFRelease(value)

            def set_state(index: i32, kind: UiControls::Kind, value: f32, low: f32, high: f32, selected: bool) -> void:
                can Ui.Controls:
                    handle: usize = native_handle(index)
                    return if handle == 0
                    if kind == UiControls::Kind.ToggleButton or kind == UiControls::Kind.CheckBox or kind == UiControls::Kind.RadioButton:
                        UiAppKitNative::native_set_button_state(handle, elisa_appkit_control_state_on if selected else elisa_appkit_control_state_off)
                        return
                    if kind == UiControls::Kind.Slider:
                        UiAppKitNative::native_set_slider_state(handle, low, high, value)
                        return
                    if kind == UiControls::Kind.ProgressBar:
                        UiAppKitNative::native_set_progress_value(handle, value)

        # Release the retained handles before the next realization. Child views
        # may still be retained by their old parent, but releasing every Elisa
        # ownership reference (including the root window) lets ARC tear down the
        # old tree without leaving a second native lifetime table behind.
        def release_native_handles() -> void:
            # UiControls emits parents before children. Release the retained
            # handles in reverse order so a parent deallocation cannot invalidate
            # a child handle that Elisa still needs to release.
            count: usize = UiControls::count()
            index: mutable usize = count
            while index > 0 |index|:
                index <- index - 1
                handle: usize = UiControls::native_handle_at(index)
                # Clear Elisa's ownership slot before crossing the FFI boundary.
                # If Cocoa synchronously tears down part of the old tree, any
                # re-entrant lookup fails closed instead of observing a handle
                # whose retain is already being relinquished.
                UiControls::set_native_handle(index, 0) if handle != 0
                CFRelease(handle) if handle != 0

        # Realize a laid-out widget tree as native controls. Run UiWidgets::layout
        # first: every control is placed at the box it computed.
        def realize(root: UiWidgets::Widget) -> void:
            can[Ui.Controls]:
                release_native_handles()
                UiControls::reset()
                UiControls::realize(root, UiControls::NO_PARENT, 0)
                UiControls::apply[AppKitControls]()

        def start() -> void:
            # UiControls owns the validated arena, dense index sequence and
            # retained native identities. AppKit initialization only establishes
            # the Cocoa application object.
            UiAppKitNative::native_init()
            UiAppKitNative::native_set_activation_policy(elisa_appkit_activation_policy_regular)

        def present() -> void:
            # The retained realization always emits its root at index zero.
            UiAppKitNative::native_present(native_handle(0))
            UiAppKitNative::native_activate()

        def run() -> void:
            UiAppKitNative::native_run()
