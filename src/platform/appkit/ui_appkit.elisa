# elisa-ui AppKit backend: the widget tree as real macOS controls.
#
# The first NATIVE backend. SDL3 and WasmBrowser both draw -- they consume the
# command list and own every pixel. This one owns none: it creates NSWindows,
# NSButtons and NSTextFields and lets AppKit draw them, lay out their text,
# handle the IME, mirror right-to-left and talk to VoiceOver. That is the whole
# reason to want native controls, and none of it is reachable by drawing
# rectangles.
#
# The Objective-C lives in appkit_shim.m, not here. objc_msgSend has no single
# signature -- on arm64 each call must be cast to the exact prototype of the
# method being sent, and a wrong cast is a silent ABI mismatch, not a link error.
# That cast is a C operation, so Elisa sees a flat typed C API exactly as it does
# for SDL3.
#
# The shim also owns the index -> NSView* table. UiControls hands out dense
# indices for precisely this reason; every real toolkit keeps such a table.

include "../../widgets/ui_controls.elisa"

# `impl UiControls::Controls for T:` is rejected by stage0's parser, so the impl
# below names `Controls` unqualified and this is what resolves it.
using UiControls

extern elisa_appkit_init() -> void
extern elisa_appkit_activation_policy_regular() -> i32
extern elisa_appkit_set_activation_policy(policy: i32) -> void
extern elisa_appkit_window_style_titled() -> i32
extern elisa_appkit_window_style_closable() -> i32
extern elisa_appkit_window_style_miniaturizable() -> i32
extern elisa_appkit_window_style_resizable() -> i32
extern elisa_appkit_window_style_utility() -> i32
extern elisa_appkit_bezel_style_rounded() -> i32
extern elisa_appkit_button_type_push_on_push_off() -> i32
extern elisa_appkit_control_state_on() -> i32
extern elisa_appkit_control_state_off() -> i32
extern elisa_appkit_progress_style_bar() -> i32
extern elisa_appkit_backing_store_buffered() -> i32
extern elisa_appkit_create_window_with_style(index: i32, style: i32, backing: i32, width: f32, height: f32) -> void
extern elisa_appkit_create_panel_window(index: i32, style: i32, backing: i32, floating: i32, becomes_key_only: i32, width: f32, height: f32) -> void
extern elisa_appkit_create_panel(index: i32) -> void
extern elisa_appkit_create_scroll_view(index: i32, vertical: i32, horizontal: i32) -> void
extern elisa_appkit_create_label(index: i32, text: usize) -> void
extern elisa_appkit_create_push_button(index: i32, bezel_style: i32, text: usize) -> void
extern elisa_appkit_create_toggle_button(index: i32, button_type: i32, text: usize) -> void
extern elisa_appkit_create_checkbox(index: i32, text: usize) -> void
extern elisa_appkit_create_radio_button(index: i32, text: usize) -> void
extern elisa_appkit_create_text_field(index: i32, text: usize) -> void
extern elisa_appkit_create_slider(index: i32, low: f32, high: f32, value: f32) -> void
extern elisa_appkit_create_progress_bar(index: i32, progress_style: i32, indeterminate: i32) -> void
extern elisa_appkit_attach_to_window(index: i32, parent: i32) -> void
extern elisa_appkit_attach_to_scroll_view(index: i32, parent: i32) -> void
extern elisa_appkit_attach_to_view(index: i32, parent: i32) -> void
extern elisa_appkit_set_window_frame(index: i32, width: f32, height: f32) -> void
extern elisa_appkit_set_view_frame(index: i32, x: f32, y: f32, width: f32, height: f32) -> void
extern elisa_appkit_set_scroll_document_frame(index: i32, width: f32, height: f32) -> void
extern elisa_appkit_set_window_title(index: i32, text: usize) -> void
extern elisa_appkit_set_button_title(index: i32, text: usize) -> void
extern elisa_appkit_set_field_text(index: i32, text: usize) -> void
extern elisa_appkit_set_button_state(index: i32, state: i32) -> void
extern elisa_appkit_set_slider_state(index: i32, low: f32, high: f32, value: f32) -> void
extern elisa_appkit_set_progress_value(index: i32, value: f32) -> void
extern elisa_appkit_present() -> void
extern elisa_appkit_activate() -> void
extern elisa_appkit_run() -> void
extern CFStringCreateWithBytes(allocator: usize, bytes: cstr, length: i64, encoding: u32, external: bool) -> usize
extern CFRelease(value: usize) -> void

# The retained widget model uses top-left coordinates on every backend. Keep
# that convention in Elisa; the native view merely adapts Cocoa's protocol
# callback to this framework fact.
def appkit_view_is_flipped() -> i32:
    return 1

export fn elisa_appkit_view_is_flipped() -> i32 = appkit_view_is_flipped

# Read back from the live AppKit objects, for the headless check.
extern elisa_appkit_control_count() -> i32
extern elisa_appkit_subview_count(index: i32) -> i32
extern elisa_appkit_is_class(index: i32, class_name: usize) -> i32
extern elisa_appkit_window_is_resizable(index: i32) -> i32
extern elisa_appkit_window_is_floating(index: i32) -> i32
extern elisa_appkit_panel_becomes_key_only(index: i32) -> i32
extern elisa_appkit_button_is_on(index: i32) -> i32
extern elisa_appkit_button_bezel_style(index: i32) -> i32
extern elisa_appkit_button_toggles(index: i32) -> i32
extern elisa_appkit_scroll_has_vertical(index: i32) -> i32
extern elisa_appkit_scroll_has_horizontal(index: i32) -> i32
extern elisa_appkit_frame_width(index: i32) -> f32
extern elisa_appkit_frame_x(index: i32) -> f32
extern elisa_appkit_frame_y(index: i32) -> f32
extern elisa_appkit_is_flipped(index: i32) -> i32
extern elisa_appkit_progress_is_indeterminate(index: i32) -> i32
extern elisa_appkit_progress_style(index: i32) -> i32

module UiAppKit:
    private:
        const STANDARD_WINDOW_WIDTH: f32 = 640.0
        const STANDARD_WINDOW_HEIGHT: f32 = 480.0
        const FLOATING_PANEL_WIDTH: f32 = 480.0
        const FLOATING_PANEL_HEIGHT: f32 = 320.0
        const UTF8_ENCODING: u32 = 0x08000100

        # Build counted native strings in Elisa. The Objective-C shim borrows
        # the opaque CFString only long enough to assign it to a control, so
        # byte-to-string conversion and its policy stay outside the bridge.
        def native_string(text: sview) -> usize can Unsafe.PointerCast:
            empty: cstr = ""
            pointer: mutable cstr = empty
            pointer <- text.data.cast[cstr] can Unsafe.PointerCast if text.len > 0
            return CFStringCreateWithBytes(0, pointer, text.len.i64(), UTF8_ENCODING, false)

        def empty_native_string() -> usize can Unsafe.PointerCast:
            empty: cstr = ""
            return native_string(sview(empty, 0, 0))

        # AppKit's enum values cross the FFI as opaque facts. The decoration
        # policy itself stays in Elisa, where the widget's WindowMode is already
        # resolved and can be tested without constructing an NSWindow.
        def standard_window_style(resizable: bool) -> i32:
            style: mutable i32 = elisa_appkit_window_style_titled()
            style <- style | elisa_appkit_window_style_closable()
            style <- style | elisa_appkit_window_style_miniaturizable()
            style <- style | elisa_appkit_window_style_resizable() if resizable
            return style

        def floating_panel_style() -> i32:
            style: mutable i32 = elisa_appkit_window_style_titled()
            style <- style | elisa_appkit_window_style_closable()
            style <- style | elisa_appkit_window_style_utility()
            return style

    public:
        # The AppKit controls backend. A TYPE, not a value: every native handle
        # lives in the shim's index table, so the methods are static and the
        # specialization inlines straight through to the C entry points.
        struct AppKitControls:
            unused: i32

        # Class names used by the headless read-back check are framework text
        # too. Build them as counted CoreFoundation strings so the native shim
        # only resolves an already-constructed NSString class identity.
        def class_is(index: i32, name: sview) -> i32 can Unsafe.PointerCast:
            native: usize = native_string(name)
            return 0 if native == 0
            result: i32 = elisa_appkit_is_class(index, native)
            CFRelease(native)
            return result

        def attach_created(index: i32, parent: i32, parent_kind: UiControls::Kind) -> void:
            return if parent < 0
            if parent_kind == UiControls::Kind.Window:
                elisa_appkit_attach_to_window(index, parent)
                return
            if parent_kind == UiControls::Kind.ScrollView:
                elisa_appkit_attach_to_scroll_view(index, parent)
                return
            elisa_appkit_attach_to_view(index, parent)

        impl Controls for AppKitControls:
            def create(index: i32, kind: UiControls::Kind, parent: i32, window_mode: UiControls::WindowMode, axis: UiConst::Axis, state: UiControls::ControlState) -> void:
                can Ui.Controls:
                    # Parent placement is decided from the Elisa control list;
                    # native constructors only create and store their object.
                    parent_kind: mutable UiControls::Kind = UiControls::Kind.Panel
                    if parent >= 0:
                        parent_kind <- UiControls::kind_at(parent.usize())
                    if kind == UiControls::Kind.Window:
                        if window_mode == UiControls::WindowMode.Floating:
                            elisa_appkit_create_panel_window(index, floating_panel_style(), elisa_appkit_backing_store_buffered(), 1, 1, FLOATING_PANEL_WIDTH, FLOATING_PANEL_HEIGHT)
                            return
                        elisa_appkit_create_window_with_style(index, standard_window_style(window_mode == UiControls::WindowMode.Resizable), elisa_appkit_backing_store_buffered(), STANDARD_WINDOW_WIDTH, STANDARD_WINDOW_HEIGHT)
                        return
                    if kind == UiControls::Kind.Panel:
                        elisa_appkit_create_panel(index)
                        attach_created(index, parent, parent_kind)
                        return
                    if kind == UiControls::Kind.ScrollView:
                        vertical: i32 = 0 if axis == UiConst::Axis.Row else 1
                        horizontal: i32 = 1 if axis == UiConst::Axis.Row else 0
                        elisa_appkit_create_scroll_view(index, vertical, horizontal)
                        attach_created(index, parent, parent_kind)
                        return
                    if kind == UiControls::Kind.Label:
                        empty: usize = empty_native_string()
                        return if empty == 0
                        elisa_appkit_create_label(index, empty)
                        CFRelease(empty)
                        attach_created(index, parent, parent_kind)
                        return
                    if kind == UiControls::Kind.PushButton:
                        empty: usize = empty_native_string()
                        return if empty == 0
                        elisa_appkit_create_push_button(index, elisa_appkit_bezel_style_rounded(), empty)
                        CFRelease(empty)
                        attach_created(index, parent, parent_kind)
                        return
                    if kind == UiControls::Kind.ToggleButton:
                        empty: usize = empty_native_string()
                        return if empty == 0
                        elisa_appkit_create_toggle_button(index, elisa_appkit_button_type_push_on_push_off(), empty)
                        CFRelease(empty)
                        attach_created(index, parent, parent_kind)
                        return
                    if kind == UiControls::Kind.CheckBox:
                        empty: usize = empty_native_string()
                        return if empty == 0
                        elisa_appkit_create_checkbox(index, empty)
                        CFRelease(empty)
                        attach_created(index, parent, parent_kind)
                        return
                    if kind == UiControls::Kind.RadioButton:
                        empty: usize = empty_native_string()
                        return if empty == 0
                        elisa_appkit_create_radio_button(index, empty)
                        CFRelease(empty)
                        attach_created(index, parent, parent_kind)
                        return
                    if kind == UiControls::Kind.TextField:
                        empty: usize = empty_native_string()
                        return if empty == 0
                        elisa_appkit_create_text_field(index, empty)
                        CFRelease(empty)
                        attach_created(index, parent, parent_kind)
                        return
                    if kind == UiControls::Kind.Slider:
                        elisa_appkit_create_slider(index, state.low, state.high, state.value)
                        attach_created(index, parent, parent_kind)
                        return
                    if kind == UiControls::Kind.ProgressBar:
                        elisa_appkit_create_progress_bar(index, elisa_appkit_progress_style_bar(), 0)
                        attach_created(index, parent, parent_kind)

            def set_frame(index: i32, kind: UiControls::Kind, box: UiCore::Rect) -> void:
                can Ui.Controls:
                    if kind == UiControls::Kind.Window:
                        elisa_appkit_set_window_frame(index, box.size.width, box.size.height)
                        return
                    elisa_appkit_set_view_frame(index, box.origin.x, box.origin.y, box.size.width, box.size.height)
                    if kind == UiControls::Kind.ScrollView:
                        elisa_appkit_set_scroll_document_frame(index, box.size.width, box.size.height)

            def set_text(index: i32, kind: UiControls::Kind, text: sview) -> void:
                # Native controls copy this borrowed CoreFoundation string in
                # their Cocoa setter. The bridge therefore performs only the
                # object assignment, not framework-side text conversion.
                value: usize = native_string(text)
                return if value == 0
                if kind == UiControls::Kind.Window:
                    elisa_appkit_set_window_title(index, value)
                if kind == UiControls::Kind.PushButton or kind == UiControls::Kind.ToggleButton or kind == UiControls::Kind.CheckBox or kind == UiControls::Kind.RadioButton:
                    elisa_appkit_set_button_title(index, value)
                if kind == UiControls::Kind.Label or kind == UiControls::Kind.TextField:
                    elisa_appkit_set_field_text(index, value)
                CFRelease(value)

            def set_state(index: i32, kind: UiControls::Kind, value: f32, low: f32, high: f32, selected: bool) -> void:
                can Ui.Controls:
                    if kind == UiControls::Kind.ToggleButton or kind == UiControls::Kind.CheckBox or kind == UiControls::Kind.RadioButton:
                        elisa_appkit_set_button_state(index, elisa_appkit_control_state_on() if selected else elisa_appkit_control_state_off())
                        return
                    if kind == UiControls::Kind.Slider:
                        elisa_appkit_set_slider_state(index, low, high, value)
                        return
                    if kind == UiControls::Kind.ProgressBar:
                        elisa_appkit_set_progress_value(index, value)

        # Realize a laid-out widget tree as native controls. Run UiWidgets::layout
        # first: every control is placed at the box it computed.
        def realize(root: UiWidgets::Widget) -> void:
            can[Ui.Controls]:
                UiControls::reset()
                UiControls::realize(root, UiControls::NO_PARENT)
                UiControls::apply[AppKitControls]()

        def start() -> void:
            elisa_appkit_init()
            elisa_appkit_set_activation_policy(elisa_appkit_activation_policy_regular())

        def present() -> void:
            elisa_appkit_present()
            elisa_appkit_activate()

        def run() -> void:
            elisa_appkit_run()
