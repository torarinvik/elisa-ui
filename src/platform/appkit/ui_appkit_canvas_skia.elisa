# Optional Skia frame path for the AppKit custom canvas.
#
# AppKit still owns the window/context. The C++ host creates a temporary Skia
# surface and calls this Elisa export while that surface is borrowed; Elisa
# keeps frame preparation, semantics, command replay, and scheduling here.

include "../skia/ui_skia.elisa"

extend UiAppKitCanvas:
    public:
        # A zero result is reserved for rejection before app_frame mutates the
        # retained model. Once Elisa has entered a frame, every non-painted
        # result is negative so the Objective-C caller cannot replay the same
        # application callbacks through CoreGraphics.
        const SKIA_REPLAY_REJECTED: i32 = 0
        const SKIA_REPLAY_CONSUMED_NO_PRESENTATION: i32 = -1

        def skia_replay(window_handle: usize, canvas: usize, logical_width: f32, logical_height: f32, pixel_width: f32, pixel_height: f32, font: usize) -> i32 can[Ui.Draw, Ui.Text, Unsafe.PointerCast]:
            return SKIA_REPLAY_REJECTED if canvas == 0 or not UiAppKitCanvas::live()
            return SKIA_REPLAY_REJECTED if window_handle != UiAppKitCanvas::window_handle()
            return SKIA_REPLAY_REJECTED if not UiCapabilities::select_skia_renderer()
            scale: f32 = UiCore::backing_scale(logical_width, logical_height, pixel_width, pixel_height)
            return SKIA_REPLAY_REJECTED if scale <= 0.0
            autorelease_pool: usize = objc_autoreleasePoolPush()
            UiAppKitCanvas::begin_native_frame(0)
            UiCore::set_frame_time(UiAppKitCanvas::monotonic_time())
            UiMetrics::begin_frame(UiCore::frame_time())
            UiCore::begin_frame()
            # The borrowed SkCanvas is created after app_frame. Rich Skia-only
            # primitives therefore use this bounded Elisa queue; each record
            # captures its retained command anchor so replay can preserve the
            # application's full draw order.
            UiSkia::begin_deferred_frame()
            previous_font: usize = UiSkia::begin_frame_font(font)
            # UiSkia reports the typeface/scale generations; this adapter is
            # what knows about the widget layer, so it is what invalidates the
            # shared metric cache when either changes.
            _ = UiTextMetrics::set_context(UiSkia::font_generation(), UiSkia::scale_generation())
            frame_generation: u32 = UiLifecycle::generation()
            app_frame()
            same_session: bool = UiLifecycle::generation() == frame_generation
            status: mutable i32 = UiSkia::RenderStatus.SkippedNoSurface.i32()
            if same_session and UiAppKitCanvas::live() and window_handle == UiAppKitCanvas::window_handle():
                UiMetrics::mark_application(UiAppKitCanvas::monotonic_time())
                UiAppKitCanvas::sync_accessibility()
                UiMetrics::mark_semantics(UiAppKitCanvas::monotonic_time())
                UiSkia::attach_scaled(canvas, scale)
                status <- UiSkia::render_status_with_font(font).i32()
                UiSkia::detach()
                UiMetrics::mark_paint(UiAppKitCanvas::monotonic_time())
                UiAppKitCanvas::schedule_next_frame(UiCore::frame_delay())
            UiAppKitCanvas::end_native_frame()
            UiSkia::end_deferred_frame()
            UiSkia::end_frame_font(previous_font)
            if same_session:
                UiMetrics::finish_frame(UiAppKitCanvas::monotonic_time())
            objc_autoreleasePoolPop(autorelease_pool)
            # app_frame has run whenever execution reaches this point. A
            # stopped/replaced window, or a rejected borrowed surface, must
            # never fall through to a second backend replay.
            return SKIA_REPLAY_CONSUMED_NO_PRESENTATION if not same_session or status == UiSkia::RenderStatus.SkippedNoSurface
            return status

def appkit_canvas_skia_replay_callback(window_handle: usize, canvas: usize, logical_width: f32, logical_height: f32, pixel_width: f32, pixel_height: f32, font: usize) -> i32 can[Ui.Draw, Ui.Text, Unsafe.PointerCast]:
    return UiAppKitCanvas::skia_replay(window_handle, canvas, logical_width, logical_height, pixel_width, pixel_height, font)

export fn elisa_appkit_canvas_skia_replay(window_handle: usize, canvas: usize, logical_width: f32, logical_height: f32, pixel_width: f32, pixel_height: f32, font: usize) -> i32 = appkit_canvas_skia_replay_callback
