# Externally mandated AppKit canvas callback exports.
#
# Keeping this ABI-only surface separate makes it obvious which names are
# dictated by the Objective-C shim. The implementation and all policy remain
# in the Elisa adapter modules.

export fn elisa_appkit_canvas_accessibility_activate(window_handle: usize, handle: usize) -> i32 = appkit_flat_accessibility_activate_handle
export fn elisa_appkit_canvas_accessibility_adjust(window_handle: usize, handle: usize, direction: i32) -> i32 = appkit_flat_accessibility_adjust_handle
export fn elisa_appkit_canvas_accessibility_set_value(window_handle: usize, handle: usize, value: usize) -> usize = appkit_flat_accessibility_set_value_handle
export fn elisa_appkit_canvas_window_closed(window_handle: usize) -> void = appkit_flat_window_closed
export fn elisa_appkit_canvas_pointer_move_event(window_handle: usize, x: f32, y: f32) -> usize = appkit_flat_pointer_move_event
export fn elisa_appkit_canvas_pointer_button(window_handle: usize, x: f32, y: f32, button: i32, down: i32, click_count: i32) -> void = appkit_flat_pointer_button
export fn elisa_appkit_canvas_pointer_leave_event(window_handle: usize) -> usize = appkit_flat_pointer_leave_event
# Cocoa passes charactersIgnoringModifiers as a borrowed CFString handle. Keep
# the exported ABI pointer-sized, matching the Objective-C `size_t` declaration;
# Elisa decodes the UTF-16 scalar only after crossing this boundary.
export fn elisa_appkit_canvas_key_down_event(window_handle: usize, event: usize, key_code: i32, character: usize, modifiers: usize) -> void = appkit_flat_key_down_event
export fn elisa_appkit_canvas_key_up(window_handle: usize, key_code: i32, character: usize) -> void = appkit_flat_key_up
export fn elisa_appkit_canvas_selection_location(window_handle: usize) -> usize = appkit_flat_selection_location
export fn elisa_appkit_canvas_selection_length(window_handle: usize) -> usize = appkit_flat_selection_length
export fn elisa_appkit_canvas_set_selected_range(window_handle: usize, handle: usize, location: usize, length: usize) -> i32 = appkit_flat_set_selected_range_handle
export fn elisa_appkit_canvas_selected_range(window_handle: usize, handle: usize, actual_location: mutable usize&, actual_length: mutable usize&) -> i32 = appkit_flat_selected_range_handle
export fn elisa_appkit_canvas_marked_location(window_handle: usize) -> usize = appkit_flat_marked_location
export fn elisa_appkit_canvas_marked_length(window_handle: usize) -> usize = appkit_flat_marked_length
export fn elisa_appkit_canvas_has_marked_text(window_handle: usize) -> i32 = appkit_flat_has_marked_text
export fn elisa_appkit_canvas_commit_text(window_handle: usize, text: usize, replacement_location: usize, replacement_length: usize) -> void = appkit_flat_commit_text
export fn elisa_appkit_canvas_update_marked_text(window_handle: usize, text: usize, selected_location: usize, selected_length: usize, replacement_location: usize, replacement_length: usize) -> void = appkit_flat_update_marked_text
export fn elisa_appkit_canvas_unmark_text(window_handle: usize) -> void = appkit_flat_unmark_text
export fn elisa_appkit_canvas_text_selector_handle(window_handle: usize, selector: usize) -> void = appkit_flat_text_selector_handle
export fn elisa_appkit_canvas_text_action_selector(window_handle: usize, selector: usize) -> void = appkit_flat_text_action_selector
export fn elisa_appkit_canvas_text_action_valid_selector(window_handle: usize, selector: usize) -> i32 = appkit_flat_text_action_valid_selector
export fn elisa_appkit_canvas_character_at_x(window_handle: usize, x: f32) -> usize = appkit_flat_character_at_x
export fn elisa_appkit_canvas_attributed_substring(window_handle: usize, location: usize, length: usize, actual_location: mutable usize&, actual_length: mutable usize&) -> usize = appkit_flat_attributed_substring
export fn elisa_appkit_canvas_first_rect(window_handle: usize, location: usize, length: usize, actual_location: mutable usize&, actual_length: mutable usize&, x: mutable f32&, y: mutable f32&, width: mutable f32&, height: mutable f32&) -> i32 = appkit_flat_first_rect
