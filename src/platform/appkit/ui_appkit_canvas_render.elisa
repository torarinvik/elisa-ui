extend UiAppKitCanvas:
        def sync_accessibility() -> void can Unsafe.PointerCast:
            next_count: usize = UiCore::accessibility_count()
            previous_count: usize = accessibility_previous_count
            layout_changed: mutable bool = accessibility_force_layout or next_count != accessibility_previous_count
            for index in 0..<UiCore::accessibility_count():
                node: UiCore::AccessibilityNode = UiCore::accessibility_at(index)
                identifier: sview = accessibility_identifier(node.id)
                native_identifier: usize = native_string(identifier)
                native_label: usize = native_string(node.label)
                native_help: mutable usize = 0
                native_help <- native_string(node.help) if node.help.len > 0
                stable_label: sview = copy_accessibility_text(node.label, &accessibility_next_label_storage[0], index)
                stable_help: sview = copy_accessibility_text(node.help, &accessibility_next_help_storage[0], index)
                enabled: i32 = 1 if node.enabled else 0
                focused: i32 = 1 if node.focused else 0
                selected: i32 = 1 if node.selected else 0
                interaction: i32 = accessibility_interaction(node.role, node.enabled)
                value_kind: i32 = accessibility_value_kind(node.role)
                cursor: i32 = accessibility_cursor(node.role, node.enabled)
                native_role: usize = accessibility_native_role(node.role)
                native_subrole: usize = accessibility_native_subrole(node.role)
                state: AccessibilityState = AccessibilityState{
                    role: node.role.i32(), action: node.action, interaction, value_kind, cursor,
                    enabled: node.enabled, focused: node.focused, selected: node.selected,
                    value: node.value, text_revision: node.revision,
                    selection_location: node.selection_location, selection_length: node.selection_length,
                    label: stable_label, help: stable_help,
                    x: node.frame.origin.x, y: node.frame.origin.y,
                    width: node.frame.size.width, height: node.frame.size.height,
                    parent_id: node.parent_id, first_child_id: node.first_child_id,
                    next_sibling_id: node.next_sibling_id, has_range: node.has_range,
                    range_min: node.range_min, range_max: node.range_max,
                    range_conflict: node.range_conflict,
                }
                previous_index: usize = previous_accessibility_index(node.id)
                existed: bool = previous_index < accessibility_previous_count
                previous_handle: usize = accessibility_previous_handles[previous_index] if existed else 0
                before: AccessibilityState = accessibility_previous[previous_index] if existed else state
                layout_changed <- true if accessibility_layout_changed(existed, before, state)
                layout_changed <- true if index >= accessibility_previous_count or accessibility_previous_ids[index] != node.id
                accessibility_next_ids[index] <- node.id
                accessibility_next[index] <- state
                # Identity/reuse is decided from Elisa's semantic history and
                # sent as an explicit token. The native bridge must not infer
                # framework identity by probing an opaque handle.
                is_new: i32 = 1 if not existed or previous_handle == 0 else 0
                handle: usize = elisa_appkit_canvas_accessibility_add(canvas_window, previous_handle, is_new, native_identifier, native_role, native_subrole, native_label, native_help, node.frame.origin.x, node.frame.origin.y, node.frame.size.width, node.frame.size.height, enabled, focused)
                accessibility_next_handles[index] <- handle
                # New elements are not reachable from Cocoa's committed list,
                # so their role-specific values can be staged immediately. A
                # reused element must stay untouched until the child-list
                # transaction below succeeds; otherwise a later allocation
                # failure would leave the old list with new values.
                if is_new != 0 and handle != 0:
                    elisa_appkit_canvas_accessibility_clear_value(handle, not_found(), 0)
                    if value_kind == 1:
                        native_selected: usize = native_boolean_value(selected)
                        elisa_appkit_canvas_accessibility_set_boolean_value(handle, native_selected)
                        CFRelease(native_selected) if native_selected != 0
                    if value_kind == 2:
                        native_value: usize = native_float_value(node.value)
                        native_minimum: usize = native_float_value(node.range_min if node.has_range else ACCESSIBILITY_RANGE_MINIMUM)
                        native_maximum: usize = native_float_value(node.range_max if node.has_range else ACCESSIBILITY_RANGE_MAXIMUM)
                        elisa_appkit_canvas_accessibility_set_range_values(handle, native_value, native_minimum, native_maximum)
                        CFRelease(native_value) if native_value != 0
                        CFRelease(native_minimum) if native_minimum != 0
                        CFRelease(native_maximum) if native_maximum != 0
                    if value_kind == 3:
                        # Always pass counted strings, including empty values.
                        # The native bridge only assigns these objects and
                        # never manufactures an Objective-C empty fallback.
                        native_value: usize = native_string(node.text_value)
                        native_selected: usize = native_string(node.selected_text)
                        elisa_appkit_canvas_accessibility_set_text(handle, native_value, native_selected, node.selection_location, node.selection_length)
                        CFRelease(native_value) if native_value != 0
                        CFRelease(native_selected) if native_selected != 0
                CFRelease(native_identifier) if native_identifier != 0
                CFRelease(native_label) if native_label != 0
                CFRelease(native_help) if native_help != 0
            # Capture handles that are leaving the semantic tree before the
            # previous-frame arrays are overwritten. A handle is retained only
            # when the same semantic ID still points at that exact native
            # element; replacement handles must not be confused with reuse.
            accessibility_stale_count <- 0
            for previous_index in 0..<previous_count:
                previous_id: usize = accessibility_previous_ids[previous_index]
                previous_handle: usize = accessibility_previous_handles[previous_index]
                retained: mutable bool = false
                for next_index in 0..<next_count:
                    retained <- true if accessibility_next_ids[next_index] == previous_id and previous_handle != 0 and accessibility_next_handles[next_index] == previous_handle
                if not retained and accessibility_stale_count < UiCore::MAX_ACCESSIBILITY_NODES:
                    accessibility_stale_handles[accessibility_stale_count] <- previous_handle
                    accessibility_stale_count <- accessibility_stale_count + 1

            committed: bool = commit_accessibility_children(next_count)
            if committed:
                # The child list is now accepted by Cocoa. Apply metadata and
                # value state to reused elements only after that point, then
                # emit notifications against the committed identities. Any
                # failure before the commit therefore leaves the old semantic
                # objects completely unchanged.
                for index in 0..<next_count:
                    handle: usize = accessibility_next_handles[index]
                    continue if handle == 0
                    node: UiCore::AccessibilityNode = UiCore::accessibility_at(index)
                    identifier: sview = accessibility_identifier(node.id)
                    native_identifier: usize = native_string(identifier)
                    native_label: usize = native_string(node.label)
                    native_help: mutable usize = 0
                    native_help <- native_string(node.help) if node.help.len > 0
                    _ = elisa_appkit_canvas_accessibility_update(canvas_window, handle,
                        native_identifier, accessibility_native_role(node.role),
                        accessibility_native_subrole(node.role), native_label,
                        native_help, node.frame.origin.x, node.frame.origin.y,
                        node.frame.size.width, node.frame.size.height,
                        1 if node.enabled else 0, 1 if node.focused else 0)
                    previous_index: usize = previous_accessibility_index(node.id)
                    existed: bool = previous_index < previous_count
                    before: AccessibilityState = accessibility_previous[previous_index] if existed else accessibility_next[index]
                    value_kind: i32 = accessibility_value_kind(node.role)
                    if existed:
                        value_kind_changed: bool = before.value_kind != value_kind
                        elisa_appkit_canvas_accessibility_clear_value(handle, not_found(), 0) if value_kind_changed
                        if value_kind == 1:
                            native_selected: usize = native_boolean_value(1 if node.selected else 0)
                            elisa_appkit_canvas_accessibility_set_boolean_value(handle, native_selected)
                            CFRelease(native_selected) if native_selected != 0
                        if value_kind == 2:
                            native_value: usize = native_float_value(node.value)
                            native_minimum: usize = native_float_value(node.range_min if node.has_range else ACCESSIBILITY_RANGE_MINIMUM)
                            native_maximum: usize = native_float_value(node.range_max if node.has_range else ACCESSIBILITY_RANGE_MAXIMUM)
                            elisa_appkit_canvas_accessibility_set_range_values(handle, native_value, native_minimum, native_maximum)
                            CFRelease(native_value) if native_value != 0
                            CFRelease(native_minimum) if native_minimum != 0
                            CFRelease(native_maximum) if native_maximum != 0
                        if value_kind == 3:
                            native_value: usize = native_string(node.text_value)
                            native_selected: usize = native_string(node.selected_text)
                            elisa_appkit_canvas_accessibility_set_text(handle, native_value, native_selected, node.selection_location, node.selection_length)
                            CFRelease(native_value) if native_value != 0
                            CFRelease(native_selected) if native_selected != 0
                    notifications: i32 = accessibility_notifications(existed, before, accessibility_next[index])
                    accessibility_notify(handle, notifications) if notifications != 0
                    CFRelease(native_identifier) if native_identifier != 0
                    CFRelease(native_label) if native_label != 0
                    CFRelease(native_help) if native_help != 0
                # Publish the new history only after Cocoa has accepted the
                # replacement list. The CFArray has no retain callbacks, so
                # stale handles remain live through the native commit itself.
                accessibility_previous_count <- next_count
                for index in 0..<accessibility_previous_count:
                    accessibility_previous_ids[index] <- accessibility_next_ids[index]
                    accessibility_previous_handles[index] <- accessibility_next_handles[index]
                    _ = copy_accessibility_text(accessibility_next[index].label, &accessibility_previous_label_storage[0], index)
                    _ = copy_accessibility_text(accessibility_next[index].help, &accessibility_previous_help_storage[0], index)
                    previous_state: mutable AccessibilityState = accessibility_next[index]
                    previous_state.label <- sview(&accessibility_previous_label_storage[index * ACCESSIBILITY_TEXT_CAPACITY], 0, previous_state.label.len)
                    previous_state.help <- sview(&accessibility_previous_help_storage[index * ACCESSIBILITY_TEXT_CAPACITY], 0, previous_state.help.len)
                    accessibility_previous[index] <- previous_state
                # Now that the view references the new list, release old or
                # superseded handles that are no longer reachable from it.
                for stale_index in 0..<accessibility_stale_count:
                    stale_handle: usize = accessibility_stale_handles[stale_index]
                    elisa_appkit_canvas_accessibility_release(stale_handle) if stale_handle != 0
                    accessibility_stale_handles[stale_index] <- 0
            else:
                # Keep the old semantic list and ownership when allocation or
                # native validation fails. Newly-created elements are not in
                # that old list, so they can be released immediately; reused
                # handles remain owned by the previous-frame table.
                for next_index in 0..<next_count:
                    candidate: usize = accessibility_next_handles[next_index]
                    known: mutable bool = false
                    for previous_index in 0..<previous_count:
                        known <- true if candidate != 0 and candidate == accessibility_previous_handles[previous_index]
                    if candidate != 0 and not known:
                        elisa_appkit_canvas_accessibility_release(candidate)
                    accessibility_next_handles[next_index] <- 0
                for stale_index in 0..<accessibility_stale_count:
                    accessibility_stale_handles[stale_index] <- 0
            accessibility_stale_count <- 0
            if committed and layout_changed:
                rebuild_accessibility_tooltips(next_count)
                elisa_appkit_canvas_accessibility_invalidate_cursor_rects(canvas_window)
                root_view: usize = elisa_appkit_canvas_accessibility_root(canvas_window)
                NSAccessibilityPostNotification(root_view, NSAccessibilityLayoutChangedNotification) if root_view != 0
            accessibility_force_layout <- false if committed

        struct AppKitPainter:
            unused: i32

        impl Painter for AppKitPainter:
            def push_clip(box: UiCore::Rect) -> void can[Ui.Draw]:
                context: usize = current_context()
                CGContextSaveGState(context)
                CGContextBeginPath(context)
                CGContextMoveToPoint(context, box.origin.x.f64(), box.origin.y.f64())
                CGContextAddLineToPoint(context, (box.origin.x + box.size.width).f64(), box.origin.y.f64())
                CGContextAddLineToPoint(context, (box.origin.x + box.size.width).f64(), (box.origin.y + box.size.height).f64())
                CGContextAddLineToPoint(context, box.origin.x.f64(), (box.origin.y + box.size.height).f64())
                CGContextClosePath(context)
                CGContextClip(context)
            def pop_clip() -> void can[Ui.Draw]:
                CGContextRestoreGState(current_context())
            def clear(color: UiCore::Color) -> void can[Ui.Draw]:
                context: usize = current_context()
                set_fill_color(context, color)
                CGContextBeginPath(context)
                CGContextMoveToPoint(context, 0.0, 0.0)
                CGContextAddLineToPoint(context, UiCore::viewport_width().f64(), 0.0)
                CGContextAddLineToPoint(context, UiCore::viewport_width().f64(), UiCore::viewport_height().f64())
                CGContextAddLineToPoint(context, 0.0, UiCore::viewport_height().f64())
                CGContextClosePath(context)
                CGContextFillPath(context)
            def fill_rect(box: UiCore::Rect, color: UiCore::Color) -> void can[Ui.Draw]:
                style: UiPaint::RoundedRectStyle = UiPaint::rounded_rect_style(box)
                shadow_alpha: f32 = style.shadow_alpha.f32() / 255.0
                hairline_alpha: f32 = style.hairline_alpha.f32() / 255.0
                context: usize = current_context()
                CGContextSaveGState(context)
                set_shadow(context, 0.0, 2.0, 5.0, shadow_alpha) if shadow_alpha > 0.0
                set_fill_color(context, color)
                rounded_path(context, box, style.radius)
                CGContextFillPath(context)
                CGContextRestoreGState(context)
                CGContextSaveGState(context)
                rounded_path(context, box, style.radius)
                CGContextSetRGBStrokeColor(context, 1.0, 1.0, 1.0, hairline_alpha.f64())
                CGContextSetLineWidth(context, 1.0)
                CGContextStrokePath(context)
                CGContextRestoreGState(context)
            def fill_circle(disc: UiCore::Circle, color: UiCore::Color) -> void can[Ui.Draw]:
                context: usize = current_context()
                set_fill_color(context, color)
                CGContextBeginPath(context)
                CGContextAddArc(context, disc.center.x.f64(), disc.center.y.f64(), disc.radius.f64(), 0.0, 6.283185307179586, 0)
                CGContextFillPath(context)
            def fill_triangle(tri: UiCore::Triangle, color: UiCore::Color) -> void can[Ui.Draw]:
                context: usize = current_context()
                set_fill_color(context, color)
                CGContextBeginPath(context)
                CGContextMoveToPoint(context, tri.a.x.f64(), tri.a.y.f64())
                CGContextAddLineToPoint(context, tri.b.x.f64(), tri.b.y.f64())
                CGContextAddLineToPoint(context, tri.c.x.f64(), tri.c.y.f64())
                CGContextClosePath(context)
                CGContextFillPath(context)
            def fill_line(segment: UiCore::Line, color: UiCore::Color) -> void can[Ui.Draw]:
                context: usize = current_context()
                set_stroke_color(context, color)
                CGContextSetLineWidth(context, 1.0)
                CGContextBeginPath(context)
                CGContextMoveToPoint(context, segment.from_point.x.f64(), segment.from_point.y.f64())
                CGContextAddLineToPoint(context, segment.to_point.x.f64(), segment.to_point.y.f64())
                CGContextStrokePath(context)
            def draw_text(run: UiCore::TextRun, color: UiCore::Color) -> void can[Ui.Draw, Ui.Text]:
                return if run.text.len == 0
                safe_text: sview = UiCore::bounded_text(run.text)
                pointer: cstr = safe_text.data.cast[cstr] can Unsafe.PointerCast
                semibold: i32 = 1 if run.size >= 19.0 else 0
                draw_text_line(pointer, safe_text.len, run.size, semibold, run.origin.x, run.origin.y, color)
