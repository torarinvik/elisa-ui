# Keep per-frame temporary Objective-C objects bounded even for headless
# rendering, which does not enter AppKit's normal event-loop autorelease scope.
# These are libobjc C functions, so the pool lifetime remains in Elisa rather
# than introducing an Objective-C frame wrapper.
