# Snapshot paths come from the process environment and are bounded by the
# platform's path limits in normal use. Keep the scan in Elisa so this backend
# does not acquire a libc dependency for one small string primitive, while the
# bound prevents an unterminated value from becoming an unbounded memory walk.
const SNAPSHOT_PATH_SCAN_CAPACITY: usize = 4096

def appkit_cstr_byte(text: cstr, index: usize) -> u8:
    pointer: uintptr = text.cast[uintptr] can Unsafe.PointerCast
    return 0 if pointer == 0.uintptr()
    trusted [Unsafe.PointerCast, Unsafe.PointerArithmetic]:
        byte: u8& = (pointer + index.uintptr()).cast[u8&]
        return byte

def snapshot_path_length(text: cstr) -> usize:
    pointer: uintptr = text.cast[uintptr] can Unsafe.PointerCast
    return 0 if pointer == 0.uintptr()
    length: usize =
        for index in 0..<SNAPSHOT_PATH_SCAN_CAPACITY |length = SNAPSHOT_PATH_SCAN_CAPACITY| -> length:
            value: u8 = appkit_cstr_byte(text, index)
            length <- index if value == 0
            break if value == 0
    # CAPACITY + 1 is an explicit invalid sentinel: a valid path can be exactly
    # CAPACITY bytes long, but this value had no terminator in the scan window.
    return SNAPSHOT_PATH_SCAN_CAPACITY + 1 if length == SNAPSHOT_PATH_SCAN_CAPACITY else length

# CoreFoundation strings created by `native_string` share the framework's
# counted-text budget. Keep the environment scan's larger memory-safety bound,
# but reject a path that would be silently truncated by that bridge.
def snapshot_path_within_budget(length: usize) -> bool:
    return length <= UiCore::MAX_TEXT_BYTES

def appkit_cstr_equals(left: cstr, right: cstr) -> bool:
    left_pointer: uintptr = left.cast[uintptr] can Unsafe.PointerCast
    right_pointer: uintptr = right.cast[uintptr] can Unsafe.PointerCast
    return false if left_pointer == 0.uintptr() or right_pointer == 0.uintptr()
    condition: bool =
        for index in 0..<SNAPSHOT_PATH_SCAN_CAPACITY |condition = false| -> condition:
            left_byte: u8 = appkit_cstr_byte(left, index)
            right_byte: u8 = appkit_cstr_byte(right, index)
            condition <- false if left_byte != right_byte
            break if left_byte != right_byte
            condition <- true if left_byte == 0
            break if left_byte == 0
    return condition

def ui_measure_text_width(text: sview, size: f32) -> f32:
    return 0.0 if text.len <= 0 or text.data == null
    safe_text: sview = UiCore::bounded_text(text)
    return 0.0 if safe_text.len <= 0 or safe_text.data == null
    pointer: cstr = safe_text.data.cast[cstr] can Unsafe.PointerCast
    safe_size: f32 = UiCore::bounded_extent(size)
    semibold: i32 = 1 if safe_size >= 19.0 else 0
    return UiCore::bounded_extent(UiAppKitCanvas::text_width(pointer, safe_text.len, safe_size, semibold))
def ui_measure_text_height(text: sview, size: f32) -> f32:
    return UiAppKitCanvas::font_line_height(UiCore::bounded_extent(size))
def ui_font_ascent(size: f32) -> f32:
    return UiAppKitCanvas::font_ascent(UiCore::bounded_extent(size))
def ui_text_line_height(size: f32) -> f32:
    return UiAppKitCanvas::font_line_height(UiCore::bounded_extent(size))

def appkit_canvas_tracking_options() -> usize:
    options: mutable usize = elisa_appkit_canvas_tracking_mouse_moved
    options <- options | elisa_appkit_canvas_tracking_mouse_entered_exited
    options <- options | elisa_appkit_canvas_tracking_active_in_key_window
    options <- options | elisa_appkit_canvas_tracking_in_visible_rect
    return options

export fn elisa_appkit_canvas_tracking_options() -> usize = appkit_canvas_tracking_options

# Cocoa asks these values through NSView's protocol methods. They describe
# framework policy (coordinate orientation, keyboard focus, and the semantic
# root), so keep the decisions in Elisa and let Objective-C only adapt the
# callbacks to BOOL.
def appkit_canvas_view_is_flipped() -> i32:
    return 1

def appkit_canvas_view_accepts_first_responder() -> i32:
    return 1

def appkit_canvas_view_is_accessibility_element() -> i32:
    return 0

export fn elisa_appkit_canvas_view_is_flipped() -> i32 = appkit_canvas_view_is_flipped
export fn elisa_appkit_canvas_view_accepts_first_responder() -> i32 = appkit_canvas_view_accepts_first_responder
export fn elisa_appkit_canvas_view_is_accessibility_element() -> i32 = appkit_canvas_view_is_accessibility_element
