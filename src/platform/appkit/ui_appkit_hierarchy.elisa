# The immediate hierarchy, on macOS, as real AppKit controls.
#
# The half of the controls backend that knows UiWidgets, kept apart from the
# backend itself for the reason the iOS one is: the seam has two application
# layers, a program links one, and the compiler declines a unit holding both.

include "./ui_appkit.elisa"
include "../../widgets/ui_controls_hierarchy.elisa"

extend UiAppKit:
    public:
        # Realize a laid-out widget tree as native controls. Run UiWidgets::layout
        # first: every control is placed at the box it computed.
        def realize(root: UiWidgets::Widget) -> void:
            can[Ui.Controls]:
                release_native_handles()
                UiControls::reset()
                UiControls::realize(root, UiControls::NO_PARENT, 0)
                UiControls::apply[AppKitControls]()
