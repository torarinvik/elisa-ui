def ui_measure_text_width(text: sview, size: f32) -> f32:
    return 0.0 if text.len == 0
    pointer: cstr = text.data.cast[cstr] can Unsafe.PointerCast
    semibold: i32 = 1 if size >= 19.0 else 0
    return UiAppKitCanvas::text_width(pointer, text.len, size, semibold)
def ui_measure_text_height(text: sview, size: f32) -> f32:
    return UiAppKitCanvas::font_line_height(size)
def ui_font_ascent(size: f32) -> f32:
    return UiAppKitCanvas::font_ascent(size)
def ui_text_line_height(size: f32) -> f32:
    return UiAppKitCanvas::font_line_height(size)

def appkit_canvas_tracking_options() -> usize:
    options: mutable usize = elisa_appkit_canvas_tracking_mouse_moved()
    options <- options | elisa_appkit_canvas_tracking_mouse_entered_exited()
    options <- options | elisa_appkit_canvas_tracking_active_in_key_window()
    options <- options | elisa_appkit_canvas_tracking_in_visible_rect()
    return options

export fn elisa_appkit_canvas_tracking_options() -> usize = appkit_canvas_tracking_options

# Cocoa asks these values through NSView's protocol methods. They describe
# framework policy (coordinate orientation, keyboard focus, and the semantic
# root), so keep the decisions in Elisa and let Objective-C only adapt the
# callbacks to BOOL.
def appkit_canvas_view_is_flipped() -> i32:
    return 1

def appkit_canvas_view_accepts_first_responder() -> i32:
    return 1

def appkit_canvas_view_is_accessibility_element() -> i32:
    return 0

export fn elisa_appkit_canvas_view_is_flipped() -> i32 = appkit_canvas_view_is_flipped
export fn elisa_appkit_canvas_view_accepts_first_responder() -> i32 = appkit_canvas_view_accepts_first_responder
export fn elisa_appkit_canvas_view_is_accessibility_element() -> i32 = appkit_canvas_view_is_accessibility_element

# The native bridge uses this ABI fact to reject malformed child-list lengths
# without duplicating the semantic arena's capacity in Objective-C.
def appkit_canvas_accessibility_capacity() -> usize:
    return UiCore::MAX_ACCESSIBILITY_NODES

export fn elisa_appkit_canvas_accessibility_capacity() -> usize = appkit_canvas_accessibility_capacity

module UiAppKitCanvas:
    public:
        # Darwin's CLOCK_MONOTONIC value. Calling libSystem directly keeps
        # timing policy and unit conversion in Elisa rather than the Cocoa shim.
        const CLOCK_MONOTONIC: i32 = 6
        const SYSTEM_UI_FONT: i32 = 2

        def monotonic_time() -> f64:
            return clock_gettime_nsec_np(CLOCK_MONOTONIC).f64() / 1000000000.0

        def font_ascent(size: f32) -> f32:
            font: usize = CTFontCreateUIFontForLanguage(SYSTEM_UI_FONT, size.f64(), 0)
            return 0.0 if font == 0
            ascent: f32 = CTFontGetAscent(font).f32()
            CFRelease(font)
            return ascent

        def font_line_height(size: f32) -> f32:
            font: usize = CTFontCreateUIFontForLanguage(SYSTEM_UI_FONT, size.f64(), 0)
            return 0.0 if font == 0
            height: f32 = (CTFontGetAscent(font) + CTFontGetDescent(font) + CTFontGetLeading(font)).f32()
            CFRelease(font)
            return height

        const UTF8_ENCODING: u32 = 0x08000100
        const BOLD_TRAIT: u32 = 2
        def not_found() -> usize:
            return elisa_appkit_canvas_not_found()

        # Pointer and accessibility adapters use a compact, backend-neutral
        # vocabulary. Keep these identities in Elisa so Cocoa event methods
        # forward framework tokens instead of embedding button ordinals.
        def pointer_button_primary() -> i32:
            return UiCore::PointerButton.Primary.i32()

        def pointer_button_secondary() -> i32:
            return UiCore::PointerButton.Secondary.i32()

        def accessibility_increment_direction() -> i32:
            return 1

        def accessibility_decrement_direction() -> i32:
            return -1

        # The text protocol wants a caret rectangle in view coordinates. Keep
        # its visual width beside the rest of Elisa's caret geometry instead of
        # embedding a point-size default in the Objective-C adapter.
        def caret_width() -> f32:
            return 1.0

        # Native accessibility elements are opaque callback targets only. Keep
        # the widget action target in Elisa's retained semantic history and
        # resolve a callback's element handle back to that target on demand.
        def accessibility_index_for_handle(handle: usize) -> usize:
            return not_found() if handle == 0
            for index in 0..<accessibility_previous_count:
                return accessibility_previous[index].action if accessibility_previous_handles[index] == handle
            return not_found()

        # Cocoa asks the tooltip owner for a string lazily, after the semantic
        # frame has already been committed. Resolve the element handle back to
        # Elisa's retained state and construct a short-lived native string only
        # when that state still exposes help text for an interactive node.
        def accessibility_tooltip_text(handle: usize) -> usize can Unsafe.PointerCast:
            index: usize = accessibility_index_for_handle(handle)
            return 0 if index == not_found() or index >= accessibility_previous_count
            state: AccessibilityState = accessibility_previous[index]
            return 0 if state.interaction == 0 or state.help.len == 0
            return native_string(state.help)

        # Bitmap dimensions are framework geometry, not a Cocoa default. Keep
        # the conversion from logical points to whole pixels in Elisa so the
        # native snapshot bridge only receives explicit, validated extents.
        def bitmap_extent(value: f32) -> i32:
            safe: f32 = UiCore::nonnegative_extent(value)
            return 1 if safe <= 0.0
            rounded: f32 = ceilf(safe)
            return 1 if rounded < 1.0 else rounded.i32()

        # Render a frame into a CoreGraphics bitmap and optionally encode it
        # through ImageIO. The old NSBitmapImageRep path lived in Objective-C;
        # keeping the complete off-screen lifecycle here means smoke tests use
        # the same retained frame callback as a visible window without ever
        # ordering the window onscreen.
        const SNAPSHOT_BITS_PER_COMPONENT: usize = 8
        const SNAPSHOT_BITMAP_INFO_PREMULTIPLIED_LAST: u32 = 1
        const SNAPSHOT_URL_POSIX_PATH_STYLE: i32 = 0

        def render_headless(window_handle: usize, snapshot: usize, pixels_width: i32, pixels_height: i32) -> i32 can Ui.Draw, Ui.Text, Unsafe.PointerCast:
            return 0 if window_handle == 0 or window_handle != canvas_window
            return 0 if not canvas_initialized or pixels_width <= 0 or pixels_height <= 0
            if snapshot != 0:
                return 0 if CFGetTypeID(snapshot) != CFStringGetTypeID()
            color_space: usize = CGColorSpaceCreateDeviceRGB()
            return 0 if color_space == 0
            context: usize = CGBitmapContextCreate(0, pixels_width.usize(), pixels_height.usize(), SNAPSHOT_BITS_PER_COMPONENT, 0, color_space, SNAPSHOT_BITMAP_INFO_PREMULTIPLIED_LAST)
            CGColorSpaceRelease(color_space)
            return 0 if context == 0

            reset_frame_state()
            # CGBitmapContext uses a bottom-left origin. Mirror the context so
            # the custom painter sees the same top-left coordinates as an
            # AppKit flipped NSView; CoreText's nested transform then remains
            # identical between visible and off-screen frames.
            CGContextSaveGState(context)
            CGContextTranslateCTM(context, 0.0, pixels_height.f64())
            CGContextScaleCTM(context, 1.0, -1.0)
            appkit_canvas_frame_callback(context)
            CGContextRestoreGState(context)
            CGContextFlush(context)
            rendered: bool = frame_was_rendered()
            if not rendered:
                CGContextRelease(context)
                return 0
            return_value: mutable i32 = 1
            if snapshot != 0:
                image: usize = CGBitmapContextCreateImage(context)
                if image == 0:
                    CGContextRelease(context)
                    return 0
                path_url: usize = CFURLCreateWithFileSystemPath(0, snapshot, SNAPSHOT_URL_POSIX_PATH_STYLE, false)
                if path_url == 0:
                    CGImageRelease(image)
                    CGContextRelease(context)
                    return 0
                png_type: sview = "public.png"
                native_png_type: usize = native_string(png_type)
                if native_png_type == 0:
                    CFRelease(path_url)
                    CGImageRelease(image)
                    CGContextRelease(context)
                    return 0
                destination: usize = CGImageDestinationCreateWithURL(path_url, native_png_type, 1, 0)
                if destination == 0:
                    CFRelease(native_png_type)
                    CFRelease(path_url)
                    CGImageRelease(image)
                    CGContextRelease(context)
                    return 0
                CGImageDestinationAddImage(destination, image, 0)
                return_value <- 1 if CGImageDestinationFinalize(destination) else 0
                CFRelease(destination)
                CFRelease(native_png_type)
                CFRelease(path_url)
                CGImageRelease(image)
            CGContextRelease(context)
            return return_value

        # Window titles originate in Elisa as counted UTF-8 views. Construct
        # their native object here so the Objective-C host only assigns the
        # borrowed value to NSWindow and never decodes framework text.
        def native_string(text: sview) -> usize can Unsafe.PointerCast:
            empty: cstr = ""
            pointer: mutable cstr = empty
            pointer <- text.data.cast[cstr] can Unsafe.PointerCast if text.len > 0
            return CFStringCreateWithBytes(0, pointer, text.len.i64(), UTF8_ENCODING, false)

        def native_string_bytes(bytes: u8&, length: usize) -> usize can Unsafe.PointerCast:
            pointer: cstr = (&bytes).cast[cstr] can Unsafe.PointerCast
            return CFStringCreateWithBytes(0, pointer, length.i64(), UTF8_ENCODING, false)

        # Encode a retained native string into a caller-owned UTF-8 buffer.
        # CFStringGetBytes stops at a complete scalar when the fixed buffer is
        # full, preserving the text layer's well-formed-prefix invariant.
        def copy_native_string(value: usize, buffer: mutable u8&, capacity: usize) -> usize:
            return 0 if value == 0 or capacity == 0
            length: i64 = CFStringGetLength(value)
            return 0 if length <= 0
            used: mutable i64 = 0
            _ = CFStringGetBytes(value, NativeRange{location: 0, length: length}, UTF8_ENCODING, 0, false, buffer, capacity.i64(), &used)
            return used.usize() if used > 0 else 0

        # Keyboard callbacks carry Cocoa's borrowed charactersIgnoringModifiers
        # object across the FFI. Keep the native UTF-16 extraction here rather
        # than teaching the Objective-C shim any text policy.
        def native_event_character(value: usize) -> i32:
            return 0 if value == 0
            length: i64 = CFStringGetLength(value)
            return 0 if length != 1
            return CFStringGetCharacterAtIndex(value, 0)

        # CoreText owns the glyph shaping and rasterization path. The only
        # Objective-C work left in the canvas shim is object/protocol plumbing;
        # text runs are UTF-8 bytes and CF references all the way down here.
        def text_font(size: f32, semibold: i32) -> usize:
            regular: usize = CTFontCreateUIFontForLanguage(SYSTEM_UI_FONT, size.f64(), 0)
            return 0 if regular == 0
            return regular if semibold == 0
            emphasized: usize = CTFontCreateCopyWithSymbolicTraits(regular, size.f64(), 0, BOLD_TRAIT, BOLD_TRAIT)
            return regular if emphasized == 0
            CFRelease(regular)
            return emphasized

        def text_attributes(font: usize, color: usize) -> usize:
            keys: usize[2] = [kCTFontAttributeName, kCTForegroundColorAttributeName]
            values: usize[2] = [font, color]
            key_pointer: usize& = (&keys[0]).cast[usize&] can Unsafe.PointerCast
            value_pointer: usize& = (&values[0]).cast[usize&] can Unsafe.PointerCast
            count: i64 = 2 if color != 0 else 1
            return CFDictionaryCreate(0, key_pointer, value_pointer, count, 0, 0)

        def text_line(text: cstr, length: usize, size: f32, semibold: i32, color: usize) -> usize:
            font: usize = text_font(size, semibold)
            return 0 if font == 0
            string: usize = CFStringCreateWithBytes(0, text, length.i64(), UTF8_ENCODING, false)
            if string == 0:
                CFRelease(font)
                return 0
            attributes: usize = text_attributes(font, color)
            if attributes == 0:
                CFRelease(string)
                CFRelease(font)
                return 0
            attributed: usize = CFAttributedStringCreate(0, string, attributes)
            if attributed == 0:
                CFRelease(attributes)
                CFRelease(string)
                CFRelease(font)
                return 0
            line: usize = CTLineCreateWithAttributedString(attributed)
            CFRelease(attributed)
            CFRelease(attributes)
            CFRelease(string)
            CFRelease(font)
            return line if line != 0 else 0

        # Draw and measure each create their own short-lived CF graph. This is
        # intentionally explicit instead of relying on an autorelease pool: the
        # same path is used by the off-screen AppKit smoke renderer.
        def text_width(text: cstr, length: usize, size: f32, semibold: i32) -> f32:
            return 0.0 if length == 0
            line: usize = text_line(text, length, size, semibold, 0)
            return 0.0 if line == 0
            ascent: mutable f64 = 0.0
            descent: mutable f64 = 0.0
            leading: mutable f64 = 0.0
            width: f32 = CTLineGetTypographicBounds(line, &ascent, &descent, &leading).f32()
            CFRelease(line)
            return width

        def draw_text_line(text: cstr, length: usize, size: f32, semibold: i32, x: f32, y: f32, color: UiCore::Color) -> void:
            return if length == 0
            color_ref: usize = CGColorCreateGenericRGB(color_component(color.r).f64(), color_component(color.g).f64(), color_component(color.b).f64(), color_component(color.a).f64())
            return if color_ref == 0
            line: usize = text_line(text, length, size, semibold, color_ref)
            if line != 0:
                context: usize = current_context()
                CGContextSaveGState(context)
                # AppKit's flipped view supplies a y-down CTM while CoreText
                # lays glyphs out in y-up coordinates. Reflect the drawing
                # space around the view's bottom edge, then mirror the
                # baseline so the rest of Elisa can stay y-down.
                view_height: f64 = UiCore::viewport_height().f64()
                CGContextTranslateCTM(context, 0.0, view_height)
                CGContextScaleCTM(context, 1.0, -1.0)
                CGContextSetTextPosition(context, x.f64(), view_height - y.f64())
                CTLineDraw(line, context)
                CGContextRestoreGState(context)
                CFRelease(line)
            CGColorRelease(color_ref)

        struct WindowOptions:
            width: f32
            height: f32
            min_width: f32
            min_height: f32
            titled: bool
            closable: bool
            minimizable: bool
            resizable: bool
            tabbing: bool
            restorable: bool
            centered: bool
            activate: bool
            focus: bool

        struct AccessibilityState:
            role: mutable i32
            action: mutable usize
            interaction: mutable i32
            value_kind: mutable i32
            cursor: mutable i32
            enabled: mutable bool
            focused: mutable bool
            selected: mutable bool
            value: mutable f32
            text_revision: mutable usize
            selection_location: mutable usize
            selection_length: mutable usize
            label: mutable sview
            help: mutable sview
            x: mutable f32
            y: mutable f32
            width: mutable f32
            height: mutable f32

    private:
        const enum MenuAction of i32:
            About = 1
            Hide = 2
            HideOthers = 3
            ShowAll = 4
            Quit = 5
            Undo = 6
            Redo = 7
            Cut = 8
            Copy = 9
            Paste = 10
            SelectAll = 11
            Minimize = 12
            Zoom = 13
            BringAllToFront = 14

        def menu_action_name(action: MenuAction) -> cstr:
            return "orderFrontStandardAboutPanel:" if action == MenuAction.About
            return "hide:" if action == MenuAction.Hide
            return "hideOtherApplications:" if action == MenuAction.HideOthers
            return "unhideAllApplications:" if action == MenuAction.ShowAll
            return "terminate:" if action == MenuAction.Quit
            return "undo:" if action == MenuAction.Undo
            return "redo:" if action == MenuAction.Redo
            return "cut:" if action == MenuAction.Cut
            return "copy:" if action == MenuAction.Copy
            return "paste:" if action == MenuAction.Paste
            return "selectAll:" if action == MenuAction.SelectAll
            return "performMiniaturize:" if action == MenuAction.Minimize
            return "performZoom:" if action == MenuAction.Zoom
            return "arrangeInFront:" if action == MenuAction.BringAllToFront
            return ""

        # Register Cocoa selectors through the runtime C ABI from Elisa. The
        # native shim receives only the opaque SEL token and never owns the
        # framework's action-name mapping or registration branch.
        def menu_action_selector(action: cstr) -> usize:
            return 0 if action == ""
            return sel_registerName(action)

        const enum MenuModifiers of i32:
            None = 0
            Command = 1
            CommandShift = 3
            CommandOption = 5

        def menu_modifiers(modifiers: MenuModifiers) -> usize:
            return 0 if modifiers == MenuModifiers.None
            command: usize = elisa_appkit_canvas_modifier_command()
            return command if modifiers == MenuModifiers.Command
            shift: usize = elisa_appkit_canvas_modifier_shift()
            return command | shift if modifiers == MenuModifiers.CommandShift
            return command | elisa_appkit_canvas_modifier_option()

        global mutable accessibility_previous_ids: usize[UiCore::MAX_ACCESSIBILITY_NODES] = zeroed
        global mutable accessibility_previous: AccessibilityState[UiCore::MAX_ACCESSIBILITY_NODES] = zeroed
        global mutable accessibility_previous_handles: usize[UiCore::MAX_ACCESSIBILITY_NODES] = zeroed
        global mutable accessibility_next_ids: usize[UiCore::MAX_ACCESSIBILITY_NODES] = zeroed
        global mutable accessibility_next_handles: usize[UiCore::MAX_ACCESSIBILITY_NODES] = zeroed
        global mutable accessibility_next: AccessibilityState[UiCore::MAX_ACCESSIBILITY_NODES] = zeroed
        global mutable accessibility_previous_count: usize = 0
        global mutable accessibility_force_layout: bool = true
        global mutable headless_session: bool = false
        global mutable redraw_timer: usize = 0
        global mutable canvas_initialized: bool = false
        global mutable frame_rendered: bool = false
        global mutable frame_context: usize = 0
        # The retained root window handle lives in Elisa for exactly one run.
        # Objective-C keeps only a weak lookup for callbacks and operations.
        global mutable canvas_window: usize = 0
        # AppKit's delegate property is non-owning. Keep its one transferred
        # retain in Elisa alongside the window so close/focus callbacks remain
        # valid until the run has fully returned.
        global mutable canvas_delegate: usize = 0
        const MENU_APPLICATION_LABEL_CAPACITY: usize = 4096
        global mutable menu_application_label_storage: u8[MENU_APPLICATION_LABEL_CAPACITY] = zeroed
        const ACCESSIBILITY_IDENTIFIER_CAPACITY: usize = 32
        global mutable accessibility_identifier_storage: u8[ACCESSIBILITY_IDENTIFIER_CAPACITY] = zeroed
        const ACCESSIBILITY_RANGE_MINIMUM: f32 = 0.0
        const ACCESSIBILITY_RANGE_MAXIMUM: f32 = 1.0

        def previous_accessibility_index(id: usize) -> usize:
            for index in 0..<accessibility_previous_count:
                return index if accessibility_previous_ids[index] == id
            return UiCore::MAX_ACCESSIBILITY_NODES

        def release_accessibility_handles() -> void:
            for index in 0..<accessibility_previous_count:
                handle: usize = accessibility_previous_handles[index]
                elisa_appkit_canvas_accessibility_release(handle) if handle != 0
                accessibility_previous_handles[index] <- 0
            accessibility_previous_count <- 0

        def reset_accessibility_history() -> void:
            release_accessibility_handles()
            accessibility_force_layout <- true

        def color_component(value: u8) -> f32:
            return value.f32() / 255.0

        def set_fill_color(context: usize, color: UiCore::Color) -> void:
            CGContextSetRGBFillColor(context, color_component(color.r).f64(), color_component(color.g).f64(), color_component(color.b).f64(), color_component(color.a).f64())

        def set_stroke_color(context: usize, color: UiCore::Color) -> void:
            CGContextSetRGBStrokeColor(context, color_component(color.r).f64(), color_component(color.g).f64(), color_component(color.b).f64(), color_component(color.a).f64())

        def set_shadow(context: usize, x: f32, y: f32, blur: f32, alpha: f32) -> void:
            color: usize = CGColorCreateGenericGray(0.0, alpha.f64())
            return if color == 0
            CGContextSetShadowWithColor(context, NativeSize{width: x.f64(), height: y.f64()}, blur.f64(), color)
            CGColorRelease(color)

        def current_context() -> usize:
            return frame_context

        def rounded_path(context: usize, box: UiCore::Rect, radius: f32) -> void:
            left: f64 = box.origin.x.f64()
            top: f64 = box.origin.y.f64()
            right: f64 = (box.origin.x + box.size.width).f64()
            bottom: f64 = (box.origin.y + box.size.height).f64()
            curve: f64 = radius.f64()
            CGContextBeginPath(context)
            CGContextMoveToPoint(context, left + curve, top)
            CGContextAddLineToPoint(context, right - curve, top)
            CGContextAddArcToPoint(context, right, top, right, top + curve, curve)
            CGContextAddLineToPoint(context, right, bottom - curve)
            CGContextAddArcToPoint(context, right, bottom, right - curve, bottom, curve)
            CGContextAddLineToPoint(context, left + curve, bottom)
            CGContextAddArcToPoint(context, left, bottom, left, bottom - curve, curve)
            CGContextAddLineToPoint(context, left, top + curve)
            CGContextAddArcToPoint(context, left, top, left + curve, top, curve)
            CGContextClosePath(context)

        def window_style(options: WindowOptions) -> i32:
            style: mutable i32 = 0
            style <- style | elisa_appkit_canvas_window_style_titled() if options.titled
            style <- style | elisa_appkit_canvas_window_style_closable() if options.closable
            style <- style | elisa_appkit_canvas_window_style_miniaturizable() if options.minimizable
            style <- style | elisa_appkit_canvas_window_style_resizable() if options.resizable
            return style

        def activation_policy(headless: bool) -> i32:
            return elisa_appkit_canvas_activation_policy_prohibited() if headless else elisa_appkit_canvas_activation_policy_regular()

        def tabbing_mode(enabled: bool) -> i32:
            return elisa_appkit_canvas_tabbing_mode_preferred() if enabled else elisa_appkit_canvas_tabbing_mode_disallowed()

        def smoke_mode() -> bool:
            value_opt: cstr? = getenv("ELISA_UI_SMOKE_FRAMES")
            if value_opt is value:
                return strcmp(value, "0") != 0
            return false

        def menu_key(key: UiCore::Key) -> i32:
            # Cocoa menu equivalents use lowercase scalar values; UiCore's
            # named alphabet keys intentionally use GLFW's uppercase values.
            return key.i32() + 32

        # Standard application-menu labels are framework policy. Compose the
        # UTF-8 bytes in Elisa so the native bridge only receives a complete,
        # counted menu title. Labels are bounded to keep this allocation-free;
        # normal application names are far below this limit.
        def application_menu_label(prefix: cstr, prefix_length: usize, application: cstr, application_length: usize) -> sview:
            prefix_view: sview = sview(prefix, 0, prefix_length.i64())
            application_view: sview = sview(application, 0, application_length.i64())
            prefix_take: usize = prefix_length if prefix_length < MENU_APPLICATION_LABEL_CAPACITY else MENU_APPLICATION_LABEL_CAPACITY
            remaining: usize = MENU_APPLICATION_LABEL_CAPACITY - prefix_take
            application_take: usize = application_length if application_length < remaining else remaining
            for index in 0..<prefix_take:
                menu_application_label_storage[index] <- prefix_view.data[index]
            for index in 0..<application_take:
                menu_application_label_storage[prefix_take + index] <- application_view.data[index]
            return sview(&menu_application_label_storage[0], 0, (prefix_take + application_take).i64())

        def add_menu(menu_bar: usize, title: sview) -> usize can Unsafe.PointerCast:
            native_title: usize = native_string(title)
            return 0 if native_title == 0
            empty: sview = sview("", 0, 0)
            native_empty: usize = native_string(empty)
            if native_empty == 0:
                CFRelease(native_title)
                return 0
            menu: usize = elisa_appkit_canvas_menu_add(menu_bar, native_title, native_empty)
            CFRelease(native_empty)
            CFRelease(native_title)
            return menu

        def add_menu_item(menu: usize, title: sview, action: cstr, key: i32, modifiers: usize) -> void can Unsafe.PointerCast:
            native_title: usize = native_string(title)
            return if native_title == 0
            empty: sview = sview("", 0, 0)
            native_key: mutable usize = native_string(empty)
            if native_key == 0:
                CFRelease(native_title)
                return
            if key > 0 and key <= 255:
                key_byte: mutable u8[1] = zeroed
                key_byte[0] <- key.u8()
                CFRelease(native_key)
                native_key <- native_string_bytes(&key_byte[0], 1)
                if native_key == 0:
                    CFRelease(native_title)
                    return
            elisa_appkit_canvas_menu_add_item(menu, native_title, native_key, menu_action_selector(action), modifiers)
            CFRelease(native_key) if native_key != 0
            CFRelease(native_title)

        def add_application_menu_item(menu: usize, prefix: cstr, prefix_length: usize,
                                      application: cstr, application_length: usize,
                                      action: cstr, key: i32, modifiers: usize) -> void can Unsafe.PointerCast:
            label: sview = application_menu_label(prefix, prefix_length, application, application_length)
            add_menu_item(menu, label, action, key, modifiers)

        # Accessibility identifiers are stable framework metadata. Generate
        # their UTF-8 bytes here so the Objective-C bridge never invents a
        # naming scheme or formats framework state on its own.
        def accessibility_identifier(id: usize) -> sview:
            prefix: sview = "elisa-ui-"
            for index in 0..<prefix.len.usize():
                accessibility_identifier_storage[index] <- prefix.data[index]
            value: mutable usize = id
            digits: mutable usize = 1
            if value > 0:
                digits <- 0
                while value > 0:
                    digits <- digits + 1
                    value <- value / 10
            value <- id
            for index in 0..<digits:
                position: usize = prefix.len.usize() + digits - 1 - index
                accessibility_identifier_storage[position] <- (value % 10 + 48).u8()
                value <- value / 10
            return sview(&accessibility_identifier_storage[0], 0, (prefix.len.usize() + digits).i64())

        # Menu layout, labels, shortcuts and modifier policy belong to Elisa.
        # Objective-C maps these action tokens to Cocoa selectors and creates
        # the required NSMenu objects.
        def install_standard_menus(title: cstr, length: usize) -> void can Unsafe.PointerCast:
            menu_bar: usize = elisa_appkit_canvas_menus_begin()
            application_title: sview = sview(title, 0, length.i64())
            application: usize = add_menu(menu_bar, application_title)
            add_application_menu_item(application, "About ", 6, title, length, menu_action_name(MenuAction.About), 0, menu_modifiers(MenuModifiers.None))
            elisa_appkit_canvas_menu_add_separator(application)
            add_application_menu_item(application, "Hide ", 5, title, length, menu_action_name(MenuAction.Hide), menu_key(UiCore::Key.H), menu_modifiers(MenuModifiers.Command))
            add_menu_item(application, "Hide Others", menu_action_name(MenuAction.HideOthers), menu_key(UiCore::Key.H), menu_modifiers(MenuModifiers.CommandOption))
            add_menu_item(application, "Show All", menu_action_name(MenuAction.ShowAll), 0, menu_modifiers(MenuModifiers.None))
            elisa_appkit_canvas_menu_add_separator(application)
            add_application_menu_item(application, "Quit ", 5, title, length, menu_action_name(MenuAction.Quit), menu_key(UiCore::Key.Q), menu_modifiers(MenuModifiers.Command))

            edit: usize = add_menu(menu_bar, "Edit")
            add_menu_item(edit, "Undo", menu_action_name(MenuAction.Undo), menu_key(UiCore::Key.Z), menu_modifiers(MenuModifiers.Command))
            add_menu_item(edit, "Redo", menu_action_name(MenuAction.Redo), menu_key(UiCore::Key.Z), menu_modifiers(MenuModifiers.CommandShift))
            elisa_appkit_canvas_menu_add_separator(edit)
            add_menu_item(edit, "Cut", menu_action_name(MenuAction.Cut), menu_key(UiCore::Key.X), menu_modifiers(MenuModifiers.Command))
            add_menu_item(edit, "Copy", menu_action_name(MenuAction.Copy), menu_key(UiCore::Key.C), menu_modifiers(MenuModifiers.Command))
            add_menu_item(edit, "Paste", menu_action_name(MenuAction.Paste), menu_key(UiCore::Key.V), menu_modifiers(MenuModifiers.Command))
            elisa_appkit_canvas_menu_add_separator(edit)
            add_menu_item(edit, "Select All", menu_action_name(MenuAction.SelectAll), menu_key(UiCore::Key.A), menu_modifiers(MenuModifiers.Command))

            window: usize = add_menu(menu_bar, "Window")
            elisa_appkit_canvas_menu_set_windows(window)
            add_menu_item(window, "Minimize", menu_action_name(MenuAction.Minimize), menu_key(UiCore::Key.M), menu_modifiers(MenuModifiers.Command))
            add_menu_item(window, "Zoom", menu_action_name(MenuAction.Zoom), 0, menu_modifiers(MenuModifiers.None))
            elisa_appkit_canvas_menu_add_separator(window)
            add_menu_item(window, "Bring All to Front", menu_action_name(MenuAction.BringAllToFront), 0, menu_modifiers(MenuModifiers.None))
            elisa_appkit_canvas_menus_commit(menu_bar)

    public:
        # Elisa resolves interaction, role identity and value policy before the
        # native bridge. These compact ABI tokens keep action, value and cursor
        # policy in Elisa; only the Cocoa object assignment remains native.
        def accessibility_interaction(role: UiCore::AccessibilityRole, enabled: bool) -> i32:
            return 0 if not enabled
            return 1 if role == UiCore::AccessibilityRole.Button or role == UiCore::AccessibilityRole.RadioButton or role == UiCore::AccessibilityRole.CheckBox
            return 2 if role == UiCore::AccessibilityRole.Slider
            return 3 if role == UiCore::AccessibilityRole.TextField or role == UiCore::AccessibilityRole.PasswordField
            return 0

        def accessibility_value_kind(role: UiCore::AccessibilityRole) -> i32:
            return 1 if role == UiCore::AccessibilityRole.RadioButton or role == UiCore::AccessibilityRole.CheckBox
            return 2 if role == UiCore::AccessibilityRole.Slider or role == UiCore::AccessibilityRole.ProgressBar
            return 3 if role == UiCore::AccessibilityRole.TextField or role == UiCore::AccessibilityRole.PasswordField
            return 0

        def accessibility_cursor(role: UiCore::AccessibilityRole, enabled: bool) -> i32:
            return 0 if not enabled
            return 1 if accessibility_interaction(role, enabled) == 1
            return 2 if role == UiCore::AccessibilityRole.TextField or role == UiCore::AccessibilityRole.PasswordField
            return 0

        # Cursor identity is selected from the framework-neutral token here.
        # The bridge receives an opaque NSCursor pointer and only installs it;
        # it no longer repeats this token policy in Objective-C.
        def native_cursor(cursor: i32) -> usize:
            return elisa_appkit_canvas_pointing_hand_cursor() if cursor == 1
            return elisa_appkit_canvas_ibeam_cursor() if cursor == 2
            return elisa_appkit_canvas_arrow_cursor()

        # NSView cursor rectangles are rebuilt by Cocoa on demand. Keep the
        # semantic traversal and cursor policy in Elisa, then hand each native
        # frame/cursor pair to one narrow insertion primitive. This also means
        # cursor regions stay in lockstep with the same retained nodes used for
        # accessibility and hit testing.
        def rebuild_cursor_rects() -> void:
            return if canvas_window == 0
            for index in 0..<UiCore::accessibility_count():
                node: UiCore::AccessibilityNode = UiCore::accessibility_at(index)
                cursor: usize = native_cursor(accessibility_cursor(node.role, node.enabled))
                elisa_appkit_canvas_add_cursor_rect(canvas_window,
                    node.frame.origin.x, node.frame.origin.y,
                    node.frame.size.width, node.frame.size.height, cursor)

        def accessibility_notify(handle: usize, notifications: i32) -> void:
            NSAccessibilityPostNotification(handle, NSAccessibilityValueChangedNotification) if notifications & 1 != 0
            NSAccessibilityPostNotification(handle, NSAccessibilityFocusedUIElementChangedNotification) if notifications & 2 != 0
            NSAccessibilityPostNotification(handle, NSAccessibilitySelectedTextChangedNotification) if notifications & 4 != 0

        # Cocoa role identity is an exported NSString constant. Resolve it in
        # Elisa from the framework-neutral semantic role, then pass the native
        # pointer through FFI; Objective-C no longer owns this policy switch.
        def accessibility_native_role(role: UiCore::AccessibilityRole) -> usize:
            return NSAccessibilityButtonRole if role == UiCore::AccessibilityRole.Button
            return NSAccessibilityRadioButtonRole if role == UiCore::AccessibilityRole.RadioButton
            return NSAccessibilityCheckBoxRole if role == UiCore::AccessibilityRole.CheckBox
            return NSAccessibilitySliderRole if role == UiCore::AccessibilityRole.Slider
            return NSAccessibilityProgressIndicatorRole if role == UiCore::AccessibilityRole.ProgressBar
            return NSAccessibilityTextFieldRole if role == UiCore::AccessibilityRole.TextField or role == UiCore::AccessibilityRole.PasswordField
            return NSAccessibilityStaticTextRole

        def accessibility_native_subrole(role: UiCore::AccessibilityRole) -> usize:
            return NSAccessibilitySecureTextFieldSubrole if role == UiCore::AccessibilityRole.PasswordField
            return 0

        # Notification bits: 1 value, 2 focus, 4 text selection. Structural
        # layout invalidation is computed separately for the view as a whole.
        # Keeping this diff in Elisa avoids teaching the native object bridge
        # how framework roles and values evolve between frames.
        def accessibility_notifications(existed: bool, before: AccessibilityState, after: AccessibilityState) -> i32:
            return 0 if not existed
            notifications: mutable i32 = 0
            if before.value_kind == after.value_kind:
                notifications <- notifications + 1 if after.value_kind == 1 and before.selected != after.selected
                notifications <- notifications + 1 if after.value_kind == 2 and before.value != after.value
                notifications <- notifications + 1 if after.value_kind == 3 and before.text_revision != after.text_revision
            notifications <- notifications + 2 if after.focused and not before.focused
            notifications <- notifications + 4 if after.value_kind == 3 and (before.selection_location != after.selection_location or before.selection_length != after.selection_length)
            return notifications

        def accessibility_layout_changed(existed: bool, before: AccessibilityState, after: AccessibilityState) -> bool:
            return true if not existed
            return true if before.role != after.role or before.action != after.action
            return true if before.interaction != after.interaction or before.value_kind != after.value_kind or before.cursor != after.cursor
            return true if before.enabled != after.enabled or before.label != after.label or before.help != after.help
            return true if before.x != after.x or before.y != after.y or before.width != after.width or before.height != after.height
            return false

        # Tooltips are transient native view state. Rebuild them only after
        # Elisa's semantic diff says the accessibility layout changed; stable
        # frames can keep their existing Cocoa registrations instead of paying
        # a remove-all/add-all cost on every paint.
        def rebuild_accessibility_tooltips(count: usize) -> void:
            return if canvas_window == 0
            elisa_appkit_canvas_accessibility_reset(canvas_window)
            for index in 0..<count:
                state: AccessibilityState = accessibility_previous[index]
                handle: usize = accessibility_previous_handles[index]
                if handle != 0 and state.help.len > 0 and state.interaction != 0:
                    elisa_appkit_canvas_accessibility_add_tooltip(canvas_window, handle,
                        state.x, state.y, state.width, state.height)

        # Window movement/backing changes alter screen-relative accessibility
        # frames without changing local widget geometry. Native code reports
        # only that environmental fact; Elisa owns the invalidation decision.
        def accessibility_environment_changed() -> void:
            accessibility_force_layout <- true

        def schedule_next_frame(delay: f32) -> void:
            cancel_redraw()
            return if headless_session
            if delay <= 0.0:
                return
            redraw_timer <- elisa_appkit_canvas_schedule_redraw(delay, elisa_appkit_canvas_run_loop_common_modes(), canvas_window)

        def cancel_redraw() -> void:
            return if redraw_timer == 0
            elisa_appkit_canvas_cancel_redraw(redraw_timer)
            redraw_timer <- 0

        def begin_native_frame(context: usize) -> void:
            frame_context <- context
            frame_rendered <- true

        def reset_frame_state() -> void:
            frame_rendered <- false

        def frame_was_rendered() -> bool:
            return frame_rendered

        def end_native_frame() -> void:
            frame_context <- 0

        def release_canvas_window() -> void:
            return if canvas_window == 0
            elisa_appkit_canvas_release_window(canvas_window)
            canvas_window <- 0

        def release_canvas_delegate() -> void:
            return if canvas_delegate == 0
            elisa_appkit_canvas_release_delegate(canvas_delegate)
            canvas_delegate <- 0

        def release_canvas() -> void:
            release_canvas_delegate()
            release_accessibility_handles()
            release_canvas_window()

        # AppKit reports hardware key codes plus a UTF-16 character. Translate
        # that platform vocabulary here so the Objective-C host only forwards
        # event facts across the FFI boundary.
        def key_from_appkit(key_code: i32, character: i32) -> i32:
            return character - 32 if character >= 97 and character <= 122
            return character if character >= 32 and character <= 126
            return UiCore::Key.Enter.i32() if key_code == 36
            return UiCore::Key.Tab.i32() if key_code == 48
            return UiCore::Key.Backspace.i32() if key_code == 51
            return UiCore::Key.Escape.i32() if key_code == 53
            return UiCore::Key.LeftShift.i32() if key_code == 56
            return UiCore::Key.RightShift.i32() if key_code == 60
            return UiCore::Key.LeftControl.i32() if key_code == 59
            return UiCore::Key.RightControl.i32() if key_code == 62
            return UiCore::Key.LeftAlt.i32() if key_code == 58
            return UiCore::Key.RightAlt.i32() if key_code == 61
            return UiCore::Key.LeftSuper.i32() if key_code == 55
            return UiCore::Key.RightSuper.i32() if key_code == 54
            return UiCore::Key.Delete.i32() if key_code == 117
            return UiCore::Key.Right.i32() if key_code == 124
            return UiCore::Key.Left.i32() if key_code == 123
            return UiCore::Key.Down.i32() if key_code == 125
            return UiCore::Key.Up.i32() if key_code == 126
            return UiCore::Key.PageUp.i32() if key_code == 116
            return UiCore::Key.PageDown.i32() if key_code == 121
            return UiCore::Key.Home.i32() if key_code == 115
            return UiCore::Key.End.i32() if key_code == 119
            return UiCore::Key.F1.i32() if key_code == 122
            return UiCore::Key.F2.i32() if key_code == 120
            return UiCore::Key.F3.i32() if key_code == 99
            return UiCore::Key.F4.i32() if key_code == 118
            return UiCore::Key.F5.i32() if key_code == 96
            return UiCore::Key.F6.i32() if key_code == 97
            return UiCore::Key.F7.i32() if key_code == 98
            return UiCore::Key.F8.i32() if key_code == 100
            return UiCore::Key.F9.i32() if key_code == 101
            return UiCore::Key.F10.i32() if key_code == 109
            return UiCore::Key.F11.i32() if key_code == 103
            return UiCore::Key.F12.i32() if key_code == 111
            return 0

        # Result is an FFI action token: 1 Select All, 2 Copy, 3 Cut, 4 Paste,
        # 5 Undo, 6 Redo. Cocoa performs the native pasteboard/menu operation;
        # Elisa owns which key chord requests it.
        def shortcut_from_appkit(character: i32, shift: bool) -> i32:
            normalized: i32 = character + 32 if character >= 65 and character <= 90 else character
            return 1 if normalized == 97
            return 2 if normalized == 99
            return 3 if normalized == 120
            return 4 if normalized == 118
            return 6 if normalized == 122 and shift
            return 5 if normalized == 122
            return 0

        # Key-down routing is framework policy too. The Cocoa view supplies
        # modifier facts and performs the returned native operation, but does
        # not decide which chords edit text or enter the text-input system.
        # Result tokens: 0 raw key, 1 NSTextInput, 2..7 editing action 1..6.
        def key_down_route(accepts_text: bool, character: i32, shift: bool, control: bool, alt: bool, super_key: bool) -> i32:
            return 0 if not accepts_text
            if super_key:
                action: i32 = shortcut_from_appkit(character, shift)
                return action + 1 if action != 0
                return 0
            return 0 if control
            # Option-modified input still belongs to AppKit's text system: it
            # is how many accented and alternate characters are composed.
            return 1

        # Cocoa selector identity is irreducibly native; its editor meaning is
        # not. Elisa resolves the opaque selector handle through sel_getName,
        # then translates the runtime spelling into the backend-neutral UiFlat
        # command vocabulary and selection policy.
        def text_selector_command(selector: i32) -> i32:
            return 1 if selector == 1 or selector == 3
            return 2 if selector == 2 or selector == 4
            return 3 if selector == 5 or selector == 7
            return 4 if selector == 6 or selector == 8
            return selector - 4 if selector >= 9 and selector <= 15
            return 10 if selector == 16
            return 11 if selector == 17
            return 12 if selector == 18
            return 13 if selector == 19
            return 0

        def text_selector_modifies_selection(selector: i32) -> bool:
            return selector == 3 or selector == 4 or selector == 7 or selector == 8 or selector == 16 or selector == 17

        # Selector names are decoded from Cocoa's opaque SEL handles through the
        # runtime C ABI before these comparisons; Elisa owns their meaning.
        def text_selector_token(selector: cstr) -> i32:
            return 1 if strcmp(selector, "moveLeft:") == 0
            return 2 if strcmp(selector, "moveRight:") == 0
            return 3 if strcmp(selector, "moveLeftAndModifySelection:") == 0
            return 4 if strcmp(selector, "moveRightAndModifySelection:") == 0
            return 5 if strcmp(selector, "moveToBeginningOfLine:") == 0
            return 6 if strcmp(selector, "moveToEndOfLine:") == 0
            return 7 if strcmp(selector, "moveToBeginningOfLineAndModifySelection:") == 0
            return 8 if strcmp(selector, "moveToEndOfLineAndModifySelection:") == 0
            return 9 if strcmp(selector, "deleteBackward:") == 0
            return 10 if strcmp(selector, "deleteForward:") == 0
            return 11 if strcmp(selector, "insertNewline:") == 0
            return 12 if strcmp(selector, "insertTab:") == 0
            return 13 if strcmp(selector, "insertBacktab:") == 0
            return 14 if strcmp(selector, "moveWordLeft:") == 0
            return 15 if strcmp(selector, "moveWordRight:") == 0
            return 16 if strcmp(selector, "moveWordLeftAndModifySelection:") == 0
            return 17 if strcmp(selector, "moveWordRightAndModifySelection:") == 0
            return 18 if strcmp(selector, "deleteWordBackward:") == 0
            return 19 if strcmp(selector, "deleteWordForward:") == 0
            return 0

        def text_action_for_selector(selector: cstr) -> i32:
            return 1 if strcmp(selector, "selectAll:") == 0
            return 2 if strcmp(selector, "copy:") == 0
            return 3 if strcmp(selector, "cut:") == 0
            return 4 if strcmp(selector, "paste:") == 0
            return 5 if strcmp(selector, "undo:") == 0
            return 6 if strcmp(selector, "redo:") == 0
            return 0

        def native_modifier_flags(flags: usize) -> usize:
            return flags & elisa_appkit_canvas_modifier_device_independent_mask()

        def native_shift(flags: usize) -> bool:
            return (native_modifier_flags(flags) & elisa_appkit_canvas_modifier_shift()) != 0

        def native_control(flags: usize) -> bool:
            return (native_modifier_flags(flags) & elisa_appkit_canvas_modifier_control()) != 0

        def native_option(flags: usize) -> bool:
            return (native_modifier_flags(flags) & elisa_appkit_canvas_modifier_option()) != 0

        def native_command(flags: usize) -> bool:
            return (native_modifier_flags(flags) & elisa_appkit_canvas_modifier_command()) != 0

        # Called by the exported frame callback after the app has rebuilt the
        # semantic nodes for this frame.
        def sync_accessibility() -> void can Unsafe.PointerCast:
            next_count: usize = UiCore::accessibility_count()
            previous_count: usize = accessibility_previous_count
            layout_changed: mutable bool = accessibility_force_layout or next_count != accessibility_previous_count
            for index in 0..<UiCore::accessibility_count():
                node: UiCore::AccessibilityNode = UiCore::accessibility_at(index)
                identifier: sview = accessibility_identifier(node.id)
                native_identifier: usize = native_string(identifier)
                native_label: usize = native_string(node.label)
                native_help: mutable usize = 0
                native_help <- native_string(node.help) if node.help.len > 0
                enabled: i32 = 1 if node.enabled else 0
                focused: i32 = 1 if node.focused else 0
                selected: i32 = 1 if node.selected else 0
                interaction: i32 = accessibility_interaction(node.role, node.enabled)
                value_kind: i32 = accessibility_value_kind(node.role)
                cursor: i32 = accessibility_cursor(node.role, node.enabled)
                native_role: usize = accessibility_native_role(node.role)
                native_subrole: usize = accessibility_native_subrole(node.role)
                state: AccessibilityState = AccessibilityState{
                    role: node.role.i32(), action: node.action, interaction, value_kind, cursor,
                    enabled: node.enabled, focused: node.focused, selected: node.selected,
                    value: node.value, text_revision: node.revision,
                    selection_location: node.selection_location, selection_length: node.selection_length,
                    label: node.label, help: node.help,
                    x: node.frame.origin.x, y: node.frame.origin.y,
                    width: node.frame.size.width, height: node.frame.size.height,
                }
                previous_index: usize = previous_accessibility_index(node.id)
                existed: bool = previous_index < accessibility_previous_count
                previous_handle: usize = accessibility_previous_handles[previous_index] if existed else 0
                before: AccessibilityState = accessibility_previous[previous_index] if existed else state
                notifications: i32 = accessibility_notifications(existed, before, state)
                layout_changed <- true if accessibility_layout_changed(existed, before, state)
                layout_changed <- true if index >= accessibility_previous_count or accessibility_previous_ids[index] != node.id
                accessibility_next_ids[index] <- node.id
                accessibility_next[index] <- state
                handle: usize = elisa_appkit_canvas_accessibility_add(canvas_window, previous_handle, native_identifier, native_role, native_subrole, native_label, native_help, node.frame.origin.x, node.frame.origin.y, node.frame.size.width, node.frame.size.height, enabled, focused)
                accessibility_next_handles[index] <- handle
                if value_kind == 1 and handle != 0:
                    elisa_appkit_canvas_accessibility_set_boolean(handle, selected)
                if value_kind == 2 and handle != 0:
                    elisa_appkit_canvas_accessibility_set_range(handle, node.value, ACCESSIBILITY_RANGE_MINIMUM, ACCESSIBILITY_RANGE_MAXIMUM)
                if value_kind == 3 and handle != 0:
                    # Always pass counted strings, including empty values. The
                    # native bridge only assigns these objects and never
                    # manufactures an Objective-C empty-string fallback.
                    native_value: usize = native_string(node.text_value)
                    native_selected: usize = native_string(node.selected_text)
                    elisa_appkit_canvas_accessibility_set_text(handle, native_value, native_selected, node.selection_location, node.selection_length)
                    CFRelease(native_value) if native_value != 0
                    CFRelease(native_selected) if native_selected != 0
                accessibility_notify(handle, notifications) if handle != 0
                CFRelease(native_identifier) if native_identifier != 0
                CFRelease(native_label) if native_label != 0
                CFRelease(native_help) if native_help != 0
            # Drop Elisa's ownership for semantic nodes that disappeared. The
            # committed AppKit array has already switched to the new list, so
            # releasing these handles cannot invalidate a current child.
            for previous_index in 0..<previous_count:
                previous_id: usize = accessibility_previous_ids[previous_index]
                retained: mutable bool = false
                for next_index in 0..<next_count:
                    retained <- true if accessibility_next_ids[next_index] == previous_id
                if not retained:
                    stale_handle: usize = accessibility_previous_handles[previous_index]
                    elisa_appkit_canvas_accessibility_release(stale_handle) if stale_handle != 0
            accessibility_previous_count <- next_count
            for index in 0..<accessibility_previous_count:
                accessibility_previous_ids[index] <- accessibility_next_ids[index]
                accessibility_previous_handles[index] <- accessibility_next_handles[index]
                accessibility_previous[index] <- accessibility_next[index]
            elisa_appkit_canvas_accessibility_commit(canvas_window, &accessibility_next_handles[0], accessibility_previous_count)
            if layout_changed:
                rebuild_accessibility_tooltips(next_count)
                elisa_appkit_canvas_accessibility_invalidate_cursor_rects(canvas_window)
                root_view: usize = elisa_appkit_canvas_accessibility_root(canvas_window)
                NSAccessibilityPostNotification(root_view, elisa_appkit_canvas_accessibility_layout_changed_notification()) if root_view != 0
            accessibility_force_layout <- false

        struct AppKitPainter:
            unused: i32

        impl Painter for AppKitPainter:
            def push_clip(box: UiCore::Rect) -> void can[Ui.Draw]:
                context: usize = current_context()
                CGContextSaveGState(context)
                CGContextBeginPath(context)
                CGContextMoveToPoint(context, box.origin.x.f64(), box.origin.y.f64())
                CGContextAddLineToPoint(context, (box.origin.x + box.size.width).f64(), box.origin.y.f64())
                CGContextAddLineToPoint(context, (box.origin.x + box.size.width).f64(), (box.origin.y + box.size.height).f64())
                CGContextAddLineToPoint(context, box.origin.x.f64(), (box.origin.y + box.size.height).f64())
                CGContextClosePath(context)
                CGContextClip(context)
            def pop_clip() -> void can[Ui.Draw]:
                CGContextRestoreGState(current_context())
            def clear(color: UiCore::Color) -> void can[Ui.Draw]:
                context: usize = current_context()
                set_fill_color(context, color)
                CGContextBeginPath(context)
                CGContextMoveToPoint(context, 0.0, 0.0)
                CGContextAddLineToPoint(context, UiCore::viewport_width().f64(), 0.0)
                CGContextAddLineToPoint(context, UiCore::viewport_width().f64(), UiCore::viewport_height().f64())
                CGContextAddLineToPoint(context, 0.0, UiCore::viewport_height().f64())
                CGContextClosePath(context)
                CGContextFillPath(context)
            def fill_rect(box: UiCore::Rect, color: UiCore::Color) -> void can[Ui.Draw]:
                shortest: f32 = box.size.width if box.size.width < box.size.height else box.size.height
                radius: mutable f32 = shortest * 0.22
                radius <- 10.0 if radius > 10.0 else radius
                elevated: bool = box.size.height <= 64.0 and box.size.width >= 72.0
                shadow_alpha: f32 = 0.24 if elevated else 0.0
                hairline_alpha: f32 = 0.13 if elevated else 0.055
                context: usize = current_context()
                CGContextSaveGState(context)
                set_shadow(context, 0.0, 2.0, 5.0, shadow_alpha) if shadow_alpha > 0.0
                set_fill_color(context, color)
                rounded_path(context, box, radius)
                CGContextFillPath(context)
                CGContextRestoreGState(context)
                CGContextSaveGState(context)
                rounded_path(context, box, radius)
                CGContextSetRGBStrokeColor(context, 1.0, 1.0, 1.0, hairline_alpha.f64())
                CGContextSetLineWidth(context, 1.0)
                CGContextStrokePath(context)
                CGContextRestoreGState(context)
            def fill_circle(disc: UiCore::Circle, color: UiCore::Color) -> void can[Ui.Draw]:
                context: usize = current_context()
                set_fill_color(context, color)
                CGContextBeginPath(context)
                CGContextAddArc(context, disc.center.x.f64(), disc.center.y.f64(), disc.radius.f64(), 0.0, 6.283185307179586, 0)
                CGContextFillPath(context)
            def fill_triangle(tri: UiCore::Triangle, color: UiCore::Color) -> void can[Ui.Draw]:
                context: usize = current_context()
                set_fill_color(context, color)
                CGContextBeginPath(context)
                CGContextMoveToPoint(context, tri.a.x.f64(), tri.a.y.f64())
                CGContextAddLineToPoint(context, tri.b.x.f64(), tri.b.y.f64())
                CGContextAddLineToPoint(context, tri.c.x.f64(), tri.c.y.f64())
                CGContextClosePath(context)
                CGContextFillPath(context)
            def fill_line(segment: UiCore::Line, color: UiCore::Color) -> void can[Ui.Draw]:
                context: usize = current_context()
                set_stroke_color(context, color)
                CGContextSetLineWidth(context, 1.0)
                CGContextBeginPath(context)
                CGContextMoveToPoint(context, segment.from_point.x.f64(), segment.from_point.y.f64())
                CGContextAddLineToPoint(context, segment.to_point.x.f64(), segment.to_point.y.f64())
                CGContextStrokePath(context)
            def draw_text(run: UiCore::TextRun, color: UiCore::Color) -> void can[Ui.Draw, Ui.Text]:
                return if run.text.len == 0
                pointer: cstr = run.text.data.cast[cstr] can Unsafe.PointerCast
                semibold: i32 = 1 if run.size >= 19.0 else 0
                draw_text_line(pointer, run.text.len, run.size, semibold, run.origin.x, run.origin.y, color)

        def run_with_options(title: sview, options: WindowOptions) -> i64:
            can Ui.Window, Ui.Draw, Ui.Text, Ui.Input, Unsafe.PointerCast:
                return 1 if title.len == 0
                pointer: cstr = title.data.cast[cstr] can Unsafe.PointerCast
                native_title: usize = native_string(title)
                return 1 if native_title == 0
                width: f32 = UiCore::nonnegative_extent(options.width)
                height: f32 = UiCore::nonnegative_extent(options.height)
                style: i32 = window_style(options)
                headless: bool = smoke_mode()
                release_canvas()
                canvas_initialized <- false
                headless_session <- headless
                elisa_appkit_canvas_set_activation_policy(activation_policy(headless))
                delegate_handle: mutable usize = 0
                opened: usize = elisa_appkit_canvas_open(native_title, width, height, style, elisa_appkit_canvas_backing_store_buffered(), &delegate_handle)
                CFRelease(native_title)
                return 1 if opened == 0
                canvas_window <- opened
                canvas_delegate <- delegate_handle
                elisa_appkit_canvas_set_tabbing_mode(canvas_window, tabbing_mode(options.tabbing))
                elisa_appkit_canvas_set_restorable(canvas_window, 1 if options.restorable else 0)
                elisa_appkit_canvas_center(canvas_window) if options.centered
                install_standard_menus(pointer, title.len)
                snapshot_path: mutable usize = 0
                min_width: f32 = UiCore::nonnegative_extent(options.min_width)
                min_height: f32 = UiCore::nonnegative_extent(options.min_height)
                elisa_appkit_canvas_set_min_size(canvas_window, min_width, min_height)
                UiCore::set_viewport(width, height)
                reset_accessibility_history()
                reset_frame_state()
                app_init()
                canvas_initialized <- true
                elisa_appkit_canvas_focus(canvas_window) if options.focus
                if headless:
                    snapshot_opt: cstr? = getenv("ELISA_UI_SNAPSHOT")
                    if snapshot_opt is snapshot:
                        snapshot_length: usize = strlen(snapshot)
                        snapshot_path <- native_string(sview(snapshot, 0, snapshot_length.i64()))
                        if snapshot_length > 0 and snapshot_path == 0:
                            release_canvas()
                            return 2
                    bitmap_width: i32 = bitmap_extent(width)
                    bitmap_height: i32 = bitmap_extent(height)
                    # Keep the live path entirely in Elisa: bitmap
                    # construction, frame rendering, and PNG encoding all
                    # happen in the retained renderer below. The legacy C
                    # entry point remains available only for older native
                    # callers and bridge tests.
                    result: i32 = UiAppKitCanvas::render_headless(canvas_window, snapshot_path, bitmap_width, bitmap_height)
                    CFRelease(snapshot_path) if snapshot_path != 0
                    if result == 0 or not frame_was_rendered():
                        release_canvas()
                        return 2
                    release_canvas()
                    return 0
                if elisa_appkit_canvas_present(canvas_window) == 0:
                    release_canvas()
                    return 2
                elisa_appkit_canvas_redraw(canvas_window)
                elisa_appkit_canvas_activate() if options.activate
                elisa_appkit_canvas_run()
                release_canvas()
                return 0

        def run_with_min_size(title: sview, width: f32, height: f32, min_width: f32, min_height: f32) -> i64:
            can Ui.Window, Ui.Draw, Ui.Text, Ui.Input, Unsafe.PointerCast:
                options: WindowOptions = WindowOptions{
                    width, height, min_width, min_height,
                    titled: true, closable: true, minimizable: true, resizable: true,
                    tabbing: false, restorable: false, centered: true, activate: true, focus: true,
                }
                return run_with_options(title, options)

        def run(title: sview, width: f32, height: f32) -> i64:
            can Ui.Window, Ui.Draw, Ui.Text, Ui.Input, Unsafe.PointerCast:
                return run_with_min_size(title, width, height, 0.0, 0.0)

        def close() -> void can[Ui.Window]:
            cancel_redraw()
            elisa_appkit_canvas_close(canvas_window)

        # Redraw requests originate from native callbacks and the flat adapter,
        # but the live root identity belongs to Elisa. Keep the handle threaded
        # through this single framework-owned entry point.
        def window_handle() -> usize:
            return canvas_window

        def redraw() -> void:
            return if canvas_window == 0
            elisa_appkit_canvas_redraw(canvas_window)

        # Stopping the Cocoa run loop is a native primitive; deciding when a
        # window close should cancel retained interaction and invoke it belongs
        # to the Elisa adapter that owns the widget layer.
        def stop() -> void:
            elisa_appkit_canvas_stop()

# C callbacks from ElisaCanvasView. Top-level because the Objective-C ABI names them.
def appkit_canvas_frame_callback(context: usize) -> void:
    can Ui.Draw, Ui.Text, Unsafe.PointerCast:
        # Keep the AppKit graphics context balanced around the entire retained
        # frame. The native view only supplies the context; frame-state policy
        # and restoration now live with Elisa's painter replay.
        CGContextSaveGState(context)
        UiAppKitCanvas::begin_native_frame(context)
        UiCore::set_frame_time(UiAppKitCanvas::monotonic_time())
        CGContextSetShouldAntialias(context, true)
        CGContextSetShouldSmoothFonts(context, true)
        UiCore::begin_frame()
        app_frame()
        UiAppKitCanvas::sync_accessibility()
        UiPaint::replay[UiAppKitCanvas::AppKitPainter]()
        UiAppKitCanvas::end_native_frame()
        UiAppKitCanvas::schedule_next_frame(UiCore::frame_delay())
        CGContextRestoreGState(context)

def appkit_canvas_resize_callback(width: f32, height: f32) -> void:
    return if not UiAppKitCanvas::canvas_initialized
    UiCore::set_viewport(width, height)
    app_event(UiCore::Event.Resize(size: UiCore::Size(width, height)))
    UiAppKitCanvas::redraw()

def appkit_canvas_pointer_callback(kind: i32, x: f32, y: f32, dx: f32, dy: f32, button: i32) -> void:
    at: UiCore::Vec2 = UiCore::Vec2(x, y)
    event: mutable UiCore::Event = (UiCore::PointerEvent.Move(at: at))
    event <- (UiCore::PointerEvent.Down(at: at, button: button)) if kind == 1
    event <- (UiCore::PointerEvent.Up(at: at, button: button)) if kind == 2
    event <- (UiCore::PointerEvent.Leave) if kind == 3
    event <- (UiCore::PointerEvent.Scroll(at: at, delta: UiCore::Vec2(dx, dy))) if kind == 4
    app_event(event)
    UiAppKitCanvas::redraw()

def appkit_canvas_pointer_move_callback(x: f32, y: f32) -> void:
    appkit_canvas_pointer_callback(0, x, y, 0.0, 0.0, 0)

def appkit_canvas_pointer_down_callback(x: f32, y: f32, button: i32) -> void:
    appkit_canvas_pointer_callback(1, x, y, 0.0, 0.0, button)

def appkit_canvas_pointer_up_callback(x: f32, y: f32, button: i32) -> void:
    appkit_canvas_pointer_callback(2, x, y, 0.0, 0.0, button)

def appkit_canvas_pointer_leave_callback() -> void:
    appkit_canvas_pointer_callback(3, 0.0, 0.0, 0.0, 0.0, 0)

def appkit_canvas_pointer_scroll_callback(x: f32, y: f32, dx: f32, dy: f32) -> void:
    appkit_canvas_pointer_callback(4, x, y, dx, dy, 0)

def appkit_canvas_key_callback(down: i32, code: i32) -> void:
    if down != 0 and code == UiCore::Key.Escape.i32():
        UiAppKitCanvas::close()
        return
    event: UiCore::Event = (UiCore::KeyEvent.Down(code: UiCore::Key(code))) if down != 0 else (UiCore::KeyEvent.Up(code: UiCore::Key(code)))
    app_event(event)
    UiAppKitCanvas::redraw()

def appkit_canvas_raw_key_callback(down: i32, key_code: i32, character: i32) -> void:
    code: i32 = UiAppKitCanvas::key_from_appkit(key_code, character)
    return if code == 0
    appkit_canvas_key_callback(down, code)

def appkit_canvas_raw_flags_callback(key_code: i32, modifiers: usize) -> void:
    shift: i32 = 1 if UiAppKitCanvas::native_shift(modifiers) else 0
    control: i32 = 1 if UiAppKitCanvas::native_control(modifiers) else 0
    alt: i32 = 1 if UiAppKitCanvas::native_option(modifiers) else 0
    super_key: i32 = 1 if UiAppKitCanvas::native_command(modifiers) else 0
    down: mutable i32 = 0
    down <- shift if key_code == 56 or key_code == 60
    down <- control if key_code == 59 or key_code == 62
    down <- alt if key_code == 58 or key_code == 61
    down <- super_key if key_code == 54 or key_code == 55
    appkit_canvas_raw_key_callback(down, key_code, 0)

def appkit_canvas_focus_changed_callback(focused: i32) -> void:
    event: UiCore::Event = (UiCore::Event.FocusGained) if focused != 0 else (UiCore::Event.FocusLost)
    app_event(event)
    UiAppKitCanvas::redraw()

def appkit_canvas_accessibility_environment_changed_callback() -> void:
    UiAppKitCanvas::accessibility_environment_changed()
    UiAppKitCanvas::redraw()

def appkit_canvas_rebuild_cursor_rects_callback() -> void:
    UiAppKitCanvas::rebuild_cursor_rects()

def appkit_canvas_render_headless_callback(window_handle: usize, snapshot: usize, pixels_width: i32, pixels_height: i32) -> i32:
    return UiAppKitCanvas::render_headless(window_handle, snapshot, pixels_width, pixels_height)

def appkit_canvas_pointer_button_primary() -> i32:
    return UiAppKitCanvas::pointer_button_primary()

def appkit_canvas_pointer_button_secondary() -> i32:
    return UiAppKitCanvas::pointer_button_secondary()

def appkit_canvas_accessibility_increment_direction() -> i32:
    return UiAppKitCanvas::accessibility_increment_direction()

def appkit_canvas_accessibility_decrement_direction() -> i32:
    return UiAppKitCanvas::accessibility_decrement_direction()

def appkit_canvas_accessibility_index_for_handle(handle: usize) -> usize:
    return UiAppKitCanvas::accessibility_index_for_handle(handle)

def appkit_canvas_accessibility_tooltip_text(handle: usize) -> usize:
    return UiAppKitCanvas::accessibility_tooltip_text(handle)

export fn elisa_appkit_canvas_frame(context: usize) -> void = appkit_canvas_frame_callback
export fn elisa_appkit_canvas_pointer_button_primary() -> i32 = appkit_canvas_pointer_button_primary
export fn elisa_appkit_canvas_pointer_button_secondary() -> i32 = appkit_canvas_pointer_button_secondary
export fn elisa_appkit_canvas_accessibility_increment_direction() -> i32 = appkit_canvas_accessibility_increment_direction
export fn elisa_appkit_canvas_accessibility_decrement_direction() -> i32 = appkit_canvas_accessibility_decrement_direction
export fn elisa_appkit_canvas_accessibility_index_for_handle(handle: usize) -> usize = appkit_canvas_accessibility_index_for_handle
export fn elisa_appkit_canvas_accessibility_tooltip_text(handle: usize) -> usize = appkit_canvas_accessibility_tooltip_text
export fn elisa_appkit_canvas_resize(width: f32, height: f32) -> void = appkit_canvas_resize_callback
export fn elisa_appkit_canvas_pointer_scroll(x: f32, y: f32, dx: f32, dy: f32) -> void = appkit_canvas_pointer_scroll_callback
export fn elisa_appkit_canvas_raw_flags(key_code: i32, modifiers: usize) -> void = appkit_canvas_raw_flags_callback
export fn elisa_appkit_canvas_focus_changed(focused: i32) -> void = appkit_canvas_focus_changed_callback
export fn elisa_appkit_canvas_accessibility_environment_changed() -> void = appkit_canvas_accessibility_environment_changed_callback
export fn elisa_appkit_canvas_rebuild_cursor_rects() -> void = appkit_canvas_rebuild_cursor_rects_callback
export fn elisa_appkit_canvas_render_headless(window_handle: usize, snapshot: usize, pixels_width: i32, pixels_height: i32) -> i32 = appkit_canvas_render_headless_callback
