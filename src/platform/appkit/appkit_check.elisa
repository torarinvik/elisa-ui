# Does AppKit really build the tree the widget layer described?
#
# Not a mock. This creates actual NSWindows, NSButtons and NSTextFields and then
# reads back from the LIVE objects -- their real classes, their real subview
# counts, their real frames. A test that trusted the shim's own bookkeeping would
# pass even if no NSView had ever been created.
#
# It never shows a window, so it runs headless in a normal build.

include "../../platform/appkit/ui_appkit.elisa"

using UiWidgets

extern puts(text: cstr) -> i64

global mutable failures: i32 = 0

def check(name: cstr, ok: bool) -> void:
    return if ok
    failures <- failures + 1
    _ = puts(name)

def app_widget_event(widget: UiWidgets::Widget, event: i32) -> void:
    pass

def ui_measure_text_width(text: sview, size: f32) -> f32:
    return text.len.f32() * size * 0.5
def ui_measure_text_height(text: sview, size: f32) -> f32:
    return size
def ui_font_ascent(size: f32) -> f32:
    return size
def ui_text_line_height(size: f32) -> f32:
    return size

def grey(v: u8) -> UiCore::Color:
    return UiCore::Color{r: v, g: v, b: v, a: 255}

# Window "elisa-ui" -> row -> [ Push "Open", Check "Wrap" ], plus a Label.
def build() -> Widget:
    can Memory.Allocate, Abort.Panic:
        open_button: Widget = Button.Push(min_width: 80.0, min_height: 24.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "Open", rest: grey(60), hover: grey(90), press: grey(30))
        wrap_box: Widget = Button.Check(min_width: 80.0, min_height: 24.0, grow: 1.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "Wrap", checked: true, rest: grey(60), hover: grey(90), press: grey(30))
        open_button.next_sibling <- wrap_box
        bar: Widget = Container.Box(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: open_button, next_sibling: null, axis: UiAxis.Row, padding: 8.0, spacing: 8.0, fill: grey(20))
        caption: Widget = Control.Label(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, text: "Ready", size: 13.0, ink: grey(200))
        bar.next_sibling <- caption
        return Window.Top(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: bar, next_sibling: null, title: "elisa-ui", resizable: true)

def main() -> i64:
    can Memory.Allocate, Abort.Panic, Ui.Controls, Unsafe.PointerCast:
        UiAppKit::start()
        root: Widget = build()
        layout(root, 480.0, 240.0)
        UiAppKit::realize(root)

        # Five widgets became five controls.
        check("AppKit built one control per widget", elisa_appkit_control_count() == 5)

        # ...and they are the REAL classes, not stand-ins.
        check("the root is an NSWindow", elisa_appkit_is_class(0, "NSWindow") == 1)
        check("the container is an NSView", elisa_appkit_is_class(1, "NSView") == 1)
        check("the push button is an NSButton", elisa_appkit_is_class(2, "NSButton") == 1)
        check("the checkbox is an NSButton", elisa_appkit_is_class(3, "NSButton") == 1)
        check("the label is an NSTextField", elisa_appkit_is_class(4, "NSTextField") == 1)

        # The OS view tree has the widget tree's shape: the window's content view
        # holds the bar and the caption, and the bar holds the two buttons.
        check("the window content holds two children", elisa_appkit_subview_count(0) == 2)
        check("the bar holds two children", elisa_appkit_subview_count(1) == 2)
        check("the push button holds none", elisa_appkit_subview_count(2) == 0)

        # ABSOLUTE PLACEMENT: AppKit's frames are the boxes layout computed.
        check("the window content is the viewport width", elisa_appkit_frame_width(0) == 480.0)
        check("the bar spans the window", elisa_appkit_frame_width(1) == 480.0)
        # The second button sits to the right of the first, so the row really was
        # laid out along its axis and the frames were not all zero.
        check("the row runs left to right", elisa_appkit_frame_x(3) > elisa_appkit_frame_x(2))
        check("a button is narrower than the row", elisa_appkit_frame_width(2) < 480.0)

        # TOP-LEFT ORIGIN. elisa-ui lays out y growing DOWN, like every other
        # toolkit and like the wasm canvas; AppKit's default is y growing UP.
        # Asserted directly rather than through a frame, because isFlipped changes
        # how a frame is INTERPRETED and not the number stored in it -- every frame
        # check above passes just as happily with the window upside down.
        check("the window content is top-left origin", elisa_appkit_is_flipped(0) == 1)
        check("a container is top-left origin", elisa_appkit_is_flipped(1) == 1)
        # ...and with that, a child below another really has the larger y.
        check("the caption sits below the bar", elisa_appkit_frame_y(4) > elisa_appkit_frame_y(1))

        if failures == 0:
            _ = puts("appkit: all checks passed")
            return 0
        return 1
