# Does AppKit really build the tree the widget layer described?
#
# Not a mock. This creates actual NSWindows, NSButtons and NSTextFields and then
# reads back from the LIVE objects -- their real classes, their real subview
# counts, their real frames. A test that trusted the shim's own bookkeeping would
# pass even if no NSView had ever been created.
#
# It never shows a window, so it runs headless in a normal build.
#
# NAMESPACES. Same split as the library: `AppKitCheck` holds the checks and the
# helpers, and the top level is only what something outside Elisa dictates --
# `puts`, the four text-metric hooks, `app_widget_event`, and `main`.
#
# NO GLOBAL TALLY. The failure count is a local in `run`, handed to `check` as
# `mutable i32&`. A `global mutable` would work and is what this file used to
# do, but the count is not shared state: it belongs to one run of one function,
# and a reference says so while keeping the call sites reading exactly as they
# did. Both compilers specialize the reference away.

include "../../platform/appkit/ui_appkit.elisa"

using UiWidgets

extern puts(text: cstr) -> i64

module AppKitCheck:
    private:
        def grey(v: u8) -> UiCore::Color:
            return UiCore::Color{r: v, g: v, b: v, a: 255}

        # Count a failure and name it. The tally travels in, so nothing here
        # outlives the call that owns it.
        def check(failures: mutable i32&, name: cstr, ok: bool) -> void:
            return if ok
            failures <- failures + 1
            _ = puts(name)

        # Window "elisa-ui" -> row -> [ Push "Open", Check "Wrap" ], plus a Label.
        def build() -> Widget:
            can Memory.Allocate, Abort.Panic:
                open_button: Widget = Button.Push(min_width: 80.0, min_height: 24.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "Open", rest: grey(60), hover: grey(90), press: grey(30))
                wrap_box: Widget = Button.Check(min_width: 80.0, min_height: 24.0, grow: 1.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "Wrap", checked: true, rest: grey(60), hover: grey(90), press: grey(30))
                open_button.next_sibling <- wrap_box
                bar: Widget = Container.Box(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: open_button, next_sibling: null, axis: UiConst::Axis.Row, padding: 8.0, spacing: 8.0, fill: grey(20))
                caption: Widget = Control.Label(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, text: "Ready", size: 13.0, ink: grey(200))
                bar.next_sibling <- caption
                return Window.Top(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: bar, next_sibling: null, title: "elisa-ui", resizable: true)

    public:
        # The platform's half of the contract. A check needs text to have SOME
        # extent, not the right one, so these are the crudest metrics that keep
        # layout honest.
        def measure_width(text: sview, size: f32) -> f32:
            return text.len.f32() * size * 0.5

        def line_height(size: f32) -> f32:
            return size

        def run() -> i64:
            can Memory.Allocate, Abort.Panic, Ui.Controls, Unsafe.PointerCast:
                failures: mutable i32 = 0
                UiAppKit::start()
                root: Widget = build()
                layout(root, 480.0, 240.0)
                UiAppKit::realize(root)

                # Five widgets became five controls.
                check(failures, "AppKit built one control per widget", elisa_appkit_control_count() == 5)

                # ...and they are the REAL classes, not stand-ins.
                check(failures, "the root is an NSWindow", elisa_appkit_is_class(0, "NSWindow") == 1)
                check(failures, "the top window keeps its resizable policy", elisa_appkit_window_is_resizable(0) == 1)
                check(failures, "the top window is not floating", elisa_appkit_window_is_floating(0) == 0)
                check(failures, "the container is an NSView", elisa_appkit_is_class(1, "NSView") == 1)
                check(failures, "the push button is an NSButton", elisa_appkit_is_class(2, "NSButton") == 1)
                check(failures, "the checkbox is an NSButton", elisa_appkit_is_class(3, "NSButton") == 1)
                check(failures, "the label is an NSTextField", elisa_appkit_is_class(4, "NSTextField") == 1)

                # The OS view tree has the widget tree's shape: the window's content
                # view holds the bar and the caption, and the bar holds the two buttons.
                check(failures, "the window content holds two children", elisa_appkit_subview_count(0) == 2)
                check(failures, "the bar holds two children", elisa_appkit_subview_count(1) == 2)
                check(failures, "the push button holds none", elisa_appkit_subview_count(2) == 0)

                # ABSOLUTE PLACEMENT: AppKit's frames are the boxes layout computed.
                check(failures, "the window content is the viewport width", elisa_appkit_frame_width(0) == 480.0)
                check(failures, "the bar spans the window", elisa_appkit_frame_width(1) == 480.0)
                # The second button sits to the right of the first, so the row really
                # was laid out along its axis and the frames were not all zero.
                check(failures, "the row runs left to right", elisa_appkit_frame_x(3) > elisa_appkit_frame_x(2))
                check(failures, "a button is narrower than the row", elisa_appkit_frame_width(2) < 480.0)

                # TOP-LEFT ORIGIN. elisa-ui lays out y growing DOWN, like every other
                # toolkit and like the wasm canvas; AppKit's default is y growing UP.
                # Asserted directly rather than through a frame, because isFlipped changes
                # how a frame is INTERPRETED and not the number stored in it -- every frame
                # check above passes just as happily with the window upside down.
                check(failures, "the window content is top-left origin", elisa_appkit_is_flipped(0) == 1)
                check(failures, "a container is top-left origin", elisa_appkit_is_flipped(1) == 1)
                # ...and with that, a child below another really has the larger y.
                check(failures, "the caption sits below the bar", elisa_appkit_frame_y(4) > elisa_appkit_frame_y(1))

                if failures == 0:
                    _ = puts("appkit: all checks passed")
                    return 0
                return 1

# The platform half of the contract, top-level by name.
def ui_measure_text_width(text: sview, size: f32) -> f32:
    return AppKitCheck::measure_width(text, size)

def ui_measure_text_height(text: sview, size: f32) -> f32:
    return AppKitCheck::line_height(size)

def ui_font_ascent(size: f32) -> f32:
    return AppKitCheck::line_height(size)

def ui_text_line_height(size: f32) -> f32:
    return AppKitCheck::line_height(size)

# The application half. This check drives the tree itself, so nothing reports.
def app_widget_event(widget: UiWidgets::Widget, event: i32) -> void:
    pass

def main() -> i64:
    return AppKitCheck::run()
