extend UiAppKitCanvas:
    private:
        global mutable accessibility_previous_ids: usize[UiCore::MAX_ACCESSIBILITY_NODES] = zeroed
        # Stable IDs are bounded by UiCore's semantic arena. Keep a reverse
        # index for the previous committed frame so each next-node reuse probe
        # is constant-time instead of rescanning every previous element.
        global mutable accessibility_previous_slot_by_id: usize[UiCore::MAX_ACCESSIBILITY_NODES] = zeroed
        global mutable accessibility_previous: AccessibilityState[UiCore::MAX_ACCESSIBILITY_NODES] = zeroed
        global mutable accessibility_previous_handles: usize[UiCore::MAX_ACCESSIBILITY_NODES] = zeroed
        # Retention is decided while the next semantic frame resolves each
        # stable ID. Keeping one bit per previous slot avoids a second
        # previous-by-next nested scan when collecting stale Cocoa elements.
        global mutable accessibility_previous_retained: bool[UiCore::MAX_ACCESSIBILITY_NODES] = zeroed
        global mutable accessibility_next_ids: usize[UiCore::MAX_ACCESSIBILITY_NODES] = zeroed
        global mutable accessibility_next_handles: usize[UiCore::MAX_ACCESSIBILITY_NODES] = zeroed
        global mutable accessibility_commit_handles: usize[UiCore::MAX_ACCESSIBILITY_NODES] = zeroed
        global mutable accessibility_stale_handles: usize[UiCore::MAX_ACCESSIBILITY_NODES] = zeroed
        global mutable accessibility_stale_count: usize = 0
        global mutable accessibility_next: AccessibilityState[UiCore::MAX_ACCESSIBILITY_NODES] = zeroed
        # AccessibilityState is queried after the frame that produced it (for
        # example by a lazy tooltip callback). Keep the retained labels/help
        # in Elisa-owned storage instead of preserving borrowed application
        # views whose backing bytes may have gone out of scope at frame end.
        const ACCESSIBILITY_TEXT_CAPACITY: usize = UiCore::MAX_TEXT_BYTES
        const ACCESSIBILITY_TEXT_STORAGE_SIZE: usize = UiCore::MAX_ACCESSIBILITY_NODES * ACCESSIBILITY_TEXT_CAPACITY
        global mutable accessibility_previous_label_storage: u8[ACCESSIBILITY_TEXT_STORAGE_SIZE] = zeroed
        global mutable accessibility_previous_help_storage: u8[ACCESSIBILITY_TEXT_STORAGE_SIZE] = zeroed
        global mutable accessibility_next_label_storage: u8[ACCESSIBILITY_TEXT_STORAGE_SIZE] = zeroed
        global mutable accessibility_next_help_storage: u8[ACCESSIBILITY_TEXT_STORAGE_SIZE] = zeroed
        global mutable accessibility_previous_count: usize = 0
        global mutable accessibility_force_layout: bool = true
        global mutable headless_session: bool = false
        global mutable redraw_timer: usize = 0
        global mutable frame_rendered: bool = false
        global mutable frame_context: usize = 0
        # The retained root window handle lives in Elisa for exactly one run.
        # Objective-C keeps only a weak lookup for callbacks and operations.
        global mutable canvas_window: usize = 0
        # AppKit's delegate property is non-owning. Keep its one transferred
        # retain in Elisa alongside the window so close/focus callbacks remain
        # valid until the run has fully returned.
        global mutable canvas_delegate: usize = 0
        const ACCESSIBILITY_IDENTIFIER_CAPACITY: usize = 32
        global mutable accessibility_identifier_storage: u8[ACCESSIBILITY_IDENTIFIER_CAPACITY] = zeroed
        const ACCESSIBILITY_RANGE_MINIMUM: f32 = 0.0
        const ACCESSIBILITY_RANGE_MAXIMUM: f32 = 1.0

        def previous_accessibility_index(id: usize) -> usize:
            return UiCore::MAX_ACCESSIBILITY_NODES if id >= UiCore::MAX_ACCESSIBILITY_NODES
            index: usize = accessibility_previous_slot_by_id[id]
            return index if index < accessibility_previous_count and accessibility_previous_ids[index] == id
            return UiCore::MAX_ACCESSIBILITY_NODES

        def release_accessibility_handles() -> void:
            index: mutable usize = 0
            while index < accessibility_previous_count:
                handle: usize = accessibility_previous_handles[index]
                old_id: usize = accessibility_previous_ids[index]
                accessibility_previous_slot_by_id[old_id] <- UiCore::MAX_ACCESSIBILITY_NODES if old_id < UiCore::MAX_ACCESSIBILITY_NODES
                elisa_appkit_canvas_accessibility_release(handle) if handle != 0
                accessibility_previous_handles[index] <- 0
                index <- index + 1
            accessibility_previous_count <- 0

        def reset_accessibility_history() -> void:
            release_accessibility_handles()
            # This storage spans every semantic slot, so keep the clear
            # iterative rather than lowering a 256*text-capacity closure
            # reduction on every window start.
            byte_index: mutable usize = 0
            while byte_index < ACCESSIBILITY_TEXT_STORAGE_SIZE:
                accessibility_previous_label_storage[byte_index] <- 0
                accessibility_previous_help_storage[byte_index] <- 0
                accessibility_next_label_storage[byte_index] <- 0
                accessibility_next_help_storage[byte_index] <- 0
                byte_index <- byte_index + 1
            accessibility_force_layout <- true

        # Copy one bounded semantic string into a per-node slot and return a
        # view into that stable storage. The source can be a transient app
        # buffer; the returned view remains valid until the next semantic
        # synchronization/reset, which is the lifetime the cache requires.
        def copy_accessibility_text(value: sview, storage: mutable u8&, slot: usize) -> sview:
            safe: sview = UiCore::bounded_text(value)
            offset: usize = slot * ACCESSIBILITY_TEXT_CAPACITY
            byte_index: mutable usize = 0
            while byte_index < ACCESSIBILITY_TEXT_CAPACITY:
                storage[offset + byte_index] <- 0
                byte_index <- byte_index + 1
            take: usize = safe.len.usize()
            byte_index <- 0
            while byte_index < take:
                storage[offset + byte_index] <- safe.data[byte_index]
                byte_index <- byte_index + 1
            return sview(&storage[offset], 0, take.i64())

        # Compact the valid retained element handles and construct the ordered
        # Cocoa child collection through CoreFoundation. The native bridge only
        # validates and assigns this immutable array; it owns no semantic-list
        # filtering or mutable collection state.
        def commit_accessibility_children(requested_count: usize) -> bool can Unsafe.PointerCast:
            return false if requested_count > UiCore::MAX_ACCESSIBILITY_NODES
            count: mutable usize = 0
            index: mutable usize = 0
            while index < requested_count:
                handle: usize = accessibility_next_handles[index]
                # A semantic frame is all-or-nothing. Silently compacting a
                # missing native handle would let Cocoa accept a shorter child
                # list while Elisa published the full semantic table, leaving
                # assistive clients with nodes that can never be queried or
                # activated. Treat any allocation/validation failure as a
                # failed transaction and preserve the previous committed list.
                return false if handle == 0
                accessibility_commit_handles[count] <- handle
                count <- count + 1
                index <- index + 1
            # The semantic arena is bounded, but keep the boundary invariant
            # explicit at the construction site too. Objective-C receives only
            # an already-bounded immutable child list and therefore does not
            # need to know the framework's capacity policy.
            return false if count > UiCore::MAX_ACCESSIBILITY_NODES
            values_pointer: usize& = (&accessibility_commit_handles[0]).cast[usize&] can Unsafe.PointerCast
            children: usize = CFArrayCreate(0, values_pointer, count.i64(), 0)
            return false if children == 0
            committed: bool = elisa_appkit_canvas_accessibility_commit(canvas_window, children) != 0
            CFRelease(children)
            return committed

        def color_component(value: u8) -> f32:
            return value.f32() / 255.0

        def set_fill_color(context: usize, color: UiCore::Color) -> void:
            CGContextSetRGBFillColor(context, color_component(color.r).f64(), color_component(color.g).f64(), color_component(color.b).f64(), color_component(color.a).f64())

        def set_stroke_color(context: usize, color: UiCore::Color) -> void:
            CGContextSetRGBStrokeColor(context, color_component(color.r).f64(), color_component(color.g).f64(), color_component(color.b).f64(), color_component(color.a).f64())

        def set_shadow(context: usize, x: f32, y: f32, blur: f32, alpha: f32) -> void:
            color: usize = CGColorCreateGenericGray(0.0, alpha.f64())
            return if color == 0
            CGContextSetShadowWithColor(context, NativeSize{width: x.f64(), height: y.f64()}, blur.f64(), color)
            CGColorRelease(color)

        def current_context() -> usize:
            return frame_context

        def rounded_path(context: usize, box: UiCore::Rect, radius: f32) -> void:
            left: f64 = box.origin.x.f64()
            top: f64 = box.origin.y.f64()
            right: f64 = (box.origin.x + box.size.width).f64()
            bottom: f64 = (box.origin.y + box.size.height).f64()
            curve: f64 = radius.f64()
            CGContextBeginPath(context)
            CGContextMoveToPoint(context, left + curve, top)
            CGContextAddLineToPoint(context, right - curve, top)
            CGContextAddArcToPoint(context, right, top, right, top + curve, curve)
            CGContextAddLineToPoint(context, right, bottom - curve)
            CGContextAddArcToPoint(context, right, bottom, right - curve, bottom, curve)
            CGContextAddLineToPoint(context, left + curve, bottom)
            CGContextAddArcToPoint(context, left, bottom, left, bottom - curve, curve)
            CGContextAddLineToPoint(context, left, top + curve)
            CGContextAddArcToPoint(context, left, top, left + curve, top, curve)
            CGContextClosePath(context)

        def window_style(options: WindowOptions) -> i32:
            style: mutable i32 = 0
            style <- style | elisa_appkit_canvas_window_style_titled if options.titled
            style <- style | elisa_appkit_canvas_window_style_closable if options.closable
            style <- style | elisa_appkit_canvas_window_style_miniaturizable if options.minimizable
            style <- style | elisa_appkit_canvas_window_style_resizable if options.resizable
            return style

        def activation_policy(headless: bool) -> i32:
            return elisa_appkit_canvas_activation_policy_prohibited if headless else elisa_appkit_canvas_activation_policy_regular

        def tabbing_mode(enabled: bool) -> i32:
            return elisa_appkit_canvas_tabbing_mode_preferred if enabled else elisa_appkit_canvas_tabbing_mode_disallowed

        # Window construction and activation may create temporary Cocoa
        # objects before AppKit's run loop installs its normal pool. Keep that
        # lifetime scope in Elisa through libobjc's C ABI; the Objective-C shim
        # only performs the requested object construction and assignment.
        def open_window(width: f32, height: f32, style: i32,
                        backing: i32, delegate_handle: mutable usize&) -> usize:
            pool: usize = objc_autoreleasePoolPush()
            opened: usize = elisa_appkit_canvas_open(width, height, style, backing, &delegate_handle)
            objc_autoreleasePoolPop(pool)
            return opened

        def set_window_title(window_handle: usize, title: usize) -> bool:
            pool: usize = objc_autoreleasePoolPush()
            result: i32 = elisa_appkit_canvas_set_title(window_handle, title)
            objc_autoreleasePoolPop(pool)
            return result != 0

        def set_activation_policy(policy: i32) -> void:
            pool: usize = objc_autoreleasePoolPush()
            elisa_appkit_canvas_set_activation_policy(policy)
            objc_autoreleasePoolPop(pool)

        def smoke_mode() -> bool:
            value_opt: cstr? = getenv("ELISA_UI_SMOKE_FRAMES")
            if value_opt is value:
                return not appkit_cstr_equals(value, "0")
            return false

        # Accessibility identifiers are stable framework metadata. Generate
        # their UTF-8 bytes here so the Objective-C bridge never invents a
        # naming scheme or formats framework state on its own.
        def accessibility_identifier(id: usize) -> sview:
            prefix: sview = "elisa-ui-"
            for index in 0..<prefix.len.usize():
                accessibility_identifier_storage[index] <- prefix.data[index]
            value: mutable usize = id
            # An identifier is a bounded decimal value. Count its digits as a
            # scoped result so the conversion itself cannot become an open
            # loop if a foreign caller supplies an extreme usize.
            digits: mutable usize =
                for _ in 0..<20 |remaining: usize = value, count: usize = 0| -> count:
                    break if remaining == 0
                    count <- count + 1
                    remaining <- remaining / 10
            digits <- 1 if digits == 0
            value <- id
            for index in 0..<digits:
                position: usize = prefix.len.usize() + digits - 1 - index
                accessibility_identifier_storage[position] <- (value % 10 + 48).u8()
                value <- value / 10
            return sview(&accessibility_identifier_storage[0], 0, (prefix.len.usize() + digits).i64())
