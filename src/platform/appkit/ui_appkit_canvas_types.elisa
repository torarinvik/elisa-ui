module UiAppKitCanvas:
    public:
        # Darwin's CLOCK_MONOTONIC value. Calling libSystem directly keeps
        # timing policy and unit conversion in Elisa rather than the Cocoa shim.
        const CLOCK_MONOTONIC: i32 = 6

        def monotonic_time() -> f64:
            return clock_gettime_nsec_np(CLOCK_MONOTONIC).f64() / 1000000000.0

        const UTF8_ENCODING: u32 = 0x08000100
        const CF_NUMBER_SINT32_TYPE: i32 = 3
        const CF_NUMBER_FLOAT32_TYPE: i32 = 5
        def not_found() -> usize:
            return elisa_appkit_canvas_not_found

        # Cocoa's buttonNumber is a raw event fact. Normalize it here, after it
        # crosses the boundary, so Objective-C forwards every mouse phase with
        # the same native identity instead of choosing framework tokens by
        # protocol method.
        def button_from_appkit(button_number: i32) -> i32:
            return UiCore::PointerButton.Primary.i32() if button_number == 0
            return UiCore::PointerButton.Secondary.i32() if button_number == 1
            return UiCore::PointerButton.Middle.i32() if button_number == 2
            return UiCore::PointerButton.Back.i32() if button_number == 3
            return UiCore::PointerButton.Forward.i32() if button_number == 4
            return UiCore::NO_POINTER_BUTTON

        def accessibility_increment_direction() -> i32:
            return 1

        def accessibility_decrement_direction() -> i32:
            return -1

        # The text protocol wants a caret rectangle in view coordinates. Keep
        # its visual width beside the rest of Elisa's caret geometry instead of
        # embedding a point-size default in the Objective-C adapter.
        def caret_width() -> f32:
            return 1.0

        # Bitmap dimensions are framework geometry, not a Cocoa default. Keep
        # the conversion from logical points to whole pixels in Elisa so the
        # native snapshot bridge only receives explicit, validated extents.
        const SNAPSHOT_MAX_PIXELS: u64 = 67108864
        # The largest finite f32 below 2^31. Values at or above 2^31 cannot be
        # represented by the i32 ABI used by the CoreGraphics entry point.
        const SNAPSHOT_MAX_I32_EXTENT: f32 = 2147483520.0

        def bitmap_extent(value: f32) -> i32:
            safe: f32 = UiCore::nonnegative_extent(value)
            return 1 if safe <= 0.0
            return 0 if safe > SNAPSHOT_MAX_I32_EXTENT
            rounded: f32 = ceilf(safe)
            return 0 if rounded > SNAPSHOT_MAX_I32_EXTENT
            return 1 if rounded < 1.0 else rounded.i32()

        # A headless frame allocates four bytes per pixel inside CoreGraphics.
        # Reject an oversized area before the native allocator sees it, while
        # keeping the limit in Elisa where snapshot/resource policy belongs.
        def snapshot_dimensions_safe(width: i32, height: i32) -> bool:
            return false if width <= 0 or height <= 0
            return width.u64() <= SNAPSHOT_MAX_PIXELS / height.u64()

        # Render a frame into a CoreGraphics bitmap and optionally encode it
        # through ImageIO. The old NSBitmapImageRep path lived in Objective-C;
        # keeping the complete off-screen lifecycle here means smoke tests use
        # the same retained frame callback as a visible window without ever
        # ordering the window onscreen.
        const SNAPSHOT_BITS_PER_COMPONENT: usize = 8
        const SNAPSHOT_BITMAP_INFO_PREMULTIPLIED_LAST: u32 = 1
        const SNAPSHOT_URL_POSIX_PATH_STYLE: i32 = 0

        def render_headless(window_handle: usize, snapshot: usize, pixels_width: i32, pixels_height: i32) -> i32 can Ui.Draw, Ui.Text, Unsafe.PointerCast:
            return 0 if window_handle == 0 or window_handle != canvas_window
            return 0 if not UiLifecycle::can_render() or pixels_width <= 0 or pixels_height <= 0
            return 0 if not snapshot_dimensions_safe(pixels_width, pixels_height)
            if snapshot != 0:
                return 0 if CFGetTypeID(snapshot) != CFStringGetTypeID()
            color_space: usize = CGColorSpaceCreateDeviceRGB()
            return 0 if color_space == 0
            context: usize = CGBitmapContextCreate(0, pixels_width.usize(), pixels_height.usize(), SNAPSHOT_BITS_PER_COMPONENT, 0, color_space, SNAPSHOT_BITMAP_INFO_PREMULTIPLIED_LAST)
            CGColorSpaceRelease(color_space)
            return 0 if context == 0

            reset_frame_state()
            # CGBitmapContext uses a bottom-left origin. Mirror the context so
            # the custom painter sees the same top-left coordinates as an
            # AppKit flipped NSView; CoreText's nested transform then remains
            # identical between visible and off-screen frames.
            CGContextSaveGState(context)
            CGContextTranslateCTM(context, 0.0, pixels_height.f64())
            CGContextScaleCTM(context, 1.0, -1.0)
            appkit_canvas_frame_callback(window_handle, context)
            CGContextRestoreGState(context)
            CGContextFlush(context)
            rendered: bool = frame_was_rendered()
            if not rendered:
                CGContextRelease(context)
                return 0
            return_value: mutable i32 = 1
            if snapshot != 0:
                image: usize = CGBitmapContextCreateImage(context)
                if image == 0:
                    CGContextRelease(context)
                    return 0
                path_url: usize = CFURLCreateWithFileSystemPath(0, snapshot, SNAPSHOT_URL_POSIX_PATH_STYLE, false)
                if path_url == 0:
                    CGImageRelease(image)
                    CGContextRelease(context)
                    return 0
                png_type: sview = "public.png"
                native_png_type: usize = native_string(png_type)
                if native_png_type == 0:
                    CFRelease(path_url)
                    CGImageRelease(image)
                    CGContextRelease(context)
                    return 0
                destination: usize = CGImageDestinationCreateWithURL(path_url, native_png_type, 1, 0)
                if destination == 0:
                    CFRelease(native_png_type)
                    CFRelease(path_url)
                    CGImageRelease(image)
                    CGContextRelease(context)
                    return 0
                CGImageDestinationAddImage(destination, image, 0)
                return_value <- 1 if CGImageDestinationFinalize(destination) else 0
                CFRelease(destination)
                CFRelease(native_png_type)
                CFRelease(path_url)
                CGImageRelease(image)
            CGContextRelease(context)
            return return_value

        # Window titles originate in Elisa as counted UTF-8 views. Construct
        # their native object here so the Objective-C host only assigns the
        # borrowed value to NSWindow and never decodes framework text.
        def native_string(text: sview) -> usize can Unsafe.PointerCast:
            return 0 if text.len < 0
            safe_text: sview = UiCore::bounded_text(text)
            empty: cstr = ""
            pointer: mutable cstr = empty
            pointer <- safe_text.data.cast[cstr] can Unsafe.PointerCast if safe_text.len > 0
            return CFStringCreateWithBytes(0, pointer, safe_text.len, UTF8_ENCODING, false)

        def native_string_bytes(bytes: u8&, length: usize) -> usize can Unsafe.PointerCast:
            # This helper receives a raw byte pointer from a platform adapter.
            # Unlike `native_string`, it cannot inspect a signed view or safely
            # discover the allocation extent, so reject lengths outside the
            # framework text budget instead of letting CoreFoundation walk an
            # untrusted range.
            return 0 if length > UiCore::MAX_TEXT_BYTES
            return 0 if length > 0 and bytes == null
            # CoreFoundation still receives a pointer for an empty range on
            # some SDKs. Supply the canonical empty string when a foreign
            # caller has no byte storage at all instead of casting a null
            # reference into that ABI argument.
            if length == 0 and bytes == null:
                empty: sview = ""
                return native_string(empty)
            # Keep the native bridge's text invariant explicit even when the
            # caller supplies a byte span rather than an `sview`. CoreFoundation
            # rejects malformed UTF-8 today, but making the complete-scalar
            # prefix decision here prevents future callers from accidentally
            # handing it a truncated trailing sequence.
            # `bytes` is a counted foreign span and may be unterminated. A
            # compiler slice preserves the caller's explicit extent without
            # making a second unbounded NUL scan.
            source: sview = bytes[0:length]
            valid_length: usize = UiText::valid_utf8_prefix(source, length)
            pointer: cstr = (&bytes).cast[cstr] can Unsafe.PointerCast
            return CFStringCreateWithBytes(0, pointer, valid_length.i64(), UTF8_ENCODING, false)

        def native_attributed_string(text: usize) -> usize:
            return 0 if text == 0
            return 0 if CFGetTypeID(text) != CFStringGetTypeID()
            return CFAttributedStringCreate(0, text, 0)

        # NSTextInputClient accepts either NSString or NSAttributedString. Both
        # are toll-free CoreFoundation values, so normalize the borrowed
        # protocol object here and keep the text-editing layer independent of
        # Objective-C dynamic-type checks.
        def native_input_string(value: usize) -> usize:
            return 0 if value == 0
            type_id: usize = CFGetTypeID(value)
            return value if type_id == CFStringGetTypeID()
            return CFAttributedStringGetString(value) if type_id == CFAttributedStringGetTypeID()
            return 0

        # NSTextInputClient currently exposes no marked-text attributes. Build
        # the immutable empty collection in Elisa through CoreFoundation so
        # the Objective-C protocol adapter never embeds an array literal or
        # owns a second text-input policy.
        def valid_marked_attributes() -> usize can Unsafe.PointerCast:
            values: usize[1] = zeroed
            values_pointer: usize& = (&values[0]).cast[usize&] can Unsafe.PointerCast
            return CFArrayCreate(0, values_pointer, 0, 0)

        # Accessibility setter values are Cocoa NSNumber objects, but their
        # scalar contents are framework state already decided by Elisa.
        # Construct the retained CoreFoundation numbers here and let the
        # native bridge only assign the typed objects.
        def native_boolean_value(selected: i32) -> usize can Unsafe.PointerCast:
            value: mutable i32 = 1 if selected != 0 else 0
            value_pointer: usize& = (&value).cast[usize&] can Unsafe.PointerCast
            return CFNumberCreate(0, CF_NUMBER_SINT32_TYPE, value_pointer)

        def native_float_value(value: f32) -> usize can Unsafe.PointerCast:
            value_pointer: usize& = (&value).cast[usize&] can Unsafe.PointerCast
            return CFNumberCreate(0, CF_NUMBER_FLOAT32_TYPE, value_pointer)

        # Accessibility edits arrive as borrowed Cocoa objects. Keep their
        # type classification and scalar extraction in Elisa so the protocol
        # adapter only mirrors a retained result into NSAccessibility.
        def native_accessibility_value_kind(value: usize) -> i32:
            return 0 if value == 0
            type_id: usize = CFGetTypeID(value)
            return 1 if type_id == CFStringGetTypeID()
            return 2 if type_id == CFNumberGetTypeID() or type_id == CFBooleanGetTypeID()
            return 0

        def native_number_value(value: usize, result: mutable f32&) -> bool can Unsafe.PointerCast:
            # The scalar output is part of this exported Elisa-side helper's
            # ABI. Reject a missing destination before classifying or reading
            # the borrowed CoreFoundation object.
            return false if result == null
            return false if native_accessibility_value_kind(value) != 2
            if CFGetTypeID(value) == CFBooleanGetTypeID():
                result <- 1.0 if CFBooleanGetValue(value) else 0.0
                return true
            result_pointer: usize& = (&result).cast[usize&] can Unsafe.PointerCast
            return CFNumberGetValue(value, CF_NUMBER_FLOAT32_TYPE, result_pointer)

        # NSTextInputClient expects key interpretation as a one-event NSArray.
        # Build the toll-free-bridged collection through CoreFoundation so the
        # Objective-C adapter does not construct transient framework objects or
        # embed an array literal. The event is borrowed and AppKit consumes the
        # array synchronously, so a no-retain callback table is sufficient.
        def interpret_key_event(event: usize, window_handle: usize) -> void can Unsafe.PointerCast:
            return if event == 0 or window_handle == 0
            values: usize[1] = [event]
            values_pointer: usize& = (&values[0]).cast[usize&] can Unsafe.PointerCast
            events: usize = CFArrayCreate(0, values_pointer, 1, 0)
            return if events == 0
            elisa_appkit_canvas_interpret_key_event(events, window_handle)
            CFRelease(events)

        # Encode a retained native string into a caller-owned UTF-8 buffer.
        # CFStringGetBytes stops at a complete scalar when the fixed buffer is
        # full, preserving the text layer's well-formed-prefix invariant.
        def copy_native_string(value: usize, buffer: mutable u8&, capacity: usize) -> usize:
            # Native callbacks may reject a value after a previous successful
            # copy. Clear the destination first so callers never observe that
            # stale text through a zero-length result or a later retry. Keep
            # the CoreFoundation length argument inside the framework's text
            # envelope before narrowing it to i64.
            safe_capacity: usize = capacity if capacity < UiCore::MAX_TEXT_BYTES else UiCore::MAX_TEXT_BYTES
            return 0 if safe_capacity > 0 and buffer == null
            for index in 0..<safe_capacity:
                buffer[index] <- 0
            return 0 if value == 0 or safe_capacity == 0
            return 0 if CFGetTypeID(value) != CFStringGetTypeID()
            length: i64 = CFStringGetLength(value)
            return 0 if length <= 0
            used: mutable i64 = 0
            # CFStringGetBytes reports both the UTF-16 characters converted
            # and the UTF-8 bytes written. A fixed byte buffer can stop before
            # the final scalar (for example, 1023 ASCII bytes followed by a
            # two-byte character), so `used == safe_capacity` is not enough
            # to tell whether the native string was fully consumed. Preserve
            # the capacity sentinel whenever the native character count is
            # incomplete; text-editing callers then pass the bounded prefix
            # through UiFlat, which records the truncation instead of silently
            # clearing that diagnostic at the AppKit boundary.
            converted: i64 = CFStringGetBytes(value, NativeRange{location: 0, length: length}, UTF8_ENCODING, 0, false, buffer, safe_capacity.i64(), &used)
            return 0 if used <= 0
            return safe_capacity if converted < length
            return safe_capacity if used > safe_capacity.i64()
            return used.usize()

        # Keyboard callbacks carry Cocoa's borrowed charactersIgnoringModifiers
        # object across the FFI. Keep the native UTF-16 extraction here rather
        # than teaching the Objective-C shim any text policy.
        def native_event_character(value: usize) -> i32:
            return 0 if value == 0
            return 0 if CFGetTypeID(value) != CFStringGetTypeID()
            length: i64 = CFStringGetLength(value)
            return 0 if length != 1
            return CFStringGetCharacterAtIndex(value, 0)

        struct WindowOptions:
            width: f32
            height: f32
            min_width: f32
            min_height: f32
            titled: bool
            closable: bool
            minimizable: bool
            resizable: bool
            tabbing: bool
            restorable: bool
            centered: bool
            activate: bool
            focus: bool
