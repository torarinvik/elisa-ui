# GTK native-controls boundary.
#
# One typed C entry per GTK operation. Every one receives values Elisa already
# decided; none of them chooses a control, a place or a state. GTK is a C API,
# so unlike the Cocoa boundary there is no message-send prototype to get right
# here -- this file exists for the other reason the Apple ones do, which is to
# keep the toolkit's vocabulary out of the framework's.

extern elisa_gtk_init() -> i32
extern elisa_gtk_create_window(resizable: i32) -> usize
extern elisa_gtk_create_panel() -> usize
extern elisa_gtk_create_scroll(vertical: i32) -> usize
extern elisa_gtk_create_label() -> usize
extern elisa_gtk_create_button() -> usize
extern elisa_gtk_create_check() -> usize
extern elisa_gtk_create_radio() -> usize
extern elisa_gtk_create_entry(secure: i32) -> usize
extern elisa_gtk_create_slider(low: f64, high: f64, value: f64) -> usize
extern elisa_gtk_create_progress() -> usize
extern elisa_gtk_add_child(parent: usize, child: usize) -> void
extern elisa_gtk_set_frame(handle: usize, x: f32, y: f32, width: f32, height: f32) -> void
extern elisa_gtk_set_label_text(handle: usize, text: cstr) -> void
extern elisa_gtk_set_help(handle: usize, placeholder: cstr, help: cstr) -> void
extern elisa_gtk_set_state(handle: usize, value: f32, selected: i32, enabled: i32, secure: i32) -> void
extern elisa_gtk_set_colors(handle: usize, ink: u32, fill: u32) -> void
extern elisa_gtk_set_action(handle: usize) -> void
extern elisa_gtk_destroy_window(handle: usize) -> void

# Facts only a live widget has, for the fixture that asserts them.
extern elisa_gtk_is_type(handle: usize, name: cstr) -> i32
extern elisa_gtk_is_sensitive(handle: usize) -> i32
extern elisa_gtk_check_is_active(handle: usize) -> i32
extern elisa_gtk_entry_is_visible_text(handle: usize) -> i32
extern elisa_gtk_entry_has_placeholder(handle: usize) -> i32
extern elisa_gtk_child_count(handle: usize) -> i32
extern elisa_gtk_text_color(handle: usize) -> u32
extern elisa_gtk_style_errors() -> i32

# ...and the one fact no property can answer: what GTK actually painted. The
# window has to be on screen and a frame has to have been drawn, so settling
# comes first and the sample renders the widget through GSK.
extern elisa_gtk_settle(handle: usize) -> void
extern elisa_gtk_pixel_at(handle: usize, x: i32, y: i32, width: i32, height: i32) -> u32
