# Immediate shape primitives for custom Skia controls.
#
# Retained widgets continue to use UiCore::Command replay. These helpers are
# the deliberate escape hatch for a custom control that needs one extra shape
# during its paint callback; geometry and alpha policy still stay in Elisa.

include "../../core/ui_core.elisa"

extend UiSkia:
    public:
        # Custom controls can request a deliberate radius; ordinary retained
        # FillRect commands use the same bounded visual policy as AppKit's
        # custom canvas and therefore remain polished without changing the
        # portable six-command wire ABI.
        def fill_rounded_rect(box: UiCore::Rect, radius: f32, color: UiCore::Color) -> void can[Ui.Draw]:
            return if canvas_state == 0 or color.a == 0
            safe_box: UiCore::Rect = UiSkia::skia_safe_rect(box)
            return if safe_box.size.width <= 0.0 or safe_box.size.height <= 0.0
            safe_radius: f32 = UiSkia::skia_safe_radius(safe_box, radius)
            elisa_skia_canvas_fill_round_rect(
                canvas_state,
                safe_box.origin.x, safe_box.origin.y,
                safe_box.size.width, safe_box.size.height,
                safe_radius, color.r, color.g, color.b, color.a)

        def stroke_rounded_rect(box: UiCore::Rect, radius: f32, stroke_width: f32, color: UiCore::Color) -> void can[Ui.Draw]:
            return if canvas_state == 0 or color.a == 0
            safe_box: UiCore::Rect = UiSkia::skia_safe_rect(box)
            return if safe_box.size.width <= 0.0 or safe_box.size.height <= 0.0
            safe_radius: f32 = UiSkia::skia_safe_radius(safe_box, radius)
            safe_width: f32 = UiCore::bounded_extent(stroke_width)
            return if safe_width <= 0.0
            elisa_skia_canvas_stroke_round_rect(
                canvas_state,
                safe_box.origin.x, safe_box.origin.y,
                safe_box.size.width, safe_box.size.height,
                safe_radius, safe_width,
                color.r, color.g, color.b, color.a)

        # A rounded rectangle filled with a two-stop gradient, in ONE Skia draw.
        #
        # The composed clip-and-fill version below predates this and still has
        # its uses, but a clip gives the corners a hard edge while a shader on
        # the rounded path is antialiased like every other primitive -- which is
        # exactly where a surface treatment would otherwise show its seams.
        def fill_rounded_gradient(box: UiCore::Rect, radius: f32, start: UiCore::Color, end: UiCore::Color, horizontal: bool) -> void can[Ui.Draw]:
            return if canvas_state == 0 or (start.a == 0 and end.a == 0)
            safe_box: UiCore::Rect = UiSkia::skia_safe_rect(box)
            return if safe_box.size.width <= 0.0 or safe_box.size.height <= 0.0
            elisa_skia_canvas_fill_round_rect_gradient(
                canvas_state,
                safe_box.origin.x, safe_box.origin.y,
                safe_box.size.width, safe_box.size.height,
                UiSkia::skia_safe_radius(safe_box, radius),
                start.r, start.g, start.b, start.a,
                end.r, end.g, end.b, end.a,
                1 if horizontal else 0)

        # The same, stroked. This is what draws a rim light: one outline whose
        # colour changes down the edge, rather than two strokes fighting over
        # the same pixels.
        def stroke_rounded_gradient(box: UiCore::Rect, radius: f32, stroke_width: f32, start: UiCore::Color, end: UiCore::Color, horizontal: bool) -> void can[Ui.Draw]:
            return if canvas_state == 0 or (start.a == 0 and end.a == 0)
            safe_box: UiCore::Rect = UiSkia::skia_safe_rect(box)
            return if safe_box.size.width <= 0.0 or safe_box.size.height <= 0.0
            safe_width: f32 = UiCore::bounded_extent(stroke_width)
            return if safe_width <= 0.0
            elisa_skia_canvas_stroke_round_rect_gradient(
                canvas_state,
                safe_box.origin.x, safe_box.origin.y,
                safe_box.size.width, safe_box.size.height,
                UiSkia::skia_safe_radius(safe_box, radius), safe_width,
                start.r, start.g, start.b, start.a,
                end.r, end.g, end.b, end.a,
                1 if horizontal else 0)

        # A two-stop gradient is enough for polished surfaces and keeps the
        # color-stop policy in Elisa. Skia owns only shader construction and
        # rasterization; malformed geometry and fully transparent stops never
        # cross the boundary.
        def fill_linear_gradient(box: UiCore::Rect, start: UiCore::Color, end: UiCore::Color, horizontal: bool) -> void can[Ui.Draw]:
            return if canvas_state == 0 or (start.a == 0 and end.a == 0)
            safe_box: UiCore::Rect = UiSkia::skia_safe_rect(box)
            return if safe_box.size.width <= 0.0 or safe_box.size.height <= 0.0
            axis: i32 = 1 if horizontal else 0
            elisa_skia_canvas_fill_linear_gradient(
                canvas_state,
                safe_box.origin.x, safe_box.origin.y,
                safe_box.size.width, safe_box.size.height,
                start.r, start.g, start.b, start.a,
                end.r, end.g, end.b, end.a, axis)

        # Compose the existing bounded rounded-clip and gradient primitives so
        # custom cards can keep their corners transparent without introducing
        # a second native shader/path state. The scope is always popped here,
        # including when the gradient itself rejects malformed input.
        def fill_rounded_linear_gradient(box: UiCore::Rect, radius: f32, start: UiCore::Color, end: UiCore::Color, horizontal: bool) -> void can[Ui.Draw]:
            return if canvas_state == 0
            return if not UiSkia::push_rounded_clip(box, radius)
            UiSkia::fill_linear_gradient(box, start, end, horizontal)
            _ = UiSkia::pop_clip()

        # Keep shadow geometry and effect bounds in Elisa for both immediate
        # controls and deferred AppKit callback drawing. Skia receives only the
        # already-normalized rounded surface and explicit effect parameters.
        def draw_shadow_rounded_rect(box: UiCore::Rect, radius: f32, offset_x: f32, offset_y: f32, blur: f32, alpha: u8) -> void can[Ui.Draw]:
            UiSkia::draw_shadow_rounded_rect_with_color(box, radius, offset_x, offset_y, blur, UiCore::rgba(0, 0, 0, alpha))

        def draw_shadow_rounded_rect_with_color(box: UiCore::Rect, radius: f32, offset_x: f32, offset_y: f32, blur: f32, color: UiCore::Color) -> void can[Ui.Draw]:
            return if canvas_state == 0 or color.a == 0
            safe_box: UiCore::Rect = UiSkia::skia_safe_rect(box)
            return if safe_box.size.width <= 0.0 or safe_box.size.height <= 0.0
            safe_radius: f32 = UiSkia::skia_safe_radius(safe_box, radius)
            safe_offset_x: f32 = UiCore::bounded_coordinate(offset_x)
            safe_offset_y: f32 = UiCore::bounded_coordinate(offset_y)
            safe_blur: f32 = UiCore::bounded_extent(blur)
            elisa_skia_canvas_shadow_round_rect_color(
                canvas_state,
                safe_box.origin.x, safe_box.origin.y,
                safe_box.size.width, safe_box.size.height, safe_radius,
                safe_offset_x, safe_offset_y, safe_blur,
                color.r, color.g, color.b, color.a)

        def fill_circle(disc: UiCore::Circle, color: UiCore::Color) -> void can[Ui.Draw]:
            return if canvas_state == 0 or color.a == 0
            safe_disc: UiCore::Circle = UiSkia::skia_safe_circle(disc)
            return if safe_disc.radius <= 0.0
            elisa_skia_canvas_fill_circle(
                canvas_state,
                safe_disc.center.x, safe_disc.center.y, safe_disc.radius,
                color.r, color.g, color.b, color.a)

        def stroke_circle(disc: UiCore::Circle, stroke_width: f32, color: UiCore::Color) -> void can[Ui.Draw]:
            return if canvas_state == 0 or color.a == 0
            safe_width: f32 = UiCore::bounded_extent(stroke_width)
            safe_disc: UiCore::Circle = UiSkia::skia_safe_circle_with_stroke(disc, safe_width)
            return if safe_disc.radius <= 0.0 or safe_width <= 0.0
            elisa_skia_canvas_stroke_circle(
                canvas_state,
                safe_disc.center.x, safe_disc.center.y, safe_disc.radius, safe_width,
                color.r, color.g, color.b, color.a)

        def fill_triangle(tri: UiCore::Triangle, color: UiCore::Color) -> void can[Ui.Draw]:
            return if canvas_state == 0 or color.a == 0
            safe_tri: UiCore::Triangle = UiSkia::skia_safe_triangle(tri)
            elisa_skia_canvas_fill_triangle(
                canvas_state,
                safe_tri.a.x, safe_tri.a.y,
                safe_tri.b.x, safe_tri.b.y,
                safe_tri.c.x, safe_tri.c.y,
                color.r, color.g, color.b, color.a)

        def cap_token(width: f32) -> i32:
            return 1 if UiPaint::stroke_cap_is_round(width) else 0

        def stroke_line(segment: UiCore::Line, stroke_width: f32, color: UiCore::Color) -> void can[Ui.Draw]:
            return if canvas_state == 0 or color.a == 0
            safe_line: UiCore::Line = UiSkia::skia_safe_line(segment)
            safe_width: f32 = UiCore::bounded_extent(stroke_width)
            return if safe_width <= 0.0
            elisa_skia_canvas_fill_line(
                canvas_state,
                safe_line.from_point.x, safe_line.from_point.y,
                safe_line.to_point.x, safe_line.to_point.y,
                safe_width, cap_token(safe_width), color.r, color.g, color.b, color.a)
