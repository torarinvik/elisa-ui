# Elisa-owned resource bindings for the Skia custom painter.
#
# Hosts decode/upload images and typefaces. This extension records only the
# opaque borrowed handles against generation-safe UiResources identities, so a
# recycled logical resource cannot accidentally reuse an old renderer object.

include "../../widgets/ui_resources.elisa"

extend UiSkia:
    public:
        const MAX_IMAGE_BINDINGS: usize = 128
        const MAX_FONT_BINDINGS: usize = 64

        # Remove bindings whose logical resource is no longer paintable. This
        # is safe to call after host disposal and keeps opaque pointer values
        # from accumulating across retries, failures, or view teardown.
        def prune_bindings() -> usize:
            ensure_binding_indexes()
            removed: mutable usize = 0
            for index in 0..<MAX_IMAGE_BINDINGS:
                if skia_image_binding_active[index] and UiResources::state(skia_image_binding_resources[index]) != UiResources::State.Ready:
                    clear_image_binding_index(index)
                    skia_image_binding_active[index] <- false
                    skia_image_binding_resources[index] <- UiResources::resource_invalid()
                    skia_image_binding_images[index] <- 0
                    removed <- removed + 1
            for index in 0..<MAX_FONT_BINDINGS:
                if skia_font_binding_active[index] and UiResources::state(skia_font_binding_resources[index]) != UiResources::State.Ready:
                    clear_font_binding_index(index)
                    skia_font_binding_active[index] <- false
                    skia_font_binding_resources[index] <- UiResources::resource_invalid()
                    skia_font_binding_fonts[index] <- 0
                    removed <- removed + 1
            return removed

        # Teardown can clear both resource kinds with one exact generation key.
        # The returned count lets a host verify that its borrowed handles were
        # removed before freeing the corresponding native objects.
        def clear_resource_bindings(resource: UiResources::ResourceHandle) -> usize:
            removed: mutable usize = 0
            removed <- removed + 1 if UiSkia::unbind_image(resource)
            removed <- removed + 1 if UiSkia::unbind_font(resource)
            return removed

        # A lost GPU surface invalidates every renderer object at once. Keep
        # logical resources alive, but drop all borrowed image/typeface handles
        # so a recreated surface cannot accidentally draw through stale objects.
        def clear_bindings() -> void:
            UiSkia::clear_image_bindings()
            UiSkia::clear_font_bindings()

        def image_binding_count() -> usize:
            count: mutable usize = 0
            for index in 0..<MAX_IMAGE_BINDINGS:
                count <- count + 1 if skia_image_binding_active[index]
            return count

        def font_binding_count() -> usize:
            count: mutable usize = 0
            for index in 0..<MAX_FONT_BINDINGS:
                count <- count + 1 if skia_font_binding_active[index]
            return count

        def draw_ready_image(image: usize, resource: UiResources::ResourceHandle, box: UiCore::Rect, alpha: u8) -> bool can[Ui.Draw]:
            return UiSkia::draw_ready_image_with_sampling(image, resource, box, alpha, UiSkia::ImageSampling.Linear)

        def draw_ready_image_with_sampling(image: usize, resource: UiResources::ResourceHandle, box: UiCore::Rect, alpha: u8, sampling: UiSkia::ImageSampling) -> bool can[Ui.Draw]:
            return false if UiResources::state(resource) != UiResources::State.Ready
            return false if image == 0 or canvas_state == 0 or alpha == 0
            safe_width: f32 = UiCore::bounded_extent(box.size.width)
            safe_height: f32 = UiCore::bounded_extent(box.size.height)
            return false if safe_width <= 0.0 or safe_height <= 0.0
            UiSkia::draw_image_with_sampling(image, box, alpha, sampling)
            return true

        def bind_image(resource: UiResources::ResourceHandle, image: usize) -> bool:
            _ = UiSkia::prune_bindings()
            return false if UiResources::state(resource) != UiResources::State.Ready or image == 0
            existing: usize = image_binding_index(resource)
            if existing < MAX_IMAGE_BINDINGS:
                skia_image_binding_images[existing] <- image
                return true
            free_index: mutable usize = MAX_IMAGE_BINDINGS
            for index in 0..<MAX_IMAGE_BINDINGS:
                if not skia_image_binding_active[index]:
                    free_index <- index
                    break
            return false if free_index == MAX_IMAGE_BINDINGS
            skia_image_binding_resources[free_index] <- resource
            skia_image_binding_images[free_index] <- image
            skia_image_binding_active[free_index] <- true
            skia_image_binding_slot_by_resource[resource.slot.usize()] <- free_index
            return true

        def unbind_image(resource: UiResources::ResourceHandle) -> bool:
            index: usize = image_binding_index(resource)
            return false if index >= MAX_IMAGE_BINDINGS
            clear_image_binding_index(index)
            skia_image_binding_active[index] <- false
            skia_image_binding_resources[index] <- UiResources::resource_invalid()
            skia_image_binding_images[index] <- 0
            return true

        def clear_image_bindings() -> void:
            ensure_binding_indexes()
            for resource_slot in 0..<UiResources::MAX_RESOURCES:
                skia_image_binding_slot_by_resource[resource_slot] <- MAX_IMAGE_BINDINGS
            for index in 0..<MAX_IMAGE_BINDINGS:
                skia_image_binding_active[index] <- false
                skia_image_binding_resources[index] <- UiResources::resource_invalid()
                skia_image_binding_images[index] <- 0

        def draw_bound_image(resource: UiResources::ResourceHandle, box: UiCore::Rect, alpha: u8) -> bool can[Ui.Draw]:
            return UiSkia::draw_bound_image_with_sampling(resource, box, alpha, UiSkia::ImageSampling.Linear)

        def draw_bound_image_with_sampling(resource: UiResources::ResourceHandle, box: UiCore::Rect, alpha: u8, sampling: UiSkia::ImageSampling) -> bool can[Ui.Draw]:
            _ = UiSkia::prune_bindings()
            return false if UiResources::state(resource) != UiResources::State.Ready
            index: usize = image_binding_index(resource)
            return false if index >= MAX_IMAGE_BINDINGS
            return UiSkia::draw_ready_image_with_sampling(skia_image_binding_images[index], resource, box, alpha, sampling)

        def bind_font(resource: UiResources::ResourceHandle, font: usize) -> bool:
            _ = UiSkia::prune_bindings()
            return false if UiResources::state(resource) != UiResources::State.Ready or font == 0
            existing: usize = font_binding_index(resource)
            if existing < MAX_FONT_BINDINGS:
                skia_font_binding_fonts[existing] <- font
                return true
            free_index: mutable usize = MAX_FONT_BINDINGS
            for index in 0..<MAX_FONT_BINDINGS:
                if not skia_font_binding_active[index]:
                    free_index <- index
                    break
            return false if free_index == MAX_FONT_BINDINGS
            skia_font_binding_resources[free_index] <- resource
            skia_font_binding_fonts[free_index] <- font
            skia_font_binding_active[free_index] <- true
            skia_font_binding_slot_by_resource[resource.slot.usize()] <- free_index
            return true

        def unbind_font(resource: UiResources::ResourceHandle) -> bool:
            index: usize = font_binding_index(resource)
            return false if index >= MAX_FONT_BINDINGS
            clear_font_binding_index(index)
            skia_font_binding_active[index] <- false
            skia_font_binding_resources[index] <- UiResources::resource_invalid()
            skia_font_binding_fonts[index] <- 0
            return true

        def clear_font_bindings() -> void:
            ensure_binding_indexes()
            for resource_slot in 0..<UiResources::MAX_RESOURCES:
                skia_font_binding_slot_by_resource[resource_slot] <- MAX_FONT_BINDINGS
            for index in 0..<MAX_FONT_BINDINGS:
                skia_font_binding_active[index] <- false
                skia_font_binding_resources[index] <- UiResources::resource_invalid()
                skia_font_binding_fonts[index] <- 0

        def draw_bound_text(resource: UiResources::ResourceHandle, run: UiCore::TextRun, color: UiCore::Color) -> bool can[Ui.Draw, Ui.Text]:
            _ = UiSkia::prune_bindings()
            return false if UiResources::state(resource) != UiResources::State.Ready
            index: usize = font_binding_index(resource)
            return false if index >= MAX_FONT_BINDINGS
            return UiSkia::draw_ready_text(skia_font_binding_fonts[index], resource, run, color)

        # Font fallback is a framework policy, not a Skia or host decision.
        # Prefer the primary generation when it is ready and bound; otherwise
        # use the optional fallback generation without exposing native font
        # handles to the caller. An invalid fallback simply fails closed.
        def draw_bound_text_with_fallback(primary: UiResources::ResourceHandle, fallback: UiResources::ResourceHandle, run: UiCore::TextRun, color: UiCore::Color) -> bool can[Ui.Draw, Ui.Text]:
            _ = UiSkia::prune_bindings()
            index: mutable usize = font_binding_index(primary) if UiResources::state(primary) == UiResources::State.Ready else MAX_FONT_BINDINGS
            resource: mutable UiResources::ResourceHandle = primary
            if index >= MAX_FONT_BINDINGS:
                index <- font_binding_index(fallback) if UiResources::state(fallback) == UiResources::State.Ready else MAX_FONT_BINDINGS
                resource <- fallback
            return false if index >= MAX_FONT_BINDINGS
            return UiSkia::draw_ready_text(skia_font_binding_fonts[index], resource, run, color)

        def measure_bound_text_width(resource: UiResources::ResourceHandle, text: sview, size: f32) -> f32:
            _ = UiSkia::prune_bindings()
            return 0.0 if UiResources::state(resource) != UiResources::State.Ready
            index: usize = font_binding_index(resource)
            return 0.0 if index >= MAX_FONT_BINDINGS
            return UiSkia::measure_ready_text_width(skia_font_binding_fonts[index], resource, text, size)

        def measure_bound_text_width_with_fallback(primary: UiResources::ResourceHandle, fallback: UiResources::ResourceHandle, text: sview, size: f32) -> f32:
            _ = UiSkia::prune_bindings()
            index: mutable usize = font_binding_index(primary) if UiResources::state(primary) == UiResources::State.Ready else MAX_FONT_BINDINGS
            resource: mutable UiResources::ResourceHandle = primary
            if index >= MAX_FONT_BINDINGS:
                index <- font_binding_index(fallback) if UiResources::state(fallback) == UiResources::State.Ready else MAX_FONT_BINDINGS
                resource <- fallback
            return 0.0 if index >= MAX_FONT_BINDINGS
            return UiSkia::measure_ready_text_width(skia_font_binding_fonts[index], resource, text, size)

        def bound_font_ascent(resource: UiResources::ResourceHandle, size: f32) -> f32:
            _ = UiSkia::prune_bindings()
            return 0.0 if UiResources::state(resource) != UiResources::State.Ready
            index: usize = font_binding_index(resource)
            return 0.0 if index >= MAX_FONT_BINDINGS
            return UiSkia::ready_font_ascent(skia_font_binding_fonts[index], resource, size)

        def bound_font_ascent_with_fallback(primary: UiResources::ResourceHandle, fallback: UiResources::ResourceHandle, size: f32) -> f32:
            _ = UiSkia::prune_bindings()
            index: mutable usize = font_binding_index(primary) if UiResources::state(primary) == UiResources::State.Ready else MAX_FONT_BINDINGS
            resource: mutable UiResources::ResourceHandle = primary
            if index >= MAX_FONT_BINDINGS:
                index <- font_binding_index(fallback) if UiResources::state(fallback) == UiResources::State.Ready else MAX_FONT_BINDINGS
                resource <- fallback
            return 0.0 if index >= MAX_FONT_BINDINGS
            return UiSkia::ready_font_ascent(skia_font_binding_fonts[index], resource, size)

        def bound_font_line_height(resource: UiResources::ResourceHandle, size: f32) -> f32:
            _ = UiSkia::prune_bindings()
            return 0.0 if UiResources::state(resource) != UiResources::State.Ready
            index: usize = font_binding_index(resource)
            return 0.0 if index >= MAX_FONT_BINDINGS
            return UiSkia::ready_font_line_height(skia_font_binding_fonts[index], resource, size)

        def bound_font_line_height_with_fallback(primary: UiResources::ResourceHandle, fallback: UiResources::ResourceHandle, size: f32) -> f32:
            _ = UiSkia::prune_bindings()
            index: mutable usize = font_binding_index(primary) if UiResources::state(primary) == UiResources::State.Ready else MAX_FONT_BINDINGS
            resource: mutable UiResources::ResourceHandle = primary
            if index >= MAX_FONT_BINDINGS:
                index <- font_binding_index(fallback) if UiResources::state(fallback) == UiResources::State.Ready else MAX_FONT_BINDINGS
                resource <- fallback
            return 0.0 if index >= MAX_FONT_BINDINGS
            return UiSkia::ready_font_line_height(skia_font_binding_fonts[index], resource, size)

        # Font decoding/fallback remains host-owned, but a ready logical font
        # resource must still be checked in Elisa before its borrowed SkTypeface
        # can affect a frame.
        def draw_ready_text(font: usize, resource: UiResources::ResourceHandle, run: UiCore::TextRun, color: UiCore::Color) -> bool can[Ui.Draw, Ui.Text]:
            return false if UiResources::state(resource) != UiResources::State.Ready
            return false if font == 0 or canvas_state == 0 or color.a == 0 or run.text.len <= 0 or run.text.data == null
            safe_run: UiCore::TextRun = UiCore::TextRun(
                UiCore::Vec2(UiCore::bounded_coordinate(run.origin.x), UiCore::bounded_coordinate(run.origin.y)),
                UiSkia::safe_font_size(run.size),
                UiCore::bounded_text(run.text))
            return false if safe_run.text.len <= 0 or safe_run.text.data == null
            pointer: cstr = safe_run.text.data.cast[cstr] can Unsafe.PointerCast
            elisa_skia_canvas_draw_text_with_font(canvas_state, font, pointer, safe_run.text.len.usize(), safe_run.origin.x, safe_run.origin.y, safe_run.size, color.r, color.g, color.b, color.a)
            return true

        def measure_ready_text_width(font: usize, resource: UiResources::ResourceHandle, text: sview, size: f32) -> f32:
            return 0.0 if UiResources::state(resource) != UiResources::State.Ready or font == 0
            return 0.0 if text.len <= 0 or text.data == null or not UiCore::is_finite(size)
            safe_text: sview = UiCore::bounded_text(text)
            return 0.0 if safe_text.len <= 0 or safe_text.data == null
            pointer: cstr = safe_text.data.cast[cstr] can Unsafe.PointerCast
            return UiCore::bounded_extent(elisa_skia_measure_text_width_with_font(font, pointer, safe_text.len.usize(), UiSkia::safe_font_size(size)))

        def ready_font_ascent(font: usize, resource: UiResources::ResourceHandle, size: f32) -> f32:
            return 0.0 if UiResources::state(resource) != UiResources::State.Ready or font == 0
            return UiCore::bounded_extent(elisa_skia_font_ascent_with_font(font, UiSkia::safe_font_size(size)))

        def ready_font_line_height(font: usize, resource: UiResources::ResourceHandle, size: f32) -> f32:
            return 0.0 if UiResources::state(resource) != UiResources::State.Ready or font == 0
            return UiCore::bounded_extent(elisa_skia_text_line_height_with_font(font, UiSkia::safe_font_size(size)))

    private:
        global mutable skia_image_binding_resources: UiResources::ResourceHandle[MAX_IMAGE_BINDINGS] = zeroed
        global mutable skia_image_binding_images: usize[MAX_IMAGE_BINDINGS] = zeroed
        global mutable skia_image_binding_active: bool[MAX_IMAGE_BINDINGS] = zeroed
        global mutable skia_image_binding_slot_by_resource: usize[UiResources::MAX_RESOURCES] = zeroed
        global mutable skia_font_binding_resources: UiResources::ResourceHandle[MAX_FONT_BINDINGS] = zeroed
        global mutable skia_font_binding_fonts: usize[MAX_FONT_BINDINGS] = zeroed
        global mutable skia_font_binding_active: bool[MAX_FONT_BINDINGS] = zeroed
        global mutable skia_font_binding_slot_by_resource: usize[UiResources::MAX_RESOURCES] = zeroed
        global mutable binding_indexes_ready: bool = false

        def ensure_binding_indexes() -> void:
            return if binding_indexes_ready
            for resource_slot in 0..<UiResources::MAX_RESOURCES:
                skia_image_binding_slot_by_resource[resource_slot] <- MAX_IMAGE_BINDINGS
                skia_font_binding_slot_by_resource[resource_slot] <- MAX_FONT_BINDINGS
            binding_indexes_ready <- true

        def image_binding_index(resource: UiResources::ResourceHandle) -> usize:
            ensure_binding_indexes()
            return MAX_IMAGE_BINDINGS if resource.slot.usize() >= UiResources::MAX_RESOURCES
            index: usize = skia_image_binding_slot_by_resource[resource.slot.usize()]
            return index if index < MAX_IMAGE_BINDINGS and skia_image_binding_active[index] and skia_image_binding_matches(index, resource)
            return MAX_IMAGE_BINDINGS

        def font_binding_index(resource: UiResources::ResourceHandle) -> usize:
            ensure_binding_indexes()
            return MAX_FONT_BINDINGS if resource.slot.usize() >= UiResources::MAX_RESOURCES
            index: usize = skia_font_binding_slot_by_resource[resource.slot.usize()]
            return index if index < MAX_FONT_BINDINGS and skia_font_binding_active[index] and skia_font_binding_matches(index, resource)
            return MAX_FONT_BINDINGS

        def clear_image_binding_index(index: usize) -> void:
            resource_slot: usize = skia_image_binding_resources[index].slot.usize()
            skia_image_binding_slot_by_resource[resource_slot] <- MAX_IMAGE_BINDINGS if resource_slot < UiResources::MAX_RESOURCES

        def clear_font_binding_index(index: usize) -> void:
            resource_slot: usize = skia_font_binding_resources[index].slot.usize()
            skia_font_binding_slot_by_resource[resource_slot] <- MAX_FONT_BINDINGS if resource_slot < UiResources::MAX_RESOURCES

        def skia_image_binding_matches(index: usize, resource: UiResources::ResourceHandle) -> bool:
            return skia_image_binding_resources[index].slot == resource.slot and skia_image_binding_resources[index].generation == resource.generation

        def skia_font_binding_matches(index: usize, resource: UiResources::ResourceHandle) -> bool:
            return skia_font_binding_resources[index].slot == resource.slot and skia_font_binding_resources[index].generation == resource.generation
