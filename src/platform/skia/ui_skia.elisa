# Skia custom-rendering service.
#
# Elisa owns the retained command list and the painter protocol. This module
# owns only the opaque SkCanvas handle and translates the six portable paint
# primitives into a deliberately tiny C ABI. A host may provide that canvas
# from an AppKit view, an SDL surface, a Metal-backed surface, or a headless
# raster target without changing widget/layout code.

include "../../core/ui_core.elisa"
include "../../core/ui_paint.elisa"
include "../../core/ui_capabilities.elisa"

using UiPaint

extern elisa_skia_canvas_save(canvas: usize) -> void
extern elisa_skia_canvas_restore(canvas: usize) -> void
extern elisa_skia_canvas_scale(canvas: usize, x: f32, y: f32) -> void
extern elisa_skia_canvas_clip_rect(canvas: usize, x: f32, y: f32, width: f32, height: f32) -> void
extern elisa_skia_canvas_clip_round_rect(canvas: usize, x: f32, y: f32, width: f32, height: f32, radius: f32) -> void
extern elisa_skia_canvas_clear(canvas: usize, red: u8, green: u8, blue: u8, alpha: u8) -> void
extern elisa_skia_canvas_fill_round_rect(canvas: usize, x: f32, y: f32, width: f32, height: f32, radius: f32, red: u8, green: u8, blue: u8, alpha: u8) -> void
extern elisa_skia_canvas_stroke_round_rect(canvas: usize, x: f32, y: f32, width: f32, height: f32, radius: f32, stroke_width: f32, red: u8, green: u8, blue: u8, alpha: u8) -> void
extern elisa_skia_canvas_shadow_round_rect(canvas: usize, x: f32, y: f32, width: f32, height: f32, radius: f32, offset_x: f32, offset_y: f32, blur: f32, alpha: u8) -> void
extern elisa_skia_canvas_fill_linear_gradient(canvas: usize, x: f32, y: f32, width: f32, height: f32, start_red: u8, start_green: u8, start_blue: u8, start_alpha: u8, end_red: u8, end_green: u8, end_blue: u8, end_alpha: u8, horizontal: i32) -> void
extern elisa_skia_canvas_draw_image(canvas: usize, image: usize, x: f32, y: f32, width: f32, height: f32, alpha: u8) -> void
extern elisa_skia_canvas_draw_image_sampling(canvas: usize, image: usize, x: f32, y: f32, width: f32, height: f32, alpha: u8, sampling: i32) -> void
extern elisa_skia_canvas_draw_text_with_font(canvas: usize, font: usize, text: cstr, length: usize, x: f32, y: f32, size: f32, red: u8, green: u8, blue: u8, alpha: u8) -> void
extern elisa_skia_canvas_fill_circle(canvas: usize, x: f32, y: f32, radius: f32, red: u8, green: u8, blue: u8, alpha: u8) -> void
extern elisa_skia_canvas_stroke_circle(canvas: usize, x: f32, y: f32, radius: f32, stroke_width: f32, red: u8, green: u8, blue: u8, alpha: u8) -> void
extern elisa_skia_canvas_fill_triangle(canvas: usize, ax: f32, ay: f32, bx: f32, by: f32, cx: f32, cy: f32, red: u8, green: u8, blue: u8, alpha: u8) -> void
extern elisa_skia_canvas_fill_line(canvas: usize, x0: f32, y0: f32, x1: f32, y1: f32, stroke_width: f32, red: u8, green: u8, blue: u8, alpha: u8) -> void
extern elisa_skia_canvas_draw_text(canvas: usize, text: cstr, length: usize, x: f32, y: f32, size: f32, red: u8, green: u8, blue: u8, alpha: u8) -> void

module UiSkia:
    public:
        const ABI_VERSION_MAJOR: u32 = 0
        const ABI_VERSION_MINOR: u32 = 3
        const ABI_VERSION_PATCH: u32 = 0

        # Bound immediate save/restore scopes so hostile custom controls cannot
        # grow the borrowed canvas state without limit. The attachment frame
        # consumes one save; direct clip/transform helpers may use the rest.
        # Retained replay is separately bounded by UiCore::MAX_COMMANDS.
        const MAX_SCOPE_DEPTH: usize = 256
        # Retained replay wraps each clipped command in a short-lived save
        # scope. Reserve one extra ledger slot for that scope so a custom
        # control that uses the full direct budget cannot make replay pop one
        # of its own transforms when the clip push is rejected.
        const MAX_SCOPE_STACK: usize = MAX_SCOPE_DEPTH + 1

        def abi_version() -> u32:
            return (ABI_VERSION_MAJOR << 16) | (ABI_VERSION_MINOR << 8) | ABI_VERSION_PATCH

        const enum ImageSampling of i32:
            Nearest = 0
            Linear = 1

        const enum RenderStatus of i32:
            SkippedNoSurface = 0
            Complete = 1
            CommandOverflow = 2

        # The host passes an opaque SkCanvas* as usize. Elisa never dereferences
        # or stores a Skia C++ object; detach() invalidates the handle at the
        # end of every surface lifetime.
        def attach(canvas: usize) -> void:
            UiSkia::attach_scaled(canvas, 1.0)

        # Scale is applied inside a frame save/restore pair, so repeated
        # surface recreation cannot accumulate transforms on a borrowed canvas.
        def attach_scaled(canvas: usize, scale: f32) -> void:
            if canvas == 0:
                UiSkia::surface_lost()
                return
            # Capability selection is the authoritative profile gate. A host
            # may expose a borrowed canvas handle while the active profile is
            # hosted or native-control-only; do not let that opaque pointer
            # bypass the renderer policy merely because attachment is a lower
            # level entry point.
            if not UiCapabilities::select_skia_renderer():
                UiSkia::surface_lost()
                return
            safe_scale: f32 = skia_scale_value(scale)
            scale_changed: bool = skia_surface_scale != safe_scale
            UiSkia::detach() if canvas_state != 0
            if scale_changed:
                UiSkia::clear_bindings()
                UiSkia::clear_metric_cache()
            canvas_state <- canvas
            skia_clip_depth <- 0
            skia_save_depth <- 1
            skia_scope_kinds[0] <- SKIA_SCOPE_FRAME
            skia_surface_generation <- skia_surface_generation + 1
            skia_surface_generation <- 1 if skia_surface_generation == 0
            skia_surface_scale <- safe_scale
            elisa_skia_canvas_save(canvas_state)
            elisa_skia_canvas_scale(canvas_state, safe_scale, safe_scale)

        def detach() -> void:
            if canvas_state != 0:
                restore_count: usize = skia_save_depth
                for _ in 0..<restore_count:
                    elisa_skia_canvas_restore(canvas_state)
                    skia_save_depth <- skia_save_depth - 1
            canvas_state <- 0
            skia_clip_depth <- 0
            skia_transform_depth <- 0

        def is_attached() -> bool:
            return canvas_state != 0

        # Surface loss is a logical lifecycle event, not a widget-tree reset.
        # Keep retained commands/resources intact while invalidating only the
        # borrowed canvas and advancing a token that hosts can compare.
        def surface_lost() -> void:
            UiSkia::detach()
            UiSkia::cancel_deferred_frame()
            UiSkia::clear_bindings()
            UiSkia::clear_metric_cache()
            skia_surface_scale <- 1.0
            skia_surface_generation <- skia_surface_generation + 1
            skia_surface_generation <- 1 if skia_surface_generation == 0

        def surface_generation() -> u32:
            return skia_surface_generation

        # Replay the retained command batch through this backend's painter.
        # Hosts only manage the borrowed canvas lifetime; command traversal and
        # all geometry normalization stay in Elisa.
        def render() -> void can[Ui.Draw, Ui.Text]:
            _ = UiSkia::render_status()

        def render_status() -> RenderStatus can[Ui.Draw, Ui.Text]:
            return UiSkia::render_status_with_font(0)

        # A host may provide one borrowed SkTypeface for the retained text
        # batch. The handle is scoped to this replay and is never retained by
        # the framework; resource-bound text APIs remain available when a
        # longer-lived generation contract is needed.
        def render_status_with_font(font: usize) -> RenderStatus can[Ui.Draw, Ui.Text]:
            return RenderStatus.SkippedNoSurface if canvas_state == 0
            previous_font: usize = skia_frame_font
            skia_frame_font <- font
            UiPaint::replay[SkiaPainter]()
            UiSkia::replay_deferred()
            skia_frame_font <- previous_font
            return RenderStatus.CommandOverflow if UiCore::command_overflowed() or UiSkia::deferred_overflowed()
            return RenderStatus.Complete

        # Replay remains available for compatibility, while this checked form
        # tells a host whether the retained batch was complete. Overflow is
        # recorded by UiCore before replay, so the backend never allocates or
        # attempts to walk beyond the fixed command arena.
        def render_checked() -> bool can[Ui.Draw, Ui.Text]:
            return UiSkia::render_status() == RenderStatus.Complete

        # Hosts decode and retain images; Elisa owns only placement and
        # visibility policy. The handle is borrowed for this call and never
        # retained by UiSkia, so resource disposal stays host-owned.
        def draw_image(image: usize, box: UiCore::Rect, alpha: u8) -> void can[Ui.Draw]:
            return if canvas_state == 0 or image == 0 or alpha == 0
            safe_box: UiCore::Rect = UiSkia::skia_safe_rect(box)
            return if safe_box.size.width <= 0.0 or safe_box.size.height <= 0.0
            elisa_skia_canvas_draw_image(canvas_state, image, safe_box.origin.x, safe_box.origin.y, safe_box.size.width, safe_box.size.height, alpha)

        # Custom controls can opt into nearest-neighbour filtering for crisp
        # pixel art; ordinary image commands retain the smoother linear default.
        def draw_image_with_sampling(image: usize, box: UiCore::Rect, alpha: u8, sampling: ImageSampling) -> void can[Ui.Draw]:
            return if canvas_state == 0 or image == 0 or alpha == 0
            safe_box: UiCore::Rect = UiSkia::skia_safe_rect(box)
            return if safe_box.size.width <= 0.0 or safe_box.size.height <= 0.0
            raw_sampling: i32 = sampling.i32()
            safe_sampling: i32 = ImageSampling.Linear.i32() if raw_sampling != ImageSampling.Nearest.i32() and raw_sampling != ImageSampling.Linear.i32() else raw_sampling
            elisa_skia_canvas_draw_image_sampling(canvas_state, image, safe_box.origin.x, safe_box.origin.y, safe_box.size.width, safe_box.size.height, alpha, safe_sampling)

        # Custom controls may draw text directly, outside the retained command
        # replay path. Keep that escape hatch on the same bounded geometry,
        # UTF-8, and minimum-font policy as ordinary commands.
        def draw_text_run(run: UiCore::TextRun, color: UiCore::Color) -> void can[Ui.Draw, Ui.Text]:
            return if canvas_state == 0 or color.a == 0 or run.text.len <= 0 or run.text.data == null
            safe_run: UiCore::TextRun = UiCore::TextRun(
                UiCore::Vec2(
                    UiCore::bounded_coordinate(run.origin.x),
                    UiCore::bounded_coordinate(run.origin.y)),
                UiSkia::safe_font_size(run.size),
                UiCore::bounded_text(run.text))
            safe_text: sview = safe_run.text
            return if safe_text.len <= 0 or safe_text.data == null
            pointer: cstr = safe_text.data.cast[cstr] can Unsafe.PointerCast
            if skia_frame_font != 0:
                elisa_skia_canvas_draw_text_with_font(canvas_state, skia_frame_font, pointer, safe_text.len.usize(), safe_run.origin.x, safe_run.origin.y, safe_run.size, color.r, color.g, color.b, color.a)
            else:
                elisa_skia_canvas_draw_text(canvas_state, pointer, safe_text.len.usize(), safe_run.origin.x, safe_run.origin.y, safe_run.size, color.r, color.g, color.b, color.a)

        struct SkiaPainter:
            unused: i32

        impl Painter for SkiaPainter:
            def push_clip(box: UiCore::Rect) -> void can[Ui.Draw]:
                UiSkia::push_replay_clip(box)

            def pop_clip() -> void can[Ui.Draw]:
                _ = UiSkia::pop_clip()

            def clear(color: UiCore::Color) -> void can[Ui.Draw]:
                return if canvas_state == 0
                elisa_skia_canvas_clear(canvas_state, color.r, color.g, color.b, color.a)

            def fill_rect(box: UiCore::Rect, color: UiCore::Color, elevated: bool) -> void can[Ui.Draw]:
                return if canvas_state == 0 or color.a == 0
                safe_box: UiCore::Rect = UiSkia::skia_safe_rect(box)
                return if safe_box.size.width <= 0.0 or safe_box.size.height <= 0.0
                style: UiPaint::RoundedRectStyle = UiPaint::rounded_rect_style(safe_box, elevated)
                UiSkia::draw_shadow(safe_box, style)
                UiSkia::fill_rounded_rect(safe_box, style.radius, color)
                UiSkia::draw_outline(safe_box, style)

            def fill_circle(disc: UiCore::Circle, color: UiCore::Color) -> void can[Ui.Draw]:
                return if canvas_state == 0 or color.a == 0
                safe_disc: UiCore::Circle = UiSkia::skia_safe_circle(disc)
                return if safe_disc.radius <= 0.0
                elisa_skia_canvas_fill_circle(canvas_state, safe_disc.center.x, safe_disc.center.y, safe_disc.radius, color.r, color.g, color.b, color.a)

            def fill_triangle(tri: UiCore::Triangle, color: UiCore::Color) -> void can[Ui.Draw]:
                return if canvas_state == 0 or color.a == 0
                safe_tri: UiCore::Triangle = UiSkia::skia_safe_triangle(tri)
                elisa_skia_canvas_fill_triangle(canvas_state, safe_tri.a.x, safe_tri.a.y, safe_tri.b.x, safe_tri.b.y, safe_tri.c.x, safe_tri.c.y, color.r, color.g, color.b, color.a)

            def fill_line(segment: UiCore::Line, color: UiCore::Color) -> void can[Ui.Draw]:
                return if canvas_state == 0 or color.a == 0
                safe_line: UiCore::Line = UiSkia::skia_safe_line(segment)
                UiSkia::draw_line(safe_line, color)

            def draw_text(run: UiCore::TextRun, color: UiCore::Color) -> void can[Ui.Draw, Ui.Text]:
                UiSkia::draw_text_run(run, color)

    private:
        global mutable canvas_state: usize = 0
        global mutable skia_clip_depth: usize = 0
        global mutable skia_transform_depth: usize = 0
        global mutable skia_save_depth: usize = 0
        # A shared save-depth counter is not enough to validate typed pops:
        # restoring a transform through pop_clip would leave the two public
        # depth counters lying about the borrowed canvas state. Keep one byte
        # per bounded scope so mismatched pops fail closed in Elisa.
        const SKIA_SCOPE_FRAME: u8 = 0
        const SKIA_SCOPE_CLIP: u8 = 1
        const SKIA_SCOPE_TRANSFORM: u8 = 2
        global mutable skia_scope_kinds: u8[MAX_SCOPE_STACK] = zeroed
        global mutable skia_surface_generation: u32 = 0
        global mutable skia_surface_scale: f32 = 1.0
        global mutable skia_frame_font: usize = 0

include "./ui_skia_geometry.elisa"

include "./ui_skia_primitives.elisa"

include "./ui_skia_polygon.elisa"

include "./ui_skia_style.elisa"

include "./ui_skia_clip.elisa"

include "./ui_skia_state.elisa"

include "./ui_skia_transform.elisa"

include "./ui_skia_text.elisa"

include "./ui_skia_resources.elisa"

include "./ui_skia_image.elisa"

include "./ui_skia_text_layout.elisa"

include "./ui_skia_deferred.elisa"

include "./ui_skia_deferred_image.elisa"

include "./ui_skia_deferred_resource_image.elisa"

include "./ui_skia_deferred_scopes.elisa"

# C/Objective-C hosts should prefer this one-shot boundary when they do not
# need to interleave custom work with replay. Elisa owns the borrowed-canvas
# lifetime and always detaches it before returning.
def skia_render_frame_export(canvas: usize) -> void can[Ui.Draw, Ui.Text]:
    if canvas == 0:
        UiSkia::surface_lost()
        return
    UiSkia::attach(canvas)
    UiSkia::render()
    UiSkia::detach()

export fn elisa_skia_render_frame(canvas: usize) -> void = skia_render_frame_export

def skia_abi_version_export() -> u32:
    return UiSkia::abi_version()

export fn elisa_skia_abi_version() -> u32 = skia_abi_version_export

def skia_render_frame_status_export(canvas: usize) -> i32 can[Ui.Draw, Ui.Text]:
    if canvas == 0:
        UiSkia::surface_lost()
        return UiSkia::RenderStatus.SkippedNoSurface.i32()
    UiSkia::attach(canvas)
    status: UiSkia::RenderStatus = UiSkia::render_status()
    UiSkia::detach()
    return status.i32()

export fn elisa_skia_render_frame_status(canvas: usize) -> i32 = skia_render_frame_status_export

def skia_render_frame_with_font_status_export(canvas: usize, font: usize) -> i32 can[Ui.Draw, Ui.Text]:
    if canvas == 0:
        UiSkia::surface_lost()
        return UiSkia::RenderStatus.SkippedNoSurface.i32()
    UiSkia::attach(canvas)
    status: UiSkia::RenderStatus = UiSkia::render_status_with_font(font)
    UiSkia::detach()
    return status.i32()

export fn elisa_skia_render_frame_with_font_status(canvas: usize, font: usize) -> i32 = skia_render_frame_with_font_status_export

def skia_render_scaled_frame_export(canvas: usize, scale: f32) -> void can[Ui.Draw, Ui.Text]:
    if canvas == 0:
        UiSkia::surface_lost()
        return
    UiSkia::attach_scaled(canvas, scale)
    UiSkia::render()
    UiSkia::detach()

export fn elisa_skia_render_frame_scaled(canvas: usize, scale: f32) -> void = skia_render_scaled_frame_export

def skia_render_scaled_frame_status_export(canvas: usize, scale: f32) -> i32 can[Ui.Draw, Ui.Text]:
    if canvas == 0:
        UiSkia::surface_lost()
        return UiSkia::RenderStatus.SkippedNoSurface.i32()
    UiSkia::attach_scaled(canvas, scale)
    status: UiSkia::RenderStatus = UiSkia::render_status()
    UiSkia::detach()
    return status.i32()

export fn elisa_skia_render_frame_scaled_status(canvas: usize, scale: f32) -> i32 = skia_render_scaled_frame_status_export

def skia_scale_value(value: f32) -> f32:
    return 1.0 if not UiCore::is_finite(value) or value <= 0.0
    return UiCore::bounded_extent(value)
