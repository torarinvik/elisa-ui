# Skia custom-rendering service.
#
# Elisa owns the retained command list and the painter protocol. This module
# owns only the opaque SkCanvas handle and translates the six portable paint
# primitives into a deliberately tiny C ABI. A host may provide that canvas
# from an AppKit view, an SDL surface, a Metal-backed surface, or a headless
# raster target without changing widget/layout code.

include "../../core/ui_core.elisa"
include "../../core/ui_paint.elisa"
include "../../core/ui_capabilities.elisa"
include "../../widgets/ui_resources.elisa"

using UiPaint

extern elisa_skia_canvas_save(canvas: usize) -> void
extern elisa_skia_canvas_restore(canvas: usize) -> void
extern elisa_skia_canvas_scale(canvas: usize, x: f32, y: f32) -> void
extern elisa_skia_canvas_clip_rect(canvas: usize, x: f32, y: f32, width: f32, height: f32) -> void
extern elisa_skia_canvas_clear(canvas: usize, red: u8, green: u8, blue: u8, alpha: u8) -> void
extern elisa_skia_canvas_fill_rect(canvas: usize, x: f32, y: f32, width: f32, height: f32, red: u8, green: u8, blue: u8, alpha: u8) -> void
extern elisa_skia_canvas_fill_round_rect(canvas: usize, x: f32, y: f32, width: f32, height: f32, radius: f32, red: u8, green: u8, blue: u8, alpha: u8) -> void
extern elisa_skia_canvas_stroke_round_rect(canvas: usize, x: f32, y: f32, width: f32, height: f32, radius: f32, red: u8, green: u8, blue: u8, alpha: u8) -> void
extern elisa_skia_canvas_shadow_round_rect(canvas: usize, x: f32, y: f32, width: f32, height: f32, radius: f32, alpha: u8) -> void
extern elisa_skia_canvas_draw_image(canvas: usize, image: usize, x: f32, y: f32, width: f32, height: f32, alpha: u8) -> void
extern elisa_skia_canvas_draw_text_with_font(canvas: usize, font: usize, text: cstr, length: usize, x: f32, y: f32, size: f32, red: u8, green: u8, blue: u8, alpha: u8) -> void
extern elisa_skia_canvas_fill_circle(canvas: usize, x: f32, y: f32, radius: f32, red: u8, green: u8, blue: u8, alpha: u8) -> void
extern elisa_skia_canvas_fill_triangle(canvas: usize, ax: f32, ay: f32, bx: f32, by: f32, cx: f32, cy: f32, red: u8, green: u8, blue: u8, alpha: u8) -> void
extern elisa_skia_canvas_fill_line(canvas: usize, x0: f32, y0: f32, x1: f32, y1: f32, red: u8, green: u8, blue: u8, alpha: u8) -> void
extern elisa_skia_canvas_draw_text(canvas: usize, text: cstr, length: usize, x: f32, y: f32, size: f32, red: u8, green: u8, blue: u8, alpha: u8) -> void
extern elisa_skia_measure_text_width(text: cstr, length: usize, size: f32) -> f32
extern elisa_skia_font_ascent(size: f32) -> f32
extern elisa_skia_text_line_height(size: f32) -> f32
extern elisa_skia_measure_text_width_with_font(font: usize, text: cstr, length: usize, size: f32) -> f32
extern elisa_skia_font_ascent_with_font(font: usize, size: f32) -> f32
extern elisa_skia_text_line_height_with_font(font: usize, size: f32) -> f32

module UiSkia:
    public:
        const MAX_IMAGE_BINDINGS: usize = 128
        const MAX_FONT_BINDINGS: usize = 64

        # The host passes an opaque SkCanvas* as usize. Elisa never dereferences
        # or stores a Skia C++ object; detach() invalidates the handle at the
        # end of every surface lifetime.
        def attach(canvas: usize) -> void:
            UiSkia::attach_scaled(canvas, 1.0)

        # Scale is applied inside a frame save/restore pair, so repeated
        # surface recreation cannot accumulate transforms on a borrowed canvas.
        def attach_scaled(canvas: usize, scale: f32) -> void:
            UiSkia::detach() if canvas_state != 0
            canvas_state <- canvas
            skia_clip_depth <- 0
            return if canvas == 0
            skia_surface_generation <- skia_surface_generation + 1
            skia_surface_generation <- 1 if skia_surface_generation == 0
            safe_scale: f32 = skia_scale_value(scale)
            _ = UiCapabilities::select_skia_renderer()
            elisa_skia_canvas_save(canvas_state)
            elisa_skia_canvas_scale(canvas_state, safe_scale, safe_scale)

        def detach() -> void:
            if canvas_state != 0:
                while skia_clip_depth > 0:
                    elisa_skia_canvas_restore(canvas_state)
                    skia_clip_depth <- skia_clip_depth - 1
                elisa_skia_canvas_restore(canvas_state)
            canvas_state <- 0
            skia_clip_depth <- 0

        def is_attached() -> bool:
            return canvas_state != 0

        # Surface loss is a logical lifecycle event, not a widget-tree reset.
        # Keep retained commands/resources intact while invalidating only the
        # borrowed canvas and advancing a token that hosts can compare.
        def surface_lost() -> void:
            UiSkia::detach()
            skia_surface_generation <- skia_surface_generation + 1
            skia_surface_generation <- 1 if skia_surface_generation == 0

        def surface_generation() -> u32:
            return skia_surface_generation

        # Replay the retained command batch through this backend's painter.
        # Hosts only manage the borrowed canvas lifetime; command traversal and
        # all geometry normalization stay in Elisa.
        def render() -> void can[Ui.Draw, Ui.Text]:
            return if canvas_state == 0
            UiPaint::replay[SkiaPainter]()

        # Replay remains available for compatibility, while this checked form
        # tells a host whether the retained batch was complete. Overflow is
        # recorded by UiCore before replay, so the backend never allocates or
        # attempts to walk beyond the fixed command arena.
        def render_checked() -> bool can[Ui.Draw, Ui.Text]:
            return false if canvas_state == 0
            UiPaint::replay[SkiaPainter]()
            return not UiCore::command_overflowed()

        # Custom controls can request a deliberate radius; ordinary retained
        # FillRect commands use the same bounded visual policy as AppKit's
        # custom canvas and therefore remain polished without changing the
        # portable six-command wire ABI.
        def fill_rounded_rect(box: UiCore::Rect, radius: f32, color: UiCore::Color) -> void can[Ui.Draw]:
            return if canvas_state == 0
            safe_box: UiCore::Rect = UiCore::Rect(
                UiCore::bounded_coordinate(box.origin.x),
                UiCore::bounded_coordinate(box.origin.y),
                UiCore::bounded_extent(box.size.width),
                UiCore::bounded_extent(box.size.height))
            return if safe_box.size.width <= 0.0 or safe_box.size.height <= 0.0
            safe_radius: f32 = UiCore::bounded_extent(radius)
            elisa_skia_canvas_fill_round_rect(canvas_state, safe_box.origin.x, safe_box.origin.y, safe_box.size.width, safe_box.size.height, safe_radius, color.r, color.g, color.b, color.a)

        # Hosts decode and retain images; Elisa owns only placement and
        # visibility policy. The handle is borrowed for this call and never
        # retained by UiSkia, so resource disposal stays host-owned.
        def draw_image(image: usize, box: UiCore::Rect, alpha: u8) -> void can[Ui.Draw]:
            return if canvas_state == 0 or image == 0 or alpha == 0
            safe_box: UiCore::Rect = UiCore::Rect(
                UiCore::bounded_coordinate(box.origin.x),
                UiCore::bounded_coordinate(box.origin.y),
                UiCore::bounded_extent(box.size.width),
                UiCore::bounded_extent(box.size.height))
            return if safe_box.size.width <= 0.0 or safe_box.size.height <= 0.0
            elisa_skia_canvas_draw_image(canvas_state, image, safe_box.origin.x, safe_box.origin.y, safe_box.size.width, safe_box.size.height, alpha)

        # Couple a renderer handle to the logical generation that authorized
        # it. Hosts still own decode/upload and the opaque SkImage lifetime;
        # this gate prevents a stale or not-yet-ready resource from reaching
        # the custom painter.
        def draw_ready_image(image: usize, resource: UiResources::Handle, box: UiCore::Rect, alpha: u8) -> bool can[Ui.Draw]:
            return false if UiResources::state(resource) != UiResources::State.Ready
            return false if image == 0 or canvas_state == 0 or alpha == 0
            safe_width: f32 = UiCore::bounded_extent(box.size.width)
            safe_height: f32 = UiCore::bounded_extent(box.size.height)
            return false if safe_width <= 0.0 or safe_height <= 0.0
            UiSkia::draw_image(image, box, alpha)
            return true

        # Associate a host-owned decoded image with one exact logical resource
        # generation. Elisa stores only the opaque pointer and never retains or
        # releases it; unbind before the host disposes the renderer object.
        def bind_image(resource: UiResources::Handle, image: usize) -> bool:
            return false if UiResources::state(resource) != UiResources::State.Ready or image == 0
            for index in 0..<MAX_IMAGE_BINDINGS:
                if skia_image_binding_active[index] and skia_image_binding_matches(index, resource):
                    skia_image_binding_images[index] <- image
                    return true
            free_index: mutable usize = MAX_IMAGE_BINDINGS
            for index in 0..<MAX_IMAGE_BINDINGS:
                if not skia_image_binding_active[index]:
                    free_index <- index
                    break
            return false if free_index == MAX_IMAGE_BINDINGS
            skia_image_binding_resources[free_index] <- resource
            skia_image_binding_images[free_index] <- image
            skia_image_binding_active[free_index] <- true
            return true

        def unbind_image(resource: UiResources::Handle) -> bool:
            for index in 0..<MAX_IMAGE_BINDINGS:
                if skia_image_binding_active[index] and skia_image_binding_matches(index, resource):
                    skia_image_binding_active[index] <- false
                    skia_image_binding_resources[index] <- UiResources::invalid()
                    skia_image_binding_images[index] <- 0
                    return true
            return false

        def clear_image_bindings() -> void:
            for index in 0..<MAX_IMAGE_BINDINGS:
                skia_image_binding_active[index] <- false
                skia_image_binding_resources[index] <- UiResources::invalid()
                skia_image_binding_images[index] <- 0

        def draw_bound_image(resource: UiResources::Handle, box: UiCore::Rect, alpha: u8) -> bool can[Ui.Draw]:
            return false if UiResources::state(resource) != UiResources::State.Ready
            for index in 0..<MAX_IMAGE_BINDINGS:
                if skia_image_binding_active[index] and skia_image_binding_matches(index, resource):
                    return UiSkia::draw_ready_image(skia_image_binding_images[index], resource, box, alpha)
            return false

        def bind_font(resource: UiResources::Handle, font: usize) -> bool:
            return false if UiResources::state(resource) != UiResources::State.Ready or font == 0
            for index in 0..<MAX_FONT_BINDINGS:
                if skia_font_binding_active[index] and skia_font_binding_matches(index, resource):
                    skia_font_binding_fonts[index] <- font
                    return true
            free_index: mutable usize = MAX_FONT_BINDINGS
            for index in 0..<MAX_FONT_BINDINGS:
                if not skia_font_binding_active[index]:
                    free_index <- index
                    break
            return false if free_index == MAX_FONT_BINDINGS
            skia_font_binding_resources[free_index] <- resource
            skia_font_binding_fonts[free_index] <- font
            skia_font_binding_active[free_index] <- true
            return true

        def unbind_font(resource: UiResources::Handle) -> bool:
            for index in 0..<MAX_FONT_BINDINGS:
                if skia_font_binding_active[index] and skia_font_binding_matches(index, resource):
                    skia_font_binding_active[index] <- false
                    skia_font_binding_resources[index] <- UiResources::invalid()
                    skia_font_binding_fonts[index] <- 0
                    return true
            return false

        def clear_font_bindings() -> void:
            for index in 0..<MAX_FONT_BINDINGS:
                skia_font_binding_active[index] <- false
                skia_font_binding_resources[index] <- UiResources::invalid()
                skia_font_binding_fonts[index] <- 0

        def draw_bound_text(resource: UiResources::Handle, run: UiCore::TextRun, color: UiCore::Color) -> bool can[Ui.Draw, Ui.Text]:
            return false if UiResources::state(resource) != UiResources::State.Ready
            for index in 0..<MAX_FONT_BINDINGS:
                if skia_font_binding_active[index] and skia_font_binding_matches(index, resource):
                    return UiSkia::draw_ready_text(skia_font_binding_fonts[index], resource, run, color)
            return false

        def measure_bound_text_width(resource: UiResources::Handle, text: sview, size: f32) -> f32:
            return 0.0 if UiResources::state(resource) != UiResources::State.Ready
            for index in 0..<MAX_FONT_BINDINGS:
                if skia_font_binding_active[index] and skia_font_binding_matches(index, resource):
                    return UiSkia::measure_ready_text_width(skia_font_binding_fonts[index], resource, text, size)
            return 0.0

        def bound_font_ascent(resource: UiResources::Handle, size: f32) -> f32:
            return 0.0 if UiResources::state(resource) != UiResources::State.Ready
            for index in 0..<MAX_FONT_BINDINGS:
                if skia_font_binding_active[index] and skia_font_binding_matches(index, resource):
                    return UiSkia::ready_font_ascent(skia_font_binding_fonts[index], resource, size)
            return 0.0

        def bound_font_line_height(resource: UiResources::Handle, size: f32) -> f32:
            return 0.0 if UiResources::state(resource) != UiResources::State.Ready
            for index in 0..<MAX_FONT_BINDINGS:
                if skia_font_binding_active[index] and skia_font_binding_matches(index, resource):
                    return UiSkia::ready_font_line_height(skia_font_binding_fonts[index], resource, size)
            return 0.0

        # Font decoding/fallback remains host-owned, but a ready logical font
        # resource must still be checked in Elisa before its borrowed SkTypeface
        # can affect a frame.
        def draw_ready_text(font: usize, resource: UiResources::Handle, run: UiCore::TextRun, color: UiCore::Color) -> bool can[Ui.Draw, Ui.Text]:
            return false if UiResources::state(resource) != UiResources::State.Ready
            return false if font == 0 or canvas_state == 0 or run.text.len <= 0 or run.text.data == null
            safe_run: UiCore::TextRun = UiCore::TextRun(
                UiCore::Vec2(UiCore::bounded_coordinate(run.origin.x), UiCore::bounded_coordinate(run.origin.y)),
                UiCore::bounded_extent(run.size),
                UiCore::bounded_text(run.text))
            return false if safe_run.text.len <= 0 or safe_run.text.data == null
            pointer: cstr = safe_run.text.data.cast[cstr] can Unsafe.PointerCast
            elisa_skia_canvas_draw_text_with_font(canvas_state, font, pointer, safe_run.text.len.usize(), safe_run.origin.x, safe_run.origin.y, safe_run.size, color.r, color.g, color.b, color.a)
            return true

        def measure_ready_text_width(font: usize, resource: UiResources::Handle, text: sview, size: f32) -> f32:
            return 0.0 if UiResources::state(resource) != UiResources::State.Ready or font == 0
            return 0.0 if text.len <= 0 or text.data == null or not UiCore::is_finite(size)
            safe_text: sview = UiCore::bounded_text(text)
            return 0.0 if safe_text.len <= 0 or safe_text.data == null
            pointer: cstr = safe_text.data.cast[cstr] can Unsafe.PointerCast
            return UiCore::bounded_extent(elisa_skia_measure_text_width_with_font(font, pointer, safe_text.len.usize(), UiCore::bounded_extent(size)))

        def ready_font_ascent(font: usize, resource: UiResources::Handle, size: f32) -> f32:
            return 0.0 if UiResources::state(resource) != UiResources::State.Ready or font == 0
            return UiCore::bounded_extent(elisa_skia_font_ascent_with_font(font, UiCore::bounded_extent(size)))

        def ready_font_line_height(font: usize, resource: UiResources::Handle, size: f32) -> f32:
            return 0.0 if UiResources::state(resource) != UiResources::State.Ready or font == 0
            return UiCore::bounded_extent(elisa_skia_text_line_height_with_font(font, UiCore::bounded_extent(size)))

        def measure_text_width(text: sview, size: f32) -> f32:
            # Metrics are pure font queries and do not require a live canvas.
            # Layout can therefore use Skia's authority before a surface is
            # attached; only draw methods are gated by canvas_state.
            return 0.0 if text.len <= 0 or text.data == null or not UiCore::is_finite(size)
            safe_text: sview = UiCore::bounded_text(text)
            return 0.0 if safe_text.len <= 0 or safe_text.data == null
            pointer: cstr = safe_text.data.cast[cstr] can Unsafe.PointerCast
            return UiCore::bounded_extent(elisa_skia_measure_text_width(pointer, safe_text.len.usize(), UiCore::bounded_extent(size)))

        def font_ascent(size: f32) -> f32:
            return UiCore::bounded_extent(elisa_skia_font_ascent(UiCore::bounded_extent(size)))

        def text_line_height(size: f32) -> f32:
            return UiCore::bounded_extent(elisa_skia_text_line_height(UiCore::bounded_extent(size)))

        struct SkiaPainter:
            unused: i32

        impl Painter for SkiaPainter:
            def push_clip(box: UiCore::Rect) -> void can[Ui.Draw]:
                return if canvas_state == 0
                safe_box: UiCore::Rect = UiCore::Rect(box.origin.x, box.origin.y, box.size.width, box.size.height)
                elisa_skia_canvas_save(canvas_state)
                elisa_skia_canvas_clip_rect(canvas_state, safe_box.origin.x, safe_box.origin.y, safe_box.size.width, safe_box.size.height)
                skia_clip_depth <- skia_clip_depth + 1

            def pop_clip() -> void can[Ui.Draw]:
                return if canvas_state == 0 or skia_clip_depth == 0
                elisa_skia_canvas_restore(canvas_state)
                skia_clip_depth <- skia_clip_depth - 1

            def clear(color: UiCore::Color) -> void can[Ui.Draw]:
                return if canvas_state == 0
                elisa_skia_canvas_clear(canvas_state, color.r, color.g, color.b, color.a)

            def fill_rect(box: UiCore::Rect, color: UiCore::Color) -> void can[Ui.Draw]:
                return if canvas_state == 0
                style: UiPaint::RoundedRectStyle = UiPaint::rounded_rect_style(box)
                UiSkia::fill_rounded_rect(box, style.radius, color)
                safe_box: UiCore::Rect = UiCore::Rect(box.origin.x, box.origin.y, box.size.width, box.size.height)
                elisa_skia_canvas_shadow_round_rect(canvas_state, safe_box.origin.x, safe_box.origin.y, safe_box.size.width, safe_box.size.height, style.radius, style.shadow_alpha) if style.shadow_alpha > 0
                elisa_skia_canvas_stroke_round_rect(canvas_state, safe_box.origin.x, safe_box.origin.y, safe_box.size.width, safe_box.size.height, style.radius, 255, 255, 255, style.hairline_alpha)

            def fill_circle(disc: UiCore::Circle, color: UiCore::Color) -> void can[Ui.Draw]:
                return if canvas_state == 0
                safe_disc: UiCore::Circle = UiCore::Circle{center: UiCore::Vec2(disc.center.x, disc.center.y), radius: UiCore::bounded_extent(disc.radius)}
                elisa_skia_canvas_fill_circle(canvas_state, safe_disc.center.x, safe_disc.center.y, safe_disc.radius, color.r, color.g, color.b, color.a)

            def fill_triangle(tri: UiCore::Triangle, color: UiCore::Color) -> void can[Ui.Draw]:
                return if canvas_state == 0
                safe_tri: UiCore::Triangle = UiCore::Triangle{a: UiCore::Vec2(tri.a.x, tri.a.y), b: UiCore::Vec2(tri.b.x, tri.b.y), c: UiCore::Vec2(tri.c.x, tri.c.y)}
                elisa_skia_canvas_fill_triangle(canvas_state, safe_tri.a.x, safe_tri.a.y, safe_tri.b.x, safe_tri.b.y, safe_tri.c.x, safe_tri.c.y, color.r, color.g, color.b, color.a)

            def fill_line(segment: UiCore::Line, color: UiCore::Color) -> void can[Ui.Draw]:
                return if canvas_state == 0
                safe_line: UiCore::Line = UiCore::Line{from_point: UiCore::Vec2(segment.from_point.x, segment.from_point.y), to_point: UiCore::Vec2(segment.to_point.x, segment.to_point.y)}
                elisa_skia_canvas_fill_line(canvas_state, safe_line.from_point.x, safe_line.from_point.y, safe_line.to_point.x, safe_line.to_point.y, color.r, color.g, color.b, color.a)

            def draw_text(run: UiCore::TextRun, color: UiCore::Color) -> void can[Ui.Draw, Ui.Text]:
                return if canvas_state == 0 or run.text.len <= 0 or run.text.data == null
                safe_run: UiCore::TextRun = UiCore::TextRun(run.origin, run.size, run.text)
                safe_text: sview = safe_run.text
                return if safe_text.len <= 0 or safe_text.data == null
                pointer: cstr = safe_text.data.cast[cstr] can Unsafe.PointerCast
                elisa_skia_canvas_draw_text(canvas_state, pointer, safe_text.len.usize(), safe_run.origin.x, safe_run.origin.y, safe_run.size, color.r, color.g, color.b, color.a)

    private:
        global mutable canvas_state: usize = 0
        global mutable skia_clip_depth: usize = 0
        global mutable skia_surface_generation: u32 = 0
        global mutable skia_image_binding_resources: UiResources::Handle[MAX_IMAGE_BINDINGS] = zeroed
        global mutable skia_image_binding_images: usize[MAX_IMAGE_BINDINGS] = zeroed
        global mutable skia_image_binding_active: bool[MAX_IMAGE_BINDINGS] = zeroed
        global mutable skia_font_binding_resources: UiResources::Handle[MAX_FONT_BINDINGS] = zeroed
        global mutable skia_font_binding_fonts: usize[MAX_FONT_BINDINGS] = zeroed
        global mutable skia_font_binding_active: bool[MAX_FONT_BINDINGS] = zeroed

        def skia_image_binding_matches(index: usize, resource: UiResources::Handle) -> bool:
            return skia_image_binding_resources[index].slot == resource.slot and skia_image_binding_resources[index].generation == resource.generation

        def skia_font_binding_matches(index: usize, resource: UiResources::Handle) -> bool:
            return skia_font_binding_resources[index].slot == resource.slot and skia_font_binding_resources[index].generation == resource.generation

# C/Objective-C hosts should prefer this one-shot boundary when they do not
# need to interleave custom work with replay. Elisa owns the borrowed-canvas
# lifetime and always detaches it before returning.
def skia_render_frame_export(canvas: usize) -> void can[Ui.Draw, Ui.Text]:
    if canvas == 0:
        UiSkia::surface_lost()
        return
    UiSkia::attach(canvas)
    UiSkia::render()
    UiSkia::detach()

export fn elisa_skia_render_frame(canvas: usize) -> void = skia_render_frame_export

def skia_render_scaled_frame_export(canvas: usize, scale: f32) -> void can[Ui.Draw, Ui.Text]:
    if canvas == 0:
        UiSkia::surface_lost()
        return
    UiSkia::attach_scaled(canvas, scale)
    UiSkia::render()
    UiSkia::detach()

export fn elisa_skia_render_frame_scaled(canvas: usize, scale: f32) -> void = skia_render_scaled_frame_export

def skia_scale_value(value: f32) -> f32:
    return 1.0 if not UiCore::is_finite(value) or value <= 0.0
    return UiCore::bounded_extent(value)
