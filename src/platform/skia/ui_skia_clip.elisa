# Direct clip scopes for custom Skia controls.
#
# Retained commands already carry clip metadata. This extension exposes the
# same bounded policy to immediate custom drawing while sharing UiSkia's save
# depth with transforms and the attachment frame.

include "../../core/ui_core.elisa"

extend UiSkia:
    public:
        def push_clip(box: UiCore::Rect) -> bool can[Ui.Draw]:
            return false if canvas_state == 0
            return false if skia_save_depth >= UiSkia::MAX_SCOPE_DEPTH
            safe_box: UiCore::Rect = UiSkia::skia_safe_rect(box)
            return false if safe_box.size.width <= 0.0 or safe_box.size.height <= 0.0
            elisa_skia_canvas_save(canvas_state)
            elisa_skia_canvas_clip_rect(canvas_state, safe_box.origin.x, safe_box.origin.y, safe_box.size.width, safe_box.size.height)
            skia_scope_kinds[skia_save_depth] <- SKIA_SCOPE_CLIP
            skia_clip_depth <- skia_clip_depth + 1
            skia_save_depth <- skia_save_depth + 1
            return true

        # Rounded clips keep custom surfaces visually consistent with the
        # framework's rounded fills while retaining the same typed save/pop
        # contract as rectangular clips. Elisa owns radius normalization;
        # Skia only receives the already-bounded geometry.
        def push_rounded_clip(box: UiCore::Rect, radius: f32) -> bool can[Ui.Draw]:
            return false if canvas_state == 0
            return false if skia_save_depth >= UiSkia::MAX_SCOPE_DEPTH
            safe_box: UiCore::Rect = UiSkia::skia_safe_rect(box)
            return false if safe_box.size.width <= 0.0 or safe_box.size.height <= 0.0
            safe_radius: f32 = UiSkia::skia_safe_radius(safe_box, radius)
            elisa_skia_canvas_save(canvas_state)
            elisa_skia_canvas_clip_round_rect(
                canvas_state,
                safe_box.origin.x, safe_box.origin.y,
                safe_box.size.width, safe_box.size.height, safe_radius)
            skia_scope_kinds[skia_save_depth] <- SKIA_SCOPE_CLIP
            skia_clip_depth <- skia_clip_depth + 1
            skia_save_depth <- skia_save_depth + 1
            return true

        def pop_clip() -> bool can[Ui.Draw]:
            return false if canvas_state == 0 or skia_clip_depth == 0
            return false if skia_save_depth == 0 or skia_scope_kinds[skia_save_depth - 1] != SKIA_SCOPE_CLIP
            elisa_skia_canvas_restore(canvas_state)
            skia_clip_depth <- skia_clip_depth - 1
            skia_save_depth <- skia_save_depth - 1
            return true

    private:
        # Retained commands carry a clip flag even when their normalized box
        # has zero area. That is a valid empty clip (and must suppress the
        # command), unlike the public custom-drawing helper above, which
        # rejects degenerate input as a caller error. Keep this replay path
        # separate so the two contracts do not silently change each other.
        def push_replay_clip(box: UiCore::Rect) -> void can[Ui.Draw]:
            return if canvas_state == 0
            # Replay owns one reserved stack slot beyond the direct custom
            # scope budget. Each retained command pops immediately, so this
            # does not allow an unbounded native save depth.
            return if skia_save_depth >= UiSkia::MAX_SCOPE_STACK
            safe_box: UiCore::Rect = UiSkia::skia_safe_rect(box)
            elisa_skia_canvas_save(canvas_state)
            elisa_skia_canvas_clip_rect(canvas_state, safe_box.origin.x, safe_box.origin.y, safe_box.size.width, safe_box.size.height)
            skia_scope_kinds[skia_save_depth] <- SKIA_SCOPE_CLIP
            skia_clip_depth <- skia_clip_depth + 1
            skia_save_depth <- skia_save_depth + 1
