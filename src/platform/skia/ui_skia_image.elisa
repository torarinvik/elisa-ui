# Elisa-owned image destination policy for the custom renderer.
#
# Hosts provide an opaque SkImage handle and its verified intrinsic dimensions.
# Aspect-ratio decisions stay in Elisa so a custom control never needs to
# duplicate contain/cover math or rely on a native view helper.

include "../../core/ui_core.elisa"

extend UiSkia:
    public:
        const enum ImageFit of i32:
            Stretch = 0
            Contain = 1
            Cover = 2

        # Draw an image using an Elisa-owned aspect-ratio policy. The default
        # filtering remains linear, matching draw_image().
        def draw_image_fitted(image: usize, box: UiCore::Rect, source: UiCore::Size, alpha: u8, fit: UiSkia::ImageFit) -> bool can[Ui.Draw]:
            return UiSkia::draw_image_fitted_with_sampling(image, box, source, alpha, fit, UiSkia::ImageSampling.Linear)

        def draw_image_fitted_with_sampling(image: usize, box: UiCore::Rect, source: UiCore::Size, alpha: u8, fit: UiSkia::ImageFit, sampling: UiSkia::ImageSampling) -> bool can[Ui.Draw]:
            return false if canvas_state == 0 or image == 0 or alpha == 0
            safe_box: UiCore::Rect = UiSkia::skia_safe_rect(box)
            return false if safe_box.size.width <= 0.0 or safe_box.size.height <= 0.0
            source_width: f32 = UiCore::bounded_extent(source.width)
            source_height: f32 = UiCore::bounded_extent(source.height)
            return false if source_width <= 0.0 or source_height <= 0.0
            target: UiCore::Rect = UiSkia::fitted_image_rect(safe_box, source_width, source_height, fit)
            return false if target.size.width <= 0.0 or target.size.height <= 0.0
            normalized_fit: UiSkia::ImageFit = UiSkia::normalize_image_fit(fit)
            if normalized_fit == UiSkia::ImageFit.Cover:
                return false if not UiSkia::push_clip(safe_box)
                UiSkia::draw_image_with_sampling(image, target, alpha, sampling)
                _ = UiSkia::pop_clip()
                return true
            UiSkia::draw_image_with_sampling(image, target, alpha, sampling)
            return true

        # Resource-bound variants preserve generation checks and borrowed
        # image lifetime while reusing the same destination policy.
        def draw_bound_image_fitted(resource: UiResources::ResourceHandle, box: UiCore::Rect, source: UiCore::Size, alpha: u8, fit: UiSkia::ImageFit) -> bool can[Ui.Draw]:
            return UiSkia::draw_bound_image_fitted_with_sampling(resource, box, source, alpha, fit, UiSkia::ImageSampling.Linear)

        def draw_bound_image_fitted_with_sampling(resource: UiResources::ResourceHandle, box: UiCore::Rect, source: UiCore::Size, alpha: u8, fit: UiSkia::ImageFit, sampling: UiSkia::ImageSampling) -> bool can[Ui.Draw]:
            return false if UiResources::state(resource) != UiResources::State.Ready
            return false if canvas_state == 0 or alpha == 0
            safe_box: UiCore::Rect = UiSkia::skia_safe_rect(box)
            source_width: f32 = UiCore::bounded_extent(source.width)
            source_height: f32 = UiCore::bounded_extent(source.height)
            return false if safe_box.size.width <= 0.0 or safe_box.size.height <= 0.0 or source_width <= 0.0 or source_height <= 0.0
            target: UiCore::Rect = UiSkia::fitted_image_rect(safe_box, source_width, source_height, fit)
            return false if target.size.width <= 0.0 or target.size.height <= 0.0
            normalized_fit: UiSkia::ImageFit = UiSkia::normalize_image_fit(fit)
            if normalized_fit == UiSkia::ImageFit.Cover:
                return false if not UiSkia::push_clip(safe_box)
                painted: bool = UiSkia::draw_bound_image_with_sampling(resource, target, alpha, sampling)
                _ = UiSkia::pop_clip()
                return painted
            return UiSkia::draw_bound_image_with_sampling(resource, target, alpha, sampling)

        # Intrinsic metadata is already generation-scoped by UiResources, so
        # callers can opt into aspect-preserving placement without copying
        # dimensions from the host's decoded image record.
        def draw_bound_image_fitted_intrinsic(resource: UiResources::ResourceHandle, box: UiCore::Rect, alpha: u8, fit: UiSkia::ImageFit) -> bool can[Ui.Draw]:
            return UiSkia::draw_bound_image_fitted_with_sampling(resource, box, UiResources::intrinsic_size(resource), alpha, fit, UiSkia::ImageSampling.Linear)

        def draw_bound_image_fitted_intrinsic_with_sampling(resource: UiResources::ResourceHandle, box: UiCore::Rect, alpha: u8, fit: UiSkia::ImageFit, sampling: UiSkia::ImageSampling) -> bool can[Ui.Draw]:
            return UiSkia::draw_bound_image_fitted_with_sampling(resource, box, UiResources::intrinsic_size(resource), alpha, fit, sampling)

    private:
        def normalize_image_fit(fit: UiSkia::ImageFit) -> UiSkia::ImageFit:
            return fit if fit == UiSkia::ImageFit.Stretch or fit == UiSkia::ImageFit.Contain or fit == UiSkia::ImageFit.Cover
            return UiSkia::ImageFit.Stretch

        def fitted_image_rect(box: UiCore::Rect, source_width: f32, source_height: f32, fit: UiSkia::ImageFit) -> UiCore::Rect:
            normalized_fit: UiSkia::ImageFit = UiSkia::normalize_image_fit(fit)
            return box if normalized_fit == UiSkia::ImageFit.Stretch
            width_ratio: f32 = box.size.width / source_width
            height_ratio: f32 = box.size.height / source_height
            return UiCore::Rect(0.0, 0.0, 0.0, 0.0) if not UiCore::is_finite(width_ratio) or not UiCore::is_finite(height_ratio)
            scale: f32 = width_ratio if normalized_fit == UiSkia::ImageFit.Cover and width_ratio > height_ratio else height_ratio if normalized_fit == UiSkia::ImageFit.Cover else width_ratio if width_ratio < height_ratio else height_ratio
            return UiCore::Rect(0.0, 0.0, 0.0, 0.0) if not UiCore::is_finite(scale) or scale <= 0.0
            target_width_raw: f32 = source_width * scale
            target_height_raw: f32 = source_height * scale
            return UiCore::Rect(0.0, 0.0, 0.0, 0.0) if not UiCore::is_finite(target_width_raw) or not UiCore::is_finite(target_height_raw)
            target_width: f32 = UiCore::bounded_extent(target_width_raw)
            target_height: f32 = UiCore::bounded_extent(target_height_raw)
            return UiCore::Rect(0.0, 0.0, 0.0, 0.0) if target_width <= 0.0 or target_height <= 0.0
            offset_x: f32 = UiCore::bounded_coordinate((box.size.width - target_width) * 0.5)
            offset_y: f32 = UiCore::bounded_coordinate((box.size.height - target_height) * 0.5)
            return UiCore::Rect(UiCore::bounded_coordinate(box.origin.x + offset_x), UiCore::bounded_coordinate(box.origin.y + offset_y), target_width, target_height)
