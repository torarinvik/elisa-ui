# Skia-backed measured text layout.
#
# The line-break policy remains backend-neutral and Elisa-owned. This adapter
# supplies Skia's own width authority so a custom renderer never lays out with
# CoreText, SDL_ttf, or a test metric and then paints with a different font.

include "../../widgets/ui_text_measure_layout_core.elisa"

def ui_skia_measure_layout_width(text: sview, size: f32) -> f32:
    return UiSkia::active_measure_text_width(text, size)

extend UiSkia:
    public:
        const enum HorizontalTextAlignment of i32:
            Start = 0
            Center = 1
            End = 2

        const enum VerticalTextAlignment of i32:
            Top = 0
            Center = 1
            Bottom = 2

        # Layout uses the same Skia metric path as direct text drawing. The
        # returned ranges still borrow the caller's source view and remain
        # bounded by UiTextMeasureLayout::MAX_LINES.
        def layout_text(text: sview, max_width: f32, size: f32) -> UiTextMeasureLayout::Layout:
            return UiTextMeasureLayout::layout_with_measure(text, max_width, size, ui_skia_measure_layout_width)

        # Map a local x coordinate back to a grapheme-safe byte offset using
        # the same Skia width authority that produced the line ranges. The
        # layout is recomputed in this call so hit testing remains correct
        # after a font, scale, or text change.
        def hit_test_text_line(text: sview, max_width: f32, size: f32, line_index: usize, local_x: f32) -> usize:
            planned: UiTextMeasureLayout::Layout = UiSkia::layout_text(text, max_width, size)
            return UiTextMeasureLayout::hit_test_line(text, line_index, local_x, planned.text_size, ui_skia_measure_layout_width)

        def caret_x_text_line(text: sview, max_width: f32, size: f32, line_index: usize, byte_offset: usize) -> f32:
            planned: UiTextMeasureLayout::Layout = UiSkia::layout_text(text, max_width, size)
            return UiTextMeasureLayout::caret_x_for_line(text, line_index, byte_offset, planned.text_size, ui_skia_measure_layout_width)

        # Return the clipped rectangle occupied by a byte selection on one
        # positioned line. Layout, grapheme normalization, alignment, and
        # vertical metrics all remain in Elisa; a custom painter may choose
        # its own fill treatment for the returned geometry.
        def text_selection_rect(text: sview, box: UiCore::Rect, size: f32, line_index: usize, selection_start: usize, selection_end: usize, horizontal: UiSkia::HorizontalTextAlignment, vertical: UiSkia::VerticalTextAlignment, vertical_inset: f32) -> UiCore::Rect:
            safe_box: UiCore::Rect = UiSkia::skia_safe_rect(box)
            planned: UiTextMeasureLayout::Layout = UiSkia::layout_text(text, safe_box.size.width, size)
            return UiSkia::selection_rect_for_layout(text, planned, safe_box, line_index, selection_start, selection_end, horizontal, vertical, vertical_inset)

        # Paint all non-empty selection fragments before text. The clip scope
        # is owned by this operation, and the layout record remains available
        # to the caller for overflow/line diagnostics even when the surface is
        # unavailable or the requested range is empty.
        def fill_text_selection(text: sview, box: UiCore::Rect, size: f32, selection_start: usize, selection_end: usize, color: UiCore::Color, horizontal: UiSkia::HorizontalTextAlignment, vertical: UiSkia::VerticalTextAlignment, vertical_inset: f32) -> UiTextMeasureLayout::Layout can[Ui.Draw, Ui.Text]:
            safe_box: UiCore::Rect = UiSkia::skia_safe_rect(box)
            planned: UiTextMeasureLayout::Layout = UiSkia::layout_text(text, safe_box.size.width, size)
            return planned if canvas_state == 0 or color.a == 0
            return planned if safe_box.size.width <= 0.0 or safe_box.size.height <= 0.0
            return planned if not UiSkia::push_clip(safe_box)
            for index in 0..<planned.line_count:
                selection_box: UiCore::Rect = UiSkia::selection_rect_for_layout(text, planned, safe_box, index, selection_start, selection_end, horizontal, vertical, vertical_inset)
                UiSkia::fill_rounded_rect(selection_box, 2.0, color) if selection_box.size.width > 0.0 and selection_box.size.height > 0.0
            _ = UiSkia::pop_clip()
            return planned

        # Return the clipped rectangle for one grapheme-safe caret position.
        # Blink/visibility belongs to the caller; this helper only maps the
        # logical offset through the active Skia metrics and placement policy.
        def text_caret_rect(text: sview, box: UiCore::Rect, size: f32, line_index: usize, byte_offset: usize, horizontal: UiSkia::HorizontalTextAlignment, vertical: UiSkia::VerticalTextAlignment, caret_width: f32, vertical_inset: f32) -> UiCore::Rect:
            safe_box: UiCore::Rect = UiSkia::skia_safe_rect(box)
            planned: UiTextMeasureLayout::Layout = UiSkia::layout_text(text, safe_box.size.width, size)
            return UiSkia::caret_rect_for_layout(text, planned, safe_box, line_index, byte_offset, horizontal, vertical, caret_width, vertical_inset)

        # Paint one caret inside a temporary clip. The caller can use the same
        # layout record for text and selection, keeping blink state outside the
        # renderer and avoiding any native text-field object.
        def draw_text_caret(text: sview, box: UiCore::Rect, size: f32, line_index: usize, byte_offset: usize, color: UiCore::Color, horizontal: UiSkia::HorizontalTextAlignment, vertical: UiSkia::VerticalTextAlignment, caret_width: f32, vertical_inset: f32) -> UiTextMeasureLayout::Layout can[Ui.Draw, Ui.Text]:
            safe_box: UiCore::Rect = UiSkia::skia_safe_rect(box)
            planned: UiTextMeasureLayout::Layout = UiSkia::layout_text(text, safe_box.size.width, size)
            return planned if canvas_state == 0 or color.a == 0
            return planned if safe_box.size.width <= 0.0 or safe_box.size.height <= 0.0
            return planned if not UiSkia::push_clip(safe_box)
            caret_box: UiCore::Rect = UiSkia::caret_rect_for_layout(text, planned, safe_box, line_index, byte_offset, horizontal, vertical, caret_width, vertical_inset)
            if caret_box.size.width > 0.0 and caret_box.size.height > 0.0:
                UiSkia::fill_rounded_rect(caret_box, caret_box.size.width * 0.5, color)
            _ = UiSkia::pop_clip()
            return planned

        # Resource-bound variants scope the exact ready typeface for both
        # metric queries and paint. A loading/disposed generation returns an
        # empty layout without crossing the canvas boundary.
        def fill_bound_text_selection(resource: UiResources::ResourceHandle, text: sview, box: UiCore::Rect, size: f32, selection_start: usize, selection_end: usize, color: UiCore::Color, horizontal: UiSkia::HorizontalTextAlignment, vertical: UiSkia::VerticalTextAlignment, vertical_inset: f32) -> UiTextMeasureLayout::Layout can[Ui.Draw, Ui.Text]:
            _ = UiSkia::prune_bindings()
            return UiSkia::empty_text_layout(text, box.size.width, size) if UiResources::state(resource) != UiResources::State.Ready
            index: usize = UiSkia::font_binding_index(resource)
            return UiSkia::empty_text_layout(text, box.size.width, size) if index >= UiSkia::MAX_FONT_BINDINGS
            previous_font: usize = skia_frame_font
            skia_frame_font <- skia_font_binding_fonts[index]
            planned: UiTextMeasureLayout::Layout = UiSkia::fill_text_selection(text, box, size, selection_start, selection_end, color, horizontal, vertical, vertical_inset)
            skia_frame_font <- previous_font
            return planned

        def fill_bound_text_selection_with_fallback(primary: UiResources::ResourceHandle, fallback: UiResources::ResourceHandle, text: sview, box: UiCore::Rect, size: f32, selection_start: usize, selection_end: usize, color: UiCore::Color, horizontal: UiSkia::HorizontalTextAlignment, vertical: UiSkia::VerticalTextAlignment, vertical_inset: f32) -> UiTextMeasureLayout::Layout can[Ui.Draw, Ui.Text]:
            font: usize = UiSkia::bound_font_handle(primary, fallback)
            return UiSkia::empty_text_layout(text, box.size.width, size) if font == 0
            previous_font: usize = skia_frame_font
            skia_frame_font <- font
            planned: UiTextMeasureLayout::Layout = UiSkia::fill_text_selection(text, box, size, selection_start, selection_end, color, horizontal, vertical, vertical_inset)
            skia_frame_font <- previous_font
            return planned

        def draw_bound_text_caret(resource: UiResources::ResourceHandle, text: sview, box: UiCore::Rect, size: f32, line_index: usize, byte_offset: usize, color: UiCore::Color, horizontal: UiSkia::HorizontalTextAlignment, vertical: UiSkia::VerticalTextAlignment, caret_width: f32, vertical_inset: f32) -> UiTextMeasureLayout::Layout can[Ui.Draw, Ui.Text]:
            _ = UiSkia::prune_bindings()
            return UiSkia::empty_text_layout(text, box.size.width, size) if UiResources::state(resource) != UiResources::State.Ready
            index: usize = UiSkia::font_binding_index(resource)
            return UiSkia::empty_text_layout(text, box.size.width, size) if index >= UiSkia::MAX_FONT_BINDINGS
            previous_font: usize = skia_frame_font
            skia_frame_font <- skia_font_binding_fonts[index]
            planned: UiTextMeasureLayout::Layout = UiSkia::draw_text_caret(text, box, size, line_index, byte_offset, color, horizontal, vertical, caret_width, vertical_inset)
            skia_frame_font <- previous_font
            return planned

        def draw_bound_text_caret_with_fallback(primary: UiResources::ResourceHandle, fallback: UiResources::ResourceHandle, text: sview, box: UiCore::Rect, size: f32, line_index: usize, byte_offset: usize, color: UiCore::Color, horizontal: UiSkia::HorizontalTextAlignment, vertical: UiSkia::VerticalTextAlignment, caret_width: f32, vertical_inset: f32) -> UiTextMeasureLayout::Layout can[Ui.Draw, Ui.Text]:
            font: usize = UiSkia::bound_font_handle(primary, fallback)
            return UiSkia::empty_text_layout(text, box.size.width, size) if font == 0
            previous_font: usize = skia_frame_font
            skia_frame_font <- font
            planned: UiTextMeasureLayout::Layout = UiSkia::draw_text_caret(text, box, size, line_index, byte_offset, color, horizontal, vertical, caret_width, vertical_inset)
            skia_frame_font <- previous_font
            return planned

        # A bound logical font keeps measurement and replay on one generation
        # without exposing its borrowed SkTypeface to the caller. The frame
        # font slot is restored even when a control nests another text scope.
        def layout_bound_text(resource: UiResources::ResourceHandle, text: sview, max_width: f32, size: f32) -> UiTextMeasureLayout::Layout:
            _ = UiSkia::prune_bindings()
            return UiSkia::empty_text_layout(text, max_width, size) if UiResources::state(resource) != UiResources::State.Ready
            index: usize = UiSkia::font_binding_index(resource)
            return UiSkia::empty_text_layout(text, max_width, size) if index >= UiSkia::MAX_FONT_BINDINGS
            previous_font: usize = skia_frame_font
            skia_frame_font <- skia_font_binding_fonts[index]
            planned: UiTextMeasureLayout::Layout = UiSkia::layout_text(text, max_width, size)
            skia_frame_font <- previous_font
            return planned

        def layout_bound_text_with_fallback(primary: UiResources::ResourceHandle, fallback: UiResources::ResourceHandle, text: sview, max_width: f32, size: f32) -> UiTextMeasureLayout::Layout:
            font: usize = UiSkia::bound_font_handle(primary, fallback)
            return UiSkia::empty_text_layout(text, max_width, size) if font == 0
            previous_font: usize = skia_frame_font
            skia_frame_font <- font
            planned: UiTextMeasureLayout::Layout = UiSkia::layout_text(text, max_width, size)
            skia_frame_font <- previous_font
            return planned

        def draw_text_block(text: sview, box: UiCore::Rect, size: f32, color: UiCore::Color) -> UiTextMeasureLayout::Layout can[Ui.Draw, Ui.Text]:
            return UiSkia::draw_text_block_aligned(text, box, size, color, UiSkia::HorizontalTextAlignment.Start)

        # Draw a wrapped text block directly into a bounded rectangle. Layout
        # happens first, so a caller can inspect overflow even when the canvas
        # is unavailable or the clip scope is rejected. Text remains borrowed
        # from the caller; each line crosses the narrow FFI exactly once.
        def draw_text_block_aligned(text: sview, box: UiCore::Rect, size: f32, color: UiCore::Color, alignment: UiSkia::HorizontalTextAlignment) -> UiTextMeasureLayout::Layout can[Ui.Draw, Ui.Text]:
            return UiSkia::draw_text_block_positioned(text, box, size, color, alignment, UiSkia::VerticalTextAlignment.Top)

        def draw_text_block_positioned(text: sview, box: UiCore::Rect, size: f32, color: UiCore::Color, horizontal: UiSkia::HorizontalTextAlignment, vertical: UiSkia::VerticalTextAlignment) -> UiTextMeasureLayout::Layout can[Ui.Draw, Ui.Text]:
            safe_box: UiCore::Rect = UiSkia::skia_safe_rect(box)
            planned: UiTextMeasureLayout::Layout = UiSkia::layout_text(text, safe_box.size.width, size)
            return planned if canvas_state == 0 or color.a == 0
            return planned if safe_box.size.width <= 0.0 or safe_box.size.height <= 0.0
            return planned if not UiSkia::push_clip(safe_box)
            ascent: f32 = UiCore::bounded_extent(UiSkia::active_font_ascent(planned.text_size))
            line_step: mutable f32 = UiCore::bounded_extent(UiSkia::active_text_line_height(planned.text_size))
            line_step <- planned.text_size if line_step <= 0.0
            first_baseline: f32 = UiSkia::aligned_text_baseline(safe_box, ascent, line_step, planned.line_count, vertical)
            for index in 0..<planned.line_count:
                line: sview = UiTextMeasureLayout::line_view(text, index)
                continue if line.len <= 0
                line_y: f32 = UiCore::bounded_coordinate(first_baseline + line_step * index.f32())
                continue if line_y + line_step < safe_box.origin.y
                continue if line_y - ascent > UiCore::bottom_edge(safe_box)
                line_width: f32 = UiTextMeasureLayout::line_at(index).width
                line_x: f32 = UiSkia::aligned_text_origin(safe_box, line_width, horizontal)
                UiSkia::draw_text_run(UiCore::TextRun(UiCore::Vec2(line_x, line_y), planned.text_size, line), color)
            _ = UiSkia::pop_clip()
            return planned

        def draw_bound_text_block(resource: UiResources::ResourceHandle, text: sview, box: UiCore::Rect, size: f32, color: UiCore::Color, horizontal: UiSkia::HorizontalTextAlignment, vertical: UiSkia::VerticalTextAlignment) -> UiTextMeasureLayout::Layout can[Ui.Draw, Ui.Text]:
            _ = UiSkia::prune_bindings()
            return UiSkia::empty_text_layout(text, box.size.width, size) if UiResources::state(resource) != UiResources::State.Ready
            index: usize = UiSkia::font_binding_index(resource)
            return UiSkia::empty_text_layout(text, box.size.width, size) if index >= UiSkia::MAX_FONT_BINDINGS
            previous_font: usize = skia_frame_font
            skia_frame_font <- skia_font_binding_fonts[index]
            planned: UiTextMeasureLayout::Layout = UiSkia::draw_text_block_positioned(text, box, size, color, horizontal, vertical)
            skia_frame_font <- previous_font
            return planned

        def draw_bound_text_block_with_fallback(primary: UiResources::ResourceHandle, fallback: UiResources::ResourceHandle, text: sview, box: UiCore::Rect, size: f32, color: UiCore::Color, horizontal: UiSkia::HorizontalTextAlignment, vertical: UiSkia::VerticalTextAlignment) -> UiTextMeasureLayout::Layout can[Ui.Draw, Ui.Text]:
            font: usize = UiSkia::bound_font_handle(primary, fallback)
            return UiSkia::empty_text_layout(text, box.size.width, size) if font == 0
            previous_font: usize = skia_frame_font
            skia_frame_font <- font
            planned: UiTextMeasureLayout::Layout = UiSkia::draw_text_block_positioned(text, box, size, color, horizontal, vertical)
            skia_frame_font <- previous_font
            return planned

        def aligned_text_origin(box: UiCore::Rect, line_width: f32, alignment: UiSkia::HorizontalTextAlignment) -> f32:
            safe_box: UiCore::Rect = UiSkia::skia_safe_rect(box)
            safe_line_width: f32 = UiCore::bounded_extent(line_width)
            remaining: mutable f32 = safe_box.size.width - safe_line_width
            remaining <- 0.0 if remaining < 0.0
            offset: mutable f32 = 0.0
            offset <- remaining * 0.5 if alignment == UiSkia::HorizontalTextAlignment.Center
            offset <- remaining if alignment == UiSkia::HorizontalTextAlignment.End
            return UiCore::bounded_coordinate(safe_box.origin.x + offset)

        def aligned_text_baseline(box: UiCore::Rect, ascent: f32, line_step: f32, line_count: usize, alignment: UiSkia::VerticalTextAlignment) -> f32:
            safe_box: UiCore::Rect = UiSkia::skia_safe_rect(box)
            safe_ascent: f32 = UiCore::bounded_extent(ascent)
            safe_step: mutable f32 = UiCore::bounded_extent(line_step)
            safe_step <- 1.0 if safe_step <= 0.0
            lines: f32 = line_count.f32()
            content_height: f32 = UiCore::bounded_extent(safe_step * lines)
            remaining: mutable f32 = safe_box.size.height - content_height
            remaining <- 0.0 if remaining < 0.0
            offset: mutable f32 = 0.0
            offset <- remaining * 0.5 if alignment == UiSkia::VerticalTextAlignment.Center
            offset <- remaining if alignment == UiSkia::VerticalTextAlignment.Bottom
            return UiCore::bounded_coordinate(safe_box.origin.y + offset + safe_ascent)

        def empty_text_layout(text: sview, max_width: f32, size: f32) -> UiTextMeasureLayout::Layout:
            return UiTextMeasureLayout::empty_layout(text, max_width, size)

    private:
        def caret_rect_for_layout(text: sview, planned: UiTextMeasureLayout::Layout, safe_box: UiCore::Rect, line_index: usize, byte_offset: usize, horizontal: UiSkia::HorizontalTextAlignment, vertical: UiSkia::VerticalTextAlignment, caret_width: f32, vertical_inset: f32) -> UiCore::Rect:
            empty: UiCore::Rect = UiCore::Rect(0.0, 0.0, 0.0, 0.0)
            return empty if line_index >= planned.line_count
            ascent: f32 = UiCore::bounded_extent(UiSkia::active_font_ascent(planned.text_size))
            line_step: mutable f32 = UiCore::bounded_extent(UiSkia::active_text_line_height(planned.text_size))
            line_step <- planned.text_size if line_step <= 0.0
            first_baseline: f32 = UiSkia::aligned_text_baseline(safe_box, ascent, line_step, planned.line_count, vertical)
            line_width: f32 = UiTextMeasureLayout::line_at(line_index).width
            line_x: f32 = UiSkia::aligned_text_origin(safe_box, line_width, horizontal)
            local_x: f32 = UiTextMeasureLayout::caret_x_for_line(text, line_index, byte_offset, planned.text_size, ui_skia_measure_layout_width)
            raw_x: f32 = UiCore::bounded_coordinate(line_x + local_x)
            left_edge: f32 = safe_box.origin.x
            right_edge: f32 = UiCore::right_edge(safe_box)
            safe_width: mutable f32 = UiCore::bounded_extent(caret_width)
            safe_width <- 1.0 if safe_width <= 0.0
            safe_width <- safe_box.size.width if safe_width > safe_box.size.width else safe_width
            return empty if safe_width <= 0.0
            clipped_x: mutable f32 = raw_x if raw_x >= left_edge else left_edge
            clipped_x <- right_edge - safe_width if clipped_x + safe_width > right_edge else clipped_x
            clipped_x <- left_edge if clipped_x < left_edge else clipped_x
            safe_inset: mutable f32 = UiCore::bounded_extent(vertical_inset)
            maximum_inset: f32 = line_step * 0.5
            safe_inset <- maximum_inset if safe_inset > maximum_inset
            line_top: f32 = UiCore::bounded_coordinate(first_baseline + line_step * line_index.f32() - ascent)
            line_height: f32 = line_step - safe_inset * 2.0 if line_step > safe_inset * 2.0 else 0.0
            return UiCore::Rect(clipped_x, line_top + safe_inset, safe_width, UiCore::bounded_extent(line_height))

        def selection_rect_for_layout(text: sview, planned: UiTextMeasureLayout::Layout, safe_box: UiCore::Rect, line_index: usize, selection_start: usize, selection_end: usize, horizontal: UiSkia::HorizontalTextAlignment, vertical: UiSkia::VerticalTextAlignment, vertical_inset: f32) -> UiCore::Rect:
            empty: UiCore::Rect = UiCore::Rect(0.0, 0.0, 0.0, 0.0)
            return empty if line_index >= planned.line_count
            geometry: UiTextMeasureLayout::SelectionRange = UiTextMeasureLayout::selection_for_line(text, line_index, selection_start, selection_end, planned.text_size, ui_skia_measure_layout_width)
            return empty if geometry.width <= 0.0
            ascent: f32 = UiCore::bounded_extent(UiSkia::active_font_ascent(planned.text_size))
            line_step: mutable f32 = UiCore::bounded_extent(UiSkia::active_text_line_height(planned.text_size))
            line_step <- planned.text_size if line_step <= 0.0
            first_baseline: f32 = UiSkia::aligned_text_baseline(safe_box, ascent, line_step, planned.line_count, vertical)
            line_width: f32 = UiTextMeasureLayout::line_at(line_index).width
            line_x: f32 = UiSkia::aligned_text_origin(safe_box, line_width, horizontal)
            raw_left: f32 = UiCore::bounded_coordinate(line_x + geometry.x)
            raw_right: f32 = UiCore::bounded_coordinate(raw_left + geometry.width)
            left_edge: f32 = safe_box.origin.x
            right_edge: f32 = UiCore::right_edge(safe_box)
            clipped_left: f32 = raw_left if raw_left > left_edge else left_edge
            clipped_right: f32 = raw_right if raw_right < right_edge else right_edge
            clipped_width: f32 = clipped_right - clipped_left if clipped_right > clipped_left else 0.0
            safe_inset: mutable f32 = UiCore::bounded_extent(vertical_inset)
            maximum_inset: f32 = line_step * 0.5
            safe_inset <- maximum_inset if safe_inset > maximum_inset
            line_top: f32 = UiCore::bounded_coordinate(first_baseline + line_step * line_index.f32() - ascent)
            line_height: f32 = line_step - safe_inset * 2.0 if line_step > safe_inset * 2.0 else 0.0
            return UiCore::Rect(clipped_left, line_top + safe_inset, clipped_width, UiCore::bounded_extent(line_height))
