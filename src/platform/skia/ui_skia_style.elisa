# Elisa-owned visual constants for Skia primitives.
#
# The bridge must not invent appearance defaults. Keep the custom renderer's
# shadow treatment beside the shared rounded-rectangle style and pass every
# effect parameter explicitly through the narrow FFI.

extend UiSkia:
    private:
        const SHADOW_OFFSET_X: f32 = 0.0
        const SHADOW_OFFSET_Y: f32 = 2.0
        const SHADOW_BLUR: f32 = 5.0
        const HAIRLINE_WIDTH: f32 = 1.0

        def draw_shadow(box: UiCore::Rect, radius: f32, alpha: u8) -> void can[Ui.Draw]:
            return if canvas_state == 0 or alpha == 0
            elisa_skia_canvas_shadow_round_rect(
                canvas_state,
                box.origin.x, box.origin.y,
                box.size.width, box.size.height,
                radius,
                SHADOW_OFFSET_X, SHADOW_OFFSET_Y, SHADOW_BLUR,
                alpha)

        def draw_outline(box: UiCore::Rect, radius: f32, alpha: u8) -> void can[Ui.Draw]:
            return if canvas_state == 0 or alpha == 0
            elisa_skia_canvas_stroke_round_rect(
                canvas_state,
                box.origin.x, box.origin.y,
                box.size.width, box.size.height,
                radius, HAIRLINE_WIDTH,
                255, 255, 255, alpha)

        def draw_line(segment: UiCore::Line, color: UiCore::Color) -> void can[Ui.Draw]:
            return if canvas_state == 0 or color.a == 0
            elisa_skia_canvas_fill_line(
                canvas_state,
                segment.from_point.x, segment.from_point.y,
                segment.to_point.x, segment.to_point.y,
                HAIRLINE_WIDTH,
                color.r, color.g, color.b, color.a)
