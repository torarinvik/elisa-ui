# Elisa-owned visual constants for Skia primitives.
#
# The bridge must not invent appearance defaults. Keep the custom renderer's
# shadow treatment beside the shared rounded-rectangle style and pass every
# effect parameter explicitly through the narrow FFI.

include "../../widgets/ui_theme.elisa"

extend UiSkia:
    public:
        # Apply the shared theme radius to a custom surface while retaining
        # Skia's existing explicit shadow/fill/outline primitives.
        def fill_themed_surface(box: UiCore::Rect, color: UiCore::Color, elevated: bool, metrics: UiTheme::Metrics) -> void can[Ui.Draw]:
            return if UiSkia::canvas_state == 0 or color.a == 0
            safe_box: UiCore::Rect = UiSkia::skia_safe_rect(box)
            return if safe_box.size.width <= 0.0 or safe_box.size.height <= 0.0
            depth: UiCore::SurfaceDepth = UiCore::SurfaceDepth.Raised if elevated else UiCore::SurfaceDepth.Flat
            style: UiPaint::RoundedRectStyle = UiPaint::rounded_rect_style_for_with_radius(safe_box, depth, metrics.corner_radius, color)
            UiSkia::draw_elevated_surface(safe_box, style, color)

        def fill_current_themed_surface(box: UiCore::Rect, color: UiCore::Color, elevated: bool, system_high_contrast: bool) -> void can[Ui.Draw]:
            metrics: UiTheme::Metrics = UiTheme::scaled_metrics(UiTheme::current_preferences(), system_high_contrast)
            UiSkia::fill_themed_surface(box, color, elevated, metrics)

        # One rounded surface, painted the way UiPaint says to light it: the
        # shadow it casts, its own fill, the sheen across it, and the rim.
        #
        # The ORDER is the whole thing. Shadow first, because it belongs under
        # the surface; sheen over the fill, because it is light falling ON the
        # surface rather than part of its colour; rim last, because an edge that
        # anything else paints over stops being an edge.
        def draw_elevated_surface(box: UiCore::Rect, style: UiPaint::RoundedRectStyle, color: UiCore::Color) -> void can[Ui.Draw]:
            UiSkia::draw_styled_surface(box, style, color, UiCore::surface_style(UiCore::SurfaceDepth.Flat))

        # ...and the same surface with the application's own paint record: a
        # ramp across the fill and a light around it. Both are opt-in and a
        # zeroed record has neither, which is why the call above is the whole
        # of the old behaviour.
        def draw_styled_surface(box: UiCore::Rect, style: UiPaint::RoundedRectStyle, color: UiCore::Color, surface: UiCore::SurfaceStyle) -> void can[Ui.Draw]:
            # Glass comes FIRST, before even the shadow: it is a change to what
            # is already on the canvas, and everything below is drawn on top of
            # the result. The shadow lands outside the blurred region anyway,
            # which is why the two do not fight.
            UiSkia::blur_behind_rounded_rect(box, style.radius, style.backdrop_blur) if UiPaint::has_backdrop_blur(style)
            # Contact before ambient. Two translucent blacks composite to the
            # same result either way, and this order leaves the ambient layer
            # as the last shadow the backend was asked for, which is the one a
            # painter fixture reads back.
            # The glow goes under the shadows and over the glass: it is light
            # spilling around the object, so it belongs outside the object and
            # beneath everything the object itself puts down.
            UiSkia::draw_glow(box, style, surface.glow) if UiCore::has_glow(surface)
            UiSkia::draw_shadow(box, UiPaint::contact_shadow(style)) if UiPaint::has_contact_shadow(style)
            UiSkia::draw_shadow(box, style)
            if UiCore::has_gradient(surface):
                UiSkia::fill_rounded_gradient(box, style.radius, color, surface.gradient, surface.gradient_horizontal)
            else:
                UiSkia::fill_rounded_rect(box, style.radius, color)
            UiSkia::draw_sheen(box, style)
            UiSkia::draw_outline(box, style)

        # A DISC is a rounded rectangle whose corner is its own radius.
        #
        # That identity is what lets a raised thumb reuse the whole surface
        # treatment -- shadow, fill, sheen, rim -- without one new primitive in
        # any backend. A slider thumb is the one control that is unambiguously
        # ON the surface rather than part of it, and it was the last thing in
        # the framework still painted as a flat disc of colour.
        def fill_disc(disc: UiCore::Circle, color: UiCore::Color, depth: UiCore::SurfaceDepth) -> void can[Ui.Draw]:
            return if UiSkia::canvas_state == 0 or color.a == 0 or disc.radius <= 0.0
            if depth == UiCore::SurfaceDepth.Flat:
                UiSkia::fill_circle(disc, color)
                return
            box: UiCore::Rect = disc_bounds(disc)
            style: UiPaint::RoundedRectStyle = UiPaint::rounded_rect_style_for_with_radius(box, depth, disc.radius, color)
            UiSkia::draw_elevated_surface(box, style, color)

    private:
        def disc_bounds(disc: UiCore::Circle) -> UiCore::Rect:
            return UiCore::Rect(disc.center.x - disc.radius, disc.center.y - disc.radius, disc.radius * 2.0, disc.radius * 2.0)

        # One primitive, two meanings: see UiPaint::glow_shadow.
        def draw_glow(box: UiCore::Rect, style: UiPaint::RoundedRectStyle, glow: UiCore::Color) -> void can[Ui.Draw]:
            lit: UiPaint::RoundedRectStyle = UiPaint::glow_shadow(style, box)
            UiSkia::draw_shadow_rounded_rect_with_color(
                box, lit.radius, lit.shadow_offset_x, lit.shadow_offset_y, lit.shadow_blur, glow)

        def draw_shadow(box: UiCore::Rect, style: UiPaint::RoundedRectStyle) -> void can[Ui.Draw]:
            alpha: u8 = style.shadow_alpha
            UiSkia::draw_shadow_rounded_rect(
                box, style.radius, style.shadow_offset_x, style.shadow_offset_y,
                style.shadow_blur, alpha)

        # Light across the face, strongest at the top. The tint and the two
        # alphas come from UiPaint, so the CoreGraphics painters draw the
        # identical wash from the identical record.
        def draw_sheen(box: UiCore::Rect, style: UiPaint::RoundedRectStyle) -> void can[Ui.Draw]:
            return if not UiPaint::has_sheen(style)
            UiSkia::fill_rounded_gradient(
                box, style.radius,
                UiPaint::sheen_near_color(style), UiPaint::sheen_far_color(style), false)

        # The outline and the rim light are ONE stroke.
        #
        # They used to be two ideas and only one of them existed: a uniform
        # white hairline all the way round, which defines the shape but says
        # nothing about where the light is. A single stroke that runs from the
        # bevel alpha at the top to the hairline alpha at the bottom does both,
        # and cannot double up on the top edge the way two strokes would.
        def draw_outline(box: UiCore::Rect, style: UiPaint::RoundedRectStyle) -> void can[Ui.Draw]:
            UiSkia::stroke_rounded_gradient(
                box, style.radius, style.hairline_width,
                UiPaint::rim_near_color(style), UiPaint::rim_far_color(style), false)
