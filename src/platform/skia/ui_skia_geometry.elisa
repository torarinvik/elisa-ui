# Private geometry policy for the Skia painter.
#
# Core commands are already normalized when they enter the retained arena, but
# custom controls can call the direct UiSkia methods too. Keep that second path
# equally defensive without making the C++ bridge repeat framework policy.

include "../../core/ui_core.elisa"

extend UiSkia:
    private:
        def skia_safe_rect(box: UiCore::Rect) -> UiCore::Rect:
            safe_x: f32 = UiCore::bounded_coordinate(box.origin.x)
            safe_y: f32 = UiCore::bounded_coordinate(box.origin.y)
            safe_width: mutable f32 = UiCore::bounded_extent(box.size.width)
            safe_height: mutable f32 = UiCore::bounded_extent(box.size.height)
            # A bounded origin and extent can still overflow the shared
            # coordinate envelope when the box starts near its positive edge.
            # Clamp the extent before constructing the Skia rect so the native
            # bridge never has to reason about a derived far edge.
            width_room: f32 = UiCore::MAX_GEOMETRY_EXTENT - safe_x if safe_x > 0.0 else UiCore::MAX_GEOMETRY_EXTENT
            height_room: f32 = UiCore::MAX_GEOMETRY_EXTENT - safe_y if safe_y > 0.0 else UiCore::MAX_GEOMETRY_EXTENT
            safe_width <- width_room if safe_width > width_room else safe_width
            safe_height <- height_room if safe_height > height_room else safe_height
            return UiCore::Rect(safe_x, safe_y, safe_width, safe_height)

        # Image source rectangles are pixel-space regions rather than logical
        # layout boxes. Origins cannot be negative, but they use the same
        # finite envelope and extent cap before reaching Skia.
        def skia_safe_source_rect(source: UiCore::Rect) -> UiCore::Rect:
            safe_x: f32 = UiCore::bounded_extent(source.origin.x)
            safe_y: f32 = UiCore::bounded_extent(source.origin.y)
            safe_width: mutable f32 = UiCore::bounded_extent(source.size.width)
            safe_height: mutable f32 = UiCore::bounded_extent(source.size.height)
            width_room: f32 = UiCore::MAX_GEOMETRY_EXTENT - safe_x
            height_room: f32 = UiCore::MAX_GEOMETRY_EXTENT - safe_y
            safe_width <- width_room if safe_width > width_room else safe_width
            safe_height <- height_room if safe_height > height_room else safe_height
            return UiCore::Rect(safe_x, safe_y, safe_width, safe_height)

        # A ready logical image may publish verified decoded dimensions. Use
        # them to keep generation-bound crops inside the actual image while
        # retaining the envelope-only policy for resources without metadata.
        def skia_safe_source_rect_for_size(source: UiCore::Rect, intrinsic: UiCore::Size) -> UiCore::Rect:
            safe: UiCore::Rect = UiSkia::skia_safe_source_rect(source)
            limit_width: f32 = UiCore::bounded_extent(intrinsic.width)
            limit_height: f32 = UiCore::bounded_extent(intrinsic.height)
            return safe if limit_width <= 0.0 or limit_height <= 0.0
            safe_x: mutable f32 = safe.origin.x
            safe_y: mutable f32 = safe.origin.y
            safe_x <- limit_width if safe_x > limit_width
            safe_y <- limit_height if safe_y > limit_height
            remaining_width: f32 = limit_width - safe_x
            remaining_height: f32 = limit_height - safe_y
            safe_width: mutable f32 = safe.size.width
            safe_height: mutable f32 = safe.size.height
            safe_width <- remaining_width if safe_width > remaining_width else safe_width
            safe_height <- remaining_height if safe_height > remaining_height else safe_height
            return UiCore::Rect(safe_x, safe_y, safe_width, safe_height)

        def skia_safe_radius(box: UiCore::Rect, radius: f32) -> f32:
            safe_radius: mutable f32 = UiCore::bounded_extent(radius)
            shortest: f32 = box.size.width if box.size.width < box.size.height else box.size.height
            maximum: f32 = UiCore::bounded_extent(shortest * 0.5)
            safe_radius <- maximum if safe_radius > maximum else safe_radius
            return safe_radius

        def skia_safe_circle(disc: UiCore::Circle) -> UiCore::Circle:
            return UiSkia::skia_safe_circle_with_stroke(disc, 0.0)

        def skia_safe_circle_with_stroke(disc: UiCore::Circle, stroke_width: f32) -> UiCore::Circle:
            safe_x: f32 = UiCore::bounded_coordinate(disc.center.x)
            safe_y: f32 = UiCore::bounded_coordinate(disc.center.y)
            safe_radius: mutable f32 = UiCore::bounded_extent(disc.radius)
            safe_stroke: f32 = UiCore::bounded_extent(stroke_width)
            horizontal_room: f32 = UiCore::MAX_GEOMETRY_EXTENT - safe_x if safe_x >= 0.0 else UiCore::MAX_GEOMETRY_EXTENT + safe_x
            vertical_room: f32 = UiCore::MAX_GEOMETRY_EXTENT - safe_y if safe_y >= 0.0 else UiCore::MAX_GEOMETRY_EXTENT + safe_y
            radius_room: mutable f32 = horizontal_room if horizontal_room < vertical_room else vertical_room
            radius_room <- radius_room - safe_stroke * 0.5
            radius_room <- 0.0 if radius_room < 0.0
            safe_radius <- radius_room if safe_radius > radius_room else safe_radius
            return UiCore::Circle{
                center: UiCore::Vec2(safe_x, safe_y),
                radius: safe_radius}

        def skia_safe_triangle(tri: UiCore::Triangle) -> UiCore::Triangle:
            return UiCore::Triangle{
                a: UiCore::Vec2(UiCore::bounded_coordinate(tri.a.x), UiCore::bounded_coordinate(tri.a.y)),
                b: UiCore::Vec2(UiCore::bounded_coordinate(tri.b.x), UiCore::bounded_coordinate(tri.b.y)),
                c: UiCore::Vec2(UiCore::bounded_coordinate(tri.c.x), UiCore::bounded_coordinate(tri.c.y))}

        def skia_safe_line(segment: UiCore::Line) -> UiCore::Line:
            return UiCore::Line{
                from_point: UiCore::Vec2(UiCore::bounded_coordinate(segment.from_point.x), UiCore::bounded_coordinate(segment.from_point.y)),
                to_point: UiCore::Vec2(UiCore::bounded_coordinate(segment.to_point.x), UiCore::bounded_coordinate(segment.to_point.y))}
