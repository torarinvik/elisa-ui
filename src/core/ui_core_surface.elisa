# How a surface sits relative to what is behind it.
#
# Its own file rather than a member of ui_core_types: depth is a PAINTING fact,
# consumed by the shared style policy in ui_paint.elisa and by every custom
# backend, while the types file is the geometry and event vocabulary the whole
# framework is written against.

extend UiCore:
    public:
        # Raised and Inset are not two shadows -- they are opposite lighting. A
        # raised surface catches light on its top edge and drops a shadow below;
        # a recessed one (a text field, a slider track, a well) is lit along its
        # BOTTOM edge and shaded at the top, because the light still comes from
        # above and the near wall is now the far one. Painting a field with the
        # raised treatment is the single most common way a UI looks almost right
        # and slightly wrong.
        const enum SurfaceDepth of i32:
            Flat = 0
            Raised = 1
            Inset = 2

        # WHAT A SURFACE IS, when its size does not say.
        #
        # The corner policy in ui_paint.elisa derives a radius from the box,
        # and it is a good default precisely because it is derived: every
        # surface in a frame stays consistent with every other without an
        # application naming a pixel value that stops being right at the next
        # text scale.
        #
        # But shape is also a statement about KIND, and two surfaces of the
        # same size can be different kinds. A tag, a status chip and a count
        # badge are capsules at a size where the derived policy -- which asks
        # whether a box is a BAR, long AND thin -- correctly says "not a bar"
        # and rounds them like a small card. That is not a flaw in the policy;
        # it is a fact the policy cannot know. An image filling the head of a
        # card is the same story from the other side: it wants the card's
        # corners at the top and none at the bottom, and by itself it is just
        # a rectangle.
        #
        # Three values rather than a radius, deliberately. A number invites an
        # application to hardcode 8.0 and drift away from the rest of the
        # frame; a kind stays right when the metrics change under it.
        const enum CornerStyle of i32:
            # The derived policy: a capsule for a bar, proportional otherwise.
            Automatic = 0
            # Always a capsule, whatever the proportions.
            Pill = 1
            # No rounding at all.
            Square = 2

        # EVERYTHING ABOUT HOW A SURFACE IS PAINTED that is not its box or its
        # base colour, in one record.
        #
        # It began as a single `depth` argument, then grew a `corner` beside
        # it, and the next two attributes would have made `fill_rect` a
        # six-argument call that every backend has to thread. A record is the
        # honest shape: these are facts about ONE surface, they travel
        # together, and a painter that ignores three of them ignores them by
        # name rather than by position.
        #
        # It rides side-band, like the depth alone used to. The command
        # PAYLOAD is unchanged, so a wire backend that never learns about any
        # of this keeps decoding the same rectangles it always did.
        struct SurfaceStyle:
            depth: SurfaceDepth
            corner: CornerStyle
            # The far end of a linear ramp across the fill. Alpha 0 means a
            # flat fill, which is why every existing call site needed no
            # change: a zeroed record is the old behaviour exactly.
            #
            # A ramp is not a decoration here. Every raised, tinted or
            # accented surface in a current interface is one, and a framework
            # that can only fill flat colour cannot draw one however good its
            # shadows are.
            gradient: Color
            gradient_horizontal: bool
            # An outer light in the surface's own colour. NOT the shadow: a
            # shadow says how high something is, a glow says it is ON -- the
            # selected item, the primary action, the live indicator. They are
            # drawn by the same primitive and mean opposite things, so they
            # are two fields rather than one tinted one.
            glow: Color

        # The record every existing fill emits: a flat surface at the depth it
        # asked for, derived corners, no ramp and no light.
        def surface_style(depth: SurfaceDepth) -> SurfaceStyle:
            return SurfaceStyle{
                depth,
                corner: CornerStyle.Automatic,
                gradient: Color{r: 0, g: 0, b: 0, a: 0},
                gradient_horizontal: false,
                glow: Color{r: 0, g: 0, b: 0, a: 0},
            }

        def has_gradient(style: SurfaceStyle) -> bool:
            return style.gradient.a != 0

        def has_glow(style: SurfaceStyle) -> bool:
            return style.glow.a != 0
