# UiCore semantic-node construction and boundary sanitization.

extend UiCore:
    public:
        # Compatibility builder for ordinary controls. Metadata-aware callers
        # can use `accessibility_with_metadata`; keeping this signature stable
        # avoids forcing every existing widget to learn relationship/range
        # details before it needs them.
        def accessibility(role: AccessibilityRole, label: sview, help: sview, frame: Rect, id: usize, action: usize, enabled: bool, focused: bool, selected: bool, value: f32, text_value: sview, selected_text: sview, revision: usize, selection_location: usize, selection_length: usize) -> void:
            accessibility_with_metadata(role, label, help, frame, id, action,
                enabled, focused, selected, value, text_value, selected_text,
                revision, selection_location, selection_length,
                MAX_ACCESSIBILITY_NODES, MAX_ACCESSIBILITY_NODES,
                MAX_ACCESSIBILITY_NODES, 0.0, 1.0, false)

        # Build one portable semantic node with optional tree relationships and
        # a numeric range. IDs are bounded before storage so a malformed host
        # cannot make an adapter chase an arbitrary pointer-sized value.
        def accessibility_with_metadata(role: AccessibilityRole, label: sview, help: sview, frame: Rect, id: usize, action: usize, enabled: bool, focused: bool, selected: bool, value: f32, text_value: sview, selected_text: sview, revision: usize, selection_location: usize, selection_length: usize, parent_id: usize, first_child_id: usize, next_sibling_id: usize, range_minimum: f32, range_maximum: f32, has_range: bool) -> void:
            return if label.len == 0
            # Views carry a signed extent. A negative extent is malformed and
            # must not reach a backend's counted-string or pointer arithmetic.
            return if label.len < 0 or help.len < 0 or text_value.len < 0 or selected_text.len < 0
            # A counted view with bytes but no backing storage is malformed
            # foreign input, not an instruction to clear semantic metadata.
            # Reject every text-bearing field before `bounded_text` turns it
            # into an indistinguishable empty view; otherwise a repeated
            # declaration could erase help/value/selection text on a live ID.
            return if (label.len > 0 and label.data == null) or (help.len > 0 and help.data == null) or (text_value.len > 0 and text_value.data == null) or (selected_text.len > 0 and selected_text.data == null)
            # Sanitize the label before deciding whether the node is nameable.
            # A foreign counted view can advertise bytes while carrying null
            # storage (or malformed UTF-8); retaining it would publish an empty
            # accessibility element despite the non-empty raw length check.
            safe_label: sview = bounded_text(label)
            if safe_label.len == 0:
                accessibility_dropped <- true
                return
            # `MAX_ACCESSIBILITY_NODES` is also the relationship sentinel. Do
            # not let a caller publish that sentinel (or an arbitrary large
            # pointer-sized identity) as a real node ID; native adapters use
            # IDs in bounded arrays and would otherwise risk truncation or an
            # identifier-buffer overrun.
            if id >= MAX_ACCESSIBILITY_NODES:
                accessibility_dropped <- true
                return
            safe_frame: Rect = Rect{
                origin: Vec2{ x: bounded_coordinate(frame.origin.x), y: bounded_coordinate(frame.origin.y) },
                size: Size{ width: bounded_extent(frame.size.width), height: bounded_extent(frame.size.height) },
            }
            safe_value: mutable f32 = finite_or_zero(value)
            safe_parent: usize = relationship_id(parent_id)
            safe_first_child: usize = relationship_id(first_child_id)
            safe_next_sibling: usize = relationship_id(next_sibling_id)
            # Numeric ranges are forwarded to native accessibility objects as
            # CFNumbers. A finite f32 can still be far outside a useful or
            # representable control range, so use the same signed envelope as
            # coordinates before storing the semantic node.
            safe_range_minimum: f32 = bounded_coordinate(range_minimum)
            safe_range_maximum: mutable f32 = bounded_coordinate(range_maximum)
            range_conflict: mutable bool = false
            if has_range and safe_range_maximum < safe_range_minimum:
                safe_range_maximum <- safe_range_minimum
                range_conflict <- true
            # A ranged semantic value must stay inside the canonical interval.
            # Repairing only the endpoints would otherwise publish an
            # inconsistent tuple to native accessibility APIs.
            if has_range:
                safe_value <- safe_range_minimum if safe_value < safe_range_minimum
                safe_value <- safe_range_maximum if safe_value > safe_range_maximum
            safe_help: sview = bounded_text(help)
            safe_text_value: sview = bounded_text(text_value)
            safe_selected_text: sview = bounded_text(selected_text)
            # Text ranges are expressed in UTF-16 units by native adapters.
            # Bound against the exact unit count so multibyte UTF-8 (and
            # supplementary scalars) cannot publish an NSRange past NSString.
            selection_limit: usize = UiText::utf16_unit_count(safe_text_value)
            safe_selection_location: mutable usize = selection_location
            safe_selection_location <- selection_limit if safe_selection_location > selection_limit
            remaining_selection: usize = selection_limit - safe_selection_location
            safe_selection_length: mutable usize = selection_length
            safe_selection_length <- remaining_selection if safe_selection_length > remaining_selection
            node: AccessibilityNode = AccessibilityNode{
                role: normalize_role(role), label: safe_label, help: safe_help, frame: safe_frame, id: id,
                action: action, enabled: enabled, focused: focused,
                selected: selected, value: safe_value, text_value: safe_text_value,
                selected_text: safe_selected_text, revision: revision,
                selection_location: safe_selection_location,
                selection_length: safe_selection_length,
                parent_id: safe_parent, first_child_id: safe_first_child,
                next_sibling_id: safe_next_sibling, has_range: has_range,
                range_min: safe_range_minimum, range_max: safe_range_maximum,
                range_conflict: range_conflict,
            }
            existing: usize = accessibility_index_for_id(id)
            if existing < MAX_ACCESSIBILITY_NODES:
                # Last declaration wins while preserving the ID's first
                # position, giving frame diffs stable ordering and identity.
                accessibility_nodes[existing] <- node
                invalidate(Invalidation.Semantics)
                return
            if accessibility_total >= MAX_ACCESSIBILITY_NODES.u32():
                accessibility_dropped <- true
                return
            slot: usize = accessibility_total.usize()
            accessibility_nodes[slot] <- node
            accessibility_slot_by_id[id] <- slot
            accessibility_total <- accessibility_total + 1
            invalidate(Invalidation.Semantics)
