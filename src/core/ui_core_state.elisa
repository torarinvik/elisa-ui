extend UiCore:
    private:
        global mutable command_buffer: Command[MAX_COMMANDS] = zeroed
        # Clip metadata travels beside each render command rather than inside
        # the command union, so existing backend wire layouts remain stable.
        global mutable command_clip: Rect[MAX_COMMANDS] = zeroed
        global mutable command_has_clip_flag: bool[MAX_COMMANDS] = zeroed
        # Visual elevation is likewise side-band metadata. Keeping it out of
        # the portable command union preserves the existing C/WIT wire shape,
        # while custom painters can still apply an explicit Elisa style token.
        global mutable command_elevated: bool[MAX_COMMANDS] = zeroed
        # These counters are bounded by the fixed capacities below. Keeping
        # their storage in the wire-facing u32 width also avoids asking a
        # wasm32 backend to compare an i64 usize load with an i32 capacity.
        global mutable command_total: u32 = 0
        global mutable command_dropped: bool = false
        global mutable accessibility_nodes: AccessibilityNode[MAX_ACCESSIBILITY_NODES] = zeroed
        # Semantic IDs are bounded to the same 256-slot domain as the retained
        # node arena. Keep an Elisa-owned reverse index so declaration and
        # relationship updates do not rescan the full semantic list.
        global mutable accessibility_slot_by_id: usize[MAX_ACCESSIBILITY_NODES] = zeroed
        global mutable accessibility_total: u32 = 0
        global mutable accessibility_dropped: bool = false
        global mutable viewport_size: Size = Size{width: 0.0, height: 0.0}
        global mutable current_clip: Rect = Rect{origin: Vec2{ x: 0.0, y: 0.0 }, size: Size{ width: 0.0, height: 0.0 }}
        global mutable current_clip_active: bool = false
        global mutable current_frame_time: f64 = 0.0
        global mutable requested_frame_delay: f32 = 0.0
        global mutable invalidation_flags: i32 = 0
        global mutable invalidation_sequence_state: u32 = 0
