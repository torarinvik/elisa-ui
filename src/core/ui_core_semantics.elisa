# Shared incremental diff policy for portable semantic nodes.
#
# Backends may retain their native object handles, but they should not invent a
# second interpretation of when a semantic node changed. This mask compares
# the same `AccessibilityNode` records emitted by the retained frame model.

extend UiCore:
    public:
        const enum AccessibilityChange of i32:
            None = 0
            Identity = 1
            Structure = 2
            Geometry = 4
            State = 8
            Value = 16
            Text = 32
            Selection = 64
            Range = 128
            All = 255

        # Compare two nodes without allocating or inspecting native handles.
        # A caller can map each bit to the smallest host operation: structural
        # replacement, geometry refresh, state notification, value update, or
        # text/selection refresh.
        def accessibility_diff(before: AccessibilityNode, after: AccessibilityNode) -> i32:
            changes: mutable i32 = 0
            changes <- changes | AccessibilityChange.Identity.i32() if before.id != after.id
            changes <- changes | AccessibilityChange.Structure.i32() if before.role != after.role or before.action != after.action or before.parent_id != after.parent_id or before.first_child_id != after.first_child_id or before.next_sibling_id != after.next_sibling_id
            changes <- changes | AccessibilityChange.Geometry.i32() if before.frame.origin.x != after.frame.origin.x or before.frame.origin.y != after.frame.origin.y or before.frame.size.width != after.frame.size.width or before.frame.size.height != after.frame.size.height
            changes <- changes | AccessibilityChange.State.i32() if before.enabled != after.enabled or before.focused != after.focused or before.selected != after.selected
            changes <- changes | AccessibilityChange.Value.i32() if before.value != after.value
            changes <- changes | AccessibilityChange.Text.i32() if before.label != after.label or before.help != after.help or before.text_value != after.text_value or before.selected_text != after.selected_text or before.revision != after.revision
            changes <- changes | AccessibilityChange.Selection.i32() if before.selection_location != after.selection_location or before.selection_length != after.selection_length
            changes <- changes | AccessibilityChange.Range.i32() if before.has_range != after.has_range or before.range_min != after.range_min or before.range_max != after.range_max or before.range_conflict != after.range_conflict
            return changes

extend UiCore:
    public:
        # Semantic IDs are the retained identity key used by every backend.
        # Keep one node per ID in the frame buffer so a malformed declaration
        # cannot make a backend reuse one native object at two positions.
        def accessibility_index_for_id(id: usize) -> usize:
            found: usize =
                for index in 0..<accessibility_total.usize() |found = MAX_ACCESSIBILITY_NODES| -> found:
                    found <- index if accessibility_nodes[index].id == id
                    break if found != MAX_ACCESSIBILITY_NODES
            return found

        def accessibility_set_relationships(id: usize, parent_id: usize, first_child_id: usize, next_sibling_id: usize) -> void:
            existing: usize = accessibility_index_for_id(id)
            return if existing >= accessibility_total.usize()
            accessibility_nodes[existing].parent_id <- relationship_id(parent_id)
            accessibility_nodes[existing].first_child_id <- relationship_id(first_child_id)
            accessibility_nodes[existing].next_sibling_id <- relationship_id(next_sibling_id)
            invalidate(Invalidation.Semantics)

        def accessibility_set_range(id: usize, minimum: f32, maximum: f32) -> void:
            existing: usize = accessibility_index_for_id(id)
            return if existing >= accessibility_total.usize()
            safe_minimum: f32 = bounded_coordinate(minimum)
            safe_maximum: mutable f32 = bounded_coordinate(maximum)
            conflict: mutable bool = false
            if safe_maximum < safe_minimum:
                safe_maximum <- safe_minimum
                conflict <- true
            accessibility_nodes[existing].has_range <- true
            accessibility_nodes[existing].range_min <- safe_minimum
            accessibility_nodes[existing].range_max <- safe_maximum
            accessibility_nodes[existing].range_conflict <- conflict
            value: mutable f32 = finite_or_zero(accessibility_nodes[existing].value)
            value <- safe_minimum if value < safe_minimum
            value <- safe_maximum if value > safe_maximum
            accessibility_nodes[existing].value <- value
            invalidate(Invalidation.Semantics)

        def accessibility_count() -> usize:
            return accessibility_total.usize()

        # The indexed reader is the zero-overhead path used by bounded backend
        # loops. External callers should use the optional form when needed.
        def accessibility_at(index: usize) -> AccessibilityNode:
            return accessibility_nodes[index]

        def accessibility_if_valid(index: usize) -> AccessibilityNode?:
            return null if index >= accessibility_total.usize()
            return accessibility_nodes[index]

        def accessibility_overflowed() -> bool:
            return accessibility_dropped
