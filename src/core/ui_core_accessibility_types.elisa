# Portable semantic node types.
#
# A semantic tree travels beside the retained visual command list. Custom-painted
# controls are otherwise invisible to VoiceOver and browser accessibility APIs
# because pixels carry no role, label, bounds, or action target. These types
# live in their own extension so the core type module stays within the source
# hygiene limit.
#
# Relationship IDs use `MAX_ACCESSIBILITY_NODES` as a bounded sentinel; range
# and collection metadata are optional and normalized by the frame builder.
# Collection positions use the native-facing, one-based convention.

extend UiCore:
    public:
        const enum AccessibilityRole of i32:
            Label = 0
            Button = 1
            RadioButton = 2
            CheckBox = 3
            Slider = 4
            ProgressBar = 5
            TextField = 6
            PasswordField = 7
            Dialog = 8
            Image = 9
            Group = 10
            List = 11
            Status = 12
            Alert = 13

        struct AccessibilityNode:
            role: AccessibilityRole
            label: sview
            help: sview
            frame: Rect
            id: usize
            action: usize
            enabled: bool
            focused: bool
            selected: bool
            value: f32
            text_value: sview
            selected_text: sview
            revision: usize
            selection_location: usize
            selection_length: usize
            parent_id: usize
            first_child_id: usize
            next_sibling_id: usize
            has_range: bool
            range_min: f32
            range_max: f32
            range_conflict: bool
            has_collection_position: bool
            collection_position: usize
            # `collection_size` belongs to a positioned item. `collection_count`
            # belongs to a container; keeping them separate supports nested lists.
            collection_size: usize
            collection_count: usize
