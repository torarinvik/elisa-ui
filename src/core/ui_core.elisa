# elisa-ui core: platform-independent types shared by every backend.
#
# The platform contract (implemented by exactly one included backend per binary):
#   ui_clear(r, g, b, a)                      paint the whole surface
#   ui_fill_rect(x, y, w, h, r, g, b, a)      filled rectangle in surface pixels
# The app contract (implemented by the application, called by the backend):
#   app_init()                                once, after the surface exists
#   app_event(event)                          per translated input event
#   app_frame()                               once per frame; issues draw calls

const UI_EVENT_NONE: i32 = 0
const UI_EVENT_QUIT: i32 = 1
const UI_EVENT_POINTER_MOVE: i32 = 2
const UI_EVENT_POINTER_DOWN: i32 = 3
const UI_EVENT_POINTER_UP: i32 = 4
const UI_EVENT_KEY_DOWN: i32 = 5

struct UiEvent:
    kind: mutable i32
    x: mutable f32
    y: mutable f32
    code: mutable i32
