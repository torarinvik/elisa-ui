# elisa-ui core: the platform-independent model every backend shares.
#
# Drawing is RETAINED, not immediate. An app's frame appends commands to a
# buffer; the backend consumes the whole batch at the end of the frame. That is
# the shape wasmbrowser:window/host@0.1.0 requires (`present-commands` takes one
# list per frame, and the manifest's `hybrid` execution mode depends on it), and
# an immediate-mode backend like SDL3 loses nothing by replaying the batch.
#
# The geometry records mirror the WIT records field-for-field so the component
# backend can lower them without reshaping. Canonical-ABI encoding stays in that
# backend; nothing here knows about the wire format.
#
# NAMESPACES. Everything lives in a module and is reached as `Module::name`;
# the module gives the prefix, so names inside drop the `ui_` they used to
# carry. Constants that form a closed set get a module of their own (`UiEvent`)
# so a kind reads as `UiEvent::POINTER_DOWN`. State is private and reached
# through functions, which is what lets a backend live in its own module.
#
# THE CONTRACT. Two sets of top-level functions are declared by name only and
# implemented outside this library, which is why they are not in a module:
#
#   platform (text metrics, from the font the backend rasterizes with):
#     ui_measure_text_width(text, size)   ui_measure_text_height(text, size)
#     ui_font_ascent(size)                ui_text_line_height(size)
#   application:
#     app_init()            once, after the surface exists
#     app_event(event)      per translated input event (`mutable UiCore::Event&`)
#     app_frame()           once per frame; issues draw calls
#     app_widget_event(widget, event)   a widget layer's click report

# Event kinds. Pointer and key values carry the host's own encoding: the
# component backend receives wasmbrowser's pointer-kind/key-code ordinals and
# the SDL3 backend translates its events into the same space.
module UiEvent:
    public:
        const NONE: i32 = 0
        const QUIT: i32 = 1
        const POINTER_MOVE: i32 = 2
        const POINTER_DOWN: i32 = 3
        const POINTER_UP: i32 = 4
        const POINTER_LEAVE: i32 = 5
        const KEY_DOWN: i32 = 6
        const KEY_UP: i32 = 7
        const RESIZE: i32 = 8
        const SCROLL: i32 = 9
        const GAMEPAD_BUTTON: i32 = 10
        const GAMEPAD_AXIS: i32 = 11


# Keyboard scancodes, as the host reports them. A closed set of named values,
# so an app writes `UiKey::Escape` instead of a bare 27 and the compiler catches
# a typo. `of i32` keeps them the same width as `UiCore::Event.code`, and
# `.i32()` converts when a raw code is needed.
const enum UiKey of i32:
    Space = 32
    Apostrophe = 39
    Comma = 44
    Minus = 45
    Period = 46
    Slash = 47
    Digit0 = 48
    Digit1 = 49
    Digit2 = 50
    Digit3 = 51
    Digit4 = 52
    Digit5 = 53
    Digit6 = 54
    Digit7 = 55
    Digit8 = 56
    Digit9 = 57
    Semicolon = 59
    Equal = 61
    A = 65
    B = 66
    C = 67
    D = 68
    E = 69
    F = 70
    G = 71
    H = 72
    I = 73
    J = 74
    K = 75
    L = 76
    M = 77
    N = 78
    O = 79
    P = 80
    Q = 81
    R = 82
    S = 83
    T = 84
    U = 85
    V = 86
    W = 87
    X = 88
    Y = 89
    Z = 90
    LeftBracket = 91
    Backslash = 92
    RightBracket = 93
    Backtick = 96
    Escape = 256
    Enter = 257
    Tab = 258
    Backspace = 259
    Insert = 260
    Delete = 261
    Right = 262
    Left = 263
    Down = 264
    Up = 265
    PageUp = 266
    PageDown = 267
    Home = 268
    End = 269
    F1 = 290
    F2 = 291
    F3 = 292
    F4 = 293
    F5 = 294
    F6 = 295
    F7 = 296
    F8 = 297
    F9 = 298
    F10 = 299
    F11 = 300
    F12 = 301
    LeftShift = 340
    LeftControl = 341
    LeftAlt = 342
    LeftSuper = 343
    RightShift = 344
    RightControl = 345
    RightAlt = 346
    RightSuper = 347


# Gamepad buttons, in the order every modern pad reports them. `South`/`East`/
# `West`/`North` name POSITIONS rather than letters, because the letter printed
# on the same physical button differs by vendor.
const enum UiPad of i32:
    South = 0
    East = 1
    West = 2
    North = 3
    LeftBumper = 4
    RightBumper = 5
    Back = 6
    Start = 7
    Guide = 8
    LeftStick = 9
    RightStick = 10
    DPadUp = 11
    DPadRight = 12
    DPadDown = 13
    DPadLeft = 14


# Gamepad axes.
const enum UiPadAxis of i32:
    LeftX = 0
    LeftY = 1
    RightX = 2
    RightY = 3
    LeftTrigger = 4
    RightTrigger = 5


module UiCore:
    public:
        # A point or a displacement. One type for both, because a UI never needs
        # to distinguish them and two would double every helper.
        struct Vec2:
            x: f32
            y: f32

        struct Size:
            width: f32
            height: f32

        struct Color:
            r: u8
            g: u8
            b: u8
            a: u8

        # SHAPES CARRY NO COLOUR. A shape is geometry, and the colour is how it
        # is painted this frame, so `fill(shape, colour)` takes them separately
        # and one shape can be drawn twice in two colours without rebuilding it.
        struct Rect:
            origin: Vec2
            size: Size

        struct Circle:
            center: Vec2
            radius: f32

        struct Triangle:
            a: Vec2
            b: Vec2
            c: Vec2

        struct Line:
            from_point: Vec2
            to_point: Vec2

        # `origin` is the run's top-left, not its baseline, so a caller that
        # knows only a layout box can place text without consulting font
        # metrics. The text is a view, not a copy: it must outlive the frame,
        # which is why the label widget takes static text rather than building
        # strings per frame -- the component backend's allocator is monotonic
        # and would never reclaim them.
        struct TextRun:
            origin: Vec2
            size: f32
            text: sview

        enum Command:
            Clear(color: Color)
            FillRect(rect: Rect, color: Color)
            FillCircle(circle: Circle, color: Color)
            FillTriangle(triangle: Triangle, color: Color)
            FillLine(line: Line, color: Color)
            DrawText(run: TextRun, color: Color)

        # `code` carries the host's discrete selector (key code, pointer button,
        # gamepad button/axis). `dx`/`dy` carry continuous deltas: scroll
        # distance, or a gamepad axis/button value in dx. `x`/`y` stay the
        # pointer position throughout.
        struct Event:
            kind: mutable i32
            x: mutable f32
            y: mutable f32
            dx: mutable f32
            dy: mutable f32
            code: mutable i32

        # A fixed buffer keeps the frame path allocation-free, which matters
        # most on the component side: the freestanding cabi_realloc is
        # monotonic, so a per-frame growing list would never return memory to
        # the instance.
        const MAX_COMMANDS: usize = 1024

    private:
        global mutable command_buffer: Command[MAX_COMMANDS] = zeroed
        global mutable command_total: usize = 0
        global mutable viewport_w: f32 = 0.0
        global mutable viewport_h: f32 = 0.0

    public:
        def begin_frame() -> void:
            command_total <- 0

        # Commands past the buffer's capacity are dropped rather than growing
        # it. A frame that overflows draws incompletely, which is visible and
        # fixable; the alternative is growing the buffer while making the
        # component's monotonic heap grow without bound.
        def push_command(command: Command) -> void:
            return if command_total >= MAX_COMMANDS
            command_buffer[command_total] <- command
            command_total <- command_total + 1

        # The batch a backend consumes at frame end.
        def command_count() -> usize:
            return command_total

        def command_at(index: usize) -> Command:
            return command_buffer[index]

        def set_viewport(width: f32, height: f32) -> void:
            viewport_w <- width
            viewport_h <- height

        def viewport_width() -> f32:
            return viewport_w

        def viewport_height() -> f32:
            return viewport_h

        # Short constructors, so a call site reads as geometry rather than as a
        # list of floats.
        def vec2(x: f32, y: f32) -> Vec2:
            return Vec2{x: x, y: y}

        def size(width: f32, height: f32) -> Size:
            return Size{width: width, height: height}

        def rect(x: f32, y: f32, width: f32, height: f32) -> Rect:
            return Rect{origin: Vec2{x: x, y: y}, size: Size{width: width, height: height}}

        def rgba(r: u8, g: u8, b: u8, a: u8) -> Color:
            return Color{r: r, g: g, b: b, a: a}

        def rgb(r: u8, g: u8, b: u8) -> Color:
            return Color{r: r, g: g, b: b, a: 255}

        # A rectangle's far edges, for hit testing and layout.
        def right_edge(box: Rect) -> f32:
            return box.origin.x + box.size.width

        def bottom_edge(box: Rect) -> f32:
            return box.origin.y + box.size.height

        def contains(box: Rect, point: Vec2) -> bool:
            return point.x >= box.origin.x and point.y >= box.origin.y and point.x < right_edge(box) and point.y < bottom_edge(box)

        def clear(color: Color) -> void:
            push_command(Command.Clear(color))

        # ONE NAME PER OPERATION, overloaded on the shape. Elisa resolves a free
        # call by its first argument's type, so `fill` needs no protocol and no
        # per-shape suffix; adding a shape means adding one overload.
        def fill(box: Rect, color: Color) -> void:
            push_command(Command.FillRect(box, color))

        def fill(disc: Circle, color: Color) -> void:
            push_command(Command.FillCircle(disc, color))

        def fill(tri: Triangle, color: Color) -> void:
            push_command(Command.FillTriangle(tri, color))

        def fill(segment: Line, color: Color) -> void:
            push_command(Command.FillLine(segment, color))

        def draw(run: TextRun, color: Color) -> void:
            push_command(Command.DrawText(run, color))

        def text_run(origin: Vec2, size: f32, body: sview) -> TextRun:
            return TextRun{origin: origin, size: size, text: body}
