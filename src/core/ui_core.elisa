# elisa-ui core: the platform-independent model every backend shares.
#
# Drawing is RETAINED, not immediate. An app's frame appends commands to a
# buffer; the backend consumes the whole batch at the end of the frame. That is
# the shape wasmbrowser:window/host@0.1.0 requires (`present-commands` takes one
# list per frame, and the manifest's `hybrid` execution mode depends on it), and
# an immediate-mode backend like SDL3 loses nothing by replaying the batch.
#
# The geometry records mirror the WIT records field-for-field so the component
# backend can lower them without reshaping. Canonical-ABI encoding stays in that
# backend; nothing here knows about the wire format.
#
# NAMESPACES. Everything lives in a module and is reached as `Module::name`;
# the module gives the prefix, so names inside drop the `ui_` they used to
# carry. State is private and reached through functions, which is what lets a
# backend live in its own module.
#
# THE CONTRACT. Two sets of top-level functions are declared by name only and
# implemented outside this library, which is why they are not in a module:
#
#   platform (text metrics, from the font the backend rasterizes with):
#     ui_measure_text_width(text, size)   ui_measure_text_height(text, size)
#     ui_font_ascent(size)                ui_text_line_height(size)
#   application:
#     app_init()            once, after the surface exists
#     app_event(event)      per translated input event (`UiCore::Event`, by value)
#     app_text_input(text)  committed UTF-8 text (separate from physical keys)
#     app_text_editing(text, start, length)  live IME composition
#     app_frame()           once per frame; issues draw calls
#     app_widget_event(widget, event)   a widget layer's click report

module UiCore:
    public:
        # A point or a displacement. One type for both, because a UI never needs
        # to distinguish them and two would double every helper.
        struct Vec2:
            x: f32
            y: f32

        struct Size:
            width: f32
            height: f32

        struct Color:
            r: u8
            g: u8
            b: u8
            a: u8

        # SHAPES CARRY NO COLOUR. A shape is geometry, and the colour is how it
        # is painted this frame, so `fill(shape, colour)` takes them separately
        # and one shape can be drawn twice in two colours without rebuilding it.
        struct Rect:
            origin: Vec2
            size: Size

        struct Circle:
            center: Vec2
            radius: f32

        struct Triangle:
            a: Vec2
            b: Vec2
            c: Vec2

        struct Line:
            from_point: Vec2
            to_point: Vec2

        # `origin` is the run's top-left, not its baseline, so a caller that
        # knows only a layout box can place text without consulting font
        # metrics. The text is a view, not a copy: it must outlive the frame,
        # which is why the label widget takes static text rather than building
        # strings per frame -- the component backend's allocator is monotonic
        # and would never reclaim them.
        struct TextRun:
            origin: Vec2
            size: f32
            text: sview

        enum Command:
            Clear(color: Color)
            FillRect(rect: Rect, color: Color)
            FillCircle(circle: Circle, color: Color)
            FillTriangle(triangle: Triangle, color: Color)
            FillLine(line: Line, color: Color)
            DrawText(run: TextRun, color: Color)

        # A semantic tree travels beside the visual command list. Custom-painted
        # controls are otherwise invisible to VoiceOver and browser accessibility
        # APIs because pixels carry no role, label, bounds, or action target.
        const enum AccessibilityRole of i32:
            Label = 0
            Button = 1
            RadioButton = 2
            CheckBox = 3
            Slider = 4
            ProgressBar = 5
            TextField = 6
            PasswordField = 7

        struct AccessibilityNode:
            role: AccessibilityRole
            label: sview
            help: sview
            frame: Rect
            id: usize
            action: usize
            enabled: bool
            focused: bool
            selected: bool
            value: f32
            text_value: sview
            selected_text: sview
            revision: usize
            selection_location: usize
            selection_length: usize

        # Key codes, in GLFW's numbering -- which is what the wasmbrowser host reports.
        # A closed set of named values, so an app writes `Key.Escape` instead of a bare
        # 256 and the compiler catches a typo. A const enum is its BACKING, so `.i32()`
        # converts out and `raw.Key()` converts in; the SDL3 backend, whose keycodes are
        # a different space entirely, translates in key_from_sdl rather than casting.
        #
        # THE SEPARATORS DIFFER, and both are load-bearing. `::` reaches into the
        # module and `.` names a variant of the type it found there, so a backend
        # writes `UiCore::Key.Escape`. The conversion has no such spelling --
        # `raw.UiCore::Key()` does not parse -- which is why `Key`, `Pad` and
        # `PadAxis` below are also FUNCTIONS: `UiCore::Key(raw)` is the same cast
        # a caller inside this module writes as `raw.Key()`.
        const enum Key of i32:
            Space = 32
            Apostrophe = 39
            Comma = 44
            Minus = 45
            Period = 46
            Slash = 47
            Digit0 = 48
            Digit1 = 49
            Digit2 = 50
            Digit3 = 51
            Digit4 = 52
            Digit5 = 53
            Digit6 = 54
            Digit7 = 55
            Digit8 = 56
            Digit9 = 57
            Semicolon = 59
            Equal = 61
            A = 65
            B = 66
            C = 67
            D = 68
            E = 69
            F = 70
            G = 71
            H = 72
            I = 73
            J = 74
            K = 75
            L = 76
            M = 77
            N = 78
            O = 79
            P = 80
            Q = 81
            R = 82
            S = 83
            T = 84
            U = 85
            V = 86
            W = 87
            X = 88
            Y = 89
            Z = 90
            LeftBracket = 91
            Backslash = 92
            RightBracket = 93
            Backtick = 96
            Escape = 256
            Enter = 257
            Tab = 258
            Backspace = 259
            Insert = 260
            Delete = 261
            Right = 262
            Left = 263
            Down = 264
            Up = 265
            PageUp = 266
            PageDown = 267
            Home = 268
            End = 269
            F1 = 290
            F2 = 291
            F3 = 292
            F4 = 293
            F5 = 294
            F6 = 295
            F7 = 296
            F8 = 297
            F9 = 298
            F10 = 299
            F11 = 300
            F12 = 301
            LeftShift = 340
            LeftControl = 341
            LeftAlt = 342
            LeftSuper = 343
            RightShift = 344
            RightControl = 345
            RightAlt = 346
            RightSuper = 347


        # Gamepad buttons, in the order every modern pad reports them. `South`/`East`/
        # `West`/`North` name POSITIONS rather than letters, because the letter printed
        # on the same physical button differs by vendor.
        const enum Pad of i32:
            South = 0
            East = 1
            West = 2
            North = 3
            LeftBumper = 4
            RightBumper = 5
            Back = 6
            Start = 7
            Guide = 8
            LeftStick = 9
            RightStick = 10
            DPadUp = 11
            DPadRight = 12
            DPadDown = 13
            DPadLeft = 14


        # Gamepad axes.
        const enum PadAxis of i32:
            LeftX = 0
            LeftY = 1
            RightX = 2
            RightY = 3
            LeftTrigger = 4
            RightTrigger = 5

        # INPUT, as a sealed hierarchy (docs/77). Each kind carries exactly its own
        # data, so there is no record where `dx` means something only for a scroll and
        # `code` means three different things depending on the tag.
        #
        # It costs nothing: no member is recursive, none declares `common:`, and the
        # root is not `packed`, so the whole tree lowers INLINE -- one tagged union
        # sized for the widest leaf, no store and no allocation per event.
        #
        # The `InputEvent` tier is what lets a handler say "any input at all" in one
        # arm (`InputEvent input:`) instead of listing every leaf.
        enum Event:
            None
            Quit
            Resize(size: Size)
            FocusGained
            FocusLost

        enum InputEvent is Event:
            pass

        enum PointerEvent is InputEvent:
            Move(at: Vec2)
            Down(at: Vec2, button: i32)
            Up(at: Vec2, button: i32)
            Leave
            Scroll(at: Vec2, delta: Vec2)

        # Pointer button identities are framework vocabulary, not a platform's
        # event ordinal. Keep the two named buttons that have semantics in the
        # retained widgets here; other native button numbers remain available
        # through the event's i32 payload for applications that need them.
        const enum PointerButton of i32:
            Primary = 0
            Secondary = 1

        # A captured button uses this sentinel until a press claims it. Keeping
        # it beside the button identities avoids another magic value in the
        # portable interaction state machine.
        const NO_POINTER_BUTTON: i32 = -1

        # The codes are NAMED types, not bare i32. A const enum is its backing, so
        # this costs nothing at runtime and makes `key.code == Key.Escape` a
        # comparison the compiler can check -- against a Pad, say, it cannot.
        enum KeyEvent is InputEvent:
            Down(code: Key)
            Up(code: Key)

        enum GamepadEvent is InputEvent:
            Button(button: Pad, value: f32)
            Axis(axis: PadAxis, value: f32)

        # The FLAT form, for the two boundaries that cannot carry a variant: the WIT
        # host hands the guest loose scalars, and a C caller wants a POD struct. The
        # field meanings are the ones the flat `Event` used to carry, and `kind` keeps
        # the same wire ordinals, so neither boundary shifts.
        struct EventRecord:
            kind: mutable WireKind
            x: mutable f32
            y: mutable f32
            dx: mutable f32
            dy: mutable f32
            code: mutable i32

        # Wire ordinals. Named so the mapping is stated once and both directions of
        # the conversion below read against it. A const enum rather than loose
        # constants, for the same reason Key and Pad are one: a match arm reads
        # `WireKind.Quit`, and a dotted path cannot be mistaken for a fresh binding
        # the way a bare constant name can -- that spelling bound the scrutinee and
        # matched everything, so every event decoded as the first arm. A typo is now
        # a compile error rather than a catch-all. This mirrors elisa_ui_event_kind
        # in include/elisa_ui.h ordinal for ordinal; a const enum IS its backing, so
        # both boundaries still see a plain i32 and nothing shifts.
        const enum WireKind of i32:
            None = 0
            Quit = 1
            PointerMove = 2
            PointerDown = 3
            PointerUp = 4
            PointerLeave = 5
            KeyDown = 6
            KeyUp = 7
            Resize = 8
            Scroll = 9
            GamepadButton = 10
            GamepadAxis = 11
            FocusGained = 12
            FocusLost = 13

        # A fixed buffer keeps the frame path allocation-free, which matters
        # most on the component side: the freestanding cabi_realloc is
        # monotonic, so a per-frame growing list would never return memory to
        # the instance.
        const MAX_COMMANDS: usize = 1024
        const MAX_ACCESSIBILITY_NODES: usize = 256

    private:
        global mutable command_buffer: Command[MAX_COMMANDS] = zeroed
        # Clip metadata travels beside each render command rather than inside
        # the command union, so existing backend wire layouts remain stable.
        global mutable command_clip: Rect[MAX_COMMANDS] = zeroed
        global mutable command_has_clip_flag: bool[MAX_COMMANDS] = zeroed
        global mutable command_total: usize = 0
        global mutable command_dropped: bool = false
        global mutable accessibility_nodes: AccessibilityNode[MAX_ACCESSIBILITY_NODES] = zeroed
        global mutable accessibility_total: usize = 0
        global mutable accessibility_dropped: bool = false
        global mutable viewport_size: Size = Size{width: 0.0, height: 0.0}
        global mutable current_clip: Rect = Rect{origin: Vec2{ x: 0.0, y: 0.0 }, size: Size{ width: 0.0, height: 0.0 }}
        global mutable current_clip_active: bool = false
        global mutable current_frame_time: f64 = 0.0
        global mutable requested_frame_delay: f32 = 0.0

    public:
        def begin_frame() -> void:
            command_total <- 0
            command_dropped <- false
            current_clip_active <- false
            accessibility_total <- 0
            accessibility_dropped <- false
            requested_frame_delay <- 0.0

        def accessibility(role: AccessibilityRole, label: sview, help: sview, frame: Rect, id: usize, action: usize, enabled: bool, focused: bool, selected: bool, value: f32, text_value: sview, selected_text: sview, revision: usize, selection_location: usize, selection_length: usize) -> void:
            return if label.len == 0
            if accessibility_total >= MAX_ACCESSIBILITY_NODES:
                accessibility_dropped <- true
                return
            safe_frame: Rect = Rect(frame.origin.x, frame.origin.y, frame.size.width, frame.size.height)
            safe_value: f32 = finite_or_zero(value)
            accessibility_nodes[accessibility_total] <- AccessibilityNode{role: role, label: label, help: help, frame: safe_frame, id: id, action: action, enabled: enabled, focused: focused, selected: selected, value: safe_value, text_value: text_value, selected_text: selected_text, revision: revision, selection_location: selection_location, selection_length: selection_length}
            accessibility_total <- accessibility_total + 1

        def accessibility_count() -> usize:
            return accessibility_total

        def accessibility_at(index: usize) -> AccessibilityNode:
            return accessibility_nodes[index]

        def accessibility_overflowed() -> bool:
            return accessibility_dropped

        # Commands past the buffer's capacity are dropped rather than growing
        # it. A frame that overflows draws incompletely, which is visible and
        # fixable; the alternative is growing the buffer while making the
        # component's monotonic heap grow without bound.
        def push_command(command: Command) -> void:
            if command_total >= MAX_COMMANDS:
                command_dropped <- true
                return
            command_has_clip_flag[command_total] <- current_clip_active
            command_clip[command_total] <- current_clip if current_clip_active
            command_buffer[command_total] <- command
            command_total <- command_total + 1

        # The batch a backend consumes at frame end.
        def command_count() -> usize:
            return command_total

        def command_at(index: usize) -> Command:
            return command_buffer[index]

        def command_overflowed() -> bool:
            return command_dropped

        # Clip state is deliberately side-band metadata. A backend that can
        # clip natively applies it around one command; a wire backend can keep
        # the render-command discriminants and payloads byte-for-byte stable.
        def set_clip(box: Rect) -> void:
            current_clip <- Rect{
                origin: Vec2{ x: finite_or_zero(box.origin.x), y: finite_or_zero(box.origin.y) },
                size: Size{ width: nonnegative_extent(box.size.width), height: nonnegative_extent(box.size.height) },
            }
            current_clip_active <- true

        def clear_clip() -> void:
            current_clip_active <- false

        def command_has_clip(index: usize) -> bool:
            return index < command_total and command_has_clip_flag[index]

        def command_clip_at(index: usize) -> Rect:
            return command_clip[index]

        # Surface dimensions are extents, never signed offsets. Normalize them
        # at the core boundary so painters and backends cannot observe a
        # negative or NaN-sized viewport from a host resize callback.
        # Host-provided scalar values may be NaN even when they are not
        # extents or normalized fractions. Preserve finite negatives (slider
        # ranges are allowed to span them), but make NaN and infinities
        # deterministic before they reach layout, painting, or a native API.
        def finite_or_zero(value: f32) -> f32:
            difference: f32 = value - value
            return value if difference == difference
            return 0.0

        def finite_or_zero_f64(value: f64) -> f64:
            difference: f64 = value - value
            return value if difference == difference
            return 0.0

        def nonnegative_extent(value: f32) -> f32:
            safe: f32 = finite_or_zero(value)
            return safe if safe > 0.0 else 0.0

        # Normalize values that represent a fraction or progress amount. The
        # Sanitize malformed host values before applying the ordinary lower and
        # upper bounds, so neither NaN nor infinity can poison layout or paint.
        def normalized_unit(value: f32) -> f32:
            safe: f32 = finite_or_zero(value)
            return 0.0 if safe < 0.0
            return 1.0 if safe > 1.0 else safe

        def set_viewport(width: f32, height: f32) -> void:
            viewport_size <- Size{width: nonnegative_extent(width), height: nonnegative_extent(height)}

        def viewport_width() -> f32:
            return viewport_size.width

        def viewport_height() -> f32:
            return viewport_size.height

        # Backends provide a monotonic clock at frame start. Keeping time in
        # core makes animation policy deterministic and directly testable;
        # platforms that do not animate may leave the default at zero.
        def set_frame_time(seconds: f64) -> void:
            safe: f64 = finite_or_zero_f64(seconds)
            current_frame_time <- safe if safe >= 0.0 else 0.0

        def frame_time() -> f64:
            return current_frame_time

        # Animation remains backend-neutral: painting code requests the next
        # frame, while each host decides how to schedule it. Zero means idle.
        # Multiple animated controls coalesce onto the earliest requested wake.
        def request_frame_after(seconds: f32) -> void:
            safe: f32 = finite_or_zero(seconds)
            return if safe <= 0.0
            requested_frame_delay <- safe if requested_frame_delay <= 0.0 or safe < requested_frame_delay

        def frame_delay() -> f32:
            return requested_frame_delay

        # Short constructors named for the type they build, so a call site reads as
        # geometry rather than as a list of floats. `rgb`/`rgba` keep their own names:
        # they are two constructors for ONE type, and the channel set is the whole
        # distinction between them, which a pair of `Color` overloads would throw away.
        def Vec2(x: f32, y: f32) -> Vec2:
            return Vec2{x: finite_or_zero(x), y: finite_or_zero(y)}

        def Size(width: f32, height: f32) -> Size:
            return Size{width: nonnegative_extent(width), height: nonnegative_extent(height)}

        def Rect(x: f32, y: f32, width: f32, height: f32) -> Rect:
            return Rect{origin: Vec2(x, y), size: Size(width, height)}

        def rgba(r: u8, g: u8, b: u8, a: u8) -> Color:
            return Color{r: r, g: g, b: b, a: a}

        def rgb(r: u8, g: u8, b: u8) -> Color:
            return Color{r: r, g: g, b: b, a: 255}

        # A rectangle's far edges, for hit testing and layout.
        def right_edge(box: Rect) -> f32:
            origin: f32 = finite_or_zero(box.origin.x)
            extent: f32 = nonnegative_extent(box.size.width)
            return finite_or_zero(origin + extent)

        def bottom_edge(box: Rect) -> f32:
            origin: f32 = finite_or_zero(box.origin.y)
            extent: f32 = nonnegative_extent(box.size.height)
            return finite_or_zero(origin + extent)

        def contains(box: Rect, point: Vec2) -> bool:
            safe_box: Rect = Rect(box.origin.x, box.origin.y, box.size.width, box.size.height)
            safe_point: Vec2 = Vec2(point.x, point.y)
            return safe_point.x >= safe_box.origin.x and safe_point.y >= safe_box.origin.y and safe_point.x < right_edge(safe_box) and safe_point.y < bottom_edge(safe_box)

        def clear(color: Color) -> void:
            push_command(Command.Clear(color))

        # ONE NAME PER OPERATION, overloaded on the shape. Elisa resolves a free
        # call by its first argument's type, so `fill` needs no protocol and no
        # per-shape suffix; adding a shape means adding one overload.
        def fill(box: Rect, color: Color) -> void:
            safe_box: Rect = Rect(box.origin.x, box.origin.y, box.size.width, box.size.height)
            push_command(Command.FillRect(safe_box, color))

        def fill(disc: Circle, color: Color) -> void:
            safe_disc: Circle = Circle{center: Vec2(disc.center.x, disc.center.y), radius: nonnegative_extent(disc.radius)}
            push_command(Command.FillCircle(safe_disc, color))

        def fill(tri: Triangle, color: Color) -> void:
            safe_tri: Triangle = Triangle{a: Vec2(tri.a.x, tri.a.y), b: Vec2(tri.b.x, tri.b.y), c: Vec2(tri.c.x, tri.c.y)}
            push_command(Command.FillTriangle(safe_tri, color))

        def fill(segment: Line, color: Color) -> void:
            safe_segment: Line = Line{from_point: Vec2(segment.from_point.x, segment.from_point.y), to_point: Vec2(segment.to_point.x, segment.to_point.y)}
            push_command(Command.FillLine(safe_segment, color))

        def draw(run: TextRun, color: Color) -> void:
            safe_run: TextRun = TextRun(run.origin, run.size, run.text)
            push_command(Command.DrawText(safe_run, color))

        def TextRun(origin: Vec2, size: f32, body: sview) -> TextRun:
            return TextRun{origin: origin, size: nonnegative_extent(size), text: body}

        # The constructors for every ordinal that arrives from outside: a raw
        # integer from a host or a C caller, named into its closed set. A const
        # enum IS its backing, so each of these is a cast the compiler erases --
        # they exist because the cast syntax cannot be qualified, not because a
        # conversion has to happen.
        def Key(raw: i32) -> Key:
            return raw.Key()

        def Pad(raw: i32) -> Pad:
            return raw.Pad()

        def PadAxis(raw: i32) -> PadAxis:
            return raw.PadAxis()

        def WireKind(raw: i32) -> WireKind:
            return raw.WireKind()

        # The packed event boundary accepts raw integers from C and WIT hosts,
        # while the typed hierarchy promises closed key and gamepad sets. Keep
        # the membership checks beside the casts so an unknown host ordinal can
        # never become an invalid `Key`, `Pad`, or `PadAxis` value in an app.
        def key_is_valid(raw: i32) -> bool:
            return true if raw == Key.Space.i32() or raw == Key.Apostrophe.i32() or raw == Key.Comma.i32() or raw == Key.Minus.i32() or raw == Key.Period.i32() or raw == Key.Slash.i32()
            return true if raw >= Key.Digit0.i32() and raw <= Key.Digit9.i32()
            return true if raw == Key.Semicolon.i32() or raw == Key.Equal.i32()
            return true if raw >= Key.A.i32() and raw <= Key.Z.i32()
            return true if raw == Key.LeftBracket.i32() or raw == Key.Backslash.i32() or raw == Key.RightBracket.i32() or raw == Key.Backtick.i32()
            return true if raw >= Key.Escape.i32() and raw <= Key.End.i32()
            return true if raw >= Key.F1.i32() and raw <= Key.F12.i32()
            return raw >= Key.LeftShift.i32() and raw <= Key.RightSuper.i32()

        def pad_is_valid(raw: i32) -> bool:
            return raw >= Pad.South.i32() and raw <= Pad.DPadLeft.i32()

        def pad_axis_is_valid(raw: i32) -> bool:
            return raw >= PadAxis.LeftX.i32() and raw <= PadAxis.RightTrigger.i32()

        # ---- The flat boundary ----
        #
        # Everything above this line speaks in variants. These three are the only
        # place the ordinal encoding is written down, so a backend that receives
        # loose scalars (WIT) or a C caller that wants a POD struct converts once
        # here rather than spreading tag arithmetic through the tree.

        # The ordinal a kind travels as. Exhaustive on purpose: adding a leaf without
        # giving it a number is a compile error, not a silent zero.
        def wire_kind(event: Event) -> WireKind:
            match event:
                Event.None:
                    return WireKind.None
                Event.Quit:
                    return WireKind.Quit
                Event.Resize(size):
                    return WireKind.Resize
                Event.FocusGained:
                    return WireKind.FocusGained
                Event.FocusLost:
                    return WireKind.FocusLost
                PointerEvent.Move(at):
                    return WireKind.PointerMove
                PointerEvent.Down(at, button):
                    return WireKind.PointerDown
                PointerEvent.Up(at, button):
                    return WireKind.PointerUp
                PointerEvent.Leave:
                    return WireKind.PointerLeave
                PointerEvent.Scroll(at, delta):
                    return WireKind.Scroll
                KeyEvent.Down(code):
                    return WireKind.KeyDown
                KeyEvent.Up(code):
                    return WireKind.KeyUp
                GamepadEvent.Button(button, value):
                    return WireKind.GamepadButton
                GamepadEvent.Axis(axis, value):
                    return WireKind.GamepadAxis

        # Flatten. Fields a kind does not use stay zero, which is what the flat
        # record always meant.
        def to_record(event: Event) -> EventRecord:
            record: mutable EventRecord = EventRecord{kind: wire_kind(event), x: 0.0, y: 0.0, dx: 0.0, dy: 0.0, code: 0}
            match event:
                Event.Resize(size):
                    record with { x <- nonnegative_extent(size.width), y <- nonnegative_extent(size.height) }
                PointerEvent.Move(at):
                    record with { x <- finite_or_zero(at.x), y <- finite_or_zero(at.y) }
                PointerEvent.Down(at, button):
                    record with { x <- finite_or_zero(at.x), y <- finite_or_zero(at.y), code <- button }
                PointerEvent.Up(at, button):
                    record with { x <- finite_or_zero(at.x), y <- finite_or_zero(at.y), code <- button }
                PointerEvent.Scroll(at, delta):
                    record with { x <- finite_or_zero(at.x), y <- finite_or_zero(at.y), dx <- finite_or_zero(delta.x), dy <- finite_or_zero(delta.y) }
                KeyEvent.Down(code):
                    record.code <- code.i32()
                KeyEvent.Up(code):
                    record.code <- code.i32()
                GamepadEvent.Button(button, value):
                    record with { dx <- finite_or_zero(value), code <- button.i32() }
                GamepadEvent.Axis(axis, value):
                    record with { dx <- finite_or_zero(value), code <- axis.i32() }
                Event.None:
                    pass
                Event.Quit:
                    pass
                Event.FocusGained:
                    pass
                Event.FocusLost:
                    pass
                PointerEvent.Leave:
                    pass
            return record

        # Rebuild. An unknown ordinal is `None` rather than a panic: the host is
        # free to grow its event set faster than this library does.
        def from_record(record: EventRecord) -> Event:
            at: Vec2 = Vec2(record.x, record.y)
            return match record.kind:
                WireKind.Quit:
                    Event.Quit
                WireKind.Resize:
                    Event.Resize(size: Size(record.x, record.y))
                WireKind.FocusGained:
                    Event.FocusGained
                WireKind.FocusLost:
                    Event.FocusLost
                WireKind.PointerMove:
                    PointerEvent.Move(at: at)
                WireKind.PointerDown:
                    PointerEvent.Down(at: at, button: record.code)
                WireKind.PointerUp:
                    PointerEvent.Up(at: at, button: record.code)
                WireKind.PointerLeave:
                    PointerEvent.Leave
                WireKind.Scroll:
                    PointerEvent.Scroll(at: at, delta: Vec2(record.dx, record.dy))
                WireKind.KeyDown:
                    return Event.None if not key_is_valid(record.code)
                    KeyEvent.Down(code: record.code.Key())
                WireKind.KeyUp:
                    return Event.None if not key_is_valid(record.code)
                    KeyEvent.Up(code: record.code.Key())
                WireKind.GamepadButton:
                    return Event.None if not pad_is_valid(record.code)
                    GamepadEvent.Button(button: record.code.Pad(), value: finite_or_zero(record.dx))
                WireKind.GamepadAxis:
                    return Event.None if not pad_axis_is_valid(record.code)
                    GamepadEvent.Axis(axis: record.code.PadAxis(), value: finite_or_zero(record.dx))
                _:
                    Event.None
