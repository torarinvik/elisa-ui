# Backend-neutral grapheme navigation.
#
# The retained editor, line planner, and native range adapters all need the
# same user-perceived-character boundaries. Keep the compact UAX #29 property
# vocabulary beside UiText so no backend has to duplicate caret policy.

extend UiText:
    public:
        # Advance to the next extended grapheme boundary. The input is a
        # counted UTF-8 view and the result is a byte offset into that view.
        # Malformed bytes recover one byte at a time through utf8_scalar_bytes.
        def next_grapheme(text: sview, position: usize) -> usize:
            return 0 if text.len <= 0 or text.data == null
            limit: usize = MAX_TEXT_BYTES if text.len > MAX_TEXT_BYTES.i64() else text.len.usize()
            return limit if position >= limit
            first: u32 = scalar_value(text, position)
            first_width: usize = utf8_scalar_bytes(text, position)
            cursor: mutable usize = position + first_width
            return limit if cursor > limit
            previous_scalar: mutable u32 = first
            if first == 13 and cursor < limit and scalar_value(text, cursor) == 10:
                return cursor + 1
            return cursor if grapheme_control(first)
            if regional_indicator(first) and cursor < limit and regional_indicator(scalar_value(text, cursor)):
                previous_scalar <- scalar_value(text, cursor)
                cursor <- cursor + utf8_scalar_bytes(text, cursor)
            result: usize =
                for _ in 0..<limit |cursor, previous_scalar, emoji_base: bool = grapheme_extended_pictographic(first), emoji_zwj: bool = false, indic_context: u32 = (1 if grapheme_consonant(first) else 0), prepend_context: bool = grapheme_prepend(first)| -> cursor:
                    break if cursor >= limit
                    scalar: u32 = scalar_value(text, cursor)
                    width: usize = utf8_scalar_bytes(text, cursor)
                    break if width == 0 or cursor + width > limit
                    if grapheme_control(scalar):
                        break
                    elif scalar == 8205:
                        cursor <- cursor + width
                        emoji_zwj <- emoji_base
                        emoji_base <- false
                        prepend_context <- false
                        previous_scalar <- scalar
                    elif emoji_zwj and grapheme_extended_pictographic(scalar):
                        cursor <- cursor + width
                        emoji_zwj <- false
                        emoji_base <- true
                        prepend_context <- false
                        previous_scalar <- scalar
                    elif grapheme_linker(scalar):
                        cursor <- cursor + width
                        indic_context <- 2 if indic_context == 1 else 0
                        emoji_base <- false
                        prepend_context <- false
                        previous_scalar <- scalar
                    elif extends_grapheme(scalar):
                        cursor <- cursor + width
                        prepend_context <- false
                        previous_scalar <- scalar
                    elif grapheme_spacing_mark(scalar):
                        cursor <- cursor + width
                        indic_context <- 0
                        emoji_base <- false
                        prepend_context <- false
                        previous_scalar <- scalar
                    elif prepend_context:
                        cursor <- cursor + width
                        indic_context <- 0
                        emoji_base <- false
                        prepend_context <- grapheme_prepend(scalar)
                        previous_scalar <- scalar
                    elif hangul_joins(previous_scalar, scalar):
                        cursor <- cursor + width
                        indic_context <- 0
                        emoji_base <- false
                        prepend_context <- false
                        previous_scalar <- scalar
                    elif indic_context == 2 and grapheme_consonant(scalar):
                        cursor <- cursor + width
                        indic_context <- 1
                        emoji_base <- false
                        prepend_context <- false
                        previous_scalar <- scalar
                    else:
                        break
            return result

    private:
        def scalar_value(text: sview, position: usize) -> u32:
            return 0 if text.data == null or position >= text.len.usize()
            first: u32 = text.data[position].u32()
            width: usize = utf8_scalar_bytes(text, position)
            return first if width == 1
            second: u32 = text.data[position + 1].u32() & 63
            return ((first & 31) << 6) | second if width == 2
            third: u32 = text.data[position + 2].u32() & 63
            return ((first & 15) << 12) | (second << 6) | third if width == 3
            fourth: u32 = text.data[position + 3].u32() & 63
            return ((first & 7) << 18) | (second << 12) | (third << 6) | fourth

        def extends_grapheme(scalar: u32) -> bool:
            return true if scalar >= 768 and scalar <= 879
            return true if scalar >= 6832 and scalar <= 6911
            return true if scalar >= 7616 and scalar <= 7679
            return true if scalar >= 8400 and scalar <= 8447
            return true if scalar >= 65024 and scalar <= 65039
            return true if scalar >= 127995 and scalar <= 127999
            return true if scalar >= 917536 and scalar <= 917631
            return true if scalar >= 917760 and scalar <= 917999
            return true if scalar == 8204
            return scalar >= 65056 and scalar <= 65071

        def grapheme_control(scalar: u32) -> bool:
            return true if scalar <= 31
            return scalar >= 127 and scalar <= 159

        def grapheme_prepend(scalar: u32) -> bool:
            return true if scalar >= 1536 and scalar <= 1541
            return true if scalar == 1757 or scalar == 1807 or scalar == 2274
            return true if scalar >= 2192 and scalar <= 2193
            return true if scalar == 3406 or scalar == 69821 or scalar == 69837
            return true if scalar >= 70082 and scalar <= 70083
            return true if scalar == 71999 or scalar == 72001 or scalar == 72250
            return scalar >= 72324 and scalar <= 72329

        def grapheme_spacing_mark(scalar: u32) -> bool:
            return true if scalar >= 2366 and scalar <= 2380
            return true if scalar >= 2382 and scalar <= 2383
            return true if scalar >= 2389 and scalar <= 2391
            return true if scalar >= 2402 and scalar <= 2403
            return true if scalar >= 2494 and scalar <= 2500
            return true if scalar >= 2503 and scalar <= 2508
            return true if scalar == 2519
            return true if scalar >= 2622 and scalar <= 2636
            return true if scalar >= 2750 and scalar <= 2764
            return true if scalar >= 2878 and scalar <= 2892
            return true if scalar == 2903
            return true if scalar >= 3006 and scalar <= 3020
            return true if scalar == 3031
            return true if scalar >= 3134 and scalar <= 3148
            return true if scalar >= 3157 and scalar <= 3158
            return true if scalar >= 3262 and scalar <= 3276
            return true if scalar >= 3285 and scalar <= 3286
            return true if scalar >= 3390 and scalar <= 3404
            return true if scalar == 3415
            return true if scalar >= 3531 and scalar <= 3551
            return true if scalar >= 3632 and scalar <= 3642
            return true if scalar >= 3762 and scalar <= 3763
            return true if scalar >= 3902 and scalar <= 3903
            return true if scalar >= 4139 and scalar <= 4152
            return true if scalar >= 4155 and scalar <= 4158
            return scalar >= 4159 and scalar <= 4169

        def grapheme_linker(scalar: u32) -> bool:
            return true if scalar == 2381 or scalar == 2509 or scalar == 2637 or scalar == 2765
            return true if scalar == 2893 or scalar == 3021 or scalar == 3149 or scalar == 3277
            return true if scalar == 3405 or scalar == 3530 or scalar == 4153 or scalar == 4154
            return true if scalar == 6098 or scalar == 6752 or scalar == 6980
            return true if scalar == 69702 or scalar == 69939 or scalar == 70080
            return true if scalar == 70197 or scalar == 70477 or scalar == 70722
            return true if scalar == 70850 or scalar == 71103 or scalar == 71231
            return true if scalar == 71350 or scalar == 71467 or scalar == 71737
            return true if scalar == 71997 or scalar == 72160 or scalar == 72244
            return true if scalar == 72767 or scalar == 73028
            return false

        def grapheme_consonant(scalar: u32) -> bool:
            return true if scalar >= 2325 and scalar <= 2361
            return true if scalar >= 2453 and scalar <= 2489
            return true if scalar >= 2524 and scalar <= 2527
            return true if scalar >= 2581 and scalar <= 2617
            return true if scalar >= 2649 and scalar <= 2654
            return true if scalar >= 2709 and scalar <= 2745
            return true if scalar >= 2784 and scalar <= 2785
            return true if scalar >= 2837 and scalar <= 2873
            return true if scalar >= 2908 and scalar <= 2909
            return true if scalar >= 2965 and scalar <= 3001
            return true if scalar >= 3093 and scalar <= 3129
            return true if scalar >= 3221 and scalar <= 3257
            return true if scalar >= 3349 and scalar <= 3385
            return true if scalar >= 3482 and scalar <= 3526
            return true if scalar >= 4096 and scalar <= 4129
            return scalar >= 6016 and scalar <= 6050

        def grapheme_extended_pictographic(scalar: u32) -> bool:
            return true if scalar == 169 or scalar == 174 or scalar == 8252 or scalar == 8265
            return false if scalar >= 127462 and scalar <= 127487
            return true if scalar >= 9728 and scalar <= 10175
            return true if scalar >= 11008 and scalar <= 11263
            return true if scalar >= 127744 and scalar <= 129791
            return scalar >= 129792 and scalar <= 129939

        def regional_indicator(scalar: u32) -> bool:
            return scalar >= 127462 and scalar <= 127487

        def hangul_kind(scalar: u32) -> u32:
            return 1 if (scalar >= 4352 and scalar <= 4447) or (scalar >= 43360 and scalar <= 43388)
            return 2 if (scalar >= 4448 and scalar <= 4519) or (scalar >= 55216 and scalar <= 55238)
            return 3 if (scalar >= 4520 and scalar <= 4607) or (scalar >= 55243 and scalar <= 55291)
            if scalar >= 44032 and scalar <= 55203:
                return 4 if (scalar - 44032) % 28 == 0 else 5
            return 0

        def hangul_joins(previous: u32, current: u32) -> bool:
            previous_kind: u32 = hangul_kind(previous)
            current_kind: u32 = hangul_kind(current)
            return true if previous_kind == 1 and (current_kind == 1 or current_kind == 2 or current_kind == 4 or current_kind == 5)
            return true if (previous_kind == 4 or previous_kind == 2) and (current_kind == 2 or current_kind == 3)
            return true if (previous_kind == 5 or previous_kind == 3) and current_kind == 3
            return false
