# Bounded, backend-neutral event ingress.
#
# Platform adapters translate their native facts into UiCore::Event and hand
# them to this queue before application dispatch. The queue owns capacity and
# overflow policy in Elisa; a host cannot silently grow an unbounded event
# backlog or overwrite an authoritative event. Adapters may drain immediately
# when their host callback is synchronous, or after polling a burst.

module UiEvents:
    public:
        const EVENT_QUEUE_CAPACITY: usize = 256

        struct Snapshot:
            pending: usize
            capacity: usize
            dropped: usize
            overflowed: bool

        def reset() -> void:
            for slot in 0..<EVENT_QUEUE_CAPACITY:
                queue[slot] <- UiCore::Event.None
            queue_head <- 0
            queue_count <- 0
            dropped_count <- 0
            overflow_state <- false

        # Enqueue is loss-aware. The event is never replaced when full; callers
        # receive false and can expose the sticky overflow through diagnostics.
        # Normalize at this shared ingress point as well: native and test
        # adapters often construct typed variants directly and must not bypass
        # the finite-geometry and enum checks used by flat ABI records.
        def enqueue(event: UiCore::Event) -> bool:
            return false if not UiCore::input_coordinates_are_finite(event)
            normalized: UiCore::Event = UiCore::normalize_event(event)
            # `normalize_event` maps unknown key, pointer-button, and gamepad
            # ordinals to `Event.None`. Do not claim that such a malformed
            # typed value was accepted: callers must be able to distinguish a
            # rejected input from a valid no-op event at the queue boundary.
            return false if UiCore::wire_kind(normalized) != UiCore::wire_kind(event)
            if queue_count >= EVENT_QUEUE_CAPACITY:
                dropped_count <- dropped_count + 1
                overflow_state <- true
                # Lifecycle transitions are authoritative: losing focus must
                # be observable even when a synchronous callback has filled
                # the ring with stale pointer/key traffic. Replace the first
                # queued physical-input event, preserving the bounded ring and
                # making the loss visible through the existing diagnostics.
                return false if not is_authoritative(event)
                replacement: mutable usize = EVENT_QUEUE_CAPACITY
                for offset in 0..<EVENT_QUEUE_CAPACITY:
                    slot: usize = (queue_head + offset) % EVENT_QUEUE_CAPACITY
                    if UiCore::is_input_event(queue[slot]):
                        replacement <- slot
                        break
                return false if replacement == EVENT_QUEUE_CAPACITY
                queue[replacement] <- normalized
                return true
            slot: usize = (queue_head + queue_count) % EVENT_QUEUE_CAPACITY
            queue[slot] <- normalized
            queue_count <- queue_count + 1
            return true

        # The destination is written only when an event exists. This keeps a
        # failed drain from accidentally replacing a caller's current event.
        def dequeue(out_event: mutable UiCore::Event&) -> bool:
            return false if queue_count == 0
            out_event <- queue[queue_head]
            queue_head <- (queue_head + 1) % EVENT_QUEUE_CAPACITY
            queue_count <- queue_count - 1
            return true

        def pending() -> usize:
            return queue_count

        def dropped() -> usize:
            return dropped_count

        def overflowed() -> bool:
            return overflow_state

        def snapshot() -> Snapshot:
            return Snapshot{
                pending: queue_count,
                capacity: EVENT_QUEUE_CAPACITY,
                dropped: dropped_count,
                overflowed: overflow_state,
            }

    private:
        global mutable queue: UiCore::Event[EVENT_QUEUE_CAPACITY] = zeroed
        global mutable queue_head: usize = 0
        global mutable queue_count: usize = 0
        global mutable dropped_count: usize = 0
        global mutable overflow_state: bool = false

        def is_authoritative(event: UiCore::Event) -> bool:
            match event:
                UiCore::Event.Quit:
                    return true
                UiCore::Event.Resize(size):
                    return true
                UiCore::Event.FocusGained:
                    return true
                UiCore::Event.FocusLost:
                    return true
                _:
                    pass
            return false
