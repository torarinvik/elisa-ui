# elisa-ui painting contract: what a backend must provide to turn the core's
# command list into pixels.
#
# WHY A PROTOCOL AND NOT A FUNCTION TABLE. Elisa protocols resolve at COMPILE
# TIME and lower through specialization -- there is no vtable carrier, so
# `UiPaint::replay[Sdl3Painter]()` costs exactly what the hand-written match
# cost, with no indirect call on the per-command path. That matters here: this is
# the hot loop of every frame. The price is that a binary paints through one
# painter, chosen when it is built, which is how a UI toolkit is used anyway --
# you ship a macOS app or a wasm component, not a binary that might be either.
#
# WHY THE COMMANDS AND NOT THE WIDGETS. Both widget layers -- UiFlat's array and
# UiWidgets' sealed hierarchy -- emit the same UiCore::Command list, so the
# painting contract sits BELOW both and neither leaks into a backend. A native
# controls backend is a different contract entirely (it consumes the widget tree,
# not the command list) and is its own protocol, in ui_controls.elisa.
#
# The replay loop below used to be copied into every backend: SDL3 matched the
# six commands to paint them, WasmBrowser matched the same six to encode them.
# Two copies drifted -- SDL3 approximated circles and triangles with their
# bounding boxes while WasmBrowser drew them exactly, so one command list meant
# two different pictures. One loop, six protocol methods, no place to drift.

include "./ui_core.elisa"

# The authority a UI needs, split so a function can be honest about which part it
# uses. The prize is the NEGATIVE space: layout and the widget passes touch none
# of these, so their `can` rows stay empty and the compiler proves a layout pass
# cannot draw, poll, or open a window. That is what makes the passes reusable by
# every backend and testable with no backend at all.
#
# TOP LEVEL on purpose, unlike everything below it: `Ui.Draw` is spelled in the
# `can` row of every backend function in the framework, and a permission is
# vocabulary rather than a layer. Qualifying it would put a module name in every
# effect row and buy nothing.
permission Ui:
    # Create, size and destroy windows.
    Window
    # Put pixels on a surface.
    Draw
    # Measure or shape text -- separated from Draw because layout MEASURES
    # without drawing, and a headless layout test wants the one without the other.
    Text
    # Pump the host's event queue.
    Input
    # Create and mutate native OS controls. Unused by a painting backend; declared
    # here so the native backend's row is drawn from the same family.
    Controls

# The painting vocabulary: the contract and the one loop that drives it.
#
# A backend names `Painter` UNQUALIFIED in its `impl` header, under `using
# UiPaint`, because `impl UiPaint::Painter for T:` is the one shape here that no
# compiler takes: stage0's parser wants a `:` where the `for` is, and stage1
# accepts the parse but declines the specialized bodies. Measured 2026-09-04, not
# guessed. Everything else this module needs -- a generic declared inside a
# module, an `impl` written inside a platform module, a module-qualified call to
# the generic -- compiles and runs identically on both compilers now, which is
# why the contract lives in a module at all.
module UiPaint:
    public:
        const SHADOW_OFFSET_X: f32 = 0.0
        const SHADOW_OFFSET_Y: f32 = 2.0
        const SHADOW_BLUR: f32 = 5.0
        const HAIRLINE_WIDTH: f32 = 1.0
        # The largest corner any surface takes, and the corner a perfectly
        # square one gets as a fraction of its side.
        const CORNER_MAX: f32 = 12.0
        const BLOCK_CORNER_RATIO: f32 = 0.22
        # The thickness range over which a slender surface stops being a bar.
        const BAR_THICKNESS_MIN: f32 = 8.0
        const BAR_THICKNESS_MAX: f32 = 24.0
        # The stem growth a weighted run gets, as a fraction of its point size.
        #
        # Tuned against a real semibold face rendered by CoreText at the same
        # size, but NOT to equal it. Matching its ink exactly takes 0.07, and at
        # 0.07 the counters close: dilating one face uniformly is not what a
        # designed bold does, so the bowl of an "e" fills in before the stems
        # are heavy enough. This is the point where a heading reads as bold and
        # the counters stay open.
        const SYNTHETIC_WEIGHT_RATIO: f32 = 0.045

        # Shared custom-painter styling. Native controls do not consume this
        # record; each custom backend translates the same Elisa policy into its
        # own primitive API, keeping AppKit fallback and Skia visually aligned.
        struct RoundedRectStyle:
            radius: f32
            elevated: bool
            shadow_alpha: u8
            hairline_alpha: u8
            shadow_offset_x: f32
            shadow_offset_y: f32
            shadow_blur: f32
            hairline_width: f32
            # DEPTH, and why it is three effects rather than one.
            #
            # A drop shadow alone is how a surface reads as raised on PAPER. On a
            # dark interface it is nearly invisible -- dark on dark -- and the
            # first Skia renders of the showcase looked flat for exactly that
            # reason: every surface had the same shadow policy and none of it
            # showed. What actually reads as raised on a dark ground is LIGHT
            # CATCHING THE TOP EDGE, so the policy carries both and weights them
            # by how light the surface itself is.
            #
            # `sheen` is a white overlay across the fill, strongest at the top:
            # the surface is lit from above. `bevel` is the rim of that same
            # light on the top of the outline -- one pixel, and the difference
            # between a rectangle and an object.
            sheen_top_alpha: u8
            sheen_bottom_alpha: u8
            bevel_alpha: u8
            # A RECESSED surface is the same three effects with the light
            # coming from the other side of the edge: the wash across it is
            # shadow rather than sheen, and the rim sits at the BOTTOM, where a
            # well catches light from a source still overhead.
            sheen_is_shadow: bool
            bevel_at_bottom: bool

        # The corner policy: a capsule if the surface is a BAR -- long AND thin --
        # and a proportional corner otherwise, blended continuously between.
        #
        # It began as `shortest * 0.22`, capped at 10. That is proportional, and
        # proportional corners are what made the small controls look dated: a
        # 4pt slider track got a 0.9pt radius, so the filled part of every
        # slider, every progress meter and every thin divider ended in a SQUARE.
        # Nothing in a current interface has square ends at that size.
        #
        # Half the short side fixes that and breaks two other things, both of
        # which the renders showed. A checkbox indicator is 14x14, and half of
        # 14 is a CIRCLE: the checkboxes came back indistinguishable from radio
        # buttons. And a list row is 940x26 -- slender, so half its thickness is
        # a stadium, and a page of twenty-four of them reads as twenty-four
        # floating buttons rather than as a list.
        #
        # Slenderness alone cannot separate those: a track and a row are both
        # long. What separates them is THICKNESS. A capsule says "this is a bar",
        # and a bar is thin in absolute terms, not relative ones -- so both
        # factors weight the blend and a surface has to be both to get one.
        def rounded_rect_style(box: UiCore::Rect, elevated: bool) -> RoundedRectStyle:
            return rounded_rect_style_with_radius(box, elevated, corner_radius(box))

        def corner_radius(box: UiCore::Rect) -> f32:
            shortest: f32 = box.size.width if box.size.width < box.size.height else box.size.height
            longest: f32 = box.size.height if box.size.width < box.size.height else box.size.width
            return 0.0 if shortest <= 0.0
            pill: f32 = slender_weight(longest / shortest) * thin_weight(shortest)
            radius: mutable f32 = UiCore::bounded_extent(shortest * (BLOCK_CORNER_RATIO + (0.5 - BLOCK_CORNER_RATIO) * pill))
            radius <- CORNER_MAX if radius > CORNER_MAX else radius
            return radius

        # Square reads as 0, three-to-one and beyond as 1.
        def slender_weight(slenderness: f32) -> f32:
            weight: mutable f32 = (slenderness - 1.0) / 2.0
            weight <- 0.0 if weight < 0.0
            return 1.0 if weight > 1.0 else weight

        # A hairline or a track reads as 1, anything as thick as a list row as 0.
        def thin_weight(shortest: f32) -> f32:
            weight: mutable f32 = (BAR_THICKNESS_MAX - shortest) / (BAR_THICKNESS_MAX - BAR_THICKNESS_MIN)
            weight <- 0.0 if weight < 0.0
            return 1.0 if weight > 1.0 else weight

        # Theme-aware variant for custom painters. The supplied radius is
        # normalized against the box so a malformed style cannot escape the
        # same finite geometry envelope as the default policy.
        def rounded_rect_style_with_radius(box: UiCore::Rect, elevated: bool, requested_radius: f32) -> RoundedRectStyle:
            shortest: f32 = box.size.width if box.size.width < box.size.height else box.size.height
            limit: f32 = UiCore::bounded_extent(shortest / 2.0)
            radius: mutable f32 = UiCore::bounded_extent(requested_radius)
            radius <- 0.0 if radius < 0.0
            radius <- limit if radius > limit
            return RoundedRectStyle{
                radius: radius,
                elevated: elevated,
                shadow_alpha: 61 if elevated else 0,
                hairline_alpha: 33 if elevated else 14,
                shadow_offset_x: SHADOW_OFFSET_X,
                shadow_offset_y: SHADOW_OFFSET_Y,
                shadow_blur: SHADOW_BLUR,
                hairline_width: HAIRLINE_WIDTH,
                sheen_top_alpha: 0,
                sheen_bottom_alpha: 0,
                bevel_alpha: 0,
                sheen_is_shadow: false,
                bevel_at_bottom: false,
            }

        # The elevation treatment for a surface that will be painted in `color`.
        #
        # This is the whole depth policy, in one place, for every custom backend:
        # a light surface is lifted by a soft shadow beneath it, a dark surface by
        # light along its top edge, and both get a little of the other. Passing the
        # colour is what makes that possible -- the style used to be chosen with no
        # idea what would be painted into it, so one shadow had to serve a white
        # card and a near-black panel, and it suited neither.
        def rounded_rect_style_for(box: UiCore::Rect, depth: UiCore::SurfaceDepth, color: UiCore::Color) -> RoundedRectStyle:
            base: RoundedRectStyle = rounded_rect_style(box, depth == UiCore::SurfaceDepth.Raised)
            return elevation_treatment(base, color, depth)

        def rounded_rect_style_for_with_radius(box: UiCore::Rect, depth: UiCore::SurfaceDepth, requested_radius: f32, color: UiCore::Color) -> RoundedRectStyle:
            base: RoundedRectStyle = rounded_rect_style_with_radius(box, depth == UiCore::SurfaceDepth.Raised, requested_radius)
            return elevation_treatment(base, color, depth)

        # Weight the three depth effects by the surface's own lightness.
        #
        # LIGHT surfaces (luminance at or above the midpoint) cast a real shadow:
        # wide and soft, low alpha, offset further down than the old policy's 2px,
        # because a tight dark smudge reads as a border rather than as height.
        # They keep a strong top bevel -- on paper that is the lit edge.
        #
        # DARK surfaces get a shadow too, but a stronger one over a shorter
        # distance (it has to survive being dark-on-dark), and they lean on the
        # sheen and bevel, which are the only two things that read at all.
        #
        # A surface that is NOT elevated still gets a trace of both, because a
        # completely flat fill next to a lifted one looks like a rendering
        # failure rather than a deliberate lack of emphasis.
        def elevation_treatment(base: RoundedRectStyle, color: UiCore::Color, depth: UiCore::SurfaceDepth) -> RoundedRectStyle:
            luminance: i64 = UiCore::surface_luminance(color)
            elevated: bool = depth == UiCore::SurfaceDepth.Raised
            inset: bool = depth == UiCore::SurfaceDepth.Inset
            # A recess casts no shadow of its own -- the shadow is INSIDE it,
            # which is what the inverted wash below draws.
            return RoundedRectStyle{
                radius: base.radius,
                elevated: elevated,
                shadow_alpha: 0 if inset or not elevated else blend(130, 46, luminance),
                hairline_alpha: base.hairline_alpha,
                shadow_offset_x: base.shadow_offset_x,
                shadow_offset_y: 8.0,
                shadow_blur: 22.0,
                hairline_width: base.hairline_width,
                sheen_top_alpha: blend(110, 70, luminance) if inset else (blend(30, 26, luminance) if elevated else blend(8, 10, luminance)),
                sheen_bottom_alpha: 0,
                bevel_alpha: blend(46, 90, luminance) if inset else (blend(120, 170, luminance) if elevated else blend(40, 60, luminance)),
                sheen_is_shadow: inset,
                bevel_at_bottom: inset,
            }

        # The two gradients a depth treatment is MADE of, derived here rather
        # than in each backend.
        #
        # This is the seam the framework got wrong once already. Skia knew that a
        # recess washes with black rather than white, and that the rim runs from
        # the bevel alpha to the hairline alpha in whichever direction the light
        # comes from; CoreGraphics knew none of it, because that arithmetic lived
        # inside the Skia backend rather than in the policy both backends read.
        # The same app looked like two different apps. Four functions here, and a
        # backend only has to know how to draw a linear gradient.
        # SYNTHETIC TEXT WEIGHT, as a stroke added to the glyph outline.
        #
        # A backend with one borrowed typeface has no bold face to switch to, so
        # weight has to be synthesized. Skia offers `setEmbolden` for exactly
        # this and it is what the framework used -- but measured against a real
        # semibold face it is too light: the same weighted run carried 30% less
        # ink under Skia than under CoreText, so a heading was bold in a native
        # AppKit window and merely medium in the Skia one.
        #
        # A stroke says the same thing with a number the framework chooses. It
        # also keeps the property the single-typeface design rests on: a stroke
        # dilates the outline and does not touch the ADVANCE, so a weighted run
        # still occupies exactly the box the layout pass measured for it and
        # there is no second measurement path and no risk of clipped labels.
        # A real bold face would change advances and would need one.
        def synthetic_weight_stroke(size: f32, weighted: bool) -> f32:
            return 0.0 if not weighted or size <= 0.0
            return UiCore::bounded_extent(size * SYNTHETIC_WEIGHT_RATIO)

        # How a stroke ENDS, decided once for every backend.
        #
        # A hairline is butt-capped: a divider, a rule and a caret are drawn to
        # an exact length, and half a pixel of overhang at each end is a
        # measurable error rather than a nicety. Anything wider is round-capped,
        # because a butt cap on a thick diagonal reads as chipped -- and a
        # checkmark is two thick diagonals meeting at a point, which is where
        # this shows first.
        def stroke_cap_is_round(width: f32) -> bool:
            return width > UiCore::DEFAULT_STROKE_WIDTH

        def has_sheen(style: RoundedRectStyle) -> bool:
            return style.sheen_top_alpha != 0 or style.sheen_bottom_alpha != 0

        # White at a low alpha rather than a lightened copy of the fill: an
        # overlay works on any colour the app chooses, and needs no colour
        # arithmetic in the backend. A recess inverts the tint, not the
        # direction -- the light is still overhead.
        def sheen_near_color(style: RoundedRectStyle) -> UiCore::Color:
            tint: u8 = sheen_tint(style)
            return UiCore::rgba(tint, tint, tint, style.sheen_top_alpha)

        def sheen_far_color(style: RoundedRectStyle) -> UiCore::Color:
            tint: u8 = sheen_tint(style)
            return UiCore::rgba(tint, tint, tint, style.sheen_bottom_alpha)

        # The outline and the rim light are ONE stroke, which is why they are one
        # gradient here. Two strokes would double up on whichever edge they share.
        def rim_near_color(style: RoundedRectStyle) -> UiCore::Color:
            near: u8 = style.hairline_alpha if style.bevel_at_bottom else rim_alpha(style)
            return UiCore::rgba(255, 255, 255, near)

        def rim_far_color(style: RoundedRectStyle) -> UiCore::Color:
            far: u8 = rim_alpha(style) if style.bevel_at_bottom else style.hairline_alpha
            return UiCore::rgba(255, 255, 255, far)

        # Move an effect's strength between what a BLACK surface needs and what a
        # WHITE one needs, in proportion to how light this surface actually is.
        #
        # A threshold here was wrong, and visibly so: the accents in the shipped
        # showcase straddle it -- coral measures 130 and the ocean blue 117 --
        # so two bars of the same saturation, side by side in one chart, got
        # visibly different rims because one landed a step above the midpoint.
        # Lighting is continuous; a cliff in the policy shows up as a cliff in
        # the picture.
        def blend(at_black: i64, at_white: i64, luminance: i64) -> u8:
            bounded: i64 = UiCore::channel(luminance)
            mixed: i64 = at_black + (at_white - at_black) * bounded / 255
            return UiCore::channel(mixed).u8()

        # One command, one method. A painter is a TYPE, not a value: its state is
        # the backend's own (SDL3's renderer handle, the component's wire cursor),
        # so the methods are static and the specialization inlines them.
        protocol Painter:
            def push_clip(box: UiCore::Rect) -> void can[Ui.Draw]
            def pop_clip() -> void can[Ui.Draw]
            def clear(color: UiCore::Color) -> void can[Ui.Draw]
            def fill_rect(box: UiCore::Rect, color: UiCore::Color, depth: UiCore::SurfaceDepth) -> void can[Ui.Draw]
            def fill_circle(disc: UiCore::Circle, color: UiCore::Color, depth: UiCore::SurfaceDepth) -> void can[Ui.Draw]
            def fill_triangle(tri: UiCore::Triangle, color: UiCore::Color) -> void can[Ui.Draw]
            def fill_line(segment: UiCore::Line, color: UiCore::Color, width: f32) -> void can[Ui.Draw]
            # Text needs both: it rasterizes (Draw) through font metrics (Text).
            def draw_text(run: UiCore::TextRun, color: UiCore::Color) -> void can[Ui.Draw, Ui.Text]

        # Replay a bounded slice of this frame's commands through one painter.
        # Custom backends use the slice form when they interleave Elisa-owned
        # deferred work with retained commands; ordinary backends still call
        # `replay`, which covers the complete batch.
        def replay_range[P: Painter](start: usize, end: usize) -> void can[Ui.Draw, Ui.Text]:
            total: usize = UiCore::command_count()
            first: usize = start if start < total else total
            last: usize = end if end < total else total
            return if first >= last
            for index in first..<last:
                clipped: bool = UiCore::command_has_clip(index)
                P.push_clip(UiCore::command_clip_at(index)) if clipped
                match UiCore::command_at(index):
                    UiCore::Command.Clear(color):
                        P.clear(color)
                    UiCore::Command.FillRect(box, color):
                        P.fill_rect(box, color, UiCore::command_depth_at(index))
                    UiCore::Command.FillCircle(disc, color):
                        P.fill_circle(disc, color, UiCore::command_depth_at(index))
                    UiCore::Command.FillTriangle(tri, color):
                        P.fill_triangle(tri, color)
                    UiCore::Command.FillLine(segment, color):
                        P.fill_line(segment, color, UiCore::command_stroke_width_at(index))
                    UiCore::Command.DrawText(run, color):
                        P.draw_text(run, color)
                P.pop_clip() if clipped

        # Replay this frame's commands through one painter: the only place the
        # command enum is matched for painting.
        def replay[P: Painter]() -> void can[Ui.Draw, Ui.Text]:
            UiPaint::replay_range[P](0, UiCore::command_count())

    private:
        def sheen_tint(style: RoundedRectStyle) -> u8:
            return 0 if style.sheen_is_shadow else 255

        # The lit edge is never DIMMER than the outline that defines the shape:
        # a bevel weaker than the hairline would read as a nick in the rim.
        def rim_alpha(style: RoundedRectStyle) -> u8:
            return style.bevel_alpha if style.bevel_alpha > style.hairline_alpha else style.hairline_alpha
