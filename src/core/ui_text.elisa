# Small, backend-neutral text indexing helpers.
#
# Native text protocols do not all use the same range unit. SDL and the C app
# boundary describe marked-text offsets as UTF-8 scalar counts, while AppKit
# uses UTF-16 units. Keep the scalar counter here so byte bounds are never
# mistaken for the protocol's character bound at one of those seams.

module UiText:
    public:
        # Advance over one UTF-8 encoded scalar-sized sequence. Host text is
        # expected to be valid UTF-8, but malformed input still consumes one
        # byte at a time so counting a hostile payload remains bounded and
        # deterministic instead of reading past the supplied view.  Validate
        # continuation bytes and the boundary-sensitive lead-byte ranges here;
        # merely looking at the lead byte would skip following ASCII or admit
        # surrogate/out-of-range encodings as one scalar.
        def utf8_scalar_bytes(text: sview, position: usize) -> usize:
            return 0 if text.len <= 0 or position >= text.len.usize()
            first: u32 = text.data[position].u32()
            return 1 if first < 128 or first >= 248
            width: mutable usize = 1
            width <- 2 if first >= 194 and first <= 223
            width <- 3 if first >= 224 and first <= 239
            width <- 4 if first >= 240 and first <= 244
            return 1 if width == 1 or width > text.len.usize() - position
            for index in 1..<width:
                continuation: u32 = text.data[position + index].u32()
                return 1 if continuation < 128 or continuation > 191
            second: u32 = text.data[position + 1].u32()
            return 1 if first == 224 and second < 160
            return 1 if first == 237 and second >= 160
            return 1 if first == 240 and second < 144
            return 1 if first == 244 and second >= 144
            return width

        # Return the longest well-formed UTF-8 prefix that fits byte_limit.
        # Counted views can come directly from a foreign ABI, so a byte cap
        # must not split a multibyte scalar or preserve malformed bytes for a
        # painter/native string adapter. `utf8_scalar_bytes` deliberately uses
        # one-byte recovery for counters; this helper instead stops before the
        # first malformed or truncated scalar.
        def valid_utf8_prefix(text: sview, byte_limit: usize) -> usize:
            return 0 if text.len <= 0
            total: usize = text.len.usize()
            limit: usize = byte_limit if byte_limit < total else total
            cursor: mutable usize = 0
            while cursor < limit |cursor, limit|:
                first: u32 = text.data[cursor].u32()
                width: usize = utf8_scalar_bytes(text, cursor)
                # A high-bit byte that decoded to one byte is an invalid lead,
                # a bad continuation, or an invalid/overlong scalar.
                return cursor if first >= 128 and width == 1
                return cursor if width == 0 or width > limit - cursor
                cursor <- cursor + width
            return cursor

        # Count the scalar-sized units in a bounded UTF-8 view. This is a
        # protocol bound, not a grapheme count: a combining sequence or an
        # emoji ZWJ sequence contributes one unit per encoded scalar, matching
        # SDL's marked-text range convention.
        def utf8_scalar_count(text: sview) -> usize:
            return 0 if text.len <= 0
            limit: usize = text.len.usize()
            cursor: mutable usize = 0
            count: mutable usize = 0
            while cursor < limit |cursor, count, limit|:
                width: usize = utf8_scalar_bytes(text, cursor)
                return count if width == 0
                cursor <- cursor + width
                count <- count + 1
            return count

        # Count UTF-16 code units in a bounded UTF-8 view. Native AppKit text
        # ranges use this unit: BMP scalars consume one unit and supplementary
        # scalars (four-byte UTF-8 sequences) consume a surrogate pair. Invalid
        # or truncated input follows the same one-byte recovery as the scalar
        # counter, keeping hostile payloads bounded and deterministic.
        def utf16_unit_count(text: sview) -> usize:
            return 0 if text.len <= 0
            limit: usize = text.len.usize()
            cursor: mutable usize = 0
            count: mutable usize = 0
            while cursor < limit |cursor, count, limit|:
                width: usize = utf8_scalar_bytes(text, cursor)
                return count if width == 0
                count <- count + (2 if width == 4 else 1)
                cursor <- cursor + width
            return count
