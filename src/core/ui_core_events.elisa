extend UiCore:
    public:
        # The constructors for every ordinal that arrives from outside: a raw
        # integer from a host or a C caller, named into its closed set. A const
        # enum IS its backing, so each of these is a cast the compiler erases --
        # they exist because the cast syntax cannot be qualified, not because a
        # conversion has to happen.
        def Key(raw: i32) -> Key:
            return raw.Key()

        def Pad(raw: i32) -> Pad:
            return raw.Pad()

        def PadAxis(raw: i32) -> PadAxis:
            return raw.PadAxis()

        def WireKind(raw: i32) -> WireKind:
            return raw.WireKind()

        # The packed event boundary accepts raw integers from C and WIT hosts,
        # while the typed hierarchy promises closed key, pointer-button and
        # gamepad sets. Keep the membership checks beside the casts so an
        # unknown host ordinal can never become an invalid typed value in an app.
        def key_is_valid(raw: i32) -> bool:
            return true if raw == Key.Space.i32() or raw == Key.Apostrophe.i32() or raw == Key.Comma.i32() or raw == Key.Minus.i32() or raw == Key.Period.i32() or raw == Key.Slash.i32()
            return true if raw >= Key.Digit0.i32() and raw <= Key.Digit9.i32()
            return true if raw == Key.Semicolon.i32() or raw == Key.Equal.i32()
            return true if raw >= Key.A.i32() and raw <= Key.Z.i32()
            return true if raw == Key.LeftBracket.i32() or raw == Key.Backslash.i32() or raw == Key.RightBracket.i32() or raw == Key.Backtick.i32()
            return true if raw >= Key.Escape.i32() and raw <= Key.End.i32()
            return true if raw >= Key.F1.i32() and raw <= Key.F12.i32()
            return raw >= Key.LeftShift.i32() and raw <= Key.RightSuper.i32()

        def pad_is_valid(raw: i32) -> bool:
            return raw >= Pad.South.i32() and raw <= Pad.RightTrigger2.i32()

        def pad_axis_is_valid(raw: i32) -> bool:
            return raw >= PadAxis.LeftX.i32() and raw <= PadAxis.DPadY.i32()

        def pointer_button_is_valid(raw: i32) -> bool:
            return raw >= PointerButton.Primary.i32() and raw <= PointerButton.Forward.i32()

        # ---- The flat boundary ----
        #
        # Everything above this line speaks in variants. These three are the only
        # place the ordinal encoding is written down, so a backend that receives
        # loose scalars (WIT) or a C caller that wants a POD struct converts once
        # here rather than spreading tag arithmetic through the tree.

        # The ordinal a kind travels as. Exhaustive on purpose: adding a leaf without
        # giving it a number is a compile error, not a silent zero.
        def wire_kind(event: Event) -> WireKind:
            match event:
                Event.None:
                    return WireKind.None
                Event.Quit:
                    return WireKind.Quit
                Event.Resize(size):
                    return WireKind.Resize
                Event.FocusGained:
                    return WireKind.FocusGained
                Event.FocusLost:
                    return WireKind.FocusLost
                PointerEvent.Move(at):
                    return WireKind.PointerMove
                PointerEvent.Down(at, button):
                    return WireKind.PointerDown
                PointerEvent.Up(at, button):
                    return WireKind.PointerUp
                PointerEvent.Leave:
                    return WireKind.PointerLeave
                PointerEvent.Scroll(at, delta):
                    return WireKind.Scroll
                KeyEvent.Down(code):
                    return WireKind.KeyDown
                KeyEvent.Up(code):
                    return WireKind.KeyUp
                GamepadEvent.Button(button, value):
                    return WireKind.GamepadButton
                GamepadEvent.Axis(axis, value):
                    return WireKind.GamepadAxis

        # Flatten. Fields a kind does not use stay zero, which is what the flat
        # record always meant.
        def to_record(event: Event) -> EventRecord:
            record: mutable EventRecord = EventRecord{kind: wire_kind(event), x: 0.0, y: 0.0, dx: 0.0, dy: 0.0, code: 0}
            match event:
                Event.Resize(size):
                    # Resize extents are part of the same geometry contract as
                    # viewport and retained boxes. A caller can construct the
                    # sealed event with a raw `Size{...}` value, bypassing the
                    # convenience constructor, so keep the exported wire
                    # record bounded before a C/WIT host receives it.
                    record with { x <- bounded_extent(size.width), y <- bounded_extent(size.height) }
                PointerEvent.Move(at):
                    record with { x <- bounded_coordinate(at.x), y <- bounded_coordinate(at.y) }
                PointerEvent.Down(at, button):
                    record with { x <- bounded_coordinate(at.x), y <- bounded_coordinate(at.y), code <- button if pointer_button_is_valid(button) else NO_POINTER_BUTTON }
                PointerEvent.Up(at, button):
                    record with { x <- bounded_coordinate(at.x), y <- bounded_coordinate(at.y), code <- button if pointer_button_is_valid(button) else NO_POINTER_BUTTON }
                PointerEvent.Scroll(at, delta):
                    record with { x <- bounded_coordinate(at.x), y <- bounded_coordinate(at.y), dx <- bounded_coordinate(delta.x), dy <- bounded_coordinate(delta.y) }
                KeyEvent.Down(code):
                    record.code <- code.i32() if key_is_valid(code.i32()) else -1
                KeyEvent.Up(code):
                    record.code <- code.i32() if key_is_valid(code.i32()) else -1
                GamepadEvent.Button(button, value):
                    record with { dx <- normalized_unit(value), code <- button.i32() if pad_is_valid(button.i32()) else -1 }
                GamepadEvent.Axis(axis, value):
                    record with { dx <- normalized_axis(value), code <- axis.i32() if pad_axis_is_valid(axis.i32()) else -1 }
                Event.None:
                    pass
                Event.Quit:
                    pass
                Event.FocusGained:
                    pass
                Event.FocusLost:
                    pass
                PointerEvent.Leave:
                    pass
            return record

        # Rebuild. An unknown ordinal is `None` rather than a panic: the host is
        # free to grow its event set faster than this library does.
        def from_record(record: EventRecord) -> Event:
            # EventRecord is the raw C/WIT boundary. Normalize every numeric
            # payload here before rebuilding a typed event so hosts cannot
            # inject NaN/infinity into hit testing, layout, or scroll policy.
            at: Vec2 = Vec2(bounded_coordinate(record.x), bounded_coordinate(record.y))
            return match record.kind:
                WireKind.Quit:
                    Event.Quit
                WireKind.Resize:
                    # Keep decoded resize extents on the same finite geometry
                    # cap as the flattened record and viewport setters. A raw
                    # host record can bypass `to_record`, so nonnegative-only
                    # normalization here would still expose arbitrarily large
                    # dimensions to application lifecycle code.
                    Event.Resize(size: Size(bounded_extent(record.x), bounded_extent(record.y)))
                WireKind.FocusGained:
                    Event.FocusGained
                WireKind.FocusLost:
                    Event.FocusLost
                WireKind.PointerMove:
                    PointerEvent.Move(at: at)
                WireKind.PointerDown:
                    return Event.None if not pointer_button_is_valid(record.code)
                    PointerEvent.Down(at: at, button: record.code.PointerButton())
                WireKind.PointerUp:
                    return Event.None if not pointer_button_is_valid(record.code)
                    PointerEvent.Up(at: at, button: record.code.PointerButton())
                WireKind.PointerLeave:
                    PointerEvent.Leave
                WireKind.Scroll:
                    PointerEvent.Scroll(at: at, delta: Vec2(bounded_coordinate(record.dx), bounded_coordinate(record.dy)))
                WireKind.KeyDown:
                    return Event.None if not key_is_valid(record.code)
                    KeyEvent.Down(code: record.code.Key())
                WireKind.KeyUp:
                    return Event.None if not key_is_valid(record.code)
                    KeyEvent.Up(code: record.code.Key())
                WireKind.GamepadButton:
                    return Event.None if not pad_is_valid(record.code)
                    GamepadEvent.Button(button: record.code.Pad(), value: normalized_unit(record.dx))
                WireKind.GamepadAxis:
                    return Event.None if not pad_axis_is_valid(record.code)
                    GamepadEvent.Axis(axis: record.code.PadAxis(), value: normalized_axis(record.dx))
                _:
                    Event.None

        # Typed backends may construct an event directly instead of receiving a
        # flat host record. Round-trip those values through the same boundary
        # conversion so coordinates, extents, ranges, and enum membership are
        # normalized identically regardless of which backend produced them.
        def normalize_event(event: Event) -> Event:
            return from_record(to_record(event))

    private:
        def normalized_axis(value: f32) -> f32:
            safe: f32 = finite_or_zero(value)
            return -1.0 if safe < -1.0
            return 1.0 if safe > 1.0
            return safe
