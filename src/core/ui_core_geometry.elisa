extend UiCore:
    public:
        # Short constructors named for the type they build, so a call site reads as
        # geometry rather than as a list of floats. `rgb`/`rgba` keep their own names:
        # they are two constructors for ONE type, and the channel set is the whole
        # distinction between them, which a pair of `Color` overloads would throw away.
        def Vec2(x: f32, y: f32) -> Vec2:
            return Vec2{x: bounded_coordinate(x), y: bounded_coordinate(y)}

        def Size(width: f32, height: f32) -> Size:
            return Size{width: bounded_extent(width), height: bounded_extent(height)}

        def Rect(x: f32, y: f32, width: f32, height: f32) -> Rect:
            return Rect{origin: Vec2(x, y), size: Size(width, height)}

        def rgba(r: u8, g: u8, b: u8, a: u8) -> Color:
            return Color{r: r, g: g, b: b, a: a}

        def rgb(r: u8, g: u8, b: u8) -> Color:
            return Color{r: r, g: g, b: b, a: 255}

        # A rectangle's far edges, for hit testing and layout.
        def right_edge(box: Rect) -> f32:
            origin: f32 = bounded_coordinate(box.origin.x)
            extent: f32 = bounded_extent(box.size.width)
            # Bound the derived edge too. A valid origin and extent can still
            # sum past the shared coordinate envelope when a caller places a
            # large box near the positive limit.
            return bounded_coordinate(origin + extent)

        def bottom_edge(box: Rect) -> f32:
            origin: f32 = bounded_coordinate(box.origin.y)
            extent: f32 = bounded_extent(box.size.height)
            return bounded_coordinate(origin + extent)

        def contains(box: Rect, point: Vec2) -> bool:
            # Do not turn malformed pointer input into an origin hit. The
            # widget routers use this primitive for hit testing, and callers
            # can construct the public Vec2 record directly without passing
            # through its sanitizing constructor.
            x_difference: f32 = point.x - point.x
            y_difference: f32 = point.y - point.y
            return false if x_difference != x_difference or y_difference != y_difference
            safe_box: Rect = Rect(box.origin.x, box.origin.y, box.size.width, box.size.height)
            safe_point: Vec2 = Vec2(point.x, point.y)
            return safe_point.x >= safe_box.origin.x and safe_point.y >= safe_box.origin.y and safe_point.x < right_edge(safe_box) and safe_point.y < bottom_edge(safe_box)

        # Select one finite backing scale for a logical surface. Keeping this
        # decision in shared Elisa geometry makes AppKit/Skia and other hosts
        # agree on aspect-preserving scaling without embedding policy in C++.
        def backing_scale(logical_width: f32, logical_height: f32, pixel_width: f32, pixel_height: f32) -> f32:
            return 0.0 if not is_finite(logical_width) or not is_finite(logical_height) or not is_finite(pixel_width) or not is_finite(pixel_height)
            return 0.0 if logical_width <= 0.0 or logical_height <= 0.0 or pixel_width <= 0.0 or pixel_height <= 0.0
            scale_x: f32 = pixel_width / logical_width
            scale_y: f32 = pixel_height / logical_height
            return 0.0 if not is_finite(scale_x) or not is_finite(scale_y)
            smaller: f32 = scale_x if scale_x < scale_y else scale_y
            return bounded_extent(smaller)

        def clear(color: Color) -> void:
            push_command(Command.Clear(color))

        # ONE NAME PER OPERATION, overloaded on the shape. Elisa resolves a free
        # call by its first argument's type, so `fill` needs no protocol and no
        # per-shape suffix; adding a shape means adding one overload.
        def fill(box: Rect, color: Color) -> void:
            safe_box: Rect = Rect{origin: Vec2{x: bounded_coordinate(box.origin.x), y: bounded_coordinate(box.origin.y)}, size: Size{width: bounded_extent(box.size.width), height: bounded_extent(box.size.height)}}
            push_command(Command.FillRect(safe_box, color))

        # Mark a rectangle as an intentional elevated surface. This explicit
        # opt-in keeps appearance independent of dimensions; ordinary fills
        # remain plain even when they happen to be wide and short.
        def fill_elevated(box: Rect, color: Color) -> void:
            safe_box: Rect = Rect{origin: Vec2{x: bounded_coordinate(box.origin.x), y: bounded_coordinate(box.origin.y)}, size: Size{width: bounded_extent(box.size.width), height: bounded_extent(box.size.height)}}
            push_command_with_style(Command.FillRect(safe_box, color), SurfaceDepth.Raised)

        # Mark a rectangle as an intentional RECESSED surface: a text field, a
        # slider track, a well. The opposite lighting to fill_elevated, and the
        # same explicit opt-in -- nothing infers it from the shape.
        def fill_inset(box: Rect, color: Color) -> void:
            safe_box: Rect = Rect{origin: Vec2{x: bounded_coordinate(box.origin.x), y: bounded_coordinate(box.origin.y)}, size: Size{width: bounded_extent(box.size.width), height: bounded_extent(box.size.height)}}
            push_command_with_style(Command.FillRect(safe_box, color), SurfaceDepth.Inset)

        # SHAPE AS WELL AS DEPTH. See UiCore::CornerStyle: the derived corner
        # policy is right for almost everything, and this is how an
        # application states the cases it cannot derive -- a capsule tag, a
        # square-cornered image plate. Every fill above is this call with
        # CornerStyle.Automatic, which is why nothing else had to change.
        def fill_shaped(box: Rect, color: Color, depth: SurfaceDepth, corner: CornerStyle) -> void:
            safe_box: Rect = Rect{origin: Vec2{x: bounded_coordinate(box.origin.x), y: bounded_coordinate(box.origin.y)}, size: Size{width: bounded_extent(box.size.width), height: bounded_extent(box.size.height)}}
            push_command_shaped(Command.FillRect(safe_box, color), depth, DEFAULT_STROKE_WIDTH, corner)

        def fill(disc: Circle, color: Color) -> void:
            safe_disc: Circle = Circle{center: Vec2{x: bounded_coordinate(disc.center.x), y: bounded_coordinate(disc.center.y)}, radius: bounded_extent(disc.radius)}
            push_command(Command.FillCircle(safe_disc, color))

        # A raised disc: a slider thumb, a handle, a dot that sits ON the
        # surface rather than in it. Same explicit opt-in as the rectangle --
        # an ordinary circle stays plain however big it is.
        def fill_elevated(disc: Circle, color: Color) -> void:
            safe_disc: Circle = Circle{center: Vec2{x: bounded_coordinate(disc.center.x), y: bounded_coordinate(disc.center.y)}, radius: bounded_extent(disc.radius)}
            push_command_with_style(Command.FillCircle(safe_disc, color), SurfaceDepth.Raised)

        def fill(tri: Triangle, color: Color) -> void:
            safe_tri: Triangle = Triangle{a: Vec2{x: bounded_coordinate(tri.a.x), y: bounded_coordinate(tri.a.y)}, b: Vec2{x: bounded_coordinate(tri.b.x), y: bounded_coordinate(tri.b.y)}, c: Vec2{x: bounded_coordinate(tri.c.x), y: bounded_coordinate(tri.c.y)}}
            push_command(Command.FillTriangle(safe_tri, color))

        def fill(segment: Line, color: Color) -> void:
            safe_segment: Line = Line{from_point: Vec2{x: bounded_coordinate(segment.from_point.x), y: bounded_coordinate(segment.from_point.y)}, to_point: Vec2{x: bounded_coordinate(segment.to_point.x), y: bounded_coordinate(segment.to_point.y)}}
            push_command(Command.FillLine(safe_segment, color))

        # A line WITH WEIGHT.
        #
        # `fill(Line, ...)` is a hairline and always was, in every backend: the
        # painters passed a constant width because the command carried none.
        # That is fine for a divider and wrong for everything else -- a
        # checkmark, an orbit spoke, a series in a chart. A framework whose
        # thickest available line is one pixel cannot draw a modern graph.
        def fill_stroke(segment: Line, width: f32, color: Color) -> void:
            safe_segment: Line = Line{from_point: Vec2{x: bounded_coordinate(segment.from_point.x), y: bounded_coordinate(segment.from_point.y)}, to_point: Vec2{x: bounded_coordinate(segment.to_point.x), y: bounded_coordinate(segment.to_point.y)}}
            push_command_with_stroke(Command.FillLine(safe_segment, color), bounded_extent(width))

        def draw(run: TextRun, color: Color) -> void:
            safe_run: TextRun = TextRun(run.origin, run.size, run.text, run.weighted)
            push_command(Command.DrawText(safe_run, color))
        def TextRun(origin: Vec2, size: f32, body: sview) -> TextRun:
            return TextRun(origin, size, body, false)

        def TextRun(origin: Vec2, size: f32, body: sview, weighted: bool) -> TextRun:
            safe_body: sview = bounded_text(body)
            return TextRun{origin: Vec2{x: bounded_coordinate(origin.x), y: bounded_coordinate(origin.y)}, size: bounded_extent(size), text: safe_body, weighted: weighted}
