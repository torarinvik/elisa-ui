extend UiCore:
    public:
        # Short constructors named for the type they build, so a call site reads as
        # geometry rather than as a list of floats. `rgb`/`rgba` keep their own names:
        # they are two constructors for ONE type, and the channel set is the whole
        # distinction between them, which a pair of `Color` overloads would throw away.
        def Vec2(x: f32, y: f32) -> Vec2:
            return Vec2{x: bounded_coordinate(x), y: bounded_coordinate(y)}

        def Size(width: f32, height: f32) -> Size:
            return Size{width: bounded_extent(width), height: bounded_extent(height)}

        def Rect(x: f32, y: f32, width: f32, height: f32) -> Rect:
            return Rect{origin: Vec2(x, y), size: Size(width, height)}

        def rgba(r: u8, g: u8, b: u8, a: u8) -> Color:
            return Color{r: r, g: g, b: b, a: a}

        def rgb(r: u8, g: u8, b: u8) -> Color:
            return Color{r: r, g: g, b: b, a: 255}

        # A rectangle's far edges, for hit testing and layout.
        def right_edge(box: Rect) -> f32:
            origin: f32 = bounded_coordinate(box.origin.x)
            extent: f32 = bounded_extent(box.size.width)
            # Bound the derived edge too. A valid origin and extent can still
            # sum past the shared coordinate envelope when a caller places a
            # large box near the positive limit.
            return bounded_coordinate(origin + extent)

        def bottom_edge(box: Rect) -> f32:
            origin: f32 = bounded_coordinate(box.origin.y)
            extent: f32 = bounded_extent(box.size.height)
            return bounded_coordinate(origin + extent)

        def contains(box: Rect, point: Vec2) -> bool:
            safe_box: Rect = Rect(box.origin.x, box.origin.y, box.size.width, box.size.height)
            safe_point: Vec2 = Vec2(point.x, point.y)
            return safe_point.x >= safe_box.origin.x and safe_point.y >= safe_box.origin.y and safe_point.x < right_edge(safe_box) and safe_point.y < bottom_edge(safe_box)

        def clear(color: Color) -> void:
            push_command(Command.Clear(color))

        # ONE NAME PER OPERATION, overloaded on the shape. Elisa resolves a free
        # call by its first argument's type, so `fill` needs no protocol and no
        # per-shape suffix; adding a shape means adding one overload.
        def fill(box: Rect, color: Color) -> void:
            safe_box: Rect = Rect{origin: Vec2{x: bounded_coordinate(box.origin.x), y: bounded_coordinate(box.origin.y)}, size: Size{width: bounded_extent(box.size.width), height: bounded_extent(box.size.height)}}
            push_command(Command.FillRect(safe_box, color))

        def fill(disc: Circle, color: Color) -> void:
            safe_disc: Circle = Circle{center: Vec2{x: bounded_coordinate(disc.center.x), y: bounded_coordinate(disc.center.y)}, radius: bounded_extent(disc.radius)}
            push_command(Command.FillCircle(safe_disc, color))

        def fill(tri: Triangle, color: Color) -> void:
            safe_tri: Triangle = Triangle{a: Vec2{x: bounded_coordinate(tri.a.x), y: bounded_coordinate(tri.a.y)}, b: Vec2{x: bounded_coordinate(tri.b.x), y: bounded_coordinate(tri.b.y)}, c: Vec2{x: bounded_coordinate(tri.c.x), y: bounded_coordinate(tri.c.y)}}
            push_command(Command.FillTriangle(safe_tri, color))

        def fill(segment: Line, color: Color) -> void:
            safe_segment: Line = Line{from_point: Vec2{x: bounded_coordinate(segment.from_point.x), y: bounded_coordinate(segment.from_point.y)}, to_point: Vec2{x: bounded_coordinate(segment.to_point.x), y: bounded_coordinate(segment.to_point.y)}}
            push_command(Command.FillLine(safe_segment, color))

        def draw(run: TextRun, color: Color) -> void:
            safe_run: TextRun = TextRun(run.origin, run.size, run.text)
            push_command(Command.DrawText(safe_run, color))
        def TextRun(origin: Vec2, size: f32, body: sview) -> TextRun:
            safe_body: sview = bounded_text(body)
            return TextRun{origin: Vec2{x: bounded_coordinate(origin.x), y: bounded_coordinate(origin.y)}, size: bounded_extent(size), text: safe_body}
