# Deterministic Elisa-side driver for interaction and frame tests.
#
# Native and hosted backends own their production event loops, but the retained
# framework must also be testable without a window, clock, renderer, or host.
# `UiHarness` supplies that small lifecycle: it injects a monotonic test clock,
# forwards typed events through the normal application contract, and starts a
# fresh command frame before each app render. No platform ABI is involved.

include "../core/ui_core.elisa"
include "../core/ui_capabilities.elisa"
include "../core/ui_lifecycle.elisa"
include "../core/ui_metrics.elisa"
include "../widgets/ui_resources.elisa"

module UiHarness:
    private:
        global mutable test_time: f64 = 0.0

    public:
        # Start a deterministic application session. The application still
        # receives its ordinary app_init callback, so this exercises the same
        # initialization path as a native or hosted backend.
        def start(width: f32, height: f32) -> void:
            UiLifecycle::reset()
            UiCapabilities::use_harness()
            UiEvents::reset()
            return if not UiLifecycle::begin()
            UiMetrics::reset()
            test_time <- 0.0
            UiResources::reset()
            UiCore::set_viewport(width, height)
            UiCore::set_frame_time(test_time)
            app_init()
            _ = UiLifecycle::ready()

        def stop() -> void:
            UiResources::reset()
            _ = UiLifecycle::stop()

        def is_running() -> bool:
            return UiLifecycle::is_started()

        # Absolute and relative clock injection both normalize hostile values
        # through UiCore's finite helper. Time never moves backwards in this
        # harness, matching the monotonic production clocks.
        def set_time(seconds: f64) -> void:
            return if not UiLifecycle::is_started()
            safe: f64 = UiCore::finite_or_zero_f64(seconds)
            return if safe < test_time
            test_time <- safe
            UiCore::set_frame_time(test_time)

        def advance_time(seconds: f64) -> void:
            return if not UiLifecycle::is_started()
            safe: f64 = UiCore::finite_or_zero_f64(seconds)
            return if safe <= 0.0
            set_time(test_time + safe)

        def time() -> f64:
            return test_time

        # Event injection goes through the public application callback instead
        # of reaching into a widget implementation. Applications that use the
        # flat layer can route this to UiFlat::handle in their app_event body,
        # exactly as they do on production backends.
        def dispatch(event: UiCore::Event) -> void:
            return if not UiLifecycle::is_started()
            return if not UiEvents::enqueue(event)
            # An app callback may stop this session (or rotate to a new one)
            # while handling the first event. Capture the owner generation
            # before draining so a queued follow-up cannot cross that
            # lifecycle boundary into stale application state.
            drain_generation: u32 = UiLifecycle::generation()
            queued: mutable UiCore::Event = UiCore::Event.None
            while UiEvents::dequeue(queued):
                continue if not UiLifecycle::is_started() or UiLifecycle::generation() != drain_generation
                app_event(queued)

        def resize(width: f32, height: f32) -> void:
            return if not UiLifecycle::is_started()
            UiCore::set_viewport(width, height)
            dispatch(UiCore::Event.Resize(size: UiCore::Size(width, height)))

        def focus_lost() -> void:
            return if not UiLifecycle::focus_lost()
            dispatch(UiCore::Event.FocusLost)

        def focus_gained() -> void:
            return if not UiLifecycle::focus_gained()
            dispatch(UiCore::Event.FocusGained)

        # Render one deterministic frame. begin_frame clears the retained
        # command/semantic batches and the app then follows its normal frame
        # contract; no painter or native surface is needed for assertions.
        def frame() -> void:
            return if not UiLifecycle::can_render()
            UiCore::set_frame_time(test_time)
            UiMetrics::begin_frame(test_time)
            UiCore::begin_frame()
            app_frame()
            UiMetrics::mark_application(test_time)
            UiMetrics::mark_semantics(test_time)
            UiMetrics::mark_paint(test_time)
            UiMetrics::finish_frame(test_time)

        def run_frames(count: usize, delta: f64) -> void:
            return if not UiLifecycle::can_render()
            index: mutable usize = 0
            while index < count |index|:
                frame()
                advance_time(delta)
                index <- index + 1

        def command_count() -> usize:
            return UiCore::command_count()

        def command_overflowed() -> bool:
            return UiCore::command_overflowed()

        def semantic_count() -> usize:
            return UiCore::accessibility_count()

        def semantic_overflowed() -> bool:
            return UiCore::accessibility_overflowed()

        def next_frame_delay() -> f32:
            return UiCore::frame_delay()

        # Resource callbacks use the same deterministic seam as events and
        # frames. Stopping the harness resets generations first, so a late
        # completion cannot revive a disposed resource slot.
        def request_resource(identifier: sview, owner: u32) -> UiResources::Handle:
            return UiResources::invalid() if not UiLifecycle::is_started()
            return UiResources::request(identifier, owner)

        def resource_state(handle: UiResources::Handle) -> UiResources::State:
            return UiResources::state(handle)

        def set_resource_progress(handle: UiResources::Handle, network: f32, decode: f32) -> bool:
            return false if not UiLifecycle::is_started()
            return UiResources::set_progress(handle, network, decode)

        def set_resource_demand(handle: UiResources::Handle, priority: u32) -> bool:
            return false if not UiLifecycle::is_started()
            return UiResources::set_demand(handle, priority)

        def clear_resource_demand(handle: UiResources::Handle) -> bool:
            return false if not UiLifecycle::is_started()
            return UiResources::clear_demand(handle)

        def set_resource_state(handle: UiResources::Handle, state: UiResources::State) -> bool:
            return false if not UiLifecycle::is_started()
            return UiResources::set_state(handle, state)

        def cancel_resource(handle: UiResources::Handle) -> bool:
            return false if not UiLifecycle::is_started()
            return UiResources::cancel(handle)

        def dispose_resource(handle: UiResources::Handle) -> bool:
            return false if not UiLifecycle::is_started()
            return UiResources::dispose(handle)

        def cancel_resources_for_owner(owner: u32) -> usize:
            return 0 if not UiLifecycle::is_started()
            return UiResources::cancel_owner(owner)

        def dispose_resources_for_owner(owner: u32) -> usize:
            return 0 if not UiLifecycle::is_started()
            return UiResources::dispose_owner(owner)
