# Default metric adapter for pixel-measured, grapheme-safe text layout.
#
# The reusable planner lives in `ui_text_measure_layout_core.elisa`; this
# facade binds it to the active platform metric hooks used by ordinary widgets.
# Custom renderers can include the core and provide their own width function.

include "./ui_text_measure_layout_core.elisa"
include "./ui_text_metrics.elisa"

extend UiTextMeasureLayout:
    public:
        # Use the framework's current font authority (CoreText, SDL_ttf,
        # WasmBrowser host metrics, or another selected platform adapter).
        def layout(text: sview, max_width: f32, size: f32) -> Layout:
            return layout_with_measure(text, max_width, size, ui_text_measure_layout_metric_width)

        # Use the same measured ranges and metric authority to map a local
        # pixel coordinate to a grapheme-safe source offset. Applications that
        # do not need a custom renderer can use this portable facade directly.
        def hit_test(text: sview, max_width: f32, size: f32, line_index: usize, local_x: f32) -> usize:
            planned: Layout = layout(text, max_width, size)
            return hit_test_line(text, line_index, local_x, planned.text_size, ui_text_measure_layout_metric_width)

        # Convert a source byte offset into a local caret coordinate using the
        # same floor-to-grapheme rule as `hit_test()`.
        def caret_x(text: sview, max_width: f32, size: f32, line_index: usize, byte_offset: usize) -> f32:
            planned: Layout = layout(text, max_width, size)
            return UiTextMeasureLayout::caret_x_for_line(text, line_index, byte_offset, planned.text_size, ui_text_measure_layout_metric_width)

def ui_text_measure_layout_metric_width(text: sview, size: f32) -> f32:
    return UiTextMetrics::width(text, size)
