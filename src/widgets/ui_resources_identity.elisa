# Resource identity, slot lifetime, and key matching.

extend UiResources:
    public:
        def resource_invalid() -> ResourceHandle:
            return ResourceHandle{slot: MAX_RESOURCES.u32(), generation: 0}

        def resource_is_valid(handle: ResourceHandle) -> bool:
            return handle.slot.usize() < resource_count and handle.generation == resource_generations[handle.slot.usize()] and resource_states[handle.slot.usize()] != State.Unrequested

        def resource_key_matches(slot: usize, key: sview) -> bool:
            # Keep this public diagnostic helper bounded just like request().
            # It can be called directly by a host, so relying on request's
            # length guard here would allow an oversized counted view to walk
            # past the fixed identifier arena.
            # An unrequested slot has no identity. In particular,
            # resource_clear_slot()
            # erases both its bytes and length, so treating an empty key as a
            # match would make a stale/cleared record look live to diagnostics.
            return false if slot >= MAX_RESOURCES or resource_states[slot] == State.Unrequested
            return false if not resource_identifier_is_valid(key)
            safe_key: sview = UiCore::bounded_text(key)
            return false if resource_identifier_lengths[slot] != safe_key.len.usize()
            for offset in 0..<safe_key.len:
                return false if resource_identifier_storage[slot * IDENTIFIER_CAPACITY + offset] != safe_key.data[offset]
            return true

    private:
        # Resource keys are the SDK's bounded relative virtual asset paths,
        # never native filesystem paths or URLs. Keep the same path shape as
        # the public WasmBrowser resources contract before a key enters the
        # coalescing table; the host still performs authoritative validation.
        def resource_identifier_is_valid(key: sview) -> bool:
            safe_key: sview = UiCore::bounded_text(key)
            return false if safe_key.len <= 0 or safe_key.len != key.len or safe_key.len >= IDENTIFIER_CAPACITY.i64()
            return false if safe_key.data[0] == 47
            component_start: mutable i64 = 0
            component_length: mutable i64 = 0
            for offset in 0..<safe_key.len:
                byte: u8 = safe_key.data[offset]
                if byte == 47:
                    return false if component_length == 0
                    return false if component_length == 1 and safe_key.data[component_start] == 46
                    return false if component_length == 2 and safe_key.data[component_start] == 46 and safe_key.data[component_start + 1] == 46
                    component_start <- offset + 1
                    component_length <- 0
                else:
                    return false if byte < 32 or byte == 58 or byte == 92 or byte == 127
                    return false if byte == 194 and offset + 1 < safe_key.len and safe_key.data[offset + 1] <= 159
                    component_length <- component_length + 1
            return false if component_length == 0
            return false if component_length == 1 and safe_key.data[component_start] == 46
            return false if component_length == 2 and safe_key.data[component_start] == 46 and safe_key.data[component_start + 1] == 46
            return true

        def resource_make_handle(slot: usize) -> ResourceHandle:
            return ResourceHandle{slot: slot.u32(), generation: resource_generations[slot]}

        def resource_clear_slot(slot: usize) -> void:
            next_generation: u32 = resource_generations[slot] + 1
            resource_generations[slot] <- 1 if next_generation == 0 else next_generation
            resource_states[slot] <- State.Unrequested
            resource_failure_kinds[slot] <- FailureKind.Unknown
            resource_owner_clear_slot(slot)
            resource_identifier_lengths[slot] <- 0
            for index in 0..<IDENTIFIER_CAPACITY:
                resource_identifier_storage[slot * IDENTIFIER_CAPACITY + index] <- 0
            UiResources::clear_metadata(slot)
            resource_downloaded[slot] <- 0.0
            resource_decoded[slot] <- 0.0
            resource_uploaded[slot] <- 0.0
            resource_demanded[slot] <- false
            resource_priorities[slot] <- 0
            resource_demand_owners[slot] <- 0

        def resource_mark_changed() -> void:
            UiCore::invalidate(UiCore::Invalidation.Resources)
            UiCore::invalidate(UiCore::Invalidation.Paint)

        def resource_failure_kind_is_valid(value: FailureKind) -> bool:
            return value == FailureKind.RetryableTransport or value == FailureKind.Corrupt or value == FailureKind.Incompatible

        def resource_state_is_valid(value: State) -> bool:
            return value == State.Requested or value == State.Ready or value == State.UnavailableOffline or value == State.Denied or value == State.Failed or value == State.Cancelled
