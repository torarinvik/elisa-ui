# Apply a host-observed OS permission fact to every live record of one kind.
# A request currently in flight is left for its matching prompt callback.
extend UiServices:
    public:
        def sync_kind(kind: ServiceKind, next: ConsentState, failure: ServiceFailureKind) -> usize:
            updated: mutable usize = 0
            return 0 if kind == ServiceKind.Unknown
            for slot in 0..<service_count_state:
                if service_active[slot] and service_kinds[slot] == kind:
                    updated <- updated + 1 if sync(make_handle(slot), next, failure)
            return updated
