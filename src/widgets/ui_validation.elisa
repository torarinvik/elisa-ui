# Bounded asynchronous validation state for dynamic forms.
#
# Validation observes application-owned field values; it never replaces those
# values. Each field has a stable identity and a monotonically changing
# revision token. A host task must resolve the revision it was given, so a late
# result from an older edit cannot overwrite the message for a newer value.

include "../core/ui_core.elisa"

module UiValidation:
    public:
        const MAX_FIELDS: usize = 128
        const MESSAGE_CAPACITY: usize = 256
        const NONE: usize = MAX_FIELDS

        const enum Status of i32:
            Idle = 0
            Validating = 1
            Valid = 2
            Invalid = 3
            Unavailable = 4

        struct Handle:
            slot: u32
            generation: u32

        struct Snapshot:
            fields: usize
            overflowed: bool

        def invalid() -> Handle:
            return Handle{slot: NONE.u32(), generation: 0}

        def is_valid(handle: Handle) -> bool:
            return handle.slot.usize() < MAX_FIELDS and validation_active[handle.slot.usize()] and validation_generations[handle.slot.usize()] == handle.generation

        def reset() -> void:
            for slot in 0..<MAX_FIELDS:
                validation_active[slot] <- false
                field_ids[slot] <- 0
                validation_owners[slot] <- 0
                validation_generations[slot] <- next_generation(validation_generations[slot])
                revisions[slot] <- 0
                statuses[slot] <- Status.Idle
                clear_message(slot)
            field_count <- 0
            validation_overflowed_state <- false
            mark_changed()

        # Bind one application field to a stable validation record. Rebinding
        # the same field ID reuses its status and revision instead of starting
        # a second request during every view rebuild.
        def bind(field_id: u32) -> Handle:
            return bind_owned(field_id, 0)

        # Associate a validation field with its owning view/task. Rebinding a
        # stable field ID updates that owner while preserving the pending
        # revision and user-visible status.
        def bind_owned(field_id: u32, owner: u32) -> Handle:
            for slot in 0..<field_count:
                if validation_active[slot] and field_ids[slot] == field_id:
                    validation_owners[slot] <- owner
                    return make_handle(slot)
            free_slot: mutable usize = NONE
            for slot in 0..<MAX_FIELDS:
                if not validation_active[slot]:
                    free_slot <- slot
                    break
            if free_slot == NONE:
                validation_overflowed_state <- true
                return invalid()
            validation_active[free_slot] <- true
            field_ids[free_slot] <- field_id
            validation_owners[free_slot] <- owner
            validation_generations[free_slot] <- next_generation(validation_generations[free_slot])
            revisions[free_slot] <- 0
            statuses[free_slot] <- Status.Idle
            clear_message(free_slot)
            field_count <- free_slot + 1 if free_slot >= field_count else field_count
            mark_changed()
            return make_handle(free_slot)

        def snapshot() -> Snapshot:
            total: mutable usize = 0
            for slot in 0..<field_count:
                total <- total + 1 if validation_active[slot]
            return Snapshot{fields: total, overflowed: validation_overflowed_state}

        def status(handle: Handle) -> Status:
            return Status.Idle if not is_valid(handle)
            return statuses[handle.slot.usize()]

        def revision(handle: Handle) -> u32:
            return 0 if not is_valid(handle)
            return revisions[handle.slot.usize()]

        def begin(handle: Handle) -> u32:
            return 0 if not is_valid(handle)
            slot: usize = handle.slot.usize()
            revisions[slot] <- next_revision(revisions[slot])
            statuses[slot] <- Status.Validating
            clear_message(slot)
            mark_changed()
            return revisions[slot]

        # Resolve only the currently pending revision. The accepted value and
        # the user's draft remain outside this registry, so a stale completion
        # cannot roll back edits or selection state.
        def resolve(handle: Handle, token: u32, next: Status, message: sview) -> bool:
            return false if not is_valid(handle) or token == 0 or message.len < 0
            # A counted view with bytes but no storage is malformed foreign
            # input, not an empty diagnostic. Reject it before resolving the
            # revision so a bad callback cannot silently clear a live error
            # message or advance the field out of its validating state.
            return false if message.len > 0 and message.data == null
            slot: usize = handle.slot.usize()
            return false if statuses[slot] != Status.Validating or revisions[slot] != token
            return false if next != Status.Valid and next != Status.Invalid and next != Status.Unavailable
            statuses[slot] <- next
            write_message(slot, message)
            mark_changed()
            return true

        def accept(handle: Handle, token: u32) -> bool:
            return resolve(handle, token, Status.Valid, "")

        def reject(handle: Handle, token: u32, message: sview) -> bool:
            return resolve(handle, token, Status.Invalid, message)

        def unavailable(handle: Handle, token: u32, message: sview) -> bool:
            return resolve(handle, token, Status.Unavailable, message)

        def clear(handle: Handle) -> bool:
            return false if not is_valid(handle)
            slot: usize = handle.slot.usize()
            statuses[slot] <- Status.Idle
            clear_message(slot)
            mark_changed()
            return true

        def field_id(handle: Handle) -> u32:
            return 0 if not is_valid(handle)
            return field_ids[handle.slot.usize()]

        def owner(handle: Handle) -> u32:
            return 0 if not is_valid(handle)
            return validation_owners[handle.slot.usize()]

        def message(handle: Handle) -> sview:
            return "" if not is_valid(handle)
            slot: usize = handle.slot.usize()
            offset: usize = slot * MESSAGE_CAPACITY
            return sview(&message_storage[offset], 0, message_lengths[slot].i64())

        def message_truncated(handle: Handle) -> bool:
            return is_valid(handle) and message_truncated_state[handle.slot.usize()]

        def is_pending(handle: Handle) -> bool:
            return is_valid(handle) and status(handle) == Status.Validating

        def has_error(handle: Handle) -> bool:
            return is_valid(handle) and (status(handle) == Status.Invalid or status(handle) == Status.Unavailable)

        # Disposal advances the generation before a slot can be reused, which
        # makes late validation completions harmless after a view disappears.
        def dispose(handle: Handle) -> bool:
            return false if not is_valid(handle)
            slot: usize = handle.slot.usize()
            clear_slot(slot)
            for _ in 0..<MAX_FIELDS:
                break if field_count == 0 or validation_active[field_count - 1]
                field_count <- field_count - 1
            mark_changed()
            return true

        # View/task teardown can invalidate every field it owns in one bounded
        # pass. Each slot advances its generation before reuse, so late host
        # completions carrying an old field handle are rejected.
        def dispose_owner(owner_id: u32) -> usize:
            released: mutable usize = 0
            for slot in 0..<field_count:
                if validation_active[slot] and validation_owners[slot] == owner_id:
                    clear_slot(slot)
                    released <- released + 1
            for _ in 0..<MAX_FIELDS:
                break if field_count == 0 or validation_active[field_count - 1]
                field_count <- field_count - 1
            mark_changed() if released > 0
            return released

    private:
        global mutable field_ids: u32[MAX_FIELDS] = zeroed
        global mutable validation_generations: u32[MAX_FIELDS] = zeroed
        global mutable revisions: u32[MAX_FIELDS] = zeroed
        global mutable statuses: Status[MAX_FIELDS] = zeroed
        global mutable validation_active: bool[MAX_FIELDS] = zeroed
        global mutable validation_owners: u32[MAX_FIELDS] = zeroed
        global mutable message_lengths: usize[MAX_FIELDS] = zeroed
        global mutable message_truncated_state: bool[MAX_FIELDS] = zeroed
        global mutable message_storage: u8[MAX_FIELDS * MESSAGE_CAPACITY] = zeroed
        global mutable field_count: usize = 0
        global mutable validation_overflowed_state: bool = false

        # Validation messages and pending/error affordances are visible UI
        # state. Keep their redraw and semantic invalidation in the shared
        # policy so every backend observes the same update contract.
        def mark_changed() -> void:
            UiCore::invalidate(UiCore::Invalidation.Paint)
            UiCore::invalidate(UiCore::Invalidation.Semantics)

        def next_generation(value: u32) -> u32:
            next: u32 = value + 1
            return 1 if next == 0 else next

        def next_revision(value: u32) -> u32:
            next: u32 = value + 1
            return 1 if next == 0 else next

        def clear_slot(slot: usize) -> void:
            return if slot >= MAX_FIELDS or not validation_active[slot]
            validation_active[slot] <- false
            field_ids[slot] <- 0
            validation_owners[slot] <- 0
            validation_generations[slot] <- next_generation(validation_generations[slot])
            revisions[slot] <- 0
            statuses[slot] <- Status.Idle
            clear_message(slot)

        def make_handle(slot: usize) -> Handle:
            return Handle{slot: slot.u32(), generation: validation_generations[slot]}

        def clear_message(slot: usize) -> void:
            message_lengths[slot] <- 0
            message_truncated_state[slot] <- false
            for index in 0..<MESSAGE_CAPACITY:
                message_storage[slot * MESSAGE_CAPACITY + index] <- 0

        def write_message(slot: usize, value: sview) -> void:
            return if slot >= MAX_FIELDS or value.len < 0
            # Validate the signed foreign length before narrowing it to
            # usize; otherwise a large sview length can wrap on wasm32.
            safe_value: sview = UiCore::bounded_text(value)
            take: mutable usize = MESSAGE_CAPACITY - 1
            take <- safe_value.len.usize() if safe_value.len < (MESSAGE_CAPACITY - 1).i64()
            take <- UiText::valid_utf8_prefix(safe_value, take)
            for index in 0..<MESSAGE_CAPACITY - 1:
                message_storage[slot * MESSAGE_CAPACITY + index] <- safe_value.data[index] if index < take else 0
            message_storage[slot * MESSAGE_CAPACITY + take] <- 0
            message_lengths[slot] <- take
            # Exactly MESSAGE_CAPACITY - 1 bytes fit beside the sentinel;
            # only a longer or malformed message has actually been truncated.
            message_truncated_state[slot] <- value.len > (MESSAGE_CAPACITY - 1).i64() or value.len != safe_value.len or take < safe_value.len
