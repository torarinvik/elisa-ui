# Bounded, backend-neutral text line-break policy.
#
# Shaping and pixel measurement stay with the renderer that owns the font. This
# module owns only safe UTF-8 scalar advancement and deterministic break points,
# returning ranges into the caller's original text without copying it.

include "../core/ui_core.elisa"

module UiTextLayout:
    public:
        const MAX_LINES: usize = 256

        struct LineRange:
            offset: usize
            length: usize
            columns: usize

        struct Layout:
            line_count: usize
            max_columns: usize
            source_length: usize
            overflowed: bool

        def reset() -> void:
            line_count_state <- 0
            source_length_state <- 0
            max_columns_state <- 1
            overflowed_state <- false
            for index in 0..<MAX_LINES:
                line_offsets[index] <- 0
                line_lengths[index] <- 0
                line_columns[index] <- 0

        # Plan lines using a scalar-column budget. A renderer may replace the
        # budget with measured pixel widths later, while retaining these UTF-8
        # and newline rules.
        def layout(text: sview, max_columns: usize) -> Layout:
            reset()
            # Layout is also a counted-text boundary. Bound the view before
            # narrowing its signed ABI length or using it for pointer walks.
            safe_text: sview = UiCore::bounded_text(text)
            source_length_state <- safe_text.len.usize() if safe_text.len > 0 else 0
            max_columns_state <- max_columns if max_columns > 0 else 1
            if source_length_state == 0:
                emit_line(0, 0, 0)
            else:
                start: mutable usize = 0
                while start < source_length_state:
                    cursor: mutable usize = start
                    columns: mutable usize = 0
                    last_break: mutable usize = 0
                    has_break: mutable bool = false
                    last_break_columns: mutable usize = 0
                    finished: mutable bool = false
                    while cursor < source_length_state:
                        byte: u8 = safe_text.data[cursor]
                        if is_newline(byte):
                            emit_line(start, cursor - start, columns)
                            cursor <- cursor + 1
                            if byte == 13 and cursor < source_length_state and safe_text.data[cursor] == 10:
                                cursor <- cursor + 1
                            start <- cursor
                            emit_line(start, 0, 0) if start == source_length_state
                            finished <- true
                            break
                        width: usize = scalar_bytes(safe_text, cursor, source_length_state)
                        # Keep the break at the beginning of a whitespace run.
                        # Updating it for every consecutive space would emit a
                        # trailing space (for example, `a  b` at a two-column
                        # limit) before the post-break skip discards only the
                        # later part of the run.
                        if is_break(byte) and (cursor == start or not is_break(safe_text.data[cursor - 1])):
                            last_break <- cursor
                            last_break_columns <- columns
                            has_break <- true
                        if columns >= max_columns_state:
                            if has_break and last_break >= start:
                                emit_line(start, last_break - start, last_break_columns)
                                cursor <- last_break + scalar_bytes(safe_text, last_break, source_length_state)
                                while cursor < source_length_state and is_break(safe_text.data[cursor]):
                                    cursor <- cursor + scalar_bytes(safe_text, cursor, source_length_state)
                                start <- cursor
                                finished <- true
                                break
                            emit_line(start, cursor - start, columns)
                            start <- cursor
                            finished <- true
                            break
                        columns <- columns + 1
                        cursor <- cursor + width
                    if not finished:
                        emit_line(start, source_length_state - start, columns)
                        start <- source_length_state
            return Layout{line_count: line_count_state, max_columns: max_columns_state,
                source_length: source_length_state, overflowed: overflowed_state}

        def snapshot() -> Layout:
            return Layout{line_count: line_count_state, max_columns: max_columns_state,
                source_length: source_length_state, overflowed: overflowed_state}

        def line_count() -> usize:
            return line_count_state

        def line_at(index: usize) -> LineRange:
            return LineRange{offset: 0, length: 0, columns: 0} if index >= line_count_state
            return LineRange{offset: line_offsets[index], length: line_lengths[index], columns: line_columns[index]}

        def line_if_valid(index: usize) -> LineRange?:
            return null if index >= line_count_state
            return line_at(index)

        # The returned view borrows the caller's text; it is valid for exactly
        # the same lifetime as that input view.
        def line_view(text: sview, index: usize) -> sview:
            safe_text: sview = UiCore::bounded_text(text)
            return "" if safe_text.len <= 0 or index >= line_count_state
            range: LineRange = line_at(index)
            return "" if range.offset > safe_text.len.usize()
            return "" if range.length > safe_text.len.usize() - range.offset
            return sview(&safe_text.data[range.offset], 0, range.length.i64())

        def utf8_scalar_bytes(text: sview, offset: usize) -> usize:
            # This low-level query intentionally retains one-byte recovery for
            # malformed input (callers use it to prove a planner cannot stall).
            # Apply only the shared byte cap here; `layout` itself uses
            # `bounded_text`, which rejects malformed data before planning.
            return 0 if text.len <= 0 or text.data == null
            limit: usize = UiCore::MAX_TEXT_BYTES if text.len > UiCore::MAX_TEXT_BYTES.i64() else text.len.usize()
            return 0 if offset >= limit
            # `text` is already a counted view; rebuilding it from its raw
            # pointer would scan for a NUL before applying `limit`. The scalar
            # walker accepts an explicit end, so keep the original view and
            # never read beyond that bound.
            return scalar_bytes(text, offset, limit)

    private:
        global mutable line_offsets: usize[MAX_LINES] = zeroed
        global mutable line_lengths: usize[MAX_LINES] = zeroed
        global mutable line_columns: usize[MAX_LINES] = zeroed
        global mutable line_count_state: usize = 0
        global mutable source_length_state: usize = 0
        global mutable max_columns_state: usize = 1
        global mutable overflowed_state: bool = false

        def emit_line(offset: usize, length: usize, columns: usize) -> void:
            if line_count_state >= MAX_LINES:
                overflowed_state <- true
                return
            line_offsets[line_count_state] <- offset
            line_lengths[line_count_state] <- length
            line_columns[line_count_state] <- columns
            line_count_state <- line_count_state + 1

        def is_newline(byte: u8) -> bool:
            return byte == 10 or byte == 13

        def is_break(byte: u8) -> bool:
            # Only whitespace may be discarded when wrapping. Treating '-' or
            # '/' as whitespace silently removed characters from paths/words.
            return byte == 9 or byte == 32

        def scalar_bytes(text: sview, offset: usize, end: usize) -> usize:
            return 1 if offset >= end
            first: i32 = text.data[offset].i32()
            return 1 if first < 128 or first >= 248
            width: mutable usize = 1
            width <- 2 if first >= 194 and first <= 223
            width <- 3 if first >= 224 and first <= 239
            width <- 4 if first >= 240 and first <= 244
            return 1 if width == 1 or width > end - offset
            for index in 1..<width:
                byte: u8 = text.data[offset + index]
                return 1 if byte < 128 or byte > 191
            second: u8 = text.data[offset + 1]
            return 1 if first == 224 and second < 160
            return 1 if first == 237 and second >= 160
            return 1 if first == 240 and second < 144
            return 1 if first == 244 and second >= 144
            return width
            # Invalid lead or truncated scalar: consume one byte so a malformed
            # string cannot stall the planner or make it skip past its extent.
