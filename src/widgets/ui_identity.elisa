# Bounded stable identity for dynamic widget collections.
#
# Applications rebuild list/form composition as data changes. Position is not
# identity: inserting a row above a focused editor must not silently transfer
# its selection, scroll anchor, or edit history to a different record. This
# module owns only the key -> generation mapping. The application keeps its
# per-item state keyed by the returned handle, while virtualization decides
# which of the already-identified items need realization.
#
# Identity is deliberately frame-scoped. Call begin(), claim every logical key
# in the new model (including items currently outside a virtualized viewport),
# then finish(). Reordered keys reuse their slot and generation; omitted keys
# are retired and their old handles become stale before a slot can be reused.
# The fixed bound makes exhaustion explicit instead of aliasing two records.

module UiIdentity:
    public:
        const MAX_KEYS: usize = 1024
        const NONE: usize = MAX_KEYS

        struct Handle:
            slot: u32
            generation: u32

        struct Snapshot:
            active: usize
            claimed: usize
            reused: usize
            inserted: usize
            retired: usize
            overflowed: bool
            duplicate: bool
            complete: bool

        def invalid() -> Handle:
            return Handle{slot: NONE.u32(), generation: 0}

        def is_valid(handle: Handle) -> bool:
            return handle.slot.usize() < MAX_KEYS and identity_occupied[handle.slot.usize()] and identity_generations[handle.slot.usize()] == handle.generation

        def reset() -> void:
            for slot in 0..<MAX_KEYS:
                identity_occupied[slot] <- false
                seen[slot] <- false
                was_occupied[slot] <- false
                keys[slot] <- 0
                identity_generations[slot] <- next_generation(identity_generations[slot])
            frame_active <- false
            transaction_complete <- false
            claimed_count <- 0
            reused_count <- 0
            inserted_count <- 0
            retired_count <- 0
            identity_overflowed_state <- false
            duplicate_state <- false
            identity_active_count <- 0

        # Start a model transaction. Existing keys remain live until finish so
        # a failed/partial rebuild can still reject stale input deterministically.
        # Starting again while a transaction is open first rolls back any keys
        # inserted by the abandoned attempt; otherwise those keys would become
        # indistinguishable from the committed baseline.
        def begin() -> void:
            rollback_uncommitted() if frame_active
            for slot in 0..<MAX_KEYS:
                seen[slot] <- false
                was_occupied[slot] <- identity_occupied[slot]
            frame_active <- true
            transaction_complete <- false
            claimed_count <- 0
            reused_count <- 0
            inserted_count <- 0
            retired_count <- 0
            identity_overflowed_state <- false
            duplicate_state <- false
            transaction_failed_state <- false

        # Claim one logical key. A duplicate in one transaction is rejected:
        # two rows with one key would otherwise share focus and edit state.
        def claim(key: u64) -> Handle:
            return invalid() if not frame_active
            for slot in 0..<MAX_KEYS:
                if identity_occupied[slot] and keys[slot] == key:
                    return claim_existing(slot)

            free_slot: mutable usize = NONE
            for slot in 0..<MAX_KEYS:
                if not identity_occupied[slot]:
                    free_slot <- slot
                    break
            if free_slot == NONE:
                identity_overflowed_state <- true
                transaction_failed_state <- true
                return invalid()

            identity_occupied[free_slot] <- true
            seen[free_slot] <- true
            keys[free_slot] <- key
            identity_generations[free_slot] <- next_generation(identity_generations[free_slot])
            claimed_count <- claimed_count + 1
            inserted_count <- inserted_count + 1
            identity_active_count <- identity_active_count + 1
            return Handle{slot: free_slot.u32(), generation: identity_generations[free_slot]}

        # Finish the transaction and retire keys omitted from the new model.
        # Retiring advances the slot generation before it becomes reusable, so
        # a late callback carrying an old handle can never touch a new record.
        def finish() -> Snapshot:
            return snapshot(false) if not frame_active
            # A malformed transaction must not partially commit. In
            # particular, dropping omitted keys after a duplicate/overflow
            # would make a transient builder error destroy unrelated state.
            # Roll back only slots inserted after begin(); existing identities
            # remain live and continue rejecting stale handles deterministically.
            if transaction_failed_state:
                rollback_uncommitted()
                frame_active <- false
                transaction_complete <- false
                return snapshot(false)
            for slot in 0..<MAX_KEYS:
                if identity_occupied[slot] and not seen[slot]:
                    identity_occupied[slot] <- false
                    keys[slot] <- 0
                    identity_generations[slot] <- next_generation(identity_generations[slot])
                    retired_count <- retired_count + 1
                    identity_active_count <- identity_active_count - 1
            frame_active <- false
            transaction_complete <- true
            return snapshot(true)

        def current() -> Snapshot:
            return snapshot(transaction_complete)

        def key(handle: Handle) -> u64:
            return 0 if not is_valid(handle)
            return keys[handle.slot.usize()]

        def active() -> usize:
            return identity_active_count

        def overflowed() -> bool:
            return identity_overflowed_state

        def duplicate() -> bool:
            return duplicate_state

    private:
        global mutable keys: u64[MAX_KEYS] = zeroed
        global mutable identity_generations: u32[MAX_KEYS] = zeroed
        global mutable identity_occupied: bool[MAX_KEYS] = zeroed
        global mutable seen: bool[MAX_KEYS] = zeroed
        global mutable was_occupied: bool[MAX_KEYS] = zeroed
        global mutable frame_active: bool = false
        global mutable transaction_complete: bool = false
        global mutable identity_active_count: usize = 0
        global mutable claimed_count: usize = 0
        global mutable reused_count: usize = 0
        global mutable inserted_count: usize = 0
        global mutable retired_count: usize = 0
        global mutable identity_overflowed_state: bool = false
        global mutable duplicate_state: bool = false
        global mutable transaction_failed_state: bool = false

        def next_generation(value: u32) -> u32:
            next: u32 = value + 1
            return 1 if next == 0 else next

        def claim_existing(slot: usize) -> Handle:
            # Reusing an existing key is expected during reorder. Only the
            # second claim of that key in one transaction is a duplicate.
            if seen[slot]:
                duplicate_state <- true
                transaction_failed_state <- true
                return invalid()
            seen[slot] <- true
            claimed_count <- claimed_count + 1
            reused_count <- reused_count + 1
            return Handle{slot: slot.u32(), generation: identity_generations[slot]}

        # Remove only records created after the current transaction began.
        # Advancing each generation invalidates handles already handed to the
        # caller before the transaction later failed or was abandoned.
        def rollback_uncommitted() -> void:
            for slot in 0..<MAX_KEYS:
                if identity_occupied[slot] and not was_occupied[slot]:
                    identity_occupied[slot] <- false
                    keys[slot] <- 0
                    identity_generations[slot] <- next_generation(identity_generations[slot])
                    identity_active_count <- identity_active_count - 1 if identity_active_count > 0

        def snapshot(complete: bool) -> Snapshot:
            return Snapshot{active: identity_active_count, claimed: claimed_count,
                reused: reused_count, inserted: inserted_count,
                retired: retired_count, overflowed: identity_overflowed_state,
                duplicate: duplicate_state, complete: complete}
