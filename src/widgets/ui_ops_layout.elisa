include "./ui_constraints.elisa"

extend UiWidgets:
    private:
        # Packed hierarchy handles deliberately do not expose identity
        # comparisons. Bound every recursive descent and sibling walk so a
        # malformed self-link or cycle cannot hang a backend indefinitely.
        # These are traversal safety limits, not widget-arena capacities; a
        # well-formed tree still owns all of its nodes and is never truncated
        # by the normal constructors.
        const MAX_HIERARCHY_DEPTH: i32 = 256
        const MAX_HIERARCHY_SIBLINGS: i32 = 1024

        # Hierarchy constructors are public sealed-enum entry points, so a
        # caller can bypass the convenience builders and supply finite values
        # far beyond useful screen geometry. Keep every layout operand inside
        # the same bound used by the constraints and flat-widget layers before
        # adding or multiplying it; this makes aggregate math saturating and
        # prevents a valid f32 input from turning into an infinite box.
        def bounded_extent(value: f32) -> f32:
            return UiConstraints::bounded(value)

        def safe_sum(left: f32, right: f32) -> f32:
            return bounded_extent(bounded_extent(left) + bounded_extent(right))

        def safe_product(left: f32, right: f32) -> f32:
            return bounded_extent(bounded_extent(left) * bounded_extent(right))

        def safe_difference(left: f32, right: f32) -> f32:
            safe_left: f32 = bounded_extent(left)
            safe_right: f32 = bounded_extent(right)
            return safe_left - safe_right if safe_left > safe_right else 0.0

        # The amount of content that can be revealed by a stateful viewport.
        # Child boxes already contain the current translation, so adding the
        # current offset recovers their unscrolled extent without a second
        # measurement pass or any backend-specific bookkeeping.
        def scroll_content_extent(w: Widget) -> f32:
            is_row: bool = axis_of(w) == UiConst::Axis.Row
            translated: f32 = bounded_extent(scroll_offset_of(w))
            parent_origin: f32 = UiCore::bounded_coordinate(w.x if is_row else w.y)
            extent: mutable f32 = 0.0
            content_steps: mutable i32 = 0
            cursor: mutable Widget? = w.first_child if can_nest(w) else null
            while cursor is node |extent, cursor, is_row, translated, w, content_steps|:
                break if content_steps >= MAX_HIERARCHY_SIBLINGS
                content_steps <- content_steps + 1
                # Sanitize each term before subtraction. Raw sealed-enum
                # constructors can carry finite f32 coordinates near the
                # numeric limit; subtracting opposite-signed values first can
                # overflow to infinity, which `bounded_extent` would turn
                # into zero and lose the entire scroll range.
                child_origin: f32 = UiCore::bounded_coordinate(node.x if is_row else node.y)
                child_extent: f32 = bounded_extent(node.width if is_row else node.height)
                end: f32 = bounded_extent(child_origin - parent_origin + child_extent + translated)
                extent <- end if end > extent
                cursor <- node.next_sibling
            return extent

        # Value-bearing controls share the same normalized range contract as
        # UiControls and UiFlat. Keep direct hierarchy painting from drawing
        # past its box when an application supplies an out-of-range value.
        def normalized_slider_ratio(value: f32, low: f32, high: f32) -> f32:
            # Do the subtraction in f64. Two finite f32 endpoints with
            # opposite signs can overflow their f32 span even though their
            # logical range is perfectly valid (for example -3e38..3e38).
            # Keeping the intermediate in f64 preserves the midpoint and
            # still returns the same normalized f32 contract to painters.
            lower: mutable f64 = UiCore::finite_or_zero_f64(low.f64())
            upper: mutable f64 = UiCore::finite_or_zero_f64(high.f64())
            if upper < lower:
                swap: f64 = lower
                lower <- upper
                upper <- swap
            span: f64 = upper - lower
            return 0.0 if span <= 0.0
            normalized: f64 = (UiCore::finite_or_zero_f64(value.f64()) - lower) / span
            return UiCore::normalized_unit(normalized.f32())

        # How many children a node has. Walks the sibling chain rather than
        # storing a count, so adding or removing a child needs no bookkeeping.
        def child_count(w: Widget) -> f32:
            total: mutable f32 = 0.0
            child_steps: mutable i32 = 0
            cursor: mutable Widget? = w.first_child if can_nest(w) else null
            while cursor is node |total, cursor, child_steps|:
                break if child_steps >= MAX_HIERARCHY_SIBLINGS
                child_steps <- child_steps + 1
                total <- total + 1.0
                cursor <- node.next_sibling
            return total

        # Bottom-up pass. A container's minimum is its children's minima summed
        # along its axis (plus spacing and padding) and maximised across it. A
        # declared minimum still wins when it is larger, which is how a button
        # reserves its clickable area even with a short label.
        def measure(w: Widget, depth: i32) -> void:
            return if depth >= MAX_HIERARCHY_DEPTH
            w.min_width <- bounded_extent(w.min_width)
            w.min_height <- bounded_extent(w.min_height)
            # Grid is the one container whose main-axis demand is not a simple
            # sibling sum. Measure a uniform cell from the largest child, then
            # derive the number of rows from the fixed column count.
            match w:
                Container.Grid(columns, padding, spacing, fill):
                    child: Widget? = w.first_child if can_nest(w) else null
                    return if child == null
                    columns_count: f32 = columns.i64().f32() if columns > 0 else 1.0
                    widest: mutable f32 = 0.0
                    tallest: mutable f32 = 0.0
                    count: mutable f32 = 0.0
                    measure_grid_steps: mutable i32 = 0
                    cursor: mutable Widget? = child
                    while cursor is node |widest, tallest, count, cursor, measure_grid_steps|:
                        break if measure_grid_steps >= MAX_HIERARCHY_SIBLINGS
                        measure_grid_steps <- measure_grid_steps + 1
                        measure(node, depth + 1)
                        child_width: f32 = bounded_extent(node.min_width)
                        child_height: f32 = bounded_extent(node.min_height)
                        widest <- child_width if child_width > widest else widest
                        tallest <- child_height if child_height > tallest else tallest
                        count <- count + 1.0
                        cursor <- node.next_sibling
                    rows: mutable f32 = 0.0
                    remaining: mutable f32 = count
                    while remaining > 0.0 |rows, remaining, columns_count|:
                        rows <- rows + 1.0
                        remaining <- remaining - columns_count
                    # Raw enum constructors are public, so a caller can
                    # bypass UiWidgets::grid and supply hostile metrics.
                    # Measurement must use the same normalized values as
                    # arrangement; otherwise a negative gap or inset makes
                    # the reported minimum disagree with the boxes we place.
                    safe_padding: f32 = bounded_extent(padding)
                    safe_spacing: f32 = bounded_extent(spacing)
                    gaps_x: f32 = safe_product(safe_spacing, columns_count - 1.0) if columns_count > 1.0 else 0.0
                    gaps_y: f32 = safe_product(safe_spacing, rows - 1.0) if rows > 1.0 else 0.0
                    content_width: f32 = safe_sum(safe_sum(safe_product(widest, columns_count), gaps_x), safe_product(safe_padding, 2.0))
                    content_height: f32 = safe_sum(safe_sum(safe_product(tallest, rows), gaps_y), safe_product(safe_padding, 2.0))
                    w.min_width <- content_width if content_width > w.min_width
                    w.min_height <- content_height if content_height > w.min_height
                    return
                _:
                    pass
            child: Widget? = w.first_child if can_nest(w) else null
            return if child == null
            is_row: bool = axis_of(w) == UiConst::Axis.Row
            along: mutable f32 = 0.0
            across: mutable f32 = 0.0
            count: mutable f32 = 0.0
            measure_list_steps: mutable i32 = 0
            cursor: mutable Widget? = child
            while cursor is node |along, across, count, cursor, is_row, measure_list_steps|:
                break if measure_list_steps >= MAX_HIERARCHY_SIBLINGS
                measure_list_steps <- measure_list_steps + 1
                measure(node, depth + 1)
                child_along: f32 = bounded_extent(node.min_width if is_row else node.min_height)
                child_across: f32 = bounded_extent(node.min_height if is_row else node.min_width)
                along <- safe_sum(along, child_along)
                across <- child_across if child_across > across else across
                count <- count + 1.0
                cursor <- node.next_sibling
            gaps: f32 = safe_product(spacing_of(w), count - 1.0) if count > 1.0 else 0.0
            pad: f32 = safe_product(padding_of(w), 2.0)
            content_width: f32 = safe_sum(safe_sum(along, gaps), pad) if is_row else safe_sum(across, pad)
            content_height: f32 = safe_sum(across, pad) if is_row else safe_sum(safe_sum(along, gaps), pad)
            # A scroll node's content demand belongs to its scroll range, not
            # to the viewport minimum. Keeping the declared minimum lets a
            # parent provide the visible extent (the flat backend follows the
            # same rule); ordinary containers still grow to fit their content.
            scrolling: mutable bool = false
            match w:
                Container.Scroll(axis, offset, fill):
                    scrolling <- true
                Container.ScrollWithState(axis, state, fill):
                    scrolling <- true
                _:
                    pass
            if not scrolling:
                w.min_width <- content_width if content_width > w.min_width
                w.min_height <- content_height if content_height > w.min_height

        # Top-down pass. Every child gets its minimum along the axis, then the
        # leftover is shared in proportion to `grow`; children stretch to fill
        # the cross axis. A container with no growing child simply leaves the
        # slack unused, which is wxSizer's behaviour when no item has a
        # non-zero proportion.
        # WHERE A CHILD'S BOX SITS INSIDE ITS CONTAINER, for the sealed
        # hierarchy. Its flat sibling carries the argument in full; the short
        # version is that until this existed a right-to-left frame mirrored
        # only the content inside each box and left every box where a
        # left-to-right reader would have put it, which is two layouts in one
        # picture rather than a mirrored one. One reflection within the
        # container's content span reverses a row and a grid's cells alike,
        # and -- because a scrolled row's children arrive here already
        # translated -- turns a scrolled row around with no rule of its own.
        # A column child spans the full inner width here, so the reflection
        # lands exactly where it started and costs that case nothing.
        def mirrored_child_x(inner_x: f32, span: f32, child_x: f32, child_width: f32) -> f32:
            return child_x if not reading_right_to_left()
            return UiCore::bounded_coordinate(inner_x + span - (child_x - inner_x) - child_width)

        def arrange(w: Widget, x: f32, y: f32, width: f32, height: f32, depth: i32) -> void:
            return if depth >= MAX_HIERARCHY_DEPTH
            safe_x: f32 = UiCore::bounded_coordinate(x)
            safe_y: f32 = UiCore::bounded_coordinate(y)
            safe_width: f32 = bounded_extent(width)
            safe_height: f32 = bounded_extent(height)
            w with { x <- safe_x, y <- safe_y, width <- safe_width, height <- safe_height }
            first: Widget? = w.first_child if can_nest(w) else null
            return if first == null

            # Fixed-column grid placement. Cells are uniform so a row remains
            # aligned even when its children have different intrinsic minima.
            match w:
                Container.Grid(columns, padding, spacing, fill):
                    columns_count: f32 = columns.i64().f32() if columns > 0 else 1.0
                    widest: mutable f32 = 0.0
                    tallest: mutable f32 = 0.0
                    count: mutable f32 = 0.0
                    arrange_grid_scan_steps: mutable i32 = 0
                    scan: mutable Widget? = first
                    while scan is node |widest, tallest, count, scan, arrange_grid_scan_steps|:
                        break if arrange_grid_scan_steps >= MAX_HIERARCHY_SIBLINGS
                        arrange_grid_scan_steps <- arrange_grid_scan_steps + 1
                        child_width: f32 = bounded_extent(node.min_width)
                        child_height: f32 = bounded_extent(node.min_height)
                        widest <- child_width if child_width > widest else widest
                        tallest <- child_height if child_height > tallest else tallest
                        count <- count + 1.0
                        scan <- node.next_sibling
                    rows: mutable f32 = 0.0
                    remaining: mutable f32 = count
                    while remaining > 0.0 |rows, remaining, columns_count|:
                        rows <- rows + 1.0
                        remaining <- remaining - columns_count
                    pad: f32 = bounded_extent(padding)
                    gap: f32 = bounded_extent(spacing)
                    inner_x: f32 = UiCore::bounded_coordinate(safe_x + pad)
                    inner_y: f32 = UiCore::bounded_coordinate(safe_y + pad)
                    inner_width: f32 = safe_difference(width, safe_product(pad, 2.0))
                    inner_height: f32 = safe_difference(height, safe_product(pad, 2.0))
                    gaps_x: f32 = safe_product(gap, columns_count - 1.0) if columns_count > 1.0 else 0.0
                    gaps_y: f32 = safe_product(gap, rows - 1.0) if rows > 1.0 else 0.0
                    cell_width: mutable f32 = safe_difference(inner_width, gaps_x) / columns_count
                    cell_height: mutable f32 = safe_difference(inner_height, gaps_y) / rows
                    cell_width <- bounded_extent(cell_width)
                    cell_height <- bounded_extent(cell_height)
                    cell_width <- 0.0 if cell_width < 0.0
                    cell_height <- 0.0 if cell_height < 0.0
                    cell_width <- widest if cell_width < widest else cell_width
                    cell_height <- tallest if cell_height < tallest else cell_height
                    column: mutable f32 = 0.0
                    row: mutable f32 = 0.0
                    arrange_grid_walk_steps: mutable i32 = 0
                    walk: mutable Widget? = first
                    while walk is node |column, row, walk, inner_x, inner_y, cell_width, cell_height, gap, columns_count, arrange_grid_walk_steps|:
                        break if arrange_grid_walk_steps >= MAX_HIERARCHY_SIBLINGS
                        arrange_grid_walk_steps <- arrange_grid_walk_steps + 1
                        child_x: f32 = UiCore::bounded_coordinate(inner_x + column * (cell_width + gap))
                        child_y: f32 = UiCore::bounded_coordinate(inner_y + row * (cell_height + gap))
                        arrange(node, mirrored_child_x(inner_x, inner_width, child_x, cell_width), child_y, cell_width, cell_height, depth + 1)
                        column <- column + 1.0
                        if column >= columns_count:
                            column <- 0.0
                            row <- row + 1.0
                        walk <- node.next_sibling
                    return
                _:
                    pass

            is_row: bool = axis_of(w) == UiConst::Axis.Row
            pad: f32 = bounded_extent(padding_of(w))
            gap: f32 = bounded_extent(spacing_of(w))
            inner_x: f32 = UiCore::bounded_coordinate(safe_x + pad)
            inner_y: f32 = UiCore::bounded_coordinate(safe_y + pad)
            inner_width: f32 = safe_difference(width, safe_product(pad, 2.0))
            inner_height: f32 = safe_difference(height, safe_product(pad, 2.0))
            count: f32 = child_count(w)
            gaps: f32 = safe_product(gap, count - 1.0) if count > 1.0 else 0.0
            inner_along: f32 = inner_width if is_row else inner_height
            scrolling: mutable bool = false
            match w:
                Container.Scroll(axis, offset, fill):
                    scrolling <- true
                Container.ScrollWithState(axis, state, fill):
                    scrolling <- true
                _:
                    pass
            scroll_offset: mutable f32 = scroll_offset_of(w)

            # First walk: what the children demand, and how much weight wants
            # the rest.
            demand: mutable f32 = 0.0
            weight: mutable f32 = 0.0
            arrange_scan_steps: mutable i32 = 0
            scan: mutable Widget? = first
            while scan is node |demand, weight, scan, is_row, arrange_scan_steps|:
                break if arrange_scan_steps >= MAX_HIERARCHY_SIBLINGS
                arrange_scan_steps <- arrange_scan_steps + 1
                demand <- safe_sum(demand, node.min_width if is_row else node.min_height)
                weight <- safe_sum(weight, node.grow)
                scan <- node.next_sibling

            # The offset is caller-owned for stateful viewports, so normalize
            # it again during every layout. This covers applications that
            # update ScrollState directly and keeps a stale value from moving
            # content beyond the measured range.
            if scrolling:
                content_along: f32 = safe_sum(demand, gaps)
                limit: f32 = safe_difference(content_along, inner_along)
                match w:
                    Container.ScrollWithState(axis, state, fill):
                        requested: f32 = UiCore::nonnegative_extent(state.offset)
                        next_offset: f32 = limit if requested > limit else requested
                        state.offset <- next_offset
                        scroll_offset <- next_offset
                    Container.Scroll(axis, offset, fill):
                        # Immutable scroll nodes cannot write the caller's
                        # offset, but their effective translation still has
                        # to respect the measured content range. Otherwise a
                        # stale offset can move every child past the viewport
                        # and leave an empty frame until the tree is rebuilt.
                        requested: f32 = UiCore::nonnegative_extent(offset)
                        scroll_offset <- limit if requested > limit else requested
                    _:
                        pass

            free: f32 = safe_difference(inner_along, safe_sum(gaps, demand))
            share: f32 = free / weight if weight > 0.0 and free > 0.0 else 0.0

            # Second walk: place each child at the running offset.
            offset: mutable f32 = 0.0
            arrange_walk_steps: mutable i32 = 0
            walk: mutable Widget? = first
            while walk is node |offset, walk, is_row, inner_x, inner_y, inner_width, inner_height, share, scroll_offset, arrange_walk_steps|:
                break if arrange_walk_steps >= MAX_HIERARCHY_SIBLINGS
                arrange_walk_steps <- arrange_walk_steps + 1
                base: f32 = bounded_extent(node.min_width if is_row else node.min_height)
                extent: f32 = safe_sum(base, safe_product(share, node.grow))
                if is_row:
                    child_x: f32 = UiCore::bounded_coordinate(inner_x + offset - scroll_offset)
                    arrange(node, mirrored_child_x(inner_x, inner_width, child_x, extent), inner_y, extent, inner_height, depth + 1)
                else:
                    child_y: f32 = UiCore::bounded_coordinate(inner_y + offset - scroll_offset)
                    arrange(node, inner_x, child_y, inner_width, extent, depth + 1)
                offset <- safe_sum(safe_sum(offset, extent), gap)
                walk <- node.next_sibling
