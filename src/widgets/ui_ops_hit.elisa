include "./ui_constraints.elisa"

extend UiWidgets:
    private:
        def contains(w: Widget, x: f32, y: f32) -> bool:
            # Hierarchy callers may construct a sealed Widget directly and
            # invoke hit testing before layout. Project the common geometry
            # through the same finite/bounded contract used by painting and
            # native-control realization, and reject non-finite pointer input
            # instead of accidentally treating NaN/Inf as the origin.
            safe_x: f32 = UiCore::finite_or_zero(w.x)
            safe_y: f32 = UiCore::finite_or_zero(w.y)
            safe_width: f32 = UiConstraints::bounded(w.width)
            safe_height: f32 = UiConstraints::bounded(w.height)
            safe_pointer_x: f32 = UiCore::finite_or_zero(x)
            safe_pointer_y: f32 = UiCore::finite_or_zero(y)
            x_difference: f32 = x - x
            y_difference: f32 = y - y
            x_finite: bool = x_difference == x_difference
            y_finite: bool = y_difference == y_difference
            return false if not x_finite or not y_finite
            return safe_pointer_x >= safe_x and safe_pointer_y >= safe_y and safe_pointer_x < safe_x + safe_width and safe_pointer_y < safe_y + safe_height

    public:
        # The topmost interactive widget under the pointer. Children are
        # painted after their parent, so a depth-first walk that prefers the
        # LAST matching descendant returns what the user sees on top.
        def hit_depth(w: Widget, x: f32, y: f32, depth: i32) -> Widget?:
            return null if depth >= MAX_HIERARCHY_DEPTH
            return null if not contains(w, x, y)
            found: mutable Widget? = null
            hit_steps: mutable i32 = 0
            cursor: mutable Widget? = w.first_child
            while cursor is node |found, cursor, x, y, hit_steps|:
                break if hit_steps >= MAX_HIERARCHY_SIBLINGS
                hit_steps <- hit_steps + 1
                deeper: Widget? = hit_depth(node, x, y, depth + 1)
                found <- deeper if deeper != null
                cursor <- node.next_sibling
            return found if found != null
            return w if is_interactive(w)
            return null

        def hit(w: Widget, x: f32, y: f32) -> Widget?:
            return hit_depth(w, x, y, 0)
