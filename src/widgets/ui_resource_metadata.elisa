# Validated intrinsic geometry for logical resources.
#
# Hosts can provide package metadata before bytes decode. The framework keeps
# that small, backend-neutral fact beside the logical resource generation so
# image/document placeholders reserve stable geometry during loading.

extend UiResources:
    public:
        def set_intrinsic_size(handle: ResourceHandle, width: f32, height: f32) -> bool:
            return false if not UiResources::resource_is_valid(handle)
            # Intrinsic dimensions are part of the current load result. Ignore
            # late metadata once this generation has resolved or been cancelled.
            return false if UiResources::state(handle) != State.Requested
            return false if not UiCore::is_finite(width) or not UiCore::is_finite(height)
            return false if width < 0.0 or height < 0.0
            return false if width > UiCore::MAX_GEOMETRY_EXTENT or height > UiCore::MAX_GEOMETRY_EXTENT
            image: UiCore::ImageRef = UiCore::image_ref(handle.slot, handle.generation)
            current: UiCore::Size = UiCore::image_intrinsic_size(image)
            return false if current.width == width and current.height == height
            return UiCore::set_image_intrinsic_size(image, width, height)

        def intrinsic_size(handle: ResourceHandle) -> UiCore::Size:
            return UiCore::Size(0.0, 0.0) if not UiResources::resource_is_valid(handle)
            return UiCore::image_intrinsic_size(UiCore::image_ref(handle.slot, handle.generation))

    private:
        # A retry or re-request rotates identity while retaining package
        # geometry for the same logical asset. Copy it only to the new image
        # generation; old ImageRefs remain unable to observe that metadata.
        def preserve_metadata_for_generation(slot: usize, generation: u32) -> void:
            return if slot >= MAX_RESOURCES or generation == 0
            previous: UiCore::Size = UiCore::image_intrinsic_size(UiCore::image_ref(slot.u32(), resource_generations[slot]))
            return if previous.width <= 0.0 and previous.height <= 0.0
            _ = UiCore::set_image_intrinsic_size(UiCore::image_ref(slot.u32(), generation), previous.width, previous.height)

        def clear_metadata(slot: usize) -> void:
            UiCore::clear_image_intrinsic_size(slot)
