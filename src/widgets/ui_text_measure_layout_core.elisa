# Backend-neutral pixel-measured, grapheme-safe text layout core.
#
# This module owns bounded line storage, UTF-8/grapheme advancement, and break
# policy. The caller supplies a width function so native and custom renderers
# can keep their own shaping/font authority without moving line ownership out
# of Elisa.

include "../core/ui_core.elisa"

module UiTextMeasureLayout:
    public:
        const MAX_LINES: usize = 256

        struct LineRange:
            offset: usize
            length: usize
            width: f32

        struct Layout:
            line_count: usize
            max_width: f32
            source_length: usize
            text_size: f32
            overflowed: bool

        # Wrap one bounded text view only between grapheme clusters. The
        # callback keeps the planner reusable by every backend profile. A
        # zero/negative width means one logical pixel, which keeps the planner
        # progressing for a minimized or malformed viewport.
        def layout_with_measure(text: sview, max_width: f32, size: f32, width_provider: fn(sview, f32) -> f32) -> Layout:
            measured_layout_reset()
            safe_text: sview = UiCore::bounded_text(text)
            measured_source_length <- safe_text.len.usize() if safe_text.len > 0 else 0
            measured_max_width <- UiCore::bounded_extent(max_width)
            measured_max_width <- 1.0 if measured_max_width <= 0.0 else measured_max_width
            measured_text_size <- UiCore::bounded_extent(size)
            measured_text_size <- 1.0 if measured_text_size <= 0.0 else measured_text_size
            if measured_source_length == 0:
                emit_line(0, 0, 0.0)
            else:
                start: mutable usize = 0
                while start < measured_source_length:
                    cursor: mutable usize = start
                    line_width: mutable f32 = 0.0
                    last_break: mutable usize = 0
                    last_break_width: mutable f32 = 0.0
                    has_break: mutable bool = false
                    finished: mutable bool = false
                    while cursor < measured_source_length:
                        byte: u8 = safe_text.data[cursor]
                        if is_newline(byte):
                            emit_line(start, cursor - start, line_width)
                            cursor <- cursor + 1
                            if byte == 13 and cursor < measured_source_length and safe_text.data[cursor] == 10:
                                cursor <- cursor + 1
                            start <- cursor
                            emit_line(start, 0, 0.0) if start == measured_source_length
                            finished <- true
                            break

                        cluster_end: usize = UiText::next_grapheme(safe_text, cursor)
                        cluster_length: usize = cluster_end - cursor if cluster_end > cursor and cluster_end <= measured_source_length else 1
                        cluster: sview = sview(&safe_text.data[cursor], 0, cluster_length.i64())
                        cluster_width: f32 = UiCore::bounded_extent(width_provider(cluster, measured_text_size))
                        proposed: f32 = UiCore::bounded_extent(line_width + cluster_width)
                        if is_break(byte) and (cursor == start or not is_break(safe_text.data[cursor - 1])):
                            break_after: usize = cursor + cluster_length if is_punctuation_break(byte) else cursor
                            last_break <- break_after
                            last_break_width <- proposed if break_after > cursor else line_width
                            has_break <- true

                        if proposed > measured_max_width and cursor > start:
                            if has_break and last_break >= start:
                                emit_line(start, last_break - start, last_break_width)
                                cursor <- last_break
                                cursor <- cursor + 1 if cursor < measured_source_length and is_discardable_break(safe_text.data[cursor])
                                cursor <- skip_breaks(safe_text, cursor, measured_source_length)
                                start <- cursor
                                finished <- true
                                break
                            emit_line(start, cursor - start, line_width)
                            start <- cursor
                            finished <- true
                            break

                        # A single cluster wider than the viewport still owns
                        # one line. Consuming it here guarantees progress for
                        # a large emoji or CJK glyph.
                        line_width <- proposed
                        cursor <- cursor + cluster_length
                        if line_width > measured_max_width and cursor > start:
                            emit_line(start, cursor - start, line_width)
                            start <- cursor
                            finished <- true
                            break
                    if not finished:
                        emit_line(start, measured_source_length - start, line_width)
                        start <- measured_source_length
            return Layout{line_count: measured_line_count, max_width: measured_max_width,
                source_length: measured_source_length, text_size: measured_text_size,
                overflowed: measured_overflowed}

        def snapshot() -> Layout:
            return Layout{line_count: measured_line_count, max_width: measured_max_width,
                source_length: measured_source_length, text_size: measured_text_size,
                overflowed: measured_overflowed}

        # Clear the shared line ranges while preserving the caller's bounded
        # source length. This is used when a renderer resource is unavailable;
        # returning a zero-line layout must not leave a prior frame's ranges
        # observable through line_at()/line_view().
        def empty_layout(text: sview, max_width: f32, size: f32) -> Layout:
            measured_layout_reset()
            safe_text: sview = UiCore::bounded_text(text)
            measured_source_length <- safe_text.len.usize()
            measured_max_width <- UiCore::bounded_extent(max_width)
            measured_max_width <- 1.0 if measured_max_width <= 0.0 else measured_max_width
            measured_text_size <- UiCore::bounded_extent(size)
            measured_text_size <- 1.0 if measured_text_size <= 0.0 else measured_text_size
            return snapshot()

        def line_count() -> usize:
            return measured_line_count

        def line_at(index: usize) -> LineRange:
            return LineRange{offset: 0, length: 0, width: 0.0} if index >= measured_line_count
            return LineRange{offset: measured_line_offsets[index], length: measured_line_lengths[index], width: measured_line_widths[index]}

        def line_if_valid(index: usize) -> LineRange?:
            return null if index >= measured_line_count
            return line_at(index)

        def line_view(text: sview, index: usize) -> sview:
            safe_text: sview = UiCore::bounded_text(text)
            return "" if safe_text.len <= 0 or index >= measured_line_count
            range: LineRange = line_at(index)
            return "" if range.offset > safe_text.len.usize()
            return "" if range.length > safe_text.len.usize() - range.offset
            return sview(&safe_text.data[range.offset], 0, range.length.i64())

        # Return the UTF-8 byte offset of the nearest grapheme caret on a
        # measured line. `local_x` is relative to that line's origin; the
        # provider is called only for complete grapheme clusters, so a hit can
        # never split a combining sequence or multi-codepoint emoji.
        def hit_test_line(text: sview, index: usize, local_x: f32, size: f32, width_provider: fn(sview, f32) -> f32) -> usize:
            safe_text: sview = UiCore::bounded_text(text)
            return 0 if safe_text.len <= 0 or index >= measured_line_count
            range: LineRange = line_at(index)
            source_length: usize = safe_text.len.usize()
            return range.offset if range.offset > source_length or range.length > source_length - range.offset
            end: usize = range.offset + range.length
            cursor: mutable usize = range.offset
            accumulated: mutable f32 = 0.0
            target: f32 = UiCore::bounded_coordinate(local_x)
            while cursor < end:
                cluster_end: usize = UiText::next_grapheme(safe_text, cursor)
                cluster_length: usize = cluster_end - cursor if cluster_end > cursor and cluster_end <= end else 1
                cluster: sview = sview(&safe_text.data[cursor], 0, cluster_length.i64())
                cluster_width: f32 = UiCore::bounded_extent(width_provider(cluster, size))
                midpoint: f32 = accumulated + cluster_width * 0.5
                return cursor if target < midpoint
                accumulated <- UiCore::bounded_extent(accumulated + cluster_width)
                cursor <- cursor + cluster_length
            return end

        # Return the local x coordinate for a requested byte offset. Offsets
        # that land inside a grapheme are normalized to that cluster's leading
        # edge, matching hit testing and preventing caret rendering from
        # splitting a combining sequence or emoji.
        def caret_x_for_line(text: sview, index: usize, byte_offset: usize, size: f32, width_provider: fn(sview, f32) -> f32) -> f32:
            safe_text: sview = UiCore::bounded_text(text)
            return 0.0 if safe_text.len <= 0 or index >= measured_line_count
            range: LineRange = line_at(index)
            source_length: usize = safe_text.len.usize()
            return 0.0 if range.offset > source_length or range.length > source_length - range.offset
            end: usize = range.offset + range.length
            cursor: mutable usize = range.offset
            accumulated: mutable f32 = 0.0
            target: mutable usize = byte_offset if byte_offset >= range.offset else range.offset
            target <- end if target > end
            while cursor < end:
                return accumulated if target <= cursor
                cluster_end: usize = UiText::next_grapheme(safe_text, cursor)
                cluster_length: usize = cluster_end - cursor if cluster_end > cursor and cluster_end <= end else 1
                cluster: sview = sview(&safe_text.data[cursor], 0, cluster_length.i64())
                return accumulated if target < cluster_end
                accumulated <- UiCore::bounded_extent(accumulated + UiCore::bounded_extent(width_provider(cluster, size)))
                cursor <- cursor + cluster_length
            return accumulated

    private:
        global mutable measured_line_offsets: usize[MAX_LINES] = zeroed
        global mutable measured_line_lengths: usize[MAX_LINES] = zeroed
        global mutable measured_line_widths: f32[MAX_LINES] = zeroed
        global mutable measured_line_count: usize = 0
        global mutable measured_source_length: usize = 0
        global mutable measured_max_width: f32 = 1.0
        global mutable measured_text_size: f32 = 1.0
        global mutable measured_overflowed: bool = false

        def measured_layout_reset() -> void:
            measured_line_count <- 0
            measured_source_length <- 0
            measured_max_width <- 1.0
            measured_text_size <- 1.0
            measured_overflowed <- false
            for index in 0..<MAX_LINES:
                measured_line_offsets[index] <- 0
                measured_line_lengths[index] <- 0
                measured_line_widths[index] <- 0.0

        def emit_line(offset: usize, length: usize, width: f32) -> void:
            if measured_line_count >= MAX_LINES:
                measured_overflowed <- true
                return
            measured_line_offsets[measured_line_count] <- offset
            measured_line_lengths[measured_line_count] <- length
            measured_line_widths[measured_line_count] <- UiCore::bounded_extent(width)
            measured_line_count <- measured_line_count + 1

        def is_newline(byte: u8) -> bool:
            return byte == 10 or byte == 13

        def is_break(byte: u8) -> bool:
            return is_discardable_break(byte) or is_punctuation_break(byte)

        def is_discardable_break(byte: u8) -> bool:
            return byte == 9 or byte == 32

        def is_punctuation_break(byte: u8) -> bool:
            return byte == 45 or byte == 47

        def skip_breaks(text: sview, offset: usize, end: usize) -> usize:
            cursor: mutable usize = offset
            for _ in 0..<MAX_LINES * UiCore::MAX_TEXT_BYTES:
                break if cursor >= end or not is_discardable_break(text.data[cursor])
                cursor <- cursor + 1
            return cursor
