# elisa-ui construction helpers: extends `UiWidgets` with the short spellings
# an application writes.
#
# Colours come from UiCore (`UiCore::rgb`), not from here: they are core value
# types, not widget construction.
#
# The enum constructors take every field by name -- the eleven commons first,
# then the variant's own -- which is right for the data model and wrong for
# application code: an app that writes out fifteen arguments to place a button
# will get them wrong. These helpers give each widget kind the short spelling
# wxWidgets and Qt give their constructors: sensible defaults, only the
# interesting arguments.
#
# Children are attached with `children` and chained with `sibling`. Both are
# one field write on a mutable common, so a tree can be built in either order
# -- parent first or children first -- as wxWidgets allows.

include "./ui_ops.elisa"
include "./ui_responsive.elisa"

extend UiWidgets:
    public:
        # Top-level surfaces. These keep the raw common fields out of
        # application code while preserving the hierarchy's decoration modes.
        def window(title: sview, resizable: bool) -> Widget:
            can Memory.Allocate, Abort.Panic:
                return Window.Top(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, title: normalized_text(title), resizable: resizable)

        def floating_window(title: sview) -> Widget:
            can Memory.Allocate, Abort.Panic:
                return Window.Floating(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, title: normalized_text(title))

        # A vertical stack. The default a container wants: no growth of its
        # own, so a parent gives it exactly the space its children need.
        def column(padding: f32, spacing: f32, fill: UiCore::Color) -> Widget:
            can Memory.Allocate, Abort.Panic:
                return Container.Box(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, axis: UiConst::Axis.Column, padding: UiCore::bounded_extent(padding), spacing: UiCore::bounded_extent(spacing), fill: fill)

        def row(padding: f32, spacing: f32, fill: UiCore::Color) -> Widget:
            can Memory.Allocate, Abort.Panic:
                return Container.Box(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, axis: UiConst::Axis.Row, padding: UiCore::bounded_extent(padding), spacing: UiCore::bounded_extent(spacing), fill: fill)

        # Fixed-column and scrolling containers mirror the corresponding
        # hierarchy variants, including the axis and content offset that the
        # shared arrange pass consumes.
        def grid(columns: i32, padding: f32, spacing: f32, fill: UiCore::Color) -> Widget:
            can Memory.Allocate, Abort.Panic:
                safe_columns: i32 = columns if columns > 0 else 1
                return Container.Grid(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, columns: safe_columns, padding: UiCore::bounded_extent(padding), spacing: UiCore::bounded_extent(spacing), fill: fill)

        # Choose a fixed-column grid from logical width at build time. The
        # application can rebuild this small composition when a resize event
        # changes its responsive facts; widget internals never inspect an OS
        # name or native window object.
        def adaptive_grid(width: f32, minimum_item_width: f32, maximum_columns: i32,
                          padding: f32, spacing: f32, fill: UiCore::Color) -> Widget:
            return grid(UiResponsive::columns(width, minimum_item_width, spacing, maximum_columns), padding, spacing, fill)

        def scroll(axis: UiConst::Axis, offset: f32, fill: UiCore::Color) -> Widget:
            can Memory.Allocate, Abort.Panic:
                return Container.Scroll(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, axis: UiConst::normalize_axis(axis), offset: UiCore::bounded_extent(offset), fill: fill)

        # A wheel-driven viewport. Keep the mutable offset in caller-owned
        # state so a packed hierarchy handle does not need a writable payload
        # projection (which the language deliberately does not provide).
        def scroll_with_state(axis: UiConst::Axis, state: mutable ScrollState&, fill: UiCore::Color) -> Widget:
            can Memory.Allocate, Abort.Panic:
                state.offset <- UiCore::bounded_extent(state.offset)
                return Container.ScrollWithState(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, axis: UiConst::normalize_axis(axis), state: &state, fill: fill)

        # A label's minimum is the measured extent of its text, so it takes
        # part in layout like any other child. Measured once here rather than
        # every frame: the text is a view that does not change, and the
        # platform's measure call may cross into the host.
        def label(text: sview, size: f32, ink: UiCore::Color) -> Widget:
            can Memory.Allocate, Abort.Panic:
                safe_text: sview = normalized_text(text)
                safe_size: f32 = UiConstraints::bounded(size)
                measured_width: f32 = UiTextMetrics::width(safe_text, safe_size, false)
                measured_height: f32 = UiTextMetrics::line_height(safe_size)
                return Control.Label(min_width: measured_width, min_height: measured_height, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, text: safe_text, size: safe_size, ink: ink)

        # A push button sized to its label plus padding, with the three
        # surface colours derived from one base so a caller needs only pick
        # the base.
        def button(caption: sview, base: UiCore::Color) -> Widget:
            can Memory.Allocate, Abort.Panic:
                safe_caption: sview = normalized_text(caption)
                text_width: f32 = UiTextMetrics::width(safe_caption, 14.0, false)
                text_height: f32 = UiTextMetrics::line_height(14.0)
                return Button.Push(min_width: UiCore::bounded_extent(text_width + 20.0), min_height: UiCore::bounded_extent(text_height + 12.0), grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: safe_caption, rest: base, hover: state_shift(base, HOVER_STATE_SHIFT), press: state_shift(base, PRESS_STATE_SHIFT))

        def checkbox(caption: sview, checked: bool, base: UiCore::Color) -> Widget:
            can Memory.Allocate, Abort.Panic:
                safe_caption: sview = normalized_text(caption)
                text_width: f32 = UiTextMetrics::width(safe_caption, 14.0, false)
                text_height: f32 = UiTextMetrics::line_height(14.0)
                return Button.Check(min_width: UiCore::bounded_extent(text_width + 28.0), min_height: UiCore::bounded_extent(text_height + 8.0), grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: safe_caption, checked: checked, rest: base, hover: state_shift(base, HOVER_STATE_SHIFT), press: state_shift(base, PRESS_STATE_SHIFT))

        def toggle(caption: sview, on: bool, base: UiCore::Color) -> Widget:
            can Memory.Allocate, Abort.Panic:
                safe_caption: sview = normalized_text(caption)
                text_width: f32 = UiTextMetrics::width(safe_caption, 14.0, false)
                text_height: f32 = UiTextMetrics::line_height(14.0)
                return Button.Toggle(min_width: UiCore::bounded_extent(text_width + 28.0), min_height: UiCore::bounded_extent(text_height + 8.0), grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: safe_caption, on: on, rest: base, hover: state_shift(base, HOVER_STATE_SHIFT), press: state_shift(base, PRESS_STATE_SHIFT))

        def radio(caption: sview, group: i32, selected: bool, base: UiCore::Color) -> Widget:
            can Memory.Allocate, Abort.Panic:
                safe_caption: sview = normalized_text(caption)
                text_width: f32 = UiTextMetrics::width(safe_caption, 14.0, false)
                text_height: f32 = UiTextMetrics::line_height(14.0)
                return Button.Radio(min_width: UiCore::bounded_extent(text_width + 28.0), min_height: UiCore::bounded_extent(text_height + 8.0), grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: safe_caption, group: group, selected: selected, rest: base, hover: state_shift(base, HOVER_STATE_SHIFT), press: state_shift(base, PRESS_STATE_SHIFT))

        def gauge(fraction: f32, track: UiCore::Color, bar: UiCore::Color) -> Widget:
            can Memory.Allocate, Abort.Panic:
                return Control.Gauge(min_width: 80.0, min_height: 12.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, fraction: UiCore::normalized_unit(fraction), track: track, bar: bar)

        def slider(value: f32, low: f32, high: f32, track: UiCore::Color, knob: UiCore::Color) -> Widget:
            can Memory.Allocate, Abort.Panic:
                return Control.Slider(min_width: 120.0, min_height: 16.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, value: value, low: low, high: high, track: track, knob: knob)

        def text_box(initial: sview, size: f32, ink: UiCore::Color, fill: UiCore::Color) -> Widget:
            can Memory.Allocate, Abort.Panic:
                safe_initial: sview = normalized_text(initial)
                safe_size: f32 = UiConstraints::bounded(size)
                text_height: f32 = UiTextMetrics::line_height(safe_size)
                return Control.TextBox(min_width: 160.0, min_height: UiCore::bounded_extent(text_height + 12.0), grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, text: safe_initial, caret: safe_initial.len.usize(), size: safe_size, ink: ink, fill: fill)

    private:
        # Public enum constructors accept ABI views directly, so keep the
        # convenience layer fail-closed even when callers bypass this helper.
        def normalized_text(value: sview) -> sview:
            return UiCore::bounded_text(value)

        # Saturating channel arithmetic, so a base colour near either end
        # still yields distinguishable hover and press surfaces.
        def lighten(c: UiCore::Color, amount: u8) -> UiCore::Color:
            r: u8 = c.r + amount if c.r.i64() + amount.i64() <= 255 else 255
            g: u8 = c.g + amount if c.g.i64() + amount.i64() <= 255 else 255
            b: u8 = c.b + amount if c.b.i64() + amount.i64() <= 255 else 255
            return UiCore::Color{r: r, g: g, b: b, a: c.a}

        def darken(c: UiCore::Color, amount: u8) -> UiCore::Color:
            r: u8 = c.r - amount if c.r >= amount else 0
            g: u8 = c.g - amount if c.g >= amount else 0
            b: u8 = c.b - amount if c.b >= amount else 0
            return UiCore::Color{r: r, g: g, b: b, a: c.a}

    public:
        # A STATE THAT SHOWS AT BOTH ENDS OF THE RANGE.
        #
        # Hover was a fixed +30 on every channel and press a fixed -30, which
        # works on a mid-tone surface and nowhere else. On a near-white button
        # the addition clips: rgb(250, 250, 252) lightens to (255, 255, 255),
        # a change of five levels nobody can see, and on pure white to nothing
        # at all -- so a light theme had no hover feedback. The two also moved
        # in OPPOSITE directions for no reason, which makes a press look like a
        # different control rather than a stronger version of the same signal.
        #
        # Moving AWAY from the surface's own lightness is the rule that works
        # at both ends, and it is what a state layer is: a dark surface gets
        # lighter, a light one gets darker, and pressing is the same move
        # further along.
        const HOVER_STATE_SHIFT: u8 = 26
        const PRESS_STATE_SHIFT: u8 = 52

        def state_shift(c: UiCore::Color, amount: u8) -> UiCore::Color:
            return darken(c, amount) if UiCore::surface_luminance(c) >= 128
            return lighten(c, amount)

        # Give a widget a share of its parent's leftover space. Returns the
        # widget so it can be written inline:
        # `children(row, grow(button("OK", blue), 1.0))`.
        def grow(w: Widget, weight: f32) -> Widget:
            w.grow <- UiCore::bounded_extent(weight)
            return w

        # ------------------------------------------------------------------
        # Composition
        # ------------------------------------------------------------------
        #
        # The links are mutable commons, so composition mutates in place and
        # returns the same handle for chaining. This is wxWidgets' order of
        # operations: make a widget, then add it to a sizer.

        # `w` with `next` as the node that follows it in its parent's child
        # list.
        def sibling(w: Widget, next: Widget?) -> Widget:
            w.next_sibling <- next
            return w

        # `parent` with `child` as the head of its child list. Only containers
        # and windows nest; handing a child to a leaf returns the leaf
        # unchanged, which keeps the builder total instead of failing at a call
        # site that cannot react.
        def children(parent: Widget, child: Widget?) -> Widget:
            parent.first_child <- child if can_nest(parent)
            return parent
