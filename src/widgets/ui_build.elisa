# elisa-ui construction helpers: extends `UiWidgets` with the short spellings
# an application writes.
#
# Colours come from UiCore (`UiCore::rgb`), not from here: they are core value
# types, not widget construction.
#
# The enum constructors take every field by name -- the eleven commons first,
# then the variant's own -- which is right for the data model and wrong for
# application code: an app that writes out fifteen arguments to place a button
# will get them wrong. These helpers give each widget kind the short spelling
# wxWidgets and Qt give their constructors: sensible defaults, only the
# interesting arguments.
#
# Children are attached with `children` and chained with `sibling`. Both are
# one field write on a mutable common, so a tree can be built in either order
# -- parent first or children first -- as wxWidgets allows.

include "./ui_ops.elisa"

extend UiWidgets:
    public:
        # Top-level surfaces. These keep the raw common fields out of
        # application code while preserving the hierarchy's decoration modes.
        def window(title: sview, resizable: bool) -> Widget:
            can Memory.Allocate, Abort.Panic:
                return Window.Top(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, title: title, resizable: resizable)

        def floating_window(title: sview) -> Widget:
            can Memory.Allocate, Abort.Panic:
                return Window.Floating(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, title: title)

        # A vertical stack. The default a container wants: no growth of its
        # own, so a parent gives it exactly the space its children need.
        def column(padding: f32, spacing: f32, fill: UiCore::Color) -> Widget:
            can Memory.Allocate, Abort.Panic:
                return Container.Box(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, axis: UiConst::Axis.Column, padding: padding, spacing: spacing, fill: fill)

        def row(padding: f32, spacing: f32, fill: UiCore::Color) -> Widget:
            can Memory.Allocate, Abort.Panic:
                return Container.Box(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, axis: UiConst::Axis.Row, padding: padding, spacing: spacing, fill: fill)

        # Fixed-column and scrolling containers mirror the corresponding
        # hierarchy variants, including the axis and content offset that the
        # shared arrange pass consumes.
        def grid(columns: i32, padding: f32, spacing: f32, fill: UiCore::Color) -> Widget:
            can Memory.Allocate, Abort.Panic:
                safe_columns: i32 = columns if columns > 0 else 1
                return Container.Grid(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, columns: safe_columns, padding: padding, spacing: spacing, fill: fill)

        def scroll(axis: UiConst::Axis, offset: f32, fill: UiCore::Color) -> Widget:
            can Memory.Allocate, Abort.Panic:
                return Container.Scroll(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, axis: axis, offset: offset, fill: fill)

        # A label's minimum is the measured extent of its text, so it takes
        # part in layout like any other child. Measured once here rather than
        # every frame: the text is a view that does not change, and the
        # platform's measure call may cross into the host.
        def label(text: sview, size: f32, ink: UiCore::Color) -> Widget:
            can Memory.Allocate, Abort.Panic:
                return Control.Label(min_width: ui_measure_text_width(text, size), min_height: ui_text_line_height(size), grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, text: text, size: size, ink: ink)

        # A push button sized to its label plus padding, with the three
        # surface colours derived from one base so a caller needs only pick
        # the base.
        def button(caption: sview, base: UiCore::Color) -> Widget:
            can Memory.Allocate, Abort.Panic:
                text_width: f32 = ui_measure_text_width(caption, 14.0)
                return Button.Push(min_width: text_width + 20.0, min_height: ui_text_line_height(14.0) + 12.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: caption, rest: base, hover: lighten(base, 30), press: darken(base, 30))

        def checkbox(caption: sview, checked: bool, base: UiCore::Color) -> Widget:
            can Memory.Allocate, Abort.Panic:
                text_width: f32 = ui_measure_text_width(caption, 14.0)
                return Button.Check(min_width: text_width + 28.0, min_height: ui_text_line_height(14.0) + 8.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: caption, checked: checked, rest: base, hover: lighten(base, 30), press: darken(base, 30))

        def gauge(fraction: f32, track: UiCore::Color, bar: UiCore::Color) -> Widget:
            can Memory.Allocate, Abort.Panic:
                return Control.Gauge(min_width: 80.0, min_height: 12.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, fraction: fraction, track: track, bar: bar)

        def slider(value: f32, low: f32, high: f32, track: UiCore::Color, knob: UiCore::Color) -> Widget:
            can Memory.Allocate, Abort.Panic:
                return Control.Slider(min_width: 120.0, min_height: 16.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, value: value, low: low, high: high, track: track, knob: knob)

    private:
        # Saturating channel arithmetic, so a base colour near either end
        # still yields distinguishable hover and press surfaces.
        def lighten(c: UiCore::Color, amount: u8) -> UiCore::Color:
            r: u8 = c.r + amount if c.r.i64() + amount.i64() <= 255 else 255
            g: u8 = c.g + amount if c.g.i64() + amount.i64() <= 255 else 255
            b: u8 = c.b + amount if c.b.i64() + amount.i64() <= 255 else 255
            return UiCore::Color{r: r, g: g, b: b, a: c.a}

        def darken(c: UiCore::Color, amount: u8) -> UiCore::Color:
            r: u8 = c.r - amount if c.r >= amount else 0
            g: u8 = c.g - amount if c.g >= amount else 0
            b: u8 = c.b - amount if c.b >= amount else 0
            return UiCore::Color{r: r, g: g, b: b, a: c.a}

    public:
        # Give a widget a share of its parent's leftover space. Returns the
        # widget so it can be written inline:
        # `children(row, grow(button("OK", blue), 1.0))`.
        def grow(w: Widget, weight: f32) -> Widget:
            w.grow <- weight
            return w

        # ------------------------------------------------------------------
        # Composition
        # ------------------------------------------------------------------
        #
        # The links are mutable commons, so composition mutates in place and
        # returns the same handle for chaining. This is wxWidgets' order of
        # operations: make a widget, then add it to a sizer.

        # `w` with `next` as the node that follows it in its parent's child
        # list.
        def sibling(w: Widget, next: Widget?) -> Widget:
            w.next_sibling <- next
            return w

        # `parent` with `child` as the head of its child list. Only containers
        # and windows nest; handing a child to a leaf returns the leaf
        # unchanged, which keeps the builder total instead of failing at a call
        # site that cannot react.
        def children(parent: Widget, child: Widget?) -> Widget:
            parent.first_child <- child if can_nest(parent)
            return parent
