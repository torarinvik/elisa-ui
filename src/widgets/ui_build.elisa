# elisa-ui construction helpers.
#
# The enum constructors take every field by name -- the eleven commons first,
# then the variant's own -- which is right for the data model and wrong for
# application code: an app that writes out fifteen arguments to place a button
# will get them wrong. These helpers give each widget kind the short spelling
# wxWidgets and Qt give their constructors: sensible defaults, only the
# interesting arguments.
#
# Children are attached with `ui_children` and chained with `ui_sibling`. Both
# are one field write on a mutable common, so a tree can be built in either
# order -- parent first or children first -- as wxWidgets allows.

def ui_rgba(r: u8, g: u8, b: u8, a: u8) -> UiColor:
    return UiColor{r: r, g: g, b: b, a: a}

def ui_rgb(r: u8, g: u8, b: u8) -> UiColor:
    return UiColor{r: r, g: g, b: b, a: 255}

# A vertical stack. The default a container wants: no growth of its own, so a
# parent gives it exactly the space its children need.
def ui_column(padding: f32, spacing: f32, fill: UiColor) -> Widget:
    can Memory.Allocate, Abort.Panic:
        return Container.Box(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, axis: UI_AXIS_COLUMN, padding: padding, spacing: spacing, fill: fill)

def ui_row(padding: f32, spacing: f32, fill: UiColor) -> Widget:
    can Memory.Allocate, Abort.Panic:
        return Container.Box(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, axis: UI_AXIS_ROW, padding: padding, spacing: spacing, fill: fill)

# A label's minimum is the measured extent of its text, so it takes part in
# layout like any other child. Measured once here rather than every frame: the
# text is a view that does not change, and the platform's measure call may cross
# into the host.
def ui_label(text: sview, size: f32, ink: UiColor) -> Widget:
    can Memory.Allocate, Abort.Panic:
        return Control.Label(min_width: ui_measure_text_width(text, size), min_height: ui_text_line_height(size), grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, text: text, size: size, ink: ink)

# A push button sized to its label plus padding, with the three surface colours
# derived from one base so a caller needs only pick the base.
def ui_button(label: sview, base: UiColor) -> Widget:
    can Memory.Allocate, Abort.Panic:
        text_width: f32 = ui_measure_text_width(label, 14.0)
        return Button.Push(min_width: text_width + 20.0, min_height: ui_text_line_height(14.0) + 12.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: label, rest: base, hover: ui_lighten(base, 30), press: ui_darken(base, 30))

def ui_checkbox(label: sview, checked: bool, base: UiColor) -> Widget:
    can Memory.Allocate, Abort.Panic:
        text_width: f32 = ui_measure_text_width(label, 14.0)
        return Button.Check(min_width: text_width + 28.0, min_height: ui_text_line_height(14.0) + 8.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: label, checked: checked, rest: base, hover: ui_lighten(base, 30), press: ui_darken(base, 30))

def ui_gauge(fraction: f32, track: UiColor, bar: UiColor) -> Widget:
    can Memory.Allocate, Abort.Panic:
        return Control.Gauge(min_width: 80.0, min_height: 12.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, fraction: fraction, track: track, bar: bar)

def ui_slider(value: f32, low: f32, high: f32, track: UiColor, knob: UiColor) -> Widget:
    can Memory.Allocate, Abort.Panic:
        return Control.Slider(min_width: 120.0, min_height: 16.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, value: value, low: low, high: high, track: track, knob: knob)

# Saturating channel arithmetic, so a base colour near either end still yields
# distinguishable hover and press surfaces.
def ui_lighten(c: UiColor, amount: u8) -> UiColor:
    r: u8 = c.r + amount if c.r.i64() + amount.i64() <= 255 else 255
    g: u8 = c.g + amount if c.g.i64() + amount.i64() <= 255 else 255
    b: u8 = c.b + amount if c.b.i64() + amount.i64() <= 255 else 255
    return UiColor{r: r, g: g, b: b, a: c.a}

def ui_darken(c: UiColor, amount: u8) -> UiColor:
    r: u8 = c.r - amount if c.r >= amount else 0
    g: u8 = c.g - amount if c.g >= amount else 0
    b: u8 = c.b - amount if c.b >= amount else 0
    return UiColor{r: r, g: g, b: b, a: c.a}

# Give a widget a share of its parent's leftover space. Returns the widget so it
# can be written inline: `ui_children(row, ui_grow(ui_button("OK", blue), 1.0))`.
def ui_grow(w: Widget, weight: f32) -> Widget:
    w.grow <- weight
    return w


# ------------------------------------------------------------------
# Composition
# ------------------------------------------------------------------
#
# The links are mutable commons, so composition mutates in place and returns
# the same handle for chaining. This is wxWidgets' order of operations: make a
# widget, then add it to a sizer.

# `w` with `sibling` as the node that follows it in its parent's child list.
def ui_sibling(w: Widget, sibling: Widget?) -> Widget:
    w.next_sibling <- sibling
    return w

# `parent` with `child` as the head of its child list. Only containers and
# windows nest; handing a child to a leaf returns the leaf unchanged, which
# keeps the builder total instead of failing at a call site that cannot react.
def ui_children(parent: Widget, child: Widget?) -> Widget:
    parent.first_child <- child if widget_can_nest(parent)
    return parent
