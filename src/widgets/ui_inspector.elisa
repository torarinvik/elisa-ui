# elisa-ui deterministic inspector over the retained flat widget tree.
#
# Diagnostics are framework-owned data, not a second model. The inspector
# copies bounded facts from UiFlat and UiCore, pairs every node with its typed
# lifetime handle, and redacts secure text before it can reach logs or tools.
# It is safe to call between events, after a setter, or from a headless test.

include "./ui_handles.elisa"
include "../core/ui_capabilities.elisa"
include "../core/ui_lifecycle.elisa"
include "../core/ui_metrics.elisa"
include "./ui_text_metrics.elisa"
include "../core/ui_tasks.elisa"
include "./ui_localization.elisa"
include "./ui_theme.elisa"
include "./ui_feature_view.elisa"

module UiInspector:
    public:
        struct Constraints:
            min_width: f32
            min_height: f32
            max_width: f32
            max_height: f32
            grow: f32
            margin: f32

        struct Node:
            handle: UiHandles::Handle
            parent: UiHandles::Handle
            first_child: UiHandles::Handle
            next_sibling: UiHandles::Handle
            kind: UiConst::WidgetKind
            frame: UiCore::Rect
            constraints: Constraints
            visible: bool
            enabled: bool
            focused: bool
            selected: bool
            value: f32
            secure: bool
            text: sview
            help: sview
            semantic: UiCore::AccessibilityNode?

        struct Frame:
            viewport: UiCore::Size
            lifecycle_phase: UiLifecycle::Phase
            lifecycle_generation: u32
            lifecycle_surface_available: bool
            lifecycle_accepts_input: bool
            lifecycle_can_render: bool
            lifecycle_focused: bool
            capabilities: UiCapabilities::Snapshot
            event_queue_pending: usize
            event_queue_dropped: usize
            event_queue_overflowed: bool
            metrics: UiMetrics::Snapshot
            text_metrics: UiTextMetrics::Snapshot
            work: UiMetrics::WorkSnapshot
            task_snapshot: UiTasks::Snapshot
            localization: UiLocalization::Snapshot
            theme: UiTheme::Snapshot
            features: UiFeatureView::FeatureSnapshot
            layout_initialized: bool
            layout_dirty: bool
            frame_time: f64
            frame_delay: f32
            command_count: usize
            command_overflowed: bool
            semantic_count: usize
            semantic_overflowed: bool
            layout_invalidated: bool
            paint_invalidated: bool
            semantics_invalidated: bool
            resources_invalidated: bool
            animation_invalidated: bool
            invalidation_mask: i32
            invalidation_sequence: u32

        def count() -> usize:
            return UiHandles::count()

        def root() -> UiHandles::Handle:
            return UiHandles::from_index(0)

        # Enumerate the bounded retained slots without handing a diagnostic
        # consumer an unchecked arena index. The ordinal is only a snapshot
        # position; callers must still use the returned typed handle for every
        # follow-up query because a rebuild can retire the slot immediately.
        def node_at(index: usize) -> Node?:
            return null if index >= UiHandles::count()
            return inspect(UiHandles::from_index(index))

        def frame() -> Frame:
            metrics: UiMetrics::Snapshot = UiMetrics::snapshot()
            work: UiMetrics::WorkSnapshot = UiMetrics::work_snapshot()
            text_metrics: UiTextMetrics::Snapshot = UiTextMetrics::snapshot()
            capabilities: UiCapabilities::Snapshot = UiCapabilities::snapshot()
            events: UiEvents::Snapshot = UiEvents::snapshot()
            tasks: UiTasks::Snapshot = UiTasks::snapshot()
            localization: UiLocalization::Snapshot = UiLocalization::snapshot()
            theme: UiTheme::Snapshot = UiTheme::snapshot()
            features: UiFeatureView::FeatureSnapshot = UiFeatureView::snapshot()
            return Frame{
                viewport: UiCore::Size(UiCore::viewport_width(), UiCore::viewport_height()),
                lifecycle_phase: UiLifecycle::phase(),
                lifecycle_generation: UiLifecycle::generation(),
                lifecycle_surface_available: UiLifecycle::surface_available(),
                lifecycle_accepts_input: UiLifecycle::accepts_input(),
                lifecycle_can_render: UiLifecycle::can_render(),
                lifecycle_focused: UiLifecycle::snapshot().focused,
                capabilities: capabilities,
                event_queue_pending: events.pending,
                event_queue_dropped: events.dropped,
                event_queue_overflowed: events.overflowed,
                metrics: metrics,
                text_metrics: text_metrics,
                work: work,
                task_snapshot: tasks,
                localization: localization,
                theme: theme,
                features: features,
                layout_initialized: UiFlat::layout_is_initialized(),
                layout_dirty: UiFlat::layout_is_dirty(),
                frame_time: UiCore::frame_time(),
                frame_delay: UiCore::frame_delay(),
                command_count: UiCore::command_count(),
                command_overflowed: UiCore::command_overflowed(),
                semantic_count: UiCore::accessibility_count(),
                semantic_overflowed: UiCore::accessibility_overflowed(),
                layout_invalidated: UiCore::is_invalidated(UiCore::Invalidation.Layout),
                paint_invalidated: UiCore::is_invalidated(UiCore::Invalidation.Paint),
                semantics_invalidated: UiCore::is_invalidated(UiCore::Invalidation.Semantics),
                resources_invalidated: UiCore::is_invalidated(UiCore::Invalidation.Resources),
                animation_invalidated: UiCore::is_invalidated(UiCore::Invalidation.Animation),
                invalidation_mask: UiCore::invalidations(),
                invalidation_sequence: UiCore::invalidation_sequence(),
            }

        # A stale handle has no diagnostic record. This makes inspectors safe
        # during rebuilds and prevents a recycled slot from being mislabeled.
        def inspect(handle: UiHandles::Handle) -> Node?:
            return null if not UiHandles::is_valid(handle)
            row: UiFlat::Widget = UiFlat::widget(UiHandles::index(handle))
            visible_text: sview = "[secure]" if row.secure else row.text
            return Node{
                handle: handle,
                parent: UiHandles::parent(handle),
                first_child: UiHandles::first_child(handle),
                next_sibling: UiHandles::next_sibling(handle),
                kind: row.kind,
                frame: UiCore::Rect(row.x, row.y, row.width, row.height),
                constraints: Constraints{
                    min_width: row.min_width, min_height: row.min_height,
                    max_width: row.max_width, max_height: row.max_height,
                    grow: row.grow, margin: row.margin,
                },
                visible: UiHandles::is_visible(handle),
                enabled: UiHandles::is_enabled(handle),
                focused: UiHandles::is_focused(handle),
                selected: UiHandles::selected(handle),
                value: UiHandles::value(handle),
                secure: row.secure,
                text: visible_text,
                help: row.help,
                semantic: semantic_for(handle),
            }

        # Semantics are looked up by the same retained widget identity used by
        # layout and input. Return a sanitized copy so a diagnostic consumer
        # cannot turn a password node into a secret-value side channel.
        def semantic_for(handle: UiHandles::Handle) -> UiCore::AccessibilityNode?:
            return null if not UiHandles::is_valid(handle)
            target: usize = UiHandles::index(handle)
            index: usize = UiCore::accessibility_index_for_id(target)
            return null if index >= UiCore::accessibility_count()
            node: mutable UiCore::AccessibilityNode = UiCore::accessibility_at(index)
            if node.role == UiCore::AccessibilityRole.PasswordField:
                node.text_value <- "[secure]"
                node.selected_text <- ""
            return node
