# Native-control events, resolved back into the retained control list.
#
# A native backend hands its OS toolkit an action target and gets an opaque
# handle back when the user acts. That handle means nothing to an application:
# it must become the control index the list already owns, the new value must be
# recorded so the app can read it, and only then does the application callback
# run. Every backend therefore shares one resolution, one write-back and one
# event vocabulary instead of inventing three.

        # The reverse of set_native_handle. A backend calls this from its
        # action callback, where all it has is the toolkit's own object.
        def index_for_native_handle(handle: usize) -> i32:
            return NO_PARENT if handle == 0
            for index in 0..<total:
                return index.i32() if ops[index].native_handle == handle
            return NO_PARENT

        # Record what the user just did before the application sees the event,
        # so a callback that reads the control's state observes the new value
        # rather than the one the tree was realized with.
        def note_value(index: usize, value: f32, selected: bool) -> bool:
            return false if index >= total
            return false if not UiCore::is_finite(value)
            ops[index].state_value <- value
            ops[index].state_selected <- selected
            return true

        # A selectable control is one of a group: turning one on turns its
        # siblings off. The toolkit does not know the group, the retained list
        # does, so the write-back happens here rather than in a backend.
        def note_selection(index: usize, selected: bool) -> bool:
            return false if index >= total
            ops[index].state_selected <- selected
            return true if not selected or ops[index].kind != ControlKind.RadioButton
            parent: i32 = ops[index].parent
            for sibling in 0..<total:
                continue if sibling == index
                continue if ops[sibling].kind != ControlKind.RadioButton or ops[sibling].parent != parent
                ops[sibling].state_selected <- false
            return true

        # WHAT THE USER TYPED, ON ITS WAY BACK IN.
        #
        # A native field is the strongest reason to realize native controls at
        # all: it brings the IME, dictation, autocorrect, the selection
        # magnifier, spell checking and the system paste menu, none of which a
        # framework that draws its own caret can borrow. All of that is worth
        # nothing if the words never reach the application, and until this
        # existed they did not -- an action carried a float and a flag, and a
        # string had nowhere to ride.
        #
        # It rides on its own. A value and a caption are different enough that
        # squeezing text through the numeric channel would mean encoding it;
        # the backend hands over bytes and this copies them into the arena the
        # list already owns, so `text_at` answers with what the field now holds
        # rather than what it was realized with.
        def note_text(index: usize, text: sview) -> bool:
            return false if index >= total
            # Only a field edits itself. A caption that came from the tree is
            # the application's to change, and a toolkit reporting one back
            # would be a loop, not an edit.
            return false if ops[index].kind != ControlKind.TextField
            # A null-backed counted view is not an empty string; refusing it
            # keeps a bridge that lost its buffer from clearing a live field.
            return false if text.len < 0 or (text.len > 0 and text.data == null)
            ops[index].text <- copy_control_text(index, text)
            return true

        # The text sibling of dispatch_native_action, and the same contract: a
        # handle from the toolkit, resolved here, written back here, and only
        # then does the application hear about it.
        def dispatch_native_text(handle: usize, text: sview) -> i32:
            index: i32 = index_for_native_handle(handle)
            return NO_PARENT if index == NO_PARENT
            return NO_PARENT if not note_text(index.usize(), text)
            app_control_event(index, UiConst::WidgetEvent.Change.i32())
            return index

        # The one entry point a backend's action callback needs. Returns the
        # resolved control index, or NO_PARENT when the handle belongs to no
        # live control -- which is what a late callback from a torn-down tree
        # looks like, and must not reach the application.
        def dispatch_native_action(handle: usize, event: UiConst::WidgetEvent, value: f32, selected: bool) -> i32:
            index: i32 = index_for_native_handle(handle)
            return NO_PARENT if index == NO_PARENT
            slot: usize = index.usize()
            if event == UiConst::WidgetEvent.Change:
                return NO_PARENT if not note_value(slot, value, selected)
            if event == UiConst::WidgetEvent.Click:
                return NO_PARENT if not note_selection(slot, selected)
            app_control_event(index, event.i32())
            return index

        # Which controls have anything to report. A label or a panel has no
        # action, and asking a toolkit to install one on them would either be
        # ignored or, worse, quietly accepted.
        def kind_reports_action(kind: ControlKind) -> bool:
            return kind == ControlKind.PushButton or kind == ControlKind.ToggleButton or kind == ControlKind.CheckBox or kind == ControlKind.RadioButton or kind == ControlKind.Slider or kind == ControlKind.TextField

        # What acting on a control means. A button is a click; dragging a
        # slider or typing in a field is a change. Keeping this here means a
        # backend reports the raw fact and never picks the vocabulary.
        def action_event_for(kind: ControlKind) -> UiConst::WidgetEvent:
            return UiConst::WidgetEvent.Change if kind == ControlKind.Slider or kind == ControlKind.TextField
            return UiConst::WidgetEvent.Click
