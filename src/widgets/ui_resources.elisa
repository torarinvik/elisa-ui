# Elisa-owned logical resource state for images, fonts and other package assets.
#
# Hosts/SDKs own verified bytes, transport, caching and decode/upload. This
# module owns only the visible state attached to a live view: typed identity,
# request deduplication, progress, cancellation and recoverable transitions.
# It is fixed-capacity and allocation-free so the same state machine works in
# native tests and a Wasm component.

include "../core/ui_core.elisa"

module UiResources:
    public:
        const MAX_RESOURCES: usize = 128
        const IDENTIFIER_CAPACITY: usize = 256

        const enum State of i32:
            Unrequested = 0
            Requested = 1
            Ready = 2
            UnavailableOffline = 3
            Denied = 4
            Failed = 5
            Cancelled = 6

        const enum FailureKind of i32:
            Unknown = 0
            RetryableTransport = 1
            Corrupt = 2
            Incompatible = 3

        struct Handle:
            slot: u32
            generation: u32

        struct Snapshot:
            total: usize
            requested: usize
            ready: usize
            unavailable_offline: usize
            denied: usize
            failed: usize
            cancelled: usize
            overflowed: bool

        def invalid() -> Handle:
            return Handle{slot: MAX_RESOURCES.u32(), generation: 0}

        def is_valid(handle: Handle) -> bool:
            return handle.slot.usize() < resource_count and handle.generation == resource_generations[handle.slot.usize()] and resource_states[handle.slot.usize()] != State.Unrequested

        def reset() -> void:
            for slot in 0..<MAX_RESOURCES:
                next_generation: u32 = resource_generations[slot] + 1
                resource_generations[slot] <- 1 if next_generation == 0 else next_generation
                resource_states[slot] <- State.Unrequested
                resource_failure_kinds[slot] <- FailureKind.Unknown
                resource_owners[slot] <- 0
                resource_identifier_lengths[slot] <- 0
                resource_downloaded[slot] <- 0.0
                resource_decoded[slot] <- 0.0
                resource_demanded[slot] <- false
                resource_priorities[slot] <- 0
            resource_count <- 0
            resource_overflowed <- false
            UiCore::clear_invalidations(UiCore::Invalidation.Resources)
            UiCore::invalidate(UiCore::Invalidation.Resources)
            UiCore::invalidate(UiCore::Invalidation.Paint)

        def count() -> usize:
            total: mutable usize = 0
            for slot in 0..<resource_count:
                total <- total + 1 if resource_states[slot] != State.Unrequested
            return total

        def overflowed() -> bool:
            return resource_overflowed

        def snapshot() -> Snapshot:
            requested_count: mutable usize = 0
            ready_count: mutable usize = 0
            offline_count: mutable usize = 0
            denied_count: mutable usize = 0
            failed_count: mutable usize = 0
            cancelled_count: mutable usize = 0
            for slot in 0..<resource_count:
                if resource_states[slot] == State.Requested:
                    requested_count <- requested_count + 1
                elif resource_states[slot] == State.Ready:
                    ready_count <- ready_count + 1
                elif resource_states[slot] == State.UnavailableOffline:
                    offline_count <- offline_count + 1
                elif resource_states[slot] == State.Denied:
                    denied_count <- denied_count + 1
                elif resource_states[slot] == State.Failed:
                    failed_count <- failed_count + 1
                elif resource_states[slot] == State.Cancelled:
                    cancelled_count <- cancelled_count + 1
            return Snapshot{total: count(), requested: requested_count,
                ready: ready_count, unavailable_offline: offline_count,
                denied: denied_count, failed: failed_count,
                cancelled: cancelled_count, overflowed: resource_overflowed}

        def key_matches(slot: usize, key: sview) -> bool:
            return false if slot >= MAX_RESOURCES or key.len < 0
            return false if resource_identifier_lengths[slot] != key.len
            for offset in 0..<key.len:
                return false if resource_identifier_storage[slot * IDENTIFIER_CAPACITY + offset] != key.data[offset]
            return true

        def make_handle(slot: usize) -> Handle:
            return Handle{slot: slot.u32(), generation: resource_generations[slot]}

        def clear_slot(slot: usize) -> void:
            next_generation: u32 = resource_generations[slot] + 1
            resource_generations[slot] <- 1 if next_generation == 0 else next_generation
            resource_states[slot] <- State.Unrequested
            resource_failure_kinds[slot] <- FailureKind.Unknown
            resource_owners[slot] <- 0
            resource_identifier_lengths[slot] <- 0
            for index in 0..<IDENTIFIER_CAPACITY:
                resource_identifier_storage[slot * IDENTIFIER_CAPACITY + index] <- 0
            resource_downloaded[slot] <- 0.0
            resource_decoded[slot] <- 0.0
            resource_demanded[slot] <- false
            resource_priorities[slot] <- 0

        def mark_changed() -> void:
            UiCore::invalidate(UiCore::Invalidation.Resources)
            UiCore::invalidate(UiCore::Invalidation.Paint)

        # Requesting a key is idempotent while its record is alive. This keeps
        # per-frame view rebuilds from starting duplicate host work. A cancelled
        # record can be requested again, but that starts a new host operation and
        # therefore rotates its generation so late completion from the cancelled
        # operation cannot mutate the replacement request.
        def request(key: sview, owner: u32) -> Handle:
            return invalid() if key.len <= 0 or key.len >= IDENTIFIER_CAPACITY
            for slot in 0..<resource_count:
                if resource_states[slot] != State.Unrequested and key_matches(slot, key):
                    resource_owners[slot] <- owner
                    if resource_states[slot] == State.Cancelled:
                        next_generation: u32 = resource_generations[slot] + 1
                        resource_generations[slot] <- 1 if next_generation == 0 else next_generation
                        resource_states[slot] <- State.Requested
                        resource_failure_kinds[slot] <- FailureKind.Unknown
                        resource_downloaded[slot] <- 0.0
                        resource_decoded[slot] <- 0.0
                        mark_changed()
                    return make_handle(slot)

            free_slot: mutable usize = MAX_RESOURCES
            for slot in 0..<MAX_RESOURCES:
                if resource_states[slot] == State.Unrequested:
                    free_slot <- slot
                    break
            if free_slot == MAX_RESOURCES:
                resource_overflowed <- true
                return invalid()

            generation: u32 = resource_generations[free_slot]
            resource_generations[free_slot] <- 1 if generation == 0 else generation
            offset: usize = free_slot * IDENTIFIER_CAPACITY
            for index in 0..<IDENTIFIER_CAPACITY:
                resource_identifier_storage[offset + index] <- key.data[index] if index < key.len else 0
            resource_identifier_lengths[free_slot] <- key.len
            resource_owners[free_slot] <- owner
            resource_states[free_slot] <- State.Requested
            resource_downloaded[free_slot] <- 0.0
            resource_decoded[free_slot] <- 0.0
            resource_demanded[free_slot] <- false
            resource_priorities[free_slot] <- 0
            resource_count <- free_slot + 1 if free_slot >= resource_count else resource_count
            mark_changed()
            return make_handle(free_slot)

        def state(handle: Handle) -> State:
            return State.Unrequested if not is_valid(handle)
            return resource_states[handle.slot.usize()]

        def failure(handle: Handle) -> FailureKind:
            return FailureKind.Unknown if not is_valid(handle)
            return resource_failure_kinds[handle.slot.usize()]

        # Transport failures may be retried; corrupt or incompatible bytes
        # require a package update or host/toolchain change and must not cause
        # an automatic retry loop in a view.
        def fail(handle: Handle, kind: FailureKind) -> bool:
            return false if not is_valid(handle) or not failure_kind_is_valid(kind)
            slot: usize = handle.slot.usize()
            # Cancellation is terminal for this generation. A host operation
            # that races teardown must not turn a cancelled record into a
            # visible failure; request() creates the next generation first.
            return false if resource_states[slot] == State.Ready or resource_states[slot] == State.Cancelled
            resource_states[slot] <- State.Failed
            resource_failure_kinds[slot] <- kind
            mark_changed()
            return true

        def can_retry(handle: Handle) -> bool:
            return false if not is_valid(handle)
            current: State = resource_states[handle.slot.usize()]
            return current == State.UnavailableOffline or current == State.Denied or (current == State.Failed and resource_failure_kinds[handle.slot.usize()] == FailureKind.RetryableTransport)

        def owner(handle: Handle) -> u32:
            return 0 if not is_valid(handle)
            return resource_owners[handle.slot.usize()]

        def identifier(handle: Handle) -> sview:
            return "" if not is_valid(handle)
            slot: usize = handle.slot.usize()
            return sview(&resource_identifier_storage[slot * IDENTIFIER_CAPACITY], 0, resource_identifier_lengths[slot].i64())

        def downloaded_progress(handle: Handle) -> f32:
            return 0.0 if not is_valid(handle)
            return resource_downloaded[handle.slot.usize()]

        def decoded_progress(handle: Handle) -> f32:
            return 0.0 if not is_valid(handle)
            return resource_decoded[handle.slot.usize()]

        # Visibility and prefetch policy stays in Elisa, while the host decides
        # whether a hint can be serviced under bandwidth/cache constraints.
        # A repeated hint is idempotent and only invalidates when its value
        # changes, so scrolling cannot create a request storm.
        def set_demand(handle: Handle, priority: u32) -> bool:
            return false if not is_valid(handle)
            slot: usize = handle.slot.usize()
            return false if resource_demanded[slot] and resource_priorities[slot] == priority
            resource_demanded[slot] <- true
            resource_priorities[slot] <- priority
            mark_changed()
            return true

        def clear_demand(handle: Handle) -> bool:
            return false if not is_valid(handle) or not resource_demanded[handle.slot.usize()]
            resource_demanded[handle.slot.usize()] <- false
            resource_priorities[handle.slot.usize()] <- 0
            mark_changed()
            return true

        def is_demanded(handle: Handle) -> bool:
            return is_valid(handle) and resource_demanded[handle.slot.usize()]

        def demand_priority(handle: Handle) -> u32:
            return 0 if not is_valid(handle) or not resource_demanded[handle.slot.usize()]
            return resource_priorities[handle.slot.usize()]

        # Hosts report transport/decode progress independently. Both fractions
        # are normalized before storage; network completion therefore does not
        # imply a resource is ready to paint.
        def set_progress(handle: Handle, network: f32, decode: f32) -> bool:
            return false if not is_valid(handle)
            slot: usize = handle.slot.usize()
            # Progress belongs to the currently requested operation only. Once
            # it is cancelled or resolved, late host reports are stale and
            # must not dirty the replacement/presentation state.
            return false if resource_states[slot] != State.Requested
            next_network: f32 = UiCore::normalized_unit(network)
            next_decode: f32 = UiCore::normalized_unit(decode)
            return false if resource_downloaded[slot] == next_network and resource_decoded[slot] == next_decode
            resource_downloaded[slot] <- next_network
            resource_decoded[slot] <- next_decode
            mark_changed()
            return true

        def set_state(handle: Handle, next: State) -> bool:
            return false if not is_valid(handle) or not state_is_valid(next)
            slot: usize = handle.slot.usize()
            # A cancelled generation can only be observed or replaced through
            # request(), which rotates its generation before host work resumes.
            return false if resource_states[slot] == State.Cancelled
            return false if resource_states[slot] == next
            resource_states[slot] <- next
            resource_failure_kinds[slot] <- FailureKind.RetryableTransport if next == State.Failed else FailureKind.Unknown
            if next == State.Requested:
                resource_downloaded[slot] <- 0.0
                resource_decoded[slot] <- 0.0
            if next == State.Ready:
                resource_downloaded[slot] <- 1.0
                resource_decoded[slot] <- 1.0
            mark_changed()
            return true

        def cancel(handle: Handle) -> bool:
            return set_state(handle, State.Cancelled)

        def retry(handle: Handle) -> bool:
            return false if not is_valid(handle)
            current: State = resource_states[handle.slot.usize()]
            return false if not can_retry(handle)
            return set_state(handle, State.Requested)

        # Disposal invalidates the generation before releasing the identifier.
        # A late host completion holding the old token therefore becomes a safe
        # no-op even when the slot is immediately reused by a different key.
        def dispose(handle: Handle) -> bool:
            return false if not is_valid(handle)
            slot: usize = handle.slot.usize()
            clear_slot(slot)
            while resource_count > 0 and resource_states[resource_count - 1] == State.Unrequested:
                resource_count <- resource_count - 1
            mark_changed()
            return true

        # View teardown commonly owns several assets. Dispose them together so
        # every token is invalidated before a slot can be reused and observers
        # receive one coalesced resource/paint invalidation.
        def dispose_owner(owner: u32) -> usize:
            released: mutable usize = 0
            for slot in 0..<resource_count:
                if resource_states[slot] != State.Unrequested and resource_owners[slot] == owner:
                    clear_slot(slot)
                    released <- released + 1
            while resource_count > 0 and resource_states[resource_count - 1] == State.Unrequested:
                resource_count <- resource_count - 1
            mark_changed() if released > 0
            return released

        # Cancellation keeps the logical record available for a re-request. The
        # re-request rotates its generation, so an old host task cannot resume
        # into the replacement operation for the same key.
        def cancel_owner(owner: u32) -> usize:
            cancelled: mutable usize = 0
            for slot in 0..<resource_count:
                if resource_states[slot] != State.Unrequested and resource_owners[slot] == owner and resource_states[slot] != State.Cancelled:
                    resource_states[slot] <- State.Cancelled
                    cancelled <- cancelled + 1
            mark_changed() if cancelled > 0
            return cancelled

        def failure_kind_is_valid(value: FailureKind) -> bool:
            return value == FailureKind.RetryableTransport or value == FailureKind.Corrupt or value == FailureKind.Incompatible

        def state_is_valid(value: State) -> bool:
            return value == State.Requested or value == State.Ready or value == State.UnavailableOffline or value == State.Denied or value == State.Failed or value == State.Cancelled

    private:
        global mutable resource_count: usize = 0
        global mutable resource_overflowed: bool = false
        global mutable resource_generations: u32[MAX_RESOURCES] = zeroed
        global mutable resource_states: State[MAX_RESOURCES] = zeroed
        global mutable resource_failure_kinds: FailureKind[MAX_RESOURCES] = zeroed
        global mutable resource_owners: u32[MAX_RESOURCES] = zeroed
        global mutable resource_identifier_lengths: usize[MAX_RESOURCES] = zeroed
        global mutable resource_identifier_storage: u8[MAX_RESOURCES * IDENTIFIER_CAPACITY] = zeroed
        global mutable resource_downloaded: f32[MAX_RESOURCES] = zeroed
        global mutable resource_decoded: f32[MAX_RESOURCES] = zeroed
        global mutable resource_demanded: bool[MAX_RESOURCES] = zeroed
        global mutable resource_priorities: u32[MAX_RESOURCES] = zeroed
