# Elisa-owned logical resource state for images, fonts and other package assets.
#
# Hosts/SDKs own verified bytes, transport, caching and decode/upload. The
# framework owns only the visible state attached to a live view. The public
# include remains intentionally tiny; policy is organized into cohesive
# identity, query, demand, and transition extensions below.

include "./ui_resources_types.elisa"
include "./ui_resources_identity.elisa"
include "./ui_resources_queries.elisa"
include "./ui_resources_demand.elisa"
include "./ui_resources_transitions.elisa"
include "./ui_resource_metadata.elisa"
