extend UiWidgets:
    public:
        def hot() -> Widget?:
            return hot_widget

        def active() -> Widget?:
            return active_widget

        # Feed one event through the tree. `root` is the tree being tested. Anything
        # that is not a pointer event is ignored, so an app can hand the whole stream
        # over without sorting it first.
        def pointer(root: Widget, event: UiCore::Event) -> void:
            match event:
                UiCore::PointerEvent.Move(move_at):
                    _ = hover_at(root, move_at)
                UiCore::PointerEvent.Down(down_at, down_button):
                    press_at(root, down_at, down_button)
                UiCore::PointerEvent.Up(up_at, up_button):
                    release_at(root, up_at, up_button)
                UiCore::PointerEvent.Scroll(scroll_at, scroll_delta):
                    scroll_pointer(root, scroll_at, scroll_delta)
                UiCore::PointerEvent.Leave:
                    leave_all(root)
                _:
                    pass
