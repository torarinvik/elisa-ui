# UiFlat adapter for the backend-neutral UiTheme palette.
#
# UiTheme resolves appearance facts and accessibility preferences without
# knowing widget storage. This module is the deliberate bridge: it updates
# only shared framework color tokens, preserving each widget's application-
# chosen surfaces, hover colors, text colors, and geometry metrics.

include "./ui_theme.elisa"

extend UiFlat:
    public:
        # A choice marker as a multiple of the spacing unit. See apply_metrics.
        const MARKER_PER_SPACING: f32 = 1.375
        # The rest of the affordances, each at the ratio that reproduces the
        # value it was constructed with at the default eight-point spacing.
        const TRACK_PER_SPACING: f32 = 0.75
        const THUMB_PER_SPACING: f32 = 1.0
        const SCROLLBAR_PER_SPACING: f32 = 1.0
        const SCROLLBAR_INSET_PER_SPACING: f32 = 0.5

        # Apply one resolved palette without replacing application-specific
        # widget colors or layout metrics. The return value lets a frame skip
        # work when a host repeats the same appearance facts.
        def apply_palette(palette: UiTheme::Palette) -> bool:
            current: mutable Theme = theme()
            current.focus_ring <- themed_alpha(palette.focus_ring, 245)
            current.selection <- themed_alpha(palette.selection, 210)
            current.control_mark <- themed_alpha(palette.text, 185)
            current.control_mark_strong <- palette.accent
            current.scrollbar_track <- themed_alpha(palette.disabled_surface, 165)
            current.scrollbar_thumb <- themed_alpha(palette.muted_text, 175)
            current.scrollbar_thumb_hover <- themed_alpha(palette.text, 220)
            current.scrollbar_thumb_active <- palette.accent
            return false if themes_equal(theme(), current)
            set_theme(current)
            return true

        # Apply shared geometry tokens to framework visual controls. Per-widget
        # declared frames remain untouched; only painter affordance tokens are
        # updated, so applications retain explicit layout ownership.
        def apply_metrics(metrics: UiTheme::Metrics) -> bool:
            current: mutable Theme = theme()
            current.focus_inset <- UiConstraints::bounded(metrics.focus_ring_width)
            current.text_horizontal_padding <- UiConstraints::bounded(metrics.spacing_unit / 2.0)
            current.text_vertical_padding <- UiConstraints::bounded(metrics.spacing_unit / 2.0)
            # ...and so is every other affordance the reader has to see or hit.
            # The track came from the focus ring's width for the same reason
            # the marker did, and the THUMB and the SCROLLBAR were not applied
            # at all: they sat at their construction defaults for the life of
            # the process, so a reader at double-size text got an 8pt scrollbar
            # and an 8pt thumb beside a doubled touch target. Each ratio below
            # lands on the value that default was, so nothing moves until a
            # preference asks it to.
            current.slider_track_height <- UiConstraints::bounded(metrics.spacing_unit * TRACK_PER_SPACING)
            current.slider_thumb_radius <- UiConstraints::bounded(metrics.spacing_unit * THUMB_PER_SPACING)
            current.scrollbar_width <- UiConstraints::bounded(metrics.spacing_unit * SCROLLBAR_PER_SPACING)
            current.scrollbar_inset <- UiConstraints::bounded(metrics.spacing_unit * SCROLLBAR_INSET_PER_SPACING)
            # A MARKER IS TYPOGRAPHY, so it scales with the text preference.
            #
            # These were derived from the focus ring's width, which is a proxy
            # for "high contrast wants them bigger" and nothing else -- and the
            # ring's width is deliberately NOT scaled, because thickness is a
            # style decision. So a reader who asked for double-size text got an
            # 11pt checkbox beside 28pt words. Every platform grows the control
            # glyph with dynamic type; a checkbox that stays put is the one
            # element on the page the preference did not reach.
            #
            # The spacing unit is the token that already carries the scale, and
            # the ratio is chosen to leave the default and high-contrast sizes
            # where they were: 8 -> 11 and 10 -> 13.75, against 11 and 14.
            current.checkbox_size <- UiConstraints::bounded(metrics.spacing_unit * MARKER_PER_SPACING)
            current.radio_outer_radius <- current.checkbox_size / 2.0
            current.radio_inner_radius <- current.checkbox_size / 4.0
            # The marker's centre and its label's origin are ONE measurement,
            # not two independent tokens. They used to be set apart -- the
            # label origin was the raw spacing unit, which at the default 8pt
            # is inside the marker it is supposed to follow. Nothing showed
            # because the painter centred the label in the leftover space;
            # a leading-aligned label would have drawn straight through the
            # box. Deriving both from the marker keeps the gap on either side
            # of it equal to one spacing unit at any accessibility scale.
            current.choice_center_x <-
                inset: f32 = metrics.spacing_unit
                UiConstraints::bounded(inset + current.checkbox_size / 2.0)
            current.choice_text_space <-
                marker_edge: f32 = current.choice_center_x + current.checkbox_size / 2.0
                UiConstraints::bounded(marker_edge + metrics.spacing_unit)
            return false if themes_equal(theme(), current)
            set_theme(current)
            return true

        def apply_system_metrics(preferences: UiTheme::Preferences, system_high_contrast: bool) -> bool:
            preferences_changed: bool = UiTheme::set_preferences(preferences)
            metrics_changed: bool = apply_metrics(UiTheme::scaled_metrics(UiTheme::current_preferences(), system_high_contrast))
            return preferences_changed or metrics_changed

        # Resolve and apply in one call when the host supplies system facts.
        # The resolved palette remains inspectable through UiTheme and the
        # framework theme remains overrideable through set_theme.
        def apply_system_theme(preferences: UiTheme::Preferences, system_dark: bool, system_high_contrast: bool) -> bool:
            preferences_changed: bool = UiTheme::set_preferences(preferences)
            palette_changed: bool = apply_palette(UiTheme::resolve(UiTheme::current_preferences(), system_dark, system_high_contrast))
            metrics_changed: bool = apply_metrics(UiTheme::scaled_metrics(UiTheme::current_preferences(), system_high_contrast))
            return preferences_changed or palette_changed or metrics_changed

    private:
        def themed_alpha(color: UiCore::Color, alpha: u8) -> UiCore::Color:
            return UiCore::Color{r: color.r, g: color.g, b: color.b, a: alpha}
