# Control rows carry caption, placeholder and help views, which must have
# valid backing before the first realization fills them, so start from
# empty rows rather than zeroed memory.
const EMPTY_CONTROL_OP: UiControls::ControlOp = UiControls::ControlOp{
    kind: UiControls::ControlKind.Window, window_mode: UiControls::WindowMode.Fixed,
    axis: UiConst::Axis.Column,
    state_value: 0.0, state_low: 0.0, state_high: 0.0,
    state_selected: false, state_enabled: false, state_secure: false,
    parent: 0, box: UiCore::Rect{origin: UiCore::Vec2{x: 0.0, y: 0.0}, size: UiCore::Size{width: 0.0, height: 0.0}},
    text: "", placeholder: "", help: "",
    ink: UiCore::Color{r: 0, g: 0, b: 0, a: 0}, fill: UiCore::Color{r: 0, g: 0, b: 0, a: 0},
    native_handle: 0,
}

