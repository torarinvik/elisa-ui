# Responsive mutations for retained flat containers.

extend UiFlat:
    public:
        # Change a retained panel's main axis without rebuilding its subtree.
        # This is the primitive responsive layouts need when a resize crosses
        # a breakpoint; widget identities, focus, and edit state remain intact.
        # Scroll and virtual-list axes describe their content contract and are
        # deliberately not changed through this panel-only operation.
        def set_panel_axis(index: usize, axis: UiConst::Axis) -> void:
            return if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.Panel
            normalized: UiConst::Axis = UiConst::normalize_axis(axis)
            return if widgets[index].axis == normalized
            widgets[index].axis <- normalized
            mark_layout_dirty()
