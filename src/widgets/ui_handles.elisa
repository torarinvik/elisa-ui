# elisa-ui typed handles over the allocation-free UiFlat compatibility layer.
#
# UiFlat keeps its historical usize API for small programs and C-facing code.
# UiHandles is the safe application-facing surface, organized by ownership:
# identity/tree lifetime, construction, styling/queries, and interaction.
# Each extension remains public only where it is part of the application API;
# retained arena storage stays private to UiFlat.

include "./ui_handles_types.elisa"
include "./ui_handles_build.elisa"
include "./ui_handles_style.elisa"
include "./ui_handles_input.elisa"
