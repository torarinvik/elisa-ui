# Widget-to-native-control policy for UiControls.
#
# The retained control arena stays in ui_controls.elisa. This extension owns
# only the exhaustive mapping from hierarchy variants to control kinds, state,
# window decoration, and bounded captions before a backend crosses the FFI.

        def normalized_slider(value: f32, low: f32, high: f32) -> ControlState:
            lower: mutable f32 = UiCore::bounded_coordinate(low)
            upper: mutable f32 = UiCore::bounded_coordinate(high)
            if upper < lower:
                swap: f32 = lower
                lower <- upper
                upper <- swap
            candidate: f32 = UiCore::bounded_coordinate(value)
            safe_value: f32 = lower if candidate < lower else (upper if candidate > upper else candidate)
            return ControlState{value: safe_value, low: lower, high: upper, selected: false}

        # Which OS control realizes this widget. Exhaustive on purpose: a
        # widget kind added without a control is a compile error here.
        def kind_of(w: UiWidgets::Widget) -> Kind:
            match w:
                UiWidgets::Window.Top(title, resizable):
                    return Kind.Window
                UiWidgets::Window.Floating(title):
                    return Kind.Window
                UiWidgets::Container.Box(axis, padding, spacing, fill):
                    return Kind.Panel
                UiWidgets::Container.Grid(columns, padding, spacing, fill):
                    return Kind.Panel
                UiWidgets::Container.Scroll(axis, offset, fill):
                    return Kind.ScrollView
                UiWidgets::Container.ScrollWithState(axis, state, fill):
                    return Kind.ScrollView
                UiWidgets::Control.Label(text, size, ink):
                    return Kind.Label
                UiWidgets::Control.Gauge(fraction, track, bar):
                    return Kind.ProgressBar
                UiWidgets::Control.Slider(value, low, high, track, knob):
                    return Kind.Slider
                UiWidgets::Control.TextBox(text, caret, size, ink, fill):
                    return Kind.TextField
                UiWidgets::Button.Push(label, rest, hover, press):
                    return Kind.PushButton
                UiWidgets::Button.Toggle(label, on, rest, hover, press):
                    return Kind.ToggleButton
                UiWidgets::Button.Check(label, checked, rest, hover, press):
                    return Kind.CheckBox
                UiWidgets::Button.Radio(label, group, selected, rest, hover, press):
                    return Kind.RadioButton

        # The hierarchy's window variants carry the only decoration policy the
        # controls seam needs. All non-window controls use the neutral value.
        def window_mode_of(w: UiWidgets::Widget) -> WindowMode:
            match w:
                UiWidgets::Window.Top(title, resizable):
                    return WindowMode.Resizable if resizable else WindowMode.Fixed
                UiWidgets::Window.Floating(title):
                    return WindowMode.Floating
                _:
                    return WindowMode.Fixed

        # Extract widget values once, in Elisa, before the native boundary.
        def state_of(w: UiWidgets::Widget) -> ControlState:
            match w:
                UiWidgets::Control.Gauge(fraction, track, bar):
                    return ControlState{value: UiCore::normalized_unit(fraction), low: 0.0, high: 1.0, selected: false}
                UiWidgets::Control.Slider(value, low, high, track, knob):
                    return normalized_slider(value, low, high)
                UiWidgets::Button.Toggle(label, on, rest, hover, press):
                    return ControlState{value: 0.0, low: 0.0, high: 1.0, selected: on}
                UiWidgets::Button.Check(label, checked, rest, hover, press):
                    return ControlState{value: 0.0, low: 0.0, high: 1.0, selected: checked}
                UiWidgets::Button.Radio(label, group, selected, rest, hover, press):
                    return ControlState{value: 0.0, low: 0.0, high: 1.0, selected: selected}
                _:
                    return ControlState{value: 0.0, low: 0.0, high: 1.0, selected: false}

        # The text a control shows. Empty for anything that carries none, so a
        # backend can set it unconditionally.
        def text_of(w: UiWidgets::Widget) -> sview:
            match w:
                UiWidgets::Window.Top(title, resizable):
                    return normalized_text(title)
                UiWidgets::Window.Floating(title):
                    return normalized_text(title)
                UiWidgets::Control.Label(text, size, ink):
                    return normalized_text(text)
                UiWidgets::Control.TextBox(text, caret, size, ink, fill):
                    return normalized_text(text)
                UiWidgets::Button.Push(label, rest, hover, press):
                    return normalized_text(label)
                UiWidgets::Button.Toggle(label, on, rest, hover, press):
                    return normalized_text(label)
                UiWidgets::Button.Check(label, checked, rest, hover, press):
                    return normalized_text(label)
                UiWidgets::Button.Radio(label, group, selected, rest, hover, press):
                    return normalized_text(label)
                _:
                    return ""

        def normalized_text(value: sview) -> sview:
            return UiCore::bounded_text(value)
