# UiFlat measurement, arrangement, and focus helpers.
# This file is included by ui_widget.elisa; UiFlat remains the public
# compatibility namespace while its implementation is organized by concern.

extend UiFlat:
    private:
        def child_count(index: usize) -> usize:
            total: mutable usize = 0
            cursor: mutable usize = widgets[index].first_child
            for _ in 0..<MAX_TRAVERSAL_SIBLINGS:
                break if cursor == NONE or cursor >= widget_count
                total <- total + 1 if widgets[cursor].visible
                cursor <- widgets[cursor].next_sibling
            return total

        def effectively_enabled(index: usize) -> bool:
            return false if index >= widget_count
            cursor: mutable usize = index
            steps: mutable usize = 0
            for _ in 0..<MAX_TRAVERSAL_DEPTH:
                break if cursor >= widget_count
                return false if not widgets[cursor].enabled
                steps <- steps + 1
                return false if steps >= MAX_TRAVERSAL_DEPTH and widgets[cursor].parent < widget_count
                cursor <- widgets[cursor].parent
            return true

        def collapse(index: usize, depth: usize) -> void:
            return if index >= widget_count or depth >= MAX_TRAVERSAL_DEPTH
            widgets[index] with { x <- 0.0, y <- 0.0, width <- 0.0, height <- 0.0 }
            child: mutable usize = widgets[index].first_child
            for _ in 0..<MAX_TRAVERSAL_SIBLINGS:
                return if child >= widget_count and child != NONE
                break if child == NONE
                collapse(child, depth + 1)
                child <- widgets[child].next_sibling

        # Top-down pass: give every child its minimum along the axis, then
        # share the leftover in proportion to `grow`. Cross-axis alignment can
        # stretch a child or place its measured extent at the start, center, or
        # end of the remaining band.
        def arrange(index: usize, x: f32, y: f32, width: f32, height: f32, depth: usize) -> void:
            return if index >= widget_count or depth >= MAX_TRAVERSAL_DEPTH
            if not effectively_visible(index):
                collapse(index, depth)
                return
            # Keep both the stored frame and all arithmetic below inside the
            # shared geometry envelope. A large scroll translation can be
            # finite while still overflowing a later native or raster API.
            safe_x: f32 = UiCore::bounded_coordinate(x)
            safe_y: f32 = UiCore::bounded_coordinate(y)
            safe_width: f32 = UiConstraints::bounded(width)
            safe_height: f32 = UiConstraints::bounded(height)
            widgets[index] with { x <- safe_x, y <- safe_y, width <- safe_width, height <- safe_height }
            first: usize = widgets[index].first_child
            return if first == NONE

            pad: f32 = widgets[index].padding
            inner_x: f32 = UiCore::bounded_coordinate(safe_x + pad)
            inner_y: f32 = UiCore::bounded_coordinate(safe_y + pad)
            raw_inner_width: f32 = safe_width - pad * 2.0
            raw_inner_height: f32 = safe_height - pad * 2.0
            inner_width: f32 = raw_inner_width if raw_inner_width > 0.0 else 0.0
            inner_height: f32 = raw_inner_height if raw_inner_height > 0.0 else 0.0
            if widgets[index].virtual_list:
                arrange_virtual_rows(index, inner_x, inner_y, inner_width, inner_height, depth)
                return
            is_row: bool = widgets[index].axis == UiConst::Axis.Row
            scrolling: bool = widgets[index].kind == UiConst::WidgetKind.Scroll

            children: f32 = child_count(index).f32()
            gaps: f32 = widgets[index].spacing * (children - 1.0) if children > 1.0 else 0.0
            viewport_along: f32 = inner_width if is_row else inner_height
            content_along: f32 = widgets[index].scroll_content_width if is_row else widgets[index].scroll_content_height
            inner_along: f32 = content_along if scrolling and content_along > viewport_along else viewport_along
            if scrolling:
                limit: f32 = content_along - viewport_along if content_along > viewport_along else 0.0
                next_offset: mutable f32 = UiCore::nonnegative_extent(widgets[index].scroll_offset)
                next_offset <- limit if next_offset > limit else next_offset
                widgets[index].scroll_offset <- next_offset

            demand: mutable f32 = 0.0
            minimum_demand: mutable f32 = 0.0
            weight: mutable f32 = 0.0
            cursor: mutable usize = first
            demand_steps: mutable usize = 0
            while cursor != NONE |cursor, demand, minimum_demand, weight, is_row, demand_steps|:
                return if demand_steps >= MAX_TRAVERSAL_SIBLINGS or cursor >= widget_count
                demand_steps <- demand_steps + 1
                if widgets[cursor].visible:
                    layout_extra[cursor] <- 0.0
                    layout_capped[cursor] <- false
                    demand <- demand + (widgets[cursor].preferred_width if is_row else widgets[cursor].preferred_height) + widgets[cursor].margin * 2.0
                    minimum_demand <- minimum_demand + (widgets[cursor].min_width if is_row else widgets[cursor].min_height) + widgets[cursor].margin * 2.0
                    weight <- weight + widgets[cursor].grow
                cursor <- widgets[cursor].next_sibling

            required: f32 = demand + gaps
            scale: mutable f32 = inner_along / required if required > inner_along and required > 0.0 else 1.0
            free: mutable f32 = inner_along - demand - gaps
            preserve_minimums: bool = preserves_child_minimums(index)
            shrink_scale: mutable f32 = 1.0
            if preserve_minimums and required > inner_along:
                flexible_demand: f32 = demand - minimum_demand
                available_flexible: f32 = inner_along - gaps - minimum_demand
                if flexible_demand > 0.0:
                    shrink_scale <- available_flexible / flexible_demand
                    shrink_scale <- 0.0 if shrink_scale < 0.0 else shrink_scale
                    shrink_scale <- 1.0 if shrink_scale > 1.0 else shrink_scale
                else:
                    shrink_scale <- 0.0
                arranged_demand: f32 = minimum_demand + flexible_demand * shrink_scale
                free <- inner_along - arranged_demand - gaps
                scale <- 1.0

            # Iterative weighted distribution prevents a capped child from
            # stranding free space that an uncapped sibling could use.
            remaining: mutable f32 = free if free > 0.0 and scale == 1.0 else 0.0
            remaining_weight: mutable f32 = weight
            distributing: mutable bool = remaining > 0.0 and remaining_weight > 0.0
            distribution_steps: mutable usize = 0
            while distributing |remaining, remaining_weight, distributing, is_row, distribution_steps|:
                # Every capped child removes its weight, so a valid pass is
                # bounded by the fixed arena. Keep a guard for hostile public
                # Widget values that defeat progress through non-finite math.
                return if distribution_steps >= MAX_TRAVERSAL_SIBLINGS
                distribution_steps <- distribution_steps + 1
                capped_any: mutable bool = false
                candidate: mutable usize = first
                cap_steps: mutable usize = 0
                while candidate != NONE |candidate, remaining, remaining_weight, capped_any, is_row, cap_steps|:
                    return if cap_steps >= MAX_TRAVERSAL_SIBLINGS or candidate >= widget_count
                    cap_steps <- cap_steps + 1
                    child_weight: f32 = widgets[candidate].grow
                    if widgets[candidate].visible and child_weight > 0.0 and not layout_capped[candidate]:
                        maximum: f32 = normalized_max_width(candidate) if is_row else normalized_max_height(candidate)
                        minimum: f32 = widgets[candidate].preferred_width if is_row else widgets[candidate].preferred_height
                        capacity: f32 = maximum - minimum
                        proposed: f32 = remaining * child_weight / remaining_weight
                        if maximum > 0.0 and capacity >= 0.0 and proposed > capacity:
                            layout_extra[candidate] <- capacity
                            layout_capped[candidate] <- true
                            remaining <- remaining - capacity
                            remaining_weight <- remaining_weight - child_weight
                            capped_any <- true
                    candidate <- widgets[candidate].next_sibling
                if not capped_any:
                    candidate <- first
                    distribute_steps: mutable usize = 0
                    while candidate != NONE |candidate, remaining, remaining_weight, distribute_steps|:
                        return if distribute_steps >= MAX_TRAVERSAL_SIBLINGS or candidate >= widget_count
                        distribute_steps <- distribute_steps + 1
                        if widgets[candidate].visible and widgets[candidate].grow > 0.0 and not layout_capped[candidate]:
                            layout_extra[candidate] <- remaining * widgets[candidate].grow / remaining_weight
                        candidate <- widgets[candidate].next_sibling
                    distributing <- false
                distributing <- false if remaining <= 0.0 or remaining_weight <= 0.0

            used_growth: mutable f32 = 0.0
            growth_cursor: mutable usize = first
            growth_steps: mutable usize = 0
            while growth_cursor != NONE |growth_cursor, used_growth, growth_steps|:
                return if growth_steps >= MAX_TRAVERSAL_SIBLINGS or growth_cursor >= widget_count
                growth_steps <- growth_steps + 1
                used_growth <- used_growth + layout_extra[growth_cursor] if widgets[growth_cursor].visible
                growth_cursor <- widgets[growth_cursor].next_sibling
            unused: f32 = free - used_growth if free > used_growth else 0.0
            main_alignment: UiConst::MainAlignment = UiConst::MainAlignment.Start if scrolling else widgets[index].main_alignment
            offset: mutable f32 = 0.0
            offset <- unused * 0.5 if main_alignment == UiConst::MainAlignment.Center
            offset <- unused if main_alignment == UiConst::MainAlignment.End
            gap_extra: f32 = unused / (children - 1.0) if main_alignment == UiConst::MainAlignment.SpaceBetween and children > 1.0 else 0.0
            offset <- -widgets[index].scroll_offset if scrolling
            walk: mutable usize = first
            walk_steps: mutable usize = 0
            while walk != NONE |walk, offset, is_row, inner_x, inner_y, inner_width, inner_height, gap_extra, preserve_minimums, shrink_scale, walk_steps|:
                return if walk_steps >= MAX_TRAVERSAL_SIBLINGS or walk >= widget_count
                walk_steps <- walk_steps + 1
                if widgets[walk].visible:
                    margin: f32 = widgets[walk].margin
                    base: f32 = (widgets[walk].preferred_width if is_row else widgets[walk].preferred_height) + margin * 2.0
                    minimum_outer: f32 = (widgets[walk].min_width if is_row else widgets[walk].min_height) + margin * 2.0
                    outer_extent: f32 = minimum_outer + (base - minimum_outer) * shrink_scale + layout_extra[walk] if preserve_minimums else base * scale + layout_extra[walk]
                    extent: mutable f32 = outer_extent - margin * 2.0
                    extent <- 0.0 if extent < 0.0 else extent
                    available_cross: mutable f32 = (inner_height if is_row else inner_width) - margin * 2.0
                    available_cross <- 0.0 if available_cross < 0.0 else available_cross
                    cross_extent: mutable f32 = available_cross
                    cross_offset: mutable f32 = margin
                    alignment: UiConst::CrossAlignment = widgets[walk].cross_alignment
                    minimum_cross: f32 = widgets[walk].min_height if is_row else widgets[walk].min_width
                    maximum_cross: f32 = normalized_max_height(walk) if is_row else normalized_max_width(walk)
                    cross_extent <- maximum_cross if maximum_cross > 0.0 and maximum_cross >= minimum_cross and cross_extent > maximum_cross else cross_extent
                    cross_extent <- minimum_cross if preserve_minimums and cross_extent < minimum_cross
                    if alignment != UiConst::CrossAlignment.Stretch:
                        desired_cross: f32 = widgets[walk].preferred_height if is_row else widgets[walk].preferred_width
                        cross_extent <- desired_cross if desired_cross < available_cross else available_cross
                        cross_extent <- minimum_cross if preserve_minimums and cross_extent < minimum_cross
                        cross_extent <- maximum_cross if maximum_cross > 0.0 and maximum_cross >= minimum_cross and cross_extent > maximum_cross
                        if alignment == UiConst::CrossAlignment.Center:
                            cross_offset <- margin + (available_cross - cross_extent) * 0.5
                        else:
                            if alignment == UiConst::CrossAlignment.End:
                                cross_offset <- margin + available_cross - cross_extent
                    child_width: f32 = UiConstraints::bounded(extent if is_row else cross_extent)
                    child_height: f32 = UiConstraints::bounded(cross_extent if is_row else extent)
                    unmirrored_x: f32 = inner_x + (offset + margin if is_row else cross_offset)
                    child_x: f32 = mirrored_child_x(inner_x, inner_width, unmirrored_x, child_width)
                    child_y: f32 = inner_y + (cross_offset if is_row else offset + margin)
                    arrange(walk, child_x, child_y, child_width, child_height, depth + 1)
                    offset <- offset + outer_extent + widgets[index].spacing * (scale if not preserve_minimums else 1.0) + gap_extra
                else:
                    collapse(walk, depth + 1)
                walk <- widgets[walk].next_sibling

        def contains(index: usize, x: f32, y: f32) -> bool:
            return false if index >= widget_count
            x_difference: f32 = x - x
            y_difference: f32 = y - y
            return false if x_difference != x_difference or y_difference != y_difference
            box: UiCore::Rect = UiCore::Rect(widgets[index].x, widgets[index].y, widgets[index].width, widgets[index].height)
            point: UiCore::Vec2 = UiCore::Vec2(x, y)
            return UiCore::contains(box, point)
