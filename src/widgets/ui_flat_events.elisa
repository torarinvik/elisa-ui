# UiFlat compatibility callback lowering.

extend UiFlat:
    private:
        # Keep widget notifications typed throughout the retained framework.
        # The legacy application callback is the only compatibility boundary
        # that still accepts an ordinal, so the conversion lives in one place.
        def emit_widget_event(index: usize, event: UiConst::WidgetEvent) -> void:
            app_widget_event(index, event.i32())
