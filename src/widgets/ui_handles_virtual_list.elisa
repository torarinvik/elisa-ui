# Typed application surface for retained virtual-list viewports.

extend UiHandles:
    public:
        def set_virtual_item_count(handle: Handle, item_count: i32) -> bool:
            return false if not is_valid(handle)
            return UiFlat::set_virtual_item_count(handle.widget_id.usize(), item_count)

        def virtual_item_count(handle: Handle) -> i32:
            return 0 if not is_valid(handle)
            return UiFlat::virtual_item_count(handle.widget_id.usize())

        def virtual_scroll_anchor(handle: Handle) -> UiVirtualList::ScrollAnchor:
            return UiVirtualList::ScrollAnchor{index: 0, offset: 0.0} if not is_valid(handle)
            return UiFlat::virtual_scroll_anchor(handle.widget_id.usize())

        def set_virtual_scroll_anchor(handle: Handle, anchor: UiVirtualList::ScrollAnchor) -> bool:
            return false if not is_valid(handle)
            return UiFlat::set_virtual_scroll_anchor(handle.widget_id.usize(), anchor)

        def scroll_virtual_by(handle: Handle, delta: f32) -> bool:
            return false if not is_valid(handle)
            return UiFlat::scroll_virtual_by(handle.widget_id.usize(), delta)

        def scroll_virtual_to(handle: Handle, item_index: i32) -> bool:
            return false if not is_valid(handle)
            return UiFlat::scroll_virtual_to(handle.widget_id.usize(), item_index)

        def virtual_scroll_fraction(handle: Handle) -> f32:
            return 0.0 if not is_valid(handle)
            return UiFlat::virtual_scroll_fraction(handle.widget_id.usize())

        def virtual_item_index(handle: Handle) -> i32:
            return -1 if not is_valid(handle)
            return UiFlat::virtual_item_index(handle.widget_id.usize())

        def virtual_item_generation(handle: Handle) -> u32:
            return 0 if not is_valid(handle)
            return UiFlat::virtual_item_generation(handle.widget_id.usize())
