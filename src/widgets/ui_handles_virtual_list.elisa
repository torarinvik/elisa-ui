# Typed application surface for retained virtual-list viewports.

extend UiHandles:
    public:
        def variable_virtual_list(parent: Handle, label: sview, item_count: i32, estimated_height: f32, spacing: f32, min_width: f32, min_height: f32, color: UiCore::Color) -> Handle:
            return invalid() if not parent_is_valid(parent) or not UiFlat::variable_virtual_capacity_available()
            index: usize = UiFlat::virtual_list(parent_index(parent), label, item_count, estimated_height, spacing, min_width, min_height, color)
            handle: Handle = from_index(index)
            _ = UiFlat::enable_variable_virtual_list(index, estimated_height, spacing)
            return handle

        def horizontal_variable_virtual_list(parent: Handle, label: sview, item_count: i32, estimated_width: f32, spacing: f32, min_width: f32, min_height: f32, color: UiCore::Color) -> Handle:
            return invalid() if not parent_is_valid(parent) or not UiFlat::variable_virtual_capacity_available()
            index: usize = UiFlat::horizontal_virtual_list(parent_index(parent), label, item_count, estimated_width, spacing, min_width, min_height, color)
            handle: Handle = from_index(index)
            _ = UiFlat::enable_variable_virtual_list(index, estimated_width, spacing)
            return handle

        def enable_variable_virtual_list(handle: Handle, estimated_extent: f32, spacing: f32) -> bool:
            return false if not is_valid(handle)
            return UiFlat::enable_variable_virtual_list(handle.widget_id.usize(), estimated_extent, spacing)

        def variable_virtual_list_is_enabled(handle: Handle) -> bool:
            return false if not is_valid(handle)
            return UiFlat::variable_virtual_list_is_enabled(handle.widget_id.usize())

        def set_variable_virtual_measure_provider(handle: Handle, provider: UiVirtualList::MeasureProvider?) -> bool:
            return false if not is_valid(handle)
            return UiFlat::set_variable_virtual_measure_provider(handle.widget_id.usize(), provider)

        def variable_virtual_measure_provider_is_set(handle: Handle) -> bool:
            return false if not is_valid(handle)
            return UiFlat::variable_virtual_measure_provider_is_set(handle.widget_id.usize())

        def set_virtual_item_height(handle: Handle, item_index: i32, height: f32) -> bool:
            return false if not is_valid(handle)
            return UiFlat::set_virtual_item_height(handle.widget_id.usize(), item_index, height)

        def clear_virtual_item_height(handle: Handle, item_index: i32) -> bool:
            return false if not is_valid(handle)
            return UiFlat::clear_virtual_item_height(handle.widget_id.usize(), item_index)

        def virtual_item_height(handle: Handle, item_index: i32) -> f32:
            return 0.0 if not is_valid(handle)
            return UiFlat::virtual_item_height(handle.widget_id.usize(), item_index)

        def virtual_measurement_snapshot_size(handle: Handle) -> usize:
            return 0 if not is_valid(handle)
            return UiFlat::variable_virtual_measurement_snapshot_size(handle.widget_id.usize())

        def virtual_measurement_snapshot(handle: Handle, destination: mutable u8&, capacity: usize) -> UiVirtualList::MeasurementSnapshot:
            return UiVirtualList::MeasurementSnapshot{length: 0, records: 0, overflowed: false, valid: false} if not is_valid(handle)
            return UiFlat::variable_virtual_measurement_snapshot(handle.widget_id.usize(), destination, capacity)

        def restore_virtual_measurements(handle: Handle, source: u8&, length: usize) -> UiVirtualList::MeasurementSnapshot:
            return UiVirtualList::MeasurementSnapshot{length: 0, records: 0, overflowed: false, valid: false} if not is_valid(handle)
            return UiFlat::variable_virtual_restore_measurements(handle.widget_id.usize(), source, length)

        def virtual_item_height_measurement_count(handle: Handle) -> usize:
            return 0 if not is_valid(handle)
            return UiFlat::virtual_item_height_measurement_count(handle.widget_id.usize())

        def virtual_item_height_measurement_index(handle: Handle, ordinal: usize) -> i32:
            return -1 if not is_valid(handle)
            return UiFlat::virtual_item_height_measurement_index(handle.widget_id.usize(), ordinal)

        def virtual_item_height_measurement(handle: Handle, ordinal: usize) -> f32:
            return 0.0 if not is_valid(handle)
            return UiFlat::virtual_item_height_measurement(handle.widget_id.usize(), ordinal)

        def set_virtual_item_count(handle: Handle, item_count: i32) -> bool:
            return false if not is_valid(handle)
            return UiFlat::set_virtual_item_count(handle.widget_id.usize(), item_count)

        def virtual_item_count(handle: Handle) -> i32:
            return 0 if not is_valid(handle)
            return UiFlat::virtual_item_count(handle.widget_id.usize())

        def virtual_scroll_anchor(handle: Handle) -> UiVirtualList::ScrollAnchor:
            return UiVirtualList::ScrollAnchor{index: 0, offset: 0.0} if not is_valid(handle)
            return UiFlat::virtual_scroll_anchor(handle.widget_id.usize())

        def set_virtual_scroll_anchor(handle: Handle, anchor: UiVirtualList::ScrollAnchor) -> bool:
            return false if not is_valid(handle)
            return UiFlat::set_virtual_scroll_anchor(handle.widget_id.usize(), anchor)

        def scroll_virtual_by(handle: Handle, delta: f32) -> bool:
            return false if not is_valid(handle)
            return UiFlat::scroll_virtual_by(handle.widget_id.usize(), delta)

        def scroll_virtual_to(handle: Handle, item_index: i32) -> bool:
            return false if not is_valid(handle)
            return UiFlat::scroll_virtual_to(handle.widget_id.usize(), item_index)

        def virtual_scroll_fraction(handle: Handle) -> f32:
            return 0.0 if not is_valid(handle)
            return UiFlat::virtual_scroll_fraction(handle.widget_id.usize())

        def virtual_item_index(handle: Handle) -> i32:
            return -1 if not is_valid(handle)
            return UiFlat::virtual_item_index(handle.widget_id.usize())

        def virtual_item_generation(handle: Handle) -> u32:
            return 0 if not is_valid(handle)
            return UiFlat::virtual_item_generation(handle.widget_id.usize())

        # Lazy accessibility follows the same typed virtual-list handle as
        # scrolling. The provider and row content remain application-owned;
        # UiFlat validates the logical index and snapshots borrowed text.
        def set_virtual_accessibility_provider(handle: Handle, provider: UiVirtualAccessibility::Provider?) -> bool:
            return false if not is_valid(handle)
            return UiFlat::set_virtual_accessibility_provider(handle.widget_id.usize(), provider)

        def virtual_accessibility_provider_is_set(handle: Handle) -> bool:
            return false if not is_valid(handle)
            return UiFlat::virtual_accessibility_provider_is_set(handle.widget_id.usize())

        def set_virtual_accessibility_activate_provider(handle: Handle, provider: UiVirtualAccessibility::ActivateProvider?) -> bool:
            return false if not is_valid(handle)
            return UiFlat::set_virtual_accessibility_activate_provider(handle.widget_id.usize(), provider)

        def virtual_accessibility_activate_provider_is_set(handle: Handle) -> bool:
            return false if not is_valid(handle)
            return UiFlat::virtual_accessibility_activate_provider_is_set(handle.widget_id.usize())

        def activate_virtual_accessibility_item(handle: Handle, item_index: i32) -> bool:
            return false if not is_valid(handle)
            return UiFlat::virtual_accessibility_activate(handle.widget_id.usize(), item_index)

        def virtual_accessibility_item(handle: Handle, item_index: i32, item: mutable UiVirtualAccessibility::Item&) -> bool:
            return false if not is_valid(handle)
            return UiFlat::virtual_accessibility_item(handle.widget_id.usize(), item_index, item)
