# UiFlat retained widget color policy.

extend UiFlat:
    private:
        def color_of(index: usize) -> UiCore::Color:
            if not effectively_enabled(index):
                return muted_surface(index, widgets[index].color)
            return widgets[index].press_color if widgets[index].pressed
            return widgets[index].hover_color if widgets[index].hovered
            return widgets[index].color

        # DISABLED MEANS RECEDE, and receding is relative to what you sit ON.
        #
        # This used to halve every channel, which moves a colour toward BLACK.
        # On a dark interface that reads as "off" by accident -- everything is
        # already near black, so darkening it lowers contrast. On a light one it
        # is exactly backwards: a near-white button becomes mid-grey, and the
        # disabled control ends up MORE prominent than the enabled ones beside
        # it, which is the one thing it must never be.
        #
        # Half the distance to the ground works in both, because it is the same
        # statement in both: less difference from the surroundings.
        const MUTED_TOWARD_GROUND: f32 = 0.55

        def muted_surface(index: usize, base: UiCore::Color) -> UiCore::Color:
            return muted_toward(base, ground_behind(index))

        # A mark, a track or a caption recedes into the surface it is drawn on,
        # which is the widget's own fill rather than whatever is behind the
        # widget. A disabled checkmark fading toward the page instead of toward
        # the box it sits in would gain contrast, not lose it.
        def muted_ink(index: usize, base: UiCore::Color) -> UiCore::Color:
            own: UiCore::Color = color_of(index)
            return muted_toward(base, own) if own.a != 0
            return muted_toward(base, ground_behind(index))

        def muted_toward(base: UiCore::Color, ground: UiCore::Color) -> UiCore::Color:
            # Nothing painted behind it, so there is nothing to recede into.
            # Keep the old darkening rather than fading toward transparent,
            # which would erase the control instead of disabling it.
            return UiCore::Color{r: base.r / 2, g: base.g / 2, b: base.b / 2, a: base.a} if ground.a == 0
            return UiCore::Color{
                r: muted_channel(base.r, ground.r),
                g: muted_channel(base.g, ground.g),
                b: muted_channel(base.b, ground.b),
                a: base.a,
            }

        def muted_channel(base: u8, ground: u8) -> u8:
            moved =
                distance: f32 = ground.f32() - base.f32()
                base.f32() + distance * MUTED_TOWARD_GROUND
            return UiCore::channel(moved.i64()).u8()

        # An empty choice -- box or ring -- is a BORDER, and one ratio sets its
        # weight for both so they read as one family. The checkbox measures the
        # inset from its edge and the radio from its centre, so the ring keeps
        # 1 - 2r of its radius; the two then draw the same thickness on the
        # same size of control, which they did not before: the box's border was
        # 0.18 of its extent and the ring's 0.11 of its diameter, and the box
        # looked chunky beside it.
        const CONTROL_BORDER_RATIO: f32 = 0.11
        const RADIO_RING_INNER_RATIO: f32 = 1.0 - CONTROL_BORDER_RATIO * 2.0
        # The mark inside a chosen one, as a fraction of the disc it sits in.
        const RADIO_SELECTED_MARK_RATIO: f32 = 0.4

        def radio_selected_mark_radius(outer_radius: f32) -> f32:
            proportional: f32 = outer_radius * RADIO_SELECTED_MARK_RATIO
            declared: f32 = theme().radio_inner_radius
            return proportional if proportional < declared else declared

        # A MARKER THAT FITS THE CONTROL IT MARKS.
        #
        # The theme's marker size is a preference, and a preference can ask for
        # more room than a fixed-size control has. The showcase's accent
        # swatches are 28pt squares; at double text scale the resolved marker
        # was wider than the swatch and its centre sat past the right edge, so
        # every one of them drew its ring over its neighbour. Growing a marker
        # with the reader's preference is right. Drawing it outside the widget
        # that owns it never is, and the widget is the only authority on how
        # much room there is.
        def choice_marker_extent(index: usize) -> f32:
            room =
                width: f32 = widgets[index].width
                height: f32 = widgets[index].height
                width if width < height else height
            return 0.0 if room <= 0.0
            requested: f32 = theme().checkbox_size
            return room if requested > room else requested

        # WHICH SIDE A MARKER IS ON, and why the painter has to ask.
        #
        # The framework has carried a direction policy since localization
        # landed -- `direction`, leading and trailing alignment, `mirror_x` --
        # and the retained painter never asked it anything. Text layout did:
        # the caret, hit testing and selection all take a direction. So an
        # Arabic build got a correctly mirrored caret inside a field whose
        # checkbox was still nailed to the left, with its label running away
        # from it. A policy nothing consults is a policy that is not there.
        #
        # Mirroring the fitted centre rather than recomputing it keeps the
        # marker inside the control for free: the left-to-right answer is
        # already clamped, and a reflection of something inside the box is
        # inside the box.
        def choice_marker_center_x(index: usize, extent: f32) -> f32:
            leading =
                half: f32 = extent / 2.0
                farthest: f32 = widgets[index].width - half
                fitted: f32 = leading_marker_center(index, half, farthest)
                fitted
            return widgets[index].width - leading if painting_right_to_left()
            return leading

        def leading_marker_center(index: usize, half: f32, farthest: f32) -> f32:
            return half if farthest < half
            requested: f32 = theme().choice_center_x
            return half if requested < half
            return farthest if requested > farthest
            return requested

        # THE FRACTION OF A TRACK, MEASURED FROM THE READER'S START.
        #
        # One function, consulted by the painter and by the pointer, because
        # they are two halves of one fact: where along the track a value sits.
        # Mirroring the paint without the mapping would leave the thumb where
        # the finger is not, which is worse than not mirroring at all -- it is
        # why the slider was left alone when the choice marker was mirrored.
        #
        # It is its own inverse, so both halves call the same thing and there
        # is no second formula to get wrong.
        def track_fraction(value: f32) -> f32:
            return 1.0 - value if painting_right_to_left()
            return value

        # The span a value FILLS runs from the reader's start edge to the
        # thumb, so its width is the value in either direction and only its
        # origin moves. Mirroring the width instead is a mistake that looks
        # right at both ends and is inverted everywhere between: an empty
        # right-to-left track paints itself full.
        def track_fill_origin(track_width: f32, value: f32) -> f32:
            return track_width * track_fraction(value) if painting_right_to_left()
            return 0.0

        # LEADING MEANS THE READER'S START, which is the right edge for half
        # the world.
        #
        # The default alignment for content was written as "leading" in the
        # comment beside it and implemented as `x`: one word doing duty for two
        # different edges, and correct for one of them. It read as a decision
        # rather than an oversight, which is why it survived the change that
        # taught the marker beside it which side it was on.
        #
        # A run wider than its box keeps the leading edge in both directions --
        # pushing it off the start to honour the end is how a long label
        # becomes an unreadable one.
        def leading_text_origin(index: usize, text_width: f32) -> f32:
            return widgets[index].x if not painting_right_to_left()
            trailing =
                room: f32 = widgets[index].width - text_width
                widgets[index].x + room
            return widgets[index].x if trailing < widgets[index].x
            return trailing

        def painting_right_to_left() -> bool:
            return UiLocalization::is_rtl(UiLocalization::current_locale())

        # A label follows the MARKER rather than the token whenever the token
        # would start it inside the marker or past the end of the control.
        # A label starts where the marker ends, on whichever side that is. The
        # caller supplies the marker's own centre, so this needs no second
        # direction test: in a mirrored control the marker's trailing edge is
        # the label's right edge, and the run is placed from there by its width.
        def choice_text_origin(index: usize, center_x: f32, extent: f32, text_width: f32) -> f32:
            gap: f32 = theme().choice_text_space - theme().choice_center_x
            if painting_right_to_left():
                right_edge =
                    marker_left: f32 = center_x - extent / 2.0
                    marker_left - gap if gap > 0.0 else marker_left
                return 0.0 if right_edge - text_width < 0.0
                return right_edge - text_width
            beside_marker =
                half: f32 = extent / 2.0
                center_x + half
            requested: f32 = theme().choice_text_space
            return beside_marker if requested < beside_marker or requested >= widgets[index].width
            return requested

        # The ink to put ON a filled swatch, decided by the swatch.
        #
        # A selected checkbox or radio is filled with the app's accent, and an
        # accent is whatever the app says it is -- the showcase alone ships a
        # coral, an ocean blue, a violet and an amber. A fixed white tick
        # disappears on the amber; a fixed dark one disappears on the blue.
        # Reading the fill's own lightness is the same rule the depth policy
        # uses, applied to a mark instead of to a surface.
        def contrast_ink(on: UiCore::Color) -> UiCore::Color:
            return UiCore::rgba(18, 20, 24, on.a) if UiCore::surface_luminance(on) >= 140
            return UiCore::rgba(255, 255, 255, on.a)

        # Is this Panel a CARD rather than a layout box?
        #
        # Panel is both: the root, the rows and the spacers that only exist to
        # arrange children, and the raised surfaces an app groups content onto.
        # Nothing in the model distinguishes them, and elevating all of them
        # would put a shadow behind every layout container.
        #
        # What separates them is already there: a layout box paints the same
        # colour as whatever it sits on, so it is invisible; a card paints its
        # own. A panel whose colour DIFFERS from its parent's is a surface the
        # app meant you to see, and it is the one that should be lit.
        #
        # A root panel is never a card. It is the window's background, and a
        # background that casts a shadow is a window with a shadow inside it.
        # How a widget's surface sits relative to what is behind it.
        #
        # A TEXT FIELD IS A WELL. It used to be painted with the same raised
        # treatment as a button, which is the difference between a UI that looks
        # almost right and one that looks made: a field you type into is cut
        # into the surface, not resting on it. Everything you press -- buttons,
        # radios, checkboxes -- is raised, and a card is raised when it is
        # lighter than its ground and recessed when it is darker, because that
        # is what the two look like in the world.
        def surface_depth_of(index: usize, color: UiCore::Color) -> UiCore::SurfaceDepth:
            kind: UiConst::WidgetKind = widgets[index].kind
            return UiCore::SurfaceDepth.Inset if kind == UiConst::WidgetKind.TextField
            # A CONTROL YOU CAN PRESS IS LIFTED; ONE YOU ARE PRESSING IS IN.
            #
            # Pressing used to be a colour swap and nothing else, which is the
            # feedback a hyperlink gives. A control that stands off the surface
            # when idle and sinks INTO it under the finger is the whole reason
            # the depth policy carries an opposite lighting direction at all --
            # the recess treatment was written for text fields and grooves and
            # was never asked for by the one gesture it describes exactly.
            #
            # And a control that cannot be pressed is flat. Elevation is an
            # invitation; a disabled button that still stands off the page is
            # inviting a press it will not answer.
            if control_surface(kind):
                return UiCore::SurfaceDepth.Flat if not effectively_enabled(index)
                return UiCore::SurfaceDepth.Inset if widgets[index].pressed
                # ELEVATION IS FOR WHAT YOU PRESS, NOT FOR WHAT YOU CHOOSE.
                #
                # A choice control used to be lifted like a button, and a page
                # of them is what showed why it should not be: twenty-four
                # full-width rows of one list, each with its own rim and its
                # own shadow, is a ladder of floating buttons rather than a
                # list. Nothing about the widget says which it is -- the same
                # radio is a segmented option in a form and a row in a list --
                # and the framework cannot see that the rows are adjacent.
                #
                # What it can say is that a choice is already announced by its
                # MARKER. The box or the ring is the affordance; the surface
                # behind it is a hit target, and a hit target does not need to
                # stand off the page to be pressable. The recess under the
                # finger stays, because that is feedback rather than emphasis.
                return UiCore::SurfaceDepth.Flat if kind != UiConst::WidgetKind.Button
                return UiCore::SurfaceDepth.Raised
            return UiCore::SurfaceDepth.Flat if not panel_is_surface(index, color)
            behind: UiCore::Color = ground_behind(index)
            return UiCore::SurfaceDepth.Inset if UiCore::surface_luminance(color) < UiCore::surface_luminance(behind)
            return UiCore::SurfaceDepth.Raised

        def control_surface(kind: UiConst::WidgetKind) -> bool:
            return kind == UiConst::WidgetKind.Button or kind == UiConst::WidgetKind.RadioButton or kind == UiConst::WidgetKind.CheckBox

        def fill_at_depth(box: UiCore::Rect, color: UiCore::Color, depth: UiCore::SurfaceDepth) -> void:
            if depth == UiCore::SurfaceDepth.Inset:
                UiCore::fill_inset(box, color)
            elif depth == UiCore::SurfaceDepth.Raised:
                UiCore::fill_elevated(box, color)
            else:
                UiCore::fill(box, color)

        def panel_is_surface(index: usize, color: UiCore::Color) -> bool:
            return false if widgets[index].kind != UiConst::WidgetKind.Panel
            behind: UiCore::Color = ground_behind(index)
            return false if behind.a == 0
            return color.r != behind.r or color.g != behind.g or color.b != behind.b or color.a != behind.a

        # The colour actually visible behind a widget.
        #
        # NOT simply the parent's: a layout row is usually transparent, and a
        # card inside one is painted over whatever is behind THAT. Stopping at
        # the immediate parent made every card in a row read as sitting on
        # nothing, so none of them were lit -- the buttons had depth and the
        # cards holding them did not.
        #
        # Bounded by MAX_TRAVERSAL_DEPTH like every other walk over this tree:
        # the parent links are repaired on build, but a paint pass is not the
        # place to discover that they were not.
        def ground_behind(index: usize) -> UiCore::Color:
            probe: mutable usize = widgets[index].parent
            for _ in 0..<MAX_TRAVERSAL_DEPTH:
                return UiCore::rgba(0, 0, 0, 0) if probe == NONE or probe >= widget_count
                behind: UiCore::Color = color_of(probe)
                return behind if behind.a != 0
                probe <- widgets[probe].parent
            return UiCore::rgba(0, 0, 0, 0)

        # The focus ring, drawn as a HALO UNDER the control rather than an
        # outline over it.
        #
        # It used to be four straight lines inset into the widget, which put
        # square corners on a rounded button in every backend -- the retained
        # command vocabulary has no stroked rounded rectangle, so an outline
        # could not follow the shape it was outlining. A slightly larger filled
        # rectangle behind the control does follow it: the painter rounds a fill
        # by the same policy it rounds the control, so the ring is concentric
        # with the surface by construction, on Skia and CoreGraphics alike.
        #
        # It also reads better. A ring that surrounds a control instead of
        # eating into it leaves the label alone, and against a dark ground an
        # accent halo is visible where a one-pixel line is not.
        #
        # The halo is Flat: it is light around the control, not a second surface
        # stacked under it, and lighting it would put a rim on the rim.
        # The ring around a widget, if it has one. Focus wins over an
        # application's own emphasis: where a keyboard user is standing is the
        # more urgent fact, and two concentric rings would read as neither.
        def paint_ring(index: usize) -> void:
            return paint_halo(index, current_theme.focus_ring) if widgets[index].focused
            return if widgets[index].ring_color.a == 0
            paint_halo(index, widgets[index].ring_color)

        # A RING THAT SURVIVES BEING ITS CONTROL'S OWN COLOUR.
        #
        # The halo is painted behind the widget, so what shows is the band
        # around it -- and a band of accent immediately against a surface
        # already filled with the accent is not a ring, it is a slightly wider
        # button. The showcase has exactly that control: the primary action is
        # filled with the same accent the theme derives the focus ring from.
        #
        # This is why a browser's focus outline has an OFFSET. It cannot be an
        # offset here, because a retained widget does not know what is behind
        # it and would have to guess a colour to punch through to. A separator
        # needs no such guess: one hairline in ink chosen by the control's own
        # lightness, exactly as a mark on a filled swatch is chosen, and the
        # accent band keeps its full themed width outside it.
        def paint_halo(index: usize, color: UiCore::Color) -> void:
            separator: f32 = HALO_SEPARATOR_WIDTH
            UiCore::fill(inflated_frame(index, focus_halo_spread() + separator), color)
            UiCore::fill(inflated_frame(index, separator), contrast_ink(color_of(index)))

        def inflated_frame(index: usize, spread: f32) -> UiCore::Rect:
            return UiCore::Rect(
                widgets[index].x - spread, widgets[index].y - spread,
                widgets[index].width + spread * 2.0, widgets[index].height + spread * 2.0)

        # How far the halo stands out from the control. Derived from the theme's
        # ring width so a high-contrast or large-text preference grows it with
        # everything else, and bounded so a malformed token cannot paint a
        # focus ring over the rest of the window.
        # A hairline, and not scaled with the accessibility metrics: it is a
        # SEPARATOR, and its job is done at one pixel. Growing it with the ring
        # would eat into the accent band that a large-text preference is asking
        # to make more visible.
        const HALO_SEPARATOR_WIDTH: f32 = 1.0

        def focus_halo_spread() -> f32:
            requested: f32 = UiConstraints::bounded(current_theme.focus_inset)
            return 1.0 if requested < 1.0
            return 4.0 if requested > 4.0
            return requested
