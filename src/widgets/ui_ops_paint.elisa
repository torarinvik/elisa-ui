include "./ui_constraints.elisa"

extend UiWidgets:
    public:
        def box_of(w: Widget) -> UiCore::Rect:
            return UiCore::Rect(w.x, w.y, w.width, w.height)

    private:
        # The surface colour a widget draws right now. A pressable widget
        # reports its press or hover colour when the pointer says so.
        def fill_of(w: Widget) -> UiCore::Color:
            pressed: bool = w.pressed
            hovered: bool = w.hovered
            match w:
                Window.Top(title, resizable):
                    return UiCore::Color{r: 0, g: 0, b: 0, a: 0}
                Window.Floating(title):
                    return UiCore::Color{r: 0, g: 0, b: 0, a: 0}
                Container.Box(axis, padding, spacing, fill):
                    return fill
                Container.Grid(columns, padding, spacing, fill):
                    return fill
                Container.Scroll(axis, offset, fill):
                    return fill
                Container.ScrollWithState(axis, state, fill):
                    return fill
                Control.Label(text, size, ink):
                    return UiCore::Color{r: 0, g: 0, b: 0, a: 0}
                Control.Gauge(fraction, track, bar):
                    return track
                Control.Slider(value, low, high, track, knob):
                    return track
                Control.TextBox(text, caret, size, ink, fill):
                    return fill
                Button.Push(label, rest, hover, press):
                    return press if pressed
                    return hover if hovered
                    return rest
                Button.Toggle(label, on, rest, hover, press):
                    return press if pressed
                    return hover if hovered
                    return rest
                Button.Check(label, checked, rest, hover, press):
                    return press if pressed
                    return hover if hovered
                    return rest
                Button.Radio(label, group, selected, rest, hover, press):
                    return press if pressed
                    return hover if hovered
                    return rest

        # The parts that are not just a filled box: text runs and the moving
        # pieces of gauges and sliders.
        def paint_content(w: Widget) -> void:
            box_x: f32 = w.x
            box_y: f32 = w.y
            box_width: f32 = w.width
            box_height: f32 = w.height
            box: UiCore::Rect = box_of(w)
            match w:
                Window.Top(title, resizable):
                    pass
                Window.Floating(title):
                    pass
                Container.Box(axis, padding, spacing, fill):
                    pass
                Container.Grid(columns, padding, spacing, fill):
                    pass
                Container.Scroll(axis, offset, fill):
                    pass
                Container.ScrollWithState(axis, state, fill):
                    pass
                Control.Label(text, size, ink):
                    safe_size: f32 = UiConstraints::bounded(size)
                    text_y: f32 = box_y + (box_height - ui_text_line_height(safe_size)) / 2.0
                    UiCore::draw(UiCore::TextRun(UiCore::Vec2(box_x, text_y), safe_size, text), ink)
                Control.Gauge(fraction, track, bar):
                    filled: f32 = box_width * UiCore::normalized_unit(fraction)
                    UiCore::fill(UiCore::Rect(box_x, box_y, filled, box_height), bar) if filled > 0.0
                Control.Slider(value, low, high, track, knob):
                    ratio: f32 = normalized_slider_ratio(value, low, high)
                    knob_x: f32 = box_x + (box_width - box_height) * ratio
                    UiCore::fill(UiCore::Rect(knob_x, box_y, box_height, box_height), knob)
                Control.TextBox(text, caret, size, ink, fill):
                    safe_size: f32 = UiConstraints::bounded(size)
                    text_y: f32 = box_y + (box_height - ui_text_line_height(safe_size)) / 2.0
                    UiCore::draw(UiCore::TextRun(UiCore::Vec2(box_x, text_y), safe_size, text), ink)
                Button.Push(label, rest, hover, press):
                    label_y: f32 = box_y + (box_height - ui_text_line_height(14.0)) / 2.0
                    UiCore::draw(UiCore::TextRun(UiCore::Vec2(box_x, label_y), 14.0, label), UiCore::rgb(255, 255, 255)) if label.len != 0
                Button.Toggle(label, on, rest, hover, press):
                    label_y: f32 = box_y + (box_height - ui_text_line_height(14.0)) / 2.0
                    UiCore::draw(UiCore::TextRun(UiCore::Vec2(box_x, label_y), 14.0, label), UiCore::rgb(255, 255, 255)) if label.len != 0
                Button.Check(label, checked, rest, hover, press):
                    label_y: f32 = box_y + (box_height - ui_text_line_height(14.0)) / 2.0
                    UiCore::draw(UiCore::TextRun(UiCore::Vec2(box_x, label_y), 14.0, label), UiCore::rgb(255, 255, 255)) if label.len != 0
                Button.Radio(label, group, selected, rest, hover, press):
                    label_y: f32 = box_y + (box_height - ui_text_line_height(14.0)) / 2.0
                    UiCore::draw(UiCore::TextRun(UiCore::Vec2(box_x, label_y), 14.0, label), UiCore::rgb(255, 255, 255)) if label.len != 0

    public:
        # Intersect two retained clip boxes. A zero-sized result is intentional:
        # it lets the backend discard commands from a child completely outside
        # a nested viewport without a separate visibility walk.
        def clip_intersection(first: UiCore::Rect, second: UiCore::Rect) -> UiCore::Rect:
            left: f32 = first.origin.x if first.origin.x > second.origin.x else second.origin.x
            top: f32 = first.origin.y if first.origin.y > second.origin.y else second.origin.y
            first_right: f32 = UiCore::right_edge(first)
            second_right: f32 = UiCore::right_edge(second)
            first_bottom: f32 = UiCore::bottom_edge(first)
            second_bottom: f32 = UiCore::bottom_edge(second)
            right: f32 = first_right if first_right < second_right else second_right
            bottom: f32 = first_bottom if first_bottom < second_bottom else second_bottom
            width: f32 = right - left if right > left else 0.0
            height: f32 = bottom - top if bottom > top else 0.0
            return UiCore::Rect(left, top, width, height)

        # Emit one widget's own drawing, then recurse into its children.
        # Pre-order gives painter-algorithm ordering for free: a parent's
        # background is laid down before anything it contains. The accumulated
        # clip is passed as an ordinary Elisa value because hierarchy handles do
        # not expose parent identity; each scroll node contributes its own
        # viewport before descending into its children.
        def paint_depth(w: Widget, depth: i32, clip_active: bool, clip: UiCore::Rect) -> void:
            return if depth >= MAX_HIERARCHY_DEPTH
            UiCore::set_clip(clip) if clip_active
            surface: UiCore::Color = fill_of(w)
            if surface.a != 0:
                UiCore::fill(box_of(w), surface)
            paint_content(w)
            UiCore::clear_clip() if clip_active

            child_clip_active: mutable bool = clip_active
            child_clip: mutable UiCore::Rect = clip
            is_scroll: mutable bool = false
            match w:
                Container.Scroll(axis, offset, fill):
                    is_scroll <- true
                Container.ScrollWithState(axis, state, fill):
                    is_scroll <- true
                _:
                    pass
            if is_scroll:
                viewport: UiCore::Rect = box_of(w)
                child_clip <- clip_intersection(clip, viewport) if clip_active else viewport
                child_clip_active <- true
            paint_steps: mutable i32 = 0
            cursor: mutable Widget? = w.first_child
            while cursor is node |cursor, paint_steps, child_clip_active, child_clip|:
                break if paint_steps >= MAX_HIERARCHY_SIBLINGS
                paint_steps <- paint_steps + 1
                paint_depth(node, depth + 1, child_clip_active, child_clip)
                cursor <- node.next_sibling

        def paint(w: Widget) -> void:
            empty_clip: UiCore::Rect = UiCore::Rect(0.0, 0.0, 0.0, 0.0)
            paint_depth(w, 0, false, empty_clip)
