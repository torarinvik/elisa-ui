# Backend-neutral responsive layout facts and adaptive arrangement helpers.
#
# Responsive policy belongs to the framework, not to a native shim or an
# application's OS-name switch. Callers provide logical viewport dimensions
# and explicit breakpoints; all arithmetic is sanitized and bounded so a bad
# host resize cannot produce zero-column grids or an invalid arrangement.

include "../core/ui_core.elisa"
include "./ui_const.elisa"

module UiResponsive:
    public:
        const DEFAULT_COMPACT_MAX: f32 = 599.0
        const DEFAULT_MEDIUM_MAX: f32 = 1023.0

        const enum SizeClass of i32:
            Compact = 0
            Medium = 1
            Expanded = 2

        struct Breakpoints:
            compact_max: f32
            medium_max: f32

        # A normalized viewport snapshot keeps applications from repeating
        # width/height/scale guards at every responsive decision point.
        struct Viewport:
            width: f32
            height: f32
            scale: f32

        struct Insets:
            top: f32
            right: f32
            bottom: f32
            left: f32

        # A software keyboard is a transient bottom occlusion, not a safe-area
        # edge. Keep visibility explicit so an adapter can restore the full
        # content box when the keyboard hides without rebuilding the viewport.
        struct KeyboardInsets:
            bottom: f32
            visible: bool

        struct ContentArea:
            origin: UiCore::Vec2
            size: UiCore::Size
            scale: f32

        const enum Orientation of i32:
            Portrait = 0
            Landscape = 1
            Square = 2

        def defaults() -> Breakpoints:
            return Breakpoints{compact_max: DEFAULT_COMPACT_MAX, medium_max: DEFAULT_MEDIUM_MAX}

        def normalize_breakpoints(points: Breakpoints) -> Breakpoints:
            compact: f32 = UiCore::nonnegative_extent(points.compact_max)
            medium: mutable f32 = UiCore::nonnegative_extent(points.medium_max)
            medium <- compact if medium < compact
            return Breakpoints{compact_max: compact, medium_max: medium}

        def viewport(width: f32, height: f32, scale: f32) -> Viewport:
            safe_scale: mutable f32 = UiCore::nonnegative_extent(scale)
            safe_scale <- 1.0 if safe_scale == 0.0
            return Viewport{
                width: UiCore::nonnegative_extent(width),
                height: UiCore::nonnegative_extent(height),
                scale: safe_scale,
            }

        def classify(width: f32, points: Breakpoints) -> SizeClass:
            safe_width: f32 = UiCore::nonnegative_extent(width)
            normalized: Breakpoints = normalize_breakpoints(points)
            return SizeClass.Compact if safe_width <= normalized.compact_max
            return SizeClass.Medium if safe_width <= normalized.medium_max
            return SizeClass.Expanded

        def classify_viewport(view: Viewport, points: Breakpoints) -> SizeClass:
            return classify(view.width, points)

        def orientation(view: Viewport) -> Orientation:
            return Orientation.Square if view.width == view.height
            return Orientation.Landscape if view.width > view.height else Orientation.Portrait

        # Safe-area facts arrive from a host in logical units. Normalize every
        # edge before subtracting it so malformed or non-finite insets cannot
        # produce a negative content box.
        def insets(top: f32, right: f32, bottom: f32, left: f32) -> Insets:
            return Insets{
                top: UiCore::nonnegative_extent(top),
                right: UiCore::nonnegative_extent(right),
                bottom: UiCore::nonnegative_extent(bottom),
                left: UiCore::nonnegative_extent(left),
            }

        def keyboard_insets(bottom: f32, visible: bool) -> KeyboardInsets:
            return KeyboardInsets{bottom: UiCore::nonnegative_extent(bottom), visible: visible}

        def content_area(view: Viewport, safe: Insets) -> ContentArea:
            safe_view: Viewport = viewport(view.width, view.height, view.scale)
            normalized: Insets = insets(safe.top, safe.right, safe.bottom, safe.left)
            available_width: mutable f32 = safe_view.width - normalized.left - normalized.right
            available_height: mutable f32 = safe_view.height - normalized.top - normalized.bottom
            available_width <- 0.0 if available_width < 0.0
            available_height <- 0.0 if available_height < 0.0
            return ContentArea{
                origin: UiCore::Vec2(normalized.left, normalized.top),
                size: UiCore::Size(available_width, available_height),
                scale: safe_view.scale,
            }

        # Combine safe-area and keyboard occlusion by taking the larger bottom
        # edge. Keyboard frames commonly already include the home-indicator
        # area; adding both would reserve the same pixels twice.
        def content_area_with_keyboard(view: Viewport, safe: Insets, keyboard: KeyboardInsets) -> ContentArea:
            effective_bottom: mutable f32 = safe.bottom
            effective_bottom <- keyboard.bottom if keyboard.visible and keyboard.bottom > effective_bottom
            return content_area(view, Insets{
                top: safe.top, right: safe.right, bottom: effective_bottom, left: safe.left,
            })

        def is_compact(width: f32, points: Breakpoints) -> bool:
            return classify(width, points) == SizeClass.Compact

        def axis(width: f32, points: Breakpoints,
                 compact_axis: UiConst::Axis, medium_axis: UiConst::Axis,
                 expanded_axis: UiConst::Axis) -> UiConst::Axis:
            kind: SizeClass = classify(width, points)
            return UiConst::normalize_axis(compact_axis) if kind == SizeClass.Compact
            return UiConst::normalize_axis(medium_axis) if kind == SizeClass.Medium
            return UiConst::normalize_axis(expanded_axis)

        # Return a bounded number of equal-width columns for a logical row.
        # `minimum_item_width` includes the item's own desired width; spacing
        # is counted only between columns. A zero maximum means one column,
        # while a zero item width intentionally requests the caller's cap.
        def columns(width: f32, minimum_item_width: f32, spacing: f32, maximum: i32) -> i32:
            safe_width: f32 = UiCore::nonnegative_extent(width)
            safe_item: f32 = UiCore::nonnegative_extent(minimum_item_width)
            safe_spacing: f32 = UiCore::nonnegative_extent(spacing)
            cap: i32 = maximum if maximum > 0 else 1
            return cap if safe_item == 0.0
            denominator: f32 = UiCore::finite_or_zero(safe_item + safe_spacing)
            return 1 if denominator <= 0.0
            available: f32 = UiCore::finite_or_zero(safe_width + safe_spacing)
            ratio: f32 = UiCore::finite_or_zero(available / denominator)
            return 1 if ratio <= 0.0
            return cap if ratio >= cap.f32()
            result: mutable i32 = ratio.i32()
            result <- 1 if result < 1
            result <- cap if result > cap
            return result

        # Convert a logical target into a physical touch-safe extent without
        # leaking platform-specific scale policy into widget code.
        def physical_extent(logical: f32, scale: f32, minimum_physical: f32) -> f32:
            safe_logical: f32 = UiCore::nonnegative_extent(logical)
            safe_scale: mutable f32 = UiCore::nonnegative_extent(scale)
            safe_scale <- 1.0 if safe_scale == 0.0
            safe_physical: f32 = UiCore::nonnegative_extent(minimum_physical)
            required: f32 = UiCore::finite_or_zero(safe_physical / safe_scale)
            return required if required > safe_logical else safe_logical
