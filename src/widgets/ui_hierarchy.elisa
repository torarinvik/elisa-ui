# elisa-ui widget hierarchy: one sealed enum tree over one arena.
#
# WHY A HIERARCHY AND NOT ONE FLAT ENUM. Every widget lives in a single
# region-backed AoS store, so a tree is contiguous, cache-friendly, and a widget
# reference is an opaque u32 handle rather than a pointer (docs/76, docs/77). One
# giant `enum Widget:` would give the same store and lose the type safety: every
# function would take `Widget` and defensively handle every case. Splitting the
# tree into sealed sub-categories with `is` keeps the arena and recovers the
# invariant that matters -- `def title_of(w: Window)` accepts ONLY windows, and
# the compiler proves it.
#
# The taxonomy follows wxWidgets and Qt where they agree, collapsed to the depth
# that earns its keep:
#
#   wxWindow / QWidget          -> Widget            (the root: geometry + layout)
#   wxTopLevelWindow            -> Window            (title bar, decorations)
#   wxPanel + wxSizer / QLayout -> Container         (arranges children)
#   wxControl                   -> Control           (a leaf the user drives)
#   wxAnyButton -> wxButton     -> Button is Control (the three-level chain)
#
# GEOMETRY AND LINKS LIVE IN THE ROOT'S `common:` BLOCK. wxWindow and QWidget
# put the resolved box and the child list on the base class; docs/76's
# `common:` is the direct equivalent, and `mutable` commons are writable
# through any handle, so the layout passes write straight into the node.
# Variants carry only what distinguishes a kind. Two consequences:
#
#   - There is no widget cap and no `id`: a handle IS the node.
#   - Attaching a child or a sibling is one field write, not a rebuilt node.
#
# Every common is `@storage(inline)`. The default for a hierarchy common is a
# side table, which cannot be written through a handle and costs a full word
# per field regardless of type; inline commons sit in the row at their declared
# width. An earlier measurement that found this layout ~10% slower was taken
# against the side-table default, so it compared a 48-byte row against a
# 96-byte one. With inline commons the row is the geometry plus the widest
# payload, and the tree walk touches one row per node instead of a row and a
# parallel array. (stage1 still reserves an unused side word per common next
# to each row; that is allocation only, nothing reads it.)

# The tree is `module UiWidgets`. This file declares the types; ui_ops.elisa
# and ui_build.elisa `extend` the same module with the passes and the
# constructors, so an application sees one namespace: `UiWidgets::Widget`,
# `UiWidgets::layout`, `UiWidgets::button`. Matching a widget outside the
# module spells the variant `UiWidgets::Button.Push(...)`; both compilers
# resolve that against the sealed hierarchy since stage0 4b6977e4 / stage1
# f7a4bbd8.

include "../core/ui_core.elisa"
include "./ui_const.elisa"

module UiWidgets:
    public:
        # The sealed root: the whole widget universe in ONE region-backed
        # store. A `Widget` value is an opaque u32 handle into it, so a tree
        # is contiguous and a reference costs four bytes.
        #
        # Constructors name every common first, in this order, then the
        # variant's own fields. Application code goes through the helpers in
        # ui_build.elisa, which fill them in.
        enum Widget:
            common:
                # Layout INPUT: the widget's own minimum, and its share of
                # leftover space along the parent's axis (wxSizer's proportion
                # / Qt's stretch).
                @storage(inline)
                min_width: mutable f32
                @storage(inline)
                min_height: mutable f32
                @storage(inline)
                grow: mutable f32
                # Layout OUTPUT: the box `arrange` resolved.
                @storage(inline)
                x: mutable f32
                @storage(inline)
                y: mutable f32
                @storage(inline)
                width: mutable f32
                @storage(inline)
                height: mutable f32
                # Interaction state, mirroring wxWindow's hover/press tracking.
                @storage(inline)
                hovered: mutable bool
                @storage(inline)
                pressed: mutable bool
                # The tree. A leaf's `first_child` stays null; only containers
                # and windows nest, which `children` enforces.
                @storage(inline)
                first_child: mutable Widget?
                @storage(inline)
                next_sibling: mutable Widget?
            pass


        # A top-level surface. wxTopLevelWindow's distinguishing state is its
        # title and decoration flags; the rest it inherits.
        enum Window is Widget:
            Top(title: sview, resizable: bool)
            # wxMiniFrame / a tool palette: a real window that floats above
            # its owner.
            Floating(title: sview)


        # Arranges children. The model is wxWidgets' sizer, not Qt's layout
        # objects: a container IS its layout, so there is no second tree to
        # keep in sync.
        enum Container is Widget:
            # wxBoxSizer. `axis` is UiConst::Axis.Row or UiConst::Axis.Column.
            Box(axis: UiConst::Axis, padding: f32, spacing: f32, fill: UiCore::Color)
            # wxGridSizer: fixed column count, uniform cells.
            Grid(columns: i32, padding: f32, spacing: f32, fill: UiCore::Color)
            # wxScrolledWindow / QAbstractScrollArea. `offset` is subtracted
            # from the children's positions during arrange, so scrolling is
            # one subtraction.
            Scroll(axis: UiConst::Axis, offset: f32, fill: UiCore::Color)


        # A leaf the user reads or drives -- wxControl's descendants.
        enum Control is Widget:
            # wxStaticText.
            Label(text: sview, size: f32, ink: UiCore::Color)
            # wxGauge / QProgressBar. `fraction` is 0.0..1.0.
            Gauge(fraction: f32, track: UiCore::Color, bar: UiCore::Color)
            # wxSlider / QAbstractSlider.
            Slider(value: f32, low: f32, high: f32, track: UiCore::Color, knob: UiCore::Color)
            # wxTextCtrl / QLineEdit. `caret` is a byte offset into `text`.
            TextBox(text: sview, caret: usize, size: f32, ink: UiCore::Color, fill: UiCore::Color)


        # wxAnyButton's family. Every button carries a label and the three
        # colours a pressable surface needs; the variants differ in what a
        # click MEANS, which is exactly what a sum type should encode.
        enum Button is Control:
            # wxButton: fires once per click.
            Push(label: sview, rest: UiCore::Color, hover: UiCore::Color, press: UiCore::Color)
            # wxToggleButton: latches.
            Toggle(label: sview, on: bool, rest: UiCore::Color, hover: UiCore::Color, press: UiCore::Color)
            # wxCheckBox.
            Check(label: sview, checked: bool, rest: UiCore::Color, hover: UiCore::Color, press: UiCore::Color)
            # wxRadioButton: `group` names the mutually exclusive set.
            Radio(label: sview, group: i32, selected: bool, rest: UiCore::Color, hover: UiCore::Color, press: UiCore::Color)
