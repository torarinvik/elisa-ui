# Resource requests, completion transitions, retry, and owner teardown.

extend UiResources:
    public:
        def reset() -> void:
            for slot in 0..<MAX_RESOURCES:
                next_generation: u32 = resource_generations[slot] + 1
                resource_generations[slot] <- 1 if next_generation == 0 else next_generation
                resource_states[slot] <- State.Unrequested
                resource_failure_kinds[slot] <- FailureKind.Unknown
                resource_identifier_lengths[slot] <- 0
                for byte_index in 0..<IDENTIFIER_CAPACITY:
                    resource_identifier_storage[slot * IDENTIFIER_CAPACITY + byte_index] <- 0
                UiResources::clear_metadata(slot)
                resource_downloaded[slot] <- 0.0
                resource_decoded[slot] <- 0.0
                resource_demanded[slot] <- false
                resource_priorities[slot] <- 0
                resource_demand_owners[slot] <- 0
            resource_owner_reset()
            resource_count <- 0
            resource_overflowed <- false
            UiCore::clear_invalidations(UiCore::Invalidation.Resources)
            UiCore::invalidate(UiCore::Invalidation.Resources)
            UiCore::invalidate(UiCore::Invalidation.Paint)

        # Requesting a key is idempotent while its record is alive. This keeps
        # per-frame view rebuilds from starting duplicate host work. A
        # cancelled record can be requested again, but that starts a new host
        # operation and therefore rotates its generation.
        def request(key: sview, owner: u32) -> ResourceHandle:
            safe_key: sview = UiCore::bounded_text(key)
            # Resource keys are identities, not display text. Do not let a
            # malformed or overlong counted view collapse to a valid prefix
            # and alias an existing package asset.
            return UiResources::resource_invalid() if safe_key.len <= 0 or safe_key.len != key.len or safe_key.len >= IDENTIFIER_CAPACITY.i64()
            for slot in 0..<resource_count:
                if resource_states[slot] != State.Unrequested and resource_key_matches(slot, safe_key):
                    return UiResources::resource_invalid() if not resource_owner_add(slot, owner)
                    if resource_states[slot] == State.Cancelled:
                        next_generation: u32 = resource_generations[slot] + 1
                        resource_generations[slot] <- 1 if next_generation == 0 else next_generation
                        resource_states[slot] <- State.Requested
                        resource_failure_kinds[slot] <- FailureKind.Unknown
                        resource_downloaded[slot] <- 0.0
                        resource_decoded[slot] <- 0.0
                        # Demand hints belong to the cancelled host operation.
                        resource_clear_all_owner_demands(slot)
                        resource_mark_changed()
                    return resource_make_handle(slot)

            free_slot: mutable usize = MAX_RESOURCES
            for slot in 0..<MAX_RESOURCES:
                if resource_states[slot] == State.Unrequested:
                    free_slot <- slot
                    break
            if free_slot == MAX_RESOURCES:
                resource_overflowed <- true
                return UiResources::resource_invalid()

            generation: u32 = resource_generations[free_slot]
            resource_generations[free_slot] <- 1 if generation == 0 else generation
            return UiResources::resource_invalid() if not resource_owner_add(free_slot, owner)
            offset: usize = free_slot * IDENTIFIER_CAPACITY
            for index in 0..<IDENTIFIER_CAPACITY:
                resource_identifier_storage[offset + index] <- safe_key.data[index] if index < safe_key.len else 0
            resource_identifier_lengths[free_slot] <- safe_key.len.usize()
            resource_states[free_slot] <- State.Requested
            resource_downloaded[free_slot] <- 0.0
            resource_decoded[free_slot] <- 0.0
            resource_demanded[free_slot] <- false
            resource_priorities[free_slot] <- 0
            resource_demand_owners[free_slot] <- 0
            resource_count <- free_slot + 1 if free_slot >= resource_count else resource_count
            resource_mark_changed()
            return resource_make_handle(free_slot)

        # Transport failures may be retried; corrupt or incompatible bytes
        # require a package update or host/toolchain change.
        def fail(handle: ResourceHandle, kind: FailureKind) -> bool:
            return false if not UiResources::resource_is_valid(handle) or not resource_failure_kind_is_valid(kind)
            slot: usize = handle.slot.usize()
            # A completion resolves exactly one request generation. If a host
            # learns a better diagnosis later, it must retry with a new token
            # rather than rewriting a terminal result in place.
            return false if resource_states[slot] != State.Requested
            resource_states[slot] <- State.Failed
            resource_failure_kinds[slot] <- kind
            resource_mark_changed()
            return true

        def set_state(handle: ResourceHandle, next: State) -> bool:
            return false if not UiResources::resource_is_valid(handle) or not resource_state_is_valid(next)
            slot: usize = handle.slot.usize()
            return false if resource_states[slot] == State.Cancelled
            # Requested starts a new host operation and must rotate its
            # generation through request() or retry(), never in place.
            return false if next == State.Requested
            # The first completion is terminal for this generation, regardless
            # of outcome. Only explicit cancellation may supersede it; retry
            # rotates the token before another completion can be accepted.
            return false if next != State.Cancelled and resource_states[slot] != State.Requested
            resource_states[slot] <- next
            if next == State.Cancelled:
                resource_clear_all_owner_demands(slot)
            resource_failure_kinds[slot] <- FailureKind.RetryableTransport if next == State.Failed else FailureKind.Unknown
            if next == State.Ready:
                resource_downloaded[slot] <- 1.0
                resource_decoded[slot] <- 1.0
            resource_mark_changed()
            return true

        def cancel(handle: ResourceHandle) -> bool:
            return set_state(handle, State.Cancelled)

        # A widget can stop observing its shared resource without cancelling
        # work still needed by another widget. The logical record remains as
        # a cancelled tombstone if this was its last live owner, allowing a
        # later request for the same key to begin with a fresh generation.
        def cancel_for_owner(handle: ResourceHandle, owner: u32) -> bool:
            return false if not UiResources::resource_is_valid(handle)
            slot: usize = handle.slot.usize()
            return false if not resource_owner_remove(slot, owner)
            resource_refresh_demand(slot)
            if resource_owner_count(slot) == 0 and resource_states[slot] != State.Cancelled:
                resource_states[slot] <- State.Cancelled
                resource_failure_kinds[slot] <- FailureKind.Unknown
                resource_downloaded[slot] <- 0.0
                resource_decoded[slot] <- 0.0
                resource_clear_all_owner_demands(slot)
            resource_mark_changed()
            return true

        # Start a recoverable resource operation with a fresh generation. The
        # returned handle must replace the caller's old handle.
        def retry(handle: ResourceHandle) -> ResourceHandle:
            return UiResources::resource_invalid() if not UiResources::resource_is_valid(handle) or not can_retry(handle)
            slot: usize = handle.slot.usize()
            next_generation: u32 = resource_generations[slot] + 1
            resource_generations[slot] <- 1 if next_generation == 0 else next_generation
            resource_states[slot] <- State.Requested
            resource_failure_kinds[slot] <- FailureKind.Unknown
            resource_downloaded[slot] <- 0.0
            resource_decoded[slot] <- 0.0
            resource_clear_all_owner_demands(slot)
            resource_mark_changed()
            return resource_make_handle(slot)

        # Disposal invalidates the generation before releasing the identifier.
        def dispose(handle: ResourceHandle) -> bool:
            return false if not UiResources::resource_is_valid(handle)
            slot: usize = handle.slot.usize()
            resource_clear_slot(slot)
            for _ in 0..<MAX_RESOURCES:
                break if resource_count == 0 or resource_states[resource_count - 1] != State.Unrequested
                resource_count <- resource_count - 1
            resource_mark_changed()
            return true

        # View teardown commonly owns several assets. Dispose them together so
        # every token is invalidated before a slot can be reused.
        def dispose_owner(owner: u32) -> usize:
            released: mutable usize = 0
            for slot in 0..<resource_count:
                if resource_states[slot] != State.Unrequested and resource_owner_remove(slot, owner):
                    released <- released + 1
                    resource_refresh_demand(slot)
                    resource_clear_slot(slot) if resource_owner_count(slot) == 0
            for _ in 0..<MAX_RESOURCES:
                break if resource_count == 0 or resource_states[resource_count - 1] != State.Unrequested
                resource_count <- resource_count - 1
            resource_mark_changed() if released > 0
            return released

        # Cancellation removes this owner's leases. A coalesced operation is
        # cancelled only after its final interested owner has gone away.
        def cancel_owner(owner: u32) -> usize:
            released: mutable usize = 0
            for slot in 0..<resource_count:
                if resource_states[slot] != State.Unrequested and resource_owner_lease_index(slot, owner) < MAX_RESOURCE_OWNER_LEASES:
                    released <- released + 1 if UiResources::cancel_for_owner(resource_make_handle(slot), owner)
            return released
