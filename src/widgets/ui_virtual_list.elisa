# Backend-neutral virtualization policy for long, uniform lists.
#
# The list's data and row widgets remain application-owned. This module owns
# only the deterministic geometry that decides which rows need realization,
# where they are placed, and how much content a viewport must reserve. Keeping
# that policy in Elisa prevents native/host backends from growing separate
# scroll-window calculations and keeps semantic navigation aligned with paint.

include "../core/ui_core.elisa"

module UiVirtualList:
    public:
        # Keep hostile counts bounded and logical identities within f32's
        # exact-integer range. Deep pixel positions still require anchors;
        # absolute geometry helpers intentionally remain capped.
        const MAX_ITEMS: i32 = 16777216
        const NONE_INDEX: i32 = -1
        const MAX_GEOMETRY_EXTENT: f32 = 16777216.0
        const MAX_REALIZED: usize = 64

        struct VisibleRange:
            first: i32
            finish: i32

        struct Metrics:
            item_extent: f32
            spacing: f32
            stride: f32

        # Which logical rows currently occupy the bounded realization slots.
        struct Realization:
            total: i32
            first: i32
            finish: i32
            realized: i32

        # Bounded semantic metadata for a realized window. `total` describes
        # the logical list even when only [first, finish) has widgets. Focus
        # and selection retain their logical indexes, so an off-screen target
        # remains addressable instead of silently disappearing from assistive
        # navigation during virtualization.
        struct SemanticWindow:
            total: i32
            first: i32
            finish: i32
            focused: i32
            selected: i32
            has_focus: bool
            has_selection: bool
            focus_visible: bool
            selection_visible: bool
            has_before: bool
            has_after: bool

        def metrics(item_extent: f32, spacing: f32) -> Metrics:
            safe_item: mutable f32 = bounded_extent(item_extent)
            safe_item <- 1.0 if safe_item == 0.0
            safe_spacing: f32 = bounded_extent(spacing)
            # The sum is itself a geometry operand. Keep it inside the same
            # envelope as the individual row and gap before virtualization
            # divides offsets by it or publishes it to a scroll backend.
            stride: f32 = bounded_extent(safe_item + safe_spacing)
            return Metrics{item_extent: safe_item, spacing: safe_spacing, stride: stride}

        def bounded_count(item_count: i32) -> i32:
            return 0 if item_count <= 0
            return MAX_ITEMS if item_count > MAX_ITEMS
            return item_count

        # Reserve one row extent per item and one gap only between adjacent
        # rows. A zero count has no trailing spacing.
        def content_extent(item_count: i32, item_extent: f32, spacing: f32) -> f32:
            count: i32 = bounded_count(item_count)
            return 0.0 if count == 0
            layout: Metrics = metrics(item_extent, spacing)
            extent: f32 = (count.f32() * layout.item_extent) + ((count - 1).f32() * layout.spacing)
            return bounded_extent(extent)

        # Return the top edge of an item in content coordinates. Clamping the
        # index makes this helper total for stale/negative list identities.
        def item_offset(index: i32, item_count: i32, item_extent: f32, spacing: f32) -> f32:
            count: i32 = bounded_count(item_count)
            return 0.0 if count == 0 or index < 0
            safe_index: mutable i32 = index
            safe_index <- count - 1 if safe_index >= count
            layout: Metrics = metrics(item_extent, spacing)
            return bounded_extent(safe_index.f32() * layout.stride)

        # Compute a half-open [first, finish) range. One extra row is retained at
        # the lower edge so a fractional scroll or a pixel-rounding difference
        # cannot expose a blank strip between frames. `max_visible` is a hard
        # memory/semantic budget; zero means one row.
        def visible_range(item_count: i32, item_extent: f32, spacing: f32, scroll_offset: f32, viewport_extent: f32, max_visible: i32) -> VisibleRange:
            count: i32 = bounded_count(item_count)
            return VisibleRange{first: 0, finish: 0} if count == 0
            layout: Metrics = metrics(item_extent, spacing)
            offset: f32 = UiCore::nonnegative_extent(scroll_offset)
            viewport: f32 = UiCore::nonnegative_extent(viewport_extent)
            # Use the same bounded stride as item_offset() and content_extent().
            # Re-summing the individual extents here can exceed the framework
            # geometry cap, making virtualization disagree with placement for
            # large but otherwise valid inputs.
            stride: f64 = layout.stride.f64()
            first_ratio: f64 = offset.f64() / stride
            first: mutable i32 = count - 1
            first <- first_ratio.i32() if first_ratio < count.f64()
            budget: mutable i32 = max_visible if max_visible > 0 else 1
            budget <- count - first if budget > count - first
            # Bound ratios before narrowing to i32; finite f32 dimensions can
            # still exceed the integer range or overflow a f32 sum.
            finish_ratio: f64 = (offset.f64() + viewport.f64()) / stride
            finish: mutable i32 = count
            finish <- finish_ratio.i32() + 1 if finish_ratio < count.f64()
            finish <- first + budget if finish > first + budget
            finish <- count if finish > count
            finish <- first + 1 if finish <= first
            return VisibleRange{first: first, finish: finish}

        def count(range: VisibleRange) -> i32:
            return range.finish - range.first if range.finish > range.first else 0

        def contains(range: VisibleRange, index: i32) -> bool:
            return index >= range.first and index < range.finish

        # Normalize a geometry range supplied by a stale caller before it is
        # published to a semantic adapter. A non-empty list always exposes at
        # least one row, keeping accessibility navigation useful even when a
        # surface briefly reports a zero-sized viewport.
        def semantic_window(item_count: i32, range: VisibleRange, focused_index: i32, selected_index: i32) -> SemanticWindow:
            total: i32 = bounded_count(item_count)
            return SemanticWindow{total: 0, first: 0, finish: 0,
                focused: NONE_INDEX, selected: NONE_INDEX,
                has_focus: false, has_selection: false,
                focus_visible: false, selection_visible: false,
                has_before: false, has_after: false} if total == 0

            first: mutable i32 = range.first
            first <- 0 if first < 0
            first <- total - 1 if first >= total
            finish: mutable i32 = range.finish
            finish <- first + 1 if finish <= first
            finish <- total if finish > total

            has_focus: bool = focused_index >= 0 and focused_index < total
            has_selection: bool = selected_index >= 0 and selected_index < total
            return SemanticWindow{
                total: total,
                first: first,
                finish: finish,
                focused: focused_index if has_focus else NONE_INDEX,
                selected: selected_index if has_selection else NONE_INDEX,
                has_focus: has_focus,
                has_selection: has_selection,
                focus_visible: has_focus and focused_index >= first and focused_index < finish,
                selection_visible: has_selection and selected_index >= first and selected_index < finish,
                has_before: first > 0,
                has_after: finish < total,
            }

        # Move a logical semantic target without requiring its row to be
        # realized. Invalid or empty targets fail closed with NONE_INDEX;
        # callers can then request a new visible range before painting it.
        def move(index: i32, item_count: i32, forward: bool) -> i32:
            total: i32 = bounded_count(item_count)
            return NONE_INDEX if total == 0 or index < 0 or index >= total
            next: mutable i32 = index + 1 if forward else index - 1
            return NONE_INDEX if next < 0 or next >= total
            return next

        # ── Realization ────────────────────────────────────────────────────
        # Row widgets remain application-owned; this controller decides which
        # logical rows currently occupy which bounded slots, so a scrolling list
        # can recycle a fixed pool instead of building every row. A row that
        # stays visible keeps its slot and generation; a row that scrolls out
        # and returns crosses a new generation, so a late callback for the old
        # occupancy is stale. `max_slots` bounds this owner and the shared
        # global pool may bound it further; the result reports what fit.

        def reset_realization() -> void:
            ensure_realization_initialized()
            for slot_index in 0..<MAX_REALIZED:
                virtual_slot_logical[slot_index] <- NONE_INDEX
                virtual_slot_owner[slot_index] <- 0
                virtual_slot_generation[slot_index] <- next_generation(virtual_slot_generation[slot_index])

        def realize(owner: u32, item_count: i32, range: VisibleRange, max_slots: i32) -> Realization:
            ensure_realization_initialized()
            total: i32 = bounded_count(item_count)
            if total == 0:
                release_owner(owner)
                return Realization{total: 0, first: 0, finish: 0, realized: 0}
            budget: mutable i32 = max_slots
            budget <- 1 if budget < 1
            budget <- MAX_REALIZED.i32() if budget > MAX_REALIZED.i32()
            first: mutable i32 = range.first
            first <- 0 if first < 0
            first <- total - 1 if first >= total
            finish: mutable i32 = range.finish
            finish <- first + 1 if finish <= first
            finish <- total if finish > total
            wanted: mutable i32 = finish - first
            wanted <- budget if wanted > budget
            limit: mutable i32 = first + wanted
            # Free this owner's slots that are no longer in the retained window.
            for slot_index in 0..<MAX_REALIZED:
                if virtual_slot_logical[slot_index] != NONE_INDEX and virtual_slot_owner[slot_index] == owner and (virtual_slot_logical[slot_index] < first or virtual_slot_logical[slot_index] >= limit):
                    free_slot(slot_index)
            # This is a shared bounded pool: a caller may consume only its
            # retained slots plus currently free ones, never another owner's
            # slots. Limit the reported window before assigning so exhaustion
            # is explicit and never silently steals a row from a different list.
            usable_capacity: mutable usize = 0
            for slot_index in 0..<MAX_REALIZED:
                usable_capacity <- usable_capacity + 1 if virtual_slot_logical[slot_index] == NONE_INDEX or virtual_slot_owner[slot_index] == owner
            actual_budget: mutable i32 = wanted
            actual_budget <- usable_capacity.i32() if usable_capacity < wanted.usize()
            limit <- first + actual_budget
            # Retain only rows in the contiguous window this call can report.
            for slot_index in 0..<MAX_REALIZED:
                if virtual_slot_logical[slot_index] != NONE_INDEX and virtual_slot_owner[slot_index] == owner and virtual_slot_logical[slot_index] >= limit:
                    free_slot(slot_index)
            # Assign every retained logical row to a stable slot.
            for logical in first..<limit:
                if slot_for(owner, logical) == NONE_INDEX:
                    slot: usize = find_free_slot()
                    if slot >= MAX_REALIZED:
                        limit <- logical
                        break
                    virtual_slot_logical[slot] <- logical
                    virtual_slot_owner[slot] <- owner
                    virtual_slot_generation[slot] <- next_generation(virtual_slot_generation[slot])
            # If a defensive allocation check shortened the window, release any
            # retained tail rows so the result still describes a contiguous set.
            for slot_index in 0..<MAX_REALIZED:
                if virtual_slot_logical[slot_index] != NONE_INDEX and virtual_slot_owner[slot_index] == owner and virtual_slot_logical[slot_index] >= limit:
                    free_slot(slot_index)
            return Realization{total: total, first: first, finish: limit, realized: limit - first}

        def release_owner(owner: u32) -> void:
            ensure_realization_initialized()
            for slot_index in 0..<MAX_REALIZED:
                free_slot(slot_index) if virtual_slot_logical[slot_index] != NONE_INDEX and virtual_slot_owner[slot_index] == owner

        def slot_for(owner: u32, logical: i32) -> i32:
            ensure_realization_initialized()
            for slot_index in 0..<MAX_REALIZED:
                return slot_index.i32() if virtual_slot_owner[slot_index] == owner and virtual_slot_logical[slot_index] == logical
            return NONE_INDEX

        def logical_for_slot(slot: i32) -> i32:
            ensure_realization_initialized()
            return NONE_INDEX if slot < 0 or slot >= MAX_REALIZED.i32()
            return virtual_slot_logical[slot.usize()]

        def slot_generation(slot: i32) -> u32:
            ensure_realization_initialized()
            return 0 if slot < 0 or slot >= MAX_REALIZED.i32()
            return virtual_slot_generation[slot.usize()]

        def realized_count() -> usize:
            ensure_realization_initialized()
            count: mutable usize = 0
            for slot_index in 0..<MAX_REALIZED:
                count <- count + 1 if virtual_slot_logical[slot_index] != NONE_INDEX
            return count

        def bounded_extent(value: f32) -> f32:
            safe: f32 = UiCore::nonnegative_extent(value)
            return MAX_GEOMETRY_EXTENT if safe > MAX_GEOMETRY_EXTENT else safe

    private:
        global mutable virtual_realization_initialized: bool = false
        global mutable virtual_slot_logical: i32[MAX_REALIZED] = zeroed
        global mutable virtual_slot_owner: u32[MAX_REALIZED] = zeroed
        global mutable virtual_slot_generation: u32[MAX_REALIZED] = zeroed

        def ensure_realization_initialized() -> void:
            return if virtual_realization_initialized
            for slot_index in 0..<MAX_REALIZED:
                virtual_slot_logical[slot_index] <- NONE_INDEX
                virtual_slot_owner[slot_index] <- 0
            virtual_realization_initialized <- true

        def free_slot(slot: usize) -> void:
            return if slot >= MAX_REALIZED
            virtual_slot_logical[slot] <- NONE_INDEX
            virtual_slot_owner[slot] <- 0
            virtual_slot_generation[slot] <- next_generation(virtual_slot_generation[slot])

        def find_free_slot() -> usize:
            for slot_index in 0..<MAX_REALIZED:
                return slot_index if virtual_slot_logical[slot_index] == NONE_INDEX
            return MAX_REALIZED

        def next_generation(value: u32) -> u32:
            next: u32 = value + 1
            return 1 if next == 0 else next

include "./ui_virtual_list_anchored.elisa"
include "./ui_virtual_list_variable.elisa"
