# Backend-neutral virtualization policy for long, uniform lists.
#
# The list's data and row widgets remain application-owned. This module owns
# only the deterministic geometry that decides which rows need realization,
# where they are placed, and how much content a viewport must reserve. Keeping
# that policy in Elisa prevents native/host backends from growing separate
# scroll-window calculations and keeps semantic navigation aligned with paint.

include "../core/ui_core.elisa"

module UiVirtualList:
    public:
        # A deliberately generous bound keeps malformed application counts
        # from overflowing f32 geometry while still allowing large feeds. The
        # visible range is additionally capped by the caller's max_visible.
        const MAX_ITEMS: i32 = 16777216
        const NONE_INDEX: i32 = -1

        struct VisibleRange:
            first: i32
            finish: i32

        struct Metrics:
            item_extent: f32
            spacing: f32
            stride: f32

        # Bounded semantic metadata for a realized window. `total` describes
        # the logical list even when only [first, finish) has widgets. Focus
        # and selection retain their logical indexes, so an off-screen target
        # remains addressable instead of silently disappearing from assistive
        # navigation during virtualization.
        struct SemanticWindow:
            total: i32
            first: i32
            finish: i32
            focused: i32
            selected: i32
            has_focus: bool
            has_selection: bool
            focus_visible: bool
            selection_visible: bool
            has_before: bool
            has_after: bool

        def metrics(item_extent: f32, spacing: f32) -> Metrics:
            safe_item: mutable f32 = UiCore::nonnegative_extent(item_extent)
            safe_item <- 1.0 if safe_item == 0.0
            safe_spacing: f32 = UiCore::nonnegative_extent(spacing)
            return Metrics{item_extent: safe_item, spacing: safe_spacing, stride: safe_item + safe_spacing}

        def bounded_count(item_count: i32) -> i32:
            return 0 if item_count <= 0
            return MAX_ITEMS if item_count > MAX_ITEMS
            return item_count

        # Reserve one row extent per item and one gap only between adjacent
        # rows. A zero count has no trailing spacing.
        def content_extent(item_count: i32, item_extent: f32, spacing: f32) -> f32:
            count: i32 = bounded_count(item_count)
            return 0.0 if count == 0
            layout: Metrics = metrics(item_extent, spacing)
            return (count.f32() * layout.item_extent) + ((count - 1).f32() * layout.spacing)

        # Return the top edge of an item in content coordinates. Clamping the
        # index makes this helper total for stale/negative list identities.
        def item_offset(index: i32, item_count: i32, item_extent: f32, spacing: f32) -> f32:
            count: i32 = bounded_count(item_count)
            return 0.0 if count == 0 or index < 0
            safe_index: mutable i32 = index
            safe_index <- count - 1 if safe_index >= count
            layout: Metrics = metrics(item_extent, spacing)
            return safe_index.f32() * layout.stride

        # Compute a half-open [first, finish) range. One extra row is retained at
        # the lower edge so a fractional scroll or a pixel-rounding difference
        # cannot expose a blank strip between frames. `max_visible` is a hard
        # memory/semantic budget; zero means one row.
        def visible_range(item_count: i32, item_extent: f32, spacing: f32, scroll_offset: f32, viewport_extent: f32, max_visible: i32) -> VisibleRange:
            count: i32 = bounded_count(item_count)
            return VisibleRange{first: 0, finish: 0} if count == 0
            layout: Metrics = metrics(item_extent, spacing)
            offset: f32 = UiCore::nonnegative_extent(scroll_offset)
            viewport: f32 = UiCore::nonnegative_extent(viewport_extent)
            stride: f64 = layout.item_extent.f64() + layout.spacing.f64()
            first_ratio: f64 = offset.f64() / stride
            first: mutable i32 = count - 1
            first <- first_ratio.i32() if first_ratio < count.f64()
            budget: mutable i32 = max_visible if max_visible > 0 else 1
            budget <- count - first if budget > count - first
            # Bound ratios before narrowing to i32; finite f32 dimensions can
            # still exceed the integer range or overflow a f32 sum.
            finish_ratio: f64 = (offset.f64() + viewport.f64()) / stride
            finish: mutable i32 = count
            finish <- finish_ratio.i32() + 1 if finish_ratio < count.f64()
            finish <- first + budget if finish > first + budget
            finish <- count if finish > count
            finish <- first + 1 if finish <= first
            return VisibleRange{first: first, finish: finish}

        def count(range: VisibleRange) -> i32:
            return range.finish - range.first if range.finish > range.first else 0

        def contains(range: VisibleRange, index: i32) -> bool:
            return index >= range.first and index < range.finish

        # Normalize a geometry range supplied by a stale caller before it is
        # published to a semantic adapter. A non-empty list always exposes at
        # least one row, keeping accessibility navigation useful even when a
        # surface briefly reports a zero-sized viewport.
        def semantic_window(item_count: i32, range: VisibleRange, focused_index: i32, selected_index: i32) -> SemanticWindow:
            total: i32 = bounded_count(item_count)
            return SemanticWindow{total: 0, first: 0, finish: 0,
                focused: NONE_INDEX, selected: NONE_INDEX,
                has_focus: false, has_selection: false,
                focus_visible: false, selection_visible: false,
                has_before: false, has_after: false} if total == 0

            first: mutable i32 = range.first
            first <- 0 if first < 0
            first <- total - 1 if first >= total
            finish: mutable i32 = range.finish
            finish <- first + 1 if finish <= first
            finish <- total if finish > total

            has_focus: bool = focused_index >= 0 and focused_index < total
            has_selection: bool = selected_index >= 0 and selected_index < total
            return SemanticWindow{
                total: total,
                first: first,
                finish: finish,
                focused: focused_index if has_focus else NONE_INDEX,
                selected: selected_index if has_selection else NONE_INDEX,
                has_focus: has_focus,
                has_selection: has_selection,
                focus_visible: has_focus and focused_index >= first and focused_index < finish,
                selection_visible: has_selection and selected_index >= first and selected_index < finish,
                has_before: first > 0,
                has_after: finish < total,
            }

        # Move a logical semantic target without requiring its row to be
        # realized. Invalid or empty targets fail closed with NONE_INDEX;
        # callers can then request a new visible range before painting it.
        def move(index: i32, item_count: i32, forward: bool) -> i32:
            total: i32 = bounded_count(item_count)
            return NONE_INDEX if total == 0 or index < 0 or index >= total
            next: mutable i32 = index + 1 if forward else index - 1
            return NONE_INDEX if next < 0 or next >= total
            return next
