# Shared text-input purpose and privacy policy.
#
# Backends provide native text controls/IME bridges; this module decides the
# traits they should request from those bridges. Secure fields never opt into
# autocorrect, suggestions, clipboard export, or semantic value readback.

module UiTextInput:
    public:
        const enum Purpose of i32:
            Text = 0
            Password = 1
            Email = 2
            Url = 3
            Number = 4
            Search = 5

        const enum Keyboard of i32:
            Default = 0
            Email = 1
            Url = 2
            Number = 3
            Decimal = 4

        struct Options:
            purpose: Purpose
            multiline: bool
            autocorrect: bool
            suggestions: bool

        struct Traits:
            purpose: Purpose
            keyboard: Keyboard
            secure: bool
            multiline: bool
            autocorrect: bool
            suggestions: bool
            clipboard_allowed: bool
            semantic_value_allowed: bool

        def defaults(purpose: Purpose) -> Options:
            safe_purpose: Purpose = normalize_purpose(purpose)
            secure: bool = safe_purpose == Purpose.Password
            return Options{
                purpose: safe_purpose,
                multiline: safe_purpose == Purpose.Text,
                autocorrect: not secure and (safe_purpose == Purpose.Text or safe_purpose == Purpose.Search),
                suggestions: not secure and safe_purpose != Purpose.Number,
            }

        def resolve(options: Options) -> Traits:
            safe_purpose: Purpose = normalize_purpose(options.purpose)
            secure: bool = safe_purpose == Purpose.Password
            multiline: bool = options.multiline and not secure and safe_purpose != Purpose.Number
            autocorrect: bool = options.autocorrect and not secure and (safe_purpose == Purpose.Text or safe_purpose == Purpose.Search)
            suggestions: bool = options.suggestions and not secure and safe_purpose != Purpose.Number
            keyboard: Keyboard = keyboard_for(safe_purpose)
            return Traits{
                purpose: safe_purpose, keyboard: keyboard, secure: secure,
                multiline: multiline, autocorrect: autocorrect,
                suggestions: suggestions, clipboard_allowed: not secure,
                semantic_value_allowed: not secure,
            }

        def keyboard_for(purpose: Purpose) -> Keyboard:
            safe_purpose: Purpose = normalize_purpose(purpose)
            return Keyboard.Email if safe_purpose == Purpose.Email
            return Keyboard.Url if safe_purpose == Purpose.Url
            return Keyboard.Number if safe_purpose == Purpose.Number
            return Keyboard.Default

        # `code` is a Unicode scalar supplied by the platform text bridge. This
        # conservative gate handles the common numeric controls without trying
        # to replace locale-specific decimal formatting or IME composition.
        def allows_scalar(traits: Traits, code: i32) -> bool:
            return false if code < 0
            purpose: Purpose = normalize_purpose(traits.purpose)
            secure: bool = traits.secure or purpose == Purpose.Password
            multiline: bool = traits.multiline and not secure and purpose != Purpose.Number
            if code == 10 or code == 13:
                return multiline
            return true if purpose != Purpose.Number and code >= 32
            return true if code >= 48 and code <= 57
            return code == 43 or code == 45 or code == 46 or code == 44

        def is_secure(traits: Traits) -> bool:
            return traits.secure or normalize_purpose(traits.purpose) == Purpose.Password

        def allows_clipboard(traits: Traits) -> bool:
            return traits.clipboard_allowed and not is_secure(traits)

        def allows_semantic_value(traits: Traits) -> bool:
            return traits.semantic_value_allowed and not is_secure(traits)

        # Unknown host/application purpose values must not silently become a
        # clipboard-readable plain-text field. Password is the fail-closed
        # fallback because it disables assistive text services and readback.
        def normalize_purpose(value: Purpose) -> Purpose:
            return value if value == Purpose.Text or value == Purpose.Password or value == Purpose.Email or value == Purpose.Url or value == Purpose.Number or value == Purpose.Search
            return Purpose.Password
