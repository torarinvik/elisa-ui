# Elisa-owned presentation policy for logical resources.
#
# UiResources owns identity and lifecycle; this module owns the user-facing
# interpretation of those states. Hosts still provide verified bytes and
# renderer handles. A backend can therefore consume one explicit record for a
# placeholder, progress indicator, ready asset, or recoverable fallback.

include "./ui_resources.elisa"

module UiResourcePresentation:
    public:
        const enum Kind of i32:
            Generic = 0
            Image = 1
            Font = 2
            Document = 3

        const enum DisplayState of i32:
            Placeholder = 0
            Loading = 1
            Ready = 2
            Offline = 3
            Denied = 4
            Failed = 5
            Cancelled = 6

        struct Options:
            kind: Kind
            reserved_width: f32
            reserved_height: f32
            placeholder_color: UiCore::Color
            fallback_color: UiCore::Color
            show_progress: bool
            allow_retry: bool

        struct Record:
            handle: UiResources::Handle
            kind: Kind
            state: DisplayState
            failure: UiResources::FailureKind
            network_progress: f32
            decode_progress: f32
            placeholder_visible: bool
            fallback_visible: bool
            progress_visible: bool
            retry_available: bool
            interaction_enabled: bool
            reserved_size: UiCore::Size

        def default_options(kind: Kind) -> Options:
            safe_kind: Kind = normalize_kind(kind)
            if safe_kind == Kind.Image:
                return Options{
                    kind: safe_kind, reserved_width: 64.0, reserved_height: 64.0,
                    placeholder_color: UiCore::rgb(42, 46, 56),
                    fallback_color: UiCore::rgb(92, 48, 54),
                    show_progress: true, allow_retry: true,
                }
            if safe_kind == Kind.Font:
                return Options{
                    kind: safe_kind, reserved_width: 0.0, reserved_height: 0.0,
                    placeholder_color: UiCore::rgb(42, 46, 56),
                    fallback_color: UiCore::rgb(92, 48, 54),
                    show_progress: false, allow_retry: true,
                }
            if safe_kind == Kind.Document:
                return Options{
                    kind: safe_kind, reserved_width: 320.0, reserved_height: 200.0,
                    placeholder_color: UiCore::rgb(42, 46, 56),
                    fallback_color: UiCore::rgb(92, 48, 54),
                    show_progress: true, allow_retry: true,
                }
            return Options{
                kind: safe_kind, reserved_width: 0.0, reserved_height: 0.0,
                placeholder_color: UiCore::rgb(42, 46, 56),
                fallback_color: UiCore::rgb(92, 48, 54),
                show_progress: true, allow_retry: false,
            }

        def display_state(handle: UiResources::Handle) -> DisplayState:
            match UiResources::state(handle):
                UiResources::State.Unrequested:
                    return DisplayState.Placeholder
                UiResources::State.Requested:
                    return DisplayState.Loading
                UiResources::State.Ready:
                    return DisplayState.Ready
                UiResources::State.UnavailableOffline:
                    return DisplayState.Offline
                UiResources::State.Denied:
                    return DisplayState.Denied
                UiResources::State.Failed:
                    return DisplayState.Failed
                UiResources::State.Cancelled:
                    return DisplayState.Cancelled

        def is_placeholder(handle: UiResources::Handle) -> bool:
            current: DisplayState = display_state(handle)
            return current == DisplayState.Placeholder or current == DisplayState.Loading

        def is_fallback(handle: UiResources::Handle) -> bool:
            current: DisplayState = display_state(handle)
            return current == DisplayState.Offline or current == DisplayState.Denied or current == DisplayState.Failed or current == DisplayState.Cancelled

        def can_retry(handle: UiResources::Handle) -> bool:
            return UiResources::can_retry(handle)

        def retry(handle: UiResources::Handle) -> bool:
            return UiResources::retry(handle)

        def cancel(handle: UiResources::Handle) -> bool:
            return UiResources::cancel(handle)

        # Emit the stable visual fallback owned by the framework. Ready assets
        # intentionally emit nothing: the host resolves verified bytes through
        # its renderer, while every non-ready state remains backend-neutral.
        def paint(box: UiCore::Rect, value: Record, options: Options) -> void:
            # Callers can construct records and rectangles directly, bypassing
            # the convenience constructors. Normalize at this policy boundary
            # before deriving progress geometry or emitting a fallback card.
            safe_box: UiCore::Rect = UiCore::Rect(
                UiCore::bounded_coordinate(box.origin.x),
                UiCore::bounded_coordinate(box.origin.y),
                UiCore::bounded_extent(box.size.width),
                UiCore::bounded_extent(box.size.height))
            if value.placeholder_visible:
                UiCore::fill(safe_box, options.placeholder_color)
                if value.progress_visible and safe_box.size.width > 0.0 and safe_box.size.height > 0.0:
                    progress_width: f32 = safe_box.size.width * UiCore::normalized_unit(value.decode_progress)
                    progress_y: mutable f32 = UiCore::bottom_edge(safe_box) - 4.0
                    progress_y <- safe_box.origin.y if progress_y < safe_box.origin.y else progress_y
                    UiCore::fill(UiCore::Rect(safe_box.origin.x, progress_y, progress_width, 3.0), options.fallback_color)
                return
            return if not value.fallback_visible
            UiCore::fill(safe_box, options.fallback_color)
            mark: UiCore::Color = UiCore::rgba(255, 255, 255, 70)
            UiCore::fill(UiCore::Line{
                from_point: UiCore::Vec2(safe_box.origin.x, safe_box.origin.y),
                to_point: UiCore::Vec2(UiCore::right_edge(safe_box), UiCore::bottom_edge(safe_box)),
            }, mark)
            UiCore::fill(UiCore::Line{
                from_point: UiCore::Vec2(UiCore::right_edge(safe_box), safe_box.origin.y),
                to_point: UiCore::Vec2(safe_box.origin.x, UiCore::bottom_edge(safe_box)),
            }, mark)

        def record(handle: UiResources::Handle, options: Options) -> Record:
            current: DisplayState = display_state(handle)
            retryable: bool = options.allow_retry and can_retry(handle)
            return Record{
                handle: handle,
                kind: normalize_kind(options.kind),
                state: current,
                failure: UiResources::failure(handle),
                network_progress: UiResources::downloaded_progress(handle),
                decode_progress: UiResources::decoded_progress(handle),
                placeholder_visible: is_placeholder(handle),
                fallback_visible: is_fallback(handle),
                progress_visible: options.show_progress and current == DisplayState.Loading,
                retry_available: retryable,
                interaction_enabled: current == DisplayState.Ready or retryable,
                reserved_size: UiCore::Size(
                    UiCore::bounded_extent(options.reserved_width),
                    UiCore::bounded_extent(options.reserved_height)),
            }

        def normalize_kind(kind: Kind) -> Kind:
            return kind if kind == Kind.Image or kind == Kind.Font or kind == Kind.Document
            return Kind.Generic
