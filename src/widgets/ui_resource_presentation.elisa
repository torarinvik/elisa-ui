# Elisa-owned presentation policy for logical resources.
#
# UiResources owns identity and lifecycle; this module owns the user-facing
# interpretation of those states. Hosts still provide verified bytes and
# renderer handles. A backend can therefore consume one explicit record for a
# placeholder, progress indicator, ready asset, or recoverable fallback.

include "./ui_resources.elisa"

module UiResourcePresentation:
    public:
        const enum Kind of i32:
            Generic = 0
            Image = 1
            Font = 2
            Document = 3

        const enum DisplayState of i32:
            Placeholder = 0
            Loading = 1
            Ready = 2
            Offline = 3
            Denied = 4
            Failed = 5
            Cancelled = 6

        const enum Action of i32:
            None = 0
            Cancel = 1
            Retry = 2

        struct Options:
            kind: Kind
            reserved_width: f32
            reserved_height: f32
            placeholder_color: UiCore::Color
            fallback_color: UiCore::Color
            show_progress: bool
            allow_retry: bool

        struct Record:
            handle: UiResources::ResourceHandle
            owner: u32
            kind: Kind
            state: DisplayState
            failure: UiResources::FailureKind
            network_progress: f32
            decode_progress: f32
            upload_progress: f32
            demanded: bool
            demand_priority: u32
            placeholder_visible: bool
            fallback_visible: bool
            progress_visible: bool
            retry_available: bool
            interaction_enabled: bool
            reserved_size: UiCore::Size
            role: UiCore::AccessibilityRole
            title: sview
            detail: sview
            help: sview
            action: Action
            action_label: sview

        struct ActionResult:
            handle: UiResources::ResourceHandle
            action: Action
            changed: bool

        def default_options(kind: Kind) -> Options:
            safe_kind: Kind = normalize_kind(kind)
            if safe_kind == Kind.Image:
                return Options{
                    kind: safe_kind, reserved_width: 64.0, reserved_height: 64.0,
                    placeholder_color: UiCore::rgb(42, 46, 56),
                    fallback_color: UiCore::rgb(92, 48, 54),
                    show_progress: true, allow_retry: true,
                }
            if safe_kind == Kind.Font:
                return Options{
                    kind: safe_kind, reserved_width: 0.0, reserved_height: 0.0,
                    placeholder_color: UiCore::rgb(42, 46, 56),
                    fallback_color: UiCore::rgb(92, 48, 54),
                    show_progress: false, allow_retry: true,
                }
            if safe_kind == Kind.Document:
                return Options{
                    kind: safe_kind, reserved_width: 320.0, reserved_height: 200.0,
                    placeholder_color: UiCore::rgb(42, 46, 56),
                    fallback_color: UiCore::rgb(92, 48, 54),
                    show_progress: true, allow_retry: true,
                }
            return Options{
                kind: safe_kind, reserved_width: 0.0, reserved_height: 0.0,
                placeholder_color: UiCore::rgb(42, 46, 56),
                fallback_color: UiCore::rgb(92, 48, 54),
                show_progress: true, allow_retry: false,
            }

        # High-level request helpers coalesce by logical identifier through
        # UiResources::request() and immediately return the framework-owned
        # presentation record. Applications can keep that typed handle for
        # later completion, retry, cancellation, or disposal.
        def request(key: sview, owner: u32, options: Options) -> Record:
            return UiResourcePresentation::record_for_owner(UiResources::request(key, owner), owner, options)

        # Request and publish a visibility/prefetch hint together. The logical
        # request remains idempotent, while the returned snapshot reflects the
        # exact generation that received the demand. An invalid key simply
        # returns the same neutral record as request().
        def request_with_demand(key: sview, owner: u32, priority: u32, options: Options) -> Record:
            handle: UiResources::ResourceHandle = UiResources::request(key, owner)
            _ = UiResources::set_demand_for_owner(handle, owner, priority)
            return UiResourcePresentation::record_for_owner(handle, owner, options)

        def request_kind(key: sview, owner: u32, kind: Kind) -> Record:
            safe_kind: Kind = normalize_kind(kind)
            return UiResourcePresentation::request(key, owner, default_options(safe_kind))

        def request_image(key: sview, owner: u32) -> Record:
            return UiResourcePresentation::request_kind(key, owner, Kind.Image)

        def request_font(key: sview, owner: u32) -> Record:
            return UiResourcePresentation::request_kind(key, owner, Kind.Font)

        def request_document(key: sview, owner: u32) -> Record:
            return UiResourcePresentation::request_kind(key, owner, Kind.Document)

        def request_kind_with_demand(key: sview, owner: u32, priority: u32, kind: Kind) -> Record:
            safe_kind: Kind = normalize_kind(kind)
            return UiResourcePresentation::request_with_demand(key, owner, priority, default_options(safe_kind))

        def request_image_with_demand(key: sview, owner: u32, priority: u32) -> Record:
            return UiResourcePresentation::request_kind_with_demand(key, owner, priority, Kind.Image)

        def request_font_with_demand(key: sview, owner: u32, priority: u32) -> Record:
            return UiResourcePresentation::request_kind_with_demand(key, owner, priority, Kind.Font)

        def request_document_with_demand(key: sview, owner: u32, priority: u32) -> Record:
            return UiResourcePresentation::request_kind_with_demand(key, owner, priority, Kind.Document)

        def display_state(handle: UiResources::ResourceHandle) -> DisplayState:
            match UiResources::state(handle):
                UiResources::State.Unrequested:
                    return DisplayState.Placeholder
                UiResources::State.Requested:
                    return DisplayState.Loading
                UiResources::State.Ready:
                    return DisplayState.Ready
                UiResources::State.UnavailableOffline:
                    return DisplayState.Offline
                UiResources::State.Denied:
                    return DisplayState.Denied
                UiResources::State.Failed:
                    return DisplayState.Failed
                UiResources::State.Cancelled:
                    return DisplayState.Cancelled

        def is_placeholder(handle: UiResources::ResourceHandle) -> bool:
            current: DisplayState = display_state(handle)
            return current == DisplayState.Placeholder or current == DisplayState.Loading

        def is_fallback(handle: UiResources::ResourceHandle) -> bool:
            current: DisplayState = display_state(handle)
            return current == DisplayState.Offline or current == DisplayState.Denied or current == DisplayState.Failed or current == DisplayState.Cancelled

        def can_retry(handle: UiResources::ResourceHandle) -> bool:
            return UiResources::can_retry(handle)

        # A retry starts a new resource generation. Callers must store the
        # returned handle so late callbacks from the failed operation cannot
        # update the replacement request.
        def retry(handle: UiResources::ResourceHandle) -> UiResources::ResourceHandle:
            return UiResources::retry(handle)

        # Explicitly cancels the shared logical operation for every owner.
        # Use cancel_record() when only this widget should stop observing it.
        def cancel(handle: UiResources::ResourceHandle) -> bool:
            return UiResources::cancel(handle)

        def cancel_record(value: Record) -> bool:
            return UiResources::cancel_for_owner(value.handle, value.owner)

        # Interpret an explicit control activation against the current
        # generation and owner lease. A stale snapshot can never cancel a
        # completed request or retry a replacement generation.
        def perform_action(value: Record) -> ActionResult:
            unchanged: ActionResult = ActionResult{handle: value.handle, action: value.action, changed: false}
            return unchanged if not UiResources::resource_is_valid(value.handle) or not UiResources::owns(value.handle, value.owner)
            if value.action == Action.Cancel and UiResources::state(value.handle) == UiResources::State.Requested:
                return ActionResult{handle: value.handle, action: value.action, changed: cancel_record(value)}
            if value.action == Action.Retry and UiResources::can_retry(value.handle):
                replacement: UiResources::ResourceHandle = retry(value.handle)
                return ActionResult{handle: replacement, action: value.action, changed: UiResources::resource_is_valid(replacement)}
            return unchanged

        def clear_demand(value: Record) -> bool:
            return UiResources::clear_demand_for_owner(value.handle, value.owner)

        # Emit the stable visual fallback owned by the framework. Ready assets
        # intentionally emit nothing: the host resolves verified bytes through
        # its renderer, while every non-ready state remains backend-neutral.
        def paint(box: UiCore::Rect, value: Record, options: Options) -> void:
            # Callers can construct records and rectangles directly, bypassing
            # the convenience constructors. Normalize at this policy boundary
            # before deriving progress geometry or emitting a fallback card.
            safe_box: UiCore::Rect = UiCore::Rect(
                UiCore::bounded_coordinate(box.origin.x),
                UiCore::bounded_coordinate(box.origin.y),
                UiCore::bounded_extent(box.size.width),
                UiCore::bounded_extent(box.size.height))
            if value.placeholder_visible:
                UiCore::fill(safe_box, options.placeholder_color)
                if value.progress_visible and safe_box.size.width > 0.0 and safe_box.size.height > 0.0:
                    progress_width: f32 = safe_box.size.width * UiCore::normalized_unit(displayed_progress(value))
                    progress_y: mutable f32 = UiCore::bottom_edge(safe_box) - 4.0
                    progress_y <- safe_box.origin.y if progress_y < safe_box.origin.y else progress_y
                    UiCore::fill(UiCore::Rect(safe_box.origin.x, progress_y, progress_width, 3.0), options.fallback_color)
                return
            return if not value.fallback_visible
            UiCore::fill(safe_box, options.fallback_color)
            mark: UiCore::Color = UiCore::rgba(255, 255, 255, 70)
            UiCore::fill(UiCore::Line{
                from_point: UiCore::Vec2(safe_box.origin.x, safe_box.origin.y),
                to_point: UiCore::Vec2(UiCore::right_edge(safe_box), UiCore::bottom_edge(safe_box)),
            }, mark)
            UiCore::fill(UiCore::Line{
                from_point: UiCore::Vec2(UiCore::right_edge(safe_box), safe_box.origin.y),
                to_point: UiCore::Vec2(safe_box.origin.x, UiCore::bottom_edge(safe_box)),
            }, mark)

        def record(handle: UiResources::ResourceHandle, options: Options) -> Record:
            return UiResourcePresentation::record_for_owner(handle, UiResources::owner(handle), options)

        def normalize_kind(kind: Kind) -> Kind:
            return kind if kind == Kind.Image or kind == Kind.Font or kind == Kind.Document
            return Kind.Generic

        def displayed_progress(value: Record) -> f32:
            # Once decode is complete the bar represents renderer upload, not
            # a misleading full-width decode bar while the image is unusable.
            return value.upload_progress if value.decode_progress >= 1.0 else value.decode_progress

    private:
        struct StatusCopy:
            role: UiCore::AccessibilityRole
            title: sview
            detail: sview
            help: sview
            action: Action
            action_label: sview

        def status_copy(state: DisplayState, failure: UiResources::FailureKind, can_retry_now: bool, can_cancel: bool) -> StatusCopy:
            if state == DisplayState.Loading:
                return StatusCopy{
                    role: UiCore::AccessibilityRole.Status,
                    title: "Loading resource", detail: "The app remains available while content loads.",
                    help: "Activate to stop waiting." if can_cancel else "", action: Action.Cancel if can_cancel else Action.None,
                    action_label: "Cancel loading" if can_cancel else "",
                }
            if state == DisplayState.Ready:
                return StatusCopy{role: UiCore::AccessibilityRole.Status, title: "Resource ready", detail: "The content is available.", help: "", action: Action.None, action_label: ""}
            if state == DisplayState.Offline:
                return StatusCopy{
                    role: UiCore::AccessibilityRole.Alert,
                    title: "Resource unavailable offline", detail: "Connect and retry to load this content.",
                    help: "Activate to retry." if can_retry_now else "", action: Action.Retry if can_retry_now else Action.None,
                    action_label: "Retry" if can_retry_now else "",
                }
            if state == DisplayState.Denied:
                return StatusCopy{
                    role: UiCore::AccessibilityRole.Alert,
                    title: "Resource access denied", detail: "The host did not grant access to this content.",
                    help: "Activate to retry after access changes." if can_retry_now else "", action: Action.Retry if can_retry_now else Action.None,
                    action_label: "Retry" if can_retry_now else "",
                }
            if state == DisplayState.Failed:
                if failure == UiResources::FailureKind.RetryableTransport:
                    return StatusCopy{
                        role: UiCore::AccessibilityRole.Alert,
                        title: "Resource failed to load", detail: "The transfer did not complete.",
                        help: "Activate to retry." if can_retry_now else "", action: Action.Retry if can_retry_now else Action.None,
                        action_label: "Retry" if can_retry_now else "",
                    }
                if failure == UiResources::FailureKind.Corrupt:
                    return StatusCopy{role: UiCore::AccessibilityRole.Alert, title: "Resource could not be verified", detail: "Choose an updated package before trying again.", help: "", action: Action.None, action_label: ""}
                if failure == UiResources::FailureKind.Incompatible:
                    return StatusCopy{role: UiCore::AccessibilityRole.Alert, title: "Resource is incompatible", detail: "Update the app package to use this content.", help: "", action: Action.None, action_label: ""}
                return StatusCopy{role: UiCore::AccessibilityRole.Alert, title: "Resource failed", detail: "This failure has no automatic recovery action.", help: "", action: Action.None, action_label: ""}
            if state == DisplayState.Cancelled:
                return StatusCopy{role: UiCore::AccessibilityRole.Status, title: "Resource loading cancelled", detail: "The content was not loaded.", help: "", action: Action.None, action_label: ""}
            return StatusCopy{role: UiCore::AccessibilityRole.Status, title: "Resource not requested", detail: "The content will load when requested.", help: "", action: Action.None, action_label: ""}

    public:
        def record_for_owner(handle: UiResources::ResourceHandle, owner: u32, options: Options) -> Record:
            current: DisplayState = display_state(handle)
            owned: bool = UiResources::owns(handle, owner)
            retryable: bool = options.allow_retry and owned and can_retry(handle)
            cancellable: bool = owned and current == DisplayState.Loading
            failure: UiResources::FailureKind = UiResources::failure(handle)
            copy: StatusCopy = status_copy(current, failure, retryable, cancellable)
            intrinsic: UiCore::Size = UiResources::intrinsic_size(handle)
            reserved_width: mutable f32 = UiCore::bounded_extent(options.reserved_width)
            reserved_height: mutable f32 = UiCore::bounded_extent(options.reserved_height)
            # A declared reservation wins. Zero means the caller has no
            # opinion, so a host-provided intrinsic dimension can stabilize
            # loading geometry without overriding an intentional size.
            reserved_width <- intrinsic.width if options.reserved_width == 0.0
            reserved_height <- intrinsic.height if options.reserved_height == 0.0
            return Record{
                handle: handle,
                owner: owner,
                kind: normalize_kind(options.kind),
                state: current,
                failure: failure,
                network_progress: UiResources::downloaded_progress(handle),
                decode_progress: UiResources::decoded_progress(handle),
                upload_progress: UiResources::uploaded_progress(handle),
                demanded: UiResources::is_demanded_for_owner(handle, owner),
                demand_priority: UiResources::demand_priority_for_owner(handle, owner),
                placeholder_visible: is_placeholder(handle),
                fallback_visible: is_fallback(handle),
                progress_visible: options.show_progress and current == DisplayState.Loading,
                retry_available: retryable,
                interaction_enabled: current == DisplayState.Ready or retryable,
                reserved_size: UiCore::Size(reserved_width, reserved_height),
                role: copy.role,
                title: copy.title,
                detail: copy.detail,
                help: copy.help,
                action: copy.action,
                action_label: copy.action_label,
            }
