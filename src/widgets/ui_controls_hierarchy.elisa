# The IMMEDIATE hierarchy, realized as native controls.
#
# UiWidgets is one of the two application layers that fill the control list;
# this file is everything the seam needs to know about it and nothing the seam
# needs to know without it. A program that builds a hierarchy includes this; a
# program that builds a retained tree includes ui_controls_flat.elisa instead.
# Linking both is not merely unnecessary, it is not possible: the compiler
# declines a unit that holds both layers' tree walks.

include "./ui_controls.elisa"
include "./ui_hierarchy.elisa"
# ui_ops `extend`s UiWidgets with the passes; box_of lives there, not in the
# type declarations.
include "./ui_ops.elisa"

extend UiControls:
    # The mapping is public for the reason it was before this file existed: a
    # test asks what a widget kind becomes without realizing a tree.
    public:
        def normalized_slider(value: f32, low: f32, high: f32) -> ControlState:
            lower: mutable f32 = UiCore::bounded_coordinate(low)
            upper: mutable f32 = UiCore::bounded_coordinate(high)
            if upper < lower:
                swap: f32 = lower
                lower <- upper
                upper <- swap
            candidate: f32 = UiCore::bounded_coordinate(value)
            safe_value: f32 = lower if candidate < lower else (upper if candidate > upper else candidate)
            return ControlState{value: safe_value, low: lower, high: upper, selected: false, enabled: true, secure: false}

        # Which OS control realizes this widget. Exhaustive on purpose: a
        # widget kind added without a control is a compile error here.
        def kind_of(w: UiWidgets::Widget) -> ControlKind:
            match w:
                UiWidgets::Window.Top(title, resizable):
                    return ControlKind.Window
                UiWidgets::Window.Floating(title):
                    return ControlKind.Window
                UiWidgets::Container.Box(axis, padding, spacing, fill):
                    return ControlKind.Panel
                UiWidgets::Container.Grid(columns, padding, spacing, fill):
                    return ControlKind.Panel
                UiWidgets::Container.Scroll(axis, offset, fill):
                    return ControlKind.ScrollView
                UiWidgets::Container.ScrollWithState(axis, state, fill):
                    return ControlKind.ScrollView
                UiWidgets::Control.Label(text, size, ink):
                    return ControlKind.Label
                UiWidgets::Control.Gauge(fraction, track, bar):
                    return ControlKind.ProgressBar
                UiWidgets::Control.Slider(value, low, high, track, knob):
                    return ControlKind.Slider
                UiWidgets::Control.TextBox(text, caret, size, ink, fill):
                    return ControlKind.TextField
                UiWidgets::Button.Push(label, rest, hover, press):
                    return ControlKind.PushButton
                UiWidgets::Button.Toggle(label, on, rest, hover, press):
                    return ControlKind.ToggleButton
                UiWidgets::Button.Check(label, checked, rest, hover, press):
                    return ControlKind.CheckBox
                UiWidgets::Button.Radio(label, group, selected, rest, hover, press):
                    return ControlKind.RadioButton

        # Which of a widget's colours a native control may honour. See
        # UiControls::Palette for why a button's are not among them.
        #
        # A slider and a gauge are the two controls whose colours are not text
        # and not a panel: their INK is the filled part and their FILL is the
        # track, which is the same pair of roles under different names and is
        # why one record covers all of them.
        def palette_of(w: UiWidgets::Widget) -> Palette:
            match w:
                UiWidgets::Container.Box(axis, padding, spacing, fill):
                    return Palette{ink: transparent_ink(), fill: fill}
                UiWidgets::Container.Grid(columns, padding, spacing, fill):
                    return Palette{ink: transparent_ink(), fill: fill}
                UiWidgets::Container.Scroll(axis, offset, fill):
                    return Palette{ink: transparent_ink(), fill: fill}
                UiWidgets::Container.ScrollWithState(axis, state, fill):
                    return Palette{ink: transparent_ink(), fill: fill}
                UiWidgets::Control.Label(text, size, ink):
                    return Palette{ink: ink, fill: transparent_ink()}
                UiWidgets::Control.TextBox(text, caret, size, ink, fill):
                    return Palette{ink: ink, fill: fill}
                UiWidgets::Control.Gauge(fraction, track, bar):
                    return Palette{ink: bar, fill: track}
                UiWidgets::Control.Slider(value, low, high, track, knob):
                    return Palette{ink: knob, fill: track}
                _:
                    return Palette{ink: transparent_ink(), fill: transparent_ink()}

        # The hierarchy's window variants carry the only decoration policy the
        # controls seam needs. All non-window controls use the neutral value.
        def window_mode_of(w: UiWidgets::Widget) -> WindowMode:
            match w:
                UiWidgets::Window.Top(title, resizable):
                    return WindowMode.Resizable if resizable else WindowMode.Fixed
                UiWidgets::Window.Floating(title):
                    return WindowMode.Floating
                _:
                    return WindowMode.Fixed

        # Extract widget values once, in Elisa, before the native boundary.
        #
        # THIS LAYER CARRIES NO `enabled`, `secure`, PLACEHOLDER OR HELP. The
        # immediate hierarchy's variants do not have those fields, so every
        # control it realizes is enabled, unmasked and unhinted -- stated here
        # rather than left as a silent default, because the retained layer next
        # door does carry all four and a reader will wonder.
        def state_of(w: UiWidgets::Widget) -> ControlState:
            match w:
                UiWidgets::Control.Gauge(fraction, track, bar):
                    return ControlState{value: UiCore::normalized_unit(fraction), low: 0.0, high: 1.0, selected: false, enabled: true, secure: false}
                UiWidgets::Control.Slider(value, low, high, track, knob):
                    return normalized_slider(value, low, high)
                UiWidgets::Button.Toggle(label, on, rest, hover, press):
                    return ControlState{value: 0.0, low: 0.0, high: 1.0, selected: on, enabled: true, secure: false}
                UiWidgets::Button.Check(label, checked, rest, hover, press):
                    return ControlState{value: 0.0, low: 0.0, high: 1.0, selected: checked, enabled: true, secure: false}
                UiWidgets::Button.Radio(label, group, selected, rest, hover, press):
                    return ControlState{value: 0.0, low: 0.0, high: 1.0, selected: selected, enabled: true, secure: false}
                _:
                    return ControlState{value: 0.0, low: 0.0, high: 1.0, selected: false, enabled: true, secure: false}

        # The text a control shows. Empty for anything that carries none, so a
        # backend can set it unconditionally.
        def text_of(w: UiWidgets::Widget) -> sview:
            match w:
                UiWidgets::Window.Top(title, resizable):
                    return normalized_text(title)
                UiWidgets::Window.Floating(title):
                    return normalized_text(title)
                UiWidgets::Control.Label(text, size, ink):
                    return normalized_text(text)
                UiWidgets::Control.TextBox(text, caret, size, ink, fill):
                    return normalized_text(text)
                UiWidgets::Button.Push(label, rest, hover, press):
                    return normalized_text(label)
                UiWidgets::Button.Toggle(label, on, rest, hover, press):
                    return normalized_text(label)
                UiWidgets::Button.Check(label, checked, rest, hover, press):
                    return normalized_text(label)
                UiWidgets::Button.Radio(label, group, selected, rest, hover, press):
                    return normalized_text(label)
                _:
                    return ""

        def normalized_text(value: sview) -> sview:
            return UiCore::bounded_text(value)

        # Walk one widget and its subtree, PARENT FIRST, so the OS tree comes out
        # with the widget tree's shape and a child's parent already exists.
        #
        # Past MAX_CONTROLS a subtree is dropped rather than overwriting a live record:
        # a missing control is visible and fixable, a corrupted one is neither.
        def realize(w: UiWidgets::Widget, parent: i32, depth: i32) -> void:
            if depth >= MAX_REALIZE_DEPTH:
                control_dropped <- true
                return
            if total >= MAX_CONTROLS:
                control_dropped <- true
                return
            index: usize = total
            total <- total + 1
            ops[index].kind <- kind_of(w)
            ops[index].window_mode <- window_mode_of(w)
            ops[index].axis <- UiWidgets::axis_of(w)
            state: ControlState = state_of(w)
            # Write the compact state fields explicitly. Besides making the
            # record layout obvious, this avoids depending on aggregate
            # assignment for a mixed float/bool payload in stage0.
            ops[index].state_value <- state.value
            ops[index].state_low <- state.low
            ops[index].state_high <- state.high
            ops[index].state_selected <- state.selected
            ops[index].state_enabled <- state.enabled
            ops[index].state_secure <- state.secure
            ops[index].parent <- parent
            ops[index].box <- UiWidgets::box_of(w)
            ops[index].text <- copy_control_text(index, text_of(w))
            ops[index].placeholder <- copy_control_placeholder(index, "")
            ops[index].help <- copy_control_help(index, "")
            palette: Palette = palette_of(w)
            ops[index].ink <- palette.ink
            ops[index].fill <- palette.fill
            ops[index].native_handle <- 0
            cursor: mutable UiWidgets::Widget? = w.first_child if UiWidgets::can_nest(w) else null
            sibling_steps: mutable i32 = 0
            while cursor is node |cursor, index, sibling_steps|:
                if sibling_steps >= MAX_REALIZE_SIBLINGS:
                    control_dropped <- true
                    break
                realize(node, index.i32(), depth + 1)
                sibling_steps <- sibling_steps + 1
                cursor <- node.next_sibling
            # The root call is the one that has a whole tree to mirror.
            mirror_control_boxes() if parent == NO_PARENT
