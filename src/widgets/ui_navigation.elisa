# Backend-neutral back-navigation policy.
#
# Native hosts report a back gesture, button, Escape key, or window-close fact;
# they do not decide whether that fact navigates, is consumed by the current
# view, or needs confirmation. This bounded stack keeps that decision in Elisa
# so desktop and mobile adapters can share the same behavior without trapping
# OS navigation in a platform shim.

module UiNavigation:
    public:
        const MAX_ENTRIES: usize = 32
        const NAVIGATION_NONE_SLOT: usize = MAX_ENTRIES

        const enum BackPolicy of i32:
            Allow = 0
            Confirm = 1
            Consume = 2

        const enum BackDecision of i32:
            Unhandled = 0
            Navigate = 1
            Confirm = 2
            Consumed = 3

        # Keep the public identity module-specific. Included Elisa modules are
        # lowered through one type table by the current compiler, so a generic
        # `Handle` would collide with widget/dialog/resource tokens.
        struct NavigationHandle:
            slot: u32
            generation: u32

        struct Snapshot:
            entries: usize
            pending_confirmation: bool
            overflowed: bool

        def navigation_invalid() -> NavigationHandle:
            return NavigationHandle{slot: NAVIGATION_NONE_SLOT.u32(), generation: 0}

        def reset() -> void:
            for slot in 0..<MAX_ENTRIES:
                navigation_occupied[slot] <- false
                navigation_generations[slot] <- navigation_next_generation(navigation_generations[slot])
                navigation_owners[slot] <- 0
                navigation_policies[slot] <- BackPolicy.Allow
                navigation_dirty[slot] <- false
                navigation_sequence[slot] <- 0
            navigation_entry_count <- 0
            navigation_sequence_state <- 0
            navigation_pending_slot <- NAVIGATION_NONE_SLOT
            navigation_overflowed_state <- false
            navigation_mark_changed()

        def snapshot() -> Snapshot:
            return Snapshot{entries: navigation_entry_count,
                pending_confirmation: navigation_pending_slot != NAVIGATION_NONE_SLOT,
                overflowed: navigation_overflowed_state}

        def overflowed() -> bool:
            return navigation_overflowed_state

        def navigation_is_valid(handle: NavigationHandle) -> bool:
            return handle.slot.usize() < MAX_ENTRIES and navigation_occupied[handle.slot.usize()] and navigation_generations[handle.slot.usize()] == handle.generation

        # Push records the current view/surface. The owner is application state,
        # not a native pointer; disposing an owner can therefore pop its entries
        # safely during a surface loss or task cancellation.
        def push(owner: u32, policy: BackPolicy, is_dirty: bool) -> NavigationHandle:
            return navigation_invalid() if not navigation_policy_is_valid(policy)
            free_slot: mutable usize = NAVIGATION_NONE_SLOT
            for slot in 0..<MAX_ENTRIES:
                if not navigation_occupied[slot]:
                    free_slot <- slot
                    break
            if free_slot == NAVIGATION_NONE_SLOT:
                navigation_overflowed_state <- true
                return navigation_invalid()
            navigation_occupied[free_slot] <- true
            navigation_generations[free_slot] <- navigation_next_generation(navigation_generations[free_slot])
            navigation_owners[free_slot] <- owner
            navigation_policies[free_slot] <- policy
            navigation_dirty[free_slot] <- is_dirty
            navigation_sequence_state <- navigation_next_sequence(navigation_sequence_state)
            navigation_sequence[free_slot] <- navigation_sequence_state
            navigation_entry_count <- navigation_entry_count + 1
            navigation_mark_changed()
            return NavigationHandle{slot: free_slot.u32(), generation: navigation_generations[free_slot]}

        def top() -> NavigationHandle:
            selected: mutable usize = NAVIGATION_NONE_SLOT
            newest: mutable u64 = 0
            for slot in 0..<MAX_ENTRIES:
                if navigation_occupied[slot] and navigation_sequence[slot] >= newest:
                    selected <- slot
                    newest <- navigation_sequence[slot]
            return navigation_invalid() if selected == NAVIGATION_NONE_SLOT
            return NavigationHandle{slot: selected.u32(), generation: navigation_generations[selected]}

        def owner(handle: NavigationHandle) -> u32:
            return 0 if not navigation_is_valid(handle)
            return navigation_owners[handle.slot.usize()]

        def policy(handle: NavigationHandle) -> BackPolicy:
            return BackPolicy.Allow if not navigation_is_valid(handle)
            return navigation_policies[handle.slot.usize()]

        def is_dirty(handle: NavigationHandle) -> bool:
            return navigation_is_valid(handle) and navigation_dirty[handle.slot.usize()]

        def set_dirty(handle: NavigationHandle, value: bool) -> bool:
            return false if not navigation_is_valid(handle)
            slot: usize = handle.slot.usize()
            return false if navigation_dirty[slot] == value
            navigation_dirty[slot] <- value
            # Dirty state changes back-navigation policy and can alter both
            # confirmation UI and semantic affordances immediately.
            UiCore::invalidate(UiCore::Invalidation.Paint)
            UiCore::invalidate(UiCore::Invalidation.Semantics)
            return true

        # Request only reports the policy. Allow/Confirm never silently pop a
        # view: the application may save state first, then call commit().
        # Consume explicitly acknowledges the event without trapping the host.
        def request_back() -> BackDecision:
            current: NavigationHandle = top()
            return BackDecision.Unhandled if not navigation_is_valid(current)
            if navigation_pending_slot != NAVIGATION_NONE_SLOT:
                return BackDecision.Confirm
            slot: usize = current.slot.usize()
            if navigation_policies[slot] == BackPolicy.Consume:
                return BackDecision.Consumed
            if navigation_policies[slot] == BackPolicy.Confirm and navigation_dirty[slot]:
                navigation_pending_slot <- slot
                navigation_mark_changed()
                return BackDecision.Confirm
            return BackDecision.Navigate

        # Complete an allowed back navigation after the application has saved or
        # otherwise accepted it. A stale handle cannot pop a recycled entry.
        def commit(handle: NavigationHandle) -> bool:
            return false if not navigation_is_valid(handle)
            return false if navigation_pending_slot != NAVIGATION_NONE_SLOT and navigation_pending_slot != handle.slot.usize()
            current: NavigationHandle = top()
            return false if not navigation_is_valid(current) or current.slot != handle.slot or current.generation != handle.generation
            navigation_pending_slot <- NAVIGATION_NONE_SLOT if navigation_pending_slot == handle.slot.usize()
            navigation_clear_slot(handle.slot.usize())
            navigation_mark_changed()
            return true

        # Resolve the confirmation requested by request_back(). Rejecting it
        # consumes the prompt but leaves the view and its dirty state intact.
        def resolve_confirmation(accept: bool) -> BackDecision:
            return BackDecision.Unhandled if navigation_pending_slot == NAVIGATION_NONE_SLOT
            slot: usize = navigation_pending_slot
            navigation_pending_slot <- NAVIGATION_NONE_SLOT
            navigation_mark_changed()
            return BackDecision.Consumed if not accept
            return BackDecision.Unhandled if not navigation_occupied[slot]
            handle: NavigationHandle = NavigationHandle{slot: slot.u32(), generation: navigation_generations[slot]}
            return BackDecision.Consumed if top().slot != handle.slot or top().generation != handle.generation
            return BackDecision.Consumed if not commit(handle)
            return BackDecision.Navigate

        def cancel_confirmation() -> bool:
            return false if navigation_pending_slot == NAVIGATION_NONE_SLOT
            navigation_pending_slot <- NAVIGATION_NONE_SLOT
            navigation_mark_changed()
            return true

        def dismiss_owner(owner_id: u32) -> usize:
            released: mutable usize = 0
            for slot in 0..<MAX_ENTRIES:
                if navigation_occupied[slot] and navigation_owners[slot] == owner_id:
                    navigation_pending_slot <- NAVIGATION_NONE_SLOT if navigation_pending_slot == slot
                    navigation_clear_slot(slot)
                    released <- released + 1
            navigation_mark_changed() if released > 0
            return released

    private:
        global mutable navigation_occupied: bool[MAX_ENTRIES] = zeroed
        global mutable navigation_generations: u32[MAX_ENTRIES] = zeroed
        global mutable navigation_owners: u32[MAX_ENTRIES] = zeroed
        global mutable navigation_policies: BackPolicy[MAX_ENTRIES] = zeroed
        global mutable navigation_dirty: bool[MAX_ENTRIES] = zeroed
        # Sequence numbers are private ordering facts. Keep them wider than
        # the compact handle generation so pushing views for a long-running
        # session cannot make an older entry appear newer after wraparound.
        global mutable navigation_sequence: u64[MAX_ENTRIES] = zeroed
        global mutable navigation_entry_count: usize = 0
        global mutable navigation_sequence_state: u64 = 0
        global mutable navigation_pending_slot: usize = NAVIGATION_NONE_SLOT
        global mutable navigation_overflowed_state: bool = false

        def navigation_next_generation(value: u32) -> u32:
            next: u32 = value + 1
            return 1 if next == 0 else next

        def navigation_next_sequence(value: u64) -> u64:
            next: u64 = value + 1
            return 1 if next == 0 else next

        def navigation_clear_slot(slot: usize) -> void:
            return if slot >= MAX_ENTRIES or not navigation_occupied[slot]
            navigation_pending_slot <- NAVIGATION_NONE_SLOT if navigation_pending_slot == slot
            navigation_occupied[slot] <- false
            navigation_generations[slot] <- navigation_next_generation(navigation_generations[slot])
            navigation_owners[slot] <- 0
            navigation_policies[slot] <- BackPolicy.Allow
            navigation_dirty[slot] <- false
            navigation_sequence[slot] <- 0
            navigation_entry_count <- navigation_entry_count - 1 if navigation_entry_count > 0

        def navigation_mark_changed() -> void:
            UiCore::invalidate(UiCore::Invalidation.Paint)
            UiCore::invalidate(UiCore::Invalidation.Semantics)

        def navigation_policy_is_valid(value: BackPolicy) -> bool:
            return value == BackPolicy.Allow or value == BackPolicy.Confirm or value == BackPolicy.Consume
