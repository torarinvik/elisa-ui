# elisa-ui widget constants, shared by both widget layers. Each closed set is
# its own module so a value reads as `UiAxis::ROW` rather than a prefixed
# global, and adding a set means adding a module, not a naming convention.

# A container distributes its children ALONG one axis and stretches them
# ACROSS the other -- wxBoxSizer's orientation, spelled as a value rather
# than a class.
module UiAxis:
    public:
        const COLUMN: i32 = 0
        const ROW: i32 = 1

# What a widget layer reports back to the application through
# app_widget_event.
module UiWidgetEvent:
    public:
        const CLICK: i32 = 0
