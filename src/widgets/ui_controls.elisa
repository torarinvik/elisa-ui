# elisa-ui native controls: turning the widget tree into real OS controls.
#
# THE OTHER HALF OF THE FRAMEWORK. ui_paint.elisa's Painter consumes the COMMAND
# LIST and owns every pixel. This consumes the WIDGET TREE and owns none of them:
# it creates NSViews, HWNDs, GtkWidgets, UIViews or android.view.Views and lets
# the platform draw, lay out text, handle IME, mirror right-to-left and speak to
# a screen reader. Those are the things you cannot get by drawing rectangles, and
# they are the reason to want native controls at all.
#
# The two backends therefore share no interface, and forcing them to would give
# one where half the methods are meaningless on each side -- `fill_triangle`
# means nothing to AppKit, `create` means nothing to a rasterizer. What they DO
# share is the widget tree above them, which is the portable boundary.
#
# ABSOLUTE PLACEMENT. Every control is positioned at the box `UiWidgets::layout`
# already computed, so ui_ops.elisa stays the single layout implementation and
# both presentation modes agree about where things are. The cost is the platform
# behaviour that comes from letting the platform lay out -- Dynamic Type, RTL
# mirroring, platform-correct focus order. Delegating to Auto Layout,
# ConstraintLayout or a GtkBox is a per-backend upgrade this shape leaves open,
# not a rewrite.
#
# A CONTROL LIST, mirroring the command list. The tree walk emits flat records;
# the backend consumes them. That split began as a compiler workaround -- a
# generic over a hierarchy handle was miscompiled, so the walk that touches
# widget handles was kept non-generic and the generic that talks to the backend
# never saw a handle. The workaround is gone (a generic over a store-backed
# handle carries its hidden store slot correctly as of 2026-09-04) and the shape
# stays, because it was the better shape independently and for the same reasons
# the command list is: the control list is plain data, so it can be asserted in a
# test with no OS control in sight, logged, diffed between runs, or shipped to a
# host across a boundary that no widget handle could cross.
#
# A backend receives an opaque handle through the protocol's create call and may
# retain it in this record while it applies the realization. The shared arena is
# the one index -> handle table, so a native backend does not need a second
# capacity, count or lifetime table in C/Objective-C.

include "./ui_hierarchy.elisa"
# ui_ops `extend`s UiWidgets with the passes; box_of lives there, not in the
# type declarations.
include "./ui_ops.elisa"
include "../core/ui_paint.elisa"

# One module for the whole seam: the vocabulary, the list the tree walk fills,
# and the loop that hands it to a backend.
#
# A backend names `Controls` UNQUALIFIED in its impl header, under `using
# UiControls`, for the reason ui_paint.elisa gives: `impl UiControls::Controls
# for T:` is the one shape neither compiler takes.
module UiControls:
    public:
        # The control vocabulary every target actually has. Not a copy of the
        # widget taxonomy -- several widget variants collapse onto one OS control,
        # which is the point of the mapping being explicit and in one place:
        #
        #   Window       NSWindow    HWND               GtkWindow          UIWindow
        #   Panel        NSView      HWND (child)       GtkBox             UIView
        #   ScrollView   NSScrollView                   GtkScrolledWindow  UIScrollView
        #   Label        NSTextField STATIC             GtkLabel           UILabel
        #   PushButton   NSButton    BUTTON             GtkButton          UIButton
        #   ToggleButton NSButton    BS_AUTOCHECKBOX    GtkToggleButton    UISwitch
        #   CheckBox     NSButton    BS_CHECKBOX        GtkCheckButton     UISwitch
        #   RadioButton  NSButton    BS_RADIOBUTTON     GtkCheckButton     UISegmented
        #   TextField    NSTextField EDIT               GtkEntry           UITextField
        #   Slider       NSSlider    TRACKBAR           GtkScale           UISlider
        #   ProgressBar  NSProgress  msctls_progress32  GtkProgressBar     UIProgressView
        const enum Kind of i32:
            Window = 0
            Panel = 1
            ScrollView = 2
            Label = 3
            PushButton = 4
            ToggleButton = 5
            CheckBox = 6
            RadioButton = 7
            TextField = 8
            Slider = 9
            ProgressBar = 10

        # Window decoration policy is part of the widget hierarchy, not a
        # native toolkit default. Keeping it typed in the control list lets a
        # backend choose the corresponding native surface without re-matching
        # the hierarchy or silently treating every window as resizable.
        const enum WindowMode of i32:
            Fixed = 0
            Resizable = 1
            Floating = 2

        # Initial value state carried by controls that expose one. The range
        # fields are meaningful for sliders; `selected` covers toggle, check
        # and radio buttons. Other kinds receive the neutral zero value.
        struct ControlState:
            value: f32
            low: f32
            high: f32
            selected: bool

        # The root's parent.
        const NO_PARENT: i32 = -1

        # What a native backend must provide.
        #
        # `index` is the control's position in the list and its identity: a backend
        # maps it to its own NSView*, HWND or jobject. `parent` is another index,
        # or NO_PARENT for the root -- and because the list is emitted parent-first,
        # a parent has always been created before any child names it.
        protocol Controls:
            # The normalized initial state is available during construction as
            # well as in set_state, so a native control never exposes a
            # backend-specific placeholder range between create and apply.
            def create(index: i32, kind: Kind, parent: i32, window_mode: WindowMode, axis: UiConst::Axis, state: ControlState) -> void can[Ui.Controls]
            # Absolute placement, at the box UiWidgets::layout computed. The
            # kind crosses with it so a backend can select window-content versus
            # child-view placement in typed Elisa code.
            def set_frame(index: i32, kind: Kind, box: UiCore::Rect) -> void can[Ui.Controls]
            # The control's own text: a label, a button's caption, a window's title.
            # The kind crosses with it so a backend can keep this semantic dispatch
            # in its typed Elisa implementation instead of inspecting native classes.
            def set_text(index: i32, kind: Kind, text: sview) -> void can[Ui.Controls]
            # Initial value/range/selection state, kept separate from caption
            # text so a backend can apply native state with typed setters.
            def set_state(index: i32, kind: Kind, value: f32, low: f32, high: f32, selected: bool) -> void can[Ui.Controls]

    private:
        # Native controls and the custom painter share the same value contract:
        # gauges use a normalized fraction and sliders use an ordered range.
        # Resolve that contract once while recording the control list so every
        # backend receives identical, safe state instead of reimplementing it.
        def normalized_slider(value: f32, low: f32, high: f32) -> ControlState:
            # A finite f32 can still be enormous (for example, a value read
            # directly from an untrusted FFI struct). Keep the signed range
            # within the same geometry envelope used by native frames before
            # passing it to a platform slider setter.
            lower: mutable f32 = UiCore::bounded_coordinate(low)
            upper: mutable f32 = UiCore::bounded_coordinate(high)
            if upper < lower:
                swap: f32 = lower
                lower <- upper
                upper <- swap
            candidate: f32 = UiCore::bounded_coordinate(value)
            safe_value: f32 = lower if candidate < lower else (upper if candidate > upper else candidate)
            return ControlState{value: safe_value, low: lower, high: upper, selected: false}

        # The list itself. It sits after the vocabulary because that is the reading
        # order -- what a backend must implement first, then how the list is kept.
        #
        # Stage0 distinguishes fixed-size arrays from generic types by requiring
        # an underscore in the array-size constant name.
        const MAX_CONTROLS: usize = 256
        # Realization walks a handle-backed hierarchy, so unlike UiFlat it
        # cannot infer termination from an arena index. Keep malformed
        # self-links and sibling cycles bounded before they can exhaust the
        # native-control list or the host call stack. These limits are
        # framework policy, not backend details; every native target receives
        # the same fail-closed behavior.
        const MAX_REALIZE_DEPTH: i32 = 256
        const MAX_REALIZE_SIBLINGS: i32 = 1024
        # Own captions in a bounded arena so a backend may apply records later.
        const CONTROL_TEXT_CAPACITY: usize = UiCore::MAX_TEXT_BYTES
        const CONTROL_TEXT_STORAGE_SIZE: usize = MAX_CONTROLS * CONTROL_TEXT_CAPACITY

        struct ControlOp:
            kind: mutable Kind
            window_mode: mutable WindowMode
            axis: mutable UiConst::Axis
            state_value: mutable f32
            state_low: mutable f32
            state_high: mutable f32
            state_selected: mutable bool
            parent: mutable i32
            box: mutable UiCore::Rect
            text: mutable sview
            # Backend-owned opaque identity. Elisa stores it here so the native
            # side can remain a stateless object bridge. Zero means no handle.
            native_handle: mutable usize

        global mutable ops: ControlOp[MAX_CONTROLS] = zeroed
        global mutable control_text_storage: u8[CONTROL_TEXT_STORAGE_SIZE] = zeroed
        global mutable total: usize = 0
        global mutable control_dropped: bool = false

        def copy_control_text(index: usize, value: sview) -> sview:
            return "" if index >= MAX_CONTROLS
            safe: sview = UiCore::bounded_text(value)
            offset: usize = index * CONTROL_TEXT_CAPACITY
            for byte_index in 0..<CONTROL_TEXT_CAPACITY:
                control_text_storage[offset + byte_index] <- 0
            take: usize = safe.len.usize()
            for byte_index in 0..<take:
                control_text_storage[offset + byte_index] <- safe.data[byte_index]
            return control_text_storage[offset:offset + take]

    public:
        def reset() -> void:
            for text_index in 0..<total:
                for byte_index in 0..<CONTROL_TEXT_CAPACITY:
                    control_text_storage[text_index * CONTROL_TEXT_CAPACITY + byte_index] <- 0
            for index in 0..<MAX_CONTROLS:
                ops[index].native_handle <- 0
            total <- 0
            control_dropped <- false

        def count() -> usize:
            return total

        # Native backends may need a bounded object table. Keep the capacity
        # query beside the retained control arena so that limit is sourced from
        # Elisa rather than duplicated in a platform shim.
        def capacity() -> usize:
            return MAX_CONTROLS

        # A full control arena drops the overflowing subtree rather than
        # overwriting a live record. Expose that fact so applications can fail
        # loudly or switch to a recovery UI instead of mistaking it for an
        # intentionally empty tree.
        def overflowed() -> bool:
            return control_dropped

        def kind_at(index: usize) -> Kind:
            return Kind.Panel if index >= total
            return ops[index].kind

        def window_mode_at(index: usize) -> WindowMode:
            return WindowMode.Fixed if index >= total
            return ops[index].window_mode

        def axis_at(index: usize) -> UiConst::Axis:
            return UiConst::Axis.Column if index >= total
            return UiConst::normalize_axis(ops[index].axis)

        def state_at(index: usize) -> ControlState:
            return ControlState{value: 0.0, low: 0.0, high: 1.0, selected: false} if index >= total
            return ControlState{value: ops[index].state_value, low: ops[index].state_low, high: ops[index].state_high, selected: ops[index].state_selected}

        def parent_at(index: usize) -> i32:
            return NO_PARENT if index >= total
            return ops[index].parent

        def box_at(index: usize) -> UiCore::Rect:
            return UiCore::Rect(0.0, 0.0, 0.0, 0.0) if index >= total
            return ops[index].box

        def text_at(index: usize) -> sview:
            return "" if index >= total
            return ops[index].text

        # A native backend records its retained opaque object here after create;
        # later frame, text, state and attachment calls resolve through Elisa's
        # arena instead of a duplicated platform-side index table.
        def native_handle_at(index: usize) -> usize:
            return 0 if index >= total
            return ops[index].native_handle

        def set_native_handle(index: usize, handle: usize) -> void:
            return if index >= total
            ops[index].native_handle <- handle

        # Walk one widget and its subtree, PARENT FIRST, so the OS tree comes out
        # with the widget tree's shape and a child's parent already exists.
        #
        # Past MAX_CONTROLS a subtree is dropped rather than overwriting a live record:
        # a missing control is visible and fixable, a corrupted one is neither.
        def realize(w: UiWidgets::Widget, parent: i32, depth: i32) -> void:
            if depth >= MAX_REALIZE_DEPTH:
                control_dropped <- true
                return
            if total >= MAX_CONTROLS:
                control_dropped <- true
                return
            index: usize = total
            total <- total + 1
            ops[index].kind <- kind_of(w)
            ops[index].window_mode <- window_mode_of(w)
            ops[index].axis <- UiWidgets::axis_of(w)
            state: ControlState = state_of(w)
            # Write the compact state fields explicitly. Besides making the
            # record layout obvious, this avoids depending on aggregate
            # assignment for a mixed float/bool payload in stage0.
            ops[index].state_value <- state.value
            ops[index].state_low <- state.low
            ops[index].state_high <- state.high
            ops[index].state_selected <- state.selected
            ops[index].parent <- parent
            ops[index].box <- UiWidgets::box_of(w)
            ops[index].text <- copy_control_text(index, text_of(w))
            ops[index].native_handle <- 0
            cursor: mutable UiWidgets::Widget? = w.first_child
            sibling_steps: mutable i32 = 0
            while cursor is node |cursor, index, sibling_steps|:
                if sibling_steps >= MAX_REALIZE_SIBLINGS:
                    control_dropped <- true
                    break
                realize(node, index.i32(), depth + 1)
                sibling_steps <- sibling_steps + 1
                cursor <- node.next_sibling

        # Hand the list to a backend, in order. The only generic here, and it
        # never touches a widget handle.
        def apply[C: Controls]() -> void can[Ui.Controls]:
            for index in 0..<count():
                slot: i32 = index.i32()
                state: ControlState = state_at(index)
                C.create(slot, kind_at(index), parent_at(index), window_mode_at(index), axis_at(index), state)
                C.set_frame(slot, kind_at(index), box_at(index))
                C.set_text(slot, kind_at(index), text_at(index))
                C.set_state(slot, kind_at(index), state.value, state.low, state.high, state.selected)

        # Which OS control realizes this widget. Exhaustive on purpose: a widget
        # kind added without a control is a compile error here, not a silently
        # invisible node.
        def kind_of(w: UiWidgets::Widget) -> Kind:
            match w:
                UiWidgets::Window.Top(title, resizable):
                    return Kind.Window
                UiWidgets::Window.Floating(title):
                    return Kind.Window
                UiWidgets::Container.Box(axis, padding, spacing, fill):
                    return Kind.Panel
                UiWidgets::Container.Grid(columns, padding, spacing, fill):
                    return Kind.Panel
                UiWidgets::Container.Scroll(axis, offset, fill):
                    return Kind.ScrollView
                UiWidgets::Container.ScrollWithState(axis, state, fill):
                    return Kind.ScrollView
                UiWidgets::Control.Label(text, size, ink):
                    return Kind.Label
                UiWidgets::Control.Gauge(fraction, track, bar):
                    return Kind.ProgressBar
                UiWidgets::Control.Slider(value, low, high, track, knob):
                    return Kind.Slider
                UiWidgets::Control.TextBox(text, caret, size, ink, fill):
                    return Kind.TextField
                UiWidgets::Button.Push(label, rest, hover, press):
                    return Kind.PushButton
                UiWidgets::Button.Toggle(label, on, rest, hover, press):
                    return Kind.ToggleButton
                UiWidgets::Button.Check(label, checked, rest, hover, press):
                    return Kind.CheckBox
                UiWidgets::Button.Radio(label, group, selected, rest, hover, press):
                    return Kind.RadioButton

        # The hierarchy's window variants carry the only decoration policy the
        # controls seam needs. All non-window controls use the neutral value.
        def window_mode_of(w: UiWidgets::Widget) -> WindowMode:
            match w:
                UiWidgets::Window.Top(title, resizable):
                    return WindowMode.Resizable if resizable else WindowMode.Fixed
                UiWidgets::Window.Floating(title):
                    return WindowMode.Floating
                _:
                    return WindowMode.Fixed

        # Extract widget values once, in Elisa, before the native boundary.
        # This keeps the platform adapter from inspecting hierarchy variants.
        def state_of(w: UiWidgets::Widget) -> ControlState:
            match w:
                UiWidgets::Control.Gauge(fraction, track, bar):
                    return ControlState{value: UiCore::normalized_unit(fraction), low: 0.0, high: 1.0, selected: false}
                UiWidgets::Control.Slider(value, low, high, track, knob):
                    return normalized_slider(value, low, high)
                UiWidgets::Button.Toggle(label, on, rest, hover, press):
                    return ControlState{value: 0.0, low: 0.0, high: 1.0, selected: on}
                UiWidgets::Button.Check(label, checked, rest, hover, press):
                    return ControlState{value: 0.0, low: 0.0, high: 1.0, selected: checked}
                UiWidgets::Button.Radio(label, group, selected, rest, hover, press):
                    return ControlState{value: 0.0, low: 0.0, high: 1.0, selected: selected}
                _:
                    return ControlState{value: 0.0, low: 0.0, high: 1.0, selected: false}

        # The text a control shows. Empty for anything that carries none, so a
        # backend can set it unconditionally.
        def text_of(w: UiWidgets::Widget) -> sview:
            match w:
                UiWidgets::Window.Top(title, resizable):
                    return normalized_text(title)
                UiWidgets::Window.Floating(title):
                    return normalized_text(title)
                UiWidgets::Control.Label(text, size, ink):
                    return normalized_text(text)
                UiWidgets::Control.TextBox(text, caret, size, ink, fill):
                    return normalized_text(text)
                UiWidgets::Button.Push(label, rest, hover, press):
                    return normalized_text(label)
                UiWidgets::Button.Toggle(label, on, rest, hover, press):
                    return normalized_text(label)
                UiWidgets::Button.Check(label, checked, rest, hover, press):
                    return normalized_text(label)
                UiWidgets::Button.Radio(label, group, selected, rest, hover, press):
                    return normalized_text(label)
                _:
                    return ""

    private:
        # Hierarchy variants are public and can be constructed without the
        # convenience builders. Normalize their signed ABI views again at the
        # final control-list boundary so native backends never reinterpret a
        # negative length as an unsigned copy size or receive an oversized
        # counted string.
        def normalized_text(value: sview) -> sview:
            return UiCore::bounded_text(value)
