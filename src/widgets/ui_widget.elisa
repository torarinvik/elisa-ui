# elisa-ui flat-widget facade.
#
# UiFlat is intentionally still the public compatibility namespace. Its
# implementation is organized by ownership so state, construction, layout,
# text, input, scrolling, and painting can evolve independently without
# exposing the retained arena or its scratch buffers.

include "../core/ui_lifecycle.elisa"
# The direction policy is part of the widget layer's own vocabulary now, not
# just of text layout's: a checkbox's marker has a SIDE, and the side is the
# reader's, not the framework's.
include "./ui_localization.elisa"
include "./ui_flat_identity.elisa"
include "./ui_flat_accessors.elisa"
include "./ui_flat_theme_tokens.elisa"
include "./ui_flat_choice.elisa"
include "./ui_flat_build.elisa"
include "./ui_flat_layout.elisa"
include "./ui_flat_focus.elisa"
include "./ui_flat_direction.elisa"
include "./ui_flat_style.elisa"
include "./ui_flat_theme.elisa"
include "./ui_flat_motion.elisa"
include "./ui_flat_events.elisa"
include "./ui_flat_text_semantics.elisa"
include "./ui_flat_text_core.elisa"
include "./ui_flat_text_history.elisa"
include "./ui_flat_layout_api.elisa"
include "./ui_flat_text_api.elisa"
include "./ui_flat_text_editing.elisa"
include "./ui_flat_pointer.elisa"
include "./ui_flat_keyboard.elisa"
include "./ui_flat_scrollbar.elisa"
include "./ui_flat_paint.elisa"
include "./ui_responsive.elisa"
include "./ui_virtual_list.elisa"
include "./ui_text_metrics.elisa"
