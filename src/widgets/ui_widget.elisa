# elisa-ui flat widget layer: a retained widget tree in one fixed array, box
# layout, and hit testing. `module UiFlat`.
#
# This is the older, simpler layer: every widget is one row of `UiFlat::Widget`
# and a reference is an index. The sealed hierarchy in ui_hierarchy.elisa is
# the typed successor; this layer stays because it needs no arena and no
# region, which suits the smallest components.
#
# The layout model is wxWidgets' sizer idea reduced to its load-bearing parts: a
# container distributes its inner box along one axis, each child contributes a
# minimum size, and leftover space is shared out in proportion to each child's
# `grow` weight. Two passes -- measure bottom-up, then arrange top-down -- so a
# container's size never depends on the order its children were added.
#
# Nothing here allocates: a frame that lays out, hit-tests, and paints touches
# only the array and the core's command batch, which is what lets the same code
# run on the component backend's monotonic heap.
#
# Apps implement `app_widget_event(widget: usize, event)` to receive clicks.

include "../core/ui_core.elisa"
include "./ui_const.elisa"

module UiFlat:
    public:
        # The flat layer caps its tree; the sealed hierarchy in ui_hierarchy.elisa
        # has no cap because a handle IS the node there. new_widget degrades to
        # NONE past this rather than corrupting the tree.
        const MAX_WIDGETS: usize = 256
        # One KiB per field keeps the flat layer deterministic and allocation-
        # free without imposing the old 127-byte ceiling on ordinary desktop
        # input. One byte remains reserved by the storage contract.
        const TEXT_CAPACITY: usize = 1024
        const TEXT_STORAGE_SIZE: usize = MAX_WIDGETS * TEXT_CAPACITY
        const SECURE_TEXT_CAPACITY: usize = TEXT_CAPACITY * 3
        const SECURE_TEXT_STORAGE_SIZE: usize = MAX_WIDGETS * SECURE_TEXT_CAPACITY
        const TEXT_HISTORY_CAPACITY: usize = 32
        const TEXT_HISTORY_STORAGE_SIZE: usize = TEXT_HISTORY_CAPACITY * TEXT_CAPACITY
        # One past the last valid slot, so it can never collide with a real index.
        # DERIVED, not a second literal: as `= 256` beside `MAX_WIDGETS = 256` it
        # was one edit away from becoming a valid index, which would have made the
        # sentinel silently alias a real widget instead of failing loudly.
        const NONE: usize = MAX_WIDGETS

        struct Widget:
            kind: mutable UiConst::WidgetKind
            parent: mutable usize
            first_child: mutable usize
            next_sibling: mutable usize
            axis: mutable UiConst::Axis
            padding: mutable f32
            spacing: mutable f32
            margin: mutable f32
            cross_alignment: mutable UiConst::CrossAlignment
            main_alignment: mutable UiConst::MainAlignment
            declared_min_width: mutable f32
            declared_min_height: mutable f32
            min_width: mutable f32
            min_height: mutable f32
            max_width: mutable f32
            max_height: mutable f32
            grow: mutable f32
            x: mutable f32
            y: mutable f32
            width: mutable f32
            height: mutable f32
            color: mutable UiCore::Color
            hover_color: mutable UiCore::Color
            press_color: mutable UiCore::Color
            text: mutable sview
            placeholder: mutable sview
            help: mutable sview
            text_size: mutable f32
            text_color: mutable UiCore::Color
            secure: mutable bool
            interactive: mutable bool
            focus_order: mutable usize
            selection_group: mutable usize
            visible: mutable bool
            enabled: mutable bool
            hovered: mutable bool
            pressed: mutable bool
            focused: mutable bool
            selected: mutable bool
            value: mutable f32
            step: mutable f32
            input_length: mutable usize
            caret: mutable usize
            selection_anchor: mutable usize
            marked_start: mutable usize
            marked_end: mutable usize
            text_revision: mutable usize
            text_truncated: mutable bool
            # Scroll state is framework-owned. The content extents are the
            # measured size of the child strip; offset is clamped to the
            # viewport during arrange and changed by wheel input.
            scroll_offset: mutable f32
            scroll_content_width: mutable f32
            scroll_content_height: mutable f32

        # Shared visual tokens for details that are common to every widget.
        # Per-control surface and text colors remain on Widget so applications
        # can still build palettes without cloning the framework painter.
        struct Theme:
            focus_ring: mutable UiCore::Color
            selection: mutable UiCore::Color
            control_mark: mutable UiCore::Color
            control_mark_strong: mutable UiCore::Color
            focus_inset: mutable f32
            text_horizontal_padding: mutable f32
            text_vertical_padding: mutable f32
            selection_vertical_inset: mutable f32
            marked_underline_inset: mutable f32
            slider_horizontal_inset: mutable f32
            slider_track_height: mutable f32
            slider_thumb_radius: mutable f32
            choice_center_x: mutable f32
            radio_outer_radius: mutable f32
            radio_inner_radius: mutable f32
            checkbox_size: mutable f32
            choice_text_space: mutable f32
            # One visible or hidden half-cycle. Zero keeps the caret steadily
            # visible and requests no animation, useful for reduced motion.
            caret_blink_interval: mutable f32
            scrollbar_track: mutable UiCore::Color
            scrollbar_thumb: mutable UiCore::Color
            scrollbar_thumb_hover: mutable UiCore::Color
            scrollbar_thumb_active: mutable UiCore::Color
            scrollbar_width: mutable f32
            scrollbar_inset: mutable f32

    private:
        global mutable widgets: Widget[MAX_WIDGETS] = zeroed
        # Scratch allocation by widget index. Recursive layout is safe because
        # each tree node has a unique slot and a child only rewrites descendants.
        global mutable layout_extra: f32[MAX_WIDGETS] = zeroed
        global mutable layout_capped: bool[MAX_WIDGETS] = zeroed
        global mutable semantic_emitted: bool[MAX_WIDGETS] = zeroed
        global mutable text_storage: u8[TEXT_STORAGE_SIZE] = zeroed
        global mutable secure_text_storage: u8[SECURE_TEXT_STORAGE_SIZE] = zeroed
        global mutable widget_count: usize = 0
        global mutable widget_dropped: bool = false
        global mutable last_layout_width: f32 = 0.0
        global mutable last_layout_height: f32 = 0.0
        global mutable layout_initialized: bool = false
        # Geometry-affecting mutations defer one retained reflow until the
        # next paint. This keeps layout policy in Elisa while avoiding a full
        # measure/arrange pass for every setter during a frame.
        global mutable layout_dirty: bool = false
        # The widget under the pointer, and the one holding a press. A click
        # only fires when both agree on release, so dragging off a button
        # cancels it.
        global mutable hot_widget: usize = NONE
        global mutable pointer_x: f32 = 0.0
        global mutable pointer_y: f32 = 0.0
        global mutable pointer_inside: bool = false
        global mutable active_widget: usize = NONE
        global mutable active_scroll: usize = NONE
        global mutable active_scroll_pointer: f32 = 0.0
        global mutable active_scroll_offset: f32 = 0.0
        global mutable active_pointer_button: i32 = UiCore::NO_POINTER_BUTTON
        global mutable active_key: i32 = -1
        global mutable focused_widget: usize = NONE
        global mutable left_shift_down: bool = false
        global mutable right_shift_down: bool = false
        global mutable left_control_down: bool = false
        global mutable right_control_down: bool = false
        global mutable left_super_down: bool = false
        global mutable right_super_down: bool = false
        global mutable clipboard_buffer: u8[TEXT_CAPACITY] = zeroed
        # Text history is global so edits across fields undo in chronological
        # order. Each bounded entry stores complete before/after field states;
        # Complete before/after snapshots keep behavior deterministic and
        # allocation-free; capacity constants derive the exact storage cost.
        global mutable history_widget: usize[TEXT_HISTORY_CAPACITY] = zeroed
        global mutable history_before_text: u8[TEXT_HISTORY_STORAGE_SIZE] = zeroed
        global mutable history_after_text: u8[TEXT_HISTORY_STORAGE_SIZE] = zeroed
        global mutable history_before_length: usize[TEXT_HISTORY_CAPACITY] = zeroed
        global mutable history_after_length: usize[TEXT_HISTORY_CAPACITY] = zeroed
        global mutable history_before_caret: usize[TEXT_HISTORY_CAPACITY] = zeroed
        global mutable history_after_caret: usize[TEXT_HISTORY_CAPACITY] = zeroed
        global mutable history_before_anchor: usize[TEXT_HISTORY_CAPACITY] = zeroed
        global mutable history_after_anchor: usize[TEXT_HISTORY_CAPACITY] = zeroed
        global mutable history_before_marked_start: usize[TEXT_HISTORY_CAPACITY] = zeroed
        global mutable history_before_marked_end: usize[TEXT_HISTORY_CAPACITY] = zeroed
        global mutable history_after_marked_start: usize[TEXT_HISTORY_CAPACITY] = zeroed
        global mutable history_after_marked_end: usize[TEXT_HISTORY_CAPACITY] = zeroed
        global mutable history_count: usize = 0
        global mutable history_cursor: usize = 0
        global mutable history_active: bool = false
        global mutable history_suppressed: bool = false
        global mutable composition_history_slot: usize = TEXT_HISTORY_CAPACITY
        global mutable caret_blink_started: f64 = 0.0

        # Flat widgets have two container kinds. Keeping this predicate beside
        # link/new_widget makes the nesting invariant explicit and prevents a
        # leaf from becoming an unreachable parent with a misleading ancestry.
        def can_nest(index: usize) -> bool:
            return false if index >= widget_count
            return widgets[index].kind == UiConst::WidgetKind.Panel or widgets[index].kind == UiConst::WidgetKind.Scroll
        global mutable current_theme: Theme = Theme{
            focus_ring: UiCore::Color{r: 94, g: 158, b: 255, a: 245},
            selection: UiCore::Color{r: 55, g: 112, b: 214, a: 210},
            control_mark: UiCore::Color{r: 255, g: 255, b: 255, a: 185},
            control_mark_strong: UiCore::Color{r: 255, g: 255, b: 255, a: 255},
            focus_inset: 2.0,
            text_horizontal_padding: 12.0,
            text_vertical_padding: 8.0,
            selection_vertical_inset: 6.0,
            marked_underline_inset: 7.0,
            slider_horizontal_inset: 8.0,
            slider_track_height: 6.0,
            slider_thumb_radius: 8.0,
            choice_center_x: 17.0,
            radio_outer_radius: 5.5,
            radio_inner_radius: 2.8,
            checkbox_size: 11.0,
            choice_text_space: 28.0,
            caret_blink_interval: 0.5,
            scrollbar_track: UiCore::Color{r: 0, g: 0, b: 0, a: 70},
            scrollbar_thumb: UiCore::Color{r: 255, g: 255, b: 255, a: 175},
            scrollbar_thumb_hover: UiCore::Color{r: 255, g: 255, b: 255, a: 220},
            scrollbar_thumb_active: UiCore::Color{r: 255, g: 255, b: 255, a: 255},
            scrollbar_width: 8.0,
            scrollbar_inset: 4.0,
        }

        # Fractions are part of the public widget state and must never let an
        # out-of-range value reach layout, paint, accessibility, or a native
        # setter. The same helper is used by both direct setters and pointer
        # interaction so the two paths cannot drift.
        def shift_active() -> bool:
            return left_shift_down or right_shift_down

        def control_active() -> bool:
            return left_control_down or right_control_down

        def super_active() -> bool:
            return left_super_down or right_super_down

        # TextField is deliberately single-line. Native text input normally
        # routes Return to Submit, but paste and programmatic replacement can
        # still contain control or Unicode line separators. Replace every byte
        # of such a sequence with ASCII space so storage length and offsets stay
        # stable while no backend can interpret the value as multiple lines.
        def single_line_byte(text: sview, position: usize) -> u8:
            byte: u8 = text.data[position]
            return 32 if byte < 32 or byte == 127
            return 32 if byte == 194 and position + 1 < text.len and text.data[position + 1] == 133
            return 32 if byte == 133 and position > 0 and text.data[position - 1] == 194
            return 32 if byte == 226 and position + 2 < text.len and text.data[position + 1] == 128 and (text.data[position + 2] == 168 or text.data[position + 2] == 169)
            return 32 if byte == 128 and position > 0 and position + 1 < text.len and text.data[position - 1] == 226 and (text.data[position + 1] == 168 or text.data[position + 1] == 169)
            return 32 if (byte == 168 or byte == 169) and position > 1 and text.data[position - 1] == 128 and text.data[position - 2] == 226
            return byte

        def clamped_inset(value: f32, extent: f32) -> f32:
            safe: f32 = UiCore::nonnegative_extent(value)
            half: f32 = UiCore::nonnegative_extent(extent) / 2.0
            return safe if safe < half else half

        def restart_caret_blink() -> void:
            caret_blink_started <- UiCore::frame_time()

        def caret_is_visible() -> bool:
            interval: f32 = current_theme.caret_blink_interval
            return true if interval <= 0.0
            UiCore::request_frame_after(interval)
            elapsed: f64 = UiCore::frame_time() - caret_blink_started
            return true if elapsed <= 0.0
            return ((elapsed / interval.f64()).i64() % 2) == 0

        def link(parent: usize, child: usize) -> void:
            return if parent >= widget_count or child >= widget_count or parent == child
            return if not can_nest(parent)
            # A child may only be attached once. `new_widget` initializes its
            # parent before calling this helper, so the same-parent case is the
            # normal insertion path; a different parent would silently create
            # two ownership paths and make focus/layout traversal ambiguous.
            return if widgets[child].parent != NONE and widgets[child].parent != parent
            # Walking the proposed parent's ancestry rejects attaching an
            # ancestor below its own descendant, which would otherwise make
            # every parent/sibling traversal unbounded.
            ancestor: mutable usize = parent
            while ancestor < widget_count |ancestor|:
                return if ancestor == child
                ancestor <- widgets[ancestor].parent
            if widgets[parent].first_child == NONE:
                widgets[parent].first_child <- child
                widgets[child].parent <- parent
                return
            cursor: mutable usize = widgets[parent].first_child
            return if cursor == child
            while widgets[cursor].next_sibling != NONE |cursor|:
                cursor <- widgets[cursor].next_sibling
                return if cursor == child
            widgets[cursor].next_sibling <- child
            widgets[child].parent <- parent

        # Returns NONE when the arena is full; callers may pass that on as a
        # parent, and every traversal treats it as absent, so overflow degrades
        # to missing widgets rather than corrupting the tree.
        def new_widget(parent: usize, kind: UiConst::WidgetKind) -> usize:
            if widget_count >= MAX_WIDGETS:
                widget_dropped <- true
                return NONE
            index: usize = widget_count
            widget_count <- widget_count + 1
            layout_dirty <- true if layout_initialized
            safe_parent: usize = parent if parent < index and can_nest(parent) else NONE
            # A whole-record reset, not a `with` block: a literal must name
            # every field, so a field added to Widget cannot be left
            # uninitialised here.
            widgets[index] <- Widget{
                kind, parent: safe_parent,
                first_child: NONE, next_sibling: NONE,
                axis: UiConst::Axis.Column, padding: 0.0, spacing: 0.0, margin: 0.0,
                cross_alignment: UiConst::CrossAlignment.Stretch,
                main_alignment: UiConst::MainAlignment.Start,
                declared_min_width: 0.0, declared_min_height: 0.0,
                min_width: 0.0, min_height: 0.0,
                max_width: 0.0, max_height: 0.0, grow: 0.0,
                x: 0.0, y: 0.0, width: 0.0, height: 0.0,
                color: UiCore::Color{r: 0, g: 0, b: 0, a: 0}, hover_color: UiCore::Color{r: 0, g: 0, b: 0, a: 0}, press_color: UiCore::Color{r: 0, g: 0, b: 0, a: 0},
                text: "", placeholder: "", help: "", text_size: 0.0, text_color: UiCore::Color{r: 0, g: 0, b: 0, a: 0}, secure: false,
                interactive: false, focus_order: index, selection_group: parent, visible: true, enabled: true, hovered: false, pressed: false, focused: false, selected: false, value: 0.0, step: 0.05,
                input_length: 0, caret: 0, selection_anchor: 0, marked_start: 0, marked_end: 0, text_revision: 0, text_truncated: false,
                scroll_offset: 0.0, scroll_content_width: 0.0, scroll_content_height: 0.0,
            }
            link(safe_parent, index)
            return index

    public:
        # Reading and writing rows. A row is copied out; writes go through
        # the setters so the array stays private. `widget` is the fast path
        # for a known-valid handle; uncertain external handles use the checked
        # optional reader instead.
        def count() -> usize:
            return widget_count

        def is_valid(index: usize) -> bool:
            return index < widget_count

        def widget(index: usize) -> Widget:
            return widgets[index]

        def widget_if_valid(index: usize) -> Widget?:
            return null if index >= widget_count
            return widgets[index]

        def hot() -> usize:
            return hot_widget

        def active() -> usize:
            return active_widget

        def focused() -> usize:
            return focused_widget

        def request_focus(index: usize) -> bool:
            return false if index >= widget_count or not widgets[index].interactive or not effectively_enabled(index) or not effectively_visible(index)
            focus(index)
            return focused_widget == index

        def clear_focus() -> void:
            focus(NONE)

        def overflowed() -> bool:
            return widget_dropped

        def set_color(index: usize, color: UiCore::Color) -> void:
            return if index >= widget_count
            widgets[index].color <- color

        def theme() -> Theme:
            return current_theme

        def set_theme(next: Theme) -> void:
            normalized: mutable Theme = next
            normalized.focus_inset <- UiCore::nonnegative_extent(next.focus_inset)
            normalized.text_horizontal_padding <- UiCore::nonnegative_extent(next.text_horizontal_padding)
            normalized.text_vertical_padding <- UiCore::nonnegative_extent(next.text_vertical_padding)
            normalized.selection_vertical_inset <- UiCore::nonnegative_extent(next.selection_vertical_inset)
            normalized.marked_underline_inset <- UiCore::nonnegative_extent(next.marked_underline_inset)
            normalized.slider_horizontal_inset <- UiCore::nonnegative_extent(next.slider_horizontal_inset)
            normalized.slider_track_height <- UiCore::nonnegative_extent(next.slider_track_height)
            normalized.slider_thumb_radius <- UiCore::nonnegative_extent(next.slider_thumb_radius)
            normalized.choice_center_x <- UiCore::nonnegative_extent(next.choice_center_x)
            normalized.radio_outer_radius <- UiCore::nonnegative_extent(next.radio_outer_radius)
            normalized.radio_inner_radius <- UiCore::nonnegative_extent(next.radio_inner_radius)
            # A selected radio mark is drawn inside the outer ring. Keep a
            # hostile theme from inverting that layering relationship.
            normalized.radio_inner_radius <- normalized.radio_outer_radius if normalized.radio_inner_radius > normalized.radio_outer_radius
            normalized.checkbox_size <- UiCore::nonnegative_extent(next.checkbox_size)
            normalized.choice_text_space <- UiCore::nonnegative_extent(next.choice_text_space)
            normalized.caret_blink_interval <- UiCore::nonnegative_extent(next.caret_blink_interval)
            normalized.scrollbar_width <- UiCore::nonnegative_extent(next.scrollbar_width)
            normalized.scrollbar_inset <- UiCore::nonnegative_extent(next.scrollbar_inset)
            current_theme <- normalized

        def set_colors(index: usize, color: UiCore::Color, hover: UiCore::Color, press: UiCore::Color) -> void:
            return if index >= widget_count
            widgets[index] with { color, hover_color <- hover, press_color <- press }

        def set_grow(index: usize, grow: f32) -> void:
            return if index >= widget_count
            widgets[index].grow <- UiCore::nonnegative_extent(grow)
            layout_dirty <- true if layout_initialized

        # Zero means unbounded. A maximum below the measured minimum never
        # clips required content; the minimum wins for that axis.
        def set_max_size(index: usize, width: f32, height: f32) -> void:
            return if index >= widget_count
            widgets[index].max_width <- UiCore::nonnegative_extent(width)
            widgets[index].max_height <- UiCore::nonnegative_extent(height)
            layout_dirty <- true if layout_initialized

        def set_margin(index: usize, margin: f32) -> void:
            return if index >= widget_count
            widgets[index].margin <- UiCore::nonnegative_extent(margin)
            layout_dirty <- true if layout_initialized

        def set_cross_alignment(index: usize, alignment: UiConst::CrossAlignment) -> void:
            return if index >= widget_count
            widgets[index].cross_alignment <- alignment
            layout_dirty <- true if layout_initialized

        def set_main_alignment(index: usize, alignment: UiConst::MainAlignment) -> void:
            return if index >= widget_count
            widgets[index].main_alignment <- alignment
            layout_dirty <- true if layout_initialized

        def set_focus_order(index: usize, order: usize) -> void:
            return if index >= widget_count
            widgets[index].focus_order <- order

        # Radios default to one group per parent. An explicit group allows a
        # logical choice set to span layout containers without native state.
        def set_selection_group(index: usize, group: usize) -> void:
            return if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.RadioButton
            widgets[index].selection_group <- group

        def set_enabled(index: usize, enabled: bool) -> void:
            return if index >= widget_count
            widgets[index].enabled <- enabled
            if not enabled:
                for candidate in 0..<widget_count:
                    if not effectively_enabled(candidate):
                        widgets[candidate].hovered <- false
                        widgets[candidate].pressed <- false
                if active_widget < widget_count and not effectively_enabled(active_widget):
                    active_widget <- NONE
                    active_pointer_button <- UiCore::NO_POINTER_BUTTON
                    active_key <- -1
                if active_scroll < widget_count and not effectively_enabled(active_scroll):
                    active_scroll <- NONE
                    active_scroll_pointer <- 0.0
                    active_scroll_offset <- 0.0
                    active_pointer_button <- UiCore::NO_POINTER_BUTTON
                hot_widget <- NONE if hot_widget < widget_count and not effectively_enabled(hot_widget)
                focus(NONE) if focused_widget < widget_count and not effectively_enabled(focused_widget)

        def is_enabled(index: usize) -> bool:
            return effectively_enabled(index)

        def is_visible(index: usize) -> bool:
            return effectively_visible(index)

        # Hidden widgets remain in the retained tree but contribute no layout,
        # painting, hit target, focus stop or accessibility node. Hiding a
        # container applies transitively to its descendants.
        def set_visible(index: usize, shown: bool) -> void:
            return if index >= widget_count
            widgets[index].visible <- shown
            layout_dirty <- true if layout_initialized
            return if shown
            for candidate in 0..<widget_count:
                if not effectively_visible(candidate):
                    widgets[candidate].hovered <- false
                    widgets[candidate].pressed <- false
            if active_widget < widget_count and not effectively_visible(active_widget):
                active_widget <- NONE
                active_pointer_button <- UiCore::NO_POINTER_BUTTON
                active_key <- -1
            if active_scroll < widget_count and not effectively_visible(active_scroll):
                active_scroll <- NONE
                active_scroll_pointer <- 0.0
                active_scroll_offset <- 0.0
                active_pointer_button <- UiCore::NO_POINTER_BUTTON
            hot_widget <- NONE if hot_widget < widget_count and not effectively_visible(hot_widget)
            focus(NONE) if focused_widget < widget_count and not effectively_visible(focused_widget)

        # Give any painted widget a caption. Buttons keep their declared minimum
        # hit target; labels still use `label`, which derives its minimum from text.
        def set_text(index: usize, text: sview, size: f32, color: UiCore::Color) -> void:
            return if index >= widget_count
            safe_size: f32 = UiCore::nonnegative_extent(size)
            widgets[index] with { text, text_size <- safe_size, text_color <- color }
            if widgets[index].kind == UiConst::WidgetKind.Label:
                measured_width: f32 = UiCore::nonnegative_extent(ui_measure_text_width(text, safe_size))
                measured_height: f32 = UiCore::nonnegative_extent(ui_text_line_height(safe_size))
                widgets[index] with {
                    declared_min_width <- measured_width, declared_min_height <- measured_height,
                    min_width <- measured_width, min_height <- measured_height,
                }
            layout_dirty <- true if layout_initialized

        def set_help(index: usize, help: sview) -> void:
            return if index >= widget_count
            widgets[index].help <- help

        def set_secure(index: usize, secure: bool) -> void:
            return if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.TextField
            widgets[index].secure <- secure

        # Selection is independent from focus and press state. Applications own
        # group policy, so a radio group can span containers without hidden state.
        def set_selected(index: usize, selected: bool) -> void:
            return if index >= widget_count
            return if widgets[index].kind != UiConst::WidgetKind.RadioButton and widgets[index].kind != UiConst::WidgetKind.CheckBox
            if selected and widgets[index].kind == UiConst::WidgetKind.RadioButton:
                for candidate in 0..<widget_count:
                    if candidate != index and widgets[candidate].kind == UiConst::WidgetKind.RadioButton and widgets[candidate].selection_group == widgets[index].selection_group:
                        widgets[candidate].selected <- false
            widgets[index].selected <- selected

        def set_value(index: usize, value: f32) -> void:
            return if index >= widget_count
            return if widgets[index].kind != UiConst::WidgetKind.Slider and widgets[index].kind != UiConst::WidgetKind.ProgressBar
            widgets[index].value <- UiCore::normalized_unit(value)

        def set_step(index: usize, step: f32) -> void:
            return if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.Slider
            widgets[index].step <- UiCore::nonnegative_extent(step)

        def text_value(index: usize) -> sview:
            return "" if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.TextField
            offset: usize = index * TEXT_CAPACITY
            return sview(&text_storage[offset], 0, widgets[index].input_length.i64())

        # Whether the most recent input operation retained only a prefix due
        # to malformed UTF-8 or fixed-capacity exhaustion.
        def text_was_truncated(index: usize) -> bool:
            return false if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.TextField
            return widgets[index].text_truncated

        def scrub_clipboard_buffer() -> void:
            # Paste data is transient framework state. Erase the fixed scratch
            # arena after use instead of leaving a copy alive until the next
            # reset or process exit.
            for byte_index in 0..<TEXT_CAPACITY:
                clipboard_buffer[byte_index] <- 0

        def reset() -> void:
            # Fixed buffers are reused, so reset must erase content rather than
            # merely dropping lengths. This also scrubs secure values retained
            # by undo/redo snapshots.
            for byte_index in 0..<TEXT_STORAGE_SIZE:
                text_storage[byte_index] <- 0
            for byte_index in 0..<SECURE_TEXT_STORAGE_SIZE:
                secure_text_storage[byte_index] <- 0
            for byte_index in 0..<TEXT_HISTORY_STORAGE_SIZE:
                history_before_text[byte_index] <- 0
                history_after_text[byte_index] <- 0
            scrub_clipboard_buffer()
            widget_count <- 0
            widget_dropped <- false
            last_layout_width <- 0.0
            last_layout_height <- 0.0
            layout_initialized <- false
            layout_dirty <- false
            hot_widget <- NONE
            pointer_x <- 0.0
            pointer_y <- 0.0
            pointer_inside <- false
            active_widget <- NONE
            active_scroll <- NONE
            active_scroll_pointer <- 0.0
            active_scroll_offset <- 0.0
            active_pointer_button <- UiCore::NO_POINTER_BUTTON
            active_key <- -1
            focused_widget <- NONE
            left_shift_down <- false
            right_shift_down <- false
            left_control_down <- false
            right_control_down <- false
            left_super_down <- false
            right_super_down <- false
            history_count <- 0
            history_cursor <- 0
            history_active <- false
            history_suppressed <- false
            composition_history_slot <- TEXT_HISTORY_CAPACITY

        def panel(parent: usize, axis: UiConst::Axis, padding: f32, spacing: f32, color: UiCore::Color) -> usize:
            index: usize = new_widget(parent, UiConst::WidgetKind.Panel)
            return index if index == NONE
            widgets[index] with { axis, padding <- UiCore::nonnegative_extent(padding), spacing <- UiCore::nonnegative_extent(spacing), color, hover_color <- color, press_color <- color }
            return index

        # A scroll container reserves a viewport while its children retain
        # their measured extent. Wheel input changes the offset in Elisa and
        # re-runs the same layout pass, so no backend owns scroll geometry.
        def scroll(parent: usize, axis: UiConst::Axis, min_width: f32, min_height: f32, color: UiCore::Color) -> usize:
            index: usize = new_widget(parent, UiConst::WidgetKind.Scroll)
            return index if index == NONE
            safe_width: f32 = UiCore::nonnegative_extent(min_width)
            safe_height: f32 = UiCore::nonnegative_extent(min_height)
            widgets[index] with {
                axis, declared_min_width <- safe_width, declared_min_height <- safe_height,
                min_width <- safe_width, min_height <- safe_height,
                color, hover_color <- color, press_color <- color,
            }
            return index

        def button(parent: usize, min_width: f32, min_height: f32, color: UiCore::Color, hover_color: UiCore::Color, press_color: UiCore::Color) -> usize:
            index: usize = new_widget(parent, UiConst::WidgetKind.Button)
            return index if index == NONE
            safe_width: f32 = UiCore::nonnegative_extent(min_width)
            safe_height: f32 = UiCore::nonnegative_extent(min_height)
            widgets[index] with { declared_min_width <- safe_width, declared_min_height <- safe_height, min_width <- safe_width, min_height <- safe_height, color, hover_color, press_color, interactive <- true }
            return index

        def radio_button(parent: usize, min_width: f32, min_height: f32, color: UiCore::Color, hover_color: UiCore::Color, press_color: UiCore::Color) -> usize:
            index: usize = new_widget(parent, UiConst::WidgetKind.RadioButton)
            return index if index == NONE
            safe_width: f32 = UiCore::nonnegative_extent(min_width)
            safe_height: f32 = UiCore::nonnegative_extent(min_height)
            widgets[index] with { declared_min_width <- safe_width, declared_min_height <- safe_height, min_width <- safe_width, min_height <- safe_height, color, hover_color, press_color, interactive <- true }
            return index

        def check_box(parent: usize, min_width: f32, min_height: f32, color: UiCore::Color, hover_color: UiCore::Color, press_color: UiCore::Color) -> usize:
            index: usize = new_widget(parent, UiConst::WidgetKind.CheckBox)
            return index if index == NONE
            safe_width: f32 = UiCore::nonnegative_extent(min_width)
            safe_height: f32 = UiCore::nonnegative_extent(min_height)
            widgets[index] with { declared_min_width <- safe_width, declared_min_height <- safe_height, min_width <- safe_width, min_height <- safe_height, color, hover_color, press_color, interactive <- true }
            return index

        # A slider stores a normalized value. Its three colors are the track,
        # filled range and thumb, keeping the fixed widget record compact.
        def slider(parent: usize, label: sview, min_width: f32, min_height: f32, value: f32, track_color: UiCore::Color, fill_color: UiCore::Color, thumb_color: UiCore::Color) -> usize:
            index: usize = new_widget(parent, UiConst::WidgetKind.Slider)
            return index if index == NONE
            safe_width: f32 = UiCore::nonnegative_extent(min_width)
            safe_height: f32 = UiCore::nonnegative_extent(min_height)
            widgets[index] with {
                declared_min_width <- safe_width, declared_min_height <- safe_height, min_width <- safe_width, min_height <- safe_height, text <- label, value,
                color <- track_color, hover_color <- fill_color, press_color <- thumb_color,
                interactive <- true,
            }
            set_value(index, value)
            return index

        def progress_bar(parent: usize, label: sview, min_width: f32, min_height: f32, value: f32, track_color: UiCore::Color, fill_color: UiCore::Color) -> usize:
            index: usize = new_widget(parent, UiConst::WidgetKind.ProgressBar)
            return index if index == NONE
            safe_width: f32 = UiCore::nonnegative_extent(min_width)
            safe_height: f32 = UiCore::nonnegative_extent(min_height)
            widgets[index] with {
                declared_min_width <- safe_width, declared_min_height <- safe_height, min_width <- safe_width, min_height <- safe_height, text <- label, value,
                color <- track_color, hover_color <- fill_color,
            }
            set_value(index, value)
            return index

        def text_field(parent: usize, label: sview, placeholder: sview, initial: sview, min_width: f32, min_height: f32, size: f32, ink: UiCore::Color, fill: UiCore::Color) -> usize:
            index: usize = new_widget(parent, UiConst::WidgetKind.TextField)
            return index if index == NONE
            safe_width: f32 = UiCore::nonnegative_extent(min_width)
            safe_height: f32 = UiCore::nonnegative_extent(min_height)
            safe_size: f32 = UiCore::nonnegative_extent(size)
            widgets[index] with {
                declared_min_width <- safe_width, declared_min_height <- safe_height, min_width <- safe_width, min_height <- safe_height, text <- label, placeholder,
                text_size <- safe_size, text_color <- ink, color <- fill,
                hover_color <- fill, press_color <- fill, interactive <- true,
            }
            byte_limit: usize = initial.len if initial.len < TEXT_CAPACITY - 1 else TEXT_CAPACITY - 1
            limit: usize = grapheme_prefix_length(initial, valid_utf8_prefix(initial, byte_limit))
            widgets[index].text_truncated <- limit < initial.len
            offset: usize = index * TEXT_CAPACITY
            for byte_index in 0..<limit:
                text_storage[offset + byte_index] <- single_line_byte(initial, byte_index)
            widgets[index].input_length <- limit
            widgets[index].caret <- limit
            widgets[index].selection_anchor <- limit
            widgets[index] with { marked_start <- 0, marked_end <- 0 }
            return index

        def secure_text_field(parent: usize, label: sview, placeholder: sview, initial: sview, min_width: f32, min_height: f32, size: f32, ink: UiCore::Color, fill: UiCore::Color) -> usize:
            index: usize = text_field(parent, label, placeholder, initial, min_width, min_height, size, ink, fill)
            set_secure(index, true)
            return index

        # A label's minimum is the measured extent of its text, so it
        # participates in layout like any other child. Measurement happens
        # once here rather than every frame: the text is a view that does not
        # change, and the platform's measure call may cross into the host.
        def label(parent: usize, text: sview, size: f32, color: UiCore::Color) -> usize:
            index: usize = new_widget(parent, UiConst::WidgetKind.Label)
            return index if index == NONE
            safe_size: f32 = UiCore::nonnegative_extent(size)
            measured_width: f32 = UiCore::nonnegative_extent(ui_measure_text_width(text, safe_size))
            measured_height: f32 = UiCore::nonnegative_extent(ui_text_line_height(safe_size))
            widgets[index] with {
                text, text_size <- safe_size, text_color <- color,
                declared_min_width <- measured_width, declared_min_height <- measured_height,
                min_width <- measured_width, min_height <- measured_height,
            }
            return index

    private:
        def child_count(index: usize) -> usize:
            total: mutable usize = 0
            cursor: mutable usize = widgets[index].first_child
            while cursor != NONE |cursor, total|:
                total <- total + 1 if widgets[cursor].visible
                cursor <- widgets[cursor].next_sibling
            return total

        def effectively_visible(index: usize) -> bool:
            return false if index >= widget_count
            cursor: mutable usize = index
            while cursor < widget_count |cursor|:
                return false if not widgets[cursor].visible
                cursor <- widgets[cursor].parent
            return true

        def effectively_enabled(index: usize) -> bool:
            return false if index >= widget_count
            cursor: mutable usize = index
            while cursor < widget_count |cursor|:
                return false if not widgets[cursor].enabled
                cursor <- widgets[cursor].parent
            return true

        def collapse(index: usize) -> void:
            return if index >= widget_count
            widgets[index] with { x <- 0.0, y <- 0.0, width <- 0.0, height <- 0.0 }
            child: mutable usize = widgets[index].first_child
            while child != NONE |child|:
                collapse(child)
                child <- widgets[child].next_sibling

        # Bottom-up pass: a container's minimum is its children's minima summed
        # along its axis (plus spacing and padding) and maximised across it. A
        # declared minimum still wins if it is larger.
        def measure(index: usize) -> void:
            return if index >= widget_count
            widgets[index].min_width <- widgets[index].declared_min_width
            widgets[index].min_height <- widgets[index].declared_min_height
            widgets[index].scroll_content_width <- widgets[index].declared_min_width
            widgets[index].scroll_content_height <- widgets[index].declared_min_height
            return if not effectively_visible(index)
            cursor: mutable usize = widgets[index].first_child
            return if cursor == NONE
            is_row: bool = widgets[index].axis == UiConst::Axis.Row
            along: mutable f32 = 0.0
            across: mutable f32 = 0.0
            children: mutable f32 = 0.0
            while cursor != NONE |cursor, along, across, children, is_row|:
                if widgets[cursor].visible:
                    measure(cursor)
                    child_margin: f32 = widgets[cursor].margin * 2.0
                    child_along: f32 = (widgets[cursor].min_width if is_row else widgets[cursor].min_height) + child_margin
                    child_across: f32 = (widgets[cursor].min_height if is_row else widgets[cursor].min_width) + child_margin
                    along <- along + child_along
                    across <- child_across if child_across > across else across
                    children <- children + 1.0
                cursor <- widgets[cursor].next_sibling
            gaps: f32 = widgets[index].spacing * (children - 1.0) if children > 1.0 else 0.0
            pad: f32 = widgets[index].padding * 2.0
            content_width: f32 = along + gaps + pad if is_row else across + pad
            content_height: f32 = across + pad if is_row else along + gaps + pad
            if widgets[index].kind == UiConst::WidgetKind.Scroll:
                widgets[index].scroll_content_width <- content_width if content_width > widgets[index].scroll_content_width else widgets[index].scroll_content_width
                widgets[index].scroll_content_height <- content_height if content_height > widgets[index].scroll_content_height else widgets[index].scroll_content_height
            else:
                widgets[index].min_width <- content_width if content_width > widgets[index].min_width
                widgets[index].min_height <- content_height if content_height > widgets[index].min_height

        # Top-down pass: give every child its minimum along the axis, then
        # share the leftover in proportion to `grow`. Cross-axis alignment can
        # stretch a child or place its measured extent at the start, center, or
        # end of the remaining band.
        def arrange(index: usize, x: f32, y: f32, width: f32, height: f32) -> void:
            return if index >= widget_count
            if not effectively_visible(index):
                collapse(index)
                return
            widgets[index] with { x, y, width, height }
            first: usize = widgets[index].first_child
            return if first == NONE

            pad: f32 = widgets[index].padding
            inner_x: f32 = x + pad
            inner_y: f32 = y + pad
            raw_inner_width: f32 = width - pad * 2.0
            raw_inner_height: f32 = height - pad * 2.0
            inner_width: f32 = raw_inner_width if raw_inner_width > 0.0 else 0.0
            inner_height: f32 = raw_inner_height if raw_inner_height > 0.0 else 0.0
            is_row: bool = widgets[index].axis == UiConst::Axis.Row
            scrolling: bool = widgets[index].kind == UiConst::WidgetKind.Scroll

            children: f32 = child_count(index).f32()
            gaps: f32 = widgets[index].spacing * (children - 1.0) if children > 1.0 else 0.0
            viewport_along: f32 = inner_width if is_row else inner_height
            content_along: f32 = widgets[index].scroll_content_width if is_row else widgets[index].scroll_content_height
            inner_along: f32 = content_along if scrolling and content_along > viewport_along else viewport_along
            if scrolling:
                limit: f32 = content_along - viewport_along if content_along > viewport_along else 0.0
                next_offset: mutable f32 = UiCore::nonnegative_extent(widgets[index].scroll_offset)
                next_offset <- limit if next_offset > limit else next_offset
                widgets[index].scroll_offset <- next_offset

            demand: mutable f32 = 0.0
            weight: mutable f32 = 0.0
            cursor: mutable usize = first
            while cursor != NONE |cursor, demand, weight, is_row|:
                if widgets[cursor].visible:
                    layout_extra[cursor] <- 0.0
                    layout_capped[cursor] <- false
                    demand <- demand + (widgets[cursor].min_width if is_row else widgets[cursor].min_height) + widgets[cursor].margin * 2.0
                    weight <- weight + widgets[cursor].grow
                cursor <- widgets[cursor].next_sibling

            required: f32 = demand + gaps
            scale: f32 = inner_along / required if required > inner_along and required > 0.0 else 1.0
            free: f32 = inner_along - demand - gaps

            # Iterative weighted distribution prevents a capped child from
            # stranding free space that an uncapped sibling could use.
            remaining: mutable f32 = free if free > 0.0 and scale == 1.0 else 0.0
            remaining_weight: mutable f32 = weight
            distributing: mutable bool = remaining > 0.0 and remaining_weight > 0.0
            while distributing |remaining, remaining_weight, distributing, is_row|:
                capped_any: mutable bool = false
                candidate: mutable usize = first
                while candidate != NONE |candidate, remaining, remaining_weight, capped_any, is_row|:
                    child_weight: f32 = widgets[candidate].grow
                    if widgets[candidate].visible and child_weight > 0.0 and not layout_capped[candidate]:
                        maximum: f32 = widgets[candidate].max_width if is_row else widgets[candidate].max_height
                        minimum: f32 = widgets[candidate].min_width if is_row else widgets[candidate].min_height
                        capacity: f32 = maximum - minimum
                        proposed: f32 = remaining * child_weight / remaining_weight
                        if maximum > 0.0 and capacity >= 0.0 and proposed > capacity:
                            layout_extra[candidate] <- capacity
                            layout_capped[candidate] <- true
                            remaining <- remaining - capacity
                            remaining_weight <- remaining_weight - child_weight
                            capped_any <- true
                    candidate <- widgets[candidate].next_sibling
                if not capped_any:
                    candidate <- first
                    while candidate != NONE |candidate, remaining, remaining_weight|:
                        if widgets[candidate].visible and widgets[candidate].grow > 0.0 and not layout_capped[candidate]:
                            layout_extra[candidate] <- remaining * widgets[candidate].grow / remaining_weight
                        candidate <- widgets[candidate].next_sibling
                    distributing <- false
                distributing <- false if remaining <= 0.0 or remaining_weight <= 0.0

            used_growth: mutable f32 = 0.0
            growth_cursor: mutable usize = first
            while growth_cursor != NONE |growth_cursor, used_growth|:
                used_growth <- used_growth + layout_extra[growth_cursor] if widgets[growth_cursor].visible
                growth_cursor <- widgets[growth_cursor].next_sibling
            unused: f32 = free - used_growth if free > used_growth else 0.0
            main_alignment: UiConst::MainAlignment = UiConst::MainAlignment.Start if scrolling else widgets[index].main_alignment
            offset: mutable f32 = 0.0
            offset <- unused * 0.5 if main_alignment == UiConst::MainAlignment.Center
            offset <- unused if main_alignment == UiConst::MainAlignment.End
            gap_extra: f32 = unused / (children - 1.0) if main_alignment == UiConst::MainAlignment.SpaceBetween and children > 1.0 else 0.0
            offset <- -widgets[index].scroll_offset if scrolling
            walk: mutable usize = first
            while walk != NONE |walk, offset, is_row, inner_x, inner_y, inner_width, inner_height, gap_extra|:
                if widgets[walk].visible:
                    margin: f32 = widgets[walk].margin
                    base: f32 = (widgets[walk].min_width if is_row else widgets[walk].min_height) + margin * 2.0
                    outer_extent: f32 = base * scale + layout_extra[walk]
                    extent: f32 = outer_extent - margin * 2.0
                    extent <- 0.0 if extent < 0.0 else extent
                    available_cross: f32 = (inner_height if is_row else inner_width) - margin * 2.0
                    available_cross <- 0.0 if available_cross < 0.0 else available_cross
                    cross_extent: f32 = available_cross
                    cross_offset: f32 = margin
                    alignment: UiConst::CrossAlignment = widgets[walk].cross_alignment
                    minimum_cross: f32 = widgets[walk].min_height if is_row else widgets[walk].min_width
                    maximum_cross: f32 = widgets[walk].max_height if is_row else widgets[walk].max_width
                    cross_extent <- maximum_cross if maximum_cross > 0.0 and maximum_cross >= minimum_cross and cross_extent > maximum_cross else cross_extent
                    if alignment != UiConst::CrossAlignment.Stretch:
                        desired_cross: f32 = minimum_cross
                        cross_extent <- desired_cross if desired_cross < available_cross else available_cross
                        if alignment == UiConst::CrossAlignment.Center:
                            cross_offset <- margin + (available_cross - cross_extent) * 0.5
                        else:
                            if alignment == UiConst::CrossAlignment.End:
                                cross_offset <- margin + available_cross - cross_extent
                    if is_row:
                        arrange(walk, inner_x + offset + margin, inner_y + cross_offset, extent, cross_extent)
                    else:
                        arrange(walk, inner_x + cross_offset, inner_y + offset + margin, cross_extent, extent)
                    offset <- offset + outer_extent + widgets[index].spacing * scale + gap_extra
                else:
                    collapse(walk)
                walk <- widgets[walk].next_sibling

        def contains(index: usize, x: f32, y: f32) -> bool:
            return x >= widgets[index].x and y >= widgets[index].y and x < widgets[index].x + widgets[index].width and y < widgets[index].y + widgets[index].height

        # A translated child remains in the retained tree, but it is not
        # visible or hittable once the pointer leaves any scroll viewport on
        # its ancestor chain. The same shared predicate drives hit testing and
        # semantic visibility; paint() records the geometric half as side-band
        # clip metadata so native painters can enforce it without a backend-
        # specific command payload.
        def inside_scroll_viewports(index: usize, x: f32, y: f32) -> bool:
            cursor: mutable usize = widgets[index].parent
            while cursor < widget_count |cursor, x, y|:
                if widgets[cursor].kind == UiConst::WidgetKind.Scroll:
                    return false if not contains(cursor, x, y)
                cursor <- widgets[cursor].parent
            return true

        def intersects_scroll_viewports(index: usize) -> bool:
            left: f32 = widgets[index].x
            top: f32 = widgets[index].y
            right: f32 = left + widgets[index].width
            bottom: f32 = top + widgets[index].height
            cursor: mutable usize = widgets[index].parent
            while cursor < widget_count |cursor, left, top, right, bottom|:
                if widgets[cursor].kind == UiConst::WidgetKind.Scroll:
                    viewport_left: f32 = widgets[cursor].x
                    viewport_top: f32 = widgets[cursor].y
                    viewport_right: f32 = viewport_left + widgets[cursor].width
                    viewport_bottom: f32 = viewport_top + widgets[cursor].height
                    return false if right <= viewport_left or left >= viewport_right or bottom <= viewport_top or top >= viewport_bottom
                cursor <- widgets[cursor].parent
            return right > left and bottom > top

        # Attach the intersection of every scroll ancestor to commands emitted
        # for this widget. Core keeps this clip beside the command so native
        # painters can apply it without changing their wire payloads.
        def set_scroll_clip(index: usize) -> void:
            UiCore::clear_clip()
            cursor: mutable usize = widgets[index].parent
            left: mutable f32 = 0.0
            top: mutable f32 = 0.0
            right: mutable f32 = 0.0
            bottom: mutable f32 = 0.0
            found: mutable bool = false
            while cursor < widget_count |cursor, left, top, right, bottom, found|:
                if widgets[cursor].kind == UiConst::WidgetKind.Scroll:
                    viewport_left: f32 = widgets[cursor].x
                    viewport_top: f32 = widgets[cursor].y
                    viewport_right: f32 = viewport_left + widgets[cursor].width
                    viewport_bottom: f32 = viewport_top + widgets[cursor].height
                    if not found:
                        left <- viewport_left
                        top <- viewport_top
                        right <- viewport_right
                        bottom <- viewport_bottom
                        found <- true
                    else:
                        left <- viewport_left if viewport_left > left else left
                        top <- viewport_top if viewport_top > top else top
                        right <- viewport_right if viewport_right < right else right
                        bottom <- viewport_bottom if viewport_bottom < bottom else bottom
                cursor <- widgets[cursor].parent
            if found:
                UiCore::set_clip(UiCore::Rect(left, top, right - left, bottom - top))

        def clear_hover() -> void:
            for index in 0..<widget_count:
                widgets[index].hovered <- false

        def release_active_press() -> void:
            if active_widget < widget_count:
                widgets[active_widget].pressed <- false
            active_widget <- NONE
            active_scroll <- NONE
            active_scroll_pointer <- 0.0
            active_scroll_offset <- 0.0
            active_pointer_button <- UiCore::NO_POINTER_BUTTON
            active_key <- -1

        def focus(index: usize) -> void:
            target: mutable usize = index
            target <- NONE if target < widget_count and (not widgets[target].interactive or not effectively_enabled(target) or not effectively_visible(target))
            release_active_press() if target != focused_widget
            if focused_widget < widget_count:
                widgets[focused_widget].focused <- false
            focused_widget <- target
            if focused_widget < widget_count:
                widgets[focused_widget].focused <- true
                restart_caret_blink() if widgets[focused_widget].kind == UiConst::WidgetKind.TextField
                ensure_visible(focused_widget)

        def focus_next() -> void:
            return if widget_count == 0
            next: mutable usize = NONE
            current_order: usize = widgets[focused_widget].focus_order if focused_widget < widget_count else 0
            for candidate in 0..<widget_count:
                eligible: bool = widgets[candidate].interactive and effectively_enabled(candidate) and effectively_visible(candidate)
                follows: bool = focused_widget >= widget_count or widgets[candidate].focus_order > current_order or (widgets[candidate].focus_order == current_order and candidate > focused_widget)
                if eligible and follows:
                    next <- candidate if next >= widget_count or widgets[candidate].focus_order < widgets[next].focus_order or (widgets[candidate].focus_order == widgets[next].focus_order and candidate < next) else next
            if next >= widget_count:
                for candidate in 0..<widget_count:
                    eligible: bool = widgets[candidate].interactive and effectively_enabled(candidate) and effectively_visible(candidate)
                    if eligible:
                        next <- candidate if next >= widget_count or widgets[candidate].focus_order < widgets[next].focus_order or (widgets[candidate].focus_order == widgets[next].focus_order and candidate < next) else next
            focus(next) if next < widget_count

        def focus_previous() -> void:
            return if widget_count == 0
            previous: mutable usize = NONE
            current_order: usize = widgets[focused_widget].focus_order if focused_widget < widget_count else 0
            for candidate in 0..<widget_count:
                eligible: bool = widgets[candidate].interactive and effectively_enabled(candidate) and effectively_visible(candidate)
                precedes: bool = focused_widget < widget_count and (widgets[candidate].focus_order < current_order or (widgets[candidate].focus_order == current_order and candidate < focused_widget))
                if eligible and precedes:
                    previous <- candidate if previous >= widget_count or widgets[candidate].focus_order > widgets[previous].focus_order or (widgets[candidate].focus_order == widgets[previous].focus_order and candidate > previous) else previous
            if previous >= widget_count:
                for candidate in 0..<widget_count:
                    eligible: bool = widgets[candidate].interactive and effectively_enabled(candidate) and effectively_visible(candidate)
                    if eligible:
                        previous <- candidate if previous >= widget_count or widgets[candidate].focus_order > widgets[previous].focus_order or (widgets[candidate].focus_order == widgets[previous].focus_order and candidate > previous) else previous
            focus(previous) if previous < widget_count

        def color_of(index: usize) -> UiCore::Color:
            if not effectively_enabled(index):
                return muted_color(widgets[index].color)
            return widgets[index].press_color if widgets[index].pressed
            return widgets[index].hover_color if widgets[index].hovered
            return widgets[index].color

        def muted_color(base: UiCore::Color) -> UiCore::Color:
            return UiCore::Color{r: base.r / 2, g: base.g / 2, b: base.b / 2, a: base.a}

        # Keyboard focus must never disappear into a translated viewport. The
        # child frame already contains the current offset, so recover its
        # unscrolled edge and request the smallest offset that reveals it.
        def ensure_visible(index: usize) -> void:
            cursor: mutable usize = widgets[index].parent
            while cursor < widget_count |cursor, index|:
                if widgets[cursor].kind == UiConst::WidgetKind.Scroll:
                    current: f32 = widgets[cursor].scroll_offset
                    requested: mutable f32 = current
                    if widgets[cursor].axis == UiConst::Axis.Row:
                        viewport_start: f32 = widgets[cursor].x
                        viewport_end: f32 = viewport_start + widgets[cursor].width
                        child_start: f32 = widgets[index].x
                        child_end: f32 = child_start + widgets[index].width
                        unscrolled_start: f32 = child_start + current
                        unscrolled_end: f32 = child_end + current
                        requested <- unscrolled_start - viewport_start if child_start < viewport_start
                        requested <- unscrolled_end - viewport_end if child_end > viewport_end and child_start >= viewport_start
                    else:
                        viewport_start: f32 = widgets[cursor].y
                        viewport_end: f32 = viewport_start + widgets[cursor].height
                        child_start: f32 = widgets[index].y
                        child_end: f32 = child_start + widgets[index].height
                        unscrolled_start: f32 = child_start + current
                        unscrolled_end: f32 = child_end + current
                        requested <- unscrolled_start - viewport_start if child_start < viewport_start
                        requested <- unscrolled_end - viewport_end if child_end > viewport_end and child_start >= viewport_start
                    _ = set_scroll_offset(cursor, requested)
                cursor <- widgets[cursor].parent

        def emit_accessibility(index: usize) -> void:
            enabled: bool = effectively_enabled(index)
            frame: UiCore::Rect = UiCore::Rect(widgets[index].x, widgets[index].y, widgets[index].width, widgets[index].height)
            if widgets[index].kind == UiConst::WidgetKind.Button:
                UiCore::accessibility(UiCore::AccessibilityRole.Button, widgets[index].text, widgets[index].help, frame, index, index, enabled, widgets[index].focused, false, 0.0, "", "", 0, 0, 0)
            elif widgets[index].kind == UiConst::WidgetKind.RadioButton:
                UiCore::accessibility(UiCore::AccessibilityRole.RadioButton, widgets[index].text, widgets[index].help, frame, index, index, enabled, widgets[index].focused, widgets[index].selected, 0.0, "", "", 0, 0, 0)
            elif widgets[index].kind == UiConst::WidgetKind.CheckBox:
                UiCore::accessibility(UiCore::AccessibilityRole.CheckBox, widgets[index].text, widgets[index].help, frame, index, index, enabled, widgets[index].focused, widgets[index].selected, 0.0, "", "", 0, 0, 0)
            elif widgets[index].kind == UiConst::WidgetKind.Slider:
                UiCore::accessibility(UiCore::AccessibilityRole.Slider, widgets[index].text, widgets[index].help, frame, index, index, enabled, widgets[index].focused, false, widgets[index].value, "", "", 0, 0, 0)
            elif widgets[index].kind == UiConst::WidgetKind.ProgressBar:
                UiCore::accessibility(UiCore::AccessibilityRole.ProgressBar, widgets[index].text, widgets[index].help, frame, index, NONE, enabled, false, false, widgets[index].value, "", "", 0, 0, 0)
            elif widgets[index].kind == UiConst::WidgetKind.TextField:
                semantic_role: UiCore::AccessibilityRole = UiCore::AccessibilityRole.PasswordField if widgets[index].secure else UiCore::AccessibilityRole.TextField
                semantic_value: sview = secure_display_value(index) if widgets[index].secure else text_value(index)
                UiCore::accessibility(semantic_role, widgets[index].text, widgets[index].help, frame, index, index, enabled, widgets[index].focused, false, 0.0, semantic_value, selected_text_value(index), widgets[index].text_revision, selection_utf16_location(index), selection_utf16_length(index))
            elif widgets[index].kind == UiConst::WidgetKind.Label:
                UiCore::accessibility(UiCore::AccessibilityRole.Label, widgets[index].text, widgets[index].help, frame, index, NONE, enabled, false, false, 0.0, "", "", 0, 0, 0)

        def update_slider(index: usize, pointer_x: f32) -> void:
            return if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.Slider
            inset: f32 = clamped_inset(current_theme.slider_horizontal_inset, widgets[index].width)
            travel: f32 = widgets[index].width - inset * 2.0
            return if travel <= 0.0
            next: mutable f32 = (pointer_x - widgets[index].x - inset) / travel
            before: f32 = widgets[index].value
            set_value(index, next)
            return if widgets[index].value == before
            app_widget_event(index, UiConst::WidgetEvent.Change.i32())

        def dispatch_activation(index: usize) -> void:
            return if index >= widget_count
            if widgets[index].kind == UiConst::WidgetKind.CheckBox:
                set_selected(index, not widgets[index].selected)
            elif widgets[index].kind == UiConst::WidgetKind.RadioButton:
                set_selected(index, true)
            app_widget_event(index, UiConst::WidgetEvent.Click.i32())

        def is_utf8_continuation(byte: u8) -> bool:
            return (byte.u32() & 192) == 128

        def utf8_scalar_bytes(text: sview, position: usize) -> usize:
            return 0 if position >= text.len
            byte: u32 = text.data[position].u32()
            return 1 if byte < 128
            return 2 if byte < 224 and position + 1 < text.len
            return 3 if byte < 240 and position + 2 < text.len
            return 4 if byte < 248 and position + 3 < text.len
            return 1

        def utf8_scalar_value(text: sview, position: usize) -> u32:
            return 0 if position >= text.len
            first: u32 = text.data[position].u32()
            bytes: usize = utf8_scalar_bytes(text, position)
            return first if bytes == 1
            second: u32 = text.data[position + 1].u32() & 63
            return ((first & 31) << 6) | second if bytes == 2
            third: u32 = text.data[position + 2].u32() & 63
            return ((first & 15) << 12) | (second << 6) | third if bytes == 3
            fourth: u32 = text.data[position + 3].u32() & 63
            return ((first & 7) << 18) | (second << 12) | (third << 6) | fourth

        # Return the longest well-formed UTF-8 prefix that fits byte_limit.
        # Invalid, overlong, surrogate and out-of-range sequences terminate the
        # prefix, keeping stored values safe for painters and native strings.
        def valid_utf8_prefix(text: sview, byte_limit: usize) -> usize:
            limit: usize = byte_limit if byte_limit < text.len else text.len
            cursor: mutable usize = 0
            while cursor < limit |cursor, limit|:
                first: u32 = text.data[cursor].u32()
                if first <= 127:
                    cursor <- cursor + 1
                    continue
                if first >= 194 and first <= 223:
                    return cursor if cursor + 1 >= limit or not is_utf8_continuation(text.data[cursor + 1])
                    cursor <- cursor + 2
                    continue
                if first >= 224 and first <= 239:
                    return cursor if cursor + 2 >= limit
                    second: u32 = text.data[cursor + 1].u32()
                    return cursor if not is_utf8_continuation(text.data[cursor + 1]) or not is_utf8_continuation(text.data[cursor + 2])
                    return cursor if first == 224 and second < 160
                    return cursor if first == 237 and second > 159
                    cursor <- cursor + 3
                    continue
                if first >= 240 and first <= 244:
                    return cursor if cursor + 3 >= limit
                    second: u32 = text.data[cursor + 1].u32()
                    return cursor if not is_utf8_continuation(text.data[cursor + 1]) or not is_utf8_continuation(text.data[cursor + 2]) or not is_utf8_continuation(text.data[cursor + 3])
                    return cursor if first == 240 and second < 144
                    return cursor if first == 244 and second > 143
                    cursor <- cursor + 4
                    continue
                return cursor
            return cursor

        # The ranges that most often extend a user-perceived character: Unicode
        # combining marks, variation selectors, emoji skin tones and emoji tag
        # characters. ZWJ and regional-indicator pairing are handled separately.
        def extends_grapheme(scalar: u32) -> bool:
            return true if scalar >= 768 and scalar <= 879
            return true if scalar >= 6832 and scalar <= 6911
            return true if scalar >= 7616 and scalar <= 7679
            return true if scalar >= 8400 and scalar <= 8447
            return true if scalar >= 65024 and scalar <= 65039
            return true if scalar >= 127995 and scalar <= 127999
            return true if scalar >= 917536 and scalar <= 917631
            return scalar >= 65056 and scalar <= 65071

        def regional_indicator(scalar: u32) -> bool:
            return scalar >= 127462 and scalar <= 127487

        def next_grapheme(text: sview, position: usize) -> usize:
            return text.len if position >= text.len
            first: u32 = utf8_scalar_value(text, position)
            cursor: mutable usize = position + utf8_scalar_bytes(text, position)
            if first == 13 and cursor < text.len and utf8_scalar_value(text, cursor) == 10:
                return cursor + 1
            if regional_indicator(first) and cursor < text.len and regional_indicator(utf8_scalar_value(text, cursor)):
                cursor <- cursor + utf8_scalar_bytes(text, cursor)
            while cursor < text.len |cursor|:
                scalar: u32 = utf8_scalar_value(text, cursor)
                if extends_grapheme(scalar):
                    cursor <- cursor + utf8_scalar_bytes(text, cursor)
                elif scalar == 8205:
                    cursor <- cursor + utf8_scalar_bytes(text, cursor)
                    cursor <- cursor + utf8_scalar_bytes(text, cursor) if cursor < text.len
                else:
                    break
            return cursor

        def grapheme_prefix_length(text: sview, byte_limit: usize) -> usize:
            limit: usize = byte_limit if byte_limit < text.len else text.len
            cursor: mutable usize = 0
            while cursor < limit |cursor, limit|:
                after: usize = next_grapheme(text, cursor)
                return cursor if after > limit
                cursor <- after
            return cursor

        def utf16_units_for_prefix(text: sview, byte_stop: usize) -> usize:
            stop: usize = byte_stop if byte_stop < text.len else text.len
            cursor: mutable usize = 0
            units: mutable usize = 0
            while cursor < stop |cursor, units, stop|:
                scalar_bytes: usize = utf8_scalar_bytes(text, cursor)
                units <- units + (2 if scalar_bytes == 4 else 1)
                cursor <- cursor + scalar_bytes
            return units

        def byte_offset_for_utf16(text: sview, unit_stop: usize) -> usize:
            cursor: mutable usize = 0
            units: mutable usize = 0
            while cursor < text.len |cursor, units, unit_stop|:
                scalar_bytes: usize = utf8_scalar_bytes(text, cursor)
                scalar_units: usize = 2 if scalar_bytes == 4 else 1
                return cursor if units + scalar_units > unit_stop
                units <- units + scalar_units
                cursor <- cursor + scalar_bytes
                return cursor if units == unit_stop
            return text.len

        def previous_character(index: usize, position: usize) -> usize:
            return 0 if position == 0
            cursor: mutable usize = 0
            previous: mutable usize = 0
            while cursor < position |cursor, previous, position|:
                previous <- cursor
                after: usize = next_character(index, cursor)
                return previous if after >= position
                cursor <- after
            return previous

        def next_character(index: usize, position: usize) -> usize:
            value: sview = text_value(index)
            return next_grapheme(value, position)

        def grapheme_boundary_at_or_before(index: usize, position: usize) -> usize:
            cursor: mutable usize = 0
            while cursor < position |cursor, position|:
                after: usize = next_character(index, cursor)
                return cursor if after > position
                cursor <- after
            return cursor

        def secure_display_offset(index: usize, byte_position: usize) -> usize:
            cursor: mutable usize = 0
            output: mutable usize = 0
            stop: usize = byte_position if byte_position < widgets[index].input_length else widgets[index].input_length
            while cursor < stop |cursor, output, stop|:
                cursor <- next_character(index, cursor)
                output <- output + 3
            return output

        def secure_display_value(index: usize) -> sview:
            output_base: usize = index * SECURE_TEXT_CAPACITY
            cursor: mutable usize = 0
            output: mutable usize = 0
            while cursor < widgets[index].input_length |cursor, output, output_base|:
                # U+2022 BULLET in UTF-8. The mask reveals scalar count but
                # never the original bytes or grapheme widths.
                secure_text_storage[output_base + output] <- 226
                secure_text_storage[output_base + output + 1] <- 128
                secure_text_storage[output_base + output + 2] <- 162
                output <- output + 3
                cursor <- next_character(index, cursor)
            return sview(&secure_text_storage[output_base], 0, output.i64())

        def display_range(index: usize, start: usize, stop: usize) -> sview:
            value: sview = text_value(index)
            return sview(value.data + start, 0, (stop - start).i64()) if not widgets[index].secure
            masked: sview = secure_display_value(index)
            masked_start: usize = secure_display_offset(index, start)
            masked_stop: usize = secure_display_offset(index, stop)
            return sview(masked.data + masked_start, 0, (masked_stop - masked_start).i64())

        def measure_text_range(index: usize, start: usize, stop: usize) -> f32:
            return ui_measure_text_width(display_range(index, start, stop), widgets[index].text_size)

        # Word navigation is intentionally Unicode-safe without pretending to
        # implement locale-specific tokenization: ASCII letters, digits and
        # underscore form words, while every non-ASCII scalar stays intact and
        # participates as a word character.
        def is_word_character(index: usize, position: usize) -> bool:
            return false if position >= widgets[index].input_length
            byte: u32 = text_storage[index * TEXT_CAPACITY + position].u32()
            return true if byte >= 128
            return true if byte >= 48 and byte <= 57
            return true if byte >= 65 and byte <= 90
            return true if byte >= 97 and byte <= 122
            return byte == 95

        def previous_word(index: usize, position: usize) -> usize:
            return 0 if position == 0
            cursor: mutable usize = previous_character(index, position)
            while cursor > 0 and not is_word_character(index, cursor) |cursor|:
                cursor <- previous_character(index, cursor)
            while cursor > 0 |cursor|:
                before: usize = previous_character(index, cursor)
                return cursor if not is_word_character(index, before)
                cursor <- before
            return 0

        def next_word(index: usize, position: usize) -> usize:
            length: usize = widgets[index].input_length
            cursor: mutable usize = position if position < length else length
            while cursor < length and not is_word_character(index, cursor) |cursor, length|:
                cursor <- next_character(index, cursor)
            while cursor < length and is_word_character(index, cursor) |cursor, length|:
                cursor <- next_character(index, cursor)
            return cursor

        def visible_text_start(index: usize, available_width: f32) -> usize:
            visible_start: mutable usize = 0
            return visible_start if widgets[index].caret == 0
            while visible_start < widgets[index].caret |visible_start, available_width|:
                return visible_start if measure_text_range(index, visible_start, widgets[index].caret) <= available_width
                visible_start <- next_character(index, visible_start)
            return visible_start

        def caret_from_pointer(index: usize, pointer_x: f32) -> usize:
            inset: f32 = clamped_inset(current_theme.text_horizontal_padding, widgets[index].width)
            local_x: f32 = pointer_x - widgets[index].x - inset
            available_width: mutable f32 = widgets[index].width - inset * 2.0
            available_width <- 0.0 if available_width < 0.0 else available_width
            visible_start: usize = visible_text_start(index, available_width)
            return visible_start if local_x <= 0.0 or widgets[index].input_length == 0
            cursor: mutable usize = visible_start
            previous_width: mutable f32 = 0.0
            while cursor < widgets[index].input_length |cursor, previous_width, local_x|:
                after: usize = next_character(index, cursor)
                width: f32 = measure_text_range(index, visible_start, after)
                return cursor if local_x < (previous_width + width) * 0.5
                previous_width <- width
                cursor <- after
            return widgets[index].input_length

        def clear_history_slot(slot: usize) -> void:
            offset: usize = slot * TEXT_CAPACITY
            for byte_index in 0..<TEXT_CAPACITY:
                history_before_text[offset + byte_index] <- 0
                history_after_text[offset + byte_index] <- 0
            history_before_length[slot] <- 0
            history_after_length[slot] <- 0
            history_before_caret[slot] <- 0
            history_after_caret[slot] <- 0
            history_before_anchor[slot] <- 0
            history_after_anchor[slot] <- 0
            history_before_marked_start[slot] <- 0
            history_before_marked_end[slot] <- 0
            history_after_marked_start[slot] <- 0
            history_after_marked_end[slot] <- 0

        def copy_history_slot(source: usize, target: usize) -> void:
            history_widget[target] <- history_widget[source]
            history_before_length[target] <- history_before_length[source]
            history_after_length[target] <- history_after_length[source]
            history_before_caret[target] <- history_before_caret[source]
            history_after_caret[target] <- history_after_caret[source]
            history_before_anchor[target] <- history_before_anchor[source]
            history_after_anchor[target] <- history_after_anchor[source]
            history_before_marked_start[target] <- history_before_marked_start[source]
            history_before_marked_end[target] <- history_before_marked_end[source]
            history_after_marked_start[target] <- history_after_marked_start[source]
            history_after_marked_end[target] <- history_after_marked_end[source]
            source_offset: usize = source * TEXT_CAPACITY
            target_offset: usize = target * TEXT_CAPACITY
            for byte_index in 0..<TEXT_CAPACITY:
                history_before_text[target_offset + byte_index] <- history_before_text[source_offset + byte_index]
                history_after_text[target_offset + byte_index] <- history_after_text[source_offset + byte_index]

        def store_history_state(slot: usize, index: usize, after: bool) -> void:
            source_offset: usize = index * TEXT_CAPACITY
            target_offset: usize = slot * TEXT_CAPACITY
            for byte_index in 0..<TEXT_CAPACITY:
                if after:
                    history_after_text[target_offset + byte_index] <- 0
                else:
                    history_before_text[target_offset + byte_index] <- 0
            for byte_index in 0..<widgets[index].input_length:
                if after:
                    history_after_text[target_offset + byte_index] <- text_storage[source_offset + byte_index]
                else:
                    history_before_text[target_offset + byte_index] <- text_storage[source_offset + byte_index]
            if after:
                history_after_length[slot] <- widgets[index].input_length
                history_after_caret[slot] <- widgets[index].caret
                history_after_anchor[slot] <- widgets[index].selection_anchor
                history_after_marked_start[slot] <- widgets[index].marked_start
                history_after_marked_end[slot] <- widgets[index].marked_end
            else:
                history_before_length[slot] <- widgets[index].input_length
                history_before_caret[slot] <- widgets[index].caret
                history_before_anchor[slot] <- widgets[index].selection_anchor
                history_before_marked_start[slot] <- widgets[index].marked_start
                history_before_marked_end[slot] <- widgets[index].marked_end

        def history_text_changed(slot: usize) -> bool:
            return true if history_before_length[slot] != history_after_length[slot]
            offset: usize = slot * TEXT_CAPACITY
            for byte_index in 0..<history_before_length[slot]:
                return true if history_before_text[offset + byte_index] != history_after_text[offset + byte_index]
            return false

        def begin_text_history(index: usize) -> usize:
            return TEXT_HISTORY_CAPACITY if history_suppressed or history_active
            discarded_count: usize = history_count
            history_count <- history_cursor
            for discarded in history_count..<discarded_count:
                clear_history_slot(discarded)
            if history_count == TEXT_HISTORY_CAPACITY:
                for slot in 1..<TEXT_HISTORY_CAPACITY:
                    copy_history_slot(slot, slot - 1)
                history_count <- TEXT_HISTORY_CAPACITY - 1
                history_cursor <- history_count
            slot: usize = history_count
            clear_history_slot(slot)
            history_widget[slot] <- index
            store_history_state(slot, index, false)
            history_active <- true
            composition_history_slot <- TEXT_HISTORY_CAPACITY
            return slot

        def finish_text_history(slot: usize, index: usize) -> void:
            return if slot >= TEXT_HISTORY_CAPACITY
            store_history_state(slot, index, true)
            if history_text_changed(slot):
                history_count <- slot + 1
                history_cursor <- history_count
            else:
                clear_history_slot(slot)
            history_active <- false

        def restore_history_state(slot: usize, after: bool) -> void:
            index: usize = history_widget[slot]
            return if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.TextField
            length: usize = history_after_length[slot] if after else history_before_length[slot]
            source_offset: usize = slot * TEXT_CAPACITY
            target_offset: usize = index * TEXT_CAPACITY
            for byte_index in 0..<TEXT_CAPACITY:
                text_storage[target_offset + byte_index] <- 0
            for byte_index in 0..<length:
                text_storage[target_offset + byte_index] <- history_after_text[source_offset + byte_index] if after else history_before_text[source_offset + byte_index]
            if after:
                widgets[index] with {
                    input_length <- length, caret <- history_after_caret[slot], selection_anchor <- history_after_anchor[slot],
                    marked_start <- history_after_marked_start[slot], marked_end <- history_after_marked_end[slot],
                }
            else:
                widgets[index] with {
                    input_length <- length, caret <- history_before_caret[slot], selection_anchor <- history_before_anchor[slot],
                    marked_start <- history_before_marked_start[slot], marked_end <- history_before_marked_end[slot],
                }
            widgets[index].text_revision <- widgets[index].text_revision + 1
            widgets[index].text_truncated <- false
            focus(index)
            app_widget_event(index, UiConst::WidgetEvent.Change.i32())

        def remove_text(index: usize, start: usize, stop: usize) -> void:
            return if stop <= start or stop > widgets[index].input_length
            widgets[index].text_truncated <- false
            history_slot: usize = begin_text_history(index)
            offset: usize = index * TEXT_CAPACITY
            old_length: usize = widgets[index].input_length
            removed: usize = stop - start
            cursor: mutable usize = stop
            while cursor < widgets[index].input_length |cursor, offset, removed|:
                text_storage[offset + cursor - removed] <- text_storage[offset + cursor]
                cursor <- cursor + 1
            widgets[index].input_length <- widgets[index].input_length - removed
            for byte_index in widgets[index].input_length..<old_length:
                text_storage[offset + byte_index] <- 0
            widgets[index].text_revision <- widgets[index].text_revision + 1
            widgets[index].caret <- start
            widgets[index].selection_anchor <- start
            widgets[index] with { marked_start <- 0, marked_end <- 0 }
            restart_caret_blink() if index == focused_widget
            app_widget_event(index, UiConst::WidgetEvent.Change.i32())
            finish_text_history(history_slot, index)

    public:
        def layout(width: f32, height: f32) -> void:
            last_layout_width <- UiCore::nonnegative_extent(width)
            last_layout_height <- UiCore::nonnegative_extent(height)
            layout_initialized <- true
            layout_dirty <- false
            return if widget_count == 0
            measure(0)
            arrange(0, 0.0, 0.0, last_layout_width, last_layout_height)

        # Geometry consumers share paint's deferred retained reflow. Keeping
        # this in Elisa means a mutation followed immediately by hit testing
        # or scrolling cannot observe stale frames.
        def ensure_layout() -> void:
            layout(last_layout_width, last_layout_height) if layout_initialized and layout_dirty

        # Scroll geometry is retained in the flat widget row, not in a host
        # object. Setters clamp in Elisa and optionally reflow the remembered
        # viewport so all backends observe the same translated child frames.
        def scroll_offset(index: usize) -> f32:
            return 0.0 if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.Scroll
            return widgets[index].scroll_offset

        def scroll_dragging() -> bool:
            return active_scroll < widget_count

        def scroll_limit(index: usize) -> f32:
            ensure_layout()
            return 0.0 if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.Scroll
            viewport: f32 = widgets[index].width if widgets[index].axis == UiConst::Axis.Row else widgets[index].height
            content: f32 = widgets[index].scroll_content_width if widgets[index].axis == UiConst::Axis.Row else widgets[index].scroll_content_height
            return content - viewport if content > viewport else 0.0

        def set_scroll_offset(index: usize, requested: f32) -> bool:
            ensure_layout()
            return false if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.Scroll
            wanted: mutable f32 = UiCore::nonnegative_extent(UiCore::finite_or_zero(requested))
            limit: f32 = scroll_limit(index)
            wanted <- limit if wanted > limit else wanted
            current: f32 = widgets[index].scroll_offset
            difference: f32 = wanted - current if wanted >= current else current - wanted
            return false if difference < 0.0001
            widgets[index].scroll_offset <- wanted
            layout(last_layout_width, last_layout_height) if layout_initialized
            return true

        # Window deactivation, modal interruption and capture loss must not
        # leave a control visually held or a modifier latched.
        def cancel_interaction() -> void:
            release_active_press()
            hot_widget <- NONE
            pointer_inside <- false
            left_shift_down <- false
            right_shift_down <- false
            left_control_down <- false
            right_control_down <- false
            left_super_down <- false
            right_super_down <- false
            clear_hover()

        # Portable window lifecycle handling. Backends report focus changes as
        # UiCore events; the widget layer owns the state that must be released
        # when the application can no longer receive the matching key/mouse-up.
        def lifecycle(event: UiCore::Event) -> void:
            match event:
                UiCore::Event.FocusLost:
                    cancel_interaction()
                _:
                    pass

        def accepts_text() -> bool:
            return focused_widget < widget_count and widgets[focused_widget].kind == UiConst::WidgetKind.TextField and effectively_enabled(focused_widget) and effectively_visible(focused_widget)

        # Accessibility and native text adapters may target a specific field,
        # not only the focused one. Keep the same kind/enabled/visible policy
        # used by replace_text in one query so a host can ask for permission
        # before mirroring a mutation into its native object.
        def text_editable(index: usize) -> bool:
            return index < widget_count and widgets[index].kind == UiConst::WidgetKind.TextField and effectively_enabled(index) and effectively_visible(index)

        def allows_text_readback() -> bool:
            return accepts_text() and not widgets[focused_widget].secure

        def selection_start(index: usize) -> usize:
            return 0 if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.TextField
            return widgets[index].selection_anchor if widgets[index].selection_anchor < widgets[index].caret else widgets[index].caret

        def selection_end(index: usize) -> usize:
            return 0 if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.TextField
            return widgets[index].caret if widgets[index].caret > widgets[index].selection_anchor else widgets[index].selection_anchor

        def selected_text_pointer(index: usize) -> u8&:
            return &text_storage[0] if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.TextField
            return &text_storage[index * TEXT_CAPACITY + selection_start(index)]

        def selected_text_length(index: usize) -> usize:
            return 0 if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.TextField or widgets[index].secure
            return selection_end(index) - selection_start(index)

        def selected_text_value(index: usize) -> sview:
            length: usize = selected_text_length(index)
            return "" if length == 0
            return sview(&text_storage[index * TEXT_CAPACITY + selection_start(index)], 0, length.i64())

        def selection_utf16_location(index: usize) -> usize:
            return 0 if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.TextField
            return utf16_units_for_prefix(text_value(index), selection_start(index))

        def selection_utf16_length(index: usize) -> usize:
            return 0 if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.TextField
            return utf16_units_for_prefix(text_value(index), selection_end(index)) - selection_utf16_location(index)

        def text_utf16_offset(index: usize, byte_offset: usize) -> usize:
            return 0 if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.TextField
            return utf16_units_for_prefix(text_value(index), byte_offset)

        def text_utf16_length(index: usize) -> usize:
            return 0 if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.TextField
            value: sview = text_value(index)
            return utf16_units_for_prefix(value, value.len)

        def text_range_location(index: usize, requested_location: usize) -> usize:
            total: usize = text_utf16_length(index)
            return requested_location if requested_location < total else total

        def text_range_length(index: usize, requested_location: usize, requested_length: usize) -> usize:
            location: usize = text_range_location(index, requested_location)
            remaining: usize = text_utf16_length(index) - location
            return requested_length if requested_length < remaining else remaining

        def text_range_pointer(index: usize, location: usize) -> u8&:
            return &text_storage[0] if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.TextField
            byte_start: usize = byte_offset_for_utf16(text_value(index), text_range_location(index, location))
            return &text_storage[index * TEXT_CAPACITY + byte_start]

        def text_range_byte_length(index: usize, location: usize, length: usize) -> usize:
            return 0 if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.TextField
            value: sview = text_value(index)
            safe_location: usize = text_range_location(index, location)
            safe_length: usize = text_range_length(index, location, length)
            start: usize = byte_offset_for_utf16(value, safe_location)
            stop: usize = byte_offset_for_utf16(value, safe_location + safe_length)
            return stop - start

        # Selection positions are UTF-8 byte offsets. Platform adapters convert
        # from their native indexing convention and only pass scalar boundaries.
        def set_selection(index: usize, anchor: usize, caret: usize) -> void:
            return if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.TextField
            length: usize = widgets[index].input_length
            next_anchor: mutable usize = anchor if anchor < length else length
            next_caret: mutable usize = caret if caret < length else length
            offset: usize = index * TEXT_CAPACITY
            while next_anchor > 0 and next_anchor < length and is_utf8_continuation(text_storage[offset + next_anchor]) |next_anchor, offset, length|:
                next_anchor <- next_anchor - 1
            while next_caret > 0 and next_caret < length and is_utf8_continuation(text_storage[offset + next_caret]) |next_caret, offset, length|:
                next_caret <- next_caret - 1
            next_anchor <- grapheme_boundary_at_or_before(index, next_anchor)
            next_caret <- grapheme_boundary_at_or_before(index, next_caret)
            widgets[index] with { selection_anchor <- next_anchor, caret <- next_caret }
            restart_caret_blink() if index == focused_widget

        def set_selection_utf16(index: usize, location: usize, length: usize) -> void:
            return if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.TextField
            value: sview = text_value(index)
            total_units: usize = utf16_units_for_prefix(value, value.len)
            safe_location: usize = location if location < total_units else total_units
            remaining_units: usize = total_units - safe_location
            safe_length: usize = length if length < remaining_units else remaining_units
            start: usize = byte_offset_for_utf16(value, safe_location)
            stop: usize = byte_offset_for_utf16(value, safe_location + safe_length)
            set_selection(index, start, stop)

        def set_marked(index: usize, start: usize, stop: usize) -> void:
            return if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.TextField
            length: usize = widgets[index].input_length
            widgets[index].marked_start <- start if start < length else length
            widgets[index].marked_end <- stop if stop < length else length
            if widgets[index].marked_end < widgets[index].marked_start:
                swap: usize = widgets[index].marked_start
                widgets[index].marked_start <- widgets[index].marked_end
                widgets[index].marked_end <- swap

        def marked_utf16_location(index: usize) -> usize:
            return 0 if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.TextField
            return utf16_units_for_prefix(text_value(index), widgets[index].marked_start)

        def marked_utf16_length(index: usize) -> usize:
            return 0 if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.TextField
            return utf16_units_for_prefix(text_value(index), widgets[index].marked_end) - marked_utf16_location(index)

        def text_caret_x(index: usize) -> f32:
            return 0.0 if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.TextField
            inset: f32 = clamped_inset(current_theme.text_horizontal_padding, widgets[index].width)
            available_width: mutable f32 = widgets[index].width - inset * 2.0
            available_width <- 0.0 if available_width < 0.0 else available_width
            visible_start: usize = visible_text_start(index, available_width)
            return widgets[index].x + inset + measure_text_range(index, visible_start, widgets[index].caret)

        def text_character_x(index: usize, utf16_location: usize) -> f32:
            return 0.0 if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.TextField
            inset: f32 = clamped_inset(current_theme.text_horizontal_padding, widgets[index].width)
            available_width: mutable f32 = widgets[index].width - inset * 2.0
            available_width <- 0.0 if available_width < 0.0 else available_width
            visible_start: usize = visible_text_start(index, available_width)
            position: mutable usize = byte_offset_for_utf16(text_value(index), text_range_location(index, utf16_location))
            position <- visible_start if position < visible_start else position
            width: mutable f32 = measure_text_range(index, visible_start, position)
            width <- available_width if width > available_width else width
            return widgets[index].x + inset + width

        def text_caret_y(index: usize) -> f32:
            return 0.0 if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.TextField
            inset: f32 = clamped_inset(current_theme.text_vertical_padding, widgets[index].height)
            return widgets[index].y + inset

        def text_caret_height(index: usize) -> f32:
            return 0.0 if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.TextField
            inset: f32 = clamped_inset(current_theme.text_vertical_padding, widgets[index].height)
            inner: f32 = widgets[index].height - inset * 2.0
            return inner if inner > 0.0 else 0.0

        def text_position_at(index: usize, x: f32) -> usize:
            return 0 if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.TextField
            return caret_from_pointer(index, x)

        # Desktop-native multi-click behavior without exposing byte indexing to
        # the host. Double-click selects the word or separator run under the
        # pointer; triple-click selects the complete single-line field.
        def select_text_at(x: f32, click_count: i32) -> void:
            return if click_count < 2 or not accepts_text()
            index: usize = focused_widget
            if click_count >= 3:
                set_selection(index, 0, widgets[index].input_length)
                return
            length: usize = widgets[index].input_length
            if length == 0:
                set_selection(index, 0, 0)
                return
            position: mutable usize = caret_from_pointer(index, x)
            position <- previous_character(index, position) if position == length
            word: bool = is_word_character(index, position)
            start: mutable usize = position
            while start > 0 |start, word|:
                before: usize = previous_character(index, start)
                break if is_word_character(index, before) != word
                start <- before
            stop: mutable usize = next_character(index, position)
            while stop < length and is_word_character(index, stop) == word |stop, length, word|:
                stop <- next_character(index, stop)
            set_selection(index, start, stop)

        # Platform adapters should use this raw-click entry point. Keeping the
        # primary-button rule beside the editing engine prevents each native
        # host from developing subtly different selection behavior.
        def select_text_click_at(x: f32, button: i32, click_count: i32) -> void:
            return if button != UiCore::PointerButton.Primary.i32()
            select_text_at(x, click_count)

        # Native adapters that also report pointer coordinates should use this
        # guarded entry point. A scrollbar press must not be interpreted as a
        # multi-click in whichever text field happened to retain focus.
        def select_text_click_at_pointer(x: f32, y: f32, button: i32, click_count: i32) -> void:
            return if button != UiCore::PointerButton.Primary.i32()
            target: usize = hit(x, y)
            return if target >= widget_count or widgets[target].kind != UiConst::WidgetKind.TextField
            return if scrollbar_target(x, y) != NONE
            select_text_at(x, click_count)

        def move_word_left(extend_selection: bool) -> void:
            return if not accepts_text()
            index: usize = focused_widget
            if not extend_selection and selection_start(index) != selection_end(index):
                widgets[index].caret <- selection_start(index)
            else:
                widgets[index].caret <- previous_word(index, widgets[index].caret)
            widgets[index].selection_anchor <- widgets[index].caret if not extend_selection
            restart_caret_blink()

        def move_word_right(extend_selection: bool) -> void:
            return if not accepts_text()
            index: usize = focused_widget
            if not extend_selection and selection_start(index) != selection_end(index):
                widgets[index].caret <- selection_end(index)
            else:
                widgets[index].caret <- next_word(index, widgets[index].caret)
            widgets[index].selection_anchor <- widgets[index].caret if not extend_selection
            restart_caret_blink()

        def delete_word_backward() -> void:
            return if not accepts_text()
            index: usize = focused_widget
            if selection_start(index) != selection_end(index):
                remove_text(index, selection_start(index), selection_end(index))
                return
            remove_text(index, previous_word(index, widgets[index].caret), widgets[index].caret)

        def delete_word_forward() -> void:
            return if not accepts_text()
            index: usize = focused_widget
            if selection_start(index) != selection_end(index):
                remove_text(index, selection_start(index), selection_end(index))
                return
            remove_text(index, widgets[index].caret, next_word(index, widgets[index].caret))

        # Insert committed UTF-8 at the focused field's caret. The AppKit text
        # input manager calls this with whole composed strings, never key codes.
        def insert_text(text: sview) -> void:
            return if not accepts_text()
            index: usize = focused_widget
            widgets[index].text_truncated <- false
            start: usize = selection_start(index)
            stop: usize = selection_end(index)
            if text.len == 0:
                remove_text(index, start, stop)
                return
            removed: usize = stop - start
            remaining: usize = widgets[index].input_length - removed
            available: usize = TEXT_CAPACITY - 1 - remaining
            byte_limit: usize = text.len if text.len < available else available
            take: usize = grapheme_prefix_length(text, valid_utf8_prefix(text, byte_limit))
            widgets[index].text_truncated <- take < text.len
            return if take == 0
            history_slot: usize = begin_text_history(index)
            offset: usize = index * TEXT_CAPACITY
            old_length: usize = widgets[index].input_length
            tail_length: usize = widgets[index].input_length - stop
            cursor: mutable usize = 0
            if start + take > stop:
                cursor <- tail_length
                while cursor > 0 |cursor, offset, start, stop, take|:
                    cursor <- cursor - 1
                    text_storage[offset + start + take + cursor] <- text_storage[offset + stop + cursor]
            else:
                while cursor < tail_length |cursor, offset, start, stop, take, tail_length|:
                    text_storage[offset + start + take + cursor] <- text_storage[offset + stop + cursor]
                    cursor <- cursor + 1
            for byte_index in 0..<take:
                text_storage[offset + start + byte_index] <- single_line_byte(text, byte_index)
            widgets[index].caret <- start + take
            widgets[index].selection_anchor <- widgets[index].caret
            widgets[index].input_length <- remaining + take
            for byte_index in widgets[index].input_length..<old_length:
                text_storage[offset + byte_index] <- 0
            widgets[index].text_revision <- widgets[index].text_revision + 1
            widgets[index] with { marked_start <- 0, marked_end <- 0 }
            restart_caret_blink()
            app_widget_event(index, UiConst::WidgetEvent.Change.i32())
            finish_text_history(history_slot, index)

        def replace_text(index: usize, text: sview) -> void:
            return if not text_editable(index)
            byte_limit: usize = text.len if text.len < TEXT_CAPACITY - 1 else TEXT_CAPACITY - 1
            take: usize = grapheme_prefix_length(text, valid_utf8_prefix(text, byte_limit))
            widgets[index].text_truncated <- take < text.len

            offset: usize = index * TEXT_CAPACITY
            old_length: usize = widgets[index].input_length
            changed: mutable bool = widgets[index].input_length != take
            compare: mutable usize = 0
            while not changed and compare < take |compare, changed, offset|:
                changed <- true if text_storage[offset + compare] != single_line_byte(text, compare)
                compare <- compare + 1

            history_slot: usize = begin_text_history(index) if changed else TEXT_HISTORY_CAPACITY
            for byte_index in 0..<take:
                text_storage[offset + byte_index] <- single_line_byte(text, byte_index)
            for byte_index in take..<old_length:
                text_storage[offset + byte_index] <- 0
            widgets[index] with { input_length <- take, caret <- take, selection_anchor <- take, marked_start <- 0, marked_end <- 0 }
            widgets[index].text_revision <- widgets[index].text_revision + 1 if changed
            restart_caret_blink() if changed and index == focused_widget
            app_widget_event(index, UiConst::WidgetEvent.Change.i32()) if changed
            finish_text_history(history_slot, index)

        # Platform text systems describe ranges in UTF-16 code units. Keeping
        # this conversion and all replacement policy in Elisa leaves native
        # adapters responsible only for forwarding protocol calls.
        def commit_text(text: sview, replacement_location: usize, replacement_length: usize, has_replacement: bool) -> void:
            return if not accepts_text()
            index: usize = focused_widget
            if composition_history_slot < TEXT_HISTORY_CAPACITY and widgets[index].marked_end > widgets[index].marked_start:
                history_suppressed <- true
                set_selection(index, widgets[index].marked_start, widgets[index].marked_end)
                insert_text(text)
                history_suppressed <- false
                store_history_state(composition_history_slot, index, true)
                composition_history_slot <- TEXT_HISTORY_CAPACITY
                return
            history_slot: usize = begin_text_history(index) if has_replacement else TEXT_HISTORY_CAPACITY
            if has_replacement:
                set_selection_utf16(index, replacement_location, replacement_length)
            elif widgets[index].marked_end > widgets[index].marked_start:
                set_selection(index, widgets[index].marked_start, widgets[index].marked_end)
            insert_text(text)
            finish_text_history(history_slot, index)

        def update_marked_text(text: sview, selected_location: usize, selected_length: usize, replacement_location: usize, replacement_length: usize, has_replacement: bool) -> void:
            return if not accepts_text()
            index: usize = focused_widget
            continuing_slot: usize = composition_history_slot
            history_slot: mutable usize = TEXT_HISTORY_CAPACITY
            if continuing_slot < TEXT_HISTORY_CAPACITY:
                history_suppressed <- true
            else:
                history_slot <- begin_text_history(index)
            if has_replacement:
                set_selection_utf16(index, replacement_location, replacement_length)
            elif widgets[index].marked_end > widgets[index].marked_start:
                set_selection(index, widgets[index].marked_start, widgets[index].marked_end)
            marked_start: usize = selection_start(index)
            insert_text(text)
            marked_stop: usize = widgets[index].caret
            set_marked(index, marked_start, marked_stop)
            total_units: usize = utf16_units_for_prefix(text, text.len)
            safe_location: usize = selected_location if selected_location < total_units else total_units
            remaining_units: usize = total_units - safe_location
            safe_length: usize = selected_length if selected_length < remaining_units else remaining_units
            relative_start: mutable usize = byte_offset_for_utf16(text, safe_location)
            relative_stop: mutable usize = byte_offset_for_utf16(text, safe_location + safe_length)
            inserted_length: usize = marked_stop - marked_start
            relative_start <- inserted_length if relative_start > inserted_length
            relative_stop <- inserted_length if relative_stop > inserted_length
            set_selection(index, marked_start + relative_start, marked_start + relative_stop)
            if continuing_slot < TEXT_HISTORY_CAPACITY:
                history_suppressed <- false
                store_history_state(continuing_slot, index, true)
            else:
                finish_text_history(history_slot, index)
                composition_history_slot <- history_slot if history_slot < TEXT_HISTORY_CAPACITY and history_text_changed(history_slot) else TEXT_HISTORY_CAPACITY

        # SDL describes the selection inside marked text in Unicode scalar
        # counts, whereas AppKit uses UTF-16 units. Normalize both at this
        # framework boundary so the editing engine has one internal protocol.
        def update_marked_text_utf8_characters(text: sview, selected_start: i32, selected_length: i32) -> void:
            start_count: usize = selected_start.usize() if selected_start > 0 else 0
            length_count: usize = selected_length.usize() if selected_length > 0 else 0
            cursor: mutable usize = 0
            scalars: mutable usize = 0
            while cursor < text.len and scalars < start_count |cursor, scalars, start_count|:
                cursor <- cursor + utf8_scalar_bytes(text, cursor)
                scalars <- scalars + 1
            selection_location: usize = utf16_units_for_prefix(text, cursor)
            stop: mutable usize = cursor
            scalars <- 0
            while stop < text.len and scalars < length_count |stop, scalars, length_count|:
                stop <- stop + utf8_scalar_bytes(text, stop)
                scalars <- scalars + 1
            selection_length_units: usize = utf16_units_for_prefix(text, stop) - selection_location
            update_marked_text(text, selection_location, selection_length_units, 0, 0, false)
            unmark_text() if text.len == 0

        def unmark_text() -> void:
            return if not accepts_text()
            widgets[focused_widget] with { marked_start <- 0, marked_end <- 0 }
            if composition_history_slot < TEXT_HISTORY_CAPACITY:
                store_history_state(composition_history_slot, focused_widget, true)
            composition_history_slot <- TEXT_HISTORY_CAPACITY

        def can_undo_text() -> bool:
            return history_cursor > 0

        def can_redo_text() -> bool:
            return history_cursor < history_count

        def undo_text() -> bool:
            return false if history_cursor == 0
            composition_history_slot <- TEXT_HISTORY_CAPACITY
            history_cursor <- history_cursor - 1
            history_suppressed <- true
            restore_history_state(history_cursor, false)
            history_suppressed <- false
            return true

        def redo_text() -> bool:
            return false if history_cursor >= history_count
            composition_history_slot <- TEXT_HISTORY_CAPACITY
            history_suppressed <- true
            restore_history_state(history_cursor, true)
            history_suppressed <- false
            history_cursor <- history_cursor + 1
            return true

        # Backend hooks expose bytes only. Selection, security, history, and
        # shortcut policy remain in Elisa's retained control implementation.
        def text_action_enabled(action: i32) -> bool:
            return can_undo_text() if action == 5
            return can_redo_text() if action == 6
            return false if not accepts_text()
            return allows_text_readback() and selected_text_length(focused_widget) > 0 if action == 2 or action == 3
            return true if action == 1
            return ui_clipboard_has_text() if action == 4
            return false

        def perform_text_action(action: i32) -> bool:
            return false if not text_action_enabled(action)
            if action == 1:
                set_selection(focused_widget, 0, widgets[focused_widget].input_length)
                return true
            if action == 2 or action == 3:
                length: usize = selected_text_length(focused_widget)
                return false if not ui_clipboard_write(selected_text_pointer(focused_widget), length)
                insert_text("") if action == 3
                return true
            if action == 4:
                length: usize = ui_clipboard_read(&clipboard_buffer[0], TEXT_CAPACITY)
                return false if length == 0
                insert_text(sview(&clipboard_buffer[0], 0, length.i64()))
                scrub_clipboard_buffer()
                return true
            return undo_text() if action == 5
            return redo_text() if action == 6
            return false

        # Later widgets are drawn over earlier ones, so scanning backwards finds
        # the topmost interactive widget under the pointer.
        def hit(x: f32, y: f32) -> usize:
            ensure_layout()
            return NONE if widget_count == 0
            scan: mutable usize = widget_count
            while scan > 0 |scan|:
                scan <- scan - 1
                return scan if widgets[scan].interactive and effectively_enabled(scan) and effectively_visible(scan) and inside_scroll_viewports(scan, x, y) and contains(scan, x, y)
            return NONE

        # Find the innermost flat scroll viewport that can consume this wheel
        # delta. Reverse arena order prefers a nested descendant, but a
        # non-scrollable or edge-clamped child is skipped so the gesture can
        # bubble to an outer viewport.
        def scroll_target(x: f32, y: f32, dx: f32, dy: f32) -> usize:
            ensure_layout()
            return NONE if widget_count == 0
            scan: mutable usize = widget_count
            while scan > 0 |scan|:
                scan <- scan - 1
                if widgets[scan].kind == UiConst::WidgetKind.Scroll and effectively_enabled(scan) and effectively_visible(scan) and inside_scroll_viewports(scan, x, y) and contains(scan, x, y):
                    limit: f32 = scroll_limit(scan)
                    delta: f32 = UiCore::finite_or_zero(dx if widgets[scan].axis == UiConst::Axis.Row else dy)
                    current: f32 = widgets[scan].scroll_offset
                    can_move: bool = limit > 0.0 and ((delta > 0.0 and current > 0.0) or (delta < 0.0 and current < limit))
                    return scan if can_move
            return NONE

        # Native hosts need only choose the system cursor; widget semantics and
        # hit ordering remain owned by Elisa. 0=arrow, 1=pointing hand, 2=I-beam.
        def cursor_at(x: f32, y: f32) -> i32:
            target: usize = hit(x, y)
            return 0 if target == NONE
            return 2 if widgets[target].kind == UiConst::WidgetKind.TextField
            return 1 if widgets[target].kind == UiConst::WidgetKind.Button or widgets[target].kind == UiConst::WidgetKind.RadioButton or widgets[target].kind == UiConst::WidgetKind.CheckBox
            return 0

        # Feed one event through the flat tree. Anything that is not a pointer event
        # is ignored here, so an app can hand the whole stream over without sorting
        # it first.
        def pointer(event: UiCore::Event) -> void:
            at: mutable UiCore::Vec2 = UiCore::Vec2(0.0, 0.0)
            match event:
                UiCore::PointerEvent.Move(move_at):
                    at <- move_at
                    pointer_x <- move_at.x
                    pointer_y <- move_at.y
                    pointer_inside <- true
                UiCore::PointerEvent.Down(down_at, down_button):
                    at <- down_at
                    pointer_x <- down_at.x
                    pointer_y <- down_at.y
                    pointer_inside <- true
                UiCore::PointerEvent.Up(up_at, up_button):
                    at <- up_at
                    pointer_x <- up_at.x
                    pointer_y <- up_at.y
                    pointer_inside <- true
                UiCore::PointerEvent.Leave:
                    pointer_inside <- false
                    pass
                UiCore::PointerEvent.Scroll(scroll_at, scroll_delta):
                    pointer_x <- scroll_at.x
                    pointer_y <- scroll_at.y
                    pointer_inside <- true
                    target: usize = scroll_target(scroll_at.x, scroll_at.y, scroll_delta.x, scroll_delta.y)
                    return if target == NONE
                    amount: f32 = scroll_delta.x if widgets[target].axis == UiConst::Axis.Row else scroll_delta.y
                    _ = set_scroll_offset(target, scroll_offset(target) - amount)
                    return
                _:
                    return

            target: usize = hit(at.x, at.y)
            clear_hover()
            hot_widget <- target
            if target != NONE:
                widgets[target].hovered <- true

            match event:
                UiCore::PointerEvent.Down(press_at, press_button):
                    return if press_button != UiCore::PointerButton.Primary.i32()
                    scroll_bar: usize = scrollbar_target(press_at.x, press_at.y)
                    if scroll_bar != NONE:
                        release_active_press()
                        if scrollbar_part(scroll_bar, press_at.x, press_at.y) == 2:
                            active_scroll <- scroll_bar
                            active_scroll_pointer <- scrollbar_coordinate(scroll_bar, press_at.x, press_at.y)
                            active_scroll_offset <- widgets[scroll_bar].scroll_offset
                            active_pointer_button <- press_button
                        else:
                            scroll_page(scroll_bar, press_at.x, press_at.y)
                        return
                    return if target == NONE
                    focus(target)
                    active_widget <- target
                    active_pointer_button <- press_button
                    widgets[target].pressed <- true
                    if widgets[target].kind == UiConst::WidgetKind.TextField:
                        widgets[target].caret <- caret_from_pointer(target, press_at.x)
                        widgets[target].selection_anchor <- widgets[target].caret if not shift_active()
                        restart_caret_blink()
                    update_slider(target, press_at.x)
                UiCore::PointerEvent.Move(move_at):
                    if active_scroll < widget_count:
                        track_length: f32 = scrollbar_track_length(active_scroll)
                        thumb_length: f32 = scrollbar_thumb_length(active_scroll)
                        travel: f32 = track_length - thumb_length
                        limit: f32 = scroll_limit(active_scroll)
                        coordinate: f32 = scrollbar_coordinate(active_scroll, move_at.x, move_at.y)
                        requested: f32 = active_scroll_offset + (coordinate - active_scroll_pointer) * limit / travel if travel > 0.0 else active_scroll_offset
                        _ = set_scroll_offset(active_scroll, requested)
                        return
                    if active_pointer_button >= 0 and active_widget < widget_count:
                        if widgets[active_widget].kind == UiConst::WidgetKind.Slider:
                            widgets[active_widget].pressed <- true
                            update_slider(active_widget, move_at.x)
                        elif widgets[active_widget].kind == UiConst::WidgetKind.TextField:
                            widgets[active_widget].pressed <- true
                            widgets[active_widget].caret <- caret_from_pointer(active_widget, move_at.x)
                            restart_caret_blink()
                        else:
                            widgets[active_widget].pressed <- target == active_widget
                UiCore::PointerEvent.Up(release_at, release_button):
                    if active_scroll < widget_count:
                        return if release_button != UiCore::PointerButton.Primary.i32()
                        active_scroll <- NONE
                        active_scroll_pointer <- 0.0
                        active_scroll_offset <- 0.0
                        active_pointer_button <- UiCore::NO_POINTER_BUTTON
                        return
                    return if active_pointer_button < 0 or active_widget == NONE or release_button != active_pointer_button
                    held: usize = active_widget
                    active_widget <- NONE
                    active_pointer_button <- UiCore::NO_POINTER_BUTTON
                    active_key <- -1
                    widgets[held].pressed <- false
                    if widgets[held].kind == UiConst::WidgetKind.Slider:
                        update_slider(held, release_at.x)
                    elif widgets[held].kind == UiConst::WidgetKind.TextField:
                        pass
                    elif held == target:
                        dispatch_activation(held)
                UiCore::PointerEvent.Leave:
                    hot_widget <- NONE
                    return if active_scroll < widget_count
                    return if active_pointer_button < 0 or active_widget == NONE
                    # Keep capture until mouse-up. Sliders continue to receive
                    # clamped drag updates outside the view; buttons can regain
                    # their pressed appearance if the pointer comes back.
                    widgets[active_widget].pressed <- widgets[active_widget].kind == UiConst::WidgetKind.Slider
                _:
                    pass

        # Keyboard interaction mirrors desktop controls: Tab moves focus, while
        # Space/Enter press and release the focused control. Activation happens
        # on release, matching pointer clicks and allowing the pressed state to paint.
        def keyboard(event: UiCore::Event) -> void:
            match event:
                UiCore::KeyEvent.Down(code):
                    if code == UiCore::Key.LeftShift:
                        left_shift_down <- true
                        return
                    if code == UiCore::Key.RightShift:
                        right_shift_down <- true
                        return
                    if code == UiCore::Key.LeftControl:
                        left_control_down <- true
                        return
                    if code == UiCore::Key.RightControl:
                        right_control_down <- true
                        return
                    if code == UiCore::Key.LeftSuper:
                        left_super_down <- true
                        return
                    if code == UiCore::Key.RightSuper:
                        right_super_down <- true
                        return
                    if accepts_text() and (control_active() or super_active()):
                        action: mutable i32 = 0
                        action <- 1 if code == UiCore::Key.A
                        action <- 2 if code == UiCore::Key.C
                        action <- 3 if code == UiCore::Key.X
                        action <- 4 if code == UiCore::Key.V
                        action <- 6 if code == UiCore::Key.Z and shift_active()
                        action <- 5 if code == UiCore::Key.Z and not shift_active()
                        if action != 0:
                            _ = perform_text_action(action)
                            return
                    if code == UiCore::Key.Tab:
                        focus_previous() if shift_active() else focus_next()
                        return
                    if focused_widget < widget_count and widgets[focused_widget].kind == UiConst::WidgetKind.TextField:
                        field: usize = focused_widget
                        if code == UiCore::Key.Left:
                            if not shift_active() and selection_start(field) != selection_end(field):
                                widgets[field].caret <- selection_start(field)
                            else:
                                widgets[field].caret <- previous_character(field, widgets[field].caret)
                            widgets[field].selection_anchor <- widgets[field].caret if not shift_active()
                            restart_caret_blink()
                            return
                        if code == UiCore::Key.Right:
                            if not shift_active() and selection_start(field) != selection_end(field):
                                widgets[field].caret <- selection_end(field)
                            else:
                                widgets[field].caret <- next_character(field, widgets[field].caret)
                            widgets[field].selection_anchor <- widgets[field].caret if not shift_active()
                            restart_caret_blink()
                            return
                        if code == UiCore::Key.Home:
                            widgets[field].caret <- 0
                            widgets[field].selection_anchor <- widgets[field].caret if not shift_active()
                            restart_caret_blink()
                            return
                        if code == UiCore::Key.End:
                            widgets[field].caret <- widgets[field].input_length
                            widgets[field].selection_anchor <- widgets[field].caret if not shift_active()
                            restart_caret_blink()
                            return
                        if code == UiCore::Key.Backspace and selection_start(field) != selection_end(field):
                            remove_text(field, selection_start(field), selection_end(field))
                            return
                        if code == UiCore::Key.Backspace and widgets[field].caret > 0:
                            remove_text(field, previous_character(field, widgets[field].caret), widgets[field].caret)
                            return
                        if code == UiCore::Key.Delete and selection_start(field) != selection_end(field):
                            remove_text(field, selection_start(field), selection_end(field))
                            return
                        if code == UiCore::Key.Delete and widgets[field].caret < widgets[field].input_length:
                            remove_text(field, widgets[field].caret, next_character(field, widgets[field].caret))
                            return
                        if code == UiCore::Key.Enter:
                            app_widget_event(field, UiConst::WidgetEvent.Submit.i32())
                            return
                    if focused_widget < widget_count and widgets[focused_widget].kind == UiConst::WidgetKind.RadioButton:
                        direction: i32 = -1 if code == UiCore::Key.Left or code == UiCore::Key.Up else 1 if code == UiCore::Key.Right or code == UiCore::Key.Down else 0
                        return if radio_move(focused_widget, direction)
                    if focused_widget < widget_count and widgets[focused_widget].kind == UiConst::WidgetKind.Slider:
                        adjust_step(focused_widget, -1) if code == UiCore::Key.Left or code == UiCore::Key.Down
                        adjust_step(focused_widget, 1) if code == UiCore::Key.Right or code == UiCore::Key.Up
                        adjust(focused_widget, -widgets[focused_widget].step * 10.0) if code == UiCore::Key.PageDown
                        adjust(focused_widget, widgets[focused_widget].step * 10.0) if code == UiCore::Key.PageUp
                        adjust(focused_widget, -1.0) if code == UiCore::Key.Home
                        adjust(focused_widget, 1.0) if code == UiCore::Key.End
                        return if code == UiCore::Key.Left or code == UiCore::Key.Down or code == UiCore::Key.Right or code == UiCore::Key.Up or code == UiCore::Key.PageDown or code == UiCore::Key.PageUp or code == UiCore::Key.Home or code == UiCore::Key.End
                    return if scroll_keyboard(code)
                    if (code == UiCore::Key.Space or code == UiCore::Key.Enter) and focused_widget < widget_count and widgets[focused_widget].kind != UiConst::WidgetKind.Slider and widgets[focused_widget].kind != UiConst::WidgetKind.TextField:
                        return if active_key >= 0 or active_pointer_button >= 0
                        active_widget <- focused_widget
                        active_key <- code.i32()
                        widgets[focused_widget].pressed <- true
                UiCore::KeyEvent.Up(code):
                    if code == UiCore::Key.LeftShift:
                        left_shift_down <- false
                        return
                    if code == UiCore::Key.RightShift:
                        right_shift_down <- false
                        return
                    if code == UiCore::Key.LeftControl:
                        left_control_down <- false
                        return
                    if code == UiCore::Key.RightControl:
                        right_control_down <- false
                        return
                    if code == UiCore::Key.LeftSuper:
                        left_super_down <- false
                        return
                    if code == UiCore::Key.RightSuper:
                        right_super_down <- false
                        return
                    if (code == UiCore::Key.Space or code == UiCore::Key.Enter) and focused_widget < widget_count and widgets[focused_widget].kind != UiConst::WidgetKind.Slider and widgets[focused_widget].kind != UiConst::WidgetKind.TextField:
                        return if active_key != code.i32() or active_widget >= widget_count
                        activated: usize = active_widget
                        active_widget <- NONE
                        active_key <- -1
                        widgets[activated].pressed <- false
                        dispatch_activation(activated) if activated == focused_widget and effectively_enabled(activated)
                _:
                    pass

        # One activation path for accessibility adapters and future automation.
        # It deliberately mirrors a completed pointer/keyboard click.
        def activate(index: usize) -> bool:
            return false if index >= widget_count or not widgets[index].interactive or not effectively_enabled(index) or not effectively_visible(index) or widgets[index].kind == UiConst::WidgetKind.Slider or widgets[index].kind == UiConst::WidgetKind.TextField
            release_active_press()
            focus(index)
            dispatch_activation(index)
            return true

        # Accessibility adapters use the same normalized adjustment path as
        # arrow keys, so assistive actions update app state identically.
        def adjust(index: usize, delta: f32) -> bool:
            return false if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.Slider or not effectively_enabled(index) or not effectively_visible(index)
            before: f32 = widgets[index].value
            set_value(index, before + delta)
            return false if widgets[index].value == before
            focus(index)
            app_widget_event(index, UiConst::WidgetEvent.Change.i32())
            return true

        # Assistive clients may assign a slider value directly. Keep that
        # mutation on the same normalized, visibility- and enabled-checked path
        # as pointer and keyboard adjustments, and report whether the request
        # was accepted so native accessibility state can mirror the result.
        def set_accessibility_value(index: usize, value: f32) -> bool:
            return false if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.Slider or not effectively_enabled(index) or not effectively_visible(index)
            before: f32 = widgets[index].value
            set_value(index, value)
            return false if widgets[index].value == before
            focus(index)
            app_widget_event(index, UiConst::WidgetEvent.Change.i32())
            return true

        def adjust_step(index: usize, direction: i32) -> bool:
            return false if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.Slider or direction == 0
            delta: f32 = widgets[index].step if direction > 0 else -widgets[index].step
            return adjust(index, delta)

        # Arrow navigation in a radio group follows the same deterministic
        # focus order as Tab. Disabled and hidden peers are skipped, and the
        # search wraps so a group remains navigable from either end.
        def radio_move(index: usize, direction: i32) -> bool:
            return false if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.RadioButton or direction == 0
            group: usize = widgets[index].selection_group
            current_order: usize = widgets[index].focus_order
            candidate: mutable usize = NONE
            if direction > 0:
                for scan in 0..<widget_count:
                    eligible: bool = scan != index and widgets[scan].kind == UiConst::WidgetKind.RadioButton and widgets[scan].selection_group == group and effectively_enabled(scan) and effectively_visible(scan)
                    follows: bool = widgets[scan].focus_order > current_order or (widgets[scan].focus_order == current_order and scan > index)
                    if eligible and follows:
                        candidate <- scan if candidate == NONE or widgets[scan].focus_order < widgets[candidate].focus_order or (widgets[scan].focus_order == widgets[candidate].focus_order and scan < candidate) else candidate
                if candidate == NONE:
                    for scan in 0..<widget_count:
                        eligible: bool = scan != index and widgets[scan].kind == UiConst::WidgetKind.RadioButton and widgets[scan].selection_group == group and effectively_enabled(scan) and effectively_visible(scan)
                        if eligible:
                            candidate <- scan if candidate == NONE or widgets[scan].focus_order < widgets[candidate].focus_order or (widgets[scan].focus_order == widgets[candidate].focus_order and scan < candidate) else candidate
            else:
                for scan in 0..<widget_count:
                    eligible: bool = scan != index and widgets[scan].kind == UiConst::WidgetKind.RadioButton and widgets[scan].selection_group == group and effectively_enabled(scan) and effectively_visible(scan)
                    precedes: bool = widgets[scan].focus_order < current_order or (widgets[scan].focus_order == current_order and scan < index)
                    if eligible and precedes:
                        candidate <- scan if candidate == NONE or widgets[scan].focus_order > widgets[candidate].focus_order or (widgets[scan].focus_order == widgets[candidate].focus_order and scan > candidate) else candidate
                if candidate == NONE:
                    for scan in 0..<widget_count:
                        eligible: bool = scan != index and widgets[scan].kind == UiConst::WidgetKind.RadioButton and widgets[scan].selection_group == group and effectively_enabled(scan) and effectively_visible(scan)
                        if eligible:
                            candidate <- scan if candidate == NONE or widgets[scan].focus_order > widgets[candidate].focus_order or (widgets[scan].focus_order == widgets[candidate].focus_order and scan > candidate) else candidate
            return false if candidate == NONE
            set_selected(candidate, true)
            focus(candidate)
            app_widget_event(candidate, UiConst::WidgetEvent.Change.i32())
            return true

        # Keyboard scrolling follows focus into the nearest scroll ancestor,
        # so a focused child remains usable even when its viewport is clipped.
        # The offset setter owns clamping and re-layout; this helper only maps
        # desktop navigation keys to a retained viewport delta.
        const KEYBOARD_SCROLL_STEP: f32 = 40.0

        def focused_scroll_target() -> usize:
            return NONE if focused_widget >= widget_count
            cursor: mutable usize = focused_widget
            while cursor < widget_count |cursor|:
                return cursor if widgets[cursor].kind == UiConst::WidgetKind.Scroll
                cursor <- widgets[cursor].parent
            return NONE

        def scroll_keyboard(code: UiCore::Key) -> bool:
            target: usize = focused_scroll_target()
            return false if target == NONE or not effectively_enabled(target) or not effectively_visible(target)
            is_row: bool = widgets[target].axis == UiConst::Axis.Row
            forward: bool = code == UiCore::Key.PageDown or (is_row and code == UiCore::Key.Right) or (not is_row and code == UiCore::Key.Down)
            backward: bool = code == UiCore::Key.PageUp or (is_row and code == UiCore::Key.Left) or (not is_row and code == UiCore::Key.Up)
            if code == UiCore::Key.Home:
                return set_scroll_offset(target, 0.0)
            if code == UiCore::Key.End:
                return set_scroll_offset(target, scroll_limit(target))
            return false if not forward and not backward
            viewport: f32 = widgets[target].width if is_row else widgets[target].height
            page: bool = code == UiCore::Key.PageDown or code == UiCore::Key.PageUp
            amount: mutable f32 = viewport if page else KEYBOARD_SCROLL_STEP
            amount <- -amount if backward
            return set_scroll_offset(target, widgets[target].scroll_offset + amount)

        # Scroll indicators are drawn by the flat painter itself, so a canvas
        # backend does not need an NSScroller or a browser scrollbar. The thumb
        # length reflects the viewport/content ratio and its travel follows the
        # same clamped offset used by wheel input.
        def paint_scrollbar(index: usize) -> void:
            return if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.Scroll
            is_row: bool = widgets[index].axis == UiConst::Axis.Row
            viewport: f32 = widgets[index].width if is_row else widgets[index].height
            content: f32 = widgets[index].scroll_content_width if is_row else widgets[index].scroll_content_height
            return if content <= viewport or viewport <= 0.0
            cross_extent: f32 = widgets[index].height if is_row else widgets[index].width
            inset: f32 = clamped_inset(current_theme.scrollbar_inset, cross_extent)
            bar: mutable f32 = current_theme.scrollbar_width
            bar <- cross_extent - inset * 2.0 if bar > cross_extent - inset * 2.0 else bar
            return if bar <= 0.0
            track_extent: f32 = viewport - inset * 2.0
            return if track_extent <= 0.0
            thumb_extent: mutable f32 = track_extent * viewport / content
            minimum_thumb: f32 = 24.0 if track_extent >= 24.0 else track_extent
            thumb_extent <- minimum_thumb if thumb_extent < minimum_thumb else thumb_extent
            thumb_extent <- track_extent if thumb_extent > track_extent else thumb_extent
            limit: f32 = content - viewport
            travel: f32 = track_extent - thumb_extent
            thumb_position: f32 = travel * widgets[index].scroll_offset / limit if limit > 0.0 else 0.0
            thumb_color: mutable UiCore::Color = current_theme.scrollbar_thumb
            enabled: bool = effectively_enabled(index)
            thumb_color <- muted_color(thumb_color) if not enabled
            thumb_color <- current_theme.scrollbar_thumb_active if enabled and active_scroll == index
            thumb_color <- current_theme.scrollbar_thumb_hover if enabled and active_scroll != index and pointer_inside and scrollbar_part(index, pointer_x, pointer_y) == 2
            track_color: UiCore::Color = current_theme.scrollbar_track if enabled else muted_color(current_theme.scrollbar_track)
            if is_row:
                track: UiCore::Rect = UiCore::Rect(widgets[index].x + inset, widgets[index].y + widgets[index].height - bar - inset, track_extent, bar)
                thumb: UiCore::Rect = UiCore::Rect(track.origin.x + thumb_position, track.origin.y, thumb_extent, bar)
                UiCore::fill(track, track_color)
                UiCore::fill(thumb, thumb_color)
            else:
                track: UiCore::Rect = UiCore::Rect(widgets[index].x + widgets[index].width - bar - inset, widgets[index].y + inset, bar, track_extent)
                thumb: UiCore::Rect = UiCore::Rect(track.origin.x, track.origin.y + thumb_position, bar, thumb_extent)
                UiCore::fill(track, track_color)
                UiCore::fill(thumb, thumb_color)

        # Return 2 for the thumb, 1 for the track, and 0 outside the current
        # indicator. Reverse-order callers still choose the innermost nested
        # viewport before invoking this geometry helper.
        def scrollbar_part(index: usize, x: f32, y: f32) -> i32:
            return 0 if index >= widget_count or widgets[index].kind != UiConst::WidgetKind.Scroll
            return 0 if not effectively_enabled(index) or not effectively_visible(index) or not inside_scroll_viewports(index, x, y)
            is_row: bool = widgets[index].axis == UiConst::Axis.Row
            viewport: f32 = widgets[index].width if is_row else widgets[index].height
            content: f32 = widgets[index].scroll_content_width if is_row else widgets[index].scroll_content_height
            return 0 if content <= viewport or viewport <= 0.0
            cross_extent: f32 = widgets[index].height if is_row else widgets[index].width
            inset: f32 = clamped_inset(current_theme.scrollbar_inset, cross_extent)
            bar: mutable f32 = current_theme.scrollbar_width
            bar <- cross_extent - inset * 2.0 if bar > cross_extent - inset * 2.0 else bar
            return 0 if bar <= 0.0
            track_extent: f32 = viewport - inset * 2.0
            return 0 if track_extent <= 0.0
            thumb_extent: mutable f32 = track_extent * viewport / content
            minimum_thumb: f32 = 24.0 if track_extent >= 24.0 else track_extent
            thumb_extent <- minimum_thumb if thumb_extent < minimum_thumb else thumb_extent
            thumb_extent <- track_extent if thumb_extent > track_extent else thumb_extent
            limit: f32 = content - viewport
            travel: f32 = track_extent - thumb_extent
            thumb_position: f32 = travel * widgets[index].scroll_offset / limit if limit > 0.0 else 0.0
            if is_row:
                track_x: f32 = widgets[index].x + inset
                track_y: f32 = widgets[index].y + widgets[index].height - bar - inset
                return 0 if x < track_x or x >= track_x + track_extent or y < track_y or y >= track_y + bar
                thumb_x: f32 = track_x + thumb_position
                return 2 if x >= thumb_x and x < thumb_x + thumb_extent
                return 1
            track_x: f32 = widgets[index].x + widgets[index].width - bar - inset
            track_y: f32 = widgets[index].y + inset
            return 0 if x < track_x or x >= track_x + bar or y < track_y or y >= track_y + track_extent
            thumb_y: f32 = track_y + thumb_position
            return 2 if y >= thumb_y and y < thumb_y + thumb_extent
            return 1

        def scrollbar_target(x: f32, y: f32) -> usize:
            return NONE if widget_count == 0
            scan: mutable usize = widget_count
            while scan > 0 |scan|:
                scan <- scan - 1
                return scan if scrollbar_part(scan, x, y) != 0
            return NONE

        def scrollbar_coordinate(index: usize, x: f32, y: f32) -> f32:
            return x if widgets[index].axis == UiConst::Axis.Row else y

        def scrollbar_track_start(index: usize) -> f32:
            is_row: bool = widgets[index].axis == UiConst::Axis.Row
            cross_extent: f32 = widgets[index].height if is_row else widgets[index].width
            inset: f32 = clamped_inset(current_theme.scrollbar_inset, cross_extent)
            return widgets[index].x + inset if is_row else widgets[index].y + inset

        def scrollbar_track_length(index: usize) -> f32:
            viewport: f32 = widgets[index].width if widgets[index].axis == UiConst::Axis.Row else widgets[index].height
            cross_extent: f32 = widgets[index].height if widgets[index].axis == UiConst::Axis.Row else widgets[index].width
            inset: f32 = clamped_inset(current_theme.scrollbar_inset, cross_extent)
            return viewport - inset * 2.0

        def scrollbar_thumb_length(index: usize) -> f32:
            viewport: f32 = widgets[index].width if widgets[index].axis == UiConst::Axis.Row else widgets[index].height
            content: f32 = widgets[index].scroll_content_width if widgets[index].axis == UiConst::Axis.Row else widgets[index].scroll_content_height
            track_length: f32 = scrollbar_track_length(index)
            return 0.0 if content <= viewport or track_length <= 0.0
            thumb: mutable f32 = track_length * viewport / content
            minimum_thumb: f32 = 24.0 if track_length >= 24.0 else track_length
            thumb <- minimum_thumb if thumb < minimum_thumb else thumb
            return track_length if thumb > track_length else thumb

        def scroll_page(index: usize, x: f32, y: f32) -> void:
            coordinate: f32 = scrollbar_coordinate(index, x, y)
            start: f32 = scrollbar_track_start(index)
            thumb: f32 = scrollbar_thumb_length(index)
            limit: f32 = scroll_limit(index)
            travel: f32 = scrollbar_track_length(index) - thumb
            thumb_position: f32 = travel * widgets[index].scroll_offset / limit if limit > 0.0 else 0.0
            thumb_start: f32 = start + thumb_position
            return if coordinate >= thumb_start and coordinate <= thumb_start + thumb
            viewport: f32 = widgets[index].width if widgets[index].axis == UiConst::Axis.Row else widgets[index].height
            _ = set_scroll_offset(index, widgets[index].scroll_offset - viewport if coordinate < thumb_start else widgets[index].scroll_offset + viewport)

        # Pre-order emission gives painter's-algorithm ordering for free: a
        # parent's background is laid down before any of its children.
        def paint() -> void:
            layout(last_layout_width, last_layout_height) if layout_initialized and layout_dirty
            for index in 0..<widget_count:
                semantic_emitted[index] <- not effectively_visible(index) or not intersects_scroll_viewports(index)
            for emitted_count in 0..<widget_count:
                next_semantic: mutable usize = NONE
                for candidate in 0..<widget_count:
                    if not semantic_emitted[candidate]:
                        next_semantic <- candidate if next_semantic >= widget_count or widgets[candidate].focus_order < widgets[next_semantic].focus_order or (widgets[candidate].focus_order == widgets[next_semantic].focus_order and candidate < next_semantic) else next_semantic
                if next_semantic < widget_count:
                    emit_accessibility(next_semantic)
                    semantic_emitted[next_semantic] <- true
            for index in 0..<widget_count:
                continue if not effectively_visible(index) or not intersects_scroll_viewports(index)
                set_scroll_clip(index)
                enabled: bool = effectively_enabled(index)
                color: UiCore::Color = color_of(index)
                frame: UiCore::Rect = UiCore::Rect(widgets[index].x, widgets[index].y, widgets[index].width, widgets[index].height)
                if widgets[index].kind == UiConst::WidgetKind.Slider:
                    slider_inset: f32 = clamped_inset(current_theme.slider_horizontal_inset, widgets[index].width)
                    track_height: f32 = current_theme.slider_track_height if current_theme.slider_track_height < widgets[index].height else widgets[index].height
                    track_y: f32 = widgets[index].y + widgets[index].height / 2.0 - track_height / 2.0
                    track_x: f32 = widgets[index].x + slider_inset
                    track_width: f32 = widgets[index].width - slider_inset * 2.0
                    slider_track: UiCore::Color = widgets[index].color if enabled else muted_color(widgets[index].color)
                    slider_fill: UiCore::Color = widgets[index].hover_color if enabled else muted_color(widgets[index].hover_color)
                    UiCore::fill(UiCore::Rect(track_x, track_y, track_width, track_height), slider_track)
                    UiCore::fill(UiCore::Rect(track_x, track_y, track_width * widgets[index].value, track_height), slider_fill)
                    thumb_x: f32 = track_x + track_width * widgets[index].value
                    thumb: mutable UiCore::Color = widgets[index].press_color if enabled else muted_color(widgets[index].press_color)
                    thumb <- current_theme.control_mark_strong if widgets[index].pressed
                    UiCore::fill(UiCore::Circle{center: UiCore::Vec2(thumb_x, track_y + track_height / 2.0), radius: current_theme.slider_thumb_radius}, thumb)
                elif widgets[index].kind == UiConst::WidgetKind.ProgressBar:
                    progress_height: f32 = current_theme.slider_track_height if current_theme.slider_track_height < widgets[index].height else widgets[index].height
                    progress_y: f32 = widgets[index].y + widgets[index].height / 2.0 - progress_height / 2.0
                    progress_track: UiCore::Color = widgets[index].color if enabled else muted_color(widgets[index].color)
                    progress_fill: UiCore::Color = widgets[index].hover_color if enabled else muted_color(widgets[index].hover_color)
                    UiCore::fill(UiCore::Rect(widgets[index].x, progress_y, widgets[index].width, progress_height), progress_track)
                    UiCore::fill(UiCore::Rect(widgets[index].x, progress_y, widgets[index].width * widgets[index].value, progress_height), progress_fill)
                elif color.a != 0:
                    UiCore::fill(frame, color)
                if widgets[index].kind == UiConst::WidgetKind.RadioButton:
                    mark_x: f32 = widgets[index].x + current_theme.choice_center_x
                    mark_y: f32 = widgets[index].y + widgets[index].height / 2.0
                    outer: UiCore::Color = current_theme.control_mark if enabled else muted_color(current_theme.control_mark)
                    UiCore::fill(UiCore::Circle{center: UiCore::Vec2(mark_x, mark_y), radius: current_theme.radio_outer_radius}, outer)
                    inner: mutable UiCore::Color = color
                    inner <- current_theme.control_mark_strong if widgets[index].selected and enabled
                    inner <- muted_color(current_theme.control_mark_strong) if widgets[index].selected and not enabled
                    UiCore::fill(UiCore::Circle{center: UiCore::Vec2(mark_x, mark_y), radius: current_theme.radio_inner_radius}, inner)
                elif widgets[index].kind == UiConst::WidgetKind.CheckBox:
                    checkbox_extent: f32 = current_theme.checkbox_size
                    box_x: f32 = widgets[index].x + current_theme.choice_center_x - checkbox_extent / 2.0
                    box_y: f32 = widgets[index].y + widgets[index].height / 2.0 - checkbox_extent / 2.0
                    box_color: UiCore::Color = current_theme.control_mark if enabled else muted_color(current_theme.control_mark)
                    UiCore::fill(UiCore::Rect(box_x, box_y, checkbox_extent, checkbox_extent), box_color)
                    # Scale the inset and checkmark with the token. Fixed
                    # pixel geometry here used to overflow when an app chose
                    # a compact checkbox theme.
                    checkbox_inset: f32 = checkbox_extent * 0.18
                    checkbox_inner_extent: mutable f32 = checkbox_extent - checkbox_inset * 2.0
                    checkbox_inner_extent <- 0.0 if checkbox_inner_extent < 0.0
                    UiCore::fill(UiCore::Rect(box_x + checkbox_inset, box_y + checkbox_inset, checkbox_inner_extent, checkbox_inner_extent), color)
                    if widgets[index].selected and checkbox_extent > 0.0:
                        check_ink: UiCore::Color = current_theme.control_mark_strong if enabled else muted_color(current_theme.control_mark_strong)
                        UiCore::fill(UiCore::Line{from_point: UiCore::Vec2(box_x + checkbox_extent * 0.23, box_y + checkbox_extent * 0.50), to_point: UiCore::Vec2(box_x + checkbox_extent * 0.44, box_y + checkbox_extent * 0.73)}, check_ink)
                        UiCore::fill(UiCore::Line{from_point: UiCore::Vec2(box_x + checkbox_extent * 0.44, box_y + checkbox_extent * 0.73), to_point: UiCore::Vec2(box_x + checkbox_extent * 0.82, box_y + checkbox_extent * 0.27)}, check_ink)
                if widgets[index].focused:
                    focus_x: f32 = clamped_inset(current_theme.focus_inset, widgets[index].width)
                    focus_y: f32 = clamped_inset(current_theme.focus_inset, widgets[index].height)
                    left: f32 = widgets[index].x + focus_x
                    top: f32 = widgets[index].y + focus_y
                    right: f32 = widgets[index].x + widgets[index].width - focus_x
                    bottom: f32 = widgets[index].y + widgets[index].height - focus_y
                    UiCore::fill(UiCore::Line{from_point: UiCore::Vec2(left, top), to_point: UiCore::Vec2(right, top)}, current_theme.focus_ring)
                    UiCore::fill(UiCore::Line{from_point: UiCore::Vec2(right, top), to_point: UiCore::Vec2(right, bottom)}, current_theme.focus_ring)
                    UiCore::fill(UiCore::Line{from_point: UiCore::Vec2(right, bottom), to_point: UiCore::Vec2(left, bottom)}, current_theme.focus_ring)
                    UiCore::fill(UiCore::Line{from_point: UiCore::Vec2(left, bottom), to_point: UiCore::Vec2(left, top)}, current_theme.focus_ring)
                if widgets[index].kind == UiConst::WidgetKind.TextField:
                    field_value: sview = text_value(index)
                    text_inset: f32 = clamped_inset(current_theme.text_horizontal_padding, widgets[index].width)
                    available_width: mutable f32 = widgets[index].width - text_inset * 2.0
                    available_width <- 0.0 if available_width < 0.0 else available_width
                    visible_start: mutable usize = 0
                    visible_start <- visible_text_start(index, available_width) if widgets[index].focused
                    visible_stop: mutable usize = visible_start
                    scan: mutable usize = visible_start
                    while scan < widgets[index].input_length |scan, visible_stop, visible_start, available_width|:
                        after: usize = next_character(index, scan)
                        break if measure_text_range(index, visible_start, after) > available_width
                        visible_stop <- after
                        scan <- after
                    visible_value: sview = display_range(index, visible_start, visible_stop)
                    display_text: sview = visible_value if field_value.len > 0 else widgets[index].placeholder
                    field_ink: mutable UiCore::Color = widgets[index].text_color
                    field_ink <- muted_color(field_ink) if not enabled
                    if field_value.len == 0:
                        field_ink <- UiCore::Color{r: field_ink.r / 2, g: field_ink.g / 2, b: field_ink.b / 2, a: field_ink.a}
                    field_y: f32 = widgets[index].y + (widgets[index].height - ui_text_line_height(widgets[index].text_size)) / 2.0
                    selected_start: mutable usize = selection_start(index)
                    selected_stop: mutable usize = selection_end(index)
                    selected_start <- visible_start if selected_start < visible_start else selected_start
                    selected_stop <- visible_stop if selected_stop > visible_stop else selected_stop
                    if selected_stop > selected_start:
                        selection_x: f32 = widgets[index].x + text_inset + measure_text_range(index, visible_start, selected_start)
                        selection_width: f32 = measure_text_range(index, selected_start, selected_stop)
                        selection_inset: f32 = clamped_inset(current_theme.selection_vertical_inset, widgets[index].height)
                        UiCore::fill(UiCore::Rect(selection_x, widgets[index].y + selection_inset, selection_width, widgets[index].height - selection_inset * 2.0), current_theme.selection)
                    UiCore::draw(UiCore::TextRun(UiCore::Vec2(widgets[index].x + text_inset, field_y), widgets[index].text_size, display_text), field_ink)
                    marked_start: mutable usize = widgets[index].marked_start
                    marked_stop: mutable usize = widgets[index].marked_end
                    marked_start <- visible_start if marked_start < visible_start else marked_start
                    marked_stop <- visible_stop if marked_stop > visible_stop else marked_stop
                    if marked_stop > marked_start:
                        marked_x: f32 = widgets[index].x + text_inset + measure_text_range(index, visible_start, marked_start)
                        marked_width: f32 = measure_text_range(index, marked_start, marked_stop)
                        # Keep the composition underline inside the field even
                        # when a theme supplies an inset larger than its
                        # current widget height.
                        marked_inset: f32 = clamped_inset(current_theme.marked_underline_inset, widgets[index].height)
                        marked_y: f32 = widgets[index].y + widgets[index].height - marked_inset
                        UiCore::fill(UiCore::Line{from_point: UiCore::Vec2(marked_x, marked_y), to_point: UiCore::Vec2(marked_x + marked_width, marked_y)}, widgets[index].text_color)
                    if widgets[index].focused and selection_start(index) == selection_end(index) and caret_is_visible():
                        caret_x: f32 = widgets[index].x + text_inset + measure_text_range(index, visible_start, widgets[index].caret)
                        caret_inset: f32 = clamped_inset(current_theme.text_vertical_padding, widgets[index].height)
                        UiCore::fill(UiCore::Line{from_point: UiCore::Vec2(caret_x, widgets[index].y + caret_inset), to_point: UiCore::Vec2(caret_x, widgets[index].y + widgets[index].height - caret_inset)}, widgets[index].text_color)
                    continue
                continue if widgets[index].text_size <= 0.0 or widgets[index].text.len == 0
                # Button captions are centered in their hit target. Ordinary labels
                # remain leading-aligned, which is the useful default for content.
                text_y: f32 = widgets[index].y + (widgets[index].height - ui_text_line_height(widgets[index].text_size)) / 2.0
                text_x: mutable f32 = widgets[index].x
                text_width: f32 = ui_measure_text_width(widgets[index].text, widgets[index].text_size)
                if widgets[index].kind == UiConst::WidgetKind.Button:
                    text_x <- widgets[index].x + (widgets[index].width - text_width) / 2.0
                elif widgets[index].kind == UiConst::WidgetKind.RadioButton or widgets[index].kind == UiConst::WidgetKind.CheckBox:
                    marker_space: f32 = current_theme.choice_text_space
                    text_x <- widgets[index].x + marker_space + (widgets[index].width - marker_space - text_width) / 2.0
                ink: mutable UiCore::Color = widgets[index].text_color
                ink <- muted_color(ink) if not enabled
                UiCore::draw(UiCore::TextRun(UiCore::Vec2(text_x, text_y), widgets[index].text_size, widgets[index].text), ink)
            # Indicators are emitted after content so they remain readable over
            # translated children and nested scroll areas.
            for index in 0..<widget_count:
                continue if not effectively_visible(index) or not intersects_scroll_viewports(index)
                set_scroll_clip(index)
                paint_scrollbar(index)
            UiCore::clear_clip()
