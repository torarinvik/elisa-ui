# Minimal retained-tree identity facts shared by adapters.
#
# This module intentionally includes only the flat state needed to identify a
# live slot. It does not pull in text, clipboard, layout, or paint extensions,
# so a standalone ABI adapter can validate identity without acquiring backend
# symbols. The retained storage remains private to UiFlat.

include "./ui_flat_types.elisa"
include "./ui_flat_state.elisa"

extend UiFlat:
    public:
        def identity_lifetime() -> usize:
            return widget_epoch

        def identity_is_valid(index: usize) -> bool:
            return index < widget_count
