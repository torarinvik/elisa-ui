# elisa-ui widget operations: layout, hit testing, and painting over the sealed
# widget hierarchy. Extends `UiWidgets` (types in ui_hierarchy.elisa).
#
# The algorithm is wxWidgets' sizer reduced to its load-bearing parts: measure
# bottom-up so every node knows its minimum, then arrange top-down handing each
# child its minimum plus a share of the leftover proportional to `grow`. Two
# passes means a container's size never depends on the order its children were
# added.
#
# Geometry, hover/press state and the child links are `common:` fields of the
# root, so the passes read and write them through the handle directly. The
# `match`es below are over what DIFFERS per kind, and each one is exhaustive
# over the whole tree: adding a widget kind is a compile error at each site
# that must handle it rather than a silently missed case -- which is the entire
# reason for splitting `Widget` into sealed sub-categories instead of writing
# one flat enum.
#
# Public: the per-kind queries, `layout`, `hit`, `paint`, `pointer`, and the
# `hot`/`active` readers. Private: the passes and the pointer state.

include "./ui_hierarchy.elisa"

extend UiWidgets:
    public:
        # The axis a container distributes its children along. A leaf has no
        # axis; UiConst::Axis.Column is returned so callers need no special case.
        def axis_of(w: Widget) -> UiConst::Axis:
            match w:
                Window.Top(title, resizable):
                    return UiConst::Axis.Column
                Window.Floating(title):
                    return UiConst::Axis.Column
                Container.Box(axis, padding, spacing, fill):
                    return axis
                Container.Grid(columns, padding, spacing, fill):
                    return UiConst::Axis.Column
                Container.Scroll(axis, offset, fill):
                    return axis
                Container.ScrollWithState(axis, state, fill):
                    return axis
                Control.Label(text, size, ink):
                    return UiConst::Axis.Column
                Control.Gauge(fraction, track, bar):
                    return UiConst::Axis.Column
                Control.Slider(value, low, high, track, knob):
                    return UiConst::Axis.Column
                Control.TextBox(text, caret, size, ink, fill):
                    return UiConst::Axis.Column
                Button.Push(label, rest, hover, press):
                    return UiConst::Axis.Column
                Button.Toggle(label, on, rest, hover, press):
                    return UiConst::Axis.Column
                Button.Check(label, checked, rest, hover, press):
                    return UiConst::Axis.Column
                Button.Radio(label, group, selected, rest, hover, press):
                    return UiConst::Axis.Column

        # Inner margin a container reserves on every side.
        def padding_of(w: Widget) -> f32:
            match w:
                Window.Top(title, resizable):
                    return 0.0
                Window.Floating(title):
                    return 0.0
                Container.Box(axis, padding, spacing, fill):
                    return padding
                Container.Grid(columns, padding, spacing, fill):
                    return padding
                Container.Scroll(axis, offset, fill):
                    return 0.0
                Container.ScrollWithState(axis, state, fill):
                    return 0.0
                Control.Label(text, size, ink):
                    return 0.0
                Control.Gauge(fraction, track, bar):
                    return 0.0
                Control.Slider(value, low, high, track, knob):
                    return 0.0
                Control.TextBox(text, caret, size, ink, fill):
                    return 0.0
                Button.Push(label, rest, hover, press):
                    return 0.0
                Button.Toggle(label, on, rest, hover, press):
                    return 0.0
                Button.Check(label, checked, rest, hover, press):
                    return 0.0
                Button.Radio(label, group, selected, rest, hover, press):
                    return 0.0

        # Scroll containers keep their viewport box while translating the
        # arranged content along the declared axis. The offset is intentionally
        # read here, in Elisa, so every backend sees identical child geometry.
        def scroll_offset_of(w: Widget) -> f32:
            match w:
                Container.Scroll(axis, offset, fill):
                    return UiCore::nonnegative_extent(offset)
                Container.ScrollWithState(axis, state, fill):
                    return UiCore::nonnegative_extent(state.offset)
                _:
                    return 0.0

        # Gap a container leaves between adjacent children.
        def spacing_of(w: Widget) -> f32:
            match w:
                Window.Top(title, resizable):
                    return 0.0
                Window.Floating(title):
                    return 0.0
                Container.Box(axis, padding, spacing, fill):
                    return spacing
                Container.Grid(columns, padding, spacing, fill):
                    return spacing
                Container.Scroll(axis, offset, fill):
                    return 0.0
                Container.ScrollWithState(axis, state, fill):
                    return 0.0
                Control.Label(text, size, ink):
                    return 0.0
                Control.Gauge(fraction, track, bar):
                    return 0.0
                Control.Slider(value, low, high, track, knob):
                    return 0.0
                Control.TextBox(text, caret, size, ink, fill):
                    return 0.0
                Button.Push(label, rest, hover, press):
                    return 0.0
                Button.Toggle(label, on, rest, hover, press):
                    return 0.0
                Button.Check(label, checked, rest, hover, press):
                    return 0.0
                Button.Radio(label, group, selected, rest, hover, press):
                    return 0.0

        # Whether the widget can hold children. Only containers and windows
        # nest; `children` uses this to leave a leaf's `first_child` null.
        def can_nest(w: Widget) -> bool:
            match w:
                Window.Top(title, resizable):
                    return true
                Window.Floating(title):
                    return true
                Container.Box(axis, padding, spacing, fill):
                    return true
                Container.Grid(columns, padding, spacing, fill):
                    return true
                Container.Scroll(axis, offset, fill):
                    return true
                Container.ScrollWithState(axis, state, fill):
                    return true
                Control.Label(text, size, ink):
                    return false
                Control.Gauge(fraction, track, bar):
                    return false
                Control.Slider(value, low, high, track, knob):
                    return false
                Control.TextBox(text, caret, size, ink, fill):
                    return false
                Button.Push(label, rest, hover, press):
                    return false
                Button.Toggle(label, on, rest, hover, press):
                    return false
                Button.Check(label, checked, rest, hover, press):
                    return false
                Button.Radio(label, group, selected, rest, hover, press):
                    return false

        # Whether the widget takes pointer input. Buttons, sliders and text
        # boxes do; labels, gauges and containers are inert, so a click falls
        # through them.
        def is_interactive(w: Widget) -> bool:
            match w:
                Window.Top(title, resizable):
                    return false
                Window.Floating(title):
                    return false
                Container.Box(axis, padding, spacing, fill):
                    return false
                Container.Grid(columns, padding, spacing, fill):
                    return false
                Container.Scroll(axis, offset, fill):
                    return false
                Container.ScrollWithState(axis, state, fill):
                    return false
                Control.Label(text, size, ink):
                    return false
                Control.Gauge(fraction, track, bar):
                    return false
                Control.Slider(value, low, high, track, knob):
                    return true
                Control.TextBox(text, caret, size, ink, fill):
                    return true
                Button.Push(label, rest, hover, press):
                    return true
                Button.Toggle(label, on, rest, hover, press):
                    return true
                Button.Check(label, checked, rest, hover, press):
                    return true
                Button.Radio(label, group, selected, rest, hover, press):
                    return true

    # ------------------------------------------------------------------
    # Layout: measure bottom-up, then arrange top-down.
    # ------------------------------------------------------------------

    private:
        # The amount of content that can be revealed by a stateful viewport.
        # Child boxes already contain the current translation, so adding the
        # current offset recovers their unscrolled extent without a second
        # measurement pass or any backend-specific bookkeeping.
        def scroll_content_extent(w: Widget) -> f32:
            is_row: bool = axis_of(w) == UiConst::Axis.Row
            translated: f32 = scroll_offset_of(w)
            extent: mutable f32 = 0.0
            cursor: mutable Widget? = w.first_child
            while cursor is node |extent, cursor, is_row, translated, w|:
                end: f32 = node.x - w.x + node.width + translated if is_row else node.y - w.y + node.height + translated
                end <- 0.0 if end < 0.0
                extent <- end if end > extent
                cursor <- node.next_sibling
            return extent

        # Value-bearing controls share the same normalized range contract as
        # UiControls and UiFlat. Keep direct hierarchy painting from drawing
        # past its box when an application supplies an out-of-range value.
        def normalized_slider_ratio(value: f32, low: f32, high: f32) -> f32:
            lower: mutable f32 = UiCore::finite_or_zero(low)
            upper: mutable f32 = UiCore::finite_or_zero(high)
            if upper < lower:
                swap: f32 = lower
                lower <- upper
                upper <- swap
            span: f32 = upper - lower
            return 0.0 if span <= 0.0
            normalized: f32 = (UiCore::finite_or_zero(value) - lower) / span
            return UiCore::normalized_unit(normalized)

        # How many children a node has. Walks the sibling chain rather than
        # storing a count, so adding or removing a child needs no bookkeeping.
        def child_count(w: Widget) -> f32:
            total: mutable f32 = 0.0
            cursor: mutable Widget? = w.first_child
            while cursor is node |total, cursor|:
                total <- total + 1.0
                cursor <- node.next_sibling
            return total

        # Bottom-up pass. A container's minimum is its children's minima summed
        # along its axis (plus spacing and padding) and maximised across it. A
        # declared minimum still wins when it is larger, which is how a button
        # reserves its clickable area even with a short label.
        def measure(w: Widget) -> void:
            w.min_width <- UiCore::nonnegative_extent(w.min_width)
            w.min_height <- UiCore::nonnegative_extent(w.min_height)
            # Grid is the one container whose main-axis demand is not a simple
            # sibling sum. Measure a uniform cell from the largest child, then
            # derive the number of rows from the fixed column count.
            match w:
                Container.Grid(columns, padding, spacing, fill):
                    child: Widget? = w.first_child
                    return if child == null
                    columns_count: f32 = columns.i64().f32() if columns > 0 else 1.0
                    widest: mutable f32 = 0.0
                    tallest: mutable f32 = 0.0
                    count: mutable f32 = 0.0
                    cursor: mutable Widget? = child
                    while cursor is node |widest, tallest, count, cursor|:
                        measure(node)
                        child_width: f32 = UiCore::nonnegative_extent(node.min_width)
                        child_height: f32 = UiCore::nonnegative_extent(node.min_height)
                        widest <- child_width if child_width > widest else widest
                        tallest <- child_height if child_height > tallest else tallest
                        count <- count + 1.0
                        cursor <- node.next_sibling
                    rows: mutable f32 = 0.0
                    remaining: mutable f32 = count
                    while remaining > 0.0 |rows, remaining, columns_count|:
                        rows <- rows + 1.0
                        remaining <- remaining - columns_count
                    gaps_x: f32 = spacing * (columns_count - 1.0) if columns_count > 1.0 else 0.0
                    gaps_y: f32 = spacing * (rows - 1.0) if rows > 1.0 else 0.0
                    content_width: f32 = widest * columns_count + gaps_x + padding * 2.0
                    content_height: f32 = tallest * rows + gaps_y + padding * 2.0
                    w.min_width <- content_width if content_width > w.min_width
                    w.min_height <- content_height if content_height > w.min_height
                    return
                _:
                    pass
            child: Widget? = w.first_child
            return if child == null
            is_row: bool = axis_of(w) == UiConst::Axis.Row
            along: mutable f32 = 0.0
            across: mutable f32 = 0.0
            count: mutable f32 = 0.0
            cursor: mutable Widget? = child
            while cursor is node |along, across, count, cursor, is_row|:
                measure(node)
                child_along: f32 = UiCore::nonnegative_extent(node.min_width if is_row else node.min_height)
                child_across: f32 = UiCore::nonnegative_extent(node.min_height if is_row else node.min_width)
                along <- along + child_along
                across <- child_across if child_across > across else across
                count <- count + 1.0
                cursor <- node.next_sibling
            gaps: f32 = UiCore::nonnegative_extent(spacing_of(w)) * (count - 1.0) if count > 1.0 else 0.0
            pad: f32 = UiCore::nonnegative_extent(padding_of(w)) * 2.0
            content_width: f32 = along + gaps + pad if is_row else across + pad
            content_height: f32 = across + pad if is_row else along + gaps + pad
            w.min_width <- content_width if content_width > w.min_width
            w.min_height <- content_height if content_height > w.min_height

        # Top-down pass. Every child gets its minimum along the axis, then the
        # leftover is shared in proportion to `grow`; children stretch to fill
        # the cross axis. A container with no growing child simply leaves the
        # slack unused, which is wxSizer's behaviour when no item has a
        # non-zero proportion.
        def arrange(w: Widget, x: f32, y: f32, width: f32, height: f32) -> void:
            w with { x, y, width, height }
            first: Widget? = w.first_child
            return if first == null

            # Fixed-column grid placement. Cells are uniform so a row remains
            # aligned even when its children have different intrinsic minima.
            match w:
                Container.Grid(columns, padding, spacing, fill):
                    columns_count: f32 = columns.i64().f32() if columns > 0 else 1.0
                    widest: mutable f32 = 0.0
                    tallest: mutable f32 = 0.0
                    count: mutable f32 = 0.0
                    scan: mutable Widget? = first
                    while scan is node |widest, tallest, count, scan|:
                        child_width: f32 = UiCore::nonnegative_extent(node.min_width)
                        child_height: f32 = UiCore::nonnegative_extent(node.min_height)
                        widest <- child_width if child_width > widest else widest
                        tallest <- child_height if child_height > tallest else tallest
                        count <- count + 1.0
                        scan <- node.next_sibling
                    rows: mutable f32 = 0.0
                    remaining: mutable f32 = count
                    while remaining > 0.0 |rows, remaining, columns_count|:
                        rows <- rows + 1.0
                        remaining <- remaining - columns_count
                    pad: f32 = UiCore::nonnegative_extent(padding)
                    gap: f32 = UiCore::nonnegative_extent(spacing)
                    inner_x: f32 = x + pad
                    inner_y: f32 = y + pad
                    raw_inner_width: f32 = width - pad * 2.0
                    raw_inner_height: f32 = height - pad * 2.0
                    inner_width: f32 = UiCore::nonnegative_extent(raw_inner_width)
                    inner_height: f32 = UiCore::nonnegative_extent(raw_inner_height)
                    gaps_x: f32 = gap * (columns_count - 1.0) if columns_count > 1.0 else 0.0
                    gaps_y: f32 = gap * (rows - 1.0) if rows > 1.0 else 0.0
                    cell_width: mutable f32 = (inner_width - gaps_x) / columns_count
                    cell_height: mutable f32 = (inner_height - gaps_y) / rows
                    cell_width <- 0.0 if cell_width < 0.0
                    cell_height <- 0.0 if cell_height < 0.0
                    cell_width <- widest if cell_width < widest else cell_width
                    cell_height <- tallest if cell_height < tallest else cell_height
                    column: mutable f32 = 0.0
                    row: mutable f32 = 0.0
                    walk: mutable Widget? = first
                    while walk is node |column, row, walk, inner_x, inner_y, cell_width, cell_height, gap, columns_count|:
                        arrange(node, inner_x + column * (cell_width + gap), inner_y + row * (cell_height + gap), cell_width, cell_height)
                        column <- column + 1.0
                        if column >= columns_count:
                            column <- 0.0
                            row <- row + 1.0
                        walk <- node.next_sibling
                    return
                _:
                    pass

            is_row: bool = axis_of(w) == UiConst::Axis.Row
            pad: f32 = UiCore::nonnegative_extent(padding_of(w))
            gap: f32 = UiCore::nonnegative_extent(spacing_of(w))
            inner_x: f32 = x + pad
            inner_y: f32 = y + pad
            raw_inner_width: f32 = width - pad * 2.0
            raw_inner_height: f32 = height - pad * 2.0
            inner_width: f32 = UiCore::nonnegative_extent(raw_inner_width)
            inner_height: f32 = UiCore::nonnegative_extent(raw_inner_height)
            count: f32 = child_count(w)
            gaps: f32 = gap * (count - 1.0) if count > 1.0 else 0.0
            inner_along: f32 = inner_width if is_row else inner_height
            scroll_offset: f32 = scroll_offset_of(w)

            # First walk: what the children demand, and how much weight wants
            # the rest.
            demand: mutable f32 = 0.0
            weight: mutable f32 = 0.0
            scan: mutable Widget? = first
            while scan is node |demand, weight, scan, is_row|:
                demand <- demand + UiCore::nonnegative_extent(node.min_width if is_row else node.min_height)
                weight <- weight + UiCore::nonnegative_extent(node.grow)
                scan <- node.next_sibling

            free: f32 = inner_along - gaps - demand
            share: f32 = free / weight if weight > 0.0 and free > 0.0 else 0.0

            # Second walk: place each child at the running offset.
            offset: mutable f32 = 0.0
            walk: mutable Widget? = first
            while walk is node |offset, walk, is_row, inner_x, inner_y, inner_width, inner_height, share, scroll_offset|:
                base: f32 = UiCore::nonnegative_extent(node.min_width if is_row else node.min_height)
                extent: f32 = base + share * UiCore::nonnegative_extent(node.grow)
                if is_row:
                    arrange(node, inner_x + offset - scroll_offset, inner_y, extent, inner_height)
                else:
                    arrange(node, inner_x, inner_y + offset - scroll_offset, inner_width, extent)
                offset <- offset + extent + gap
                walk <- node.next_sibling

    public:
        # Lay out a whole tree into a surface of the given size.
        def layout(root: Widget, width: f32, height: f32) -> void:
            measure(root)
            arrange(root, 0.0, 0.0, UiCore::nonnegative_extent(width), UiCore::nonnegative_extent(height))

        # Maximum legal offset, derived entirely from Elisa-owned geometry.
        # Non-scroll widgets deliberately report zero, making this safe for
        # callers that discover targets speculatively.
        def scroll_limit(w: Widget) -> f32:
            match w:
                Container.Scroll(axis, offset, fill):
                    viewport: f32 = UiCore::nonnegative_extent(w.width if axis == UiConst::Axis.Row else w.height)
                    content: f32 = scroll_content_extent(w)
                    return UiCore::nonnegative_extent(content - viewport)
                Container.ScrollWithState(axis, state, fill):
                    viewport: f32 = UiCore::nonnegative_extent(w.width if axis == UiConst::Axis.Row else w.height)
                    content: f32 = scroll_content_extent(w)
                    return UiCore::nonnegative_extent(content - viewport)
                _:
                    return 0.0

        # Move a stateful viewport to a clamped offset. The immutable Scroll
        # constructor remains useful for fixed initial translations, but cannot
        # be mutated through a packed handle and therefore reports no change.
        def scroll_to(w: Widget, requested: f32) -> bool:
            match w:
                Container.ScrollWithState(axis, state, fill):
                    current: f32 = UiCore::nonnegative_extent(state.offset)
                    limit: f32 = scroll_limit(w)
                    wanted: f32 = UiCore::nonnegative_extent(UiCore::finite_or_zero(requested))
                    next: f32 = limit if wanted > limit else wanted
                    difference: f32 = next - current if next >= current else current - next
                    state.offset <- next
                    return difference >= 0.0001
                _:
                    return false

    # ------------------------------------------------------------------
    # Hit testing
    # ------------------------------------------------------------------

    private:
        def contains(w: Widget, x: f32, y: f32) -> bool:
            return x >= w.x and y >= w.y and x < w.x + w.width and y < w.y + w.height

    public:
        # The topmost interactive widget under the pointer. Children are
        # painted after their parent, so a depth-first walk that prefers the
        # LAST matching descendant returns what the user sees on top.
        def hit(w: Widget, x: f32, y: f32) -> Widget?:
            return null if not contains(w, x, y)
            found: mutable Widget? = null
            cursor: mutable Widget? = w.first_child
            while cursor is node |found, cursor, x, y|:
                deeper: Widget? = hit(node, x, y)
                found <- deeper if deeper != null
                cursor <- node.next_sibling
            return found if found != null
            return w if is_interactive(w)
            return null

    # ------------------------------------------------------------------
    # Painting
    # ------------------------------------------------------------------

    public:
        # The widget's resolved box, as one value.
        def box_of(w: Widget) -> UiCore::Rect:
            return UiCore::Rect(w.x, w.y, w.width, w.height)

    private:
        # The surface colour a widget draws right now. A pressable widget
        # reports its press or hover colour when the pointer says so.
        def fill_of(w: Widget) -> UiCore::Color:
            pressed: bool = w.pressed
            hovered: bool = w.hovered
            match w:
                Window.Top(title, resizable):
                    return UiCore::Color{r: 0, g: 0, b: 0, a: 0}
                Window.Floating(title):
                    return UiCore::Color{r: 0, g: 0, b: 0, a: 0}
                Container.Box(axis, padding, spacing, fill):
                    return fill
                Container.Grid(columns, padding, spacing, fill):
                    return fill
                Container.Scroll(axis, offset, fill):
                    return fill
                Container.ScrollWithState(axis, state, fill):
                    return fill
                Control.Label(text, size, ink):
                    return UiCore::Color{r: 0, g: 0, b: 0, a: 0}
                Control.Gauge(fraction, track, bar):
                    return track
                Control.Slider(value, low, high, track, knob):
                    return track
                Control.TextBox(text, caret, size, ink, fill):
                    return fill
                Button.Push(label, rest, hover, press):
                    return press if pressed
                    return hover if hovered
                    return rest
                Button.Toggle(label, on, rest, hover, press):
                    return press if pressed
                    return hover if hovered
                    return rest
                Button.Check(label, checked, rest, hover, press):
                    return press if pressed
                    return hover if hovered
                    return rest
                Button.Radio(label, group, selected, rest, hover, press):
                    return press if pressed
                    return hover if hovered
                    return rest

        # The parts that are not just a filled box: text runs and the moving
        # pieces of gauges and sliders.
        def paint_content(w: Widget) -> void:
            box_x: f32 = w.x
            box_y: f32 = w.y
            box_width: f32 = w.width
            box_height: f32 = w.height
            box: UiCore::Rect = box_of(w)
            match w:
                Window.Top(title, resizable):
                    pass
                Window.Floating(title):
                    pass
                Container.Box(axis, padding, spacing, fill):
                    pass
                Container.Grid(columns, padding, spacing, fill):
                    pass
                Container.Scroll(axis, offset, fill):
                    pass
                Container.ScrollWithState(axis, state, fill):
                    pass
                Control.Label(text, size, ink):
                    text_y: f32 = box_y + (box_height - ui_text_line_height(size)) / 2.0
                    UiCore::draw(UiCore::TextRun(UiCore::Vec2(box_x, text_y), size, text), ink)
                Control.Gauge(fraction, track, bar):
                    filled: f32 = box_width * UiCore::normalized_unit(fraction)
                    UiCore::fill(UiCore::Rect(box_x, box_y, filled, box_height), bar) if filled > 0.0
                Control.Slider(value, low, high, track, knob):
                    ratio: f32 = normalized_slider_ratio(value, low, high)
                    knob_x: f32 = box_x + (box_width - box_height) * ratio
                    UiCore::fill(UiCore::Rect(knob_x, box_y, box_height, box_height), knob)
                Control.TextBox(text, caret, size, ink, fill):
                    text_y: f32 = box_y + (box_height - ui_text_line_height(size)) / 2.0
                    UiCore::draw(UiCore::TextRun(UiCore::Vec2(box_x, text_y), size, text), ink)
                Button.Push(label, rest, hover, press):
                    label_y: f32 = box_y + (box_height - ui_text_line_height(14.0)) / 2.0
                    UiCore::draw(UiCore::TextRun(UiCore::Vec2(box_x, label_y), 14.0, label), UiCore::rgb(255, 255, 255)) if label.len != 0
                Button.Toggle(label, on, rest, hover, press):
                    label_y: f32 = box_y + (box_height - ui_text_line_height(14.0)) / 2.0
                    UiCore::draw(UiCore::TextRun(UiCore::Vec2(box_x, label_y), 14.0, label), UiCore::rgb(255, 255, 255)) if label.len != 0
                Button.Check(label, checked, rest, hover, press):
                    label_y: f32 = box_y + (box_height - ui_text_line_height(14.0)) / 2.0
                    UiCore::draw(UiCore::TextRun(UiCore::Vec2(box_x, label_y), 14.0, label), UiCore::rgb(255, 255, 255)) if label.len != 0
                Button.Radio(label, group, selected, rest, hover, press):
                    label_y: f32 = box_y + (box_height - ui_text_line_height(14.0)) / 2.0
                    UiCore::draw(UiCore::TextRun(UiCore::Vec2(box_x, label_y), 14.0, label), UiCore::rgb(255, 255, 255)) if label.len != 0

    public:
        # Emit one widget's own drawing, then recurse into its children.
        # Pre-order gives painter's-algorithm ordering for free: a parent's
        # background is laid down before anything it contains.
        def paint(w: Widget) -> void:
            surface: UiCore::Color = fill_of(w)
            if surface.a != 0:
                UiCore::fill(box_of(w), surface)
            paint_content(w)
            cursor: mutable Widget? = w.first_child
            while cursor is node |cursor|:
                paint(node)
                cursor <- node.next_sibling

    # ------------------------------------------------------------------
    # Pointer state machine
    # ------------------------------------------------------------------
    #
    # A click is press-then-release on the SAME widget, which is what every
    # desktop toolkit means by a click: dragging off a button before releasing
    # cancels it. The hot/active pair is wxWidgets' capture model reduced to
    # what a retained tree needs -- `hot` is what the pointer is over, `active`
    # is what holds the press. Only the active widget ever has `pressed` set,
    # so "released on the widget that was pressed" is "the hit widget is
    # pressed" and needs no handle comparison.

    private:
        global mutable hot_widget: Widget? = null
        global mutable active_widget: Widget? = null

        # Find the innermost viewport under a pointer. A child is searched
        # first so nested scroll areas consume the wheel before an ancestor.
        def scroll_target(w: Widget, x: f32, y: f32) -> Widget?:
            return null if not contains(w, x, y)
            cursor: mutable Widget? = w.first_child
            while cursor is node |cursor, x, y|:
                found: Widget? = scroll_target(node, x, y)
                return found if found != null
                cursor <- node.next_sibling
            match w:
                Container.Scroll(axis, offset, fill):
                    return w
                Container.ScrollWithState(axis, state, fill):
                    return w
                _:
                    return null

        # Route a wheel event to the viewport under the pointer. Native wheel
        # deltas follow AppKit/SDL convention (negative means content moves
        # down), hence subtracting the delta from the logical offset.
        def scroll_pointer(root: Widget, at: UiCore::Vec2, delta: UiCore::Vec2) -> void:
            target: Widget? = scroll_target(root, at.x, at.y)
            return if target == null
            if target is viewport:
                axis: UiConst::Axis = axis_of(viewport)
                amount: f32 = delta.x if axis == UiConst::Axis.Row else delta.y
                current: f32 = scroll_offset_of(viewport)
                changed: bool = scroll_to(viewport, current - amount)
                layout(root, root.width, root.height) if changed

        # One function per pointer kind. `root` is a real parameter in each: a body
        # reaching the widget store only through a global has no store to decode a
        # handle against, which stage0 rejects outright and stage1 now declines
        # (43a08c31). Every one of them uses it for the hit test anyway.

        # Move the hover to whatever is under `at`, and report it.
        def hover_at(root: Widget, at: UiCore::Vec2) -> Widget?:
            target: Widget? = hit(root, at.x, at.y)
            if hot_widget is previous:
                previous.hovered <- false
            hot_widget <- target
            if target is over:
                over.hovered <- true
            return target

        def press_at(root: Widget, at: UiCore::Vec2, button: i32) -> void:
            return if button != UiCore::PointerButton.Primary.i32()
            target: Widget? = hover_at(root, at)
            if target is pressed_now:
                active_widget <- target
                pressed_now.pressed <- true

        # A click is a release ON the widget that holds the press, which is exactly
        # "the widget under the pointer is pressed" -- only the active one ever is.
        def release_at(root: Widget, at: UiCore::Vec2, button: i32) -> void:
            return if button != UiCore::PointerButton.Primary.i32()
            target: Widget? = hover_at(root, at)
            clicked: mutable bool = false
            if target is released_on:
                clicked <- released_on.pressed
            if active_widget is held:
                held.pressed <- false
            active_widget <- null
            if clicked and target is clicked_widget:
                app_widget_event(clicked_widget, UiConst::WidgetEvent.Click.i32())

        def leave_all(root: Widget) -> void:
            _ = hover_at(root, UiCore::Vec2(0.0, 0.0))
            if active_widget is held:
                held.pressed <- false
            active_widget <- null
            if hot_widget is left:
                left.hovered <- false
            hot_widget <- null

    public:
        # What the pointer is over, and what holds the press.
        def hot() -> Widget?:
            return hot_widget

        def active() -> Widget?:
            return active_widget

        # Feed one event through the tree. `root` is the tree being tested. Anything
        # that is not a pointer event is ignored, so an app can hand the whole stream
        # over without sorting it first.
        def pointer(root: Widget, event: UiCore::Event) -> void:
            match event:
                UiCore::PointerEvent.Move(move_at):
                    _ = hover_at(root, move_at)
                UiCore::PointerEvent.Down(down_at, down_button):
                    press_at(root, down_at, down_button)
                UiCore::PointerEvent.Up(up_at, up_button):
                    release_at(root, up_at, up_button)
                UiCore::PointerEvent.Scroll(scroll_at, scroll_delta):
                    scroll_pointer(root, scroll_at, scroll_delta)
                UiCore::PointerEvent.Leave:
                    leave_all(root)
                _:
                    pass
