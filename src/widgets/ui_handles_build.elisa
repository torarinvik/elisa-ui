# Typed UiHandles constructors.

include "./ui_theme.elisa"

extend UiHandles:
    public:
        # Constructors preserve UiFlat's defaults while returning a checked
        # typed value. A stale parent is rejected rather than turned into a
        # root, which makes view destruction/rebuild deterministic.
        def panel(parent: Handle, axis: UiConst::Axis, padding: f32, spacing: f32, color: UiCore::Color) -> Handle:
            return invalid() if not parent_is_valid(parent)
            return from_index(UiFlat::panel(parent_index(parent), axis, padding, spacing, color))

        def row(parent: Handle, padding: f32, spacing: f32, color: UiCore::Color) -> Handle:
            return panel(parent, UiConst::Axis.Row, padding, spacing, color)

        def column(parent: Handle, padding: f32, spacing: f32, color: UiCore::Color) -> Handle:
            return panel(parent, UiConst::Axis.Column, padding, spacing, color)

        def scroll(parent: Handle, axis: UiConst::Axis, min_width: f32, min_height: f32, color: UiCore::Color) -> Handle:
            return invalid() if not parent_is_valid(parent)
            return from_index(UiFlat::scroll(parent_index(parent), axis, min_width, min_height, color))

        def button(parent: Handle, min_width: f32, min_height: f32, color: UiCore::Color, hover: UiCore::Color, press: UiCore::Color) -> Handle:
            return invalid() if not parent_is_valid(parent)
            return from_index(UiFlat::button(parent_index(parent), min_width, min_height, color, hover, press))

        # Theme-aware convenience constructor. Explicit-size `button` remains
        # unchanged; this opt-in form derives a minimum activation height from
        # the shared high-contrast/large-text geometry policy.
        def button_accessible(parent: Handle, min_width: f32, color: UiCore::Color, hover: UiCore::Color, press: UiCore::Color, system_high_contrast: bool) -> Handle:
            preferences: UiTheme::Preferences = UiTheme::current_preferences()
            target: f32 = UiTheme::scaled_metrics(preferences, system_high_contrast).minimum_touch_target
            return button(parent, min_width, target, color, hover, press)

        def radio_button(parent: Handle, min_width: f32, min_height: f32, color: UiCore::Color, hover: UiCore::Color, press: UiCore::Color) -> Handle:
            return invalid() if not parent_is_valid(parent)
            return from_index(UiFlat::radio_button(parent_index(parent), min_width, min_height, color, hover, press))

        def check_box(parent: Handle, min_width: f32, min_height: f32, color: UiCore::Color, hover: UiCore::Color, press: UiCore::Color) -> Handle:
            return invalid() if not parent_is_valid(parent)
            return from_index(UiFlat::check_box(parent_index(parent), min_width, min_height, color, hover, press))

        # Keep the original no-caption constructors for source compatibility;
        # the labeled forms are the preferred API for new applications.
        def slider(parent: Handle, min_width: f32, min_height: f32, value: f32, track: UiCore::Color, fill: UiCore::Color, thumb: UiCore::Color) -> Handle:
            return slider_labeled(parent, "", min_width, min_height, value, track, fill, thumb)

        def slider_labeled(parent: Handle, label: sview, min_width: f32, min_height: f32, value: f32, track: UiCore::Color, fill: UiCore::Color, thumb: UiCore::Color) -> Handle:
            return invalid() if not parent_is_valid(parent)
            return from_index(UiFlat::slider(parent_index(parent), label, min_width, min_height, value, track, fill, thumb))

        def progress_bar(parent: Handle, min_width: f32, min_height: f32, value: f32, track: UiCore::Color, fill: UiCore::Color) -> Handle:
            return progress_bar_labeled(parent, "", min_width, min_height, value, track, fill)

        def progress_bar_labeled(parent: Handle, label: sview, min_width: f32, min_height: f32, value: f32, track: UiCore::Color, fill: UiCore::Color) -> Handle:
            return invalid() if not parent_is_valid(parent)
            return from_index(UiFlat::progress_bar(parent_index(parent), label, min_width, min_height, value, track, fill))

        def text_field(parent: Handle, label: sview, placeholder: sview, initial: sview, min_width: f32, min_height: f32, size: f32, ink: UiCore::Color, fill: UiCore::Color) -> Handle:
            return invalid() if not parent_is_valid(parent)
            return from_index(UiFlat::text_field(parent_index(parent), label, placeholder, initial, min_width, min_height, size, ink, fill))

        def secure_text_field(parent: Handle, label: sview, placeholder: sview, initial: sview, min_width: f32, min_height: f32, size: f32, ink: UiCore::Color, fill: UiCore::Color) -> Handle:
            return invalid() if not parent_is_valid(parent)
            return from_index(UiFlat::secure_text_field(parent_index(parent), label, placeholder, initial, min_width, min_height, size, ink, fill))

        def label(parent: Handle, text: sview, size: f32, color: UiCore::Color) -> Handle:
            return invalid() if not parent_is_valid(parent)
            return from_index(UiFlat::label(parent_index(parent), text, size, color))
