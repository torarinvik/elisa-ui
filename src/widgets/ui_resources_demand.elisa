# Resource visibility demand hints and independent progress channels.

extend UiResources:
    public:
        struct DemandHint:
            handle: ResourceHandle
            owner: u32
            priority: u32

        # Visibility and prefetch policy stays in Elisa, while the host decides
        # whether a hint can be serviced under bandwidth/cache constraints.
        # A repeated hint is idempotent and only invalidates when its value
        # changes, so scrolling cannot create a request storm.
        def set_demand(handle: ResourceHandle, priority: u32) -> bool:
            return false if not UiResources::resource_is_valid(handle)
            slot: usize = handle.slot.usize()
            return false if resource_demanded[slot] and resource_priorities[slot] == priority
            resource_demanded[slot] <- true
            resource_priorities[slot] <- priority
            resource_mark_changed()
            return true

        def clear_demand(handle: ResourceHandle) -> bool:
            return false if not UiResources::resource_is_valid(handle) or not resource_demanded[handle.slot.usize()]
            resource_demanded[handle.slot.usize()] <- false
            resource_priorities[handle.slot.usize()] <- 0
            resource_mark_changed()
            return true

        # Hiding a view should release its visibility/prefetch hints without
        # cancelling the logical records. A later show can set fresh demand,
        # while owner disposal remains responsible for cancelling or releasing
        # the resources themselves.
        def clear_demand_owner(owner: u32) -> usize:
            cleared: mutable usize = 0
            for slot in 0..<resource_count:
                if resource_states[slot] != State.Unrequested and resource_owners[slot] == owner and resource_demanded[slot]:
                    resource_demanded[slot] <- false
                    resource_priorities[slot] <- 0
                    cleared <- cleared + 1
            resource_mark_changed() if cleared > 0
            return cleared

        def is_demanded(handle: ResourceHandle) -> bool:
            return UiResources::resource_is_valid(handle) and resource_demanded[handle.slot.usize()]

        def demand_priority(handle: ResourceHandle) -> u32:
            return 0 if not UiResources::resource_is_valid(handle) or not resource_demanded[handle.slot.usize()]
            return resource_priorities[handle.slot.usize()]

        # Hosts enumerate a bounded snapshot of visibility/prefetch work rather
        # than reaching into the resource arena. Results are ordered by slot so
        # repeated polling is deterministic; each hint carries its priority for
        # host-side coalescing and scheduling policy.
        def demand_count() -> usize:
            count: usize =
                for slot in 0..<resource_count |count: usize = 0| -> count:
                    count <- count + 1 if resource_states[slot] != State.Unrequested and resource_demanded[slot]
            return count

        def demand_at(index: usize) -> DemandHint:
            found: mutable usize = 0
            for slot in 0..<resource_count:
                continue if resource_states[slot] == State.Unrequested or not resource_demanded[slot]
                return DemandHint{handle: resource_make_handle(slot), owner: resource_owners[slot], priority: resource_priorities[slot]} if found == index
                found <- found + 1
            return DemandHint{handle: UiResources::resource_invalid(), owner: 0, priority: 0}

        # A host that services one hint at a time can select the highest
        # priority without sorting or allocating. Ties use the lowest slot for
        # stable ordering across polls.
        def highest_priority_demand() -> DemandHint:
            selected: mutable usize = MAX_RESOURCES
            selected_priority: mutable u32 = 0
            for slot in 0..<resource_count:
                continue if resource_states[slot] == State.Unrequested or not resource_demanded[slot]
                if selected == MAX_RESOURCES or resource_priorities[slot] > selected_priority:
                    selected <- slot
                    selected_priority <- resource_priorities[slot]
            return DemandHint{handle: resource_invalid(), owner: 0, priority: 0} if selected == MAX_RESOURCES
            return DemandHint{handle: resource_make_handle(selected), owner: resource_owners[selected], priority: selected_priority}

        # Hosts report transport/decode progress independently. Both fractions
        # are normalized before storage; network completion therefore does not
        # imply a resource is ready to paint.
        def set_progress(handle: ResourceHandle, network: f32, decode: f32) -> bool:
            return false if not UiResources::resource_is_valid(handle)
            return false if not UiCore::is_finite(network) or not UiCore::is_finite(decode)
            slot: usize = handle.slot.usize()
            # Progress belongs to the currently requested operation only. Once
            # it is cancelled or resolved, late host reports are stale and
            # must not dirty the replacement/presentation state.
            return false if resource_states[slot] != State.Requested
            next_network: f32 = UiCore::normalized_unit(network)
            next_decode: f32 = UiCore::normalized_unit(decode)
            # Progress callbacks can arrive out of order. A retry creates a
            # fresh generation, so decreases within this generation are stale
            # and must not make the visible loader regress.
            return false if next_network < resource_downloaded[slot] or next_decode < resource_decoded[slot]
            return false if resource_downloaded[slot] == next_network and resource_decoded[slot] == next_decode
            resource_downloaded[slot] <- next_network
            resource_decoded[slot] <- next_decode
            resource_mark_changed()
            return true
