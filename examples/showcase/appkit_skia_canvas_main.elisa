# The showcase painted by Skia into an AppKit custom canvas.
#
# Identical to appkit_canvas_main.elisa but for the painter: the same five
# pages, the same retained tree, the same command batch -- rasterized by Skia
# instead of CoreGraphics. That is the point of having both, and it is what
# makes a rendering difference between them attributable to the renderer.
# The optional native compositor is linked only by the Skia build script.

include "../../src/platform/appkit/ui_appkit_canvas_flat.elisa"
include "../../src/platform/appkit/ui_appkit_canvas_skia.elisa"
include "app.elisa"

def main() -> i64:
    # The sidebar plus the widest page decide the floor; the rest is app policy.
    return UiAppKitCanvas::run_with_min_size("Elisa UI Showcase (Skia)", 1180.0, 800.0, 980.0, 660.0)
