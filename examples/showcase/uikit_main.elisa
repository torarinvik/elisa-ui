# The showcase, painted by elisa-ui into a UIKit-hosted custom view.
#
# The five pages, the theming, the validation and the custom canvas are the
# same sources the macOS build runs. Only the launch options differ: the
# showcase's shell is laid out for a large landscape surface, which on iOS
# means an iPad rather than a phone.
include "../../src/platform/uikit/ui_uikit_flat.elisa"
include "app.elisa"

def main() -> i64:
    options: mutable UiUIKit::LaunchOptions = UiUIKit::default_launch_options()
    # The showcase paints its own full-bleed chrome and animates continuously,
    # so it hides the status bar and holds the display awake. Both are
    # application policy, stated here rather than inherited from UIKit.
    options.status_bar <- false
    options.idle_timer <- false
    # A 12.9-inch iPad in landscape, at its native 2x scale. These are only the
    # headless smoke dimensions; a real launch takes its surface from UIKit.
    options.snapshot_width <- 1366.0
    options.snapshot_height <- 1024.0
    options.snapshot_scale <- 2.0
    return UiUIKit::run_with_options(options)
