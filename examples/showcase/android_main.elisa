# The showcase on Android, painted by Skia behind a NativeActivity.
#
# The five pages, the theming, the validation and the custom canvas are the
# same sources every other build runs; this file only says which backend
# paints them. Unlike the storefront there are no pictures to hand over, so
# there is nothing here but the include and a program for the compiler.
include "../../src/platform/android/ui_android.elisa"
include "app.elisa"

def main() -> i64:
    # A NativeActivity has no main: the host's android_main is the entry and
    # this unit is a library. The symbol exists so the compiler has a program.
    return 0
