# The showcase, painted by elisa-ui into an AppKit-hosted custom canvas.
include "../../src/platform/appkit/ui_appkit_canvas_flat.elisa"
include "app.elisa"

def main() -> i64:
    # The sidebar plus the widest page decide the floor; the rest is app policy.
    return UiAppKitCanvas::run_with_min_size("Elisa UI Showcase", 1180.0, 800.0, 980.0, 660.0)
