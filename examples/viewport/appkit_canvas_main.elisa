# An Elisa engine viewport inside an elisa-ui AppKit canvas window.
# Build: scripts/build_appkit_canvas_viewport.sh (needs the Elisa engine checkout).
include "../../src/platform/appkit/ui_appkit_canvas_flat.elisa"
include "app.elisa"

def main() -> i64:
    return UiAppKitCanvas::run_with_min_size("elisa-ui engine viewport", 1000.0, 640.0, 640.0, 400.0)
