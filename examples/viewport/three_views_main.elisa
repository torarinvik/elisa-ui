# Three Elisa engine viewports in one elisa-ui AppKit canvas window.
# Build: ELISA_VIEWPORT_APP=three_views scripts/build_appkit_canvas_viewport.sh
include "../../src/platform/appkit/ui_appkit_canvas_flat.elisa"
include "three_views_app.elisa"

def main() -> i64:
    return UiAppKitCanvas::run_with_min_size("elisa-ui engine views", 1200.0, 800.0, 800.0, 560.0)
