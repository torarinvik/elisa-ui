# One call per treatment. Every one of these is a statement, not a trick.

include "./theme.elisa"

module StoreStyle:
    public:
        # A LIT PRIMARY ACTION: a ramp from a lifted accent down to the accent,
        # with the accent spilling out around it. Two framework facts, and the
        # difference between a button and a button someone designed.
        def primary(handle: UiHandles::Handle, caption: sview, size: f32) -> void:
            # Hover brightens the lift; press is the deep end. A control whose
            # hover is its rest is a control the pointer does nothing to.
            UiHandles::set_colors(handle, StoreTheme::accent_lifted(), StoreTheme::rgb(150, 205, 255), StoreTheme::accent_deep())
            UiHandles::set_gradient(handle, StoreTheme::accent_deep(), false)
            # A lift at the top edge, the hue through the body, a deep end:
            # three stops, because two make a line and a lit button is a curve.
            UiHandles::set_gradient_mid(handle, StoreTheme::accent(), 0.42)
            UiHandles::set_glow(handle, StoreTheme::rgba(37, 118, 236, 120))
            UiHandles::set_corner(handle, UiCore::CornerStyle.Pill)
            UiHandles::set_text(handle, caption, size, StoreTheme::on_accent())
            UiHandles::set_text_weight(handle, true)
            UiHandles::set_text_halo(handle, StoreTheme::rgba(10, 40, 120, 110))

        # A quiet action is the ground with a hairline, not a weaker copy of
        # the primary: two buttons of the same shape in different strengths
        # read as one broken button.
        def secondary(handle: UiHandles::Handle, caption: sview, size: f32) -> void:
            UiHandles::set_colors(handle, StoreTheme::rgba(255, 255, 255, 36), StoreTheme::rgba(255, 255, 255, 56), StoreTheme::rgba(255, 255, 255, 24))
            UiHandles::set_corner(handle, UiCore::CornerStyle.Pill)
            UiHandles::set_text(handle, caption, size, StoreTheme::rail_ink())

        def card_action(handle: UiHandles::Handle, caption: sview, size: f32) -> void:
            UiHandles::set_colors(handle, StoreTheme::rgb(240, 245, 252), StoreTheme::rgb(226, 236, 250), StoreTheme::rgb(214, 228, 246))
            UiHandles::set_corner(handle, UiCore::CornerStyle.Pill)
            UiHandles::set_text(handle, caption, size, StoreTheme::accent())
            UiHandles::set_text_weight(handle, true)

        # A TAG IS A CAPSULE, and it is a capsule at a size where the derived
        # corner policy correctly answers "not a bar". Stating the kind is the
        # whole of it.
        def tag(handle: UiHandles::Handle, caption: sview) -> void:
            UiHandles::set_colors(handle, StoreTheme::chip(), StoreTheme::chip(), StoreTheme::chip())
            UiHandles::set_corner(handle, UiCore::CornerStyle.Pill)
            UiHandles::set_text(handle, caption, 11.0, StoreTheme::chip_ink())

        # An icon tile: a gradient square with a picture in it. Both are the
        # widget's own record now, so the tile is one widget rather than a
        # stack of three.
        def tile(handle: UiHandles::Handle, near: UiCore::Color, far: UiCore::Color, image: UiCore::ImageRef) -> void:
            UiHandles::set_colors(handle, near, near, near)
            UiHandles::set_gradient(handle, far, false)
            UiHandles::set_gradient_mid(handle, StoreTheme::rgba(((near.r.i64() + far.r.i64()) / 2).u8(), ((near.g.i64() + far.g.i64()) / 2).u8(), ((near.b.i64() + far.b.i64()) / 2).u8(), 255), 0.38)
            UiHandles::set_glow(handle, StoreTheme::rgba(far.r, far.g, far.b, 70))
            UiHandles::set_image(handle, image)
            UiHandles::set_image_fit(handle, UiCore::PictureFit.Contain)

        # A NAVIGATION ENTRY whose selected state is the accent itself, lit --
        # and whose unselected state is the rail with a label on it, because a
        # column of five outlined boxes reads as five buttons.
        def nav_row(row: UiHandles::Handle, caption: UiHandles::Handle, text: sview, selected: bool) -> void:
            if selected:
                UiHandles::set_color(row, StoreTheme::accent_lifted())
                UiHandles::set_gradient(row, StoreTheme::accent_deep(), false)
                UiHandles::set_gradient_mid(row, StoreTheme::accent(), 0.45)
                UiHandles::set_glow(row, StoreTheme::rgba(37, 118, 236, 110))
                UiHandles::set_text(caption, text, 14.0, StoreTheme::on_accent())
                UiHandles::set_text_weight(caption, true)
                return
            UiHandles::set_color(row, StoreTheme::transparent())
            UiHandles::clear_gradient(row)
            UiHandles::set_glow(row, StoreTheme::transparent())
            UiHandles::set_text(caption, text, 14.0, StoreTheme::rail_ink())
            UiHandles::set_text_weight(caption, false)

        # A TAB IS ITS UNDERLINE. The active one is a weighted accent label
        # over a short accent bar; the rest are muted labels over nothing. The
        # bar is a capsule two points thick, which is a bar by the corner
        # policy's own test and needs no shape stated.
        def tab(handle: UiHandles::Handle, caption: sview, selected: bool) -> void:
            UiHandles::set_colors(handle, StoreTheme::transparent(), StoreTheme::transparent(), StoreTheme::transparent())
            UiHandles::set_text(handle, caption, 13.0, StoreTheme::accent() if selected else StoreTheme::muted())
            UiHandles::set_text_weight(handle, selected)
