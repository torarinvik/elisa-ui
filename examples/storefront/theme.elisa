# The storefront's palette and its one-line surface treatments.
#
# A SECOND EXAMPLE, and not a second showcase. The showcase exists to put every
# widget the framework has on screen, which is what makes it a coverage
# artifact and also what makes it look like a widget catalogue. This one exists
# to answer a different question: what does an interface BUILT with this
# framework look like when it is composed the way a shipping application is
# composed -- a shell, a hero, a grid of content, and nothing on screen that is
# there to demonstrate a feature.
#
# Every treatment below is one call. That is the point of the last several
# pieces of work: a ramp, a light, a shape and a picture are things an
# application states, not things it fakes with a second colour and a
# hand-placed rectangle.

include "../../src/widgets/ui_handles.elisa"

module StoreTheme:
    public:
        def rgb(r: u8, g: u8, b: u8) -> UiCore::Color:
            return UiCore::rgba(r, g, b, 255)

        def rgba(r: u8, g: u8, b: u8, a: u8) -> UiCore::Color:
            return UiCore::rgba(r, g, b, a)

        def transparent() -> UiCore::Color:
            return UiCore::rgba(0, 0, 0, 0)

        # A deep blue ground with a lighter far end. The page is never one
        # value: a window filled edge to edge with a single colour is the
        # cheapest possible ground and reads that way.
        def page_near() -> UiCore::Color:
            return rgb(14, 24, 54)

        def page_far() -> UiCore::Color:
            return rgb(24, 44, 96)

        # The shell is glass over that ground. Under the transmission floor a
        # translucent surface is a tint and the framework declines to blur
        # behind it, which is the right answer here: what is behind the rail
        # is the page, not content.
        def rail() -> UiCore::Color:
            return rgba(18, 32, 70, 232)

        def rail_far() -> UiCore::Color:
            return rgba(26, 48, 104, 232)

        def surface() -> UiCore::Color:
            return rgba(255, 255, 255, 250)

        def surface_far() -> UiCore::Color:
            return rgba(238, 244, 252, 250)

        def bar() -> UiCore::Color:
            return rgba(246, 249, 254, 244)

        def accent() -> UiCore::Color:
            return rgb(37, 118, 236)

        def accent_lifted() -> UiCore::Color:
            return rgb(96, 168, 255)

        def accent_deep() -> UiCore::Color:
            return rgb(20, 78, 190)

        def ink() -> UiCore::Color:
            return rgb(16, 26, 48)

        def muted() -> UiCore::Color:
            return rgb(96, 112, 142)

        def rail_ink() -> UiCore::Color:
            return rgb(232, 240, 255)

        def rail_muted() -> UiCore::Color:
            return rgba(180, 200, 235, 255)

        def rail_label() -> UiCore::Color:
            return rgba(140, 166, 214, 255)

        def on_accent() -> UiCore::Color:
            return rgb(255, 255, 255)

        def chip() -> UiCore::Color:
            return rgb(234, 240, 250)

        def chip_ink() -> UiCore::Color:
            return rgb(64, 84, 122)

        def hairline() -> UiCore::Color:
            return rgba(255, 255, 255, 26)
