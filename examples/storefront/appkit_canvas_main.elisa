# The storefront in an AppKit window, painted by CoreGraphics.
#
# The same composition the Skia fixture renders, through the other painter.
# Its pictures arrive from a host; an AppKit window has none to hand over, so
# the plates show their fills -- which is exactly what a card whose picture has
# not arrived is meant to look like.

include "../../src/platform/appkit/ui_appkit_canvas_flat.elisa"
include "app.elisa"

def main() -> i64:
    return UiAppKitCanvas::run_with_min_size("Storefront", 1440.0, 812.0, 1100.0, 700.0)
