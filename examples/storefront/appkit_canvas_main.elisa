# The storefront in an AppKit window, painted by CoreGraphics.
#
# The same composition the Skia fixture renders, through the other painter.
# Its pictures are made here, with CoreGraphics, and bound to the painter by
# slot before the window exists; the tree picks them up when it is built.

include "../../src/platform/appkit/ui_appkit_canvas_flat.elisa"
include "app.elisa"
include "pictures_cg.elisa"

def bound(slot: u32, image: usize) -> UiCore::ImageRef:
    return UiCore::image_ref_none() if not UiAppKitCanvas::bind_picture(slot, 1, image)
    return UiCore::image_ref(slot, 1)

def main() -> i64:
    pictures: StorePictures::Set = StorePictures::make()
    StoreApp::set_pictures(bound(1, pictures.brand), bound(2, pictures.glyph), bound(3, pictures.banner), bound(4, pictures.plate), bound(5, pictures.grain))
    return UiAppKitCanvas::run_with_min_size("Storefront", 1440.0, 812.0, 1100.0, 700.0)
