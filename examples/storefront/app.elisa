# A storefront, composed the way a shipping application is composed.
#
# The showcase next door puts every widget on screen, which makes it a coverage
# artifact and also makes it look like a widget catalogue. This one has nothing
# on screen to demonstrate a feature: a rail, a search bar, a header with tabs,
# a hero and a grid of cards, and every one of them is built from the ordinary
# retained vocabulary. It is the answer to "what does an interface built with
# this framework look like" rather than "what can this framework draw".

include "./shell.elisa"
include "./catalog.elisa"

module StoreApp:
    private:
        global mutable root: UiHandles::Handle = UiHandles::invalid()
        global mutable body: UiHandles::Handle = UiHandles::invalid()
        global mutable started: bool = false
        # Narrower than this at the moment the tree is built, and the
        # composition takes its phone form. A tablet or a window is wide.
        const COMPACT_WIDTH: f32 = 700.0
        # Pictures handed over before the tree exists wait here. An entry
        # point that makes its own pictures has them before the backend has
        # a surface, and the backend is what decides when `init` runs.
        global mutable pending: bool = false
        global mutable pending_brand: UiCore::ImageRef = UiCore::image_ref_none()
        global mutable pending_glyph: UiCore::ImageRef = UiCore::image_ref_none()
        global mutable pending_banner: UiCore::ImageRef = UiCore::image_ref_none()
        global mutable pending_plate: UiCore::ImageRef = UiCore::image_ref_none()
        global mutable pending_grain: UiCore::ImageRef = UiCore::image_ref_none()

        def apply_pictures() -> void:
            # GRAIN over the page ramp: a tile at its own size, at a few
            # percent. A smooth ramp reads as vector; this reads as a surface.
            UiHandles::set_image(root, pending_grain)
            UiHandles::set_image_fit(root, UiCore::PictureFit.Tile)
            UiHandles::set_image_alpha(root, 14)
            StoreShell::set_marks(pending_brand, pending_glyph, pending_banner)
            StoreCatalog::set_pictures(pending_banner, pending_plate, pending_glyph)

    public:
        def init() -> void:
            return if started
            started <- true
            root <- UiHandles::column(UiHandles::root_parent(), 0.0, 0.0, StoreTheme::page_near())
            UiHandles::set_gradient(root, StoreTheme::page_far(), false)
            body <- UiHandles::row(root, 0.0, 0.0, StoreTheme::transparent())
            UiHandles::set_grow(body, 1.0)
            compact: bool = UiCore::viewport_width() > 0.0 and UiCore::viewport_width() < COMPACT_WIDTH
            StoreShell::init(body, compact)
            StoreCatalog::init(body, compact)
            apply_pictures() if pending

        # Where the primary action sits, so a host can put the pointer on it.
        def primary_centre() -> UiCore::Vec2:
            return StoreCatalog::primary_centre()

        def frame() -> void:
            # The viewport is the host's to report and the layout is the
            # application's to run against it. A frame that never lays out is
            # a tree of zero-sized boxes and a perfectly good empty PNG.
            UiHandles::layout(UiCore::viewport_width(), UiCore::viewport_height())
            UiCore::clear(StoreTheme::page_near())
            UiHandles::paint()

        # One call for the host to hand over every picture the frame uses,
        # before or after the tree exists.
        def set_pictures(brand: UiCore::ImageRef, glyph: UiCore::ImageRef, banner: UiCore::ImageRef, plate: UiCore::ImageRef, grain: UiCore::ImageRef) -> void:
            pending <- true
            pending_brand <- brand
            pending_glyph <- glyph
            pending_banner <- banner
            pending_plate <- plate
            pending_grain <- grain
            apply_pictures() if started

def app_init() -> void:
    StoreApp::init()

def app_widget_event(widget: usize, event: i32) -> void:
    _ = widget
    _ = event

def app_event(event: UiCore::Event) -> void:
    UiHandles::handle(event)

def app_frame() -> void:
    StoreApp::frame()
