# Native entry: SDL3 backend + shared app.
# ELISA_UI_SMOKE_FRAMES (with SDL_VIDEODRIVER=dummy) bounds the loop for headless checks.

include "../../src/platform/sdl3/ui_sdl3.elisa"
include "../../src/widgets/ui_widget.elisa"
include "app.elisa"

extern getenv(name: cstr) -> cstr?

def smoke_frames() -> i64:
    value_opt: cstr? = getenv("ELISA_UI_SMOKE_FRAMES")
    if value_opt is value:
        return 30
    return 0

def main() -> i64:
    return ui_run("Elisa UI - hello", 800, 600, smoke_frames())
