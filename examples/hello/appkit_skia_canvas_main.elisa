# The shared hello app painted by Skia into an AppKit custom canvas.
# The optional native compositor is linked only by the Skia build script.

include "../../src/platform/appkit/ui_appkit_canvas_flat.elisa"
include "../../src/platform/appkit/ui_appkit_canvas_skia.elisa"
include "app.elisa"

def main() -> i64:
    return UiAppKitCanvas::run_with_min_size("elisa-ui Skia AppKit", 800.0, 680.0, 640.0, 540.0)
