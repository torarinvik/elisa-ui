# The shared hello app, painted by elisa-ui into an AppKit-hosted custom canvas.
include "../../src/platform/appkit/ui_appkit_canvas_flat.elisa"
include "app.elisa"

def main() -> i64:
    # The toolbar's intrinsic minimum is 550pt plus outer padding. This is app
    # policy, so it stays in Elisa rather than the native window shim.
    return UiAppKitCanvas::run_with_min_size("elisa-ui custom AppKit", 800.0, 680.0, 640.0, 540.0)
