# hello: a typed widget tree driven by the same app.elisa on every backend.
#
# The application owns only its view state and palette policy. Geometry, hit
# testing, focus, editing, painting and stale-view protection stay in Elisa's
# UiHandles layer, so this example never stores a raw arena index.

include "state.elisa"
include "catalog.elisa"
include "resource_demo.elisa"
include "validation.elisa"

module HelloApp:
    private:
        global mutable swatch_red: UiHandles::Handle = UiHandles::Handle{widget_id: UiFlat::NONE.u32(), tree_id: 0}
        global mutable swatch_green: UiHandles::Handle = UiHandles::Handle{widget_id: UiFlat::NONE.u32(), tree_id: 0}
        global mutable swatch_blue: UiHandles::Handle = UiHandles::Handle{widget_id: UiFlat::NONE.u32(), tree_id: 0}
        global mutable theme_button: UiHandles::Handle = UiHandles::Handle{widget_id: UiFlat::NONE.u32(), tree_id: 0}
        global mutable project_field: UiHandles::Handle = UiHandles::Handle{widget_id: UiFlat::NONE.u32(), tree_id: 0}
        global mutable content: UiHandles::Handle = UiHandles::Handle{widget_id: UiFlat::NONE.u32(), tree_id: 0}
        global mutable root_panel: UiHandles::Handle = UiHandles::Handle{widget_id: UiFlat::NONE.u32(), tree_id: 0}
        global mutable title_label: UiHandles::Handle = UiHandles::Handle{widget_id: UiFlat::NONE.u32(), tree_id: 0}
        global mutable subtitle_label: UiHandles::Handle = UiHandles::Handle{widget_id: UiFlat::NONE.u32(), tree_id: 0}
        global mutable preview_label: UiHandles::Handle = UiHandles::Handle{widget_id: UiFlat::NONE.u32(), tree_id: 0}
        global mutable help_label: UiHandles::Handle = UiHandles::Handle{widget_id: UiFlat::NONE.u32(), tree_id: 0}
        global mutable intensity_label: UiHandles::Handle = UiHandles::Handle{widget_id: UiFlat::NONE.u32(), tree_id: 0}
        global mutable intensity_slider: UiHandles::Handle = UiHandles::Handle{widget_id: UiFlat::NONE.u32(), tree_id: 0}
        global mutable intensity_progress: UiHandles::Handle = UiHandles::Handle{widget_id: UiFlat::NONE.u32(), tree_id: 0}
        global mutable clicks: i32 = 0
        global mutable accent_index: i32 = 2
        global mutable accent: UiCore::Color = UiCore::Color{r: 64, g: 112, b: 224, a: 255}
        global mutable dark_theme: bool = true
        global mutable canvas_color: UiCore::Color = UiCore::Color{r: 12, g: 14, b: 20, a: 255}

        def color(r: u8, g: u8, b: u8) -> UiCore::Color:
            return UiCore::rgb(r, g, b)

        def swatch(parent: UiHandles::Handle, label: sview, r: u8, g: u8, b: u8, hover_r: u8, hover_g: u8, hover_b: u8) -> UiHandles::Handle:
            handle: UiHandles::Handle = UiHandles::radio_button(parent, 132.0, 48.0, color(r, g, b), color(hover_r, hover_g, hover_b), color(r / 2, g / 2, b / 2))
            UiHandles::set_grow(handle, 1.0)
            UiHandles::set_text(handle, label, 15.0, color(255, 255, 255))
            return handle

        def apply_framework_theme() -> void:
            mode: mutable UiTheme::ColorMode = UiTheme::ColorMode.Light
            mode <- UiTheme::ColorMode.Dark if dark_theme
            preferences: UiTheme::Preferences = UiTheme::Preferences{
                mode: mode, contrast: UiTheme::Contrast.Normal,
                text_scale: 1.0, reduced_motion: false,
            }
            palette: mutable UiTheme::Palette = UiTheme::resolve(preferences, false, false)
            palette.accent <- UiCore::Color{r: accent.r, g: accent.g, b: accent.b, a: 255}
            palette.focus_ring <- UiCore::Color{r: accent.r, g: accent.g, b: accent.b, a: 255}
            palette.selection <- UiCore::Color{r: accent.r, g: accent.g, b: accent.b, a: 255}
            _ = UiHandles::apply_palette(palette)

        def select_palette(selected: UiHandles::Handle, next: UiCore::Color) -> void:
            accent <- next
            apply_framework_theme()
            selected_index: usize = UiHandles::index(selected)
            accent_index <- 0 if selected_index == UiHandles::index(swatch_red)
            accent_index <- 1 if selected_index == UiHandles::index(swatch_green)
            accent_index <- 2 if selected_index == UiHandles::index(swatch_blue)
            UiHandles::set_selected(swatch_red, selected_index == UiHandles::index(swatch_red))
            UiHandles::set_selected(swatch_green, selected_index == UiHandles::index(swatch_green))
            UiHandles::set_selected(swatch_blue, selected_index == UiHandles::index(swatch_blue))
            track: UiCore::Color = color(54, 61, 78) if dark_theme else color(198, 205, 220)
            thumb: UiCore::Color = color(238, 242, 252) if dark_theme else color(255, 255, 255)
            UiHandles::set_colors(intensity_slider, track, next, thumb)
            UiHandles::set_colors(intensity_progress, track, next, next)

        def apply_theme() -> void:
            apply_framework_theme()
            HelloValidation::apply_theme(dark_theme)
            if dark_theme:
                canvas_color <- color(12, 14, 20)
                UiHandles::set_color(root_panel, color(17, 20, 27))
                UiHandles::set_color(content, color(31, 36, 48))
                UiHandles::set_text(title_label, "elisa-ui", 30.0, color(244, 246, 252))
                UiHandles::set_text(subtitle_label, "A small UI framework, drawing every pixel itself.", 15.0, color(148, 158, 180))
                UiHandles::set_colors(project_field, color(27, 32, 43), color(27, 32, 43), color(27, 32, 43))
                UiHandles::set_text(project_field, "Project name", 15.0, color(232, 236, 246))
                UiHandles::set_text(preview_label, "Canvas preview", 20.0, color(238, 241, 248))
                UiHandles::set_text(help_label, "Choose a palette above. Keys 1-3 switch colour; T theme; P/R save/restore; L/C/F/Y preview.", 14.0, color(166, 175, 196))
                UiHandles::set_text(intensity_label, "Preview intensity", 13.0, color(148, 158, 180))
                UiHandles::set_colors(intensity_slider, color(54, 61, 78), accent, color(238, 242, 252))
                UiHandles::set_colors(intensity_progress, color(54, 61, 78), accent, accent)
                UiHandles::set_colors(theme_button, color(48, 54, 68), color(62, 70, 88), color(35, 40, 52))
                UiHandles::set_text(theme_button, "Dark mode", 15.0, color(245, 247, 252))
                UiHandles::set_selected(theme_button, true)
            else:
                canvas_color <- color(226, 231, 241)
                UiHandles::set_color(root_panel, color(238, 241, 247))
                UiHandles::set_color(content, color(252, 253, 255))
                UiHandles::set_text(title_label, "elisa-ui", 30.0, color(25, 31, 43))
                UiHandles::set_text(subtitle_label, "A small UI framework, drawing every pixel itself.", 15.0, color(91, 103, 126))
                UiHandles::set_colors(project_field, color(250, 251, 254), color(250, 251, 254), color(250, 251, 254))
                UiHandles::set_text(project_field, "Project name", 15.0, color(35, 43, 58))
                UiHandles::set_text(preview_label, "Canvas preview", 20.0, color(31, 39, 54))
                UiHandles::set_text(help_label, "Choose a palette above. Keys 1-3 switch colour; T theme; P/R save/restore; L/C/F/Y preview.", 14.0, color(98, 110, 132))
                UiHandles::set_text(intensity_label, "Preview intensity", 13.0, color(91, 103, 126))
                UiHandles::set_colors(intensity_slider, color(198, 205, 220), accent, color(255, 255, 255))
                UiHandles::set_colors(intensity_progress, color(198, 205, 220), accent, accent)
                UiHandles::set_colors(theme_button, color(218, 223, 234), color(205, 212, 226), color(190, 198, 214))
                UiHandles::set_text(theme_button, "Dark mode", 15.0, color(35, 43, 58))
                UiHandles::set_selected(theme_button, false)

        # A small vector scene makes the empty content card earn its space and
        # exercises the custom backend's shapes, alpha blending and line work.
        # It is derived from typed retained widgets every frame, so resize stays live.
        def paint_preview() -> void:
            if UiHandles::widget(content) is card:
                if UiHandles::widget(intensity_progress) is meter:
                    if UiHandles::widget(intensity_slider) is slider:
                        centre_x: f32 = card.x + card.width * 0.5
                        art_top: f32 = meter.y + meter.height + 18.0
                        art_bottom: f32 = card.y + card.height - 24.0
                        art_height: f32 = art_bottom - art_top
                        centre_y: f32 = art_top + art_height * 0.5
                        intensity: f32 = slider.value
                        base_radius: f32 = 76.0 if card.height > 260.0 else 48.0
                        desired_radius: f32 = base_radius * (0.72 + intensity * 0.42)
                        available_radius: f32 = art_height * 0.5 - 34.0
                        radius: mutable f32 = desired_radius if desired_radius < available_radius else available_radius
                        radius <- 12.0 if radius < 12.0 else radius

                        # Quiet guide rails behind the focal mark.
                        guide: UiCore::Color = UiCore::rgba(255, 255, 255, 24)
                        UiCore::fill(UiCore::Line{from_point: UiCore::Vec2(card.x + 32.0, centre_y), to_point: UiCore::Vec2(card.x + card.width - 32.0, centre_y)}, guide)
                        UiCore::fill(UiCore::Line{from_point: UiCore::Vec2(centre_x, art_top), to_point: UiCore::Vec2(centre_x, art_bottom)}, guide)

                        # Layered translucent geometry: deliberately backend-neutral commands,
                        # not AppKit drawing hidden in the example.
                        halo: UiCore::Color = UiCore::Color{r: accent.r, g: accent.g, b: accent.b, a: 42}
                        soft: UiCore::Color = UiCore::Color{r: accent.r, g: accent.g, b: accent.b, a: 105}
                        UiCore::fill(UiCore::Circle{center: UiCore::Vec2(centre_x, centre_y), radius: radius + 34.0}, halo)
                        UiCore::fill(UiCore::Circle{center: UiCore::Vec2(centre_x - radius * 0.42, centre_y + radius * 0.18), radius: radius}, accent)
                        UiCore::fill(UiCore::Circle{center: UiCore::Vec2(centre_x + radius * 0.55, centre_y - radius * 0.28), radius: radius * 0.72}, soft)
                        UiCore::fill(UiCore::Triangle{
                            a: UiCore::Vec2(centre_x + radius * 0.15, centre_y - radius * 0.72),
                            b: UiCore::Vec2(centre_x + radius * 1.05, centre_y + radius * 0.72),
                            c: UiCore::Vec2(centre_x - radius * 0.34, centre_y + radius * 0.56),
                        }, UiCore::rgba(246, 248, 255, 185))

        def save_state() -> void can Unsafe.PointerCast:
            catalog_index: i32 = HelloCatalog::selected()
            _ = HelloState::save(project_field, intensity_slider, dark_theme, accent_index, clicks, catalog_index)
            UiHandles::set_text(help_label, "State saved. Press R to restore it.", 14.0, color(166, 175, 196))

        def restore_state() -> void can Unsafe.PointerCast:
            snapshot: HelloState::HelloStateSnapshot = HelloState::restore(project_field, intensity_slider)
            return if not snapshot.valid
            dark_theme <- snapshot.dark_theme
            clicks <- snapshot.clicks
            if snapshot.accent_index == 0:
                select_palette(swatch_red, color(204, 76, 92))
            elif snapshot.accent_index == 1:
                select_palette(swatch_green, color(54, 166, 118))
            else:
                select_palette(swatch_blue, color(64, 112, 224))
            HelloCatalog::select(snapshot.catalog_index)
            UiHandles::set_value(intensity_progress, UiHandles::value(intensity_slider))
            apply_theme()
            UiHandles::set_text(help_label, "State restored. Press P to save it again.", 14.0, color(166, 175, 196))

    public:
        # Advanced custom renderers may anchor their own drawing to a retained
        # layout node without reaching into the widget arena. The handle is
        # generation-checked by UiHandles at the call site.
        def content_handle() -> UiHandles::Handle:
            return content

        def init() -> void:
            HelloState::reset()
            UiHandles::reset()
            root: UiHandles::Handle = UiHandles::column(UiHandles::root_parent(), 28.0, 18.0, color(17, 20, 27))
            root_panel <- root

            # Static text: the run is a view, and the component's allocator never
            # reclaims, so labels must not build strings per frame.
            title_label <- UiHandles::label(root, "elisa-ui", 30.0, color(244, 246, 252))
            subtitle_label <- UiHandles::label(root, "A small UI framework, drawing every pixel itself.", 15.0, color(148, 158, 180))
            project_field <- UiHandles::text_field(root, "Project name", "Name this canvas", "Canvas study", 240.0, 40.0, 15.0, color(232, 236, 246), color(27, 32, 43))
            UiHandles::set_help(project_field, "Editable custom-drawn text field")
            HelloValidation::init(root, project_field)

            toolbar: UiHandles::Handle = UiHandles::row(root, 0.0, 14.0, UiCore::Color{r: 0, g: 0, b: 0, a: 0})
            UiHandles::set_grow(toolbar, 0.0)
            swatch_red <- swatch(toolbar, "Coral", 204, 76, 92, 225, 96, 110)
            swatch_green <- swatch(toolbar, "Mint", 54, 166, 118, 70, 190, 138)
            swatch_blue <- swatch(toolbar, "Ocean", 64, 112, 224, 84, 136, 244)
            UiHandles::set_help(swatch_red, "Use the warm coral palette (keyboard: 1)")
            UiHandles::set_help(swatch_green, "Use the mint palette (keyboard: 2)")
            UiHandles::set_help(swatch_blue, "Use the ocean palette (keyboard: 3)")
            UiHandles::set_selected(swatch_blue, true)
            theme_button <- UiHandles::check_box(toolbar, 112.0, 48.0, color(48, 54, 68), color(62, 70, 88), color(35, 40, 52))
            UiHandles::set_text(theme_button, "Dark mode", 15.0, color(245, 247, 252))
            UiHandles::set_help(theme_button, "Toggle dark appearance (keyboard: T)")
            UiHandles::set_selected(theme_button, true)

            content <- UiHandles::column(root, 24.0, 10.0, color(31, 36, 48))
            UiHandles::set_grow(content, 1.0)
            preview_label <- UiHandles::label(content, "Canvas preview", 20.0, color(238, 241, 248))
            help_label <- UiHandles::label(content, "Choose a palette above. Keys 1-3 switch colour; T theme; P/R save/restore; L/C/F/Y preview.", 14.0, color(166, 175, 196))
            HelloCatalog::init(content)
            HelloResourceDemo::init(content)
            intensity_label <- UiHandles::label(content, "Preview intensity", 13.0, color(148, 158, 180))
            intensity_slider <- UiHandles::slider_labeled(content, "Preview intensity", 180.0, 24.0, 0.72, color(54, 61, 78), accent, color(238, 242, 252))
            UiHandles::set_help(intensity_slider, "Adjust the scale of the canvas artwork with drag or arrow keys")
            intensity_progress <- UiHandles::progress_bar_labeled(content, "Preview level", 180.0, 10.0, 0.72, color(54, 61, 78), accent)

            UiHandles::layout(UiCore::viewport_width(), UiCore::viewport_height())
            HelloValidation::validate()

        def widget_event(widget: usize, event: i32) -> void:
            return if HelloCatalog::widget_event(widget, event)
            return if HelloResourceDemo::widget_event(widget, event)
            if UiHandles::event_is(event, UiConst::WidgetEvent.Change) and UiHandles::callback_matches(widget, intensity_slider):
                UiHandles::set_value(intensity_progress, UiHandles::value(intensity_slider))
                return
            return if not UiHandles::event_is(event, UiConst::WidgetEvent.Click)
            clicks <- clicks + 1
            if UiHandles::callback_matches(widget, swatch_red):
                select_palette(swatch_red, color(204, 76, 92))
            elif UiHandles::callback_matches(widget, swatch_green):
                select_palette(swatch_green, color(54, 166, 118))
            elif UiHandles::callback_matches(widget, swatch_blue):
                select_palette(swatch_blue, color(64, 112, 224))
            elif UiHandles::callback_matches(widget, theme_button):
                dark_theme <- not dark_theme
                apply_theme()

        def event(incoming: UiCore::Event) -> void:
            match incoming:
                UiCore::KeyEvent.Down(code):
                    select_palette(swatch_red, color(204, 76, 92)) if code == UiCore::Key.Digit1
                    select_palette(swatch_green, color(54, 166, 118)) if code == UiCore::Key.Digit2
                    select_palette(swatch_blue, color(64, 112, 224)) if code == UiCore::Key.Digit3
                    if code == UiCore::Key.T:
                        dark_theme <- not dark_theme
                        apply_theme()
                    if code == UiCore::Key.P:
                        save_state()
                    if code == UiCore::Key.R:
                        restore_state()
                    if HelloResourceDemo::key_down(code):
                        return
                _:
                    pass
            UiHandles::handle(incoming)

        def frame() -> void:
            UiCore::clear(canvas_color)
            UiHandles::paint()
            paint_preview()

# The application half of the contract. Top-level by name; one call each.
def app_init() -> void:
    HelloApp::init()

def app_widget_event(widget: usize, event: i32) -> void:
    HelloApp::widget_event(widget, event)

def app_event(event: UiCore::Event) -> void:
    HelloApp::event(event)

def app_text_input(text: sview) -> void:
    UiHandles::insert_text(text)
    HelloValidation::validate()

def app_validate() -> void:
    HelloValidation::validate()

def app_text_editing(text: sview, selected_start: i32, selected_length: i32) -> void:
    UiHandles::update_marked_text_utf8_characters(text, selected_start, selected_length)

def app_frame() -> void:
    HelloApp::frame()
