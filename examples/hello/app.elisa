# hello: the same app source drives both backends (lockstep contract).
# A square follows the pointer and turns warm while a button is held.

global mutable app_pointer_x: f32 = 400.0
global mutable app_pointer_y: f32 = 300.0
global mutable app_pressed: bool = false

def app_init() -> void:
    app_pressed <- false

def app_event(event: mutable UiEvent&) -> void:
    if event.kind == UI_EVENT_POINTER_MOVE:
        app_pointer_x <- event.x
        app_pointer_y <- event.y
    elif event.kind == UI_EVENT_POINTER_DOWN:
        app_pressed <- true
    elif event.kind == UI_EVENT_POINTER_UP:
        app_pressed <- false

def app_frame() -> void:
    ui_clear(24, 26, 32, 255)
    if app_pressed:
        ui_fill_rect(app_pointer_x - 40.0, app_pointer_y - 40.0, 80.0, 80.0, 235, 122, 52, 255)
    else:
        ui_fill_rect(app_pointer_x - 40.0, app_pointer_y - 40.0, 80.0, 80.0, 82, 156, 255, 255)
