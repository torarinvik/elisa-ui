# hello: a widget tree driven by the same app.elisa on both backends.
#
# A toolbar row of buttons above a content area. Clicking a swatch recolours the
# content panel, which is the whole point of the example: the app never touches
# geometry or hit testing, only the tree and its own state.

global mutable app_swatch_red: usize = UI_WIDGET_NONE
global mutable app_swatch_green: usize = UI_WIDGET_NONE
global mutable app_swatch_blue: usize = UI_WIDGET_NONE
global mutable app_content: usize = UI_WIDGET_NONE
global mutable app_clicks: i32 = 0

def app_color(r: u8, g: u8, b: u8) -> UiColor:
    return UiColor{r: r, g: g, b: b, a: 255}

def app_swatch(parent: usize, r: u8, g: u8, b: u8) -> usize:
    index: usize = ui_button(parent, 120.0, 44.0, app_color(r, g, b), app_color(r + 30, g + 30, b + 30), app_color(r / 2, g / 2, b / 2))
    ui_widget_set_grow(index, 1.0)
    return index

def app_init() -> void:
    ui_widget_reset()
    root: usize = ui_panel(UI_WIDGET_NONE, UI_AXIS_COLUMN, 16.0, 16.0, app_color(24, 26, 32))

    toolbar: usize = ui_panel(root, UI_AXIS_ROW, 0.0, 12.0, UiColor{r: 0, g: 0, b: 0, a: 0})
    ui_widget_set_grow(toolbar, 0.0)
    app_swatch_red <- app_swatch(toolbar, 200, 70, 70)
    app_swatch_green <- app_swatch(toolbar, 80, 180, 100)
    app_swatch_blue <- app_swatch(toolbar, 82, 130, 235)

    app_content <- ui_panel(root, UI_AXIS_COLUMN, 0.0, 0.0, app_color(44, 48, 60))
    ui_widget_set_grow(app_content, 1.0)

    ui_layout(ui_viewport_width, ui_viewport_height)

def app_widget_event(widget: usize, event: i32) -> void:
    return if event != UI_WIDGET_EVENT_CLICK
    app_clicks <- app_clicks + 1
    if widget == app_swatch_red:
        ui_widgets[app_content].color <- app_color(120, 40, 40)
    elif widget == app_swatch_green:
        ui_widgets[app_content].color <- app_color(40, 110, 60)
    elif widget == app_swatch_blue:
        ui_widgets[app_content].color <- app_color(40, 70, 140)

def app_event(event: mutable UiEvent&) -> void:
    if event.kind == UI_EVENT_RESIZE:
        ui_layout(event.x, event.y)
        return
    ui_widget_pointer(event.kind, event.x, event.y)

def app_frame() -> void:
    ui_clear(16, 17, 21, 255)
    ui_widget_paint()
