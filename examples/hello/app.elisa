# hello: a widget tree driven by the same app.elisa on both backends.
#
# A toolbar row of buttons above a content area. Clicking a swatch recolours the
# content panel, which is the whole point of the example: the app never touches
# geometry or hit testing, only the tree and its own state.
#
# NAMESPACES. The application is written the way the library is: its state and
# helpers live in `HelloApp`, private, and the only top-level names are the four
# `app_*` the contract in ui_core.elisa dictates. So the globals lose the `app_`
# prefix they carried to keep out of everyone else's way -- the module keeps
# them out now -- and nothing an entry file includes alongside this one can
# collide with a swatch handle.

module HelloApp:
    private:
        global mutable swatch_red: usize = UiFlat::NONE
        global mutable swatch_green: usize = UiFlat::NONE
        global mutable swatch_blue: usize = UiFlat::NONE
        global mutable theme_button: usize = UiFlat::NONE
        global mutable project_field: usize = UiFlat::NONE
        global mutable content: usize = UiFlat::NONE
        global mutable root_panel: usize = UiFlat::NONE
        global mutable title_label: usize = UiFlat::NONE
        global mutable subtitle_label: usize = UiFlat::NONE
        global mutable preview_label: usize = UiFlat::NONE
        global mutable help_label: usize = UiFlat::NONE
        global mutable intensity_label: usize = UiFlat::NONE
        global mutable intensity_slider: usize = UiFlat::NONE
        global mutable intensity_progress: usize = UiFlat::NONE
        global mutable clicks: i32 = 0
        global mutable accent: UiCore::Color = UiCore::Color{r: 64, g: 112, b: 224, a: 255}
        global mutable dark_theme: bool = true
        global mutable canvas_color: UiCore::Color = UiCore::Color{r: 12, g: 14, b: 20, a: 255}

        def color(r: u8, g: u8, b: u8) -> UiCore::Color:
            return UiCore::rgb(r, g, b)

        def swatch(parent: usize, label: sview, r: u8, g: u8, b: u8, hover_r: u8, hover_g: u8, hover_b: u8) -> usize:
            index: usize = UiFlat::radio_button(parent, 132.0, 48.0, color(r, g, b), color(hover_r, hover_g, hover_b), color(r / 2, g / 2, b / 2))
            UiFlat::set_grow(index, 1.0)
            UiFlat::set_text(index, label, 15.0, color(255, 255, 255))
            return index

        def apply_framework_theme() -> void:
            visual: mutable UiFlat::Theme = UiFlat::theme()
            visual.focus_ring <- UiCore::Color{r: accent.r, g: accent.g, b: accent.b, a: 245}
            visual.selection <- UiCore::Color{r: accent.r, g: accent.g, b: accent.b, a: 190}
            if dark_theme:
                visual.control_mark <- UiCore::rgba(255, 255, 255, 185)
                visual.control_mark_strong <- UiCore::rgba(255, 255, 255, 255)
            else:
                visual.control_mark <- UiCore::rgba(38, 48, 66, 145)
                visual.control_mark_strong <- UiCore::Color{r: accent.r, g: accent.g, b: accent.b, a: 255}
            UiFlat::set_theme(visual)

        def select_palette(selected: usize, next: UiCore::Color) -> void:
            accent <- next
            apply_framework_theme()
            UiFlat::set_selected(swatch_red, selected == swatch_red)
            UiFlat::set_selected(swatch_green, selected == swatch_green)
            UiFlat::set_selected(swatch_blue, selected == swatch_blue)
            track: UiCore::Color = color(54, 61, 78) if dark_theme else color(198, 205, 220)
            thumb: UiCore::Color = color(238, 242, 252) if dark_theme else color(255, 255, 255)
            UiFlat::set_colors(intensity_slider, track, next, thumb)
            UiFlat::set_colors(intensity_progress, track, next, next)

        def apply_theme() -> void:
            apply_framework_theme()
            if dark_theme:
                canvas_color <- color(12, 14, 20)
                UiFlat::set_color(root_panel, color(17, 20, 27))
                UiFlat::set_color(content, color(31, 36, 48))
                UiFlat::set_text(title_label, "elisa-ui", 30.0, color(244, 246, 252))
                UiFlat::set_text(subtitle_label, "A small UI framework, drawing every pixel itself.", 15.0, color(148, 158, 180))
                UiFlat::set_colors(project_field, color(27, 32, 43), color(27, 32, 43), color(27, 32, 43))
                UiFlat::set_text(project_field, "Project name", 15.0, color(232, 236, 246))
                UiFlat::set_text(preview_label, "Canvas preview", 20.0, color(238, 241, 248))
                UiFlat::set_text(help_label, "Choose a palette above. Keys 1-3 switch colour; T changes theme.", 14.0, color(166, 175, 196))
                UiFlat::set_text(intensity_label, "Preview intensity", 13.0, color(148, 158, 180))
                UiFlat::set_colors(intensity_slider, color(54, 61, 78), accent, color(238, 242, 252))
                UiFlat::set_colors(intensity_progress, color(54, 61, 78), accent, accent)
                UiFlat::set_colors(theme_button, color(48, 54, 68), color(62, 70, 88), color(35, 40, 52))
                UiFlat::set_text(theme_button, "Dark mode", 15.0, color(245, 247, 252))
                UiFlat::set_selected(theme_button, true)
            else:
                canvas_color <- color(226, 231, 241)
                UiFlat::set_color(root_panel, color(238, 241, 247))
                UiFlat::set_color(content, color(252, 253, 255))
                UiFlat::set_text(title_label, "elisa-ui", 30.0, color(25, 31, 43))
                UiFlat::set_text(subtitle_label, "A small UI framework, drawing every pixel itself.", 15.0, color(91, 103, 126))
                UiFlat::set_colors(project_field, color(250, 251, 254), color(250, 251, 254), color(250, 251, 254))
                UiFlat::set_text(project_field, "Project name", 15.0, color(35, 43, 58))
                UiFlat::set_text(preview_label, "Canvas preview", 20.0, color(31, 39, 54))
                UiFlat::set_text(help_label, "Choose a palette above. Keys 1-3 switch colour; T changes theme.", 14.0, color(98, 110, 132))
                UiFlat::set_text(intensity_label, "Preview intensity", 13.0, color(91, 103, 126))
                UiFlat::set_colors(intensity_slider, color(198, 205, 220), accent, color(255, 255, 255))
                UiFlat::set_colors(intensity_progress, color(198, 205, 220), accent, accent)
                UiFlat::set_colors(theme_button, color(218, 223, 234), color(205, 212, 226), color(190, 198, 214))
                UiFlat::set_text(theme_button, "Dark mode", 15.0, color(35, 43, 58))
                UiFlat::set_selected(theme_button, false)

        # A small vector scene makes the empty content card earn its space and
        # exercises the custom backend's shapes, alpha blending and line work.
        # It is derived from the laid-out card every frame, so resize remains live.
        def paint_preview() -> void:
            card: UiFlat::Widget = UiFlat::widget(content)
            meter: UiFlat::Widget = UiFlat::widget(intensity_progress)
            centre_x: f32 = card.x + card.width * 0.5
            art_top: f32 = meter.y + meter.height + 18.0
            art_bottom: f32 = card.y + card.height - 24.0
            art_height: f32 = art_bottom - art_top
            centre_y: f32 = art_top + art_height * 0.5
            intensity: f32 = UiFlat::widget(intensity_slider).value
            base_radius: f32 = 76.0 if card.height > 260.0 else 48.0
            desired_radius: f32 = base_radius * (0.72 + intensity * 0.42)
            available_radius: f32 = art_height * 0.5 - 34.0
            radius: mutable f32 = desired_radius if desired_radius < available_radius else available_radius
            radius <- 12.0 if radius < 12.0 else radius

            # Quiet guide rails behind the focal mark.
            guide: UiCore::Color = UiCore::rgba(255, 255, 255, 24)
            UiCore::fill(UiCore::Line{from_point: UiCore::Vec2(card.x + 32.0, centre_y), to_point: UiCore::Vec2(card.x + card.width - 32.0, centre_y)}, guide)
            UiCore::fill(UiCore::Line{from_point: UiCore::Vec2(centre_x, art_top), to_point: UiCore::Vec2(centre_x, art_bottom)}, guide)

            # Layered translucent geometry: deliberately backend-neutral commands,
            # not AppKit drawing hidden in the example.
            halo: UiCore::Color = UiCore::Color{r: accent.r, g: accent.g, b: accent.b, a: 42}
            soft: UiCore::Color = UiCore::Color{r: accent.r, g: accent.g, b: accent.b, a: 105}
            UiCore::fill(UiCore::Circle{center: UiCore::Vec2(centre_x, centre_y), radius: radius + 34.0}, halo)
            UiCore::fill(UiCore::Circle{center: UiCore::Vec2(centre_x - radius * 0.42, centre_y + radius * 0.18), radius: radius}, accent)
            UiCore::fill(UiCore::Circle{center: UiCore::Vec2(centre_x + radius * 0.55, centre_y - radius * 0.28), radius: radius * 0.72}, soft)
            UiCore::fill(UiCore::Triangle{
                a: UiCore::Vec2(centre_x + radius * 0.15, centre_y - radius * 0.72),
                b: UiCore::Vec2(centre_x + radius * 1.05, centre_y + radius * 0.72),
                c: UiCore::Vec2(centre_x - radius * 0.34, centre_y + radius * 0.56),
            }, UiCore::rgba(246, 248, 255, 185))

    public:
        def init() -> void:
            UiFlat::reset()
            root: usize = UiFlat::panel(UiFlat::NONE, UiConst::Axis.Column, 28.0, 18.0, color(17, 20, 27))
            root_panel <- root

            # Static text: the run is a view, and the component's allocator never
            # reclaims, so labels must not build strings per frame.
            title_label <- UiFlat::label(root, "elisa-ui", 30.0, color(244, 246, 252))
            subtitle_label <- UiFlat::label(root, "A small UI framework, drawing every pixel itself.", 15.0, color(148, 158, 180))
            project_field <- UiFlat::text_field(root, "Project name", "Name this canvas", "Canvas study", 240.0, 40.0, 15.0, color(232, 236, 246), color(27, 32, 43))
            UiFlat::set_help(project_field, "Editable custom-drawn text field")

            toolbar: usize = UiFlat::panel(root, UiConst::Axis.Row, 0.0, 14.0, UiCore::Color{r: 0, g: 0, b: 0, a: 0})
            UiFlat::set_grow(toolbar, 0.0)
            swatch_red <- swatch(toolbar, "Coral", 204, 76, 92, 225, 96, 110)
            swatch_green <- swatch(toolbar, "Mint", 54, 166, 118, 70, 190, 138)
            swatch_blue <- swatch(toolbar, "Ocean", 64, 112, 224, 84, 136, 244)
            UiFlat::set_help(swatch_red, "Use the warm coral palette (keyboard: 1)")
            UiFlat::set_help(swatch_green, "Use the mint palette (keyboard: 2)")
            UiFlat::set_help(swatch_blue, "Use the ocean palette (keyboard: 3)")
            UiFlat::set_selected(swatch_blue, true)
            theme_button <- UiFlat::check_box(toolbar, 112.0, 48.0, color(48, 54, 68), color(62, 70, 88), color(35, 40, 52))
            UiFlat::set_text(theme_button, "Dark mode", 15.0, color(245, 247, 252))
            UiFlat::set_help(theme_button, "Toggle dark appearance (keyboard: T)")
            UiFlat::set_selected(theme_button, true)

            content <- UiFlat::panel(root, UiConst::Axis.Column, 24.0, 10.0, color(31, 36, 48))
            UiFlat::set_grow(content, 1.0)
            preview_label <- UiFlat::label(content, "Canvas preview", 20.0, color(238, 241, 248))
            help_label <- UiFlat::label(content, "Choose a palette above. Keys 1-3 switch colour; T changes theme.", 14.0, color(166, 175, 196))
            intensity_label <- UiFlat::label(content, "Preview intensity", 13.0, color(148, 158, 180))
            intensity_slider <- UiFlat::slider(content, "Preview intensity", 180.0, 24.0, 0.72, color(54, 61, 78), accent, color(238, 242, 252))
            UiFlat::set_help(intensity_slider, "Adjust the scale of the canvas artwork with drag or arrow keys")
            intensity_progress <- UiFlat::progress_bar(content, "Preview level", 180.0, 10.0, 0.72, color(54, 61, 78), accent)

            UiFlat::layout(UiCore::viewport_width(), UiCore::viewport_height())

        def widget_event(widget: usize, event: i32) -> void:
            if event == UiConst::WidgetEvent.Change.i32() and widget == intensity_slider:
                UiFlat::set_value(intensity_progress, UiFlat::widget(intensity_slider).value)
                return
            return if event != UiConst::WidgetEvent.Click.i32()
            clicks <- clicks + 1
            if widget == swatch_red:
                select_palette(swatch_red, color(204, 76, 92))
            elif widget == swatch_green:
                select_palette(swatch_green, color(54, 166, 118))
            elif widget == swatch_blue:
                select_palette(swatch_blue, color(64, 112, 224))
            elif widget == theme_button:
                dark_theme <- not dark_theme
                apply_theme()

        def event(incoming: UiCore::Event) -> void:
            match incoming:
                UiCore::KeyEvent.Down(code):
                    select_palette(swatch_red, color(204, 76, 92)) if code == UiCore::Key.Digit1
                    select_palette(swatch_green, color(54, 166, 118)) if code == UiCore::Key.Digit2
                    select_palette(swatch_blue, color(64, 112, 224)) if code == UiCore::Key.Digit3
                    if code == UiCore::Key.T:
                        dark_theme <- not dark_theme
                        apply_theme()
                _:
                    pass
            UiFlat::handle(incoming)

        def frame() -> void:
            UiCore::clear(canvas_color)
            UiFlat::paint()
            paint_preview()

# The application half of the contract. Top-level by name; one call each.
def app_init() -> void:
    HelloApp::init()

def app_widget_event(widget: usize, event: i32) -> void:
    HelloApp::widget_event(widget, event)

def app_event(event: UiCore::Event) -> void:
    HelloApp::event(event)

def app_text_input(text: sview) -> void:
    UiFlat::insert_text(text)

def app_text_editing(text: sview, selected_start: i32, selected_length: i32) -> void:
    UiFlat::update_marked_text_utf8_characters(text, selected_start, selected_length)

def app_frame() -> void:
    HelloApp::frame()
