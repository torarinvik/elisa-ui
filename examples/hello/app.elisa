# hello: a widget tree driven by the same app.elisa on both backends.
#
# A toolbar row of buttons above a content area. Clicking a swatch recolours the
# content panel, which is the whole point of the example: the app never touches
# geometry or hit testing, only the tree and its own state.

global mutable app_swatch_red: usize = UiFlat::NONE
global mutable app_swatch_green: usize = UiFlat::NONE
global mutable app_swatch_blue: usize = UiFlat::NONE
global mutable app_content: usize = UiFlat::NONE
global mutable app_clicks: i32 = 0

def app_color(r: u8, g: u8, b: u8) -> UiCore::Color:
    return UiCore::rgb(r, g, b)

def app_swatch(parent: usize, r: u8, g: u8, b: u8) -> usize:
    index: usize = UiFlat::button(parent, 120.0, 44.0, app_color(r, g, b), app_color(r + 30, g + 30, b + 30), app_color(r / 2, g / 2, b / 2))
    UiFlat::set_grow(index, 1.0)
    return index

def app_init() -> void:
    UiFlat::reset()
    root: usize = UiFlat::panel(UiFlat::NONE, UiAxis::COLUMN, 16.0, 16.0, app_color(24, 26, 32))

    # Static text: the run is a view, and the component's allocator never
    # reclaims, so labels must not build strings per frame.
    _ = UiFlat::label(root, "elisa-ui", 22.0, app_color(235, 236, 240))

    toolbar: usize = UiFlat::panel(root, UiAxis::ROW, 0.0, 12.0, UiCore::Color{r: 0, g: 0, b: 0, a: 0})
    UiFlat::set_grow(toolbar, 0.0)
    app_swatch_red <- app_swatch(toolbar, 200, 70, 70)
    app_swatch_green <- app_swatch(toolbar, 80, 180, 100)
    app_swatch_blue <- app_swatch(toolbar, 82, 130, 235)

    app_content <- UiFlat::panel(root, UiAxis::COLUMN, 12.0, 0.0, app_color(44, 48, 60))
    UiFlat::set_grow(app_content, 1.0)
    _ = UiFlat::label(app_content, "Pick a colour above", 16.0, app_color(190, 194, 205))

    UiFlat::layout(UiCore::viewport_width(), UiCore::viewport_height())

def app_widget_event(widget: usize, event: i32) -> void:
    return if event != UiWidgetEvent::CLICK
    app_clicks <- app_clicks + 1
    if widget == app_swatch_red:
        UiFlat::set_color(app_content, app_color(120, 40, 40))
    elif widget == app_swatch_green:
        UiFlat::set_color(app_content, app_color(40, 110, 60))
    elif widget == app_swatch_blue:
        UiFlat::set_color(app_content, app_color(40, 70, 140))

def app_event(event: mutable UiCore::Event&) -> void:
    if event.kind == UiEvent::RESIZE:
        UiFlat::layout(event.x, event.y)
        return
    UiFlat::pointer(event.kind, event.x, event.y)

def app_frame() -> void:
    UiCore::clear(UiCore::rgb(16, 17, 21))
    UiFlat::paint()
