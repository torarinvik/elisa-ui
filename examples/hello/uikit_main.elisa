# The shared hello app, painted by elisa-ui into a UIKit-hosted custom view.
#
# Nothing in app.elisa changes for iOS. The surface is smaller and the pointer
# is a finger, but the retained tree, the layout and the paint are the same
# ones the macOS canvas runs.
include "../../src/platform/uikit/ui_uikit_flat.elisa"
include "app.elisa"

def main() -> i64:
    options: mutable UiUIKit::LaunchOptions = UiUIKit::default_launch_options()
    # The hello tree is laid out for a phone in portrait. Keeping the status
    # bar is app policy, so it is stated here rather than inherited.
    options.status_bar <- true
    options.idle_timer <- true
    return UiUIKit::run_with_options(options)
