# Reference-app optional-resource and async-error flow.
#
# This is a deterministic demo of the same resource states a real host would
# report asynchronously. The host still owns verified bytes and decoding; the
# example only exercises Elisa's visible state and recovery policy. The
# generic resource-presentation mapper is covered independently by its tests;
# this app keeps its include graph small enough for every shared entry point.

include "../../src/widgets/ui_resources.elisa"
include "../../src/widgets/ui_handles.elisa"

module HelloResourceDemo:
    private:
        global mutable hello_resource_asset: UiResources::ResourceHandle = UiResources::resource_invalid()
        global mutable hello_resource_heading: UiHandles::Handle = UiHandles::invalid()
        global mutable hello_resource_status: UiHandles::Handle = UiHandles::invalid()
        global mutable hello_resource_progress: UiHandles::Handle = UiHandles::invalid()
        global mutable hello_resource_load_button: UiHandles::Handle = UiHandles::invalid()
        global mutable hello_resource_complete_button: UiHandles::Handle = UiHandles::invalid()
        global mutable hello_resource_fail_button: UiHandles::Handle = UiHandles::invalid()
        global mutable hello_resource_retry_button: UiHandles::Handle = UiHandles::invalid()

        def hello_resource_color(r: u8, g: u8, b: u8) -> UiCore::Color:
            return UiCore::rgb(r, g, b)

        def hello_resource_update_view() -> void:
            display: UiResources::State = UiResources::state(hello_resource_asset)
            if display == UiResources::State.Requested:
                UiHandles::set_text(hello_resource_status, "Optional preview loading…", 13.0, hello_resource_color(182, 190, 208))
            elif display == UiResources::State.Ready:
                UiHandles::set_text(hello_resource_status, "Optional preview ready.", 13.0, hello_resource_color(125, 206, 158))
            elif display == UiResources::State.Failed:
                UiHandles::set_text(hello_resource_status, "Preview failed — retry or keep working offline.", 13.0, hello_resource_color(232, 152, 132))
            elif display == UiResources::State.UnavailableOffline:
                UiHandles::set_text(hello_resource_status, "Preview unavailable offline.", 13.0, hello_resource_color(232, 188, 132))
            elif display == UiResources::State.Cancelled:
                UiHandles::set_text(hello_resource_status, "Preview request cancelled.", 13.0, hello_resource_color(182, 190, 208))
            else:
                UiHandles::set_text(hello_resource_status, "Preview has not been requested.", 13.0, hello_resource_color(182, 190, 208))
            UiHandles::set_value(hello_resource_progress, UiResources::decoded_progress(hello_resource_asset))
            UiHandles::set_enabled(hello_resource_retry_button, UiResources::can_retry(hello_resource_asset))

        def hello_resource_load() -> void:
            return if not UiResources::resource_is_valid(hello_resource_asset)
            if UiResources::state(hello_resource_asset) == UiResources::State.Cancelled:
                hello_resource_asset <- UiResources::request("images/reference-preview", 77)
            _ = UiResources::set_progress(hello_resource_asset, 0.35, 0.20)
            hello_resource_update_view()

        def hello_resource_complete() -> void:
            return if not UiResources::resource_is_valid(hello_resource_asset)
            _ = UiResources::set_progress(hello_resource_asset, 1.0, 1.0)
            _ = UiResources::set_state(hello_resource_asset, UiResources::State.Ready)
            hello_resource_update_view()

        def hello_resource_fail() -> void:
            return if not UiResources::resource_is_valid(hello_resource_asset)
            _ = UiResources::fail(hello_resource_asset, UiResources::FailureKind.RetryableTransport)
            hello_resource_update_view()

        def hello_resource_retry() -> void:
            replacement: UiResources::ResourceHandle = UiResources::retry(hello_resource_asset)
            return if not UiResources::resource_is_valid(replacement)
            hello_resource_asset <- replacement
            hello_resource_update_view()

    public:
        # Renderer adapters may inspect the logical asset identity without
        # reaching into this demo's private state. The returned handle is
        # generation checked by UiResources at every use.
        def renderer_resource() -> UiResources::ResourceHandle:
            return hello_resource_asset

        # A host fixture can provide a decoded image after the app has
        # requested it. Keep the state transition in Elisa so the renderer
        # never treats a borrowed image pointer as proof that its logical
        # resource is ready.
        def renderer_mark_ready() -> bool:
            return false if not UiResources::resource_is_valid(hello_resource_asset)
            return true if UiResources::state(hello_resource_asset) == UiResources::State.Ready
            return false if not UiResources::set_state(hello_resource_asset, UiResources::State.Ready)
            hello_resource_update_view()
            return true

        # Exercise replacement semantics for a renderer before replay. The
        # old generation is failed, then retry() rotates its identity; callers
        # must replace their handle and bind the new generation.
        def renderer_replace_ready() -> UiResources::ResourceHandle:
            return UiResources::resource_invalid() if not UiResources::resource_is_valid(hello_resource_asset)
            current: UiResources::State = UiResources::state(hello_resource_asset)
            if current != UiResources::State.Failed:
                return UiResources::resource_invalid() if not UiResources::fail(hello_resource_asset, UiResources::FailureKind.RetryableTransport)
            replacement: UiResources::ResourceHandle = UiResources::retry(hello_resource_asset)
            return UiResources::resource_invalid() if not UiResources::resource_is_valid(replacement)
            hello_resource_asset <- replacement
            _ = UiResources::set_intrinsic_size(replacement, 180.0, 48.0)
            _ = UiResources::set_state(replacement, UiResources::State.Ready)
            hello_resource_update_view()
            return replacement

        def init(parent: UiHandles::Handle) -> void:
            UiResources::reset()
            panel: UiHandles::Handle = UiHandles::column(parent, 0.0, 6.0, UiCore::Color{r: 0, g: 0, b: 0, a: 0})
            UiHandles::set_grow(panel, 0.0)
            hello_resource_heading <- UiHandles::label(panel, "Optional preview", 14.0, hello_resource_color(148, 158, 180))
            UiHandles::set_help(hello_resource_heading, "A host-owned asset with explicit loading and failure states")
            hello_resource_status <- UiHandles::label(panel, "", 13.0, hello_resource_color(182, 190, 208))
            hello_resource_progress <- UiHandles::progress_bar_labeled(panel, "Preview progress", 180.0, 8.0, 0.0, hello_resource_color(54, 61, 78), hello_resource_color(84, 148, 210))
            hello_resource_load_button <- UiHandles::button(panel, 92.0, 30.0, hello_resource_color(48, 54, 68), hello_resource_color(62, 70, 88), hello_resource_color(35, 40, 52))
            hello_resource_complete_button <- UiHandles::button(panel, 92.0, 30.0, hello_resource_color(48, 54, 68), hello_resource_color(62, 70, 88), hello_resource_color(35, 40, 52))
            hello_resource_fail_button <- UiHandles::button(panel, 92.0, 30.0, hello_resource_color(92, 56, 58), hello_resource_color(116, 68, 70), hello_resource_color(70, 42, 44))
            hello_resource_retry_button <- UiHandles::button(panel, 92.0, 30.0, hello_resource_color(48, 54, 68), hello_resource_color(62, 70, 88), hello_resource_color(35, 40, 52))
            UiHandles::set_text(hello_resource_load_button, "Load", 12.0, hello_resource_color(238, 242, 250))
            UiHandles::set_text(hello_resource_complete_button, "Complete", 12.0, hello_resource_color(238, 242, 250))
            UiHandles::set_text(hello_resource_fail_button, "Fail", 12.0, hello_resource_color(255, 230, 230))
            UiHandles::set_text(hello_resource_retry_button, "Retry", 12.0, hello_resource_color(238, 242, 250))
            UiHandles::set_help(hello_resource_load_button, "Simulate a host progress update (keyboard: L)")
            UiHandles::set_help(hello_resource_complete_button, "Simulate verified decode completion (keyboard: C)")
            UiHandles::set_help(hello_resource_fail_button, "Simulate a retryable transport error (keyboard: F)")
            UiHandles::set_help(hello_resource_retry_button, "Start a fresh generation after failure (keyboard: Y)")
            hello_resource_asset <- UiResources::request("images/reference-preview", 77)
            _ = UiResources::set_intrinsic_size(hello_resource_asset, 180.0, 48.0)
            hello_resource_update_view()

        def widget_event(widget: usize, event: i32) -> bool:
            return false if not UiHandles::event_is(event, UiConst::WidgetEvent.Click)
            if UiHandles::callback_matches(widget, hello_resource_load_button):
                hello_resource_load()
                return true
            if UiHandles::callback_matches(widget, hello_resource_complete_button):
                hello_resource_complete()
                return true
            if UiHandles::callback_matches(widget, hello_resource_fail_button):
                hello_resource_fail()
                return true
            if UiHandles::callback_matches(widget, hello_resource_retry_button):
                hello_resource_retry()
                return true
            return false

        def key_down(code: UiCore::Key) -> bool:
            if code == UiCore::Key.L:
                hello_resource_load()
                return true
            if code == UiCore::Key.C:
                hello_resource_complete()
                return true
            if code == UiCore::Key.F:
                hello_resource_fail()
                return true
            if code == UiCore::Key.Y:
                hello_resource_retry()
                return true
            return false
