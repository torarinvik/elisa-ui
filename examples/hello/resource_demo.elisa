# Reference-app optional-resource and async-error flow.
#
# This is a deterministic demo of the same resource states a real host would
# report asynchronously. The host still owns verified bytes and decoding; the
# example only exercises Elisa's visible state and recovery policy. The
# generic resource-presentation mapper is covered independently by its tests;
# this app keeps its include graph small enough for every shared entry point.

include "../../src/widgets/ui_resources.elisa"
include "../../src/widgets/ui_handles.elisa"

module HelloResourceDemo:
    private:
        global mutable resource: UiResources::Handle = UiResources::invalid()
        global mutable heading: UiHandles::Handle = UiHandles::invalid()
        global mutable status: UiHandles::Handle = UiHandles::invalid()
        global mutable progress: UiHandles::Handle = UiHandles::invalid()
        global mutable load_button: UiHandles::Handle = UiHandles::invalid()
        global mutable complete_button: UiHandles::Handle = UiHandles::invalid()
        global mutable fail_button: UiHandles::Handle = UiHandles::invalid()
        global mutable retry_button: UiHandles::Handle = UiHandles::invalid()

        def color(r: u8, g: u8, b: u8) -> UiCore::Color:
            return UiCore::rgb(r, g, b)

        def update_view() -> void:
            display: UiResources::State = UiResources::state(resource)
            if display == UiResources::State.Requested:
                UiHandles::set_text(status, "Optional preview loading…", 13.0, color(182, 190, 208))
            elif display == UiResources::State.Ready:
                UiHandles::set_text(status, "Optional preview ready.", 13.0, color(125, 206, 158))
            elif display == UiResources::State.Failed:
                UiHandles::set_text(status, "Preview failed — retry or keep working offline.", 13.0, color(232, 152, 132))
            elif display == UiResources::State.UnavailableOffline:
                UiHandles::set_text(status, "Preview unavailable offline.", 13.0, color(232, 188, 132))
            elif display == UiResources::State.Cancelled:
                UiHandles::set_text(status, "Preview request cancelled.", 13.0, color(182, 190, 208))
            else:
                UiHandles::set_text(status, "Preview has not been requested.", 13.0, color(182, 190, 208))
            UiHandles::set_value(progress, UiResources::decoded_progress(resource))
            UiHandles::set_enabled(retry_button, UiResources::can_retry(resource))

        def load() -> void:
            return if not UiResources::is_valid(resource)
            if UiResources::state(resource) == UiResources::State.Cancelled:
                resource <- UiResources::request("images/reference-preview", 77)
            _ = UiResources::set_progress(resource, 0.35, 0.20)
            update_view()

        def complete() -> void:
            return if not UiResources::is_valid(resource)
            _ = UiResources::set_progress(resource, 1.0, 1.0)
            _ = UiResources::set_state(resource, UiResources::State.Ready)
            update_view()

        def fail() -> void:
            return if not UiResources::is_valid(resource)
            _ = UiResources::fail(resource, UiResources::FailureKind.RetryableTransport)
            update_view()

        def retry() -> void:
            replacement: UiResources::Handle = UiResources::retry(resource)
            return if not UiResources::is_valid(replacement)
            resource <- replacement
            update_view()

    public:
        def init(parent: UiHandles::Handle) -> void:
            UiResources::reset()
            panel: UiHandles::Handle = UiHandles::column(parent, 0.0, 6.0, UiCore::Color{r: 0, g: 0, b: 0, a: 0})
            UiHandles::set_grow(panel, 0.0)
            heading <- UiHandles::label(panel, "Optional preview", 14.0, color(148, 158, 180))
            UiHandles::set_help(heading, "A host-owned asset with explicit loading and failure states")
            status <- UiHandles::label(panel, "", 13.0, color(182, 190, 208))
            progress <- UiHandles::progress_bar_labeled(panel, "Preview progress", 180.0, 8.0, 0.0, color(54, 61, 78), color(84, 148, 210))
            load_button <- UiHandles::button(panel, 92.0, 30.0, color(48, 54, 68), color(62, 70, 88), color(35, 40, 52))
            complete_button <- UiHandles::button(panel, 92.0, 30.0, color(48, 54, 68), color(62, 70, 88), color(35, 40, 52))
            fail_button <- UiHandles::button(panel, 92.0, 30.0, color(92, 56, 58), color(116, 68, 70), color(70, 42, 44))
            retry_button <- UiHandles::button(panel, 92.0, 30.0, color(48, 54, 68), color(62, 70, 88), color(35, 40, 52))
            UiHandles::set_text(load_button, "Load", 12.0, color(238, 242, 250))
            UiHandles::set_text(complete_button, "Complete", 12.0, color(238, 242, 250))
            UiHandles::set_text(fail_button, "Fail", 12.0, color(255, 230, 230))
            UiHandles::set_text(retry_button, "Retry", 12.0, color(238, 242, 250))
            UiHandles::set_help(load_button, "Simulate a host progress update (keyboard: L)")
            UiHandles::set_help(complete_button, "Simulate verified decode completion (keyboard: C)")
            UiHandles::set_help(fail_button, "Simulate a retryable transport error (keyboard: F)")
            UiHandles::set_help(retry_button, "Start a fresh generation after failure (keyboard: Y)")
            resource <- UiResources::request("images/reference-preview", 77)
            _ = UiResources::set_intrinsic_size(resource, 180.0, 48.0)
            update_view()

        def widget_event(widget: usize, event: i32) -> bool:
            return false if not UiHandles::event_is(event, UiConst::WidgetEvent.Click)
            if UiHandles::callback_matches(widget, load_button):
                load()
                return true
            if UiHandles::callback_matches(widget, complete_button):
                complete()
                return true
            if UiHandles::callback_matches(widget, fail_button):
                fail()
                return true
            if UiHandles::callback_matches(widget, retry_button):
                retry()
                return true
            return false

        def key_down(code: UiCore::Key) -> bool:
            if code == UiCore::Key.L:
                load()
                return true
            if code == UiCore::Key.C:
                complete()
                return true
            if code == UiCore::Key.F:
                fail()
                return true
            if code == UiCore::Key.Y:
                retry()
                return true
            return false
