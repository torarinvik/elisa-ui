# elisa-ui on iOS, as REAL native controls.
#
# The same widget tree the macOS entry point hands to AppKit, handed to UIKit
# instead: UILabels, UIButtons, a UISlider, a UIProgressView and a UITextField
# that iOS draws, focuses, scales with Dynamic Type and reads aloud. Nothing
# here is platform-specific -- the tree, the layout and the kinds are the
# portable widget layer; only the backend changed.
#
# Every control kind the backend realizes is in this tree on purpose. A
# vocabulary with a hole in it looks exactly like a vocabulary without one
# until somebody builds the widget that falls in.

include "../../src/platform/uikit/ui_uikit_controls_hierarchy.elisa"

using UiWidgets

# What the last control reported, which is the only thing on screen that the
# APPLICATION put there rather than the platform.
global mutable click_count: i32 = 0
global mutable status_digits: u8[24] = zeroed

def app_widget_event(widget: UiWidgets::Widget, event: i32) -> void:
    pass

# A native control reporting what the user did. The index is the control's own
# place in the realized list, and the event is the shared Click/Change/Submit
# vocabulary -- no toolkit type reaches the application.
#
# Rebuilding from a control's own action is the strongest thing this example
# can say: the tree is realized a second time, over a live UIKit interface,
# while one of its buttons is in the middle of its action.
def app_control_event(index: i32, event: i32) -> void:
    can Memory.Allocate, Abort.Panic, Ui.Controls, Unsafe.PointerCast:
        return if event != UiConst::WidgetEvent.Click.i32()
        click_count <- click_count + 1
        app_controls_realize()

# Text metrics belong to the platform. UIKit measures its own controls, so the
# layout pass only needs something consistent to size boxes with.
def ui_measure_text_width(text: sview, size: f32, weighted: bool) -> f32:
    return text.len.f32() * size * 0.55
def ui_measure_text_height(text: sview, size: f32) -> f32:
    return size
def ui_font_ascent(size: f32) -> f32:
    return size
def ui_text_line_height(size: f32) -> f32:
    return size * 1.3

def grey(v: u8) -> UiCore::Color:
    return UiCore::Color{r: v, g: v, b: v, a: 255}

def tint(r: u8, g: u8, b: u8) -> UiCore::Color:
    return UiCore::Color{r: r, g: g, b: b, a: 255}

# "Clicks: N", written into an owned buffer because the control list copies
# what it is given and the digits have to exist while it does.
def status_line() -> sview:
    prefix: sview = "Clicks: "
    for index in 0..<prefix.len.usize():
        status_digits[index] <- prefix.data[index]
    written: mutable usize = prefix.len.usize()
    value: mutable i32 = click_count
    if value == 0:
        status_digits[written] <- 48
        written <- written + 1
    else:
        # Digits come out backwards, so they are placed and then reversed.
        start: usize = written
        for _ in 0..<10:
            break if value == 0
            status_digits[written] <- (48 + value % 10).u8()
            written <- written + 1
            value <- value / 10
        half: usize = (written - start) / 2
        for offset in 0..<half:
            swap: u8 = status_digits[start + offset]
            status_digits[start + offset] <- status_digits[written - 1 - offset]
            status_digits[written - 1 - offset] <- swap
    return sview(&status_digits[0], 0, written.i64())

def push(label: sview) -> Widget:
    can Memory.Allocate, Abort.Panic:
        return Button.Push(min_width: 96.0, min_height: 44.0, grow: 1.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, overlay: false, first_child: null, next_sibling: null, label: label, rest: grey(60), hover: grey(90), press: grey(30))

def radio(label: sview, selected: bool) -> Widget:
    can Memory.Allocate, Abort.Panic:
        return Button.Radio(min_width: 88.0, min_height: 44.0, grow: 1.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, overlay: false, first_child: null, next_sibling: null, label: label, group: 1, selected: selected, rest: grey(60), hover: grey(90), press: grey(30))

def caption(text: sview) -> Widget:
    can Memory.Allocate, Abort.Panic:
        return Control.Label(min_width: 0.0, min_height: 22.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, overlay: false, first_child: null, next_sibling: null, text: text, size: 15.0, ink: grey(210))

def row(first: Widget?) -> Widget:
    can Memory.Allocate, Abort.Panic:
        return Container.Box(min_width: 0.0, min_height: 48.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, overlay: false, first_child: first, next_sibling: null, axis: UiConst::Axis.Row, padding: 0.0, spacing: 8.0, fill: UiCore::Color{r: 0, g: 0, b: 0, a: 0})

def build() -> Widget:
    can Memory.Allocate, Abort.Panic:
        open_button: Widget = push("Open")
        save_button: Widget = push("Save")
        wrap_box: Widget = Button.Check(min_width: 120.0, min_height: 44.0, grow: 1.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, overlay: false, first_child: null, next_sibling: null, label: "Wrap lines", checked: true, rest: grey(60), hover: grey(90), press: grey(30))
        # A CAPTIONLESS SELECTABLE, UNTICKED. UIKit draws a system button as
        # its title, so one whose whole content is its state would be an empty
        # patch you can tap but not see; the backend gives it the mark iOS uses
        # in a list row instead. This example exists to exercise every kind,
        # and it had no such control -- so the unticked half of that mark was
        # the one thing in the backend nothing here could show.
        mark_box: Widget = Button.Check(min_width: 44.0, min_height: 44.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, overlay: false, first_child: null, next_sibling: null, label: "", checked: false, rest: grey(60), hover: grey(90), press: grey(30))
        open_button.next_sibling <- save_button
        save_button.next_sibling <- wrap_box
        wrap_box.next_sibling <- mark_box

        # A 44pt row is the platform's touch-target floor, which is why this
        # toolbar is taller than the macOS one built from the same kinds.
        toolbar: Widget = Container.Box(min_width: 0.0, min_height: 60.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, overlay: false, first_child: open_button, next_sibling: null, axis: UiConst::Axis.Row, padding: 8.0, spacing: 8.0, fill: grey(30))

        heading: Widget = caption("Every control here is a real UIKit control.")
        field: Widget = Control.TextBox(min_width: 0.0, min_height: 44.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, overlay: false, first_child: null, next_sibling: null, text: "a native text field", caret: 0, size: 15.0, ink: grey(230), fill: grey(45))
        slider_caption: Widget = caption("Intensity")
        slider: Widget = Control.Slider(min_width: 0.0, min_height: 34.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, overlay: false, first_child: null, next_sibling: null, value: 40.0, low: 0.0, high: 100.0, track: grey(70), knob: tint(90, 170, 255))
        progress: Widget = Control.Gauge(min_width: 0.0, min_height: 20.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, overlay: false, first_child: null, next_sibling: null, fraction: 0.4, track: grey(70), bar: tint(90, 170, 255))
        stage_caption: Widget = caption("Stage")
        draft: Widget = radio("Draft", true)
        review: Widget = radio("Review", false)
        final: Widget = radio("Final", false)
        draft.next_sibling <- review
        review.next_sibling <- final
        stages: Widget = row(draft)
        status: Widget = caption(status_line())

        heading.next_sibling <- field
        field.next_sibling <- slider_caption
        slider_caption.next_sibling <- slider
        slider.next_sibling <- progress
        progress.next_sibling <- stage_caption
        stage_caption.next_sibling <- stages
        stages.next_sibling <- status

        # A scroll view, so the one container kind that is not a plain box is
        # realized too: on a short phone the column below is taller than the
        # room for it, which is exactly when a UIScrollView earns its place.
        page: Widget = Container.Box(min_width: 0.0, min_height: 0.0, grow: 1.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, overlay: false, first_child: heading, next_sibling: null, axis: UiConst::Axis.Column, padding: 16.0, spacing: 12.0, fill: grey(38))
        body: Widget = Container.Scroll(min_width: 0.0, min_height: 0.0, grow: 1.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, overlay: false, first_child: page, next_sibling: null, axis: UiConst::Axis.Column, offset: 0.0, fill: grey(38))
        toolbar.next_sibling <- body

        return Window.Top(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, overlay: false, first_child: toolbar, next_sibling: null, title: "elisa-ui on UIKit", resizable: true)

# The scene calls this once it has a surface, and again whenever that surface
# changes -- a rotation, a split view. The tree is laid out against the usable
# part of the scene rather than a size guessed at build time, so the toolbar
# does not end up under the clock.
def app_controls_realize() -> void:
    can Memory.Allocate, Abort.Panic, Ui.Controls, Unsafe.PointerCast:
        root: Widget = build()
        layout(root, UiUIKitControls::content_width(), UiUIKitControls::content_height())
        UiUIKitControls::realize(root)

def main() -> i64:
    can Memory.Allocate, Abort.Panic, Ui.Controls, Unsafe.PointerCast:
        return UiUIKitControls::run()
