# Reference-app list/detail interaction.
#
# The catalog owns only application selection and typed widget handles. The
# retained tree, focus order, layout, painting, and semantic projection remain
# framework responsibilities and therefore work unchanged on every backend.

include "../../src/widgets/ui_handles.elisa"

module HelloCatalog:
    private:
        global mutable panel: UiHandles::Handle = UiHandles::invalid()
        global mutable coral: UiHandles::Handle = UiHandles::invalid()
        global mutable mint: UiHandles::Handle = UiHandles::invalid()
        global mutable ocean: UiHandles::Handle = UiHandles::invalid()
        global mutable detail: UiHandles::Handle = UiHandles::invalid()
        global mutable selected_index: i32 = 0

        def hello_catalog_color(r: u8, g: u8, b: u8) -> UiCore::Color:
            return UiCore::rgb(r, g, b)

        def hello_catalog_choose(index: i32) -> void:
            selected_index <- 0 if index < 0 or index > 2 else index
            UiHandles::set_selected(coral, selected_index == 0)
            UiHandles::set_selected(mint, selected_index == 1)
            UiHandles::set_selected(ocean, selected_index == 2)
            if selected_index == 0:
                UiHandles::set_text(detail, "Coral study — warm contrast and compact controls.", 13.0, hello_catalog_color(182, 190, 208))
            elif selected_index == 1:
                UiHandles::set_text(detail, "Mint study — balanced spacing for calm dashboards.", 13.0, hello_catalog_color(182, 190, 208))
            else:
                UiHandles::set_text(detail, "Ocean study — deep surfaces with bright focus.", 13.0, hello_catalog_color(182, 190, 208))

    public:
        def init(parent: UiHandles::Handle) -> void:
            panel <- UiHandles::column(parent, 0.0, 7.0, UiCore::Color{r: 0, g: 0, b: 0, a: 0})
            UiHandles::set_grow(panel, 0.0)
            heading: UiHandles::Handle = UiHandles::label(panel, "Projects", 14.0, hello_catalog_color(148, 158, 180))
            UiHandles::set_help(heading, "Choose a project to inspect")
            list: UiHandles::Handle = UiHandles::row(panel, 0.0, 8.0, UiCore::Color{r: 0, g: 0, b: 0, a: 0})
            UiHandles::set_grow(list, 0.0)
            coral <- UiHandles::radio_button(list, 108.0, 34.0, hello_catalog_color(86, 52, 64), hello_catalog_color(112, 62, 78), hello_catalog_color(58, 38, 48))
            mint <- UiHandles::radio_button(list, 108.0, 34.0, hello_catalog_color(46, 76, 67), hello_catalog_color(58, 104, 86), hello_catalog_color(34, 57, 50))
            ocean <- UiHandles::radio_button(list, 108.0, 34.0, hello_catalog_color(46, 62, 98), hello_catalog_color(58, 82, 128), hello_catalog_color(32, 44, 72))
            UiHandles::set_text(coral, "Coral", 13.0, hello_catalog_color(238, 242, 250))
            UiHandles::set_text(mint, "Mint", 13.0, hello_catalog_color(238, 242, 250))
            UiHandles::set_text(ocean, "Ocean", 13.0, hello_catalog_color(238, 242, 250))
            UiHandles::set_help(coral, "Open the Coral project detail")
            UiHandles::set_help(mint, "Open the Mint project detail")
            UiHandles::set_help(ocean, "Open the Ocean project detail")
            detail <- UiHandles::label(panel, "", 13.0, hello_catalog_color(182, 190, 208))
            UiHandles::set_help(detail, "Details for the selected project")
            hello_catalog_choose(0)

        def widget_event(widget: usize, event: i32) -> bool:
            return false if not UiHandles::event_is(event, UiConst::WidgetEvent.Click)
            if UiHandles::callback_matches(widget, coral):
                hello_catalog_choose(0)
                return true
            if UiHandles::callback_matches(widget, mint):
                hello_catalog_choose(1)
                return true
            if UiHandles::callback_matches(widget, ocean):
                hello_catalog_choose(2)
                return true
            return false

        def select(index: i32) -> void:
            hello_catalog_choose(index)

        def selected() -> i32:
            return selected_index
