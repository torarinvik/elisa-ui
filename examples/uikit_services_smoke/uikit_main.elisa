# Tap-driven UIKit picker smoke. No system picker is opened on launch.
include "../../src/platform/uikit/ui_uikit_flat.elisa"

module UiKitPickerSmoke:
    private:
        global mutable root: UiHandles::Handle = UiHandles::Handle{widget_id: UiFlat::NONE.u32(), tree_id: 0}
        global mutable status: UiHandles::Handle = UiHandles::Handle{widget_id: UiFlat::NONE.u32(), tree_id: 0}
        global mutable photos_button: UiHandles::Handle = UiHandles::Handle{widget_id: UiFlat::NONE.u32(), tree_id: 0}
        global mutable files_button: UiHandles::Handle = UiHandles::Handle{widget_id: UiFlat::NONE.u32(), tree_id: 0}
        global mutable photos: UiServices::ServiceHandle = UiServices::ServiceHandle{slot: UiServices::NONE_SLOT.u32(), generation: 0}
        global mutable files: UiServices::ServiceHandle = UiServices::ServiceHandle{slot: UiServices::NONE_SLOT.u32(), generation: 0}
        global mutable photos_reported: UiServices::PickerState = UiServices::PickerState.Idle
        global mutable files_reported: UiServices::PickerState = UiServices::PickerState.Idle

        def ok_color() -> UiCore::Color:
            return UiCore::rgb(40, 150, 80)

        def error_color() -> UiCore::Color:
            return UiCore::rgb(190, 50, 40)

        def report_selection(handle: UiServices::ServiceHandle, photo: bool) -> void:
            bytes: u8[8] = zeroed
            count: i32 = UiUIKitServices::read_selection(handle, 0, &bytes[0], 8)
            image: bool = UiServices::selection_kind(handle) == UiServices::ServiceSelectionKind.Image
            released: bool = UiUIKitServices::release_selection(handle)
            if photo:
                UiHandles::set_text(status, "PHOTO PASS: image bytes read and released", 16.0, ok_color()) if count > 0 and image and released
                UiHandles::set_text(status, "PHOTO FAIL: invalid type, read, or release", 16.0, error_color()) if count <= 0 or not image or not released
            else:
                UiHandles::set_text(status, "FILES PASS: content bytes read and released", 16.0, ok_color()) if count > 0 and released
                UiHandles::set_text(status, "FILES FAIL: read or release failed", 16.0, error_color()) if count <= 0 or not released

        def observe(handle: UiServices::ServiceHandle, photo: bool) -> void:
            current: UiServices::PickerState = UiServices::picker(handle)
            previous: UiServices::PickerState = photos_reported if photo else files_reported
            return if current == previous
            photos_reported <- current if photo
            files_reported <- current if not photo
            if current == UiServices::PickerState.Presenting:
                UiHandles::set_text(status, "Opening system photo picker...", 16.0, UiCore::rgb(80, 90, 110)) if photo
                UiHandles::set_text(status, "Opening system file picker...", 16.0, UiCore::rgb(80, 90, 110)) if not photo
            elif current == UiServices::PickerState.Selected:
                report_selection(handle, photo)
            elif current == UiServices::PickerState.Cancelled:
                UiHandles::set_text(status, "Picker cancelled", 16.0, UiCore::rgb(80, 90, 110))
            elif current == UiServices::PickerState.Failed or current == UiServices::PickerState.Unavailable:
                UiHandles::set_text(status, "Picker failed; tap to retry", 16.0, error_color())

    public:
        def init() -> void:
            UiHandles::reset()
            UiServices::reset()
            photos <- UiServices::request(UiServices::ServiceKind.Photos, 1)
            files <- UiServices::request(UiServices::ServiceKind.Files, 1)
            root <- UiHandles::column(UiHandles::root_parent(), 20.0, 16.0, UiCore::rgb(245, 246, 250))
            _ = UiHandles::label(root, "UIKit picker smoke", 24.0, UiCore::rgb(25, 28, 36))
            status <- UiHandles::label(root, "Choose a native picker", 16.0, UiCore::rgb(80, 90, 110))
            photos_button <- UiHandles::button(root, 240.0, 52.0, UiCore::rgb(60, 110, 220), UiCore::rgb(90, 140, 245), UiCore::rgb(40, 80, 180))
            UiHandles::set_text(photos_button, "Choose photo", 18.0, UiCore::rgb(255, 255, 255))
            files_button <- UiHandles::button(root, 240.0, 52.0, UiCore::rgb(60, 110, 220), UiCore::rgb(90, 140, 245), UiCore::rgb(40, 80, 180))
            UiHandles::set_text(files_button, "Choose file", 18.0, UiCore::rgb(255, 255, 255))

        def widget_event(widget: usize) -> void:
            if widget == UiHandles::index(photos_button):
                UiHandles::set_text(status, "Could not present photo picker", 16.0, error_color()) if not UiUIKitServices::present_picker(photos)
            elif widget == UiHandles::index(files_button):
                UiHandles::set_text(status, "Could not present file picker", 16.0, error_color()) if not UiUIKitServices::present_picker(files)

        def frame() -> void can Unsafe.PointerCast:
            observe(photos, true)
            observe(files, false)
            UiHandles::layout(UiCore::viewport_width(), UiCore::viewport_height())
            UiHandles::paint()

def app_init() -> void:
    UiKitPickerSmoke::init()

def app_widget_event(widget: usize, event: i32) -> void:
    UiKitPickerSmoke::widget_event(widget)

def app_event(event: UiCore::Event) -> void:
    UiHandles::handle(event)

def app_text_input(text: sview) -> void:
    UiHandles::insert_text(text)

def app_validate() -> void:
    pass

def app_text_editing(text: sview, selected_start: i32, selected_length: i32) -> void:
    UiHandles::update_marked_text_utf8_characters(text, selected_start, selected_length)

def app_frame() -> void:
    can Unsafe.PointerCast:
        UiKitPickerSmoke::frame()

def main() -> i64:
    return UiUIKit::run()
