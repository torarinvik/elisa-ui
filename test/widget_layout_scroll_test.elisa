# Scroll viewport, bubbling, clipping, and bounded-arena checks.

include "./widget_layout_support.elisa"

def main() -> i64:
    # Flat scroll containers keep their viewport size while translating the
    # measured child strip. Wheel routing, clamping, and hit clipping all live
    # in Elisa and therefore work without a backend window.
    UiFlat::reset()
    scroll_view: usize = UiFlat::scroll(UiFlat::NONE, UiConst::Axis.Column, 120.0, 100.0, UiCore::rgb(12, 16, 24))
    scroll_first: usize = UiFlat::button(scroll_view, 120.0, 60.0, UiCore::rgb(30, 30, 30), UiCore::rgb(40, 40, 40), UiCore::rgb(50, 50, 50))
    scroll_second: usize = UiFlat::button(scroll_view, 120.0, 60.0, UiCore::rgb(30, 30, 30), UiCore::rgb(40, 40, 40), UiCore::rgb(50, 50, 50))
    scroll_third: usize = UiFlat::button(scroll_view, 120.0, 60.0, UiCore::rgb(30, 30, 30), UiCore::rgb(40, 40, 40), UiCore::rgb(50, 50, 50))
    UiFlat::layout(120.0, 100.0)
    check("scroll viewport keeps its declared height", rect_is(scroll_view, 0.0, 0.0, 120.0, 100.0))
    check("scroll content reports its measured extent", near(UiFlat::scroll_limit(scroll_view), 80.0))
    check("scroll starts at the leading edge", near(UiFlat::widget(scroll_first).y, 0.0) and near(UiFlat::widget(scroll_third).y, 120.0))
    UiCore::begin_frame()
    UiFlat::paint()
    check("scroll paint emits a themed track", frame_contains_rect(108.0, 4.0, 8.0, 92.0))
    # The thumb rides INSIDE the channel: same length policy, narrower than the
    # 8pt track it sits in, and centred in it. The hit geometry asserted further
    # down is still the full track.
    check("scroll paint emits a proportional thumb", frame_contains_rect(109.6, 4.0, 4.8, 51.1111))
    check("and the thumb is narrower than its channel", not frame_contains_rect(108.0, 4.0, 8.0, 51.1111))
    scroll_base_theme: UiFlat::Theme = UiFlat::theme()
    scroll_theme: mutable UiFlat::Theme = scroll_base_theme
    scroll_theme.scrollbar_thumb_hover <- UiCore::rgba(255, 190, 70, 230)
    scroll_theme.scrollbar_thumb_active <- UiCore::rgba(255, 90, 110, 255)
    UiFlat::set_theme(scroll_theme)
    UiFlat::pointer((UiCore::PointerEvent.Move(at: UiCore::Vec2(110.0, 20.0))))
    UiCore::begin_frame()
    UiFlat::paint()
    check("scrollbar thumb adopts the themed hover color", frame_contains_rect_color(109.6, 4.0, 4.8, 51.1111, UiCore::rgba(255, 190, 70, 230)))
    UiFlat::pointer((UiCore::PointerEvent.Down(at: UiCore::Vec2(110.0, 20.0), button: 0)))
    UiCore::begin_frame()
    UiFlat::paint()
    check("scrollbar thumb adopts the themed active color", frame_contains_rect_color(109.6, 4.0, 4.8, 51.1111, UiCore::rgba(255, 90, 110, 255)))
    UiFlat::pointer((UiCore::PointerEvent.Up(at: UiCore::Vec2(110.0, 20.0), button: 0)))
    UiFlat::set_theme(scroll_base_theme)
    _ = UiFlat::set_scroll_offset(scroll_view, 50.0)
    UiCore::begin_frame()
    UiFlat::paint()
    check("scroll paint records the viewport clip", frame_contains_clip(0.0, 0.0, 120.0, 100.0))
    _ = UiFlat::set_scroll_offset(scroll_view, 0.0)
    UiFlat::pointer((UiCore::PointerEvent.Down(at: UiCore::Vec2(110.0, 80.0), button: 0)))
    check("scrollbar track paging advances one viewport", near(UiFlat::scroll_offset(scroll_view), 80.0) and not UiFlat::scroll_dragging())
    _ = UiFlat::set_scroll_offset(scroll_view, 0.0)
    thumb_endpoint: f32 = 4.0 + (92.0 * 100.0 / 180.0)
    UiFlat::pointer((UiCore::PointerEvent.Down(at: UiCore::Vec2(110.0, thumb_endpoint), button: 0)))
    check("scrollbar thumb endpoint belongs to the paging track", near(UiFlat::scroll_offset(scroll_view), 80.0) and not UiFlat::scroll_dragging())
    _ = UiFlat::set_scroll_offset(scroll_view, 0.0)
    UiFlat::pointer((UiCore::PointerEvent.Down(at: UiCore::Vec2(110.0, 20.0), button: 0)))
    check("scrollbar thumb claims pointer capture", UiFlat::scroll_dragging())
    UiFlat::pointer((UiCore::PointerEvent.Move(at: UiCore::Vec2(110.0, 45.0))))
    UiFlat::pointer((UiCore::PointerEvent.Up(at: UiCore::Vec2(110.0, 45.0), button: 0)))
    check("scrollbar thumb dragging updates offset", UiFlat::scroll_offset(scroll_view) > 40.0 and UiFlat::scroll_offset(scroll_view) < 60.0 and not UiFlat::scroll_dragging())
    _ = UiFlat::set_scroll_offset(scroll_view, 40.0)
    UiFlat::pointer((UiCore::PointerEvent.Down(at: UiCore::Vec2(110.0, 30.0), button: 0)))
    before_malformed_scroll: f32 = UiFlat::scroll_offset(scroll_view)
    zero_pointer: f32 = 0.0
    malformed_pointer: f32 = zero_pointer / zero_pointer
    UiFlat::pointer((UiCore::PointerEvent.Move(at: UiCore::Vec2{x: 110.0, y: malformed_pointer})))
    check("non-finite scrollbar drags are ignored", near(UiFlat::scroll_offset(scroll_view), before_malformed_scroll) and UiFlat::scroll_dragging())
    UiFlat::pointer((UiCore::PointerEvent.Up(at: UiCore::Vec2(110.0, 30.0), button: 0)))
    check("scroll setter translates children", UiFlat::set_scroll_offset(scroll_view, 50.0) and near(UiFlat::scroll_offset(scroll_view), 50.0) and near(UiFlat::widget(scroll_second).y, 10.0))
    check("scroll hit testing follows translated content", UiFlat::hit(60.0, 20.0) == scroll_second)
    UiFlat::pointer((UiCore::PointerEvent.Move(at: UiCore::Vec2(60.0, 20.0))))
    check("hover tracks the pointer before wheel input", UiFlat::hot() == scroll_second and UiFlat::widget(scroll_second).hovered)
    UiFlat::pointer((UiCore::PointerEvent.Scroll(at: UiCore::Vec2(60.0, 90.0), delta: UiCore::Vec2(0.0, -30.0))))
    check("wheel input refreshes hover after scrolling", near(UiFlat::scroll_offset(scroll_view), 80.0) and UiFlat::hot() == scroll_third and UiFlat::widget(scroll_third).hovered and not UiFlat::widget(scroll_second).hovered)
    _ = UiFlat::set_scroll_offset(scroll_view, 50.0)
    UiFlat::pointer((UiCore::PointerEvent.Scroll(at: UiCore::Vec2(60.0, 50.0), delta: UiCore::Vec2(0.0, 30.0))))
    check("wheel input updates the nearest flat viewport", near(UiFlat::scroll_offset(scroll_view), 20.0))
    UiFlat::pointer((UiCore::PointerEvent.Scroll(at: UiCore::Vec2(60.0, 50.0), delta: UiCore::Vec2(0.0, -200.0))))
    check("wheel input clamps at the content end", near(UiFlat::scroll_offset(scroll_view), 80.0) and near(UiFlat::scroll_limit(scroll_view), 80.0))
    check("a fully clipped child cannot be hit outside the viewport", UiFlat::hit(60.0, -30.0) == UiFlat::NONE)
    check("focusing a clipped leading child reveals it", UiFlat::request_focus(scroll_first) and near(UiFlat::scroll_offset(scroll_view), 0.0) and near(UiFlat::widget(scroll_first).y, 0.0))
    check("focusing the trailing child can restore the end offset", UiFlat::request_focus(scroll_third) and near(UiFlat::scroll_offset(scroll_view), 80.0) and near(UiFlat::widget(scroll_third).y + UiFlat::widget(scroll_third).height, 100.0))
    _ = UiFlat::request_focus(scroll_first)
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.PageDown)))
    check("Page Down scrolls the focused child's nearest viewport", near(UiFlat::scroll_offset(scroll_view), 80.0))
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Home)))
    check("Home returns the focused viewport to its leading edge", near(UiFlat::scroll_offset(scroll_view), 0.0))
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Down)))
    check("axis arrows advance a focused vertical viewport", near(UiFlat::scroll_offset(scroll_view), 40.0))
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Up)))
    check("axis arrows reverse a focused vertical viewport", near(UiFlat::scroll_offset(scroll_view), 0.0))
    before_outside_scroll: f32 = UiFlat::scroll_offset(scroll_view)
    UiFlat::pointer((UiCore::PointerEvent.Scroll(at: UiCore::Vec2(200.0, 50.0), delta: UiCore::Vec2(0.0, 30.0))))
    check("wheel input outside a viewport is ignored", near(UiFlat::scroll_offset(scroll_view), before_outside_scroll))
    UiFlat::pointer((UiCore::PointerEvent.Down(at: UiCore::Vec2(110.0, 20.0), button: 0)))
    check("scrollbar thumb starts a drag before state changes", UiFlat::scroll_dragging())
    UiFlat::set_enabled(scroll_view, false)
    disabled_scroll_offset: f32 = UiFlat::scroll_offset(scroll_view)
    UiFlat::pointer((UiCore::PointerEvent.Move(at: UiCore::Vec2(110.0, 45.0))))
    check("disabling a viewport cancels an active scrollbar drag", not UiFlat::scroll_dragging() and near(UiFlat::scroll_offset(scroll_view), disabled_scroll_offset))
    UiFlat::pointer((UiCore::PointerEvent.Down(at: UiCore::Vec2(110.0, 20.0), button: 0)))
    check("disabled scrollbar cannot claim pointer capture", not UiFlat::scroll_dragging() and near(UiFlat::scroll_offset(scroll_view), disabled_scroll_offset))
    UiCore::begin_frame()
    UiFlat::paint()
    # DISABLED MEANS RECEDE, and this asserts the property rather than the
    # arithmetic. Halving every channel used to be the rule, and it reads as
    # "off" on a dark interface only by accident -- everything there is already
    # near black, so darkening happens to lower contrast. On a light one the
    # same rule turns a near-white control mid-grey and makes the disabled
    # scrollbar the most prominent thing on the page.
    viewport_ink: UiCore::Color = widget_ink(scroll_view)
    check("a disabled scrollbar recedes into the surface it sits on",
          luminance_gap(rect_ink(108.0, 4.0, 8.0, 92.0), viewport_ink) < luminance_gap(scroll_base_theme.scrollbar_track, viewport_ink)
          and luminance_gap(rect_ink(109.6, 4.0, 4.8, 51.1111), viewport_ink) < luminance_gap(scroll_base_theme.scrollbar_thumb, viewport_ink))
    UiFlat::set_enabled(scroll_view, true)

    # The public setter must enforce the nonnegative distance contract even
    # before a viewport has been laid out and therefore has a measured limit.
    UiFlat::reset()
    prelayout_scroll: usize = UiFlat::scroll(UiFlat::NONE, UiConst::Axis.Column, 80.0, 40.0, UiCore::rgb(12, 16, 24))
    check("pre-layout negative scroll offsets are clamped", not UiFlat::set_scroll_offset(prelayout_scroll, -25.0) and near(UiFlat::scroll_offset(prelayout_scroll), 0.0))
    zero_scroll_value: f32 = 0.0
    invalid_scroll_request: f32 = zero_scroll_value / zero_scroll_value
    check("non-finite scroll requests are rejected", not UiFlat::set_scroll_offset(prelayout_scroll, invalid_scroll_request) and near(UiFlat::scroll_offset(prelayout_scroll), 0.0))

    # A non-scrollable nested viewport must not swallow a wheel gesture that
    # can still move its outer ancestor.
    UiFlat::reset()
    bubbling_outer: usize = UiFlat::scroll(UiFlat::NONE, UiConst::Axis.Column, 120.0, 100.0, UiCore::rgb(12, 16, 24))
    bubbling_inner: usize = UiFlat::scroll(bubbling_outer, UiConst::Axis.Column, 120.0, 60.0, UiCore::rgb(18, 22, 30))
    _ = UiFlat::button(bubbling_inner, 120.0, 40.0, UiCore::rgb(30, 30, 30), UiCore::rgb(40, 40, 40), UiCore::rgb(50, 50, 50))
    _ = UiFlat::button(bubbling_outer, 120.0, 80.0, UiCore::rgb(30, 30, 30), UiCore::rgb(40, 40, 40), UiCore::rgb(50, 50, 50))
    UiFlat::layout(120.0, 100.0)
    UiFlat::pointer((UiCore::PointerEvent.Scroll(at: UiCore::Vec2(60.0, 20.0), delta: UiCore::Vec2(0.0, -30.0))))
    check("wheel input bubbles past a non-scrollable nested viewport", near(UiFlat::scroll_offset(bubbling_inner), 0.0) and near(UiFlat::scroll_offset(bubbling_outer), 30.0))

    UiFlat::reset()
    guarded_scroll: usize = UiFlat::scroll(UiFlat::NONE, UiConst::Axis.Column, 120.0, 100.0, UiCore::rgb(12, 16, 24))
    guarded_field: usize = UiFlat::text_field(guarded_scroll, "Guarded", "", "do not select", 120.0, 60.0, 14.0, UiCore::rgb(230, 230, 230), UiCore::rgb(30, 30, 30))
    _ = UiFlat::button(guarded_scroll, 120.0, 60.0, UiCore::rgb(30, 30, 30), UiCore::rgb(40, 40, 40), UiCore::rgb(50, 50, 50))
    UiFlat::layout(120.0, 100.0)
    _ = UiFlat::request_focus(guarded_field)
    UiFlat::set_selection(guarded_field, 0, 0)
    UiFlat::select_text_click_at_pointer(110.0, 20.0, 0, 3)
    check("scrollbar clicks do not multi-select the focused text field", UiFlat::selected_text_length(guarded_field) == 0)

    UiFlat::reset()
    leaf_parent: usize = UiFlat::label(UiFlat::NONE, "Leaf", 14.0, UiCore::rgb(230, 230, 230))
    detached_child: usize = UiFlat::button(leaf_parent, 80.0, 24.0, UiCore::rgb(30, 30, 30), UiCore::rgb(40, 40, 40), UiCore::rgb(50, 50, 50))
    check("leaf widgets reject child attachments", UiFlat::widget(leaf_parent).first_child == UiFlat::NONE and UiFlat::widget(detached_child).parent == UiFlat::NONE)

    UiFlat::reset()
    orphan: usize = UiFlat::button(999, 80.0, 24.0, UiCore::rgb(30, 30, 30), UiCore::rgb(40, 40, 40), UiCore::rgb(50, 50, 50))
    check("invalid parent handles produce a safe detached widget", orphan == 0 and UiFlat::widget(orphan).parent == UiFlat::NONE and UiFlat::widget(orphan).next_sibling == UiFlat::NONE)

    UiFlat::reset()
    for index in 0..<257:
        _ = UiFlat::panel(UiFlat::NONE, UiConst::Axis.Column, 0.0, 0.0, UiCore::rgb(0, 0, 0))
    check("widget arena reports overflow", UiFlat::overflowed())
    check("widget arena never exceeds capacity", UiFlat::count() == UiFlat::MAX_WIDGETS)

    UiCore::begin_frame()
    for index in 0..<1025:
        UiCore::clear(UiCore::rgb(0, 0, 0))
    check("command buffer reports overflow", UiCore::command_overflowed())
    check("command buffer remains bounded", UiCore::command_count() == 1024)

    UiCore::begin_frame()
    for index in 0..<257:
        UiCore::accessibility(UiCore::AccessibilityRole.Label, "node", "", UiCore::Rect(0.0, 0.0, 1.0, 1.0), index, UiFlat::NONE, true, false, false, 0.0, "", "", 0, 0, 0)
    check("semantic buffer reports overflow", UiCore::accessibility_overflowed())
    check("semantic buffer remains bounded", UiCore::accessibility_count() == 256)

    UiCore::begin_frame()
    UiCore::accessibility(UiCore::AccessibilityRole.Label, "first declaration", "", UiCore::Rect(0.0, 0.0, 1.0, 1.0), 77, UiFlat::NONE, true, false, false, 0.0, "", "", 0, 0, 0)
    UiCore::accessibility(UiCore::AccessibilityRole.Button, "last declaration", "", UiCore::Rect(2.0, 3.0, 4.0, 5.0), 77, 77, true, false, false, 0.0, "", "", 0, 0, 0)
    duplicate_node: UiCore::AccessibilityNode = UiCore::accessibility_at(0)
    check("duplicate semantic IDs stay unique", UiCore::accessibility_count() == 1)
    check("duplicate semantic IDs keep the first position", duplicate_node.label == "last declaration" and duplicate_node.role == UiCore::AccessibilityRole.Button)

    # A ROW VIEWPORT HAS A DIRECTION OF TRAVEL, not just a side. The vertical
    # bar only had to change which edge it sits on; a mirrored horizontal one
    # starts at the reader's own edge and its thumb runs the other way -- and
    # the drag has to agree with the paint, or the thumb runs away from the
    # finger. Both halves call one function, which is its own inverse.
    UiFlat::reset()
    row_view: usize = UiFlat::scroll(UiFlat::NONE, UiConst::Axis.Row, 120.0, 60.0, UiCore::rgb(12, 16, 24))
    wide: usize = UiFlat::button(row_view, 400.0, 40.0, UiCore::rgb(40, 44, 56), UiCore::rgb(40, 44, 56), UiCore::rgb(40, 44, 56))
    UiFlat::layout(120.0, 60.0)
    UiCore::begin_frame()
    UiFlat::paint()
    ltr_thumb: f32 = horizontal_thumb_x(row_view)
    _ = UiLocalization::set_locale("ar-SA")
    UiCore::begin_frame()
    UiFlat::paint()
    rtl_thumb: f32 = horizontal_thumb_x(row_view)
    check("an unscrolled mirrored row parks its thumb at the reader's edge", rtl_thumb > ltr_thumb)
    # Dragging the thumb toward the reader's end must scroll forward, not back.
    UiFlat::pointer((UiCore::PointerEvent.Down(at: UiCore::Vec2(rtl_thumb + 4.0, 52.0), button: 0)))
    dragging: bool = UiFlat::scroll_dragging()
    UiFlat::pointer((UiCore::PointerEvent.Move(at: UiCore::Vec2(rtl_thumb - 20.0, 52.0))))
    check("a mirrored drag toward the far edge scrolls forward", dragging and UiFlat::scroll_offset(row_view) > 0.0)
    UiFlat::pointer((UiCore::PointerEvent.Up(at: UiCore::Vec2(rtl_thumb - 20.0, 52.0), button: 0)))
    _ = UiLocalization::set_locale("en-US")

    if test_failures == 0:
        _ = puts("widget layout: all checks passed")
        return 0
    _ = puts("widget layout: FAILURES above")
    return 1
