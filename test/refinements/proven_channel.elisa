# POSITIVE FIXTURE. The same call, with every argument carried through the
# framework's `channel` constructor, whose RETURN carries the law. This one must
# compile with no refinement diagnostic at all -- a checker that complained here
# would make the vocabulary unusable, which is the other way for a refinement to
# fail: not by staying silent, but by never being satisfiable.

include "../../src/core/ui_core.elisa"

def packed_from_raw(alpha: i64, red: i64, green: i64, blue: i64) -> i64:
    return UiCore::pack_channels(UiCore::channel(alpha), UiCore::channel(red), UiCore::channel(green), UiCore::channel(blue))

def main() -> i64:
    return packed_from_raw(255, 0, 0, 0)
