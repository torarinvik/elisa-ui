# NEGATIVE FIXTURE. This program must not compile clean: it hands `pack_channels`
# a value with no proof that it is a channel, which is exactly the mistake the
# law exists to catch. scripts/check_refinements.sh compiles it and requires the
# compiler to say so; if it ever goes quiet, the refinements have stopped being
# enforced and every gate that relies on them is decoration.

include "../../src/core/ui_core.elisa"

def packed_from_raw(alpha: i64, red: i64, green: i64, blue: i64) -> i64:
    return UiCore::pack_channels(alpha, red, green, blue)

def main() -> i64:
    return packed_from_raw(255, 0, 0, 0)
