# Render the shipped showcase application with real Skia, off-screen.
#
# The hello fixture next door is an acceptance test with pixel assertions. This
# one exists to produce a picture: the five-page showcase, its theme, its
# custom-painted hero and its controls, rasterized by the same painter a window
# would use. It is the artifact that says what the renderer actually looks like.

include "../src/platform/skia/ui_skia.elisa"
include "../examples/showcase/app.elisa"

# The host lends a typeface for the frame, so measurement must use it. The
# plain metric family has no typeface and measures everything as zero.
def ui_measure_text_width(text: sview, size: f32) -> f32:
    return UiSkia::active_measure_text_width(text, size)

def ui_measure_text_height(text: sview, size: f32) -> f32:
    return UiSkia::active_text_line_height(size)

def ui_font_ascent(size: f32) -> f32:
    return UiSkia::active_font_ascent(size)

def ui_text_line_height(size: f32) -> f32:
    return UiSkia::active_text_line_height(size)

def ui_clipboard_has_text() -> bool:
    return false

def ui_clipboard_write(bytes: u8&, length: usize) -> bool:
    return false

def ui_clipboard_read(buffer: mutable u8&, capacity: usize) -> usize:
    return 0

global mutable showcase_started: bool = false

def showcase_app_skia_render(canvas: usize, font: usize, width: f32, height: f32, page: i32) -> i32:
    can Ui.Draw, Ui.Text, Ui.Input, Unsafe.PointerCast:
        previous_font: usize = UiSkia::begin_frame_font(font)
        _ = UiTextMetrics::set_context(UiSkia::font_generation(), UiSkia::scale_generation())
        UiCapabilities::use_appkit_canvas()
        # Say what is actually drawing: the showcase names its rasterizer.
        _ = UiCapabilities::select_skia_renderer()
        UiCore::set_viewport(width, height)
        if not showcase_started:
            app_init()
            showcase_started <- true
        # Pages 1..5 are the showcase's own keyboard shortcuts, so a caller
        # selects one the way a user would rather than through private state.
        if page >= 1 and page <= 5:
            key: i32 = UiCore::Key.Digit1.i32() + page - 1
            app_event(UiCore::KeyEvent.Down(code: key.Key()))
        UiSkia::begin_deferred_frame()
        UiCore::begin_frame()
        app_frame()
        if canvas == 0:
            UiSkia::end_deferred_frame()
            UiSkia::end_frame_font(previous_font)
            return UiSkia::RenderStatus.SkippedNoSurface.i32()
        UiSkia::attach(canvas)
        status: UiSkia::RenderStatus = UiSkia::render_status_with_font(font)
        UiSkia::detach()
        UiSkia::end_deferred_frame()
        UiSkia::end_frame_font(previous_font)
        return status.i32()

# Move focus the way a person does. A focus ring that no rendered frame ever
# contains is an unverified drawing: the showcase pages are all rendered with
# nothing focused, so the host asks for one Tab before the last render and the
# ring lands in a picture that can be looked at.
def showcase_app_skia_focus_next() -> i32:
    can Ui.Input:
        return 0 if not showcase_started
        app_event(UiCore::KeyEvent.Down(code: UiCore::Key.Tab))
        return 1

# Switch the app between its dark and light palettes, the way its own keyboard
# shortcut does. THE LIGHT TREATMENT IS A DIFFERENT RENDERER PATH: a light
# surface is lifted by the shadow it casts while a dark one leans on the sheen
# and the rim, and rendering only the dark theme left half of that policy
# unexecuted and unlooked-at.
def showcase_app_skia_toggle_theme() -> i32:
    can Ui.Input:
        return 0 if not showcase_started
        app_event(UiCore::KeyEvent.Down(code: UiCore::Key.T))
        return 1

export fn elisa_showcase_app_skia_render(canvas: usize, font: usize, width: f32, height: f32, page: i32) -> i32 = showcase_app_skia_render
export fn elisa_showcase_app_skia_focus_next() -> i32 = showcase_app_skia_focus_next
export fn elisa_showcase_app_skia_toggle_theme() -> i32 = showcase_app_skia_toggle_theme
