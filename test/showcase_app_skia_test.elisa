# Render the shipped showcase application with real Skia, off-screen.
#
# The hello fixture next door is an acceptance test with pixel assertions. This
# one exists to produce a picture: the five-page showcase, its theme, its
# custom-painted hero and its controls, rasterized by the same painter a window
# would use. It is the artifact that says what the renderer actually looks like.

include "../src/platform/skia/ui_skia.elisa"
include "../examples/showcase/app.elisa"

# The host lends a typeface for the frame, so measurement must use it. The
# plain metric family has no typeface and measures everything as zero.
def ui_measure_text_width(text: sview, size: f32, weighted: bool) -> f32:
    return UiSkia::active_measure_text_width(text, size, weighted)

def ui_measure_text_height(text: sview, size: f32) -> f32:
    return UiSkia::active_text_line_height(size)

def ui_font_ascent(size: f32) -> f32:
    return UiSkia::active_font_ascent(size)

def ui_text_line_height(size: f32) -> f32:
    return UiSkia::active_text_line_height(size)

def ui_clipboard_has_text() -> bool:
    return false

def ui_clipboard_write(bytes: u8&, length: usize) -> bool:
    return false

def ui_clipboard_read(buffer: mutable u8&, capacity: usize) -> usize:
    return 0

global mutable showcase_started: bool = false

# `width`/`height` are LOGICAL points and `scale` is the backing scale, exactly
# as a window reports them: a retina host hands over a canvas with twice the
# pixels and the same point extent, and every radius, hairline and glyph has to
# come out right in both. Rendering only at 1.0 leaves the scale most Macs
# actually run on unexecuted.
def showcase_app_skia_render(canvas: usize, font: usize, width: f32, height: f32, page: i32, scale: f32) -> i32:
    can Ui.Draw, Ui.Text, Ui.Input, Unsafe.PointerCast:
        previous_font: usize = UiSkia::begin_frame_font(font)
        _ = UiTextMetrics::set_context(UiSkia::font_generation(), UiSkia::scale_generation())
        UiCapabilities::use_appkit_canvas()
        # Say what is actually drawing: the showcase names its rasterizer.
        _ = UiCapabilities::select_skia_renderer()
        UiCore::set_viewport(width, height)
        if not showcase_started:
            app_init()
            showcase_started <- true
        # Pages 1..5 are the showcase's own keyboard shortcuts, so a caller
        # selects one the way a user would rather than through private state.
        if page >= 1 and page <= 5:
            key: i32 = UiCore::Key.Digit1.i32() + page - 1
            app_event(UiCore::KeyEvent.Down(code: key.Key()))
        UiSkia::begin_deferred_frame()
        UiCore::begin_frame()
        app_frame()
        if canvas == 0:
            UiSkia::end_deferred_frame()
            UiSkia::end_frame_font(previous_font)
            return UiSkia::RenderStatus.SkippedNoSurface.i32()
        UiSkia::attach_scaled(canvas, scale)
        status: UiSkia::RenderStatus = UiSkia::render_status_with_font(font)
        UiSkia::detach()
        UiSkia::end_deferred_frame()
        UiSkia::end_frame_font(previous_font)
        return status.i32()

# Move focus the way a person does. A focus ring that no rendered frame ever
# contains is an unverified drawing: the showcase pages are all rendered with
# nothing focused, so the host asks for one Tab before the last render and the
# ring lands in a picture that can be looked at.
def showcase_app_skia_focus_next() -> i32:
    can Ui.Input:
        return 0 if not showcase_started
        app_event(UiCore::KeyEvent.Down(code: UiCore::Key.Tab))
        return 1

# Switch the app between its dark and light palettes, the way its own keyboard
# shortcut does. THE LIGHT TREATMENT IS A DIFFERENT RENDERER PATH: a light
# surface is lifted by the shadow it casts while a dark one leans on the sheen
# and the rim, and rendering only the dark theme left half of that policy
# unexecuted and unlooked-at.
def showcase_app_skia_toggle_theme() -> i32:
    can Ui.Input:
        return 0 if not showcase_started
        app_event(UiCore::KeyEvent.Down(code: UiCore::Key.T))
        return 1

# THE ACCESSIBILITY PATH, which no frame in this set has ever rendered.
#
# The palette and the metrics both have a high-contrast branch and a text-scale
# multiplier, and every bug found in them so far was found by reading rather
# than by looking -- a marker derived from the focus ring's width so it never
# scaled, a scrollbar the resolver never touched at all. Those survived because
# nothing put the accessibility branch on screen where a wrong size is obvious.
# 0 restores the default preferences; 1 is high contrast on the dark palette
# and 2 the same on the light one. Both halves are worth a frame: the palette
# has a high-contrast branch per mode, and the depth policy is weighted by the
# surface's own lightness, so the two do not exercise the same arithmetic.
def showcase_app_skia_accessible(mode: i32) -> i32:
    return 0 if not showcase_started
    on: bool = mode != 0
    preferences: UiTheme::Preferences = UiTheme::Preferences{
        mode: UiTheme::ColorMode.Light if mode == 2 else UiTheme::ColorMode.Dark,
        contrast: UiTheme::Contrast.High if on else UiTheme::Contrast.Normal,
        text_scale: 2.0 if on else 1.0,
        reduced_motion: false,
    }
    _ = UiHandles::apply_system_theme(preferences, mode != 2, on)
    return 1

# Open the app's confirmation dialog, the way its own shortcut does. A MODAL IS
# A RENDERING CASE OF ITS OWN -- a raised sheet over a shell that has been
# disabled beneath it -- and it appeared in none of the frames above.
def showcase_app_skia_open_dialog() -> i32:
    can Ui.Input:
        return 0 if not showcase_started
        app_event(UiCore::KeyEvent.Down(code: UiCore::Key.H))
        return 1

# Put the pointer on a control, so a frame can show what one looks like under
# the cursor and under a press.
#
# HOVER AND PRESS ARE APPEARANCES TOO, and every frame the gate rendered was of
# controls at rest. The button is found rather than hardcoded: a coordinate
# baked into a fixture stops pointing at anything the first time the toolbar
# changes, and then reports that hover renders fine because it hovered nothing.
def showcase_app_skia_first_button() -> usize:
    for index in 0..<UiHandles::count():
        row: UiFlat::Widget = UiFlat::widget(index)
        continue if row.kind != UiConst::WidgetKind.Button
        continue if row.width <= 0.0 or row.height <= 0.0
        return index
    return UiHandles::count()

def showcase_app_skia_hover_button(pressed: i32) -> i32:
    can Ui.Input:
        return 0 if not showcase_started
        index: usize = showcase_app_skia_first_button()
        return 0 if index >= UiHandles::count()
        row: UiFlat::Widget = UiFlat::widget(index)
        centre: UiCore::Vec2 = UiCore::Vec2(row.x + row.width / 2.0, row.y + row.height / 2.0)
        app_event(UiCore::PointerEvent.Move(at: centre))
        app_event(UiCore::PointerEvent.Down(at: centre, button: 0)) if pressed != 0
        return 1

# Escape, the way a person dismisses the dialog. The shell is DISABLED while a
# modal is open, so a hover frame taken without closing it first shows a
# disabled control not reacting -- which is a true picture of the wrong thing.
def showcase_app_skia_close_dialog() -> i32:
    can Ui.Input:
        return 0 if not showcase_started
        app_event(UiCore::KeyEvent.Down(code: UiCore::Key.Escape))
        return 1

# THE READING DIRECTION, which no frame in this set has ever put on screen.
#
# Every mirrored coordinate in this framework -- the flat layer, the sealed
# hierarchy and the native-control placement alike -- is asserted headlessly
# and appears in no picture. That is the same shape as every other defect
# found here: a policy module whose only caller was its own test. A right-to-
# left frame is where a marker on the wrong side of its label, or a track
# that fills from the wrong end, is obvious at a glance.
#
# 0 restores the default locale; 1 selects a right-to-left one.
def showcase_app_skia_direction(rtl: i32) -> i32:
    return 0 if not showcase_started
    _ = UiLocalization::set_locale("ar" if rtl != 0 else "en")
    return 1

# WHICH PAGE IS ACTUALLY ON SCREEN.
#
# `render` selects a page the way a user does, by pressing its shortcut, and
# a press can be CONSUMED -- a modal consumes all of them. So a caller can ask
# for page one, get whichever page the dialog was opened from, and have no way
# to tell. That is exactly what happened to the retina frame: it existed to be
# compared with the 1x frame of the same page, and for as long as it existed it
# was a different page with a modal over it, checked only for its file size.
def showcase_app_skia_page() -> i32:
    return 0 if not showcase_started
    return ShowcaseApp::current_page() + 1

# BIND A PICTURE, the way a host does: a resource the framework knows by slot
# and generation, an image the host loaded, and one call that ties them
# together. Nothing above this line -- not the widget, not the command, not the
# painter -- ever sees the host's handle.
#
# The showcase's mark is the caller. It is the one element in that frame that
# is a picture rather than a shape, and until the command list learned to carry
# an image there was no way to put one there at all.
def showcase_app_skia_bind_image(image: usize) -> i32:
    return 0 if not showcase_started or image == 0
    resource: UiResources::ResourceHandle = UiResources::request("showcase/brand", 11)
    return 0 if not UiResources::resource_is_valid(resource)
    return 0 if not UiResources::set_state(resource, UiResources::State.Ready)
    return 0 if not UiSkia::bind_image(resource, image)
    ShowcaseApp::set_brand_image(UiCore::image_ref(resource.slot, resource.generation))
    return 1

export fn elisa_showcase_app_skia_bind_image(image: usize) -> i32 = showcase_app_skia_bind_image
export fn elisa_showcase_app_skia_page() -> i32 = showcase_app_skia_page
export fn elisa_showcase_app_skia_close_dialog() -> i32 = showcase_app_skia_close_dialog
export fn elisa_showcase_app_skia_hover_button(pressed: i32) -> i32 = showcase_app_skia_hover_button
export fn elisa_showcase_app_skia_render(canvas: usize, font: usize, width: f32, height: f32, page: i32, scale: f32) -> i32 = showcase_app_skia_render
export fn elisa_showcase_app_skia_open_dialog() -> i32 = showcase_app_skia_open_dialog
export fn elisa_showcase_app_skia_focus_next() -> i32 = showcase_app_skia_focus_next
export fn elisa_showcase_app_skia_toggle_theme() -> i32 = showcase_app_skia_toggle_theme
export fn elisa_showcase_app_skia_accessible(mode: i32) -> i32 = showcase_app_skia_accessible
export fn elisa_showcase_app_skia_direction(rtl: i32) -> i32 = showcase_app_skia_direction
