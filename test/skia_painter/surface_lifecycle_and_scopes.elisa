# Phase 4: surface generations across invalid attachment and loss, command overflow,
# binding teardown on loss, and the typed clip/transform scope ledger at its depth budget.

def check_surface_lifecycle_and_scopes(first_surface_generation: u32) -> void:
    UiSkia::attach(9)
    generation_before_invalid_attach: u32 = UiSkia::surface_generation()
    UiSkia::attach(0)
    check("invalid attachment advances the surface generation", not UiSkia::is_attached() and UiSkia::surface_generation() != generation_before_invalid_attach)
    skia_render_frame_export(0)
    lost_surface_generation: u32 = UiSkia::surface_generation()
    check("invalid one-shot frame clears stale state", not UiSkia::is_attached() and lost_surface_generation != first_surface_generation)
    UiSkia::attach(11)
    check("surface recreation receives a new generation", UiSkia::is_attached() and UiSkia::surface_generation() != lost_surface_generation)
    UiSkia::surface_lost()
    check("explicit surface loss preserves renderer state", not UiSkia::is_attached() and UiCapabilities::supports_skia())
    UiCore::begin_frame()
    limit: usize = UiCore::MAX_COMMANDS + 1
    for index in 0..<limit:
        UiCore::clear(UiCore::rgb(1, 2, 3))
    UiSkia::attach(13)
    check("render status reports command overflow", UiSkia::render_status() == UiSkia::RenderStatus.CommandOverflow and not UiSkia::render_checked())
    surface_resource: UiResources::ResourceHandle = UiResources::request("images/surface", 7)
    _ = UiResources::set_state(surface_resource, UiResources::State.Ready)
    _ = UiSkia::bind_image(surface_resource, 0xBEEF)
    _ = UiSkia::bind_font(surface_resource, 0xCAFE)
    UiSkia::surface_lost()
    check("surface loss clears borrowed renderer bindings", not UiSkia::draw_bound_image(surface_resource, UiCore::Rect(8.0, 9.0, 64.0, 48.0), 220) and not UiSkia::draw_bound_text(surface_resource, UiCore::TextRun(UiCore::Vec2(4.0, 16.0), 12.0, "font"), UiCore::rgb(220, 220, 220)))
    lost_state: UiSkia::Snapshot = UiSkia::snapshot()
    check("surface loss snapshot is detached and empty", not lost_state.attached and lost_state.save_depth == 0 and lost_state.clip_depth == 0 and lost_state.transform_depth == 0 and lost_state.image_bindings == 0 and lost_state.font_bindings == 0 and UiSkia::is_balanced())
    _ = UiResources::dispose(surface_resource)
    skia_test_reset()
    UiSkia::attach(21)
    check("direct clip rejects empty geometry", not UiSkia::push_clip(UiCore::Rect(1.0, 2.0, 0.0, 4.0)))
    check("direct clip scope pushes", UiSkia::push_clip(UiCore::Rect(1.0, 2.0, 8.0, 9.0)))
    UiSkia::push_transform(UiCore::Vec2(1.0, 2.0), UiCore::Vec2(2.0, 2.0))
    check("mismatched clip pop is rejected", not UiSkia::pop_clip())
    UiSkia::pop_transform()
    check("typed scopes restore in LIFO order", UiSkia::pop_clip() and UiSkia::is_balanced())
    UiSkia::push_rotation(45.0)
    UiSkia::detach()
    check("detach restores forgotten clip and transform scopes", skia_test_save_count() == 4 and skia_test_restore_count() == 4 and skia_test_rotate_count() == 1)
    skia_test_reset()
    UiSkia::attach(23)
    scope_attempts: usize = UiSkia::MAX_SCOPE_DEPTH + 2
    accepted_scopes: usize =
        for _ in 0..<scope_attempts |accepted: usize = 0| -> accepted:
            accepted <- accepted + 1 if UiSkia::push_transform(UiCore::Vec2(1.0, 1.0), UiCore::Vec2(1.0, 1.0))
    bounded_scope_state: UiSkia::Snapshot = UiSkia::snapshot()
    check("direct Skia scopes stop at the depth budget", accepted_scopes == UiSkia::MAX_SCOPE_DEPTH - 1 and bounded_scope_state.save_depth == UiSkia::MAX_SCOPE_DEPTH and bounded_scope_state.transform_depth == accepted_scopes)
    check("rotation push reports budget rejection", not UiSkia::push_rotation(90.0) and skia_test_rotate_count() == 0)
    check("scope overflow does not cross the FFI", skia_test_save_count() == UiSkia::MAX_SCOPE_DEPTH.i32())
    UiSkia::detach()
    check("bounded scopes still detach cleanly", skia_test_restore_count() == UiSkia::MAX_SCOPE_DEPTH.i32() and UiSkia::is_balanced())
    UiCore::begin_frame()
    UiCore::set_clip(UiCore::Rect(1.0, 2.0, 8.0, 9.0))
    UiCore::fill(UiCore::Rect(1.0, 2.0, 8.0, 9.0), UiCore::rgb(4, 5, 6))
    skia_test_reset()
    UiSkia::attach(24)
    for _ in 0..<UiSkia::MAX_SCOPE_DEPTH - 1:
        _ = UiSkia::push_transform(UiCore::Vec2(1.0, 1.0), UiCore::Vec2(1.0, 1.0))
    check("retained replay reserves a clip scope at direct depth limit", UiSkia::render_status() == UiSkia::RenderStatus.Complete and skia_test_clip_count() == 1 and skia_test_save_count() == (UiSkia::MAX_SCOPE_DEPTH + 1).i32())
    UiSkia::detach()
    check("reserved replay clip restores without stealing a custom scope", skia_test_restore_count() == (UiSkia::MAX_SCOPE_DEPTH + 1).i32() and UiSkia::is_balanced())
    UiCore::begin_frame()
    UiCore::set_clip(UiCore::Rect(1.0, 2.0, 0.0, 4.0))
    UiCore::fill(UiCore::Rect(1.0, 2.0, 8.0, 9.0), UiCore::rgb(4, 5, 6))
    skia_test_reset()
    UiSkia::attach(22)
    check("retained empty clips still cross the Skia boundary", UiSkia::render_status() == UiSkia::RenderStatus.Complete and skia_test_clip_count() == 1)
    UiSkia::detach()
    check("retained empty clip restores its save scope", skia_test_save_count() == 2 and skia_test_restore_count() == 2 and UiSkia::is_balanced())
    skia_test_reset()
    UiSkia::attach(25)
    check("rounded clip rejects empty geometry", not UiSkia::push_rounded_clip(UiCore::Rect(1.0, 2.0, 0.0, 4.0), 4.0))
    check("rounded clip bounds radius in Elisa", UiSkia::push_rounded_clip(UiCore::Rect(1.0, 2.0, 8.0, 9.0), 100.0) and skia_test_rounded_clip_count() == 1 and not UiSkia::is_balanced() and UiSkia::snapshot().clip_depth == 1 and skia_test_last_clip_radius() == 4.0)
    check("rounded clip restores through the typed pop", UiSkia::pop_clip() and UiSkia::is_balanced())
    UiSkia::detach()
    check("rounded clip scope detaches cleanly", skia_test_save_count() == 2 and skia_test_restore_count() == 2)
    skia_test_reset()
    UiSkia::attach(26)
    UiSkia::fill_rounded_linear_gradient(UiCore::Rect(1.0, 2.0, 8.0, 9.0), 100.0, UiCore::rgb(20, 40, 80), UiCore::rgb(100, 180, 220), true)
    check("rounded gradients compose Elisa scopes", skia_test_rounded_clip_count() == 1 and skia_test_gradient_count() == 1 and skia_test_save_count() == 2 and skia_test_restore_count() == 1 and UiSkia::is_balanced())
    UiSkia::detach()
    check("rounded gradient scope detaches cleanly", skia_test_restore_count() == 2)
    skia_test_reset()
    UiSkia::attach(27)
    UiSkia::draw_shadow_rounded_rect_with_color(UiCore::Rect(1.0, 2.0, 8.0, 9.0), 100.0, 1.0, 2.0, 3.0, UiCore::rgba(20, 40, 80, 180))
    check("custom shadow helper keeps color policy in Elisa", skia_test_shadow_round_rect_count() == 1 and skia_test_last_shadow_offset_x() == 1.0 and skia_test_last_shadow_offset_y() == 2.0 and skia_test_last_shadow_blur() == 3.0 and skia_test_last_shadow_red() == 20 and skia_test_last_shadow_green() == 40 and skia_test_last_shadow_blue() == 80)
    UiSkia::detach()
    UiCore::begin_frame()
    UiCore::clear(UiCore::rgb(4, 5, 6))
    check("one-shot status export reports complete", skia_render_frame_status_export(31) == UiSkia::RenderStatus.Complete.i32() and not UiSkia::is_attached())
    check("one-shot status export reports no surface", skia_render_frame_status_export(0) == UiSkia::RenderStatus.SkippedNoSurface.i32() and not UiSkia::is_attached())
