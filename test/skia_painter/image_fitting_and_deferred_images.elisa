# Phase 5: image fitting (contain/cover/scale-down, intrinsic metadata, rounded clips),
# interactive text, and the deferred image commands that replay the same policy. The
# `fit_box`/`source_size` fixtures are shared across the whole phase, which is why the
# deferred image checks live here rather than with the other deferred work.

def check_image_fitting_and_deferred_images() -> void:
    skia_test_reset()
    UiSkia::attach(30)
    source_size: UiCore::Size = UiCore::Size(100.0, 50.0)
    fit_box: UiCore::Rect = UiCore::Rect(10.0, 20.0, 100.0, 100.0)
    check("contain fit preserves aspect ratio in Elisa", UiSkia::draw_image_fitted(0xCAFE, fit_box, source_size, 255, UiSkia::ImageFit.Contain) and skia_test_last_image_x() == 10.0 and skia_test_last_image_y() == 45.0 and skia_test_last_image_width() == 100.0 and skia_test_last_image_height() == 50.0 and skia_test_clip_count() == 0)
    check("cover fit preserves aspect ratio and clips in Elisa", UiSkia::draw_image_fitted_with_sampling(0xCAFE, fit_box, source_size, 255, UiSkia::ImageFit.Cover, UiSkia::ImageSampling.Nearest) and skia_test_last_image_x() == -40.0 and skia_test_last_image_y() == 20.0 and skia_test_last_image_width() == 200.0 and skia_test_last_image_height() == 100.0 and skia_test_last_image_sampling() == 0 and skia_test_clip_count() == 1)
    check("scale-down fit avoids enlarging small assets", UiSkia::draw_image_fitted(0xCAFE, fit_box, UiCore::Size(40.0, 20.0), 255, UiSkia::ImageFit.ScaleDown) and skia_test_last_image_x() == 40.0 and skia_test_last_image_y() == 60.0 and skia_test_last_image_width() == 40.0 and skia_test_last_image_height() == 20.0 and skia_test_clip_count() == 1)
    check("invalid image source dimensions fail closed", not UiSkia::draw_image_fitted(0xCAFE, fit_box, UiCore::Size(0.0, 50.0), 255, UiSkia::ImageFit.Contain) and skia_test_image_count() == 3)
    UiSkia::detach()
    check("fitted image clip scope is balanced", skia_test_save_count() == 2 and skia_test_restore_count() == 2 and UiSkia::is_balanced())

    UiResources::reset()
    intrinsic_image: UiResources::ResourceHandle = UiResources::request("images/intrinsic-fit", 7)
    _ = UiResources::set_intrinsic_size(intrinsic_image, 100.0, 50.0)
    _ = UiResources::set_state(intrinsic_image, UiResources::State.Ready)
    _ = UiSkia::bind_image(intrinsic_image, 0xBEEF)
    skia_test_reset()
    UiSkia::attach(32)
    check("bound image fit can consume intrinsic metadata", UiSkia::draw_bound_image_fitted_intrinsic_with_sampling(intrinsic_image, fit_box, 255, UiSkia::ImageFit.Contain, UiSkia::ImageSampling.Nearest) and skia_test_last_image_x() == 10.0 and skia_test_last_image_y() == 45.0 and skia_test_last_image_width() == 100.0 and skia_test_last_image_height() == 50.0 and skia_test_last_image_sampling() == 0)
    UiSkia::detach()
    _ = UiResources::dispose(intrinsic_image)

    skia_test_reset()
    UiSkia::attach(33)
    interaction: UiSkia::TextInteraction = UiSkia::TextInteraction{selection_start: 0, selection_end: 1, selection_color: UiCore::rgba(70, 120, 220, 180), caret_line: 1, caret_offset: 1, caret_width: 2.0, caret_color: UiCore::rgb(220, 220, 220)}
    interactive_layout: UiTextMeasureLayout::Layout = UiSkia::draw_text_block_interactive("A\nB", UiCore::Rect(0.0, 0.0, 30.0, 30.0), 10.0, UiCore::rgb(220, 220, 220), interaction, UiSkia::HorizontalTextAlignment.Start, UiSkia::VerticalTextAlignment.Top, 1.0)
    check("interactive text paints one measured selection/text/caret pass", interactive_layout.line_count == 2 and skia_test_round_rect_count() == 2 and skia_test_text_count() == 2 and skia_test_clip_count() == 1 and skia_test_save_count() == 2 and skia_test_restore_count() == 1 and UiSkia::is_balanced())
    UiSkia::detach()
    check("interactive text scope restores its frame", skia_test_restore_count() == 2 and UiSkia::is_balanced())

    interactive_fallback_font: UiResources::ResourceHandle = UiResources::request("fonts/interactive-fallback", 7)
    _ = UiResources::set_state(interactive_fallback_font, UiResources::State.Ready)
    _ = UiSkia::bind_font(interactive_fallback_font, 0x1FA11)
    interactive_primary_font: UiResources::ResourceHandle = UiResources::request("fonts/interactive-primary", 7)
    skia_test_reset()
    UiSkia::attach(34)
    bound_interactive_layout: UiTextMeasureLayout::Layout = UiSkia::draw_bound_text_block_interactive_with_fallback(interactive_primary_font, interactive_fallback_font, "A\nB", UiCore::Rect(0.0, 0.0, 30.0, 30.0), 10.0, UiCore::rgb(220, 220, 220), interaction, UiSkia::HorizontalTextAlignment.Start, UiSkia::VerticalTextAlignment.Top, 1.0)
    check("fallback bound text composes one interactive font scope", bound_interactive_layout.line_count == 2 and skia_test_round_rect_count() == 2 and skia_test_text_count() == 2 and skia_test_clip_count() == 1 and skia_test_save_count() == 2 and skia_test_restore_count() == 1 and UiSkia::is_balanced())
    UiSkia::detach()
    _ = UiResources::dispose(interactive_primary_font)
    _ = UiResources::dispose(interactive_fallback_font)

    rounded_image: UiResources::ResourceHandle = UiResources::request("images/rounded-fit", 7)
    _ = UiResources::set_intrinsic_size(rounded_image, 100.0, 50.0)
    _ = UiResources::set_state(rounded_image, UiResources::State.Ready)
    _ = UiSkia::bind_image(rounded_image, 0xD00D)
    skia_test_reset()
    UiSkia::attach(35)
    check("rounded image fit stays inside an Elisa clip", UiSkia::draw_image_fitted_rounded(0xD00D, fit_box, UiCore::Size(100.0, 50.0), 255, UiSkia::ImageFit.Contain, 100.0) and skia_test_rounded_clip_count() == 1 and skia_test_last_clip_radius() == 50.0 and skia_test_last_image_x() == 10.0 and skia_test_last_image_y() == 45.0 and skia_test_last_image_width() == 100.0 and skia_test_last_image_height() == 50.0)
    check("rounded bound image fit reuses intrinsic metadata", UiSkia::draw_bound_image_fitted_intrinsic_rounded_with_sampling(rounded_image, fit_box, 255, UiSkia::ImageFit.Cover, 12.0, UiSkia::ImageSampling.Nearest) and skia_test_rounded_clip_count() == 2 and skia_test_last_clip_radius() == 12.0 and skia_test_last_image_sampling() == 0)
    check("rounded source crop composes an Elisa clip", UiSkia::draw_image_source_rounded_with_sampling(0xD00D, UiCore::Rect(2.0, 3.0, 20.0, 10.0), UiCore::Rect(10.0, 20.0, 80.0, 40.0), 255, 14.0, UiSkia::ImageSampling.Nearest) and skia_test_rounded_clip_count() == 3 and skia_test_last_clip_radius() == 14.0 and skia_test_last_image_source_x() == 2.0 and skia_test_last_image_source_width() == 20.0 and skia_test_last_image_sampling() == 0)
    check("rounded bound source crop keeps resource checks", UiSkia::draw_bound_image_source_rounded(rounded_image, UiCore::Rect(2.0, 3.0, 20.0, 10.0), UiCore::Rect(10.0, 20.0, 80.0, 40.0), 255, 14.0) and skia_test_rounded_clip_count() == 4 and skia_test_last_clip_radius() == 14.0 and skia_test_last_image_source_y() == 3.0)
    UiSkia::detach()
    _ = UiResources::dispose(rounded_image)

    UiCore::begin_frame()
    skia_test_reset()
    UiSkia::begin_deferred_frame()
    check("deferred fitted image stores Elisa placement policy", UiSkia::defer_image_fitted_with_sampling(0xD00D, fit_box, source_size, 255, UiSkia::ImageFit.Cover, UiSkia::ImageSampling.Nearest) and UiSkia::deferred_count() == 1)
    UiSkia::attach(35)
    check("deferred fitted image replays through a bounded clip", UiSkia::render_status() == UiSkia::RenderStatus.Complete and skia_test_image_count() == 1 and skia_test_clip_count() == 1 and skia_test_last_image_x() == -40.0 and skia_test_last_image_y() == 20.0 and skia_test_last_image_width() == 200.0 and skia_test_last_image_height() == 100.0 and skia_test_last_image_sampling() == 0)
    UiSkia::detach()
    UiSkia::end_deferred_frame()

    UiCore::begin_frame()
    skia_test_reset()
    UiSkia::begin_deferred_frame()
    check("deferred rounded source crop stores clip policy", UiSkia::defer_image_source_rounded_with_sampling(0xD00D, UiCore::Rect(2.0, 3.0, 20.0, 10.0), UiCore::Rect(10.0, 20.0, 80.0, 40.0), 255, 14.0, UiSkia::ImageSampling.Nearest) and UiSkia::deferred_count() == 1)
    UiSkia::attach(35)
    check("deferred rounded source crop replays through Elisa", UiSkia::render_status() == UiSkia::RenderStatus.Complete and skia_test_image_count() == 1 and skia_test_rounded_clip_count() == 1 and skia_test_last_clip_radius() == 14.0 and skia_test_last_image_source_x() == 2.0 and skia_test_last_image_source_height() == 10.0 and skia_test_last_image_sampling() == 0)
    UiSkia::detach()
    UiSkia::end_deferred_frame()

    UiCore::begin_frame()
    skia_test_reset()
    UiSkia::begin_deferred_frame()
    check("deferred source image stores Elisa crop", UiSkia::defer_image_source_with_sampling(0xD00D, UiCore::Rect(2.0, 3.0, 20.0, 10.0), UiCore::Rect(10.0, 20.0, 80.0, 40.0), 255, UiSkia::ImageSampling.Nearest) and UiSkia::deferred_count() == 1)
    UiSkia::attach(35)
    check("deferred source image replays crop", UiSkia::render_status() == UiSkia::RenderStatus.Complete and skia_test_image_count() == 1 and skia_test_last_image_source_x() == 2.0 and skia_test_last_image_source_y() == 3.0 and skia_test_last_image_source_width() == 20.0 and skia_test_last_image_source_height() == 10.0 and skia_test_last_image_x() == 10.0 and skia_test_last_image_width() == 80.0 and skia_test_last_image_sampling() == 0)
    UiSkia::detach()
    UiSkia::end_deferred_frame()

    UiCore::begin_frame()
    skia_test_reset()
    UiSkia::begin_deferred_frame()
    check("deferred rounded image keeps fit and radius together", UiSkia::defer_image_fitted_rounded(0xD00D, fit_box, source_size, 255, UiSkia::ImageFit.Contain, 100.0) and UiSkia::deferred_count() == 1)
    UiSkia::attach(35)
    check("deferred rounded image replays through an Elisa clip", UiSkia::render_status() == UiSkia::RenderStatus.Complete and skia_test_image_count() == 1 and skia_test_rounded_clip_count() == 1 and skia_test_last_clip_radius() == 50.0 and skia_test_last_image_x() == 10.0 and skia_test_last_image_y() == 45.0 and skia_test_last_image_width() == 100.0 and skia_test_last_image_height() == 50.0)
    UiSkia::detach()
    UiSkia::end_deferred_frame()

    UiResources::reset()
    deferred_bound_image: UiResources::ResourceHandle = UiResources::request("images/deferred-bound", 7)
    _ = UiResources::set_intrinsic_size(deferred_bound_image, 100.0, 50.0)
    _ = UiResources::set_state(deferred_bound_image, UiResources::State.Ready)
    _ = UiSkia::bind_image(deferred_bound_image, 0xD00D)
    check("deferred bound image binding is ready", UiResources::resource_is_valid(deferred_bound_image) and UiResources::state(deferred_bound_image) == UiResources::State.Ready and UiSkia::image_binding_count() == 1)
    UiCore::begin_frame()
    skia_test_reset()
    UiSkia::begin_deferred_frame()
    check("deferred bound image stores an exact destination", UiSkia::defer_bound_image_with_sampling(deferred_bound_image, fit_box, 255, UiSkia::ImageSampling.Nearest) and UiSkia::deferred_count() == 1)
    UiSkia::attach(35)
    check("deferred bound image replays without fitting", UiSkia::render_status() == UiSkia::RenderStatus.Complete and skia_test_image_count() == 1 and skia_test_rounded_clip_count() == 0 and skia_test_last_image_x() == 10.0 and skia_test_last_image_y() == 20.0 and skia_test_last_image_width() == 100.0 and skia_test_last_image_height() == 100.0 and skia_test_last_image_sampling() == 0)
    UiSkia::detach()
    UiSkia::end_deferred_frame()
    UiCore::begin_frame()
    skia_test_reset()
    UiSkia::begin_deferred_frame()
    check("deferred bound image stores source crop identity", UiSkia::defer_bound_image_source_with_sampling(deferred_bound_image, UiCore::Rect(2.0, 3.0, 20.0, 10.0), UiCore::Rect(10.0, 20.0, 80.0, 40.0), 255, UiSkia::ImageSampling.Nearest) and UiSkia::deferred_count() == 1)
    UiSkia::attach(35)
    check("deferred bound image replays source crop", UiSkia::render_status() == UiSkia::RenderStatus.Complete and skia_test_image_count() == 1 and skia_test_last_image_source_x() == 2.0 and skia_test_last_image_source_y() == 3.0 and skia_test_last_image_source_width() == 20.0 and skia_test_last_image_source_height() == 10.0 and skia_test_last_image_x() == 10.0 and skia_test_last_image_width() == 80.0 and skia_test_last_image_sampling() == 0)
    UiSkia::detach()
    UiSkia::end_deferred_frame()
    UiCore::begin_frame()
    skia_test_reset()
    UiSkia::begin_deferred_frame()
    check("deferred bound crop clamps to intrinsic dimensions", UiSkia::defer_bound_image_source_with_sampling(deferred_bound_image, UiCore::Rect(2.0, 3.0, 200.0, 100.0), UiCore::Rect(10.0, 20.0, 80.0, 40.0), 255, UiSkia::ImageSampling.Nearest) and UiSkia::deferred_count() == 1)
    UiSkia::attach(35)
    check("deferred intrinsic crop replays bounded source", UiSkia::render_status() == UiSkia::RenderStatus.Complete and skia_test_image_count() == 1 and skia_test_last_image_source_x() == 2.0 and skia_test_last_image_source_y() == 3.0 and skia_test_last_image_source_width() == 98.0 and skia_test_last_image_source_height() == 47.0)
    UiSkia::detach()
    UiSkia::end_deferred_frame()
    UiCore::begin_frame()
    skia_test_reset()
    UiSkia::begin_deferred_frame()
    check("deferred rounded bound source crop stores resource token", UiSkia::defer_bound_image_source_rounded_with_sampling(deferred_bound_image, UiCore::Rect(2.0, 3.0, 20.0, 10.0), UiCore::Rect(10.0, 20.0, 80.0, 40.0), 255, 14.0, UiSkia::ImageSampling.Nearest) and UiSkia::deferred_count() == 1)
    UiSkia::attach(35)
    check("deferred rounded bound source crop replays safely", UiSkia::render_status() == UiSkia::RenderStatus.Complete and skia_test_image_count() == 1 and skia_test_rounded_clip_count() == 1 and skia_test_last_clip_radius() == 14.0 and skia_test_last_image_source_width() == 20.0 and skia_test_last_image_sampling() == 0)
    UiSkia::detach()
    UiSkia::end_deferred_frame()
    UiCore::begin_frame()
    skia_test_reset()
    UiSkia::begin_deferred_frame()
    check("deferred bound image captures logical resource identity", UiSkia::defer_bound_image_fitted_intrinsic_rounded_with_sampling(deferred_bound_image, fit_box, 255, UiSkia::ImageFit.Contain, 100.0, UiSkia::ImageSampling.Nearest) and UiSkia::deferred_count() == 1)
    UiSkia::attach(35)
    check("deferred bound image keeps binding through attach", UiSkia::image_binding_count() == 1)
    check("deferred bound image resolves its generation at replay", UiSkia::render_status() == UiSkia::RenderStatus.Complete and skia_test_image_count() == 1 and skia_test_rounded_clip_count() == 1 and skia_test_last_clip_radius() == 50.0 and skia_test_last_image_sampling() == 0)
    UiSkia::detach()
    UiSkia::end_deferred_frame()
    _ = UiResources::dispose(deferred_bound_image)

    stale_deferred_image: UiResources::ResourceHandle = UiResources::request("images/deferred-stale", 7)
    _ = UiResources::set_intrinsic_size(stale_deferred_image, 100.0, 50.0)
    _ = UiResources::set_state(stale_deferred_image, UiResources::State.Ready)
    _ = UiSkia::bind_image(stale_deferred_image, 0xEEEE)
    UiCore::begin_frame()
    skia_test_reset()
    UiSkia::begin_deferred_frame()
    _ = UiSkia::defer_bound_image_fitted_intrinsic(stale_deferred_image, fit_box, 255, UiSkia::ImageFit.Contain)
    _ = UiResources::dispose(stale_deferred_image)
    UiSkia::attach(35)
    check("deferred bound image drops a disposed generation", UiSkia::render_status() == UiSkia::RenderStatus.Complete and skia_test_image_count() == 0 and skia_test_rounded_clip_count() == 0)
    UiSkia::detach()
    UiSkia::end_deferred_frame()
