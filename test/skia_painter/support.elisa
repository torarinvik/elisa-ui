# Shared by every skia_painter_test phase: the painter and theme modules under test, the
# counting hooks test/skia_painter_shim.c exposes, and the failure tally `check` feeds.
# Included first by test/skia_painter_test.elisa; the phase files assume it is in scope.

include "../../src/platform/skia/ui_skia.elisa"
include "../../src/widgets/ui_theme.elisa"

extern puts(text: cstr) -> i64
extern skia_test_reset() -> void
extern skia_test_save_count() -> i32
extern skia_test_restore_count() -> i32
extern skia_test_scale_count() -> i32
extern skia_test_translate_count() -> i32
extern skia_test_rotate_count() -> i32
extern skia_test_clip_count() -> i32
extern skia_test_rounded_clip_count() -> i32
extern skia_test_clear_count() -> i32
