# Phase 1: ABI packing, renderer capability profiles, one retained command batch with
# transparent commands and elevation metadata, and the rounded-rect style policy.

def check_abi_and_command_batch() -> void:
    check("Skia ABI version is packed in Elisa", UiSkia::abi_version() == 0x000400 and elisa_skia_abi_version() == 0x000400)
    check("backing scale stays in Elisa", UiCore::backing_scale(320.0, 200.0, 640.0, 300.0) == 1.5 and UiCore::backing_scale(320.0, 200.0, 0.0, 300.0) == 0.0)
    UiCapabilities::use_appkit_canvas()
    check("custom profile starts with CoreGraphics fallback", UiCapabilities::renderer() == UiCapabilities::Renderer.CoreGraphics)
    UiCapabilities::use_wasm_browser()
    UiSkia::attach(6)
    check("hosted profile rejects Skia attachment", not UiSkia::is_attached() and UiCapabilities::renderer() == UiCapabilities::Renderer.Hosted)
    UiCapabilities::use_appkit_canvas()
    UiCore::begin_frame()
    UiCore::clear(UiCore::rgb(10, 20, 30))
    UiCore::set_clip(UiCore::Rect(1.0, 2.0, 30.0, 40.0))
    UiCore::fill_elevated(UiCore::Rect(2.0, 3.0, 100.0, 30.0), UiCore::rgb(40, 50, 60))
    UiCore::clear_clip()
    UiCore::fill(UiCore::Rect(2.0, 3.0, 100.0, 30.0), UiCore::rgb(45, 55, 65))
    UiCore::fill(UiCore::Circle{center: UiCore::Vec2{ x: 20.0, y: 20.0 }, radius: 4.0}, UiCore::rgb(70, 80, 90))
    UiCore::fill(UiCore::Triangle{a: UiCore::Vec2{ x: 1.0, y: 1.0 }, b: UiCore::Vec2{ x: 4.0, y: 1.0 }, c: UiCore::Vec2{ x: 2.0, y: 5.0 }}, UiCore::rgb(100, 110, 120))
    UiCore::fill(UiCore::Line{from_point: UiCore::Vec2{ x: 0.0, y: 0.0 }, to_point: UiCore::Vec2{ x: 8.0, y: 8.0 }}, UiCore::rgb(130, 140, 150))
    UiCore::draw(UiCore::TextRun(UiCore::Vec2(2.0, 12.0), 14.0, "Skia"), UiCore::rgb(160, 170, 180))
    UiCore::fill(UiCore::Rect(2.0, 3.0, 20.0, 10.0), UiCore::rgba(40, 50, 60, 0))
    UiCore::fill(UiCore::Circle{center: UiCore::Vec2{ x: 20.0, y: 20.0 }, radius: 4.0}, UiCore::rgba(70, 80, 90, 0))
    UiCore::fill(UiCore::Triangle{a: UiCore::Vec2{ x: 1.0, y: 1.0 }, b: UiCore::Vec2{ x: 4.0, y: 1.0 }, c: UiCore::Vec2{ x: 2.0, y: 5.0 }}, UiCore::rgba(100, 110, 120, 0))
    UiCore::fill(UiCore::Line{from_point: UiCore::Vec2{ x: 0.0, y: 0.0 }, to_point: UiCore::Vec2{ x: 8.0, y: 8.0 }}, UiCore::rgba(130, 140, 150, 0))
    UiCore::draw(UiCore::TextRun(UiCore::Vec2(2.0, 12.0), 14.0, "transparent"), UiCore::rgba(160, 170, 180, 0))
    check("elevation metadata is explicit", UiCore::command_is_elevated(1) and not UiCore::command_is_elevated(2))
    style: UiPaint::RoundedRectStyle = UiPaint::rounded_rect_style(UiCore::Rect(2.0, 3.0, 100.0, 30.0), true)
    plain_style: UiPaint::RoundedRectStyle = UiPaint::rounded_rect_style(UiCore::Rect(2.0, 3.0, 100.0, 30.0), false)
    custom_style: UiPaint::RoundedRectStyle = UiPaint::rounded_rect_style_with_radius(UiCore::Rect(0.0, 0.0, 20.0, 10.0), false, 9.0)
    check("theme radius is clamped to half the box", custom_style.radius == 5.0)
    # THE DEPTH POLICY, asserted as the three claims it makes rather than as a
    # table of numbers: a light surface is lifted by the shadow it casts, a dark
    # one by light on its top edge, and a recess is the same lighting turned
    # over -- no shadow, a wash that is shade rather than sheen, and its rim at
    # the bottom. Only the ORDERING between treatments is pinned here, so the
    # values stay tunable while the rules cannot silently invert.
    box: UiCore::Rect = UiCore::Rect(2.0, 3.0, 100.0, 30.0)
    paper: UiCore::Color = UiCore::rgb(250, 250, 252)
    slate: UiCore::Color = UiCore::rgb(31, 36, 48)
    lifted_paper: UiPaint::RoundedRectStyle = UiPaint::rounded_rect_style_for(box, UiCore::SurfaceDepth.Raised, paper)
    lifted_slate: UiPaint::RoundedRectStyle = UiPaint::rounded_rect_style_for(box, UiCore::SurfaceDepth.Raised, slate)
    well: UiPaint::RoundedRectStyle = UiPaint::rounded_rect_style_for(box, UiCore::SurfaceDepth.Inset, slate)
    flat: UiPaint::RoundedRectStyle = UiPaint::rounded_rect_style_for(box, UiCore::SurfaceDepth.Flat, slate)
    check("a dark surface leans on light where a shadow cannot be seen", lifted_slate.shadow_alpha > lifted_paper.shadow_alpha and lifted_paper.bevel_alpha > lifted_slate.bevel_alpha)
    check("a recess casts no shadow and is shaded, not lit", well.shadow_alpha == 0 and well.sheen_is_shadow and well.bevel_at_bottom and well.sheen_top_alpha > 0)
    check("a raised surface is lit from the top", not lifted_slate.sheen_is_shadow and not lifted_slate.bevel_at_bottom and lifted_slate.sheen_bottom_alpha == 0)
    check("elevation is a difference of degree, not of kind", lifted_slate.sheen_top_alpha > flat.sheen_top_alpha and lifted_slate.bevel_alpha > flat.bevel_alpha and flat.shadow_alpha == 0)
    check("a saturated accent is treated as the dark surface it is", UiCore::surface_luminance(UiCore::rgb(66, 120, 236)) < 128 and UiCore::surface_luminance(paper) >= 128)

    # THE CORNER POLICY, asserted as the three shapes it distinguishes rather
    # than as a table of radii. A bar is a capsule; a square is not; a list row
    # is slender but too thick to be a bar, which is the case that a
    # slenderness-only rule got wrong and a render caught.
    track: UiCore::Rect = UiCore::Rect(0.0, 0.0, 900.0, 4.0)
    square: UiCore::Rect = UiCore::Rect(0.0, 0.0, 14.0, 14.0)
    row: UiCore::Rect = UiCore::Rect(0.0, 0.0, 940.0, 26.0)
    check("a bar is a capsule", UiPaint::corner_radius(track) == 2.0)
    check("a square is not a circle", UiPaint::corner_radius(square) < 7.0 and UiPaint::corner_radius(square) > 0.0)
    check("a list row is not a stadium", UiPaint::corner_radius(row) < 13.0)
    check("a large surface shares one corner", UiPaint::corner_radius(UiCore::Rect(0.0, 0.0, 950.0, 260.0)) == UiPaint::CORNER_MAX)
    check("the corner is continuous across thickness", UiPaint::corner_radius(UiCore::Rect(0.0, 0.0, 900.0, 12.0)) > UiPaint::corner_radius(UiCore::Rect(0.0, 0.0, 900.0, 12.5)) * 0.5)

    check("custom painters share explicit rounded style policy", style.elevated and style.shadow_alpha == 61 and style.hairline_alpha == 33 and style.shadow_offset_x == 0.0 and style.shadow_offset_y == 2.0 and style.shadow_blur == 5.0 and style.hairline_width == 1.0 and not plain_style.elevated and plain_style.shadow_alpha == 0 and plain_style.hairline_alpha == 14)
