# Phase 7: the drawing vocabulary's side-band metadata.
#
# Depth and stroke weight both ride BESIDE the command rather than inside its
# payload, so a wire backend's decoder keeps working and reads them only if it
# can honour them. This phase runs last because it begins a frame of its own:
# the batch the earlier phases build is the batch they replay.

def check_vocabulary() -> void:
    can Ui.Draw, Ui.Text:
        # Stroke weight rides beside the command, like depth, and leaves the
        # FillLine payload alone.
        UiCore::begin_frame()
        UiCore::fill(UiCore::Line{from_point: UiCore::Vec2(0.0, 0.0), to_point: UiCore::Vec2(10.0, 0.0)}, UiCore::rgb(200, 200, 200))
        UiCore::fill_stroke(UiCore::Line{from_point: UiCore::Vec2(0.0, 4.0), to_point: UiCore::Vec2(10.0, 4.0)}, 3.5, UiCore::rgb(200, 200, 200))
        UiCore::fill_elevated(UiCore::Circle{center: UiCore::Vec2(20.0, 20.0), radius: 6.0}, UiCore::rgb(240, 240, 245))
        check("an ordinary line is a hairline", UiCore::command_stroke_width_at(0) == UiCore::DEFAULT_STROKE_WIDTH)
        check("a stroke carries its own weight", UiCore::command_stroke_width_at(1) == 3.5)
        check("weight does not disturb depth", UiCore::command_depth_at(1) == UiCore::SurfaceDepth.Flat)
        check("a raised disc records its depth", UiCore::command_depth_at(2) == UiCore::SurfaceDepth.Raised)
        check("a hairline is butt-capped and a stroke is not", not UiPaint::stroke_cap_is_round(1.0) and UiPaint::stroke_cap_is_round(2.0))

        # And the weight reaches the backend. The recorder is the only thing
        # that can say so: the batch above is replayed through the real painter
        # and the width the bridge received is read back.
        UiSkia::attach(9)
        skia_test_reset()
        UiPaint::replay[UiSkia::SkiaPainter]()
        UiSkia::detach()
        check("the weight reaches the bridge", skia_test_line_count() == 2 and skia_test_last_line_width() == 3.5)
        check("and so does the cap it implies", skia_test_last_line_round_cap() == 1)

        # Synthetic text weight is a number the FRAMEWORK chooses, not one the
        # bridge picks: `setEmbolden` used to decide it, and measured against a
        # real semibold face it was 30% light. The recorder reads back what the
        # painter asked for.
        UiCore::begin_frame()
        UiCore::draw(UiCore::TextRun(UiCore::Vec2(4.0, 20.0), 26.0, "166", true), UiCore::rgb(240, 240, 245))
        UiSkia::attach(11)
        skia_test_reset()
        UiPaint::replay[UiSkia::SkiaPainter]()
        UiSkia::detach()
        check("a weighted run carries the framework's stem growth", skia_test_last_text_weight_stroke() == UiPaint::synthetic_weight_stroke(26.0, true))
        check("and the growth is real", UiPaint::synthetic_weight_stroke(26.0, true) > 0.0)

        UiCore::begin_frame()
        UiCore::draw(UiCore::TextRun(UiCore::Vec2(4.0, 20.0), 26.0, "166"), UiCore::rgb(240, 240, 245))
        UiSkia::attach(11)
        skia_test_reset()
        UiPaint::replay[UiSkia::SkiaPainter]()
        UiSkia::detach()
        check("an ordinary run is drawn as the face is", skia_test_last_text_weight_stroke() == 0.0)

        # GLASS. A raised surface you can see through blurs what is behind it,
        # and the framework asks for that with a primitive no other effect
        # needs -- it is the one thing that is a function of the pixels UNDER a
        # surface. What makes it an application-level decision without a new
        # API is that the alpha already says it: a lifted panel with a
        # translucent fill is a panel floating above content you can still see.
        UiCore::begin_frame()
        UiCore::fill_elevated(UiCore::Rect(10.0, 10.0, 200.0, 120.0), UiCore::rgba(30, 34, 44, 190))
        UiSkia::attach(13)
        skia_test_reset()
        UiPaint::replay[UiSkia::SkiaPainter]()
        UiSkia::detach()
        glass: UiPaint::RoundedRectStyle = UiPaint::rounded_rect_style_for(UiCore::Rect(10.0, 10.0, 200.0, 120.0), UiCore::SurfaceDepth.Raised, UiCore::rgba(30, 34, 44, 190))
        check("a translucent raised surface blurs what is behind it", skia_test_backdrop_blur_count() == 1)
        check("and the radius is the framework's, not the bridge's", skia_test_last_backdrop_sigma() == glass.backdrop_blur and glass.backdrop_blur > 0.0)

        # The three surfaces that are NOT glass, and none of them is an
        # accident of alpha: an opaque panel has nothing to show through it, a
        # recess is IN the surface it is cut from, and a flat translucent fill
        # is a tint -- the framework paints those by the hundred.
        UiCore::begin_frame()
        UiCore::fill_elevated(UiCore::Rect(10.0, 10.0, 200.0, 120.0), UiCore::rgb(30, 34, 44))
        UiCore::fill_inset(UiCore::Rect(10.0, 140.0, 200.0, 40.0), UiCore::rgba(30, 34, 44, 190))
        UiCore::fill(UiCore::Rect(10.0, 190.0, 200.0, 40.0), UiCore::rgba(30, 34, 44, 190))
        UiSkia::attach(13)
        skia_test_reset()
        UiPaint::replay[UiSkia::SkiaPainter]()
        UiSkia::detach()
        check("an opaque, a recessed and a flat surface are not glass", skia_test_backdrop_blur_count() == 0)

        # A DESIGNED BOLD IF THE HOST HAS ONE. Synthetic weight was always a
        # stand-in for a face the renderer did not have, and the framework said
        # so: a stroke dilates an outline uniformly, which is not what a drawn
        # bold does, and matching a real semibold's ink closed the counters. A
        # host that lends a second face gets the real thing, drawn AND measured
        # with it -- and the synthetic growth is not applied on top, which
        # would double the stems.
        regular_width: f32 = UiSkia::active_measure_text_width("Overview", 20.0, false)
        synthetic_width: f32 = UiSkia::active_measure_text_width("Overview", 20.0, true)
        check("without a bold face weight costs no width", synthetic_width == regular_width)
        UiSkia::set_bold_font(0x5B01D)
        real_bold_width: f32 = UiSkia::active_measure_text_width("Overview", 20.0, true)
        check("a lent bold face has its own advances", real_bold_width > regular_width)
        check("and the regular face is untouched by it", UiSkia::active_measure_text_width("Overview", 20.0, false) == regular_width)
        check("the renderer reports the face it was lent", UiSkia::bold_font() == 0x5B01D)

        UiCore::begin_frame()
        UiCore::draw(UiCore::TextRun(UiCore::Vec2(4.0, 20.0), 26.0, "166", true), UiCore::rgb(240, 240, 245))
        UiSkia::attach(15)
        skia_test_reset()
        UiPaint::replay[UiSkia::SkiaPainter]()
        UiSkia::detach()
        check("a weighted run is drawn with the lent face", skia_test_last_text_used_bold() == 1)
        UiSkia::set_bold_font(0)
        check("taking the face back restores the synthetic weight", UiSkia::active_measure_text_width("Overview", 20.0, true) == regular_width and UiSkia::bold_font() == 0)

        # A WIDE LINE FROM NARROW ONES. A backend whose renderer draws only
        # single-pixel lines can still honour a weight by drawing the line
        # several times along its normal, and how many times and how far apart
        # is policy -- so it is asserted here, with no renderer in sight, and
        # the backend contributes only the line it already had.
        check("a hairline is one pass", UiPaint::stroke_pass_count(UiCore::DEFAULT_STROKE_WIDTH) == 1 and UiPaint::stroke_pass_count(0.4) == 1)
        check("a weight is as many passes as it is wide", UiPaint::stroke_pass_count(3.0) == 3 and UiPaint::stroke_pass_count(2.4) == 2)
        check("and a hostile weight cannot ask for unbounded work", UiPaint::stroke_pass_count(1.0 / 0.0) == 1 and UiPaint::stroke_pass_count(4096.0) == UiPaint::MAX_STROKE_PASSES)
        # An odd count keeps one pass exactly on the line; an even one
        # straddles it. Either way the passes are centred, so a weighted line
        # covers the same middle as the hairline it replaces.
        check("an odd count keeps a pass on the line", UiPaint::stroke_pass_offset(3.0, 1) == 0.0)
        check("and is symmetric about it", UiPaint::stroke_pass_offset(3.0, 0) == 0.0 - UiPaint::stroke_pass_offset(3.0, 2))
        check("an even count straddles it", UiPaint::stroke_pass_offset(2.0, 0) == 0.0 - UiPaint::stroke_pass_offset(2.0, 1) and UiPaint::stroke_pass_offset(2.0, 0) != 0.0)
        check("a pass past the count contributes nothing", UiPaint::stroke_pass_offset(3.0, 9) == 0.0)
