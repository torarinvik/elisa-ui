# Phase 7: the drawing vocabulary's side-band metadata.
#
# Depth and stroke weight both ride BESIDE the command rather than inside its
# payload, so a wire backend's decoder keeps working and reads them only if it
# can honour them. This phase runs last because it begins a frame of its own:
# the batch the earlier phases build is the batch they replay.

def check_vocabulary() -> void:
    can Ui.Draw, Ui.Text:
        # Stroke weight rides beside the command, like depth, and leaves the
        # FillLine payload alone.
        UiCore::begin_frame()
        UiCore::fill(UiCore::Line{from_point: UiCore::Vec2(0.0, 0.0), to_point: UiCore::Vec2(10.0, 0.0)}, UiCore::rgb(200, 200, 200))
        UiCore::fill_stroke(UiCore::Line{from_point: UiCore::Vec2(0.0, 4.0), to_point: UiCore::Vec2(10.0, 4.0)}, 3.5, UiCore::rgb(200, 200, 200))
        UiCore::fill_elevated(UiCore::Circle{center: UiCore::Vec2(20.0, 20.0), radius: 6.0}, UiCore::rgb(240, 240, 245))
        check("an ordinary line is a hairline", UiCore::command_stroke_width_at(0) == UiCore::DEFAULT_STROKE_WIDTH)
        check("a stroke carries its own weight", UiCore::command_stroke_width_at(1) == 3.5)
        check("weight does not disturb depth", UiCore::command_depth_at(1) == UiCore::SurfaceDepth.Flat)
        check("a raised disc records its depth", UiCore::command_depth_at(2) == UiCore::SurfaceDepth.Raised)
        check("a hairline is butt-capped and a stroke is not", not UiPaint::stroke_cap_is_round(1.0) and UiPaint::stroke_cap_is_round(2.0))

        # And the weight reaches the backend. The recorder is the only thing
        # that can say so: the batch above is replayed through the real painter
        # and the width the bridge received is read back.
        UiSkia::attach(9)
        skia_test_reset()
        UiPaint::replay[UiSkia::SkiaPainter]()
        UiSkia::detach()
        check("the weight reaches the bridge", skia_test_line_count() == 2 and skia_test_last_line_width() == 3.5)
        check("and so does the cap it implies", skia_test_last_line_round_cap() == 1)

        # Synthetic text weight is a number the FRAMEWORK chooses, not one the
        # bridge picks: `setEmbolden` used to decide it, and measured against a
        # real semibold face it was 30% light. The recorder reads back what the
        # painter asked for.
        UiCore::begin_frame()
        UiCore::draw(UiCore::TextRun(UiCore::Vec2(4.0, 20.0), 26.0, "166", true), UiCore::rgb(240, 240, 245))
        UiSkia::attach(11)
        skia_test_reset()
        UiPaint::replay[UiSkia::SkiaPainter]()
        UiSkia::detach()
        check("a weighted run carries the framework's stem growth", skia_test_last_text_weight_stroke() == UiPaint::synthetic_weight_stroke(26.0, true))
        check("and the growth is real", UiPaint::synthetic_weight_stroke(26.0, true) > 0.0)

        UiCore::begin_frame()
        UiCore::draw(UiCore::TextRun(UiCore::Vec2(4.0, 20.0), 26.0, "166"), UiCore::rgb(240, 240, 245))
        UiSkia::attach(11)
        skia_test_reset()
        UiPaint::replay[UiSkia::SkiaPainter]()
        UiSkia::detach()
        check("an ordinary run is drawn as the face is", skia_test_last_text_weight_stroke() == 0.0)

        # GLASS. A raised surface you can see through blurs what is behind it,
        # and the framework asks for that with a primitive no other effect
        # needs -- it is the one thing that is a function of the pixels UNDER a
        # surface. What makes it an application-level decision without a new
        # API is that the alpha already says it: a lifted panel with a
        # translucent fill is a panel floating above content you can still see.
        UiCore::begin_frame()
        UiCore::fill_elevated(UiCore::Rect(10.0, 10.0, 200.0, 120.0), UiCore::rgba(30, 34, 44, 190))
        UiSkia::attach(13)
        skia_test_reset()
        UiPaint::replay[UiSkia::SkiaPainter]()
        UiSkia::detach()
        glass: UiPaint::RoundedRectStyle = UiPaint::rounded_rect_style_for(UiCore::Rect(10.0, 10.0, 200.0, 120.0), UiCore::SurfaceDepth.Raised, UiCore::rgba(30, 34, 44, 190))
        check("a translucent raised surface blurs what is behind it", skia_test_backdrop_blur_count() == 1)
        check("and the radius is the framework's, not the bridge's", skia_test_last_backdrop_sigma() == glass.backdrop_blur and glass.backdrop_blur > 0.0)

        # The three surfaces that are NOT glass, and none of them is an
        # accident of alpha: an opaque panel has nothing to show through it, a
        # recess is IN the surface it is cut from, and a flat translucent fill
        # is a tint -- the framework paints those by the hundred.
        UiCore::begin_frame()
        UiCore::fill_elevated(UiCore::Rect(10.0, 10.0, 200.0, 120.0), UiCore::rgb(30, 34, 44))
        UiCore::fill_inset(UiCore::Rect(10.0, 140.0, 200.0, 40.0), UiCore::rgba(30, 34, 44, 190))
        UiCore::fill(UiCore::Rect(10.0, 190.0, 200.0, 40.0), UiCore::rgba(30, 34, 44, 190))
        UiSkia::attach(13)
        skia_test_reset()
        UiPaint::replay[UiSkia::SkiaPainter]()
        UiSkia::detach()
        check("an opaque, a recessed and a flat surface are not glass", skia_test_backdrop_blur_count() == 0)

        # A DESIGNED BOLD IF THE HOST HAS ONE. Synthetic weight was always a
        # stand-in for a face the renderer did not have, and the framework said
        # so: a stroke dilates an outline uniformly, which is not what a drawn
        # bold does, and matching a real semibold's ink closed the counters. A
        # host that lends a second face gets the real thing, drawn AND measured
        # with it -- and the synthetic growth is not applied on top, which
        # would double the stems.
        regular_width: f32 = UiSkia::active_measure_text_width("Overview", 20.0, false)
        synthetic_width: f32 = UiSkia::active_measure_text_width("Overview", 20.0, true)
        check("without a bold face weight costs no width", synthetic_width == regular_width)
        UiSkia::set_bold_font(0x5B01D)
        real_bold_width: f32 = UiSkia::active_measure_text_width("Overview", 20.0, true)
        check("a lent bold face has its own advances", real_bold_width > regular_width)
        check("and the regular face is untouched by it", UiSkia::active_measure_text_width("Overview", 20.0, false) == regular_width)
        check("the renderer reports the face it was lent", UiSkia::bold_font() == 0x5B01D)

        UiCore::begin_frame()
        UiCore::draw(UiCore::TextRun(UiCore::Vec2(4.0, 20.0), 26.0, "166", true), UiCore::rgb(240, 240, 245))
        UiSkia::attach(15)
        skia_test_reset()
        UiPaint::replay[UiSkia::SkiaPainter]()
        UiSkia::detach()
        check("a weighted run is drawn with the lent face", skia_test_last_text_used_bold() == 1)
        UiSkia::set_bold_font(0)
        check("taking the face back restores the synthetic weight", UiSkia::active_measure_text_width("Overview", 20.0, true) == regular_width and UiSkia::bold_font() == 0)

        # A WIDE LINE FROM NARROW ONES. A backend whose renderer draws only
        # single-pixel lines can still honour a weight by drawing the line
        # several times along its normal, and how many times and how far apart
        # is policy -- so it is asserted here, with no renderer in sight, and
        # the backend contributes only the line it already had.
        check("a hairline is one pass", UiPaint::stroke_pass_count(UiCore::DEFAULT_STROKE_WIDTH) == 1 and UiPaint::stroke_pass_count(0.4) == 1)
        check("a weight is as many passes as it is wide", UiPaint::stroke_pass_count(3.0) == 3 and UiPaint::stroke_pass_count(2.4) == 2)
        check("and a hostile weight cannot ask for unbounded work", UiPaint::stroke_pass_count(1.0 / 0.0) == 1 and UiPaint::stroke_pass_count(4096.0) == UiPaint::MAX_STROKE_PASSES)
        # An odd count keeps one pass exactly on the line; an even one
        # straddles it. Either way the passes are centred, so a weighted line
        # covers the same middle as the hairline it replaces.
        check("an odd count keeps a pass on the line", UiPaint::stroke_pass_offset(3.0, 1) == 0.0)
        check("and is symmetric about it", UiPaint::stroke_pass_offset(3.0, 0) == 0.0 - UiPaint::stroke_pass_offset(3.0, 2))
        check("an even count straddles it", UiPaint::stroke_pass_offset(2.0, 0) == 0.0 - UiPaint::stroke_pass_offset(2.0, 1) and UiPaint::stroke_pass_offset(2.0, 0) != 0.0)
        check("a pass past the count contributes nothing", UiPaint::stroke_pass_offset(3.0, 9) == 0.0)

        # A SHADOW LIFTS A SURFACE. IT MUST NOT STAIN THE PAGE AROUND IT.
        #
        # Rendered against the interfaces this framework is aiming at, the
        # light palette's own frame was the tell: a white card darkened the
        # page under its edge by sixty-six levels and was still twenty-seven
        # levels dark thirty-five points away, and the twelve-point gutter
        # between two cards was filled by both their shadows at once. The gaps
        # in that frame did not read as the page. They read as grooves, and a
        # page of grooves is what makes an interface look a decade old.
        #
        # Three numbers decide this and all three lived in the depth policy
        # where no fixture could see them, because the painter shim discarded
        # the shadow's alpha outright -- the one value that separates height
        # from dirt.
        card: UiCore::Rect = UiCore::Rect(0.0, 0.0, 240.0, 72.0)
        paper: UiPaint::RoundedRectStyle = UiPaint::rounded_rect_style_for(card, UiCore::SurfaceDepth.Raised, UiCore::rgb(255, 255, 255))
        slate: UiPaint::RoundedRectStyle = UiPaint::rounded_rect_style_for(card, UiCore::SurfaceDepth.Raised, UiCore::rgb(28, 32, 40))
        check("a light card still casts a shadow", paper.shadow_alpha > 0 and paper.shadow_blur > 0.0 and paper.shadow_offset_y > 0.0)
        check("but a soft one, not a smear", paper.shadow_alpha <= 24)
        check("its contact line is tight, not dark", paper.contact_alpha <= 32 and paper.contact_blur < paper.shadow_blur)
        # Sideways reach is what crosses a gutter, and it is the blur.
        check("and it does not reach across the gutter beside it", paper.shadow_blur <= 12.0)
        # The dark palette leans on the sheen and the rim, so its shadow has to
        # survive being dark-on-dark. Keeping the two ends ordered is what
        # stops a light-palette correction from flattening the other one.
        check("a dark surface is still shadowed harder than a light one", slate.shadow_alpha > paper.shadow_alpha and slate.contact_alpha > paper.contact_alpha)
        # A shadow bigger than the thing casting it is haze, not height.
        check("a shadow is never larger than its surface", paper.shadow_blur + paper.shadow_offset_y <= 72.0)
        # ...and the painter passes on what the policy decided, rather than a
        # strength of its own. The shim kept every other argument and threw
        # this one away, so the whole policy above was unobservable end to end.
        UiCore::begin_frame()
        UiCore::fill_elevated(UiCore::Rect(20.0, 20.0, 240.0, 72.0), UiCore::rgb(255, 255, 255))
        skia_test_reset()
        UiSkia::attach(1)
        _ = UiSkia::render_status()
        UiSkia::detach()
        check("the painter asks for the shadow the policy chose", skia_test_last_shadow_alpha() > 0 and skia_test_last_shadow_alpha() <= 32)

        # A RECESS IS CUED BY ITS RIM, NOT BY A WASH ACROSS ITS FACE.
        #
        # The inner shadow in a well is cast by the LIP, and it falls off
        # within a few points of it. The gradient primitive every backend
        # shares runs edge to edge, so drawing the recess with it at a real
        # inner-shadow's strength produced a 61-level ramp down the entire
        # height of a text field: not a recess, a gradient fill, and the exact
        # beveled-well look interfaces stopped using two decades ago. It only
        # became visible when the light high-contrast frame was fixed to
        # actually render light surfaces.
        #
        # The rim already runs from the bevel at the bottom to the hairline at
        # the top for a recess -- that is the cue, it is edge-local, and it is
        # correct. The wash is left as a hint underneath it.
        well: UiPaint::RoundedRectStyle = UiPaint::rounded_rect_style_for(UiCore::Rect(0.0, 0.0, 240.0, 36.0), UiCore::SurfaceDepth.Inset, UiCore::rgb(246, 248, 251))
        check("a recess is lit from the same side as everything else", well.sheen_is_shadow and well.bevel_at_bottom)
        check("its face carries a hint, not a fill", well.sheen_top_alpha <= 32)
        check("and the hint never overpowers the rim that defines it", well.sheen_top_alpha < well.bevel_alpha)
        check("a recess casts no shadow of its own", well.shadow_alpha == 0 and well.contact_alpha == 0)

        # SHAPE IS A STATEMENT ABOUT KIND, not only about size.
        #
        # The derived corner policy is right for almost everything and is the
        # default for exactly that reason: it keeps every surface in a frame
        # consistent with every other without an application naming a pixel
        # value that stops being right at the next text scale. But two
        # surfaces of the same size can be different kinds, and there was no
        # way to say so -- a radius came from the box and from nothing else,
        # so a capsule tag was not expressible at all.
        chip: UiCore::Rect = UiCore::Rect(0.0, 0.0, 64.0, 22.0)
        # The policy asks whether a box is a BAR -- long AND thin -- and a
        # 64x22 chip is neither enough of either. It is not wrong about that;
        # it simply cannot know the answer.
        check("the derived policy rounds a chip like a small card", UiPaint::corner_radius_for(chip, UiCore::CornerStyle.Automatic) < 11.0)
        check("and a stated capsule is a capsule", UiPaint::corner_radius_for(chip, UiCore::CornerStyle.Pill) == 11.0)
        check("a stated square has no corners", UiPaint::corner_radius_for(chip, UiCore::CornerStyle.Square) == 0.0)
        # A capsule asks for half the short side, which is the value the style
        # already clamps to, so it can never exceed its box.
        tall: UiCore::Rect = UiCore::Rect(0.0, 0.0, 20.0, 200.0)
        check("a capsule is half the SHORT side, whichever that is", UiPaint::corner_radius_for(tall, UiCore::CornerStyle.Pill) == 10.0)
        check("and an empty box asks for nothing", UiPaint::corner_radius_for(UiCore::Rect(0.0, 0.0, 0.0, 40.0), UiCore::CornerStyle.Pill) == 0.0)
        # The kind survives the elevation treatment: a raised capsule is still
        # a capsule, and it still casts the shadow its size earns.
        raised_chip: UiPaint::RoundedRectStyle = UiPaint::rounded_rect_style_for_shaped(chip, UiCore::SurfaceDepth.Raised, UiCore::CornerStyle.Pill, UiCore::rgb(255, 255, 255))
        check("a raised capsule keeps both its shape and its lift", raised_chip.radius == 11.0 and raised_chip.shadow_alpha > 0)
        # ...and it reaches the backend. The side band carries it, so the
        # command payload is unchanged and a wire backend decodes the same
        # rectangles it always did.
        UiCore::begin_frame()
        UiCore::fill_shaped(UiCore::Rect(20.0, 20.0, 64.0, 22.0), UiCore::rgb(70, 90, 140), UiCore::SurfaceDepth.Flat, UiCore::CornerStyle.Pill)
        check("the shape rides beside the command, not inside it", UiCore::command_corner_at(0) == UiCore::CornerStyle.Pill)
        skia_test_reset()
        UiSkia::attach(1)
        _ = UiSkia::render_status()
        UiSkia::detach()
        check("and the painter draws the capsule the application asked for", skia_test_last_round_radius() == 11.0)

        # A RAMP AND A LIGHT: the two things every surface in a current
        # interface has that this framework could not draw at all.
        #
        # A shadow says how HIGH something is. A glow says it is ON -- the
        # selected item, the primary action, the live indicator. They are
        # drawn by the same primitive and mean opposite things, so the
        # geometry that separates them lives here rather than in five
        # backends: a shadow is dropped and black, a glow is centred and the
        # surface's own colour, because light leaves an object in every
        # direction and weight only goes down.
        lit_box: UiCore::Rect = UiCore::Rect(0.0, 0.0, 120.0, 34.0)
        base_style: UiPaint::RoundedRectStyle = UiPaint::rounded_rect_style_for(lit_box, UiCore::SurfaceDepth.Raised, UiCore::rgb(60, 120, 240))
        lit: UiPaint::RoundedRectStyle = UiPaint::glow_shadow(base_style, lit_box)
        check("a glow is not dropped in any direction", lit.shadow_offset_x == 0.0 and lit.shadow_offset_y == 0.0)
        check("and it spreads further than the shadow it replaces", lit.shadow_blur > base_style.shadow_blur)
        check("it keeps the surface's own corner", lit.radius == base_style.radius)
        check("and it is only a light", lit.contact_alpha == 0 and lit.sheen_top_alpha == 0 and lit.bevel_alpha == 0 and lit.backdrop_blur == 0.0)
        check("a hostile box cannot ask for an unbounded light", UiPaint::glow_blur(UiCore::Rect(0.0, 0.0, 1.0e30, 1.0e30)) == UiPaint::GLOW_BLUR_MAX and UiPaint::glow_blur(UiCore::Rect(0.0, 0.0, 1.0, 1.0)) == UiPaint::GLOW_BLUR_MIN)

        # A zeroed record is the old behaviour exactly, which is what let this
        # reach every existing call site without touching one of them.
        plain: UiCore::SurfaceStyle = UiCore::surface_style(UiCore::SurfaceDepth.Raised)
        check("a surface that says nothing has neither", not UiCore::has_gradient(plain) and not UiCore::has_glow(plain) and plain.corner == UiCore::CornerStyle.Automatic)

        # ...and both reach the backend. The shim keeps the shadow's COLOUR,
        # so a glow is distinguishable from a shadow at the boundary rather
        # than only in the policy.
        UiCore::begin_frame()
        UiCore::fill_styled(UiCore::Rect(20.0, 20.0, 120.0, 34.0), UiCore::rgb(120, 170, 255), UiCore::SurfaceStyle{
            depth: UiCore::SurfaceDepth.Raised,
            corner: UiCore::CornerStyle.Pill,
            gradient: UiCore::rgb(60, 120, 240),
            gradient_horizontal: false,
            glow: UiCore::rgba(60, 120, 240, 90),
        })
        skia_test_reset()
        UiSkia::attach(1)
        _ = UiSkia::render_status()
        UiSkia::detach()
        # The FIRST rounded gradient of the frame is the fill. A raised
        # surface's sheen is a rounded gradient too and it is drawn after, so
        # a count alone can never tell a ramped fill from a flat one -- which
        # is exactly how the first version of this check passed with the ramp
        # removed.
        check("the painter fills a ramp rather than a flat colour", skia_test_first_ramp_red() == 120 and skia_test_first_ramp_green() == 170 and skia_test_first_ramp_blue() == 255)
        check("and runs it to the far colour the application named", skia_test_first_ramp_end_red() == 60)
        check("and draws the light in the colour it was given", skia_test_last_shadow_red() == 0 and skia_test_last_shadow_green() == 0 and skia_test_last_shadow_blue() == 0)
        # The ambient shadow is drawn AFTER the glow, so the last shadow the
        # backend was asked for is black -- which is what the check above
        # reads. The glow's own colour is asserted by drawing one alone.
        UiCore::begin_frame()
        UiCore::fill_styled(UiCore::Rect(20.0, 20.0, 120.0, 34.0), UiCore::rgb(120, 170, 255), UiCore::SurfaceStyle{
            depth: UiCore::SurfaceDepth.Flat,
            corner: UiCore::CornerStyle.Pill,
            gradient: UiCore::rgba(0, 0, 0, 0),
            gradient_horizontal: false,
            glow: UiCore::rgba(60, 120, 240, 90),
        })
        skia_test_reset()
        UiSkia::attach(1)
        _ = UiSkia::render_status()
        UiSkia::detach()
        check("a flat surface with a light draws exactly one, in colour", skia_test_shadow_round_rect_count() == 1 and skia_test_last_shadow_red() == 60 and skia_test_last_shadow_green() == 120 and skia_test_last_shadow_blue() == 240)
        check("and it is centred, not dropped", skia_test_last_shadow_offset_x() == 0.0 and skia_test_last_shadow_offset_y() == 0.0)
