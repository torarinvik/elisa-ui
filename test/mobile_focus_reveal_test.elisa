include "./widget_layout_support.elisa"
include "../src/widgets/ui_handles.elisa"

def main() -> i64:
    UiFlat::reset()
    UiCore::set_content_insets(0.0, 0.0, 0.0, 0.0)
    root: usize = UiFlat::scroll(UiFlat::NONE, UiConst::Axis.Column, 200.0, 100.0, UiCore::rgb(0, 0, 0))
    _ = UiFlat::button(root, 180.0, 150.0, UiCore::rgb(0, 0, 0), UiCore::rgb(0, 0, 0), UiCore::rgb(0, 0, 0))
    field: usize = UiFlat::text_field(root, "Name", "", "Ada", 180.0, 40.0, 14.0, UiCore::rgb(255, 255, 255), UiCore::rgb(0, 0, 0))
    UiFlat::layout(200.0, 220.0)
    _ = UiFlat::request_focus(field)
    check("field initially fits viewport", UiFlat::scroll_offset(root) == 0.0)
    _ = UiCore::set_content_insets(0.0, 0.0, 100.0, 0.0)
    UiFlat::layout(200.0, 220.0)
    check("keyboard inset reveals focused field", UiFlat::scroll_offset(root) > 0.0 and UiFlat::widget(field).y + UiFlat::widget(field).height <= UiFlat::widget(root).y + UiFlat::widget(root).height + 0.1)
    _ = UiFlat::set_scroll_offset(root, 0.0)
    UiFlat::layout(200.0, 220.0)
    check("ordinary scroll does not force focus back into view", UiFlat::scroll_offset(root) == 0.0)
    check("explicit reveal restores focused field visibility", UiFlat::reveal(field) and UiFlat::scroll_offset(root) > 0.0)
    check("invalid reveal fails closed", not UiFlat::reveal(UiFlat::NONE))
    UiFlat::reset()
    _ = UiCore::set_content_insets(0.0, 0.0, 0.0, 0.0)
    outer: usize = UiFlat::scroll(UiFlat::NONE, UiConst::Axis.Column, 200.0, 100.0, UiCore::rgb(0, 0, 0))
    _ = UiFlat::button(outer, 180.0, 150.0, UiCore::rgb(0, 0, 0), UiCore::rgb(0, 0, 0), UiCore::rgb(0, 0, 0))
    inner: usize = UiFlat::scroll(outer, UiConst::Axis.Column, 180.0, 100.0, UiCore::rgb(0, 0, 0))
    _ = UiFlat::button(inner, 160.0, 150.0, UiCore::rgb(0, 0, 0), UiCore::rgb(0, 0, 0), UiCore::rgb(0, 0, 0))
    nested_field: usize = UiFlat::text_field(inner, "Nested", "", "Ada", 160.0, 40.0, 14.0, UiCore::rgb(255, 255, 255), UiCore::rgb(0, 0, 0))
    _ = UiFlat::button(outer, 180.0, 300.0, UiCore::rgb(0, 0, 0), UiCore::rgb(0, 0, 0), UiCore::rgb(0, 0, 0))
    UiFlat::layout(200.0, 220.0)
    _ = UiFlat::request_focus(nested_field)
    check("nested reveal updates inner geometry before outer offset", near(UiFlat::scroll_offset(inner), 90.0) and near(UiFlat::scroll_offset(outer), 30.0))
    UiFlat::set_enabled(nested_field, false)
    check("disabled field cannot request reveal", not UiFlat::reveal(nested_field))
    _ = UiFlat::set_scroll_offset(outer, 0.0)
    _ = UiFlat::set_scroll_offset(inner, 0.0)
    _ = UiCore::set_content_insets(0.0, 0.0, 40.0, 0.0)
    UiFlat::layout(200.0, 220.0)
    check("keyboard relayout does not chase disabled focus", UiFlat::scroll_offset(inner) == 0.0 and UiFlat::scroll_offset(outer) == 0.0)
    UiFlat::set_enabled(nested_field, true)
    UiFlat::set_visible(inner, false)
    check("hidden ancestor makes reveal ineligible", not UiFlat::reveal(nested_field))
    _ = UiCore::set_content_insets(0.0, 0.0, 60.0, 0.0)
    UiFlat::layout(200.0, 220.0)
    check("keyboard relayout does not scroll toward hidden subtree", UiFlat::scroll_offset(outer) == 0.0)
    stale_field: UiHandles::Handle = UiHandles::from_index(nested_field)
    UiHandles::reset()
    replacement_root: UiHandles::Handle = UiHandles::column(UiHandles::root_parent(), 0.0, 0.0, UiCore::rgb(0, 0, 0))
    for _ in 0..<(stale_field.widget_id.usize() - 1):
        _ = UiHandles::button(replacement_root, 100.0, 20.0, UiCore::rgb(0, 0, 0), UiCore::rgb(0, 0, 0), UiCore::rgb(0, 0, 0))
    replacement: UiHandles::Handle = UiHandles::text_field(replacement_root, "New", "", "", 100.0, 30.0, 14.0, UiCore::rgb(255, 255, 255), UiCore::rgb(0, 0, 0))
    check("retired typed reveal rejects a recycled live slot", replacement.widget_id == stale_field.widget_id and not UiHandles::reveal(stale_field) and UiHandles::reveal(replacement))
    if test_failures == 0:
        _ = puts("mobile focus reveal: all checks passed")
        return 0
    return 1
