# Verify that the SDL3 idle wait writes and dispatches a real event. The quit
# event is injected from the first frame, after the poll drain has completed,
# so the next iteration can only observe it through SDL_WaitEventTimeout.

include "../src/platform/sdl3/ui_sdl3.elisa"

extern SDL_setenv_unsafe(name: cstr, value: cstr, overwrite: i32) -> i32
extern SDL_PushEvent(event: void&) -> bool
extern puts(text: cstr) -> i64

global mutable frame_calls: i32 = 0
global mutable saw_quit: bool = false
global mutable failures: i32 = 0

def push_close_event() -> void:
    event: mutable u64[16] = zeroed
    fields: mutable u32& = (&event[0]).cast[mutable u32&] can Unsafe.PointerCast
    fields[0] <- 0x210
    pointer: void& = (&event[0]).cast[void&] can Unsafe.PointerCast
    if not SDL_PushEvent(pointer):
        failures <- failures + 1

def app_init() -> void:
    pass

def app_frame() -> void:
    frame_calls <- frame_calls + 1
    push_close_event() if frame_calls == 1

def app_event(event: UiCore::Event) -> void:
    match event:
        UiCore::Event.Quit:
            saw_quit <- true
        _:
            pass

def app_text_input(text: sview) -> void:
    pass

def app_text_editing(text: sview, start: i32, length: i32) -> void:
    pass

def main() -> i64:
    _ = SDL_setenv_unsafe("SDL_VIDEODRIVER", "dummy", 1)
    result: i64 = UiSdl3::run("headless wait event regression", 64, 64, 0)
    if result != 0 or frame_calls != 1 or not saw_quit:
        failures <- failures + 1
    if failures == 0:
        _ = puts("SDL wait event: passed")
    return failures.i64()
