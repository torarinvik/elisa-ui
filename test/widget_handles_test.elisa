# Typed UiHandles keep the slot-based compatibility layer safe across rebuilds.
# This is a headless identity test: no backend or window is involved.

include "../src/widgets/ui_handles.elisa"
include "../src/widgets/ui_handles_persistence.elisa"

extern puts(text: cstr) -> i64

global mutable failures: i32 = 0

def ui_measure_text_width(text: sview, size: f32) -> f32:
    return text.len.f32() * size * 0.5

def ui_measure_text_height(text: sview, size: f32) -> f32:
    return size

def ui_font_ascent(size: f32) -> f32:
    return size

def ui_text_line_height(size: f32) -> f32:
    return size

def ui_clipboard_has_text() -> bool:
    return false

def ui_clipboard_write(bytes: u8&, length: usize) -> bool:
    return false

def ui_clipboard_read(buffer: mutable u8&, capacity: usize) -> usize:
    return 0

def app_init() -> void:
    pass

def app_event(event: UiCore::Event) -> void:
    pass

def app_text_input(text: sview) -> void:
    pass

def app_text_editing(text: sview, selected_start: i32, selected_length: i32) -> void:
    pass

def app_frame() -> void:
    pass

def app_widget_event(widget: usize, event: i32) -> void:
    pass

def check(name: cstr, ok: bool) -> void:
    return if ok
    failures <- failures + 1
    _ = puts(name)

def main() -> i64:
    UiHandles::reset()
    old_root: mutable UiHandles::Handle = UiHandles::Handle{widget_id: UiFlat::NONE.u32(), tree_id: 0}
    root: UiHandles::Handle = UiHandles::column(UiHandles::root_parent(), 8.0, 4.0, UiCore::rgb(20, 20, 24))
    old_root <- root
    check("flat root slot is valid", UiFlat::is_valid(0))
    check("flat lifetime is nonzero", UiFlat::lifetime() != 0)
    check("invalid flat enabled query fails closed", not UiFlat::is_enabled(UiFlat::NONE))
    check("invalid flat visible query fails closed", not UiFlat::is_visible(UiFlat::NONE))
    check("new root handle is valid", UiHandles::is_valid(root))
    check("root handle lifetime matches", root.tree_id == UiFlat::lifetime().u32())
    check("root handle keeps slot zero", root.widget_id == 0)
    check("root handle index helper keeps slot zero", UiHandles::index(root) == 0)
    child: UiHandles::Handle = UiHandles::button(root, 80.0, 24.0, UiCore::rgb(40, 80, 140), UiCore::rgb(60, 100, 160), UiCore::rgb(20, 50, 100))
    check("child allocation increments count", UiHandles::count() == 2)
    check("child handle is valid", UiHandles::is_valid(child))
    check("child exposes a retained widget", UiHandles::widget(child) != null)
    check("typed parent navigation returns the root", UiHandles::parent(child).widget_id == root.widget_id)
    check("typed first-child navigation returns the button", UiHandles::first_child(root).widget_id == child.widget_id)
    invalid_child: UiHandles::Handle = UiHandles::button(child, 80.0, 24.0, UiCore::rgb(40, 80, 140), UiCore::rgb(60, 100, 160), UiCore::rgb(20, 50, 100))
    check("leaf parent is rejected by typed builders", not UiHandles::is_valid(invalid_child) and UiHandles::index(invalid_child) == UiFlat::NONE and UiHandles::count() == 2)
    check("stale parent is not involved before reset", UiHandles::is_valid(root))
    check("new handle tree is not overflowed", not UiHandles::overflowed())

    theme: mutable UiFlat::Theme = UiHandles::theme()
    theme.focus_inset <- 3.0
    UiHandles::set_theme(theme)
    check("theme round-trips through the handle surface", UiHandles::theme().focus_inset == 3.0)

    # The typed builder covers every flat control constructor while keeping
    # the old compact slider/progress signatures source-compatible.
    slider: UiHandles::Handle = UiHandles::slider_labeled(root, "Volume", 100.0, 24.0, 0.25, UiCore::rgb(30, 30, 34), UiCore::rgb(70, 120, 220), UiCore::rgb(240, 240, 250))
    progress: UiHandles::Handle = UiHandles::progress_bar_labeled(root, "Loading", 100.0, 20.0, 0.5, UiCore::rgb(30, 30, 34), UiCore::rgb(70, 180, 120))
    secret: UiHandles::Handle = UiHandles::secure_text_field(root, "Password", "required", "initial", 160.0, 28.0, 14.0, UiCore::rgb(240, 240, 240), UiCore::rgb(30, 30, 36))
    radio: UiHandles::Handle = UiHandles::radio_button(root, 80.0, 24.0, UiCore::rgb(40, 40, 44), UiCore::rgb(60, 60, 68), UiCore::rgb(80, 80, 90))
    check_box: UiHandles::Handle = UiHandles::check_box(root, 80.0, 24.0, UiCore::rgb(40, 40, 44), UiCore::rgb(60, 60, 68), UiCore::rgb(80, 80, 90))
    check("labeled slider is valid", UiHandles::is_valid(slider) and UiHandles::value(slider) == 0.25)
    check("labeled progress is valid", UiHandles::is_valid(progress) and UiHandles::value(progress) == 0.5)
    check("secure field keeps initial text", UiHandles::text_value(secret) == "initial")
    if UiHandles::widget(secret) is secret_row:
        check("secure field is a text field", secret_row.kind == UiConst::WidgetKind.TextField)
        check("secure constructor marks private state", secret_row.secure)
    else:
        check("secure field is a text field", false)
    if UiHandles::widget(slider) is slider_row:
        check("slider caption stays in Elisa state", slider_row.text == "Volume")
    else:
        check("slider caption stays in Elisa state", false)

    # Labeled builders copy caller-owned views into the retained Elisa arena;
    # changing the source bytes must not mutate a live widget's caption,
    # placeholder, or accessibility help.
    borrowed_caption: mutable u8[8] = zeroed
    borrowed_caption[0] <- 79
    borrowed_caption[1] <- 114
    borrowed_caption[2] <- 105
    borrowed_caption[3] <- 103
    borrowed_caption[4] <- 105
    borrowed_caption[5] <- 110
    borrowed_caption[6] <- 97
    borrowed_caption[7] <- 108
    borrowed_view: sview = sview(&borrowed_caption[0], 0, 8)
    owned_label: UiHandles::Handle = UiHandles::label(root, borrowed_view, 12.0, UiCore::rgb(230, 230, 230))
    owned_field: UiHandles::Handle = UiHandles::text_field(root, borrowed_view, borrowed_view, "", 120.0, 24.0, 12.0, UiCore::rgb(230, 230, 230), UiCore::rgb(30, 30, 36))
    UiHandles::set_help(owned_field, borrowed_view)
    for byte_index in 0..<8:
        borrowed_caption[byte_index] <- 88
    if UiHandles::widget(owned_label) is owned_label_row:
        check("label caption is retained", owned_label_row.text == "Original")
    else:
        check("label caption is retained", false)
    if UiHandles::widget(owned_field) is owned_field_row:
        check("text placeholder is retained", owned_field_row.placeholder == "Original")
        check("help text is retained", owned_field_row.help == "Original")
    else:
        check("text placeholder is retained", false)
        check("help text is retained", false)

    UiHandles::set_selected(radio, true)
    UiHandles::set_selection_group(radio, 7)
    UiHandles::set_selected(check_box, true)
    check("radio selection is readable through its handle", UiHandles::selected(radio))
    check("checkbox selection is readable through its handle", UiHandles::selected(check_box))
    UiHandles::set_step(slider, 0.1)
    UiHandles::set_accessibility_value(slider, 0.75)
    check("slider accessibility value stays normalized", UiHandles::value(slider) == 0.75)

    UiHandles::set_color(child, UiCore::rgb(9, 10, 11))
    UiHandles::set_colors(child, UiCore::rgb(12, 13, 14), UiCore::rgb(15, 16, 17), UiCore::rgb(18, 19, 20))
    UiHandles::set_max_size(child, 140.0, 40.0)
    UiHandles::set_margin(child, 2.0)
    UiHandles::set_cross_alignment(child, UiConst::CrossAlignment.Center)
    UiHandles::set_main_alignment(root, UiConst::MainAlignment.Center)
    UiHandles::set_focus_order(child, 3)
    UiHandles::set_enabled(child, true)
    UiHandles::set_visible(child, true)
    styled: UiFlat::Widget = UiFlat::widget(UiHandles::index(child))
    check("handle style setters reach Elisa widget state", styled.color.r == 12 and styled.hover_color.g == 16 and styled.press_color.b == 20 and styled.max_width == 140.0 and styled.margin == 2.0)
    check("handle alignment setters reach Elisa widget state", styled.cross_alignment == UiConst::CrossAlignment.Center)

    UiHandles::layout(240.0, 220.0)
    hit_x: f32 = UiFlat::widget(UiHandles::index(child)).x + 1.0
    hit_y: f32 = UiFlat::widget(UiHandles::index(child)).y + 1.0
    check("typed callback event helper recognizes changes", UiHandles::event_is(UiConst::WidgetEvent.Change.i32(), UiConst::WidgetEvent.Change))
    check("typed callback event helper rejects other events", not UiHandles::event_is(UiConst::WidgetEvent.Click.i32(), UiConst::WidgetEvent.Change))
    check("typed callback identity helper matches live handle", UiHandles::callback_matches(UiHandles::index(child), child))
    check("typed callback identity helper rejects stale slot", not UiHandles::callback_matches(UiHandles::index(child), old_root))
    check("handle hit testing returns a typed child", UiHandles::hit(hit_x, hit_y).widget_id == child.widget_id)
    UiHandles::handle((UiCore::PointerEvent.Move(at: UiCore::Vec2(hit_x, hit_y))))
    check("handle event dispatch updates hot state", UiHandles::is_hot(child) and UiHandles::cursor_at(hit_x, hit_y) == 1)
    check("handle focus request is observable", UiHandles::request_focus(secret) and UiHandles::is_focused(secret))
    UiHandles::replace_text(secret, "changed")
    check("handle text replacement stays in Elisa", UiHandles::text_value(secret) == "changed")
    UiHandles::set_secure(secret, false)
    UiHandles::set_selection(secret, 0, 2)
    check("byte selection is exposed in UTF-16 units", UiHandles::selection_location(secret) == 0 and UiHandles::selection_length(secret) == 2 and UiHandles::selected_text(secret) == "ch")
    UiHandles::set_selection_utf16(secret, 2, 3)
    check("UTF-16 selection stays in Elisa", UiHandles::selected_text(secret) == "ang")
    UiHandles::set_secure(secret, true)
    check("handle text replacement records undo", UiHandles::can_undo_text())
    check("handle undo restores text", UiHandles::undo_text() and UiHandles::text_value(secret) == "initial")
    check("handle redo restores text", UiHandles::redo_text() and UiHandles::text_value(secret) == "changed")

    # The typed persistence adapter binds application-owned IDs to live
    # controls while excluding secure fields from the serialized snapshot.
    UiHandles::replace_text(owned_field, "persisted")
    UiHandles::set_value(slider, 0.35)
    zero_value: f32 = 0.0
    invalid_value: f32 = zero_value / zero_value
    UiHandles::set_value(slider, invalid_value)
    check("handle value setter rejects non-finite input", UiHandles::value(slider) == 0.35)
    UiHandles::set_step(slider, 0.2)
    UiHandles::set_step(slider, invalid_value)
    check("handle step setter rejects non-finite input", UiFlat::widget(UiHandles::index(slider)).step == 0.2)
    UiHandles::set_grow(slider, 1.0)
    UiHandles::set_grow(slider, invalid_value)
    check("handle grow setter rejects non-finite input", UiFlat::widget(UiHandles::index(slider)).grow == 1.0)
    UiHandles::set_selected(radio, true)
    UiHandlesPersistence::begin()
    check("typed persistence stores ordinary text", UiHandlesPersistence::put_text(owned_field, 101))
    check("typed persistence rejects secure text", not UiHandlesPersistence::put_text(secret, 102))
    check("typed persistence stores numeric value", UiHandlesPersistence::put_value(slider, 103))
    check("typed persistence stores selection", UiHandlesPersistence::put_selected(radio, 104))
    state_blob: mutable u8[UiState::MAX_BYTES] = zeroed
    state_length: usize = UiHandlesPersistence::copy_to(&state_blob[0], UiState::MAX_BYTES)
    check("typed persistence emits a valid snapshot", UiHandlesPersistence::saved().valid and state_length > UiState::HEADER_BYTES)
    UiHandles::replace_text(owned_field, "mutated")
    UiHandles::set_value(slider, 0.9)
    UiHandles::set_selected(radio, false)
    check("typed persistence restores the blob", UiHandlesPersistence::restore(&state_blob[0], state_length))
    check("wrong persisted type preserves text", not UiHandlesPersistence::restore_text(owned_field, 103) and UiHandles::text_value(owned_field) == "mutated")
    check("wrong persisted type rejects numeric restore", not UiHandlesPersistence::restore_value(slider, 101) and UiHandles::value(slider) == 0.9)
    check("wrong persisted type rejects selection restore", not UiHandlesPersistence::restore_selected(radio, 103) and not UiHandles::selected(radio))
    check("typed persistence restores ordinary text", UiHandlesPersistence::restore_text(owned_field, 101) and UiHandles::text_value(owned_field) == "persisted")
    check("typed persistence restores numeric value", UiHandlesPersistence::restore_value(slider, 103) and UiHandles::value(slider) == 0.35)
    check("typed persistence restores selection", UiHandlesPersistence::restore_selected(radio, 104) and UiHandles::selected(radio))
    check("typed persistence never restores secure text", not UiHandlesPersistence::restore_text(secret, 102) and UiHandles::text_value(secret) == "changed")
    UiState::begin()
    _ = UiState::put_f32(105, 4.0)
    out_of_range_length: usize = UiHandlesPersistence::copy_to(&state_blob[0], UiState::MAX_BYTES)
    check("typed persistence rejects clamped numeric restore", UiHandlesPersistence::restore(&state_blob[0], out_of_range_length) and not UiHandlesPersistence::restore_value(slider, 105))

    UiHandles::reset()
    check("reset invalidates the old root", not UiHandles::is_valid(old_root))
    check("stale handles expose no widget", UiHandles::widget(old_root) == null)
    check("stale queries fail closed", not UiHandles::is_enabled(old_root) and UiHandles::value(old_root) == 0.0 and UiHandles::text_value(old_root) == "")
    stale_child: UiHandles::Handle = UiHandles::button(old_root, 80.0, 24.0, UiCore::rgb(40, 80, 140), UiCore::rgb(60, 100, 160), UiCore::rgb(20, 50, 100))
    check("stale parent is rejected", not UiHandles::is_valid(stale_child) and UiHandles::index(stale_child) == UiFlat::NONE)
    check("stale parent index fails closed", UiHandles::parent_index(old_root) == UiFlat::NONE)
    check("leaf parent index fails closed", UiHandles::parent_index(child) == UiFlat::NONE)

    fresh: UiHandles::Handle = UiHandles::column(UiHandles::root_parent(), 0.0, 0.0, UiCore::rgb(20, 20, 24))
    check("a rebuilt slot gets a fresh lifetime", UiHandles::is_valid(fresh) and fresh.tree_id != old_root.tree_id)
    check("old root stays stale after slot reuse", not UiHandles::is_valid(old_root))
    accessible: UiHandles::Handle = UiHandles::button_accessible(fresh, 80.0, UiCore::rgb(40, 80, 140), UiCore::rgb(60, 100, 160), UiCore::rgb(20, 50, 100), false)
    if UiHandles::widget(accessible) is accessible_widget:
        check("theme-aware button uses touch target token", accessible_widget.min_height == 44.0)
    else:
        check("theme-aware button is inspectable", false)
    accessible_field: UiHandles::Handle = UiHandles::text_field_accessible(fresh, "Name", "required", "", 160.0, 14.0, UiCore::rgb(230, 230, 230), UiCore::rgb(30, 30, 36), false)
    if UiHandles::widget(accessible_field) is accessible_field_widget:
        check("theme-aware text field uses touch target token", accessible_field_widget.min_height == 44.0)
    else:
        check("theme-aware text field is inspectable", false)
    accessible_slider: UiHandles::Handle = UiHandles::slider_accessible(fresh, "Volume", 160.0, 0.5, UiCore::rgb(30, 30, 34), UiCore::rgb(70, 120, 220), UiCore::rgb(240, 240, 250), false)
    if UiHandles::widget(accessible_slider) is accessible_slider_widget:
        check("theme-aware slider uses touch target token", accessible_slider_widget.min_height == 44.0)
    else:
        check("theme-aware slider is inspectable", false)
    accessible_radio: UiHandles::Handle = UiHandles::radio_button_accessible(fresh, 120.0, UiCore::rgb(40, 40, 44), UiCore::rgb(60, 60, 68), UiCore::rgb(80, 80, 90), false)
    accessible_check: UiHandles::Handle = UiHandles::check_box_accessible(fresh, 120.0, UiCore::rgb(40, 40, 44), UiCore::rgb(60, 60, 68), UiCore::rgb(80, 80, 90), false)
    if UiHandles::widget(accessible_radio) is accessible_radio_widget:
        check("theme-aware radio uses touch target token", accessible_radio_widget.min_height == 44.0)
    else:
        check("theme-aware radio is inspectable", false)
    if UiHandles::widget(accessible_check) is accessible_check_widget:
        check("theme-aware checkbox uses touch target token", accessible_check_widget.min_height == 44.0)
    else:
        check("theme-aware checkbox is inspectable", false)
    high_preferences: UiTheme::Preferences = UiTheme::Preferences{mode: UiTheme::ColorMode.System, contrast: UiTheme::Contrast.High, text_scale: 2.0, reduced_motion: false}
    _ = UiTheme::set_preferences(high_preferences)
    high_accessible: UiHandles::Handle = UiHandles::button_accessible(fresh, 120.0, UiCore::rgb(40, 80, 140), UiCore::rgb(60, 100, 160), UiCore::rgb(20, 50, 100), true)
    if UiHandles::widget(high_accessible) is high_accessible_widget:
        check("theme-aware button scales for high contrast text", high_accessible_widget.min_height == 96.0)
    else:
        check("scaled theme-aware button is inspectable", false)
    UiHandles::set_text(old_root, "must not reach rebuilt widget", 12.0, UiCore::rgb(255, 255, 255))
    rebuilt: UiFlat::Widget = UiFlat::widget(0)
    check("stale mutation does not reach rebuilt slot", rebuilt.text == "")

    if failures == 0:
        _ = puts("widget handles: all checks passed")
    return failures.i64()
