# Headless checks for Elisa-owned resource presentation policy.

include "../src/widgets/ui_resource_presentation.elisa"

extern puts(text: cstr) -> i64

global mutable failures: i32 = 0

def app_init() -> void:
    pass

def app_event(event: UiCore::Event) -> void:
    pass

def app_text_input(text: sview) -> void:
    pass

def app_text_editing(text: sview, selected_start: i32, selected_length: i32) -> void:
    pass

def app_frame() -> void:
    pass

def app_widget_event(widget: usize, event: i32) -> void:
    pass

def check(name: cstr, ok: bool) -> void:
    return if ok
    failures <- failures + 1
    _ = puts(name)

def main() -> i64:
    UiResources::reset()
    options: UiResourcePresentation::Options = UiResourcePresentation::default_options(UiResourcePresentation::Kind.Image)
    missing: UiResources::ResourceHandle = UiResources::resource_invalid()
    missing_record: UiResourcePresentation::Record = UiResourcePresentation::record(missing, options)
    check("invalid resource presents a placeholder", missing_record.state == UiResourcePresentation::DisplayState.Placeholder and missing_record.placeholder_visible and not missing_record.fallback_visible)

    requested_record: UiResourcePresentation::Record = UiResourcePresentation::request_image("images/request-helper", 3)
    check("image request helper returns a loading record", UiResources::resource_is_valid(requested_record.handle) and requested_record.kind == UiResourcePresentation::Kind.Image and requested_record.state == UiResourcePresentation::DisplayState.Loading and requested_record.reserved_size.width == 64.0)
    repeated_record: UiResourcePresentation::Record = UiResourcePresentation::request_image("images/request-helper", 8)
    check("image request helper coalesces a live identifier", repeated_record.handle.slot == requested_record.handle.slot and repeated_record.handle.generation == requested_record.handle.generation and UiResources::owner(repeated_record.handle) == 8)
    font_request: UiResourcePresentation::Record = UiResourcePresentation::request_font("fonts/request-helper", 3)
    document_request: UiResourcePresentation::Record = UiResourcePresentation::request_document("documents/request-helper", 3)
    check("typed request helpers choose their presentation policy", font_request.kind == UiResourcePresentation::Kind.Font and not font_request.progress_visible and document_request.kind == UiResourcePresentation::Kind.Document and document_request.reserved_size.width == 320.0)

    image: mutable UiResources::ResourceHandle = UiResources::request("images/preview", 3)
    _ = UiResources::set_intrinsic_size(image, 128.0, 72.0)
    loading: mutable UiResourcePresentation::Record = UiResourcePresentation::record(image, options)
    check("requested resource presents loading", loading.state == UiResourcePresentation::DisplayState.Loading and loading.placeholder_visible and loading.progress_visible)
    intrinsic_options: mutable UiResourcePresentation::Options = options
    intrinsic_options.reserved_width <- 0.0
    intrinsic_options.reserved_height <- 0.0
    intrinsic_loading: UiResourcePresentation::Record = UiResourcePresentation::record(image, intrinsic_options)
    check("presentation uses intrinsic size when reservation is unspecified", intrinsic_loading.reserved_size.width == 128.0 and intrinsic_loading.reserved_size.height == 72.0)
    check("explicit reservation overrides intrinsic size", loading.reserved_size.width == 64.0 and loading.reserved_size.height == 64.0)
    UiResources::set_progress(image, 0.8, 0.25)
    loading <- UiResourcePresentation::record(image, options)
    check("presentation preserves independent progress", loading.network_progress == 0.8 and loading.decode_progress == 0.25 and loading.state == UiResourcePresentation::DisplayState.Loading)
    UiCore::begin_frame()
    UiResourcePresentation::paint(UiCore::Rect(10.0, 20.0, 100.0, 40.0), loading, options)
    check("loading presentation emits placeholder and progress", UiCore::command_count() == 2)
    if UiCore::command_at(1) is UiCore::Command.FillRect(progress_box, progress_color):
        check("progress command follows decoded fraction", progress_box.size.width == 25.0 and progress_box.size.height == 3.0)
    else:
        check("progress command is a rectangle", false)

    UiResources::set_state(image, UiResources::State.Ready)
    ready: UiResourcePresentation::Record = UiResourcePresentation::record(image, options)
    check("ready resource hides fallback and placeholder", ready.state == UiResourcePresentation::DisplayState.Ready and not ready.placeholder_visible and not ready.fallback_visible and ready.interaction_enabled and ready.reserved_size.width == 64.0)
    UiCore::begin_frame()
    UiResourcePresentation::paint(UiCore::Rect(10.0, 20.0, 100.0, 40.0), ready, options)
    check("ready presentation leaves resource painting to the host", UiCore::command_count() == 0)

    UiResources::set_state(image, UiResources::State.Failed)
    failed: UiResourcePresentation::Record = UiResourcePresentation::record(image, options)
    retried_image: UiResources::ResourceHandle = UiResourcePresentation::retry(image)
    check("failed resource exposes typed retry", failed.state == UiResourcePresentation::DisplayState.Failed and failed.failure == UiResources::FailureKind.RetryableTransport and failed.fallback_visible and failed.retry_available and UiResources::resource_is_valid(retried_image) and UiResources::state(retried_image) == UiResources::State.Requested and not UiResources::resource_is_valid(image))
    image <- retried_image
    UiResources::fail(image, UiResources::FailureKind.Corrupt)
    corrupt: UiResourcePresentation::Record = UiResourcePresentation::record(image, options)
    check("corrupt resource has no retry action", corrupt.failure == UiResources::FailureKind.Corrupt and not corrupt.retry_available and not UiResourcePresentation::can_retry(image))
    UiResources::set_state(image, UiResources::State.Denied)
    denied: UiResourcePresentation::Record = UiResourcePresentation::record(image, options)
    check("denied resource uses fallback without prompting by itself", denied.fallback_visible and denied.retry_available)
    UiCore::begin_frame()
    UiResourcePresentation::paint(UiCore::Rect(10.0, 20.0, 100.0, 40.0), denied, options)
    check("fallback presentation emits a filled card and marks", UiCore::command_count() == 3)
    UiResourcePresentation::cancel(image)
    cancelled: UiResourcePresentation::Record = UiResourcePresentation::record(image, options)
    check("cancelled resource stops loading presentation", cancelled.state == UiResourcePresentation::DisplayState.Cancelled and cancelled.fallback_visible and not cancelled.progress_visible)

    font_options: UiResourcePresentation::Options = UiResourcePresentation::default_options(UiResourcePresentation::Kind.Font)
    font: UiResources::ResourceHandle = UiResources::request("fonts/body", 4)
    font_record: UiResourcePresentation::Record = UiResourcePresentation::record(font, font_options)
    check("font policy avoids artificial progress and geometry", not font_record.progress_visible and font_record.reserved_size.width == 0.0 and font_record.reserved_size.height == 0.0)

    invalid_options: mutable UiResourcePresentation::Options = options
    invalid_options.reserved_width <- -100.0
    invalid_options.reserved_height <- UiCore::MAX_GEOMETRY_EXTENT + 1.0
    invalid_record: UiResourcePresentation::Record = UiResourcePresentation::record(image, invalid_options)
    check("resource reservation rejects negative and oversized extents", invalid_record.reserved_size.width == 0.0 and invalid_record.reserved_size.height == UiCore::MAX_GEOMETRY_EXTENT)
    UiCore::begin_frame()
    UiResourcePresentation::paint(UiCore::Rect{origin: UiCore::Vec2{x: 10.0, y: 20.0}, size: UiCore::Size{width: -4.0, height: UiCore::MAX_GEOMETRY_EXTENT + 1.0}}, loading, invalid_options)
    if UiCore::command_at(0) is UiCore::Command.FillRect(painted_box, painted_color):
        check("resource paint normalizes direct rectangle geometry", painted_box.origin.x == 10.0 and painted_box.origin.y == 20.0 and painted_box.size.width == 0.0 and painted_box.size.height == UiCore::MAX_GEOMETRY_EXTENT)
    else:
        check("resource paint emits a normalized rectangle", false)
    if failures == 0:
        _ = puts("resource presentation: all checks passed")
    return failures.i64()
