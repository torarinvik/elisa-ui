# Included by the UIKit host fixture: two separately captured targets must
# receive their own contact identity when one lifecycle fact cancels both.
def check_gesture_lifecycle_contacts(x: f32, y: f32) -> void:
    _ = UiHandles::set_gesture_target(UiKitTestApp::button(), true)
    _ = UiHandles::set_gesture_target(UiKitTestApp::field(), true)
    field_index: usize = UiHandles::index(UiKitTestApp::field())
    field_x: f32 = UiFlat::widget(field_index).x + 4.0
    field_y: f32 = UiFlat::widget(field_index).y + 4.0
    UiHandles::handle(UiCore::ContactEvent.Update(UiCore::Contact{id: 100, phase: UiCore::ContactPhase.Began, tool: UiCore::ContactTool.Finger, at: UiCore::Vec2(x, y), timestamp: 8.0}))
    UiHandles::handle(UiCore::ContactEvent.Update(UiCore::Contact{id: 200, phase: UiCore::ContactPhase.Began, tool: UiCore::ContactTool.Stylus, at: UiCore::Vec2(field_x, field_y), timestamp: 8.0}))
    gesture_lifecycle_id_sum <- 0
    gesture_lifecycle_collect <- true
    cancelled_before: i32 = widget_gesture_cancelled
    UiHandles::handle(UiCore::Event.FocusLost)
    gesture_lifecycle_collect <- false
    check("lifecycle cancellation reports each captured identity", widget_gesture_cancelled == cancelled_before + 2 and gesture_lifecycle_id_sum == 300 and UiGestures::active_count() == 0)
    _ = uikit_lifecycle(UiUIKit::view_handle(), 0)
    _ = UiHandles::set_gesture_target(UiKitTestApp::button(), false)
    _ = UiHandles::set_gesture_target(UiKitTestApp::field(), false)
    _ = UiHandles::request_focus(UiKitTestApp::field())
    UiFlat::set_secure(field_index, true)
    check("UIKit secure keyboard trait follows focused retained field", uikit_text_is_secure(UiUIKit::view_handle()) == 1 and not UiFlat::allows_text_readback())
    UiFlat::set_secure(field_index, false)
    check("UIKit nonsecure keyboard trait is restored", uikit_text_is_secure(UiUIKit::view_handle()) == 0)
    UiHandles::clear_focus()
    check("UIKit secure keyboard trait clears without editable focus", uikit_text_is_secure(UiUIKit::view_handle()) == 0)

extern elisa_uikit_stub_keyboard_reload_count() -> i32

def check_keyboard_privacy_refresh() -> void can[Ui.Draw, Ui.Text, Ui.Input, Ui.Window, Unsafe.PointerCast]:
    UiUIKit::release_canvas()
    UiMobileSurface::reset()
    check("keyboard privacy fixture attaches native view", UiUIKit::attach_surface(42, 393.0, 852.0, 3.0, 0.0, 0.0, 0.0, 0.0))
    _ = UiMobileSurface::focus_gained()
    _ = UiHandles::request_focus(UiKitTestApp::field())
    uikit_flat_sync_keyboard()
    check("privacy fixture activates keyboard", UiUIKit::text_input_is_active())
    baseline: i32 = elisa_uikit_stub_keyboard_reload_count()
    field_index: usize = UiHandles::index(UiKitTestApp::field())
    UiFlat::set_secure(field_index, true)
    uikit_flat_sync_keyboard()
    check("secure transition refreshes active native keyboard", elisa_uikit_stub_keyboard_reload_count() == baseline + 1)
    uikit_flat_sync_keyboard()
    check("unchanged privacy does not repeatedly reload keyboard", elisa_uikit_stub_keyboard_reload_count() == baseline + 1)
    UiFlat::set_secure(field_index, false)
    uikit_flat_sync_keyboard()
    check("normal transition refreshes active native keyboard", elisa_uikit_stub_keyboard_reload_count() == baseline + 2)
    check("retained email purpose is accepted", UiHandles::set_text_purpose(UiKitTestApp::field(), UiTextInput::Purpose.Email))
    uikit_flat_sync_keyboard()
    check("email purpose reaches native query and refresh", uikit_text_purpose(42) == 2 and elisa_uikit_stub_keyboard_reload_count() == baseline + 3)
    _ = UiHandles::set_text_purpose(UiKitTestApp::field(), UiTextInput::Purpose.Number)
    uikit_flat_sync_keyboard()
    check("number purpose reaches native query and refresh", uikit_text_purpose(42) == 4 and elisa_uikit_stub_keyboard_reload_count() == baseline + 4)
    _ = UiHandles::set_text_purpose(UiKitTestApp::field(), UiTextInput::Purpose.Password)
    uikit_flat_sync_keyboard()
    check("password purpose hardens retained and native privacy", uikit_text_is_secure(42) == 1 and not UiFlat::allows_text_readback() and elisa_uikit_stub_keyboard_reload_count() == baseline + 5)
    check("purpose rejects nontext and invalid targets", not UiHandles::set_text_purpose(UiKitTestApp::button(), UiTextInput::Purpose.Email) and not UiHandles::set_text_purpose(UiHandles::invalid(), UiTextInput::Purpose.Email))
    UiFlat::set_secure(field_index, false)
    uikit_flat_sync_keyboard()
    _ = UiHandles::set_text_purpose(UiKitTestApp::field(), UiTextInput::Purpose.Url)
    uikit_flat_sync_keyboard()
    check("URL purpose reaches active native keyboard boundary", uikit_text_purpose(42) == 3 and elisa_uikit_stub_keyboard_reload_count() == baseline + 7)
    _ = UiHandles::set_text_purpose(UiKitTestApp::field(), UiTextInput::Purpose.Search)
    uikit_flat_sync_keyboard()
    check("search purpose reaches active native keyboard boundary", uikit_text_purpose(42) == 5 and elisa_uikit_stub_keyboard_reload_count() == baseline + 8)
    UiHandles::clear_focus()
    uikit_flat_sync_keyboard()
    check("blur retires native keyboard without extra reload", not UiUIKit::text_input_is_active() and elisa_uikit_stub_keyboard_reload_count() == baseline + 8)
    UiUIKit::release_canvas()
