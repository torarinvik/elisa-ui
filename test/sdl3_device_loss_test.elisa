# Verify SDL3 render device-reset/loss recovery through the real event queue and
# dummy video driver; this stays headless and never foregrounds a window.
#
# The events carry no window id, so this is also a regression for handling them
# before the window-ownership filter that would otherwise drop them.

include "../src/platform/sdl3/ui_sdl3.elisa"

extern SDL_setenv_unsafe(name: cstr, value: cstr, overwrite: i32) -> i32
extern SDL_PushEvent(event: void&) -> bool
extern puts(text: cstr) -> i64

global mutable failures: i32 = 0
global mutable frames_seen: i32 = 0
global mutable preserved_marker: i32 = 0

def push_render_event(kind: i32) -> void:
    event: mutable u64[16] = zeroed
    fields: mutable i32& = (&event[0]).cast[mutable i32&] can Unsafe.PointerCast
    fields[0] <- kind
    pointer: void& = (&event[0]).cast[void&] can Unsafe.PointerCast
    if not SDL_PushEvent(pointer):
        failures <- failures + 1

def app_init() -> void:
    preserved_marker <- 41
    push_render_event(0x2000)
    push_render_event(0x2001)
    push_render_event(0x2002)

def app_event(event: UiCore::Event) -> void:
    pass

def app_text_input(text: sview) -> void:
    pass

def app_text_editing(text: sview, selected_start: i32, selected_length: i32) -> void:
    pass

def app_frame() -> void:
    frames_seen <- frames_seen + 1
    failures <- failures + 1 if not UiLifecycle::is_started()

def main() -> i64:
    _ = SDL_setenv_unsafe("SDL_VIDEODRIVER", "dummy", 1)
    result: i64 = UiSdl3::run("headless device-loss regression", 64, 64, 3)
    if result != 0 or frames_seen < 3:
        failures <- failures + 1
    if preserved_marker != 41:
        failures <- failures + 1
    if failures == 0:
        _ = puts("SDL device-loss recovery: passed")
    return failures.i64()
