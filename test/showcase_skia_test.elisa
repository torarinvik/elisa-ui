# Real-Skia acceptance of the shipped hello showcase.
#
# The host owns only an off-screen SkSurface and a borrowed typeface. This
# fixture drives the same public app callbacks as a window host, then asks
# Elisa to build and replay the final retained frame into that surface.

include "../src/platform/skia/ui_skia.elisa"
include "../examples/hello/app.elisa"

global mutable showcase_ready: bool = false
global mutable workflow_failures: i32 = 0
global mutable deferred_probe_count: i32 = 0
global mutable deferred_probe_x: i32 = 0
global mutable deferred_probe_y: i32 = 0
global mutable resource_probe_count: i32 = 0
global mutable resource_probe_x: i32 = 0
global mutable resource_probe_y: i32 = 0
global mutable resource_generation_before: u32 = 0
global mutable resource_generation_after: u32 = 0
global mutable resource_image: usize = 0
global mutable resource_replacement_done: bool = false

const RESOURCE_PLACEHOLDER: UiCore::Color = UiCore::Color{r: 49, g: 56, b: 72, a: 255}

def ui_measure_text_width(text: sview, size: f32) -> f32:
    return UiSkia::measure_text_width(text, size)

def ui_measure_text_height(text: sview, size: f32) -> f32:
    return UiSkia::text_line_height(size)

def ui_font_ascent(size: f32) -> f32:
    return UiSkia::font_ascent(size)

def ui_text_line_height(size: f32) -> f32:
    return UiSkia::text_line_height(size)

def ui_clipboard_has_text() -> bool:
    return false

def ui_clipboard_write(bytes: u8&, length: usize) -> bool:
    return false

def ui_clipboard_read(buffer: mutable u8&, capacity: usize) -> usize:
    return 0

def ensure_showcase() -> void:
    return if showcase_ready
    UiCapabilities::use_appkit_canvas()
    UiCore::set_viewport(800.0, 680.0)
    app_init()
    showcase_ready <- true

def check_workflow(ok: bool) -> void:
    workflow_failures <- workflow_failures + 1 if not ok

def widget_with_kind(kind: UiConst::WidgetKind) -> UiHandles::Handle:
    for index in 0..<UiHandles::count():
        handle: UiHandles::Handle = UiHandles::from_index(index)
        if UiHandles::widget(handle) is row:
            return handle if row.kind == kind
    return UiHandles::invalid()

def has_widget_text(expected: sview) -> bool:
    for index in 0..<UiHandles::count():
        handle: UiHandles::Handle = UiHandles::from_index(index)
        if UiHandles::widget(handle) is row:
            return true if row.text == expected
    return false

def custom_art_command_count() -> i32:
    count: mutable i32 = 0
    for index in 0..<UiCore::command_count():
        match UiCore::command_at(index):
            UiCore::Command.FillLine(segment, color):
                count <- count + 1 if color.a > 0
            UiCore::Command.FillCircle(disc, color):
                count <- count + 1 if color.a > 0
            UiCore::Command.FillTriangle(tri, color):
                count <- count + 1 if color.a > 0
            _:
                pass
    return count

def build_headless_frame() -> void:
    UiCore::begin_frame()
    app_frame()

# Exercise the public deferred painter from application code. The three
# records deliberately straddle a retained command: replay must produce the
# first deferred badge, the retained divider, then the second deferred badge.
# Geometry comes from the live retained content card, so this is a layout
# workflow rather than a fixed-coordinate renderer test.
def queue_deferred_layout_probe() -> void can[Ui.Draw]:
    deferred_probe_count <- 0
    if UiHandles::widget(HelloApp::content_handle()) is card:
        probe_width: mutable f32 = 112.0 if card.width > 180.0 else card.width * 0.55
        probe_width <- 36.0 if probe_width < 36.0
        probe_x: f32 = card.x + card.width - probe_width - 36.0
        probe_y: f32 = card.y + card.height - 58.0
        deferred_probe_x <- probe_x.i32()
        deferred_probe_y <- probe_y.i32()
        first: UiCore::Rect = UiCore::Rect(probe_x, probe_y, 32.0, 18.0)
        accepted_first: bool = UiSkia::defer_fill_rounded_rect(first, 4.0, UiCore::rgb(250, 140, 40))
        # This retained divider overlaps the first deferred badge. The final
        # circle overlaps the divider, making replay order observable in the
        # raster rather than only in a recorder.
        UiCore::fill(UiCore::Rect(probe_x + 8.0, probe_y, 64.0, 18.0), UiCore::rgb(80, 200, 220))
        accepted_second: bool = UiSkia::defer_fill_circle(
            UiCore::Circle{center: UiCore::Vec2(probe_x + 56.0, probe_y + 9.0), radius: 9.0},
            UiCore::rgb(236, 100, 210))
        deferred_probe_count <- 1 if accepted_first
        deferred_probe_count <- deferred_probe_count + 1 if accepted_second

# Bind and replay a host-decoded image through the public resource identity.
# The first frame queues the old generation, inserts a retained placeholder,
# rotates the logical resource, and queues the replacement generation. Replay
# must skip the stale command and paint only the replacement image.
def queue_deferred_resource_probe() -> void can[Ui.Draw]:
    return if resource_image == 0
    if UiHandles::widget(HelloApp::content_handle()) is card:
        box_width: f32 = 56.0
        gap: f32 = 8.0
        probe_x: f32 = card.x + card.width - box_width * 2.0 - gap - 36.0
        probe_y: f32 = card.y + card.height - 64.0
        resource_probe_x <- probe_x.i32()
        resource_probe_y <- probe_y.i32()
        old_box: UiCore::Rect = UiCore::Rect(probe_x, probe_y, box_width, 32.0)
        new_box: UiCore::Rect = UiCore::Rect(probe_x + box_width + gap, probe_y, box_width, 32.0)
        # These retained fills make the stale-generation result observable
        # independently of whatever artwork happens to be behind the probe.
        UiCore::fill(old_box, RESOURCE_PLACEHOLDER)
        UiCore::fill(new_box, UiCore::rgb(42, 50, 64))
        if not resource_replacement_done:
            old_resource: UiResources::ResourceHandle = HelloResourceDemo::renderer_resource()
            resource_generation_before <- old_resource.generation
            accepted_old: bool = UiSkia::defer_bound_image_fitted_intrinsic_rounded(
                old_resource, old_box, 255, UiSkia::ImageFit.Contain, 6.0)
            replacement: UiResources::ResourceHandle = HelloResourceDemo::renderer_replace_ready()
            if UiResources::resource_is_valid(replacement):
                resource_generation_after <- replacement.generation
                _ = UiSkia::bind_image(replacement, resource_image)
                accepted_new: bool = UiSkia::defer_bound_image_fitted_intrinsic_rounded(
                    replacement, new_box, 255, UiSkia::ImageFit.Contain, 6.0)
                resource_probe_count <- 1 if accepted_old
                resource_probe_count <- resource_probe_count + 1 if accepted_new
                resource_replacement_done <- true
        else:
            current: UiResources::ResourceHandle = HelloResourceDemo::renderer_resource()
            resource_probe_count <- 1 if UiSkia::defer_bound_image_fitted_intrinsic_rounded(
                current, new_box, 255, UiSkia::ImageFit.Contain, 6.0)

def prepare_public_workflow() -> i32:
    ensure_showcase()
    workflow_failures <- 0
    build_headless_frame()
    check_workflow(UiHandles::count() > 20 and UiCore::command_count() > 20)
    check_workflow(custom_art_command_count() >= 6)
    check_workflow(UiCore::accessibility_count() > 10)

    field: UiHandles::Handle = widget_with_kind(UiConst::WidgetKind.TextField)
    check_workflow(UiHandles::is_valid(field))
    if UiHandles::widget(field) is field_row:
        centre: UiCore::Vec2 = UiCore::Vec2(field_row.x + field_row.width / 2.0, field_row.y + field_row.height / 2.0)
        app_event(UiCore::PointerEvent.Down(centre, UiCore::PointerButton.Primary.i32()))
        app_event(UiCore::PointerEvent.Up(centre, UiCore::PointerButton.Primary.i32()))
        check_workflow(UiHandles::is_focused(field))
        app_text_input(" • café 👋")
        check_workflow(UiHandles::text_value(field) == "Canvas study • café 👋")
        app_text_editing("候補", 0, 1)
        check_workflow(UiHandles::marked_length(field) > 0)
        app_text_input("候")
        check_workflow(UiHandles::text_value(field) == "Canvas study • café 👋候補")

    # Exercise application state transitions before the frame that is replayed
    # into Skia. In particular, Y must replace the failed resource generation,
    # not merely repaint a stale status string.
    app_event(UiCore::KeyEvent.Down(UiCore::Key.Digit1))
    app_event(UiCore::KeyEvent.Down(UiCore::Key.T))
    app_event(UiCore::KeyEvent.Down(UiCore::Key.P))
    app_event(UiCore::KeyEvent.Down(UiCore::Key.R))
    app_event(UiCore::KeyEvent.Down(UiCore::Key.F))
    check_workflow(has_widget_text("Preview failed — retry or keep working offline."))
    app_event(UiCore::KeyEvent.Down(UiCore::Key.Y))
    check_workflow(has_widget_text("Optional preview loading…"))
    build_headless_frame()
    check_workflow(UiCore::command_count() > 20 and UiCore::accessibility_count() > 10)
    return workflow_failures

def showcase_skia_render(canvas: usize, font: usize) -> i32 can[Ui.Draw, Ui.Text]:
    ensure_showcase()
    UiSkia::begin_deferred_frame()
    # The real AppKit/Skia host brackets app_frame before borrowing its
    # canvas. Keep that order here so any showcase control using a deferred
    # Skia primitive is captured and replayed rather than silently dropped.
    build_headless_frame()
    if canvas == 0:
        UiSkia::end_deferred_frame()
        return UiSkia::RenderStatus.SkippedNoSurface.i32()
    queue_deferred_layout_probe()
    queue_deferred_resource_probe()
    UiSkia::attach(canvas)
    status: UiSkia::RenderStatus = UiSkia::render_status_with_font(font)
    UiSkia::detach()
    UiSkia::end_deferred_frame()
    return status.i32()

def showcase_command_count() -> i32:
    return UiCore::command_count().i32()

def showcase_semantic_count() -> i32:
    return UiCore::accessibility_count().i32()

def showcase_art_count() -> i32:
    return custom_art_command_count()

def showcase_deferred_count() -> i32:
    return deferred_probe_count

def showcase_probe_x() -> i32:
    return deferred_probe_x

def showcase_probe_y() -> i32:
    return deferred_probe_y

def showcase_bind_resource_image(image: usize) -> i32:
    ensure_showcase()
    return 0 if image == 0
    return 0 if not HelloResourceDemo::renderer_mark_ready()
    resource_image <- image
    return 1 if UiSkia::bind_image(HelloResourceDemo::renderer_resource(), image)
    return 0

def showcase_resource_probe_count() -> i32:
    return resource_probe_count

def showcase_resource_probe_x() -> i32:
    return resource_probe_x

def showcase_resource_probe_y() -> i32:
    return resource_probe_y

def showcase_resource_generation_before() -> i32:
    return resource_generation_before.i32()

def showcase_resource_generation_after() -> i32:
    return resource_generation_after.i32()

export fn elisa_showcase_skia_prepare() -> i32 = prepare_public_workflow
export fn elisa_showcase_skia_render(canvas: usize, font: usize) -> i32 = showcase_skia_render
export fn elisa_showcase_skia_command_count() -> i32 = showcase_command_count
export fn elisa_showcase_skia_semantic_count() -> i32 = showcase_semantic_count
export fn elisa_showcase_skia_art_count() -> i32 = showcase_art_count
export fn elisa_showcase_skia_deferred_count() -> i32 = showcase_deferred_count
export fn elisa_showcase_skia_probe_x() -> i32 = showcase_probe_x
export fn elisa_showcase_skia_probe_y() -> i32 = showcase_probe_y
export fn elisa_showcase_skia_bind_resource_image(image: usize) -> i32 = showcase_bind_resource_image
export fn elisa_showcase_skia_resource_probe_count() -> i32 = showcase_resource_probe_count
export fn elisa_showcase_skia_resource_probe_x() -> i32 = showcase_resource_probe_x
export fn elisa_showcase_skia_resource_probe_y() -> i32 = showcase_resource_probe_y
export fn elisa_showcase_skia_resource_generation_before() -> i32 = showcase_resource_generation_before
export fn elisa_showcase_skia_resource_generation_after() -> i32 = showcase_resource_generation_after
