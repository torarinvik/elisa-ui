# Headless variable-height virtualization policy.
#
# Measured rows are sparse and bounded; all unknown rows use an estimate. The
# test deliberately addresses a million-item tail so the policy cannot hide
# an O(item_count) prefix scan or a f32 global-pixel overflow.

include "../src/widgets/ui_virtual_list.elisa"

extern puts(text: cstr) -> i64
global mutable failures: i32 = 0

def check(name: cstr, ok: bool) -> void:
    return if ok
    failures <- failures + 1
    _ = puts(name)

def main() -> i64:
    owner: u32 = 41
    check("variable list registers", UiVirtualList::variable_init(owner, 1000000, 32.0, 4.0))
    check("variable list keeps its bounded total", UiVirtualList::variable_content_extent(owner) > 35999900.0)
    check("unknown rows use the estimate", UiVirtualList::variable_height(owner, 100) == 32.0)

    check("first measured row changes its height", UiVirtualList::variable_set_height(owner, 0, 48.0))
    check("second measured row changes its height", UiVirtualList::variable_set_height(owner, 2, 96.0))
    check("tail measurement is accepted", UiVirtualList::variable_set_height(owner, 900000, 64.0))
    check("measurement count is sparse", UiVirtualList::variable_measurement_count(owner) == 3)
    check("measured height is returned", UiVirtualList::variable_height(owner, 2) == 96.0)
    check("prefix includes sparse measured corrections", UiVirtualList::variable_offset(owner, 2) == 72.0 + 16.0)
    check("later prefix includes all earlier corrections", UiVirtualList::variable_offset(owner, 3) == 108.0 + 16.0 + 64.0)
    check("tail prefix remains finite", UiVirtualList::variable_offset(owner, 900001) > 0.0)

    check("offset hit testing finds the first measured row", UiVirtualList::variable_item_at_offset(owner, 10.0) == 0)
    check("offset hit testing finds the following row", UiVirtualList::variable_item_at_offset(owner, 55.0) == 1)
    check("offset hit testing reaches the million-item tail", UiVirtualList::variable_item_at_offset(owner, UiVirtualList::variable_offset(owner, 900000) + 1.0) == 900000)

    window: UiVirtualList::VariableWindow = UiVirtualList::variable_window(owner, UiVirtualList::variable_offset(owner, 900000), 120.0, 8)
    check("tail window starts at its logical row", window.first == 900000)
    check("tail window is bounded", window.finish > window.first and window.finish - window.first <= 8)
    position: UiVirtualList::VariableItemPosition = UiVirtualList::variable_item_position(owner, window.first, window)
    check("first tail row is placed at the viewport origin", position.valid and position.top == 0.0)
    outside: UiVirtualList::VariableItemPosition = UiVirtualList::variable_item_position(owner, window.finish, window)
    check("rows outside the retained window are rejected", not outside.valid)

    moved: f32 = UiVirtualList::variable_scroll_by(owner, 0.0, 500.0, 120.0)
    check("scrolling remains bounded", moved == 500.0)
    check("scroll fraction is normalized", UiVirtualList::variable_scroll_fraction(owner, moved, 120.0) > 0.0 and UiVirtualList::variable_scroll_fraction(owner, moved, 120.0) < 1.0)
    tail_scroll: f32 = UiVirtualList::variable_scroll_by(owner, 0.0, 999999999.0, 120.0)
    check("oversized scroll reaches the normalized tail", UiVirtualList::variable_scroll_fraction(owner, tail_scroll, 120.0) == 1.0)

    check("setting the same measurement is idempotent", not UiVirtualList::variable_set_height(owner, 2, 96.0))
    check("measurement clear removes one sparse override", UiVirtualList::variable_clear_height(owner, 2) and UiVirtualList::variable_measurement_count(owner) == 2 and UiVirtualList::variable_height(owner, 2) == 32.0)
    check("measurement clear rejects a second removal", not UiVirtualList::variable_clear_height(owner, 2))
    check("measurement can be repopulated after clear", UiVirtualList::variable_set_height(owner, 2, 96.0) and UiVirtualList::variable_measurement_count(owner) == 3)
    check("shrinking the collection prunes removed measurements", UiVirtualList::variable_set_item_count(owner, 1) and UiVirtualList::variable_measurement_count(owner) == 1 and UiVirtualList::variable_content_extent(owner) == 48.0)
    check("count changes are bounded", UiVirtualList::variable_set_item_count(owner, 0) and UiVirtualList::variable_content_extent(owner) == 0.0)
    check("release clears the owner", UiVirtualList::variable_release(owner) and UiVirtualList::variable_content_extent(owner) == 0.0)
    check("released owner rejects new measurements", not UiVirtualList::variable_set_height(owner, 0, 20.0))

    eviction_owner: u32 = 42
    check("eviction list registers", UiVirtualList::variable_init(eviction_owner, 2000, 20.0, 0.0))
    for index in 0..<UiVirtualList::MAX_VARIABLE_MEASUREMENTS:
        check("bounded cache accepts initial measurements", UiVirtualList::variable_set_height(eviction_owner, index.i32(), 20.0 + index.f32()))
    check("bounded cache reaches its fixed capacity", UiVirtualList::variable_measurement_count(eviction_owner) == UiVirtualList::MAX_VARIABLE_MEASUREMENTS)
    check("refreshing a measurement keeps it hot", UiVirtualList::variable_set_height(eviction_owner, 0, 99.0))
    check("least recently updated entry is evicted", UiVirtualList::variable_set_height(eviction_owner, 1500, 55.0) and UiVirtualList::variable_measurement_known(eviction_owner, 0) and not UiVirtualList::variable_measurement_known(eviction_owner, 1) and UiVirtualList::variable_measurement_known(eviction_owner, 1500))

    snapshot_bytes: mutable u8[UiVirtualList::MAX_VARIABLE_MEASUREMENT_SNAPSHOT_BYTES] = zeroed
    required: usize = UiVirtualList::variable_measurement_snapshot_size(eviction_owner)
    short_snapshot: UiVirtualList::MeasurementSnapshot = UiVirtualList::variable_measurement_snapshot(eviction_owner, &snapshot_bytes[0], required - 1)
    check("measurement snapshot reports short destinations", short_snapshot.overflowed and short_snapshot.length == required and not short_snapshot.valid)
    snapshot: UiVirtualList::MeasurementSnapshot = UiVirtualList::variable_measurement_snapshot(eviction_owner, &snapshot_bytes[0], UiVirtualList::MAX_VARIABLE_MEASUREMENT_SNAPSHOT_BYTES)
    check("measurement snapshot is versioned and complete", snapshot.valid and snapshot.records == UiVirtualList::MAX_VARIABLE_MEASUREMENTS and snapshot.length == required)
    truncated: UiVirtualList::MeasurementSnapshot = UiVirtualList::variable_restore_measurements(eviction_owner, &snapshot_bytes[0], snapshot.length - 1)
    check("truncated measurement snapshot is rejected atomically", not truncated.valid and UiVirtualList::variable_measurement_count(eviction_owner) == snapshot.records)
    restored: UiVirtualList::MeasurementSnapshot = UiVirtualList::variable_restore_measurements(eviction_owner, &snapshot_bytes[0], snapshot.length)
    check("measurement snapshot restores through the public policy", restored.valid and restored.records == snapshot.records and UiVirtualList::variable_height(eviction_owner, 0) == 99.0 and UiVirtualList::variable_height(eviction_owner, 1500) == 55.0)

    if failures == 0:
        _ = puts("variable virtual list: all checks passed")
        return 0
    _ = puts("variable virtual list: FAILURES above")
    return 1
