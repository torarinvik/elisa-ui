# Headless regression for responsive layout policy. No native backend is
# involved: logical space is classified and arranged entirely in Elisa.

include "../src/widgets/ui_responsive.elisa"

extern puts(text: cstr) -> i64
global mutable failures: i32 = 0

def check(name: cstr, ok: bool) -> void:
    return if ok
    failures <- failures + 1
    _ = puts(name)

def main() -> i64:
    defaults: UiResponsive::Breakpoints = UiResponsive::defaults()
    check("default compact breakpoint", UiResponsive::classify(599.0, defaults) == UiResponsive::SizeClass.Compact)
    check("default medium breakpoint", UiResponsive::classify(600.0, defaults) == UiResponsive::SizeClass.Medium)
    check("default expanded breakpoint", UiResponsive::classify(1024.0, defaults) == UiResponsive::SizeClass.Expanded)

    custom: UiResponsive::Breakpoints = UiResponsive::Breakpoints{compact_max: 400.0, medium_max: 800.0}
    check("custom compact breakpoint", UiResponsive::classify(400.0, custom) == UiResponsive::SizeClass.Compact)
    check("custom medium breakpoint", UiResponsive::classify(401.0, custom) == UiResponsive::SizeClass.Medium)
    check("custom expanded breakpoint", UiResponsive::classify(801.0, custom) == UiResponsive::SizeClass.Expanded)
    check("compact helper", UiResponsive::is_compact(400.0, custom) and not UiResponsive::is_compact(401.0, custom))

    malformed: UiResponsive::Breakpoints = UiResponsive::Breakpoints{compact_max: 900.0, medium_max: 100.0}
    check("breakpoints stay ordered", UiResponsive::classify(899.0, malformed) == UiResponsive::SizeClass.Compact)
    check("negative width is compact", UiResponsive::classify(-20.0, defaults) == UiResponsive::SizeClass.Compact)
    huge: f32 = 3.0e38
    bounded_points: UiResponsive::Breakpoints = UiResponsive::normalize_breakpoints(UiResponsive::Breakpoints{compact_max: huge, medium_max: huge})
    check("breakpoint extents stay bounded", bounded_points.compact_max == UiCore::MAX_GEOMETRY_EXTENT and bounded_points.medium_max == UiCore::MAX_GEOMETRY_EXTENT)

    check("adaptive compact axis", UiResponsive::axis(300.0, defaults, UiConst::Axis.Column, UiConst::Axis.Row, UiConst::Axis.Row) == UiConst::Axis.Column)
    check("adaptive medium axis", UiResponsive::axis(800.0, defaults, UiConst::Axis.Column, UiConst::Axis.Row, UiConst::Axis.Column) == UiConst::Axis.Row)
    check("adaptive expanded axis", UiResponsive::axis(1200.0, defaults, UiConst::Axis.Column, UiConst::Axis.Row, UiConst::Axis.Column) == UiConst::Axis.Column)
    invalid_axis: UiConst::Axis = (-1).i32().Axis()
    check("adaptive axis normalizes unknown ordinals", UiResponsive::axis(300.0, defaults, invalid_axis, invalid_axis, invalid_axis) == UiConst::Axis.Column)

    check("two columns fit", UiResponsive::columns(500.0, 160.0, 16.0, 4) == 2)
    check("columns honor cap", UiResponsive::columns(1200.0, 160.0, 16.0, 4) == 4)
    check("narrow space keeps one", UiResponsive::columns(100.0, 160.0, 16.0, 4) == 1)
    check("zero item uses cap", UiResponsive::columns(500.0, 0.0, 16.0, 3) == 3)
    check("invalid cap keeps one", UiResponsive::columns(500.0, 160.0, 16.0, 0) == 1)
    check("overflowed column math stays bounded", UiResponsive::columns(huge, huge, huge, 4) >= 1 and UiResponsive::columns(huge, huge, huge, 4) <= 4)
    tiny_item: f32 = 1.0e-38
    check("tiny item ratio still honors cap", UiResponsive::columns(huge, tiny_item, 0.0, 4) == 4)

    view: UiResponsive::Viewport = UiResponsive::viewport(800.0, 600.0, 2.0)
    check("viewport dimensions normalize", view.width == 800.0 and view.height == 600.0 and view.scale == 2.0)
    bounded_view: UiResponsive::Viewport = UiResponsive::viewport(huge, huge, huge)
    check("viewport dimensions stay bounded", bounded_view.width == UiCore::MAX_GEOMETRY_EXTENT and bounded_view.height == UiCore::MAX_GEOMETRY_EXTENT and bounded_view.scale == UiCore::MAX_GEOMETRY_EXTENT)
    check("landscape orientation is framework-owned", UiResponsive::orientation(view) == UiResponsive::Orientation.Landscape)
    portrait: UiResponsive::Viewport = UiResponsive::viewport(400.0, 800.0, 3.0)
    check("portrait orientation is framework-owned", UiResponsive::orientation(portrait) == UiResponsive::Orientation.Portrait)
    square: UiResponsive::Viewport = UiResponsive::viewport(500.0, 500.0, 1.0)
    check("square orientation is explicit", UiResponsive::orientation(square) == UiResponsive::Orientation.Square)
    raw_hostile_view: UiResponsive::Viewport = UiResponsive::Viewport{width: huge, height: -20.0, scale: 0.0}
    check("raw viewport orientation is normalized", UiResponsive::orientation(raw_hostile_view) == UiResponsive::Orientation.Landscape)
    safe: UiResponsive::Insets = UiResponsive::insets(24.0, 8.0, 16.0, 12.0)
    bounded_safe: UiResponsive::Insets = UiResponsive::insets(huge, huge, huge, huge)
    check("safe-area edges stay bounded", bounded_safe.top == UiCore::MAX_GEOMETRY_EXTENT and bounded_safe.right == UiCore::MAX_GEOMETRY_EXTENT and bounded_safe.bottom == UiCore::MAX_GEOMETRY_EXTENT and bounded_safe.left == UiCore::MAX_GEOMETRY_EXTENT)
    content: UiResponsive::ContentArea = UiResponsive::content_area(view, safe)
    check("safe area offsets content origin", content.origin.x == 12.0 and content.origin.y == 24.0)
    check("safe area reserves logical content", content.size.width == 780.0 and content.size.height == 560.0 and content.scale == 2.0)
    malformed_safe: UiResponsive::ContentArea = UiResponsive::content_area(UiResponsive::viewport(20.0, 20.0, 1.0), UiResponsive::insets(40.0, 40.0, 40.0, 40.0))
    check("oversized safe area clamps content", malformed_safe.size.width == 0.0 and malformed_safe.size.height == 0.0)
    keyboard: UiResponsive::ContentArea = UiResponsive::content_area_with_keyboard(view, safe, UiResponsive::keyboard_insets(240.0, true))
    check("visible keyboard reserves the larger bottom occlusion", keyboard.origin.y == 24.0 and keyboard.size.height == 336.0)
    hidden_keyboard: UiResponsive::ContentArea = UiResponsive::content_area_with_keyboard(view, safe, UiResponsive::keyboard_insets(240.0, false))
    check("hidden keyboard restores safe-area content", hidden_keyboard.size.height == content.size.height)
    contained_keyboard: UiResponsive::ContentArea = UiResponsive::content_area_with_keyboard(view, safe, UiResponsive::keyboard_insets(8.0, true))
    check("keyboard never double-counts safe bottom", contained_keyboard.size.height == content.size.height)
    check("physical target respects scale", UiResponsive::physical_extent(20.0, 2.0, 44.0) == 22.0)
    check("logical target wins", UiResponsive::physical_extent(30.0, 2.0, 44.0) == 30.0)
    check("zero scale is deterministic", UiResponsive::physical_extent(20.0, 0.0, 44.0) == 44.0)
    tiny_scale: f32 = 1.0e-38
    check("overflowed physical target stays finite", UiResponsive::physical_extent(20.0, tiny_scale, 44.0) == 20.0)
    check("physical target stays bounded", UiResponsive::physical_extent(huge, 1.0, huge) == UiCore::MAX_GEOMETRY_EXTENT)

    if failures == 0:
        _ = puts("responsive: all checks passed")
        return 0
    _ = puts("responsive: FAILURES above")
    return 1
