# Text editing, UTF-8 validation, IME, selection, clipboard, and history checks.

include "./widget_layout_support.elisa"

def main() -> i64:
    UiFlat::reset()
    base_theme: UiFlat::Theme = UiFlat::theme()
    field: usize = UiFlat::text_field(UiFlat::NONE, "Project name", "Type a name", "Hi", 220.0, 36.0, 15.0, UiCore::rgb(240, 240, 245), UiCore::rgb(30, 34, 44))
    UiFlat::layout(220.0, 36.0)
    UiFlat::pointer((UiCore::PointerEvent.Down(at: UiCore::Vec2(100.0, 18.0), button: 0)))
    UiFlat::pointer((UiCore::PointerEvent.Up(at: UiCore::Vec2(100.0, 18.0), button: 0)))
    check("focused text field accepts committed input", UiFlat::accepts_text())
    check("text field requests an I-beam cursor", UiFlat::cursor_at(100.0, 18.0) == 2)
    UiFlat::insert_text("!")
    check("text field inserts at its caret", UiFlat::text_value(field) == "Hi!")
    caret_before_malformed_pointer: usize = UiFlat::selection_start(field)
    zero_pointer: f32 = 0.0
    nan_pointer: f32 = zero_pointer / zero_pointer
    inf_pointer: f32 = 1.0 / zero_pointer
    check("NaN caret queries fail closed", UiFlat::text_position_at(field, nan_pointer) == caret_before_malformed_pointer)
    check("infinite caret queries fail closed", UiFlat::text_position_at(field, inf_pointer) == caret_before_malformed_pointer)
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Left)))
    UiFlat::insert_text("?")
    check("text field supports insertion in the middle", UiFlat::text_value(field) == "Hi?!")
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Backspace)))
    check("Backspace removes the preceding character", UiFlat::text_value(field) == "Hi!")
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.End)))
    UiFlat::insert_text("é")
    check("text field stores committed UTF-8", UiFlat::text_value(field) == "Hi!é")
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Backspace)))
    check("Backspace removes one UTF-8 scalar", UiFlat::text_value(field) == "Hi!")
    UiFlat::replace_text(field, "éx")
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Left)))
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Left)))
    check("caret navigation keeps combining marks with their base", UiFlat::selection_start(field) == 0)
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Right)))
    check("right navigation advances over a complete grapheme", UiFlat::selection_start(field) == 3)
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Backspace)))
    check("Backspace removes a combining sequence as one character", UiFlat::text_value(field) == "x")
    UiFlat::replace_text(field, "👩‍💻!")
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Home)))
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Right)))
    check("joined emoji form one navigation unit", UiFlat::selection_start(field) == 11)
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Backspace)))
    check("Backspace removes a joined emoji atomically", UiFlat::text_value(field) == "!")
    UiFlat::replace_text(field, "🇳🇴x")
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Home)))
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Right)))
    check("flag pairs form one navigation unit", UiFlat::selection_start(field) == 8)
    invalid_utf8[0] <- 65
    invalid_utf8[1] <- 255
    invalid_utf8[2] <- 66
    UiFlat::replace_text(field, sview(&invalid_utf8[0], 0, 3))
    check("malformed UTF-8 is rejected at the first invalid sequence", UiFlat::text_value(field) == "A")
    check("malformed input reports truncation", UiFlat::text_was_truncated(field))
    invalid_utf8[0] <- 224
    invalid_utf8[1] <- 128
    invalid_utf8[2] <- 128
    UiFlat::replace_text(field, sview(&invalid_utf8[0], 0, 3))
    check("overlong UTF-8 is rejected", UiFlat::text_value(field).len == 0)
    invalid_utf8[0] <- 237
    invalid_utf8[1] <- 160
    invalid_utf8[2] <- 128
    UiFlat::replace_text(field, sview(&invalid_utf8[0], 0, 3))
    check("UTF-8 surrogate encodings are rejected", UiFlat::text_value(field).len == 0)
    invalid_utf8[0] <- 244
    invalid_utf8[1] <- 144
    invalid_utf8[2] <- 128
    invalid_utf8[3] <- 128
    UiFlat::replace_text(field, sview(&invalid_utf8[0], 0, 4))
    check("UTF-8 beyond Unicode's maximum is rejected", UiFlat::text_value(field).len == 0)
    invalid_utf8[0] <- 240
    invalid_utf8[1] <- 159
    UiFlat::replace_text(field, sview(&invalid_utf8[0], 0, 2))
    check("truncated UTF-8 is rejected", UiFlat::text_value(field).len == 0)
    UiFlat::replace_text(field, "Hi!")
    check("valid replacement clears truncation status", not UiFlat::text_was_truncated(field))
    UiFlat::replace_text(field, "first\nsecond\rthird")
    check("single-line replacement normalizes line endings", UiFlat::text_value(field) == "first second third")
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.End)))
    UiFlat::insert_text("\nlast")
    check("single-line insertion normalizes pasted line endings", UiFlat::text_value(field) == "first second third last")
    UiFlat::replace_text(field, "tab\therethere there done")
    check("single-line fields normalize control and Unicode separators", UiFlat::text_value(field) == "tab here  there   there   done")
    UiFlat::replace_text(field, "Hi!")
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Home)))
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Delete)))
    check("Delete removes the following character", UiFlat::text_value(field) == "i!")
    test_last_event <- -1
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Enter)))
    check("Enter submits a text field", test_last_event == UiConst::WidgetEvent.Submit.i32())
    UiCore::begin_frame()
    UiFlat::paint()
    field_node: UiCore::AccessibilityNode = UiCore::accessibility_at(0)
    check("text field exposes its semantic role", field_node.role == UiCore::AccessibilityRole.TextField)
    check("text field exposes its editable value", field_node.text_value == "i!")
    check("text field exposes an explicit edit revision", field_node.revision > 0)
    check("text field exposes its native selection range", field_node.selection_location == 0 and field_node.selection_length == 0)
    UiFlat::replace_text(field, "ABC")
    UiFlat::pointer((UiCore::PointerEvent.Down(at: UiCore::Vec2(13.0, 18.0), button: 0)))
    UiFlat::pointer((UiCore::PointerEvent.Up(at: UiCore::Vec2(13.0, 18.0), button: 0)))
    UiFlat::insert_text("X")
    check("pointer placement moves the text caret", UiFlat::text_value(field) == "XABC")
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Home)))
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.LeftShift)))
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Right)))
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Right)))
    UiFlat::keyboard((UiCore::KeyEvent.Up(code: UiCore::Key.LeftShift)))
    check("Shift-arrow creates a text selection", UiFlat::selection_start(field) == 0 and UiFlat::selection_end(field) == 2)
    UiFlat::insert_text("Z")
    check("typing replaces the selected text", UiFlat::text_value(field) == "ZBC")
    check("insertion collapses the selection", UiFlat::selection_start(field) == 1 and UiFlat::selection_end(field) == 1)
    UiFlat::set_selection(field, 1, 3)
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Backspace)))
    check("Backspace removes the selected range", UiFlat::text_value(field) == "Z")
    UiFlat::replace_text(field, "A😀éB")
    check("UTF-16 offsets stop before partial UTF-8 scalars", UiFlat::text_utf16_offset(field, 2) == 1 and UiFlat::text_utf16_offset(field, 5) == 3)
    UiFlat::set_marked(field, 6, 2)
    check("marked ranges normalize to grapheme boundaries", UiFlat::widget(field).marked_start == 1 and UiFlat::widget(field).marked_end == 5)
    UiFlat::set_marked(field, 0, 0)
    UiFlat::set_selection_utf16(field, 1, 2)
    check("UTF-16 selection maps a supplementary scalar to UTF-8", UiFlat::selection_start(field) == 1 and UiFlat::selection_end(field) == 5)
    check("selection exposes native UTF-16 units", UiFlat::selection_utf16_location(field) == 1 and UiFlat::selection_utf16_length(field) == 2)
    check("UTF-16 substring slicing retains a supplementary scalar", UiFlat::text_range_byte_length(field, 1, 2) == 4)
    check("substring ranges clamp in Elisa", UiFlat::text_range_location(field, 999999) == 5 and UiFlat::text_range_length(field, 999999, 999999) == 0)
    UiFlat::set_selection_utf16(field, 999999, 999999)
    check("oversized native ranges clamp without overflow", UiFlat::selection_start(field) == UiFlat::text_value(field).len and UiFlat::selection_end(field) == UiFlat::text_value(field).len)
    UiFlat::set_selection_utf16(field, 1, 2)
    UiFlat::commit_text("X", 0, 0, false)
    check("committed text replaces a UTF-16-selected scalar", UiFlat::text_value(field) == "AXéB")
    UiFlat::replace_text(field, "Cafe")
    UiFlat::update_marked_text("é", 1, 0, 0, 0, false)
    check("text fields retain an IME marked range", UiFlat::text_value(field) == "Cafeé" and UiFlat::widget(field).marked_start == 4 and UiFlat::widget(field).marked_end == 6)
    check("marked ranges expose UTF-16 units", UiFlat::marked_utf16_location(field) == 4 and UiFlat::marked_utf16_length(field) == 1)
    UiFlat::update_marked_text("ø", 1, 0, 0, 0, false)
    check("composition updates replace the prior marked range", UiFlat::text_value(field) == "Cafeø")
    UiFlat::commit_text("å", 0, 0, false)
    check("committed input replaces and clears marked text", UiFlat::text_value(field) == "Cafeå" and UiFlat::widget(field).marked_start == 0 and UiFlat::widget(field).marked_end == 0)
    check("text history becomes undoable", UiFlat::can_undo_text())
    check("one undo reverts a whole IME composition", UiFlat::undo_text() and UiFlat::text_value(field) == "Cafe")
    check("text history becomes redoable", UiFlat::can_redo_text())
    check("redo reapplies the committed composition", UiFlat::redo_text() and UiFlat::text_value(field) == "Cafeå")
    _ = UiFlat::undo_text()
    UiFlat::insert_text("!")
    check("a new edit invalidates redo history", UiFlat::text_value(field) == "Cafe!" and not UiFlat::can_redo_text())
    UiFlat::update_marked_text_utf8_characters("a😀b", 1, 1)
    check("SDL scalar selection maps supplementary text to UTF-16", UiFlat::selection_utf16_length(field) == 2)
    UiFlat::update_marked_text_utf8_characters("", -1, -1)
    check("empty SDL composition removes and unmarks provisional text", UiFlat::widget(field).marked_start == 0 and UiFlat::widget(field).marked_end == 0)

    UiFlat::replace_text(field, "alpha beta")
    UiFlat::set_selection(field, 10, 10)
    UiFlat::move_word_left(false)
    check("word-left moves to the previous word boundary", UiFlat::selection_start(field) == 6 and UiFlat::selection_end(field) == 6)
    UiFlat::move_word_left(true)
    check("word-left can extend the selection", UiFlat::selection_start(field) == 0 and UiFlat::selection_end(field) == 6)
    UiFlat::move_word_right(false)
    check("word movement collapses an existing selection", UiFlat::selection_start(field) == 6 and UiFlat::selection_end(field) == 6)
    UiFlat::move_word_right(false)
    check("word-right moves to the current word end", UiFlat::selection_start(field) == 10 and UiFlat::selection_end(field) == 10)
    UiFlat::delete_word_backward()
    check("word-backspace deletes one word", UiFlat::text_value(field) == "alpha ")
    check("word deletion participates in undo", UiFlat::undo_text() and UiFlat::text_value(field) == "alpha beta")
    UiFlat::set_selection(field, 0, 0)
    UiFlat::delete_word_forward()
    check("forward word deletion deletes through the word end", UiFlat::text_value(field) == " beta")
    UiFlat::replace_text(field, "café noir")
    UiFlat::set_selection(field, UiFlat::text_value(field).len, UiFlat::text_value(field).len)
    UiFlat::move_word_left(false)
    check("word navigation preserves UTF-8 scalar boundaries", UiFlat::selection_start(field) == 6)
    UiFlat::replace_text(field, "alpha beta")
    UiFlat::select_text_at(64.0, 2)
    check("double-click selects the word under the pointer", UiFlat::selection_start(field) == 6 and UiFlat::selection_end(field) == 10)
    UiFlat::select_text_at(51.0, 2)
    check("double-click selects a separator run", UiFlat::selection_start(field) == 5 and UiFlat::selection_end(field) == 6)
    UiFlat::select_text_at(20.0, 3)
    check("triple-click selects the complete field", UiFlat::selection_start(field) == 0 and UiFlat::selection_end(field) == 10)
    UiFlat::select_text_click_at(64.0, 1, 2)
    check("non-primary multi-click leaves text selection alone", UiFlat::selection_start(field) == 0 and UiFlat::selection_end(field) == 10)
    UiFlat::set_selection(field, 0, 0)
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.LeftShift)))
    UiFlat::pointer((UiCore::PointerEvent.Down(at: UiCore::Vec2(64.0, 18.0), button: 0)))
    UiFlat::pointer((UiCore::PointerEvent.Up(at: UiCore::Vec2(64.0, 18.0), button: 0)))
    UiFlat::keyboard((UiCore::KeyEvent.Up(code: UiCore::Key.LeftShift)))
    check("Shift-click extends from the existing anchor", UiFlat::selection_start(field) == 0 and UiFlat::selection_end(field) == 7)

    expanded_field: usize = UiFlat::text_field(UiFlat::NONE, "Expanded", "", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaé", 220.0, 36.0, 15.0, UiCore::rgb(240, 240, 245), UiCore::rgb(30, 34, 44))
    check("text beyond the former 127-byte ceiling is retained", UiFlat::text_value(expanded_field).len == 128 and not UiFlat::text_was_truncated(expanded_field))
    for index in 0..<1100:
        long_text[index] <- 97
    long_text[1022] <- 195
    long_text[1023] <- 169
    long_field: usize = UiFlat::text_field(UiFlat::NONE, "Bounded", "", sview(&long_text[0], 0, 1024), 220.0, 36.0, 15.0, UiCore::rgb(240, 240, 245), UiCore::rgb(30, 34, 44))
    check("bounded initial text ends at a UTF-8 boundary", UiFlat::widget(long_field).input_length == 1022)
    check("bounded initial text reports truncation", UiFlat::text_was_truncated(long_field))
    long_text[1021] <- 101
    long_text[1022] <- 204
    long_text[1023] <- 129
    cluster_bound_field: usize = UiFlat::text_field(UiFlat::NONE, "Cluster bounded", "", sview(&long_text[0], 0, 1024), 220.0, 36.0, 15.0, UiCore::rgb(240, 240, 245), UiCore::rgb(30, 34, 44))
    check("bounded initial text never truncates inside a grapheme", UiFlat::widget(cluster_bound_field).input_length == 1021)
    oversized_label: usize = UiFlat::label(UiFlat::NONE, sview(&long_text[0], 0, 1100), 15.0, UiCore::rgb(240, 240, 245))
    check("flat labels bound borrowed text views", UiFlat::widget(oversized_label).text.len == UiCore::MAX_TEXT_BYTES.i64())
    UiFlat::replace_text(long_field, sview(&long_text[0], 0, 2147483647))
    check("text replacement keeps a UTF-8 boundary", UiFlat::widget(long_field).input_length == UiFlat::TEXT_CAPACITY - 3)
    check("text replacement reports hostile truncation", UiFlat::text_was_truncated(long_field))

    UiFlat::reset()
    secret: usize = UiFlat::secure_text_field(UiFlat::NONE, "Password", "Enter password", "s3crét", 220.0, 36.0, 15.0, UiCore::rgb(240, 240, 245), UiCore::rgb(30, 34, 44))
    UiFlat::layout(220.0, 36.0)
    UiFlat::pointer((UiCore::PointerEvent.Down(at: UiCore::Vec2(20.0, 18.0), button: 0)))
    UiFlat::pointer((UiCore::PointerEvent.Up(at: UiCore::Vec2(20.0, 18.0), button: 0)))
    UiFlat::set_selection(secret, 0, UiFlat::text_value(secret).len)
    check("secure fields retain their private application value", UiFlat::text_value(secret) == "s3crét")
    check("secure fields disable selected-text export", UiFlat::selected_text_length(secret) == 0)
    check("secure fields deny native substring readback", not UiFlat::allows_text_readback())
    UiCore::begin_frame()
    UiFlat::paint()
    secret_node: UiCore::AccessibilityNode = UiCore::accessibility_at(0)
    check("secure fields expose their semantic role", secret_node.role == UiCore::AccessibilityRole.PasswordField)
    check("secure accessibility values are masked", secret_node.text_value == "••••••")
    check("secure semantic selections contain no private text", secret_node.selected_text.len == 0)
    check("secure paint commands never retain the password", not frame_contains_text("s3crét"))
    check("secure paint commands contain only the mask", frame_contains_text("••••••"))
    before_revision: usize = secret_node.revision
    UiFlat::replace_text(secret, "abcdef")
    UiCore::begin_frame()
    UiFlat::paint()
    check("same-length secure edits advance semantic revision", UiCore::accessibility_at(0).revision > before_revision)

    UiFlat::reset()
    check("reset discards secure undo history", not UiFlat::can_undo_text())

    UiCore::set_frame_time(100.0)
    blink_field: usize = UiFlat::text_field(UiFlat::NONE, "Blink", "", "A", 220.0, 36.0, 15.0, UiCore::rgb(240, 240, 245), UiCore::rgb(30, 34, 44))
    UiFlat::layout(220.0, 36.0)
    UiFlat::pointer((UiCore::PointerEvent.Down(at: UiCore::Vec2(20.0, 18.0), button: 0)))
    UiFlat::pointer((UiCore::PointerEvent.Up(at: UiCore::Vec2(20.0, 18.0), button: 0)))
    UiCore::begin_frame()
    UiFlat::paint()
    caret_visible_commands: usize = UiCore::command_count()
    check("a focused caret requests its themed animation interval", UiCore::frame_delay() == 0.5)
    UiCore::set_frame_time(100.6)
    UiCore::begin_frame()
    UiFlat::paint()
    caret_hidden_commands: usize = UiCore::command_count()
    check("focused text carets blink on monotonic frame time", caret_visible_commands == caret_hidden_commands + 1)
    UiCore::set_frame_time(100.7)
    UiFlat::set_selection(blink_field, 0, 0)
    UiCore::begin_frame()
    UiFlat::paint()
    check("selection changes restart the caret blink", UiCore::command_count() == caret_visible_commands)
    blink_theme: mutable UiFlat::Theme = UiFlat::theme()
    blink_theme.caret_blink_interval <- -1.0
    UiFlat::set_theme(blink_theme)
    UiCore::begin_frame()
    UiFlat::paint()
    check("zero blink timing disables animation without hiding the caret", UiCore::frame_delay() == 0.0 and UiCore::command_count() == caret_visible_commands)
    UiFlat::set_theme(base_theme)
    UiCore::set_frame_time(0.0)

    # A finite but enormous host clock must not overflow the caret blink tick
    # narrowing in UiFlat::paint. Once f64 loses integer parity precision the
    # framework keeps the caret visible deterministically.
    UiCore::set_frame_time(1.0e308)
    UiCore::begin_frame()
    UiFlat::paint()
    check("huge blink elapsed time remains safe", UiCore::command_count() >= caret_visible_commands)
    UiCore::set_frame_time(0.0)

    # Metric hooks are supplied by a backend and may return a finite but
    # unusably large value. Paint-time measurement must bound both width and
    # line height, not only the size stored in the retained widget.
    UiFlat::reset()
    metric_label: usize = UiFlat::label(UiFlat::NONE, "metric", 15.0, UiCore::rgb(240, 240, 245))
    UiFlat::layout(120.0, 24.0)
    hostile_text_metrics <- true
    UiCore::begin_frame()
    UiFlat::paint()
    hostile_text_metrics <- false
    metric_commands: mutable usize = 0
    for command_index in 0..<UiCore::command_count():
        match UiCore::command_at(command_index):
            UiCore::Command.DrawText(run, color):
                metric_commands <- metric_commands + 1
                check("hostile metrics keep text size bounded", run.size <= UiConstraints::MAX_EXTENT and run.size == run.size)
                check("hostile metrics keep text origin bounded", run.origin.x <= UiConstraints::MAX_EXTENT and run.origin.x >= -UiConstraints::MAX_EXTENT and run.origin.y <= UiConstraints::MAX_EXTENT and run.origin.y >= -UiConstraints::MAX_EXTENT and run.origin.x == run.origin.x and run.origin.y == run.origin.y)
            _:
                pass
    check("hostile metrics still emit text", metric_commands > 0)

    # A wide preceding sibling can place a text field at the edge of the
    # shared coordinate envelope. Caret geometry is exported directly to the
    # AppKit text protocol, so the composed origin + inset + measured width
    # must be bounded after arithmetic, not only at each input.
    UiFlat::reset()
    hostile_text_metrics <- true
    edge_root: usize = UiFlat::panel(UiFlat::NONE, UiConst::Axis.Row, 0.0, 0.0, UiCore::rgb(0, 0, 0))
    _ = UiFlat::label(edge_root, "wide", 15.0, UiCore::rgb(240, 240, 245))
    edge_field: usize = UiFlat::text_field(edge_root, "Edge", "", "A", 220.0, 36.0, 15.0, UiCore::rgb(240, 240, 245), UiCore::rgb(30, 34, 44))
    hostile_text_metrics <- false
    UiFlat::layout(UiCore::MAX_GEOMETRY_EXTENT, 100.0)
    edge_x: f32 = UiFlat::text_caret_x(edge_field)
    edge_character_x: f32 = UiFlat::text_character_x(edge_field, 0)
    check("caret x stays inside the shared coordinate envelope", edge_x <= UiCore::MAX_GEOMETRY_EXTENT and edge_x >= -UiCore::MAX_GEOMETRY_EXTENT and edge_x == edge_x)
    check("character x stays inside the shared coordinate envelope", edge_character_x <= UiCore::MAX_GEOMETRY_EXTENT and edge_character_x >= -UiCore::MAX_GEOMETRY_EXTENT and edge_character_x == edge_character_x)

    UiFlat::reset()
    UiCore::begin_frame()
    UiFlat::paint()
    check("an idle widget tree requests no animation frames", UiCore::frame_delay() == 0.0)
    history_field: usize = UiFlat::text_field(UiFlat::NONE, "History", "", "", 220.0, 36.0, 15.0, UiCore::rgb(240, 240, 245), UiCore::rgb(30, 34, 44))
    UiFlat::layout(220.0, 36.0)
    UiFlat::pointer((UiCore::PointerEvent.Down(at: UiCore::Vec2(20.0, 18.0), button: 0)))
    UiFlat::pointer((UiCore::PointerEvent.Up(at: UiCore::Vec2(20.0, 18.0), button: 0)))
    for edit in 0..<40:
        UiFlat::insert_text("x")
    check("history stress setup applies every edit", UiFlat::text_value(history_field).len == 40)
    for edit in 0..<32:
        _ = UiFlat::undo_text()
    check("bounded history retains the newest 32 edits", UiFlat::text_value(history_field).len == 8 and not UiFlat::can_undo_text())
    for edit in 0..<32:
        _ = UiFlat::redo_text()
    check("bounded history redoes every retained edit", UiFlat::text_value(history_field).len == 40 and not UiFlat::can_redo_text())

    UiFlat::reset()
    history_root: usize = UiFlat::panel(UiFlat::NONE, UiConst::Axis.Column, 0.0, 0.0, UiCore::rgb(0, 0, 0))
    first_field: usize = UiFlat::text_field(history_root, "First", "", "", 220.0, 36.0, 15.0, UiCore::rgb(240, 240, 245), UiCore::rgb(30, 34, 44))
    second_field: usize = UiFlat::text_field(history_root, "Second", "", "", 220.0, 36.0, 15.0, UiCore::rgb(240, 240, 245), UiCore::rgb(30, 34, 44))
    UiFlat::layout(220.0, 72.0)
    UiFlat::pointer((UiCore::PointerEvent.Down(at: UiCore::Vec2(20.0, 18.0), button: 0)))
    UiFlat::pointer((UiCore::PointerEvent.Up(at: UiCore::Vec2(20.0, 18.0), button: 0)))
    UiFlat::insert_text("A")
    UiFlat::pointer((UiCore::PointerEvent.Down(at: UiCore::Vec2(20.0, 54.0), button: 0)))
    UiFlat::pointer((UiCore::PointerEvent.Up(at: UiCore::Vec2(20.0, 54.0), button: 0)))
    UiFlat::insert_text("B")
    _ = UiFlat::undo_text()
    check("global history undoes the newest field first", UiFlat::text_value(first_field) == "A" and UiFlat::text_value(second_field) == "" and UiFlat::focused() == second_field)
    _ = UiFlat::undo_text()
    check("global history continues into the previous field", UiFlat::text_value(first_field) == "" and UiFlat::focused() == first_field)

    UiFlat::reset()
    shortcut_field: usize = UiFlat::text_field(UiFlat::NONE, "Shortcuts", "", "copy me", 220.0, 36.0, 15.0, UiCore::rgb(240, 240, 245), UiCore::rgb(30, 34, 44))
    UiFlat::request_focus(shortcut_field)
    UiFlat::set_selection(shortcut_field, 0, 4)
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.LeftControl)))
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.C)))
    UiFlat::keyboard((UiCore::KeyEvent.Up(code: UiCore::Key.C)))
    UiFlat::keyboard((UiCore::KeyEvent.Up(code: UiCore::Key.LeftControl)))
    check("portable Control-C copies the selected UTF-8 bytes", test_clipboard_value() == "copy")
    UiFlat::set_selection(shortcut_field, 5, 7)
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.LeftSuper)))
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.X)))
    UiFlat::keyboard((UiCore::KeyEvent.Up(code: UiCore::Key.X)))
    UiFlat::keyboard((UiCore::KeyEvent.Up(code: UiCore::Key.LeftSuper)))
    check("portable Command-X cuts through retained text history", UiFlat::text_value(shortcut_field) == "copy " and test_clipboard_value() == "me")
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.LeftControl)))
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.V)))
    UiFlat::keyboard((UiCore::KeyEvent.Up(code: UiCore::Key.V)))
    UiFlat::keyboard((UiCore::KeyEvent.Up(code: UiCore::Key.LeftControl)))
    check("portable Control-V pastes through the normal insertion path", UiFlat::text_value(shortcut_field) == "copy me")
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.LeftControl)))
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Z)))
    UiFlat::keyboard((UiCore::KeyEvent.Up(code: UiCore::Key.Z)))
    check("portable Control-Z undoes clipboard edits", UiFlat::text_value(shortcut_field) == "copy ")
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.LeftShift)))
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Z)))
    UiFlat::keyboard((UiCore::KeyEvent.Up(code: UiCore::Key.Z)))
    UiFlat::keyboard((UiCore::KeyEvent.Up(code: UiCore::Key.LeftShift)))
    UiFlat::keyboard((UiCore::KeyEvent.Up(code: UiCore::Key.LeftControl)))
    check("portable Control-Shift-Z redoes clipboard edits", UiFlat::text_value(shortcut_field) == "copy me")
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.LeftControl)))
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.A)))
    UiFlat::keyboard((UiCore::KeyEvent.Up(code: UiCore::Key.A)))
    UiFlat::keyboard((UiCore::KeyEvent.Up(code: UiCore::Key.LeftControl)))
    check("portable Control-A selects the complete field", UiFlat::selected_text_length(shortcut_field) == 7)
    UiFlat::set_selection(shortcut_field, 0, 0)
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.LeftControl)))
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.RightControl)))
    UiFlat::keyboard((UiCore::KeyEvent.Up(code: UiCore::Key.LeftControl)))
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.A)))
    UiFlat::keyboard((UiCore::KeyEvent.Up(code: UiCore::Key.A)))
    UiFlat::keyboard((UiCore::KeyEvent.Up(code: UiCore::Key.RightControl)))
    check("releasing one Control preserves the other modifier", UiFlat::selected_text_length(shortcut_field) == 7)
    UiFlat::set_selection(shortcut_field, 7, 7)
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.LeftShift)))
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.RightShift)))
    UiFlat::keyboard((UiCore::KeyEvent.Up(code: UiCore::Key.LeftShift)))
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Left)))
    UiFlat::keyboard((UiCore::KeyEvent.Up(code: UiCore::Key.RightShift)))
    check("releasing one Shift preserves selection extension from the other", UiFlat::selected_text_length(shortcut_field) == 1)
    test_clipboard_length <- 0
    UiFlat::set_selection(shortcut_field, 0, 4)
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.LeftSuper)))
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.RightSuper)))
    UiFlat::keyboard((UiCore::KeyEvent.Up(code: UiCore::Key.LeftSuper)))
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.C)))
    UiFlat::keyboard((UiCore::KeyEvent.Up(code: UiCore::Key.C)))
    UiFlat::keyboard((UiCore::KeyEvent.Up(code: UiCore::Key.RightSuper)))
    check("releasing one Command preserves shortcuts from the other", test_clipboard_value() == "copy")

    if test_failures == 0:
        _ = puts("widget layout: all checks passed")
        return 0
    _ = puts("widget layout: FAILURES above")
    return 1
