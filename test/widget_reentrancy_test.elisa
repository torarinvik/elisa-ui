# Callback handlers are allowed to rebuild the view. The framework must stop
# using the old flat-tree slot as soon as that callback advances its lifetime.

include "../src/widgets/ui_widget.elisa"

extern puts(text: cstr) -> i64

global mutable failures: i32 = 0
global mutable reset_on_change: bool = false

def ui_measure_text_width(text: sview, size: f32) -> f32:
    return text.len.f32() * size * 0.5

def ui_measure_text_height(text: sview, size: f32) -> f32:
    return size

def ui_font_ascent(size: f32) -> f32:
    return size

def ui_text_line_height(size: f32) -> f32:
    return size

def ui_clipboard_has_text() -> bool:
    return false

def ui_clipboard_write(bytes: u8&, length: usize) -> bool:
    return true

def ui_clipboard_read(buffer: mutable u8&, capacity: usize) -> usize:
    return 0

def app_widget_event(widget: usize, event: i32) -> void:
    UiFlat::reset() if reset_on_change and (event == UiConst::WidgetEvent.Change.i32() or event == UiConst::WidgetEvent.Click.i32())

def check(name: cstr, ok: bool) -> void:
    return if ok
    failures <- failures + 1
    _ = puts(name)

def field() -> usize:
    index: usize = UiFlat::text_field(UiFlat::NONE, "Value", "", "", 180.0, 32.0, 14.0, UiCore::rgb(240, 240, 240), UiCore::rgb(30, 30, 30))
    UiFlat::request_focus(index)
    return index

def main() -> i64:
    # The change callback may dispose the entire tree. Text insertion must
    # return before closing a history slot that now belongs to no widget.
    UiFlat::reset()
    reset_on_change <- true
    index: mutable usize = field()
    UiFlat::insert_text("x")
    check("insert callback can reset tree", UiFlat::count() == 0 and not UiFlat::can_undo_text())

    # Replacement and marked composition both continue work after insert_text
    # returns, so their post-callback reads need the same lifetime guard.
    UiFlat::reset()
    index <- field()
    UiFlat::replace_text(index, "replace")
    check("replace callback can reset tree", UiFlat::count() == 0)

    UiFlat::reset()
    index <- field()
    UiFlat::update_marked_text("compose", 0, 0, 0, 0, false)
    check("marked callback can reset tree", UiFlat::count() == 0)

    # Undo and redo restore a snapshot and then notify the application. A
    # reset from that notification must not move the new tree's history cursor.
    UiFlat::reset()
    reset_on_change <- false
    index <- field()
    UiFlat::insert_text("history")
    check("history setup is undoable", UiFlat::can_undo_text())
    reset_on_change <- true
    undone: bool = UiFlat::undo_text()
    check("undo callback reports disposal", not undone and UiFlat::count() == 0)

    UiFlat::reset()
    reset_on_change <- false
    index <- field()
    UiFlat::insert_text("history")
    _ = UiFlat::undo_text()
    check("history setup is redoable", UiFlat::can_redo_text())
    reset_on_change <- true
    redone: bool = UiFlat::redo_text()
    check("redo callback reports disposal", not redone and UiFlat::count() == 0)

    # The same callback contract applies to activation and assistive value
    # changes, which are public entry points used by native adapters.
    UiFlat::reset()
    index <- UiFlat::button(UiFlat::NONE, 120.0, 32.0, UiCore::rgb(30, 30, 30), UiCore::rgb(40, 40, 40), UiCore::rgb(50, 50, 50))
    reset_on_change <- true
    activated: bool = UiFlat::activate(index)
    check("activation callback reports disposal", not activated and UiFlat::count() == 0)

    UiFlat::reset()
    index <- UiFlat::slider(UiFlat::NONE, "Slider", 120.0, 24.0, 0.5, UiCore::rgb(30, 30, 30), UiCore::rgb(50, 50, 50), UiCore::rgb(90, 90, 90))
    reset_on_change <- true
    adjusted: bool = UiFlat::adjust(index, 0.1)
    check("adjust callback reports disposal", not adjusted and UiFlat::count() == 0)

    UiFlat::reset()
    first: usize = UiFlat::radio_button(UiFlat::NONE, 120.0, 24.0, UiCore::rgb(30, 30, 30), UiCore::rgb(50, 50, 50), UiCore::rgb(90, 90, 90))
    _ = UiFlat::radio_button(UiFlat::NONE, 120.0, 24.0, UiCore::rgb(30, 30, 30), UiCore::rgb(50, 50, 50), UiCore::rgb(90, 90, 90))
    reset_on_change <- true
    moved: bool = UiFlat::radio_move(first, 1)
    check("radio callback reports disposal", not moved and UiFlat::count() == 0)
    return failures.i64()
