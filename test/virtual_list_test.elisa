# Headless regression for the shared virtual-list geometry policy.

include "../src/widgets/ui_virtual_list.elisa"

extern puts(text: cstr) -> i64
global mutable failures: i32 = 0

def check(name: cstr, ok: bool) -> void:
    return if ok
    failures <- failures + 1
    _ = puts(name)

def check_large_window(index: i32) -> void:
    window: UiVirtualList::AnchoredWindow = UiVirtualList::anchored_window(
        UiVirtualList::MAX_ITEMS, 40.0, 8.0,
        UiVirtualList::ScrollAnchor{index: index, offset: 0.0}, 96.0,
        UiVirtualList::MAX_REALIZED.i32())
    range: UiVirtualList::VisibleRange = UiVirtualList::VisibleRange{first: window.first, finish: window.finish}
    realized: UiVirtualList::Realization = UiVirtualList::realize(20, UiVirtualList::MAX_ITEMS, range, UiVirtualList::MAX_REALIZED.i32())
    semantic: UiVirtualList::SemanticWindow = UiVirtualList::semantic_window(UiVirtualList::MAX_ITEMS, range, index, index)
    position: UiVirtualList::ItemPosition = UiVirtualList::item_position(index, window, 40.0, 8.0)
    expected_top: mutable f32 = 0.0
    expected_top <- 56.0 if index == UiVirtualList::MAX_ITEMS - 1
    check("anchored window preserves full logical total", window.total == UiVirtualList::MAX_ITEMS)
    check("deep target belongs to bounded visible range", UiVirtualList::contains(range, index) and position.valid)
    check("deep row realizes into bounded slot pool", realized.realized == UiVirtualList::count(range) and realized.realized <= UiVirtualList::MAX_REALIZED.i32() and UiVirtualList::slot_for(20, index) != UiVirtualList::NONE_INDEX)
    check("deep window semantics retains focus and selection", semantic.total == UiVirtualList::MAX_ITEMS and semantic.focused == index and semantic.selected == index and semantic.focus_visible and semantic.selection_visible)
    check("deep row is placed in viewport-local coordinates", position.top == expected_top)

def main() -> i64:
    layout: UiVirtualList::Metrics = UiVirtualList::metrics(40.0, 8.0)
    check("metrics normalize item extent", layout.item_extent == 40.0 and layout.spacing == 8.0 and layout.stride == 48.0)
    zero: UiVirtualList::Metrics = UiVirtualList::metrics(0.0, -4.0)
    check("zero metrics stay usable", zero.item_extent == 1.0 and zero.spacing == 0.0 and zero.stride == 1.0)
    huge: f32 = 1000000000.0
    bounded: UiVirtualList::Metrics = UiVirtualList::metrics(huge, huge)
    check("oversized metrics clamp item extent", bounded.item_extent == UiVirtualList::MAX_GEOMETRY_EXTENT)
    check("oversized metrics clamp spacing", bounded.spacing == UiVirtualList::MAX_GEOMETRY_EXTENT)
    check("overflowed metrics stay inside geometry bound", bounded.stride == UiVirtualList::MAX_GEOMETRY_EXTENT)
    check("oversized content extent stays inside geometry bound", UiVirtualList::content_extent(UiVirtualList::MAX_ITEMS, huge, huge) == UiVirtualList::MAX_GEOMETRY_EXTENT)
    check("oversized item offset stays inside geometry bound", UiVirtualList::item_offset(UiVirtualList::MAX_ITEMS - 1, UiVirtualList::MAX_ITEMS, huge, huge) == UiVirtualList::MAX_GEOMETRY_EXTENT)
    bounded_range: UiVirtualList::VisibleRange = UiVirtualList::visible_range(3, huge, huge, UiVirtualList::MAX_GEOMETRY_EXTENT, UiVirtualList::MAX_GEOMETRY_EXTENT, 3)
    check("visible range uses the bounded placement stride", bounded_range.first == 1 and bounded_range.finish == 3)

    check("content extent has no trailing gap", UiVirtualList::content_extent(3, 40.0, 8.0) == 136.0)
    check("empty content has zero extent", UiVirtualList::content_extent(0, 40.0, 8.0) == 0.0)
    check("item offsets use the stride", UiVirtualList::item_offset(2, 3, 40.0, 8.0) == 96.0)
    check("stale item offset clamps", UiVirtualList::item_offset(99, 3, 40.0, 8.0) == 96.0)
    check("empty item offset is safe", UiVirtualList::item_offset(0, 0, 40.0, 8.0) == 0.0)
    first_range: UiVirtualList::VisibleRange = UiVirtualList::visible_range(100, 40.0, 8.0, 0.0, 96.0, 4)
    check("top range includes an edge buffer", first_range.first == 0 and first_range.finish == 3)
    after_scroll: UiVirtualList::VisibleRange = UiVirtualList::visible_range(100, 40.0, 8.0, 96.0, 96.0, 4)
    check("scrolled range starts at the content row", after_scroll.first == 2 and after_scroll.finish == 5)
    capped: UiVirtualList::VisibleRange = UiVirtualList::visible_range(5, 40.0, 8.0, 0.0, 500.0, 2)
    check("range honors memory budget", capped.first == 0 and capped.finish == 2 and UiVirtualList::count(capped) == 2)
    end_range: UiVirtualList::VisibleRange = UiVirtualList::visible_range(5, 40.0, 8.0, 9999.0, 20.0, 4)
    check("tail range stays inside count", end_range.first == 4 and end_range.finish == 5 and UiVirtualList::contains(end_range, 4) and not UiVirtualList::contains(end_range, 3))
    blank: UiVirtualList::VisibleRange = UiVirtualList::visible_range(0, 40.0, 8.0, 0.0, 100.0, 4)
    check("empty range is half open", blank.first == 0 and blank.finish == 0 and UiVirtualList::count(blank) == 0)
    malformed: UiVirtualList::VisibleRange = UiVirtualList::visible_range(-10, -20.0, -8.0, -100.0, -50.0, 0)
    check("malformed range fails closed", malformed.first == 0 and malformed.finish == 0)

    # Exercise a complete public window -> realization -> local placement ->
    # semantics workflow at the start, former f32 saturation boundary, middle,
    # and tail of the maximum supported logical list.
    UiVirtualList::reset_realization()
    check_large_window(0)
    check_large_window(349526)
    check_large_window(UiVirtualList::MAX_ITEMS / 2)
    check_large_window(UiVirtualList::MAX_ITEMS - 1)

    carried: UiVirtualList::AnchoredWindow = UiVirtualList::anchored_window(UiVirtualList::MAX_ITEMS, 40.0, 8.0, UiVirtualList::ScrollAnchor{index: 2, offset: 99.0}, 96.0, 64)
    check("local scroll offset carries across logical rows", carried.first == 4 and carried.leading_offset == 3.0)
    negative_offset: UiVirtualList::AnchoredWindow = UiVirtualList::anchored_window(UiVirtualList::MAX_ITEMS, 40.0, 8.0, UiVirtualList::ScrollAnchor{index: 2, offset: -24.0}, 96.0, 64)
    check("negative local offset retreats to the preceding row", negative_offset.first == 1 and negative_offset.leading_offset == 24.0)
    invalid_anchor: UiVirtualList::AnchoredWindow = UiVirtualList::anchored_window(100, 40.0, 8.0, UiVirtualList::ScrollAnchor{index: -10, offset: 1000.0}, 96.0, 64)
    check("negative logical identity ignores malformed local offset", invalid_anchor.first == 0 and invalid_anchor.leading_offset == 0.0)
    down: UiVirtualList::ScrollAnchor = UiVirtualList::scroll_by(UiVirtualList::ScrollAnchor{index: 0, offset: 0.0}, 96.0, UiVirtualList::MAX_ITEMS, 40.0, 8.0, 96.0)
    check("scroll delta advances logical anchor", down.index == 2 and down.offset == 0.0)
    deep_step: UiVirtualList::ScrollAnchor = UiVirtualList::scroll_by(UiVirtualList::ScrollAnchor{index: 349526, offset: 0.0}, 1.0, UiVirtualList::MAX_ITEMS, 40.0, 8.0, 96.0)
    check("one-pixel scroll remains precise beyond old f32 extent", deep_step.index == 349526 and deep_step.offset == 1.0)
    up: UiVirtualList::ScrollAnchor = UiVirtualList::scroll_by(down, -48.0, UiVirtualList::MAX_ITEMS, 40.0, 8.0, 96.0)
    check("negative scroll delta retreats logical anchor", up.index == 1 and up.offset == 0.0)
    top: UiVirtualList::ScrollAnchor = UiVirtualList::scroll_by(UiVirtualList::ScrollAnchor{index: 0, offset: 0.0}, -500.0, UiVirtualList::MAX_ITEMS, 40.0, 8.0, 96.0)
    check("scrolling before the start clamps to the first row", top.index == 0 and top.offset == 0.0)
    tail_anchor: UiVirtualList::ScrollAnchor = UiVirtualList::scroll_by(UiVirtualList::ScrollAnchor{index: 0, offset: 0.0}, 1000000000.0, UiVirtualList::MAX_ITEMS, 40.0, 8.0, 96.0)
    check("large scroll delta reaches the logical tail", tail_anchor.index == UiVirtualList::MAX_ITEMS - 3 and tail_anchor.offset == 40.0)

    negative_anchor: UiVirtualList::AnchoredWindow = UiVirtualList::anchored_window(100, 40.0, 8.0, UiVirtualList::ScrollAnchor{index: -10, offset: 0.0}, 96.0, 64)
    check("negative logical anchor fails safely to the top", negative_anchor.first == 0 and negative_anchor.leading_offset == 0.0)
    short_content: UiVirtualList::ScrollAnchor = UiVirtualList::scroll_by(UiVirtualList::ScrollAnchor{index: 2, offset: 30.0}, 1000.0, 3, 40.0, 8.0, 500.0)
    check("viewport larger than content clamps to top", short_content.index == 0 and short_content.offset == 0.0)
    zero_viewport: UiVirtualList::AnchoredWindow = UiVirtualList::anchored_window(100, 40.0, 8.0, UiVirtualList::ScrollAnchor{index: 50, offset: 0.0}, 0.0, 0)
    check("zero viewport still exposes one logical row", zero_viewport.first == 50 and zero_viewport.finish == 51)
    capped_window: UiVirtualList::AnchoredWindow = UiVirtualList::anchored_window(UiVirtualList::MAX_ITEMS, 40.0, 8.0, UiVirtualList::ScrollAnchor{index: 100, offset: 0.0}, 1000000000.0, 1000000)
    check("anchored window clamps requested realization budget", capped_window.finish - capped_window.first == UiVirtualList::MAX_REALIZED.i32())
    outside_position: UiVirtualList::ItemPosition = UiVirtualList::item_position(1000, capped_window, 40.0, 8.0)
    check("local placement rejects rows outside the realized range", not outside_position.valid)
    huge_extent_window: UiVirtualList::AnchoredWindow = UiVirtualList::anchored_window(UiVirtualList::MAX_ITEMS, 1000000000.0, 1000000000.0, UiVirtualList::ScrollAnchor{index: 8388608, offset: 0.0}, 96.0, 64)
    check("large row geometry keeps deep logical index addressable", huge_extent_window.total == UiVirtualList::MAX_ITEMS and huge_extent_window.first == 8388608 and huge_extent_window.finish == 8388609)

    first_without_reset: UiVirtualList::Realization = UiVirtualList::realize(0, 10, UiVirtualList::VisibleRange{first: 0, finish: 1}, 1)
    check("realization lazily initializes its empty slot pool", first_without_reset.realized == 1 and UiVirtualList::slot_for(0, 0) != UiVirtualList::NONE_INDEX)
    UiVirtualList::reset_realization()
    r1: UiVirtualList::Realization = UiVirtualList::realize(1, 100, UiVirtualList::VisibleRange{first: 0, finish: 3}, 8)
    check("realize reports the retained window", r1.total == 100 and r1.first == 0 and r1.finish == 3 and r1.realized == 3 and UiVirtualList::realized_count() == 3)
    slot_a: i32 = UiVirtualList::slot_for(1, 0)
    gen_a: u32 = UiVirtualList::slot_generation(slot_a)
    check("a retained row has a slot and generation", slot_a != UiVirtualList::NONE_INDEX and gen_a != 0)
    check("logical lookup is symmetric", UiVirtualList::logical_for_slot(slot_a) == 0)
    _ = UiVirtualList::realize(1, 100, UiVirtualList::VisibleRange{first: 0, finish: 3}, 8)
    check("re-realizing keeps a visible row stable", UiVirtualList::slot_for(1, 0) == slot_a and UiVirtualList::slot_generation(slot_a) == gen_a)

    _ = UiVirtualList::realize(1, 100, UiVirtualList::VisibleRange{first: 10, finish: 13}, 8)
    check("scrolled-out rows release their slots", UiVirtualList::slot_for(1, 0) == UiVirtualList::NONE_INDEX and UiVirtualList::slot_for(1, 10) != UiVirtualList::NONE_INDEX)
    check("only the retained rows are realized", UiVirtualList::realized_count() == 3)
    _ = UiVirtualList::realize(1, 100, UiVirtualList::VisibleRange{first: 0, finish: 3}, 8)
    check("a returning row crosses a new generation", UiVirtualList::slot_for(1, 0) != UiVirtualList::NONE_INDEX and UiVirtualList::slot_generation(UiVirtualList::slot_for(1, 0)) != gen_a)

    _ = UiVirtualList::realize(2, 50, UiVirtualList::VisibleRange{first: 0, finish: 2}, 8)
    check("a second owner gets its own slots", UiVirtualList::slot_for(2, 0) != UiVirtualList::NONE_INDEX and UiVirtualList::slot_for(2, 0) != UiVirtualList::slot_for(1, 0) and UiVirtualList::realized_count() == 5)
    UiVirtualList::release_owner(2)
    check("releasing an owner frees only its rows", UiVirtualList::slot_for(2, 0) == UiVirtualList::NONE_INDEX and UiVirtualList::slot_for(1, 0) != UiVirtualList::NONE_INDEX)

    budgeted: UiVirtualList::Realization = UiVirtualList::realize(3, 100, UiVirtualList::VisibleRange{first: 0, finish: 100}, 4)
    check("realization honors the slot budget", budgeted.realized == 4 and budgeted.finish == 4)
    empty_realization: UiVirtualList::Realization = UiVirtualList::realize(4, 0, UiVirtualList::VisibleRange{first: 0, finish: 0}, 8)
    check("an empty list realizes nothing", empty_realization.realized == 0 and empty_realization.total == 0)

    UiVirtualList::reset_realization()
    full_owner: UiVirtualList::Realization = UiVirtualList::realize(10, 100, UiVirtualList::VisibleRange{first: 0, finish: 100}, UiVirtualList::MAX_REALIZED.i32())
    preserved_slot: i32 = UiVirtualList::slot_for(10, 0)
    preserved_generation: u32 = UiVirtualList::slot_generation(preserved_slot)
    blocked_owner: UiVirtualList::Realization = UiVirtualList::realize(11, 10, UiVirtualList::VisibleRange{first: 0, finish: 1}, 1)
    check("a full shared pool reports partial realization without evicting another owner", full_owner.realized == UiVirtualList::MAX_REALIZED.i32() and blocked_owner.realized == 0 and blocked_owner.finish == blocked_owner.first and UiVirtualList::slot_for(11, 0) == UiVirtualList::NONE_INDEX)
    check("pool exhaustion preserves prior owner identity and generation", UiVirtualList::slot_for(10, 0) == preserved_slot and UiVirtualList::slot_generation(preserved_slot) == preserved_generation and UiVirtualList::realized_count() == UiVirtualList::MAX_REALIZED)

    if failures == 0:
        _ = puts("virtual list: all checks passed")
        return 0
    _ = puts("virtual list: FAILURES above")
    return 1
