# Headless regression for the shared virtual-list geometry policy.

include "../src/widgets/ui_virtual_list.elisa"

extern puts(text: cstr) -> i64
global mutable failures: i32 = 0

def check(name: cstr, ok: bool) -> void:
    return if ok
    failures <- failures + 1
    _ = puts(name)

def main() -> i64:
    layout: UiVirtualList::Metrics = UiVirtualList::metrics(40.0, 8.0)
    check("metrics normalize item extent", layout.item_extent == 40.0 and layout.spacing == 8.0 and layout.stride == 48.0)
    zero: UiVirtualList::Metrics = UiVirtualList::metrics(0.0, -4.0)
    check("zero metrics stay usable", zero.item_extent == 1.0 and zero.spacing == 0.0 and zero.stride == 1.0)
    huge: f32 = 1000000000.0
    bounded: UiVirtualList::Metrics = UiVirtualList::metrics(huge, huge)
    check("oversized metrics clamp item extent", bounded.item_extent == UiVirtualList::MAX_GEOMETRY_EXTENT)
    check("oversized metrics clamp spacing", bounded.spacing == UiVirtualList::MAX_GEOMETRY_EXTENT)
    check("overflowed metrics stay inside geometry bound", bounded.stride == UiVirtualList::MAX_GEOMETRY_EXTENT)
    check("oversized content extent stays inside geometry bound", UiVirtualList::content_extent(UiVirtualList::MAX_ITEMS, huge, huge) == UiVirtualList::MAX_GEOMETRY_EXTENT)
    check("oversized item offset stays inside geometry bound", UiVirtualList::item_offset(UiVirtualList::MAX_ITEMS - 1, UiVirtualList::MAX_ITEMS, huge, huge) == UiVirtualList::MAX_GEOMETRY_EXTENT)

    check("content extent has no trailing gap", UiVirtualList::content_extent(3, 40.0, 8.0) == 136.0)
    check("empty content has zero extent", UiVirtualList::content_extent(0, 40.0, 8.0) == 0.0)
    check("item offsets use the stride", UiVirtualList::item_offset(2, 3, 40.0, 8.0) == 96.0)
    check("stale item offset clamps", UiVirtualList::item_offset(99, 3, 40.0, 8.0) == 96.0)
    check("empty item offset is safe", UiVirtualList::item_offset(0, 0, 40.0, 8.0) == 0.0)
    first_range: UiVirtualList::VisibleRange = UiVirtualList::visible_range(100, 40.0, 8.0, 0.0, 96.0, 4)
    check("top range includes an edge buffer", first_range.first == 0 and first_range.finish == 3)
    after_scroll: UiVirtualList::VisibleRange = UiVirtualList::visible_range(100, 40.0, 8.0, 96.0, 96.0, 4)
    check("scrolled range starts at the content row", after_scroll.first == 2 and after_scroll.finish == 5)
    capped: UiVirtualList::VisibleRange = UiVirtualList::visible_range(5, 40.0, 8.0, 0.0, 500.0, 2)
    check("range honors memory budget", capped.first == 0 and capped.finish == 2 and UiVirtualList::count(capped) == 2)
    end_range: UiVirtualList::VisibleRange = UiVirtualList::visible_range(5, 40.0, 8.0, 9999.0, 20.0, 4)
    check("tail range stays inside count", end_range.first == 4 and end_range.finish == 5 and UiVirtualList::contains(end_range, 4) and not UiVirtualList::contains(end_range, 3))
    blank: UiVirtualList::VisibleRange = UiVirtualList::visible_range(0, 40.0, 8.0, 0.0, 100.0, 4)
    check("empty range is half open", blank.first == 0 and blank.finish == 0 and UiVirtualList::count(blank) == 0)
    malformed: UiVirtualList::VisibleRange = UiVirtualList::visible_range(-10, -20.0, -8.0, -100.0, -50.0, 0)
    check("malformed range fails closed", malformed.first == 0 and malformed.finish == 0)

    if failures == 0:
        _ = puts("virtual list: all checks passed")
        return 0
    _ = puts("virtual list: FAILURES above")
    return 1
