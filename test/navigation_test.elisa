# Headless regression for shared back-navigation decisions.

include "../src/widgets/ui_navigation.elisa"

extern puts(text: cstr) -> i64
global mutable failures: i32 = 0

def check(name: cstr, ok: bool) -> void:
    return if ok
    failures <- failures + 1
    _ = puts(name)

def main() -> i64:
    UiNavigation::reset()
    check("empty navigation is unhandled", UiNavigation::request_back() == UiNavigation::BackDecision.Unhandled)

    root: UiNavigation::Handle = UiNavigation::push(10, UiNavigation::BackPolicy.Allow, false)
    check("allow entry is valid", UiNavigation::is_valid(root) and UiNavigation::owner(root) == 10)
    check("allow entry requests navigation", UiNavigation::request_back() == UiNavigation::BackDecision.Navigate)
    check("commit pops allowed entry", UiNavigation::commit(root) and UiNavigation::snapshot().entries == 0 and not UiNavigation::is_valid(root))

    dirty: UiNavigation::Handle = UiNavigation::push(20, UiNavigation::BackPolicy.Confirm, true)
    check("dirty confirm requests prompt", UiNavigation::request_back() == UiNavigation::BackDecision.Confirm and UiNavigation::snapshot().pending_confirmation)
    check("repeated back keeps prompt pending", UiNavigation::request_back() == UiNavigation::BackDecision.Confirm)
    check("cancel leaves dirty entry", UiNavigation::resolve_confirmation(false) == UiNavigation::BackDecision.Consumed and UiNavigation::is_valid(dirty) and UiNavigation::is_dirty(dirty))
    check("accepted confirmation navigates", UiNavigation::request_back() == UiNavigation::BackDecision.Confirm and UiNavigation::resolve_confirmation(true) == UiNavigation::BackDecision.Navigate and not UiNavigation::is_valid(dirty))

    consumed: UiNavigation::Handle = UiNavigation::push(30, UiNavigation::BackPolicy.Consume, false)
    check("consume entry handles back", UiNavigation::request_back() == UiNavigation::BackDecision.Consumed and UiNavigation::is_valid(consumed))
    check("owner dismissal releases entries", UiNavigation::dismiss_owner(30) == 1 and UiNavigation::snapshot().entries == 0)

    lower: UiNavigation::Handle = UiNavigation::push(50, UiNavigation::BackPolicy.Allow, false)
    upper: UiNavigation::Handle = UiNavigation::push(51, UiNavigation::BackPolicy.Allow, false)
    check("commit cannot skip the top entry", not UiNavigation::commit(lower) and UiNavigation::is_valid(lower) and UiNavigation::is_valid(upper))
    check("top entry still commits", UiNavigation::commit(upper) and UiNavigation::commit(lower))

    pending: UiNavigation::Handle = UiNavigation::push(60, UiNavigation::BackPolicy.Confirm, true)
    check("confirmation is pending before a newer entry", UiNavigation::request_back() == UiNavigation::BackDecision.Confirm)
    newer: UiNavigation::Handle = UiNavigation::push(61, UiNavigation::BackPolicy.Allow, false)
    check("confirmation cannot pop beneath a newer entry", UiNavigation::resolve_confirmation(true) == UiNavigation::BackDecision.Consumed and UiNavigation::is_valid(pending) and UiNavigation::is_valid(newer))
    _ = UiNavigation::commit(newer)
    _ = UiNavigation::commit(pending)

    stale: UiNavigation::Handle = UiNavigation::push(40, UiNavigation::BackPolicy.Allow, false)
    check("dirty mutation is explicit", UiNavigation::set_dirty(stale, true) and UiNavigation::is_dirty(stale) and not UiNavigation::set_dirty(stale, true))
    check("stale commit is rejected", UiNavigation::commit(UiNavigation::Handle{slot: stale.slot, generation: stale.generation + 1}) == false and UiNavigation::is_valid(stale))
    _ = UiNavigation::commit(stale)

    handles: UiNavigation::Handle[UiNavigation::MAX_ENTRIES] = zeroed
    for index in 0..<UiNavigation::MAX_ENTRIES:
        handles[index] <- UiNavigation::push(index.u32(), UiNavigation::BackPolicy.Allow, false)
    overflow: UiNavigation::Handle = UiNavigation::push(99, UiNavigation::BackPolicy.Allow, false)
    check("capacity overflow is visible", not UiNavigation::is_valid(overflow) and UiNavigation::overflowed() and UiNavigation::snapshot().entries == UiNavigation::MAX_ENTRIES)
    for index in 0..<UiNavigation::MAX_ENTRIES:
        _ = UiNavigation::commit(handles[index])

    if failures == 0:
        _ = puts("navigation: all checks passed")
        return 0
    _ = puts("navigation: FAILURES above")
    return 1
