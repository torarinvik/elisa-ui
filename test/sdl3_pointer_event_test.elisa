# Verify SDL3 mouse-button ABI offsets through the real queue and dummy video
# driver. Mouse motion uses x/y at byte offsets 28/32; button events use the
# same coordinates after their button-state bytes, at 28/32 in SDL3's packed
# event layout. This test stays headless and never foregrounds a window.

include "../src/platform/sdl3/ui_sdl3.elisa"

extern SDL_setenv_unsafe(name: cstr, value: cstr, overwrite: i32) -> i32
extern SDL_PushEvent(event: void&) -> bool
extern puts(text: cstr) -> i64

global mutable failures: i32 = 0
global mutable saw_down: bool = false
global mutable saw_up: bool = false

def push_button(kind: u32, button: u8, x: f32, y: f32) -> void:
    event: mutable u64[16] = zeroed
    fields: mutable u32& = (&event[0]).cast[mutable u32&] can Unsafe.PointerCast
    fields[0] <- kind
    bytes: mutable u8& = (&event[0]).cast[mutable u8&] can Unsafe.PointerCast
    bytes[24] <- button
    # SDL_MouseButtonEvent places down and click-count immediately after the
    # one-byte button field. This catches adapters that accidentally read a
    # four-byte word at offset 24.
    bytes[25] <- 1
    bytes[26] <- 1
    coords: mutable f32& = (&event[0]).cast[mutable f32&] can Unsafe.PointerCast
    coords[7] <- x
    coords[8] <- y
    pointer: void& = (&event[0]).cast[void&] can Unsafe.PointerCast
    if not SDL_PushEvent(pointer):
        failures <- failures + 1

def app_init() -> void:
    push_button(0x401, 1, 12.5, 34.25)
    push_button(0x402, 1, 12.5, 34.25)

def app_event(event: UiCore::Event) -> void:
    match event:
        UiCore::PointerEvent.Down(at, button):
            saw_down <- true
            failures <- failures + 1 if button != 0 or at.x != 12.5 or at.y != 34.25
        UiCore::PointerEvent.Up(at, button):
            saw_up <- true
            failures <- failures + 1 if button != 0 or at.x != 12.5 or at.y != 34.25
        _:
            pass

def app_frame() -> void:
    pass

def app_text_input(text: sview) -> void:
    pass

def app_text_editing(text: sview, selected_start: i32, selected_length: i32) -> void:
    pass

def main() -> i64:
    _ = SDL_setenv_unsafe("SDL_VIDEODRIVER", "dummy", 1)
    result: i64 = UiSdl3::run("headless pointer regression", 64, 64, 1)
    if result != 0 or not saw_down or not saw_up:
        failures <- failures + 1
    if failures == 0:
        _ = puts("SDL pointer coordinates: passed")
    return failures.i64()
