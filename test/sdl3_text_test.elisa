# SDL_ttf measurement checks for the native backend. These assert that a real
# font is opened and consulted, rather than that the program merely links: a
# missing font would silently measure everything as zero, which layout would
# accept while producing collapsed widgets.

include "../src/platform/sdl3/ui_sdl3_flat.elisa"

global mutable text_failures: i32 = 0
global mutable committed_text_seen: bool = false
global mutable editing_text_seen: bool = false
global mutable bounded_committed_text_seen: bool = false
global mutable bounded_editing_text_seen: bool = false
global mutable bounded_editing_selection_seen: bool = false
global mutable negative_editing_selection_seen: bool = false
global mutable scalar_editing_selection_seen: bool = false
global mutable oversized_text: u8[4097] = zeroed
global mutable unterminated_text: u8[UiCore::MAX_TEXT_BYTES] = zeroed

# The backend calls into the app contract; a measurement test has no app.
def app_init() -> void:
    pass

def app_event(event: mutable UiCore::Event&) -> void:
    pass

def app_text_input(text: sview) -> void:
    committed_text_seen <- text == "Grüße 👋"
    bounded_committed_text_seen <- text.len == UiCore::MAX_TEXT_BYTES.i64()

def app_text_editing(text: sview, selected_start: i32, selected_length: i32) -> void:
    editing_text_seen <- text == "にほん" and selected_start == 1 and selected_length == 2
    bounded_editing_text_seen <- text.len == UiCore::MAX_TEXT_BYTES.i64()
    bounded_editing_selection_seen <- selected_start == UiCore::MAX_TEXT_BYTES.i32() and selected_length == 0
    negative_editing_selection_seen <- selected_start == 0 and selected_length == 0
    scalar_editing_selection_seen <- text == "é" and selected_start == 1 and selected_length == 0

def app_frame() -> void:
    pass

def app_widget_event(widget: usize, event: i32) -> void:
    pass

def check(name: cstr, ok: bool) -> void:
    return if ok
    text_failures <- text_failures + 1
    _ = puts(name)

def null_clipboard_write_is_rejected() -> bool can Unsafe.PointerCast:
    bytes: u8& = 0.uintptr().cast[u8&] can Unsafe.PointerCast
    return not ui_clipboard_write(bytes, 1)

def null_clipboard_read_is_ignored() -> bool can Unsafe.PointerCast:
    buffer: mutable u8& = 0.uintptr().cast[mutable u8&] can Unsafe.PointerCast
    return ui_clipboard_read(buffer, 1) == 0

def main() -> i64:
    check("SDL rejects a null clipboard write buffer", null_clipboard_write_is_rejected())
    check("SDL ignores a null clipboard read buffer", null_clipboard_read_is_ignored())
    # A cached native snapshot belongs to the lifecycle generation that read
    # it. Starting a replacement session must scrub and invalidate that cache
    # before another `has_text`/paste decision can observe it.
    UiLifecycle::reset()
    sdl_flat_clipboard_read[0] <- 115
    sdl_flat_clipboard_length <- 1
    sdl_flat_clipboard_cache_valid <- true
    sdl_flat_clipboard_generation <- UiLifecycle::generation()
    _ = UiLifecycle::begin()
    check("SDL clipboard cache is generation-scoped", not sdl_flat_clipboard_cache_current() and not sdl_flat_clipboard_cache_valid and sdl_flat_clipboard_length == 0 and sdl_flat_clipboard_read[0] == 0)
    if not TTF_Init():
        _ = puts(SDL_GetError())
        return 2

    narrow: f32 = ui_measure_text_width("i", 20.0)
    wide: f32 = ui_measure_text_width("MMMMMMMMMM", 20.0)
    check("a font opened and measured a non-zero width", narrow > 0.0)
    check("wider text measures wider", wide > narrow)

    # A proportional font is the point of using SDL_ttf: ten Ms must be much
    # more than ten times an i would be under a monospace approximation.
    check("measurement is proportional, not monospace", wide > narrow * 10.0)

    small: f32 = ui_measure_text_width("Save", 12.0)
    large: f32 = ui_measure_text_width("Save", 24.0)
    check("larger point size measures wider", large > small)

    check("line height is positive", ui_text_line_height(20.0) > 0.0)
    check("line height grows with size", ui_text_line_height(32.0) > ui_text_line_height(12.0))
    check("ascent is positive and within the line", ui_font_ascent(20.0) > 0.0 and ui_font_ascent(20.0) <= ui_text_line_height(20.0))
    check("empty text measures zero", ui_measure_text_width("", 20.0) == 0.0)
    malformed_view_words: mutable u64[2] = zeroed
    malformed_view_words[1] <- 4
    malformed_view_ref: mutable sview& = (&malformed_view_words[0]).cast[mutable sview&] can Unsafe.PointerCast
    null_view: sview = malformed_view_ref[0]
    check("null-backed counted text measures zero", ui_measure_text_width(null_view, 20.0) == 0.0)

    UiSdl3::text_input("Grüße 👋")
    check("SDL committed UTF-8 reaches the application intact", committed_text_seen)
    UiSdl3::text_editing("にほん", 1, 2)
    check("SDL marked UTF-8 and selection reach the application intact", editing_text_seen)
    UiSdl3::text_editing("é", 2, 1)
    check("SDL scalar selection bounds use characters, not bytes", scalar_editing_selection_seen)

    for index in 0..<4096:
        oversized_text[index] <- 120
    oversized_text[4096] <- 0
    oversized_pointer: cstr = (&oversized_text[0]).cast[cstr] can Unsafe.PointerCast
    UiSdl3::text_input(oversized_pointer)
    UiSdl3::text_editing(oversized_pointer, 2147483647, 2147483647)
    check("SDL committed text bounds hostile NUL strings", bounded_committed_text_seen)
    check("SDL marked text bounds hostile NUL strings", bounded_editing_text_seen)
    check("SDL marked selection stays inside bounded text", bounded_editing_selection_seen)
    for index in 0..<UiCore::MAX_TEXT_BYTES:
        unterminated_text[index] <- 121
    unterminated_pointer: cstr = (&unterminated_text[0]).cast[cstr] can Unsafe.PointerCast
    unterminated_view: sview = UiSdl3Text::bounded_view(unterminated_pointer)
    check("SDL bounded view handles an unterminated text span", unterminated_view.len == UiCore::MAX_TEXT_BYTES.i64())
    UiSdl3::text_input(unterminated_pointer)
    UiSdl3::text_editing(unterminated_pointer, 2147483647, 2147483647)
    check("SDL committed input bounds an unterminated span", bounded_committed_text_seen)
    check("SDL marked input bounds an unterminated span", bounded_editing_text_seen and bounded_editing_selection_seen)
    UiSdl3::text_editing("x", -1, -1)
    check("SDL rejects negative marked selection offsets", negative_editing_selection_seen)

    # The size table must reuse an already-open font rather than growing.
    before: usize = UiSdl3::font_count()
    _ = ui_measure_text_width("again", 20.0)
    check("repeat sizes reuse the cached font", UiSdl3::font_count() == before)

    UiSdl3::fonts_close()
    check("closing releases every cached font", UiSdl3::font_count() == 0)
    TTF_Quit()

    if text_failures == 0:
        _ = puts("sdl3 text: all checks passed")
        return 0
    _ = puts("sdl3 text: FAILURES above")
    return 1
