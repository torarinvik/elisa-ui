# Verify SDL3 window-resize payload offsets through the real queue and dummy
# video driver; this stays headless and never foregrounds a window.

include "../src/platform/sdl3/ui_sdl3.elisa"

extern SDL_setenv_unsafe(name: cstr, value: cstr, overwrite: i32) -> i32
extern SDL_PushEvent(event: void&) -> bool
extern puts(text: cstr) -> i64

global mutable failures: i32 = 0
global mutable saw_resize: bool = false

def push_resize(width: i32, height: i32) -> void:
    event: mutable u64[16] = zeroed
    fields: mutable i32& = (&event[0]).cast[mutable i32&] can Unsafe.PointerCast
    fields[0] <- 0x206
    # SDL_WindowEvent.data1/data2 are the seventh/eighth 32-bit words
    # (offsets 24 and 28), after the 64-bit timestamp and window ID.
    fields[6] <- width
    fields[7] <- height
    pointer: void& = (&event[0]).cast[void&] can Unsafe.PointerCast
    if not SDL_PushEvent(pointer):
        failures <- failures + 1

def app_init() -> void:
    push_resize(320, 200)

def app_event(event: UiCore::Event) -> void:
    match event:
        UiCore::Event.Resize(size):
            saw_resize <- true
            failures <- failures + 1 if size.width != 320.0 or size.height != 200.0
        _:
            pass

def app_text_input(text: sview) -> void:
    pass

def app_text_editing(text: sview, selected_start: i32, selected_length: i32) -> void:
    pass

def app_frame() -> void:
    pass

def main() -> i64:
    _ = SDL_setenv_unsafe("SDL_VIDEODRIVER", "dummy", 1)
    result: i64 = UiSdl3::run("headless resize regression", 64, 64, 1)
    if result != 0 or not saw_resize or UiCore::viewport_width() != 320.0 or UiCore::viewport_height() != 200.0:
        failures <- failures + 1
    if failures == 0:
        _ = puts("SDL resize payload: passed")
    return failures.i64()
