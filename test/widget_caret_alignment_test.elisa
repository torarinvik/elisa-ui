# Direction-aware retained caret geometry.
#
# The public text-caret query returns a rectangle origin for native protocols;
# the retained painter fills that same one-point rectangle. Keep both
# directions in a focused fixture so this contract stays visible without
# growing the broader text-editing corpus.

include "./widget_layout_support.elisa"

def caret_rect() -> UiCore::Rect:
    for index in 0..<UiCore::command_count():
        match UiCore::command_at(index):
            UiCore::Command.FillRect(box, color):
                return box if box.size.width == UiCore::DEFAULT_STROKE_WIDTH and box.size.height > 0.0
            _:
                pass
    return UiCore::Rect(0.0, 0.0, 0.0, 0.0)

def main() -> i64:
    UiFlat::reset()
    field: usize = UiFlat::text_field(UiFlat::NONE, "Name", "", "abcd", 200.0, 30.0, 15.0, UiCore::rgb(240, 240, 245), UiCore::rgb(30, 34, 44))
    _ = UiFlat::request_focus(field)
    UiFlat::layout(200.0, 30.0)
    UiCore::begin_frame()
    UiFlat::paint()
    ltr_origin: f32 = UiFlat::text_caret_x(field)
    ltr_rect: UiCore::Rect = caret_rect()
    check("ltr caret uses its public rectangle origin", near(ltr_rect.origin.x, ltr_origin) and ltr_rect.size.width == UiCore::DEFAULT_STROKE_WIDTH)

    _ = UiLocalization::set_locale("he-IL")
    UiCore::begin_frame()
    UiFlat::paint()
    rtl_origin: f32 = UiFlat::text_caret_x(field)
    rtl_rect: UiCore::Rect = caret_rect()
    check("rtl caret uses its public rectangle origin", near(rtl_rect.origin.x, rtl_origin) and rtl_rect.size.width == UiCore::DEFAULT_STROKE_WIDTH)

    if test_failures == 0:
        _ = puts("widget caret alignment: all checks passed")
        return 0
    _ = puts("widget caret alignment: FAILURES above")
    return 1
