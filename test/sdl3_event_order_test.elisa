# Exercise the real SDL queue with a dummy video driver; no desktop window.
include "../src/platform/sdl3/ui_sdl3.elisa"

extern SDL_setenv_unsafe(name: cstr, value: cstr, overwrite: i32) -> i32
extern SDL_PushEvent(event: void&) -> bool

struct TextEvent:
    kind: u32
    reserved: u32
    timestamp: u64
    window: u32
    padding: u32
    text: cstr

global mutable received_keys: i32 = 0
global mutable failures: i32 = 0
global mutable saw_text: bool = false
global mutable saw_quit: bool = false

def push_key() -> void:
    event: mutable u64[16] = zeroed
    fields: mutable u32& = (&event[0]).cast[mutable u32&] can Unsafe.PointerCast
    fields[0] <- 0x300
    fields[7] <- 97
    pointer: void& = (&event[0]).cast[void&] can Unsafe.PointerCast
    if not SDL_PushEvent(pointer):
        failures <- failures + 1

def app_init() -> void:
    for index in 0..<300:
        push_key()
    event: mutable u64[16] = zeroed
    text_event: mutable TextEvent& = (&event[0]).cast[mutable TextEvent&] can Unsafe.PointerCast
    text_event[0] <- TextEvent{kind: 0x303, reserved: 0, timestamp: 0, window: 0, padding: 0, text: "a"}
    pointer: void& = (&event[0]).cast[void&] can Unsafe.PointerCast
    if not SDL_PushEvent(pointer):
        failures <- failures + 1
    close_event: mutable u64[16] = zeroed
    close_fields: mutable u32& = (&close_event[0]).cast[mutable u32&] can Unsafe.PointerCast
    close_fields[0] <- 0x210
    close_pointer: void& = (&close_event[0]).cast[void&] can Unsafe.PointerCast
    if not SDL_PushEvent(close_pointer):
        failures <- failures + 1

def app_event(event: UiCore::Event) -> void:
    match event:
        UiCore::KeyEvent.Down(code):
            received_keys <- received_keys + 1
        UiCore::Event.Quit:
            saw_quit <- true
        _:
            pass

def app_text_input(text: sview) -> void:
    saw_text <- true
    failures <- failures + 1 if received_keys != 300 or text != "a"

def app_text_editing(text: sview, start: i32, length: i32) -> void:
    pass

def app_frame() -> void:
    pass

def main() -> i64:
    _ = SDL_setenv_unsafe("SDL_VIDEODRIVER", "dummy", 1)
    result: i64 = UiSdl3::run("headless event regression", 64, 64, 1)
    if result != 0 or not saw_text or not saw_quit or received_keys != 300 or UiEvents::dropped() != 0:
        failures <- failures + 1
    if failures == 0:
        _ = puts("SDL event ordering: passed")
    return failures.i64()
