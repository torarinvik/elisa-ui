# The C bridge is real code, so it is compiled and exercised rather than left to
# rot: a C host's six scalars must arrive at `app_event` as the right variant.
#
# It also pins the direction the round-trip test cannot: `elisa_ui_dispatch_event`
# is what a C caller actually invokes, and it must not require the caller to know
# anything but the ordinal.

include "../src/capi/ui_capi.elisa"

extern puts(text: cstr) -> i64

global mutable seen_kind: i32 = -1
global mutable seen_x: f32 = 0.0
global mutable seen_code: i32 = 0
global mutable first_seen_kind: i32 = -1
global mutable first_seen_x: f32 = 0.0
global mutable first_seen_code: i32 = 0
global mutable seen_text: bool = false
global mutable malformed_text_seen: bool = false
global mutable text_callbacks: i32 = 0
global mutable nested_text_attempted: bool = false
global mutable event_callbacks: i32 = 0
global mutable nested_event_attempted: bool = false
global mutable nested_event_seen: bool = false
global mutable test_failures: i32 = 0

def app_event(event: UiCore::Event) -> void:
    event_callbacks <- event_callbacks + 1
    seen_kind <- UiCore::wire_kind(event)
    record: UiCore::EventRecord = UiCore::to_record(event)
    seen_x <- record.x
    seen_code <- record.code
    if event_callbacks == 1:
        first_seen_kind <- seen_kind
        first_seen_x <- record.x
        first_seen_code <- record.code
    if not nested_event_attempted and seen_kind == 3:
        nested_event_attempted <- true
        elisa_ui_dispatch_event(6, 0.0, 0.0, 0.0, 0.0, 65)
    nested_event_seen <- true if seen_kind == 6

def app_text_input(text: sview) -> void:
    text_callbacks <- text_callbacks + 1
    seen_text <- text == "Hé 👋"
    malformed_text_seen <- text.len == 1 and text.data[0] == 65
    if not nested_text_attempted:
        nested_text_attempted <- true
        elisa_ui_dispatch_text_input("nested", "nested".len)

def check(name: cstr, ok: bool) -> void:
    return if ok
    test_failures <- test_failures + 1
    _ = puts(name)

def main() -> i64:
    check("C ABI version is packed in Elisa", elisa_ui_abi_version() == 0x000100)
    elisa_ui_dispatch_event(3, 12.0, 34.0, 0.0, 0.0, 2)
    check("a C pointer-down arrives as kind 3", first_seen_kind == 3)
    check("a C pointer-down keeps its position", first_seen_x == 12.0)
    check("a C pointer-down keeps its button", first_seen_code == 2)
    check("nested C event is queued without recursive loss", nested_event_attempted and nested_event_seen and event_callbacks == 2)

    elisa_ui_dispatch_event(6, 0.0, 0.0, 0.0, 0.0, 65)
    check("a C key-down arrives as kind 6", seen_kind == 6)
    check("a C key-down keeps its code", seen_code == 65)

    elisa_ui_dispatch_event(13, 0.0, 0.0, 0.0, 0.0, 0)
    check("a C focus-loss event arrives as kind 13", seen_kind == 13)

    zero: f32 = 0.0
    nan: f32 = zero / zero
    before_malformed_event_callbacks: i32 = event_callbacks
    elisa_ui_dispatch_event(3, nan, 12.0, 0.0, 0.0, 0)
    check("C host rejects non-finite pointer coordinates", event_callbacks == before_malformed_event_callbacks)
    elisa_ui_dispatch_event(9, 12.0, 24.0, 0.0, nan, 0)
    check("C host rejects non-finite scroll deltas", event_callbacks == before_malformed_event_callbacks)

    elisa_ui_dispatch_text_input("Hé 👋", "Hé 👋".len)
    check("C committed UTF-8 reaches the Elisa application intact", seen_text)
    check("nested C text dispatch is rejected", nested_text_attempted and text_callbacks == 1)
    check("C text staging buffer is scrubbed after callback", UiCapi::text_buffer_cleared())
    invalid_text: mutable u8[3] = zeroed
    invalid_text[0] <- 65
    invalid_text[1] <- 255
    invalid_text[2] <- 66
    invalid_text_pointer: cstr = (&invalid_text[0]).cast[cstr] can Unsafe.PointerCast
    elisa_ui_dispatch_text_input(invalid_text_pointer, 3)
    check("C host text rejects malformed UTF-8 before app delivery", malformed_text_seen and text_callbacks == 2)

    elisa_ui_dispatch_event(99, 0.0, 0.0, 0.0, 0.0, 0)
    check("an unmodelled ordinal arrives as None", seen_kind == 0)

    elisa_ui_set_viewport(640.0, 480.0)
    check("the viewport crosses the boundary", elisa_ui_viewport_width() == 640.0 and elisa_ui_viewport_height() == 480.0)
    elisa_ui_set_viewport(-4.0, -8.0)
    check("negative viewport extents normalize in Elisa", elisa_ui_viewport_width() == 0.0 and elisa_ui_viewport_height() == 0.0)
    elisa_ui_set_viewport(640.0, 480.0)

    if test_failures == 0:
        _ = puts("capi bridge: all checks passed")
        return 0
    _ = puts("capi bridge: FAILURES above")
    return 1
