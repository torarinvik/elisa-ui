# The construction API as an application would use it: build children, chain
# them, hand the chain to a parent, lay out, click.

include "../src/core/ui_core.elisa"
include "../src/widgets/ui_hierarchy.elisa"
include "../src/widgets/ui_ops.elisa"
include "../src/widgets/ui_build.elisa"

extern puts(text: cstr) -> i64

global mutable failures: i32 = 0
global mutable clicks: i32 = 0

def ui_measure_text_width(text: sview, size: f32) -> f32:
    return text.len.f32() * size * 0.5
def ui_measure_text_height(text: sview, size: f32) -> f32:
    return size
def ui_font_ascent(size: f32) -> f32:
    return size
def ui_text_line_height(size: f32) -> f32:
    return size

def app_widget_event(widget: Widget, event: i32) -> void:
    clicks <- clicks + 1 if event == UI_WIDGET_EVENT_CLICK

def fail(name: cstr) -> void:
    failures <- failures + 1
    _ = puts(name)

def near(actual: f32, expected: f32) -> bool:
    delta: f32 = actual - expected if actual > expected else expected - actual
    return delta < 0.01

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        panel: UiColor = ui_rgb(30, 30, 34)
        accent: UiColor = ui_rgb(60, 110, 190)

        # A toolbar: label on the left, a growing spacer, two buttons right.
        title: Widget = ui_label("Document", 14.0, ui_rgb(230, 230, 230))
        save: Widget = ui_button("Save", accent)
        quit: Widget = ui_button("Quit", accent)

        # Chain them: title -> save -> quit.
        quit_linked: Widget = ui_sibling(quit, null)
        save_linked: Widget = ui_sibling(save, quit_linked)
        title_linked: Widget = ui_grow(ui_sibling(title, save_linked), 1.0)

        bar: Widget = ui_children(ui_row(8.0, 6.0, panel), title_linked)
        ui_layout(bar, 400.0, 48.0)

        if not near(bar.width, 400.0):
            fail("toolbar width")

        # The title grows, so it absorbs the slack and the buttons keep their
        # natural widths. Buttons are label * 7 + 20 wide: Save 48, Quit 48.
        first: Widget? = bar.first_child
        if first is title_node:
            if not near(title_node.x, 8.0):
                fail("title x")
            # 400 - 16 padding - 12 spacing - 48 - 48 = 276
            if not near(title_node.width, 276.0):
                fail("title absorbs slack")
        else:
            fail("toolbar has no children")

        # Clicking the Save button reports one click; clicking the inert title
        # reports none.
        ui_pointer(bar, UI_EVENT_POINTER_DOWN, save.x + 4.0, save.y + 4.0)
        ui_pointer(bar, UI_EVENT_POINTER_UP, save.x + 4.0, save.y + 4.0)
        if clicks != 1:
            fail("save click")

        ui_pointer(bar, UI_EVENT_POINTER_DOWN, 12.0, 24.0)
        ui_pointer(bar, UI_EVENT_POINTER_UP, 12.0, 24.0)
        if clicks != 1:
            fail("label should not click")

        return failures.i64()
