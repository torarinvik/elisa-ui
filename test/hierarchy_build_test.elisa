# The construction API as an application would use it: build children, chain
# them, hand the chain to a parent, lay out, click.

include "../src/widgets/ui_build.elisa"

using UiWidgets

extern puts(text: cstr) -> i64

global mutable failures: i32 = 0
global mutable clicks: i32 = 0

def ui_measure_text_width(text: sview, size: f32, weighted: bool) -> f32:
    return text.len.f32() * size * 0.5
def ui_measure_text_height(text: sview, size: f32) -> f32:
    return size
def ui_font_ascent(size: f32) -> f32:
    return size
def ui_text_line_height(size: f32) -> f32:
    return size

def app_widget_event(widget: UiWidgets::Widget, event: i32) -> void:
    clicks <- clicks + 1 if event == UiConst::WidgetEvent.Click.i32()

def fail(name: cstr) -> void:
    failures <- failures + 1
    _ = puts(name)

def near(actual: f32, expected: f32) -> bool:
    delta: f32 = actual - expected if actual > expected else expected - actual
    return delta < 0.01

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        panel: UiCore::Color = UiCore::rgb(30, 30, 34)
        accent: UiCore::Color = UiCore::rgb(60, 110, 190)

        # A toolbar: label on the left, a growing spacer, two buttons right.
        title: Widget = label("Document", 14.0, UiCore::rgb(230, 230, 230))
        save: Widget = button("Save", accent)
        quit: Widget = button("Quit", accent)

        # Chain them: title -> save -> quit.
        quit_linked: Widget = sibling(quit, null)
        save_linked: Widget = sibling(save, quit_linked)
        title_linked: Widget = grow(sibling(title, save_linked), 1.0)

        bar: Widget = children(row(8.0, 6.0, panel), title_linked)
        layout(bar, 400.0, 48.0)

        if not near(bar.width, 400.0):
            fail("toolbar width")

        # The title grows, so it absorbs the slack and the buttons keep their
        # natural widths. Buttons are label * 7 + 20 wide: Save 48, Quit 48.
        first: Widget? = bar.first_child
        if first is title_node:
            if not near(title_node.x, 8.0):
                fail("title x")
            # 400 - 16 padding - 12 spacing - 48 - 48 = 276
            if not near(title_node.width, 276.0):
                fail("title absorbs slack")
        else:
            fail("toolbar has no children")

        # Clicking the Save button reports one click; clicking the inert title
        # reports none.
        pointer(bar, (UiCore::PointerEvent.Down(at: UiCore::Vec2(save.x + 4.0, save.y + 4.0), button: 0)))
        pointer(bar, (UiCore::PointerEvent.Up(at: UiCore::Vec2(save.x + 4.0, save.y + 4.0), button: 0)))
        if clicks != 1:
            fail("save click")

        pointer(bar, (UiCore::PointerEvent.Down(at: UiCore::Vec2(12.0, 24.0), button: 0)))
        pointer(bar, (UiCore::PointerEvent.Up(at: UiCore::Vec2(12.0, 24.0), button: 0)))
        if clicks != 1:
            fail("label should not click")

        # The public builders cover every container/window variant without
        # exposing the hierarchy's full common record to applications.
        palette: Widget = floating_window("Palette")
        fixed_window: Widget = window("Fixed", false)
        if not can_nest(palette) or not can_nest(fixed_window):
            fail("window builders")
        matrix: Widget = grid(2, 4.0, 2.0, panel)
        matrix_child: Widget = button("A", accent)
        matrix_child.next_sibling <- button("B", accent)
        children(matrix, matrix_child)
        layout(matrix, 120.0, 80.0)
        if matrix_child.next_sibling is second:
            if not near(second.x, 61.0):
                fail("grid builder")
        else:
            fail("grid builder child chain")

        viewport: Widget = scroll(UiConst::Axis.Column, 8.0, panel)
        viewport.first_child <- button("Item", accent)
        layout(viewport, 120.0, 80.0)
        if viewport.first_child is item:
            if not near(item.y, 0.0):
                fail("scroll builder clamps short content")

        viewport_state: ScrollState = ScrollState{offset: -8.0}
        stateful_viewport: Widget = scroll_with_state(UiConst::Axis.Column, &viewport_state, panel)
        if viewport_state.offset != 0.0 or not can_nest(stateful_viewport):
            fail("stateful scroll builder")

        toggle_control: Widget = toggle("Enabled", true, accent)
        radio_control: Widget = radio("Choice", 7, true, accent)
        field_control: Widget = text_box("Hello", 14.0, UiCore::rgb(240, 240, 240), panel)
        match toggle_control:
            Button.Toggle(label, on, rest, hover, press):
                if not on:
                    fail("toggle builder state")
            _:
                fail("toggle builder kind")
        match radio_control:
            Button.Radio(label, group, selected, rest, hover, press):
                if group != 7 or not selected:
                    fail("radio builder state")
            _:
                fail("radio builder kind")
        match field_control:
            Control.TextBox(text, caret, size, ink, fill):
                if text != "Hello" or caret != 5:
                    fail("text box builder state")
            _:
                fail("text box builder kind")

        # Public builders normalize hostile inputs before they enter the
        # retained hierarchy. This keeps application code on the same
        # nonnegative/range-safe contract as the flat API and the layout pass.
        invalid_row: Widget = row(-8.0, -3.0, panel)
        match invalid_row:
            Container.Box(axis, padding, spacing, fill):
                if padding != 0.0 or spacing != 0.0:
                    fail("row builder clamps geometry")
            _:
                fail("row builder kind")

        huge_geometry: f32 = 3.0e38
        bounded_row: Widget = row(huge_geometry, huge_geometry, panel)
        match bounded_row:
            Container.Box(axis, padding, spacing, fill):
                if padding != UiCore::MAX_GEOMETRY_EXTENT or spacing != UiCore::MAX_GEOMETRY_EXTENT:
                    fail("row builder bounds oversized geometry")
            _:
                fail("bounded row builder kind")

        invalid_grid: Widget = grid(0, -4.0, -2.0, panel)
        match invalid_grid:
            Container.Grid(columns, padding, spacing, fill):
                if columns != 1 or padding != 0.0 or spacing != 0.0:
                    fail("grid builder clamps geometry")
            _:
                fail("grid builder kind")

        adaptive: Widget = adaptive_grid(500.0, 160.0, 4, 4.0, 16.0, panel)
        match adaptive:
            Container.Grid(columns, padding, spacing, fill):
                if columns != 2:
                    fail("adaptive grid uses logical width")
            _:
                fail("adaptive grid builder kind")

        invalid_label: Widget = label("invalid", -10.0, panel)
        match invalid_label:
            Control.Label(text, size, ink):
                if size != 0.0 or invalid_label.min_width != 0.0 or invalid_label.min_height != 0.0:
                    fail("label builder clamps metrics")
            _:
                fail("label builder kind")

        invalid_gauge: Widget = gauge(2.0, panel, accent)
        match invalid_gauge:
            Control.Gauge(fraction, track, bar):
                if fraction != 1.0:
                    fail("gauge builder clamps fraction")
            _:
                fail("gauge builder kind")

        invalid_growth: Widget = grow(button("Growth", accent), -4.0)
        if invalid_growth.grow != 0.0:
            fail("grow builder clamps negative weights")

        bounded_growth: Widget = grow(button("Growth", accent), huge_geometry)
        if bounded_growth.grow != UiCore::MAX_GEOMETRY_EXTENT:
            fail("grow builder bounds oversized weights")

        invalid_scroll: Widget = scroll(UiConst::Axis.Column, -8.0, panel)
        match invalid_scroll:
            Container.Scroll(axis, offset, fill):
                if offset != 0.0:
                    fail("scroll builder clamps negative offsets")
            _:
                fail("scroll builder kind")

        bounded_scroll: Widget = scroll(UiConst::Axis.Column, huge_geometry, panel)
        match bounded_scroll:
            Container.Scroll(axis, offset, fill):
                if offset != UiCore::MAX_GEOMETRY_EXTENT:
                    fail("scroll builder bounds oversized offsets")
            _:
                fail("bounded scroll builder kind")

        bounded_state: ScrollState = ScrollState{offset: huge_geometry}
        _ = scroll_with_state(UiConst::Axis.Column, &bounded_state, panel)
        if bounded_state.offset != UiCore::MAX_GEOMETRY_EXTENT:
            fail("stateful scroll builder bounds oversized offsets")

        # A STATE THAT SHOWS AT BOTH ENDS OF THE RANGE. Hover was a fixed +30
        # on every channel and press a fixed -30: fine on a mid-tone surface,
        # nothing at all on a near-white one, where the addition clips. A light
        # theme had no hover feedback, and press moved the opposite way from
        # hover for no reason -- which reads as a different control rather than
        # a stronger version of the same signal.
        paper: UiCore::Color = UiCore::rgb(250, 250, 252)
        slate: UiCore::Color = UiCore::rgb(36, 40, 50)
        paper_hover: i64 = UiCore::surface_luminance(state_shift(paper, HOVER_STATE_SHIFT))
        slate_hover: i64 = UiCore::surface_luminance(state_shift(slate, HOVER_STATE_SHIFT))
        if paper_hover >= UiCore::surface_luminance(paper):
            fail("a light surface must darken under the pointer")
        if slate_hover <= UiCore::surface_luminance(slate):
            fail("a dark surface must lighten under the pointer")
        if UiCore::surface_luminance(paper) - paper_hover < 12:
            fail("a near-white surface must still move visibly")
        if UiCore::surface_luminance(state_shift(paper, PRESS_STATE_SHIFT)) >= paper_hover:
            fail("pressing a light surface must go further than hovering it")
        if UiCore::surface_luminance(state_shift(slate, PRESS_STATE_SHIFT)) <= slate_hover:
            fail("pressing a dark surface must go further than hovering it")

        return failures.i64()
