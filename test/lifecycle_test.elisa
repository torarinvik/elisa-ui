# Headless regression for the shared lifecycle state machine.

include "../src/core/ui_lifecycle.elisa"

extern puts(text: cstr) -> i64

global mutable failures: i32 = 0

def check(name: cstr, ok: bool) -> void:
    return if ok
    failures <- failures + 1
    _ = puts(name)

def main() -> i64:
    UiLifecycle::reset()
    initial: UiLifecycle::Snapshot = UiLifecycle::snapshot()
    check("lifecycle starts new", initial.phase == UiLifecycle::Phase.New and not initial.surface_available and not initial.can_render)
    check("lifecycle rejects ready before begin", not UiLifecycle::ready())

    check("lifecycle begins once", UiLifecycle::begin())
    started: UiLifecycle::Snapshot = UiLifecycle::snapshot()
    check("begin enters starting", started.phase == UiLifecycle::Phase.Starting and started.generation == 1 and not started.accepts_input)
    check("lifecycle rejects duplicate begin", not UiLifecycle::begin())
    check("lifecycle becomes ready", UiLifecycle::ready())
    active: UiLifecycle::Snapshot = UiLifecycle::snapshot()
    check("ready without focus is inactive", active.phase == UiLifecycle::Phase.Inactive and active.surface_available and active.can_render and not active.accepts_input)

    check("focus gain activates input", UiLifecycle::focus_gained())
    check("active accepts input", UiLifecycle::accepts_input() and UiLifecycle::phase() == UiLifecycle::Phase.Active)
    check("focus loss preserves the surface", UiLifecycle::focus_lost() and UiLifecycle::phase() == UiLifecycle::Phase.Inactive and UiLifecycle::surface_available())
    check("focus gain is repeatable", UiLifecycle::focus_gained() and UiLifecycle::accepts_input())

    check("suspend enters background", UiLifecycle::suspend() and UiLifecycle::phase() == UiLifecycle::Phase.Background and not UiLifecycle::accepts_input() and not UiLifecycle::can_render())
    check("resume restores active state", UiLifecycle::resume() and UiLifecycle::phase() == UiLifecycle::Phase.Active and UiLifecycle::accepts_input())

    check("surface loss is explicit", UiLifecycle::surface_lost() and UiLifecycle::phase() == UiLifecycle::Phase.SurfaceLost and not UiLifecycle::surface_available() and not UiLifecycle::can_render())
    check("input is blocked without a surface", not UiLifecycle::focus_gained())
    check("resume restores a lost surface", UiLifecycle::resume() and UiLifecycle::phase() == UiLifecycle::Phase.Active and UiLifecycle::surface_available())
    check("surface loss can be restored", UiLifecycle::surface_lost() and UiLifecycle::surface_restored() and UiLifecycle::phase() == UiLifecycle::Phase.Active)

    check("stop is accepted", UiLifecycle::stop() and UiLifecycle::phase() == UiLifecycle::Phase.Stopped)
    check("stop is idempotent", not UiLifecycle::stop() and not UiLifecycle::is_started())
    check("stopped state rejects callbacks", not UiLifecycle::focus_lost() and not UiLifecycle::surface_restored())
    invalid_signal: UiLifecycle::Signal = (-1).i32().Signal()
    check("unknown lifecycle signals fail closed", not UiLifecycle::apply(invalid_signal) and UiLifecycle::phase() == UiLifecycle::Phase.Stopped)
    UiLifecycle::reset()
    check("reset keeps generation monotonic", UiLifecycle::generation() == 1 and UiLifecycle::phase() == UiLifecycle::Phase.New)
    check("a new begin advances generation", UiLifecycle::begin() and UiLifecycle::generation() == 2)

    if failures == 0:
        _ = puts("lifecycle: all checks passed")
        return 0
    _ = puts("lifecycle: FAILURES above")
    return 1
