# Headless regression for the shared lifecycle state machine.

include "../src/core/ui_lifecycle.elisa"

extern puts(text: cstr) -> i64

global mutable failures: i32 = 0

def check(name: cstr, ok: bool) -> void:
    return if ok
    failures <- failures + 1
    _ = puts(name)

def main() -> i64:
    UiLifecycle::reset()
    initial: UiLifecycle::Snapshot = UiLifecycle::snapshot()
    check("lifecycle starts new", initial.phase == UiLifecycle::Phase.New and not initial.surface_available and not initial.can_render)
    check("lifecycle rejects ready before begin", not UiLifecycle::ready())

    check("lifecycle begins once", UiLifecycle::begin())
    task: UiTasks::Handle = UiTasks::start(41)
    check("task belongs to the active lifecycle", UiTasks::is_valid(task) and UiTasks::is_pending(task))
    started: UiLifecycle::Snapshot = UiLifecycle::snapshot()
    check("begin enters starting", started.phase == UiLifecycle::Phase.Starting and started.generation == 1 and not started.accepts_input)
    check("lifecycle rejects duplicate begin", not UiLifecycle::begin())
    check("lifecycle becomes ready", UiLifecycle::ready())
    active: UiLifecycle::Snapshot = UiLifecycle::snapshot()
    check("ready without focus is inactive", active.phase == UiLifecycle::Phase.Inactive and active.surface_available and active.can_render and not active.accepts_input)

    check("focus gain activates input", UiLifecycle::focus_gained())
    check("active accepts input", UiLifecycle::accepts_input() and UiLifecycle::phase() == UiLifecycle::Phase.Active)
    check("focus loss preserves the surface", UiLifecycle::focus_lost() and UiLifecycle::phase() == UiLifecycle::Phase.Inactive and UiLifecycle::surface_available())
    check("focus gain is repeatable", UiLifecycle::focus_gained() and UiLifecycle::accepts_input())

    check("suspend enters background", UiLifecycle::suspend() and UiLifecycle::phase() == UiLifecycle::Phase.Background and not UiLifecycle::accepts_input() and not UiLifecycle::can_render())
    check("resume restores active state", UiLifecycle::resume() and UiLifecycle::phase() == UiLifecycle::Phase.Active and UiLifecycle::accepts_input())

    check("surface loss is explicit", UiLifecycle::surface_lost() and UiLifecycle::phase() == UiLifecycle::Phase.SurfaceLost and not UiLifecycle::surface_available() and not UiLifecycle::can_render())
    check("ready cannot bypass a lost surface", not UiLifecycle::ready() and UiLifecycle::phase() == UiLifecycle::Phase.SurfaceLost)
    check("focus events are staged without rendering", UiLifecycle::focus_lost() and UiLifecycle::phase() == UiLifecycle::Phase.SurfaceLost and not UiLifecycle::accepts_input() and not UiLifecycle::can_render())
    check("focus regain stays staged without rendering", UiLifecycle::focus_gained() and UiLifecycle::phase() == UiLifecycle::Phase.SurfaceLost and not UiLifecycle::accepts_input() and not UiLifecycle::can_render())
    check("resume cannot bypass a lost surface", not UiLifecycle::resume() and UiLifecycle::phase() == UiLifecycle::Phase.SurfaceLost and not UiLifecycle::surface_available() and not UiLifecycle::can_render())
    check("surface restoration preserves focused state", UiLifecycle::surface_restored() and UiLifecycle::phase() == UiLifecycle::Phase.Active and UiLifecycle::surface_available() and UiLifecycle::can_render())

    # PAUSE may precede TERM_WINDOW: restoration must remain backgrounded until
    # the corresponding RESUME is observed.
    check("background survives surface loss", UiLifecycle::suspend() and UiLifecycle::surface_lost() and UiLifecycle::phase() == UiLifecycle::Phase.SurfaceLost)
    check("repeated surface loss preserves background", UiLifecycle::surface_lost())
    check("surface restore does not foreground app", UiLifecycle::surface_restored() and UiLifecycle::phase() == UiLifecycle::Phase.Background and UiLifecycle::surface_available() and not UiLifecycle::can_render() and not UiLifecycle::accepts_input())
    check("foreground after surface restore activates app", UiLifecycle::resume() and UiLifecycle::phase() == UiLifecycle::Phase.Active and UiLifecycle::can_render() and UiLifecycle::accepts_input())

    # TERM_WINDOW may precede PAUSE, and RESUME may arrive before INIT_WINDOW.
    # Stage those transitions without ever making the lost surface renderable.
    check("pause after surface loss stays surface-lost", UiLifecycle::surface_lost() and UiLifecycle::suspend() and UiLifecycle::phase() == UiLifecycle::Phase.SurfaceLost and not UiLifecycle::can_render())
    check("resume before surface restoration stays surface-lost", UiLifecycle::resume() and UiLifecycle::phase() == UiLifecycle::Phase.SurfaceLost and not UiLifecycle::surface_available() and not UiLifecycle::can_render())
    check("surface restoration applies staged foreground", UiLifecycle::surface_restored() and UiLifecycle::phase() == UiLifecycle::Phase.Active and UiLifecycle::can_render() and UiLifecycle::accepts_input())
    check("surface loss can be restored", UiLifecycle::surface_lost() and UiLifecycle::surface_restored() and UiLifecycle::phase() == UiLifecycle::Phase.Active)

    check("stop is accepted", UiLifecycle::stop() and UiLifecycle::phase() == UiLifecycle::Phase.Stopped)
    check("stopping invalidates task callbacks", not UiTasks::is_valid(task) and UiTasks::state(task) == UiTasks::TaskState.Idle)
    check("stop is idempotent", not UiLifecycle::stop() and not UiLifecycle::is_started())
    check("stopped state rejects callbacks", not UiLifecycle::focus_lost() and not UiLifecycle::surface_restored())
    invalid_signal: UiLifecycle::Signal = (-1).i32().Signal()
    check("unknown lifecycle signals fail closed", not UiLifecycle::apply(invalid_signal) and UiLifecycle::phase() == UiLifecycle::Phase.Stopped)
    UiLifecycle::reset()
    check("reset keeps generation monotonic", UiLifecycle::generation() == 1 and UiLifecycle::phase() == UiLifecycle::Phase.New)
    check("a new begin advances generation", UiLifecycle::begin() and UiLifecycle::generation() == 2)
    replacement_task: UiTasks::Handle = UiTasks::start(41)
    check("replacement session accepts a fresh task", UiTasks::is_valid(replacement_task) and replacement_task.generation != task.generation)
    UiLifecycle::reset()
    check("reset invalidates replacement task callbacks", not UiTasks::is_valid(replacement_task) and UiTasks::state(replacement_task) == UiTasks::TaskState.Idle and UiLifecycle::phase() == UiLifecycle::Phase.New)

    if failures == 0:
        _ = puts("lifecycle: all checks passed")
        return 0
    _ = puts("lifecycle: FAILURES above")
    return 1
