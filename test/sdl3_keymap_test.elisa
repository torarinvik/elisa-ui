# SDL's keycodes are not UiKey's. UiKey is GLFW's numbering (Escape 256, Enter
# 257, F1 290); SDL uses ASCII control codes for those and (1 << 30) | scancode
# for the rest. The backend translates, and this is where that table is checked:
# a headless run never produces a key event, so nothing else would exercise it.

include "../src/platform/sdl3/ui_sdl3.elisa"

extern puts(text: cstr) -> i64

global mutable keymap_failures: i32 = 0

# The backend calls into the app contract; a keymap test has no app.
def app_init() -> void:
    pass

def app_frame() -> void:
    pass

def app_event(event: UiCore::Event) -> void:
    pass

def app_widget_event(widget: usize, event: i32) -> void:
    pass

def check(name: cstr, got: i32, want: i32) -> void:
    return if got == want
    keymap_failures <- keymap_failures + 1
    _ = puts(name)

def main() -> i64:
    # Printable ASCII is shared, except letters: SDL reports lowercase for an
    # unshifted key, UiKey names the uppercase.
    check("SDLK_a -> UiKey.A", UiSdl3::key_from_sdl(97), UiKey.A.i32())
    check("SDLK_z -> UiKey.Z", UiSdl3::key_from_sdl(122), UiKey.Z.i32())
    check("SDLK_SPACE passes through", UiSdl3::key_from_sdl(32), UiKey.Space.i32())
    check("SDLK_0 passes through", UiSdl3::key_from_sdl(48), UiKey.Digit0.i32())
    check("SDLK_EQUALS passes through", UiSdl3::key_from_sdl(61), UiKey.Equal.i32())
    check("SDLK_BACKQUOTE passes through", UiSdl3::key_from_sdl(96), UiKey.Backtick.i32())

    # SDL's control codes against GLFW's high numbers.
    check("SDLK_BACKSPACE -> UiKey.Backspace", UiSdl3::key_from_sdl(8), UiKey.Backspace.i32())
    check("SDLK_TAB -> UiKey.Tab", UiSdl3::key_from_sdl(9), UiKey.Tab.i32())
    check("SDLK_RETURN -> UiKey.Enter", UiSdl3::key_from_sdl(13), UiKey.Enter.i32())
    check("SDLK_ESCAPE -> UiKey.Escape", UiSdl3::key_from_sdl(27), UiKey.Escape.i32())
    check("SDLK_DELETE -> UiKey.Delete", UiSdl3::key_from_sdl(127), UiKey.Delete.i32())

    # (1 << 30) | scancode. Both runs translate by offset, so the ENDS of each are
    # what pin the arithmetic.
    mask: i32 = 1073741824
    check("F1", UiSdl3::key_from_sdl(mask + 58), UiKey.F1.i32())
    check("F12", UiSdl3::key_from_sdl(mask + 69), UiKey.F12.i32())
    check("Right", UiSdl3::key_from_sdl(mask + 79), UiKey.Right.i32())
    check("Left", UiSdl3::key_from_sdl(mask + 80), UiKey.Left.i32())
    check("Down", UiSdl3::key_from_sdl(mask + 81), UiKey.Down.i32())
    check("Up", UiSdl3::key_from_sdl(mask + 82), UiKey.Up.i32())
    check("Insert", UiSdl3::key_from_sdl(mask + 73), UiKey.Insert.i32())
    check("Home", UiSdl3::key_from_sdl(mask + 74), UiKey.Home.i32())
    check("PageUp", UiSdl3::key_from_sdl(mask + 75), UiKey.PageUp.i32())
    check("Delete via scancode", UiSdl3::key_from_sdl(mask + 76), UiKey.Delete.i32())
    check("End", UiSdl3::key_from_sdl(mask + 77), UiKey.End.i32())
    check("PageDown", UiSdl3::key_from_sdl(mask + 78), UiKey.PageDown.i32())

    # A key the backend does not model answers 0, which is not a UiKey member.
    check("an unmodelled scancode is 0", UiSdl3::key_from_sdl(mask + 200), 0)

    if keymap_failures == 0:
        _ = puts("sdl3 keymap: all checks passed")
        return 0
    _ = puts("sdl3 keymap: FAILURES above")
    return 1
