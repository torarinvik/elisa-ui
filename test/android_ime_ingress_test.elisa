include "./widget_layout_support.elisa"
include "../src/platform/android/ui_android_ime.elisa"

def main() -> i64:
    UiMobileSurface::reset()
    _ = UiMobileSurface::start(400.0, 800.0, 2.0, UiResponsive::insets(0.0, 0.0, 0.0, 0.0))
    UiFlat::reset()
    field: usize = UiFlat::text_field(UiFlat::NONE, "Name", "", "Ada", 200.0, 40.0, 16.0, UiCore::rgb(255, 255, 255), UiCore::rgb(0, 0, 0))
    _ = UiFlat::request_focus(field)
    focus_epoch: u32 = UiFlat::focus_epoch()
    _ = UiFlat::request_focus(field)
    check("same editor focus preserves connection identity", UiFlat::focus_epoch() == focus_epoch)
    UiFlat::clear_focus()
    _ = UiFlat::request_focus(field)
    check("clear/refocus retires connection identity", UiFlat::focus_epoch() != focus_epoch)
    android_commit_text("!", 1, 1)
    check("inactive Android IME cannot commit", UiFlat::text_value(field) == "Ada")
    _ = UiMobileSurface::focus_gained()
    owner: u64 = android_ime_owner()
    check("active editor has a stable owner token", owner != 0 and android_ime_owner() == owner)
    UiFlat::set_selection(field, 0, 3)
    android_composing_text("ni", 2, 1)
    check("active Android composition reaches retained editing", UiFlat::text_value(field) == "ni" and UiFlat::marked_utf16_length(field) == 2)
    check("published composition metadata uses UTF-16 endpoints", android_ime_selection_position(2) == 0 and android_ime_selection_position(3) == 2)
    check("composition does not retire its own connection", android_ime_owner() == owner)
    _ = UiMobileSurface::focus_lost()
    android_composing_text("hao", 3, 1)
    android_commit_text("!", 1, 1)
    check("focus loss rejects late composing and commit calls", UiFlat::text_value(field) == "ni" and UiFlat::marked_utf16_length(field) == 2)
    _ = UiMobileSurface::focus_gained()
    check("interruption retires the connection owner", android_ime_owner() != owner)
    android_commit_text("你好", 6, 1)
    check("reactivated Android commit replaces composition", UiFlat::text_value(field) == "你好" and UiFlat::marked_utf16_length(field) == 0)
    _ = UiMobileSurface::background()
    check("background has no connection owner", android_ime_owner() == 0)
    android_commit_text("!", 1, 1)
    check("background rejects Android IME", UiFlat::text_value(field) == "你好")
    _ = UiMobileSurface::foreground()
    android_composing_text("", -1, 1)
    check("negative byte lengths cannot edit text", UiFlat::text_value(field) == "你好")
    missing: cstr = 0.uintptr().cast[cstr] can Unsafe.PointerCast
    android_commit_text(missing, 3, 1)
    check("a missing counted buffer cannot insert NUL bytes", UiFlat::text_value(field) == "你好")
    _ = UiMobileSurface::surface_lost()
    android_composing_text("late", 4, 1)
    check("lost surface rejects Android composition", UiFlat::text_value(field) == "你好" and UiFlat::marked_utf16_length(field) == 0)
    _ = UiMobileSurface::surface_restored()
    before_blur: u64 = android_ime_owner()
    UiFlat::clear_focus()
    check("blur has no connection owner", android_ime_owner() == 0)
    android_commit_text("!", 1, 1)
    check("missing editor rejects Android commit", UiFlat::text_value(field) == "你好")
    _ = UiFlat::request_focus(field)
    check("same-field refocus receives a fresh owner", android_ime_owner() != before_blur)
    check("queued commit from retired focus is rejected", android_ime_dispatch(before_blur, 1, "!", 1, 1) == 0 and UiFlat::text_value(field) == "你好")
    current_owner: u64 = android_ime_owner()
    check("unknown queued operation is rejected", android_ime_dispatch(current_owner, 2, "!", 1, 1) == 0)
    check("oversized queued payload is rejected", android_ime_dispatch(current_owner, 1, "!", 1025, 1) == 0)
    check("missing queued payload is rejected", android_ime_dispatch(current_owner, 1, missing, 1, 1) == 0)
    check("current queued commit reaches retained editor", android_ime_dispatch(current_owner, 1, "!", 1, 1) == 1 and UiFlat::text_value(field) == "你好!")
    _ = UiMobileSurface::background()
    _ = UiMobileSurface::foreground()
    check("background round trip retires queued owner", android_ime_dispatch(current_owner, 1, "?", 1, 1) == 0 and UiFlat::text_value(field) == "你好!")
    before_traits: u64 = android_ime_owner()
    _ = UiFlat::set_text_purpose(field, UiTextInput::Purpose.Email)
    check("purpose change retires connection owner", android_ime_owner() != before_traits)
    check("queued edit with retired keyboard traits is rejected", android_ime_dispatch(before_traits, 1, "?", 1, 1) == 0 and UiFlat::text_value(field) == "你好!")
    finishing_owner: u64 = android_ime_owner()
    UiFlat::set_selection(field, 0, 7)
    check("queued provisional text is accepted", android_ime_dispatch(finishing_owner, 0, "你好!", 7, 1) == 1 and UiFlat::marked_utf16_length(field) == 3)
    check("finish rejects unexpected replacement payload", android_ime_dispatch(finishing_owner, 3, "!", 1, 0) == 0 and UiFlat::marked_utf16_length(field) == 3)
    check("finish preserves provisional text", android_ime_dispatch(finishing_owner, 3, missing, 0, 0) == 1 and UiFlat::text_value(field) == "你好!" and UiFlat::marked_utf16_length(field) == 0)
    check("unmarked editor publishes absent composition", android_ime_selection_position(2) == -1 and android_ime_selection_position(3) == -1)
    check("finish with retired owner is rejected", android_ime_dispatch(before_traits, 3, missing, 0, 0) == 0)
    UiFlat::set_selection(field, 0, 7)
    _ = android_ime_dispatch(finishing_owner, 1, "A😀éZ", 9, 1)
    check("queued selection uses UTF-16 and preserves direction", android_ime_selection(finishing_owner, 5, 3) == 1 and UiFlat::widget(field).selection_anchor == 8 and UiFlat::widget(field).caret == 5)
    check("connection metadata preserves UTF-16 selection direction", android_ime_selection_position(0) == 5 and android_ime_selection_position(1) == 3)
    check("selection cannot split a surrogate or combining cluster", android_ime_selection(finishing_owner, 2, 4) == 1 and UiFlat::widget(field).selection_anchor == 1 and UiFlat::widget(field).caret == 5)
    check("negative selection is rejected", android_ime_selection(finishing_owner, -1, 0) == 0)
    check("stale selection is rejected", android_ime_selection(before_traits, 0, 0) == 0 and UiFlat::widget(field).caret == 5)
    check("oversized selection clamps to document", android_ime_selection(finishing_owner, 2147483647, 2147483647) == 1 and UiFlat::widget(field).caret == 9)
    UiFlat::set_selection(field, 0, 9)
    _ = android_ime_dispatch(finishing_owner, 1, "你好!", 7, 1)
    stable_traits: u32 = UiFlat::text_traits_epoch()
    _ = UiFlat::set_text_purpose(field, UiTextInput::Purpose.Email)
    check("identical traits preserve connection revision", UiFlat::text_traits_epoch() == stable_traits and android_ime_owner() == finishing_owner)
    _ = UiFlat::set_text_purpose(field, UiTextInput::Purpose.Url)
    _ = UiFlat::set_text_purpose(field, UiTextInput::Purpose.Email)
    check("unobserved purpose round trip retires connection", android_ime_selection(finishing_owner, 0, 0) == 0 and UiFlat::text_value(field) == "你好!")
    before_privacy: u64 = android_ime_owner()
    public_readback: cstr = android_ime_readback_text()
    check("plain readback copies retained UTF-8", android_ime_native_byte(public_readback, 0) == 228)
    UiFlat::set_secure(field, true)
    denied_readback: cstr = android_ime_readback_text()
    check("secure retained readback is denied", denied_readback.cast[uintptr] == 0.uintptr() can Unsafe.PointerCast)
    readback_bytes: mutable u32 = 0
    for index in 0..<UiFlat::TEXT_CAPACITY:
        readback_bytes <- readback_bytes + android_ime_readback_store[index].u32()
    check("secure transition scrubs retained readback copy", readback_bytes == 0)
    check("secure select all needs no plaintext readback", android_ime_selection(android_ime_owner(), 0, 2147483647) == 1 and UiFlat::widget(field).selection_anchor == 0 and UiFlat::widget(field).caret == 7)
    check("secure clipboard actions are denied", android_ime_action(android_ime_owner(), 2) == 0 and android_ime_action(android_ime_owner(), 3) == 0 and UiFlat::text_value(field) == "你好!")
    check("invalid and stale context actions are denied", android_ime_action(android_ime_owner(), 5) == 0 and android_ime_action(before_privacy, 1) == 0)
    UiFlat::set_secure(field, false)
    check("unobserved privacy round trip retires connection", android_ime_selection(before_privacy, 0, 0) == 0 and UiFlat::text_value(field) == "你好!")
    deletion_owner: u64 = android_ime_owner()
    check("context select all resolves retained document", android_ime_action(deletion_owner, 1) == 1 and UiFlat::widget(field).selection_anchor == 0 and UiFlat::widget(field).caret == 7)
    check("context copy exports selected UTF-8", android_ime_action(deletion_owner, 2) == 1 and test_clipboard_value() == "你好!")
    check("context cut uses retained editing", android_ime_action(deletion_owner, 3) == 1 and UiFlat::text_value(field) == "")
    check("context paste restores clipboard UTF-8", android_ime_action(deletion_owner, 4) == 1 and UiFlat::text_value(field) == "你好!")
    UiFlat::replace_text(field, "ABmiddleYZ")
    _ = android_ime_selection(deletion_owner, 8, 2)
    check("stale surrounding deletion cannot edit", android_ime_delete_surrounding(before_privacy, 1, 1) == 0 and UiFlat::text_value(field) == "ABmiddleYZ")
    check("negative surrounding deletion cannot edit", android_ime_delete_surrounding(deletion_owner, -1, 1) == 0 and UiFlat::text_value(field) == "ABmiddleYZ")
    check("current surrounding deletion protects selected span", android_ime_delete_surrounding(deletion_owner, 1, 1) == 1 and UiFlat::text_value(field) == "AmiddleZ" and UiFlat::widget(field).caret == 1)
    UiFlat::replace_text(field, "AB😀Z")
    _ = android_ime_selection(deletion_owner, 4, 4)
    check("stale scalar deletion cannot edit", android_ime_delete_codepoints(before_privacy, 2, 0) == 0 and UiFlat::text_value(field) == "AB😀Z")
    check("negative scalar deletion cannot edit", android_ime_delete_codepoints(deletion_owner, 2, -1) == 0 and UiFlat::text_value(field) == "AB😀Z")
    check("current scalar deletion reaches retained editor", android_ime_delete_codepoints(deletion_owner, 2, 0) == 1 and UiFlat::text_value(field) == "AZ")
    UiFlat::replace_text(field, "你好!")
    UiFlat::replace_text(field, "A😀éZ")
    check("composing region marks existing text without moving selection", android_ime_composing_region(deletion_owner, 5, 1) == 1 and UiFlat::text_value(field) == "A😀éZ" and UiFlat::marked_utf16_location(field) == 1 and UiFlat::marked_utf16_length(field) == 4 and UiFlat::widget(field).caret == 9)
    check("stale composing region cannot edit metadata", android_ime_composing_region(before_privacy, 0, 0) == 0 and UiFlat::marked_utf16_length(field) == 4)
    check("negative composing endpoint clamps safely", android_ime_composing_region(deletion_owner, -1, 2) == 1 and UiFlat::marked_utf16_location(field) == 0 and UiFlat::marked_utf16_length(field) == 1)
    check("oversized composing region clamps to document", android_ime_composing_region(deletion_owner, 0, 2147483647) == 1 and UiFlat::marked_utf16_length(field) == 6)
    check("collapsed grapheme composing region unmarks", android_ime_composing_region(deletion_owner, 3, 4) == 1 and UiFlat::marked_utf16_length(field) == 0 and UiFlat::text_value(field) == "A😀éZ")
    UiFlat::replace_text(field, "你好!")
    staged_bytes: mutable u32 = 0
    for index in 0..<UiFlat::TEXT_CAPACITY:
        staged_bytes <- staged_bytes + android_ime_staging[index].u32()
    check("Android ingress scrubs its staging copy", staged_bytes == 0)
    _ = UiMobileSurface::stop()
    check("inactive connection metadata is empty", android_ime_selection_position(0) == 0 and android_ime_selection_position(1) == 0)
    android_commit_text("!", 1, 1)
    check("stopped Android IME cannot edit", UiFlat::text_value(field) == "你好!")
    if test_failures == 0:
        _ = puts("android IME ingress: all checks passed")
        return 0
    return 1
