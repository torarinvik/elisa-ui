# Retained painting, visibility, semantic controls, themes, and sliders.

include "./widget_layout_support.elisa"

def main() -> i64:
    # A label's minimum comes from its measured text, so it sizes a container
    # that would otherwise collapse. "Save" at size 20 measures 4 * 20 * 0.5 = 40
    # wide and 20 tall under the stub above.
    UiFlat::reset()
    row: usize = UiFlat::panel(UiFlat::NONE, UiConst::Axis.Row, 4.0, 0.0, UiCore::Color{r: 1, g: 1, b: 1, a: 255})
    label: usize = UiFlat::label(row, "Save", 20.0, UiCore::Color{r: 255, g: 255, b: 255, a: 255})
    UiFlat::layout(200.0, 100.0)
    check("label takes its measured width", near(UiFlat::widget(label).min_width, 40.0))
    check("label takes its line height", near(UiFlat::widget(label).min_height, 20.0))
    check("label container grows to fit text", near(UiFlat::widget(row).min_width, 48.0))
    check("label is not interactive", not UiFlat::widget(label).interactive)

    # Painting a label must emit a text command; an empty label must not.
    UiFlat::set_help(label, "A compact save status")
    UiCore::begin_frame()
    UiFlat::paint()
    check("painting a label emits a text command", UiCore::command_count() == 2)
    check("painting builds one semantic accessibility node", UiCore::accessibility_count() == 1)
    accessible: UiCore::AccessibilityNode = UiCore::accessibility_at(0)
    check("semantic node keeps the visible label", accessible.label == "Save")
    check("semantic node keeps its help text", accessible.help == "A compact save status")
    check("semantic node exposes static-text role", accessible.role == UiCore::AccessibilityRole.Label)
    UiFlat::set_text(label, "Localized Save", 24.0, UiCore::rgb(230, 230, 240))
    UiFlat::layout(200.0, 100.0)
    check("changing label text remeasures its width", near(UiFlat::widget(label).min_width, 168.0))
    check("changing label typography remeasures its height", near(UiFlat::widget(label).min_height, 24.0))
    check("dynamic label measurement propagates into its container", near(UiFlat::widget(row).min_width, 176.0))
    UiFlat::set_text(label, "S", 10.0, UiCore::rgb(230, 230, 240))
    UiFlat::layout(200.0, 100.0)
    check("shorter label text shrinks its cached width", near(UiFlat::widget(label).min_width, 5.0))
    check("container measurement can shrink after content changes", near(UiFlat::widget(row).min_width, 13.0))

    blank: usize = UiFlat::label(row, "", 20.0, UiCore::Color{r: 255, g: 255, b: 255, a: 255})
    UiFlat::layout(200.0, 100.0)
    UiCore::begin_frame()
    UiFlat::paint()
    check("an empty label emits no text", UiCore::command_count() == 2)

    # Painting follows the retained tree, not allocation order. Construct a
    # later sibling before filling the first one; its subtree must still be
    # emitted contiguously so the sibling cannot cover the first child.
    UiFlat::reset()
    paint_root: usize = UiFlat::panel(UiFlat::NONE, UiConst::Axis.Column, 0.0, 0.0, UiCore::rgba(0, 0, 0, 0))
    paint_first: usize = UiFlat::panel(paint_root, UiConst::Axis.Column, 0.0, 0.0, UiCore::rgb(220, 60, 70))
    paint_second: usize = UiFlat::panel(paint_root, UiConst::Axis.Column, 0.0, 0.0, UiCore::rgb(60, 90, 220))
    _ = UiFlat::button(paint_first, 40.0, 20.0, UiCore::rgb(60, 210, 120), UiCore::rgb(60, 210, 120), UiCore::rgb(60, 210, 120))
    UiFlat::layout(120.0, 80.0)
    UiCore::begin_frame()
    UiFlat::paint()
    first_fill: usize = first_fill_color_command(UiCore::rgb(220, 60, 70))
    child_fill: usize = first_fill_color_command(UiCore::rgb(60, 210, 120))
    second_fill: usize = first_fill_color_command(UiCore::rgb(60, 90, 220))
    check("flat painting keeps each subtree in tree order", first_fill < child_fill and child_fill < second_fill)
    zero: f32 = 0.0
    check("non-finite direct hit coordinates fail closed", UiFlat::hit(1.0 / zero, 15.0) == UiFlat::NONE)

    UiFlat::reset()
    visibility_row: usize = UiFlat::panel(UiFlat::NONE, UiConst::Axis.Row, 0.0, 10.0, UiCore::rgb(0, 0, 0))
    visible_a: usize = UiFlat::button(visibility_row, 100.0, 30.0, UiCore::rgb(10, 20, 30), UiCore::rgb(20, 30, 40), UiCore::rgb(5, 10, 15))
    visible_b: usize = UiFlat::button(visibility_row, 100.0, 30.0, UiCore::rgb(10, 20, 30), UiCore::rgb(20, 30, 40), UiCore::rgb(5, 10, 15))
    UiFlat::set_text(visible_a, "First", 14.0, UiCore::rgb(255, 255, 255))
    UiFlat::set_text(visible_b, "Second", 14.0, UiCore::rgb(255, 255, 255))
    UiFlat::layout(210.0, 30.0)
    UiCore::begin_frame()
    UiFlat::paint()
    first_semantic: UiCore::AccessibilityNode = UiCore::accessibility_at(0)
    second_semantic: UiCore::AccessibilityNode = UiCore::accessibility_at(1)
    check("semantic siblings preserve retained order", first_semantic.id == visible_a and second_semantic.id == visible_b and first_semantic.next_sibling_id == visible_b)
    check("semantic links omit non-semantic layout wrappers", first_semantic.parent_id == UiCore::MAX_ACCESSIBILITY_NODES and second_semantic.parent_id == UiCore::MAX_ACCESSIBILITY_NODES)
    UiFlat::pointer((UiCore::PointerEvent.Down(at: UiCore::Vec2(50.0, 15.0), button: 0)))
    UiFlat::set_visible(visible_a, false)
    check("hiding an active widget clears capture and focus", UiFlat::active() == UiFlat::NONE and UiFlat::focused() == UiFlat::NONE)
    check("hit testing reflows after visibility mutation", UiFlat::hit(50.0, 15.0) == visible_b)
    UiFlat::set_margin(visible_b, 4.0)
    # A retained geometry mutation invalidates layout; paint owns the
    # deferred reflow when callers do not issue an explicit layout pass.
    UiCore::begin_frame()
    UiFlat::paint()
    check("paint reflows after a sizing mutation", near(UiFlat::widget(visible_b).x, 4.0))
    UiFlat::set_margin(visible_b, 0.0)
    UiFlat::layout(210.0, 30.0)
    check("hidden widgets collapse their arranged frame", rect_is(visible_a, 0.0, 0.0, 0.0, 0.0))
    check("visible siblings reflow without a hidden gap", near(UiFlat::widget(visible_b).x, 0.0))
    check("hidden children stop contributing to container minimums", near(UiFlat::widget(visibility_row).min_width, 100.0))
    check("hit testing ignores hidden widgets", UiFlat::hit(50.0, 15.0) == visible_b)
    UiCore::begin_frame()
    UiFlat::paint()
    check("hidden widgets emit no accessibility node", UiCore::accessibility_count() == 1)
    UiFlat::set_visible(visibility_row, false)
    UiFlat::layout(210.0, 30.0)
    UiCore::begin_frame()
    UiFlat::paint()
    check("hidden containers transitively hide descendants", UiCore::accessibility_count() == 0 and rect_is(visible_b, 0.0, 0.0, 0.0, 0.0))
    UiFlat::set_visible(visibility_row, true)
    UiFlat::set_visible(visible_a, true)
    UiFlat::layout(210.0, 30.0)
    check("reshown widgets restore normal layout participation", near(UiFlat::widget(visibility_row).min_width, 210.0) and near(UiFlat::widget(visible_b).x, 110.0))
    UiFlat::pointer((UiCore::PointerEvent.Down(at: UiCore::Vec2(160.0, 15.0), button: 0)))
    UiFlat::set_enabled(visibility_row, false)
    check("disabling a container clears descendant capture and focus", UiFlat::active() == UiFlat::NONE and UiFlat::focused() == UiFlat::NONE)
    check("container disabled state applies transitively", not UiFlat::is_enabled(visible_a) and not UiFlat::is_enabled(visible_b))
    check("disabled descendants are removed from hit testing", UiFlat::hit(50.0, 15.0) == UiFlat::NONE)
    check("disabled descendants reject accessibility activation", not UiFlat::activate(visible_a))
    UiCore::begin_frame()
    UiFlat::paint()
    check("disabled descendants remain semantic but report disabled", UiCore::accessibility_count() == 2 and not UiCore::accessibility_at(0).enabled and not UiCore::accessibility_at(1).enabled)
    UiFlat::set_enabled(visibility_row, true)
    check("reenabling a container restores locally enabled descendants", UiFlat::is_enabled(visible_a) and UiFlat::is_enabled(visible_b))
    check("programmatic focus accepts an eligible control", UiFlat::request_focus(visible_b) and UiFlat::focused() == visible_b)
    UiFlat::set_visible(visible_b, false)
    check("programmatic focus rejects hidden controls", not UiFlat::request_focus(visible_b))
    UiFlat::set_visible(visible_b, true)
    UiFlat::set_enabled(visibility_row, false)
    check("programmatic focus rejects inherited disabled state", not UiFlat::request_focus(visible_b))
    UiFlat::set_enabled(visibility_row, true)
    UiFlat::clear_focus()
    check("programmatic focus can be cleared explicitly", UiFlat::focused() == UiFlat::NONE)

    UiFlat::reset()
    choice: usize = UiFlat::radio_button(UiFlat::NONE, 120.0, 40.0, UiCore::rgb(20, 40, 80), UiCore::rgb(30, 50, 90), UiCore::rgb(10, 20, 40))
    UiFlat::set_text(choice, "Ocean", 16.0, UiCore::rgb(255, 255, 255))
    UiFlat::set_selected(choice, true)
    UiFlat::layout(120.0, 40.0)
    UiCore::begin_frame()
    UiFlat::paint()
    choice_node: UiCore::AccessibilityNode = UiCore::accessibility_at(0)
    check("radio button exposes its semantic role", choice_node.role == UiCore::AccessibilityRole.RadioButton)
    check("radio button exposes selected state", choice_node.selected)
    check("radio button remains interactive", UiFlat::hit(60.0, 20.0) == choice)

    UiFlat::reset()
    toggle: usize = UiFlat::check_box(UiFlat::NONE, 120.0, 40.0, UiCore::rgb(30, 30, 40), UiCore::rgb(40, 40, 50), UiCore::rgb(20, 20, 30))
    UiFlat::set_text(toggle, "Dark mode", 16.0, UiCore::rgb(255, 255, 255))
    UiFlat::set_selected(toggle, true)
    UiFlat::layout(120.0, 40.0)
    UiCore::begin_frame()
    UiFlat::paint()
    toggle_node: UiCore::AccessibilityNode = UiCore::accessibility_at(0)
    check("check box exposes its semantic role", toggle_node.role == UiCore::AccessibilityRole.CheckBox)
    check("check box exposes checked state", toggle_node.selected)
    UiFlat::pointer((UiCore::PointerEvent.Down(at: UiCore::Vec2(60.0, 20.0), button: 0)))
    UiFlat::pointer((UiCore::PointerEvent.Up(at: UiCore::Vec2(60.0, 20.0), button: 0)))
    check("pointer activation toggles checkbox state in the framework", not UiFlat::widget(toggle).selected)
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Space)))
    UiFlat::keyboard((UiCore::KeyEvent.Up(code: UiCore::Key.Space)))
    check("keyboard activation shares checkbox toggle semantics", UiFlat::widget(toggle).selected)

    UiFlat::reset()
    choice_group: usize = UiFlat::panel(UiFlat::NONE, UiConst::Axis.Row, 0.0, 0.0, UiCore::rgb(0, 0, 0))
    choice_a: usize = UiFlat::radio_button(choice_group, 80.0, 30.0, UiCore::rgb(20, 40, 80), UiCore::rgb(30, 50, 90), UiCore::rgb(10, 20, 40))
    choice_b: usize = UiFlat::radio_button(choice_group, 80.0, 30.0, UiCore::rgb(20, 40, 80), UiCore::rgb(30, 50, 90), UiCore::rgb(10, 20, 40))
    UiFlat::set_selected(choice_a, true)
    UiFlat::activate(choice_b)
    check("radio activation selects one sibling exclusively", not UiFlat::widget(choice_a).selected and UiFlat::widget(choice_b).selected)
    UiFlat::set_selection_group(choice_a, 100)
    UiFlat::set_selection_group(choice_b, 200)
    UiFlat::set_selected(choice_a, true)
    check("explicit radio groups may span independent choice sets", UiFlat::widget(choice_a).selected and UiFlat::widget(choice_b).selected)
    UiFlat::set_selection_group(UiFlat::NONE, 1)
    check("invalid radio group updates are harmless", not UiFlat::is_valid(UiFlat::NONE))

    UiFlat::reset()
    radio_nav_group: usize = UiFlat::panel(UiFlat::NONE, UiConst::Axis.Row, 0.0, 0.0, UiCore::rgb(0, 0, 0))
    radio_nav_a: usize = UiFlat::radio_button(radio_nav_group, 80.0, 30.0, UiCore::rgb(20, 40, 80), UiCore::rgb(30, 50, 90), UiCore::rgb(10, 20, 40))
    radio_nav_b: usize = UiFlat::radio_button(radio_nav_group, 80.0, 30.0, UiCore::rgb(20, 40, 80), UiCore::rgb(30, 50, 90), UiCore::rgb(10, 20, 40))
    radio_nav_c: usize = UiFlat::radio_button(radio_nav_group, 80.0, 30.0, UiCore::rgb(20, 40, 80), UiCore::rgb(30, 50, 90), UiCore::rgb(10, 20, 40))
    UiFlat::set_selected(radio_nav_a, true)
    _ = UiFlat::request_focus(radio_nav_a)
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Right)))
    check("radio arrows select the next group member", UiFlat::focused() == radio_nav_b and UiFlat::widget(radio_nav_b).selected and not UiFlat::widget(radio_nav_a).selected)
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Down)))
    check("radio arrows advance through the full group", UiFlat::focused() == radio_nav_c and UiFlat::widget(radio_nav_c).selected)
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Right)))
    check("radio group navigation wraps at the end", UiFlat::focused() == radio_nav_a and UiFlat::widget(radio_nav_a).selected)

    UiFlat::reset()
    slider: usize = UiFlat::slider(UiFlat::NONE, "Intensity", 200.0, 24.0, 0.25, UiCore::rgb(30, 30, 40), UiCore::rgb(60, 110, 220), UiCore::rgb(255, 255, 255))
    UiFlat::layout(200.0, 24.0)
    test_last_event <- -1
    UiFlat::pointer((UiCore::PointerEvent.Down(at: UiCore::Vec2(100.0, 12.0), button: 0)))
    check("slider pointer maps into its normalized range", near(UiFlat::widget(slider).value, 0.5))
    check("slider drag reports a value change", test_last_event == UiConst::WidgetEvent.Change.i32())
    UiFlat::pointer((UiCore::PointerEvent.Move(at: UiCore::Vec2(192.0, 12.0))))
    check("slider drag reaches its upper bound", near(UiFlat::widget(slider).value, 1.0))
    UiFlat::pointer((UiCore::PointerEvent.Leave))
    check("slider retains capture outside the view", UiFlat::active() == slider)
    UiFlat::pointer((UiCore::PointerEvent.Move(at: UiCore::Vec2(-20.0, 12.0))))
    check("captured slider clamps beyond the lower edge", near(UiFlat::widget(slider).value, 0.0))
    UiFlat::pointer((UiCore::PointerEvent.Up(at: UiCore::Vec2(-20.0, 12.0), button: 0)))
    zero_pointer: f32 = 0.0
    malformed_pointer: f32 = zero_pointer / zero_pointer
    UiFlat::set_value(slider, 0.5)
    UiFlat::pointer((UiCore::PointerEvent.Down(at: UiCore::Vec2(100.0, 12.0), button: 0)))
    before_malformed_drag: f32 = UiFlat::widget(slider).value
    UiFlat::pointer((UiCore::PointerEvent.Move(at: UiCore::Vec2{x: malformed_pointer, y: 12.0})))
    check("non-finite slider drags are ignored", near(UiFlat::widget(slider).value, before_malformed_drag) and UiFlat::active() == slider)
    UiFlat::pointer((UiCore::PointerEvent.Up(at: UiCore::Vec2(100.0, 12.0), button: 0)))
    UiFlat::set_value(slider, 1.0)
    UiFlat::set_step(slider, 0.1)
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Left)))
    check("slider arrows use its configured step", near(UiFlat::widget(slider).value, 0.9))
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.PageDown)))
    check("slider Page Down uses ten configured steps", near(UiFlat::widget(slider).value, 0.0))
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.PageUp)))
    check("slider Page Up clamps at the upper bound", near(UiFlat::widget(slider).value, 1.0))
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.Home)))
    check("slider Home moves to its lower bound", near(UiFlat::widget(slider).value, 0.0))
    UiFlat::keyboard((UiCore::KeyEvent.Down(code: UiCore::Key.End)))
    check("slider End moves to its upper bound", near(UiFlat::widget(slider).value, 1.0))
    UiFlat::adjust_step(slider, -1)
    check("accessibility-style adjustment shares the configured step", near(UiFlat::widget(slider).value, 0.9))
    UiFlat::adjust(slider, -2.0)
    check("slider accessibility adjustment clamps", near(UiFlat::widget(slider).value, 0.0))
    before_malformed_adjust: f32 = UiFlat::widget(slider).value
    zero_adjust: f32 = 0.0
    malformed_adjust: f32 = zero_adjust / zero_adjust
    check("non-finite slider adjustments are ignored", not UiFlat::adjust(slider, malformed_adjust) and near(UiFlat::widget(slider).value, before_malformed_adjust))
    check("non-finite accessibility values are ignored", not UiFlat::set_accessibility_value(slider, malformed_adjust) and near(UiFlat::widget(slider).value, before_malformed_adjust))
    UiFlat::set_step(slider, -1.0)
    check("negative slider steps normalize to zero", UiFlat::widget(slider).step == 0.0 and not UiFlat::adjust_step(slider, 1))
    UiCore::begin_frame()
    UiFlat::paint()
    slider_node: UiCore::AccessibilityNode = UiCore::accessibility_at(0)
    check("slider exposes its semantic role", slider_node.role == UiCore::AccessibilityRole.Slider)
    check("slider exposes its normalized value", near(slider_node.value, 0.0))
    check("slider exposes its normalized range", slider_node.has_range and slider_node.range_min == 0.0 and slider_node.range_max == 1.0 and not slider_node.range_conflict)
    base_theme: UiFlat::Theme = UiFlat::theme()
    custom_theme: mutable UiFlat::Theme = base_theme
    custom_theme.slider_horizontal_inset <- 20.0
    custom_theme.focus_ring <- UiCore::rgb(1, 2, 3)
    UiFlat::set_theme(custom_theme)
    check("theme exposes application-defined visual tokens", UiFlat::theme().focus_ring.r == 1 and near(UiFlat::theme().slider_horizontal_inset, 20.0))
    UiFlat::pointer((UiCore::PointerEvent.Down(at: UiCore::Vec2(20.0, 12.0), button: 0)))
    check("slider hit geometry follows the active theme", near(UiFlat::widget(slider).value, 0.0))
    UiFlat::pointer((UiCore::PointerEvent.Up(at: UiCore::Vec2(20.0, 12.0), button: 0)))
    UiFlat::set_theme(base_theme)

    malformed_theme: mutable UiFlat::Theme = base_theme
    malformed_theme.radio_outer_radius <- 2.0
    malformed_theme.radio_inner_radius <- 9.0
    UiFlat::set_theme(malformed_theme)
    check("theme keeps radio marks inside their outer ring", near(UiFlat::theme().radio_inner_radius, 2.0))
    UiFlat::set_theme(base_theme)

    # Choice-control geometry scales with the theme token. A compact checkbox
    # must not retain the old fixed seven-pixel inner square.
    UiFlat::reset()
    compact_checkbox: usize = UiFlat::check_box(UiFlat::NONE, 40.0, 20.0, UiCore::rgb(30, 30, 30), UiCore::rgb(40, 40, 40), UiCore::rgb(20, 20, 20))
    UiFlat::set_selected(compact_checkbox, true)
    compact_theme: mutable UiFlat::Theme = base_theme
    compact_theme.checkbox_size <- 4.0
    UiFlat::set_theme(compact_theme)
    UiFlat::layout(40.0, 20.0)
    UiCore::begin_frame()
    UiFlat::paint()
    check("compact checkbox keeps its inner mark inside the token", frame_contains_rect(15.72, 8.72, 2.56, 2.56))
    UiFlat::set_theme(base_theme)

    # Marked-text decoration follows the field geometry even when an
    # application supplies an inset larger than the field itself.
    UiFlat::reset()
    underline_field: usize = UiFlat::text_field(UiFlat::NONE, "Name", "", "abc", 80.0, 20.0, 14.0, UiCore::rgb(230, 230, 230), UiCore::rgb(30, 30, 30))
    _ = UiFlat::request_focus(underline_field)
    UiFlat::set_marked(underline_field, 0, 3)
    underline_theme: mutable UiFlat::Theme = base_theme
    underline_theme.marked_underline_inset <- 200.0
    UiFlat::set_theme(underline_theme)
    UiFlat::layout(100.0, 30.0)
    UiCore::begin_frame()
    UiFlat::paint()
    check("marked underline inset stays inside the field", frame_contains_line(12.0, 15.0, 33.0, 15.0))
    UiFlat::set_theme(base_theme)

    UiFlat::reset()
    progress: usize = UiFlat::progress_bar(UiFlat::NONE, "Upload progress", 200.0, 12.0, 1.5, UiCore::rgb(30, 30, 40), UiCore::rgb(60, 110, 220))
    UiFlat::layout(200.0, 12.0)
    check("progress values clamp at construction", near(UiFlat::widget(progress).value, 1.0))
    check("progress indicators are not interactive", UiFlat::hit(100.0, 6.0) == UiFlat::NONE)
    UiFlat::set_value(progress, 0.4)
    UiCore::begin_frame()
    UiFlat::paint()
    progress_node: UiCore::AccessibilityNode = UiCore::accessibility_at(0)
    check("progress exposes its semantic role", progress_node.role == UiCore::AccessibilityRole.ProgressBar)
    check("progress exposes its normalized value", near(progress_node.value, 0.4))
    check("progress exposes its normalized range", progress_node.has_range and progress_node.range_min == 0.0 and progress_node.range_max == 1.0 and not progress_node.range_conflict)

    if test_failures == 0:
        _ = puts("widget layout: all checks passed")
        return 0
    _ = puts("widget layout: FAILURES above")
    return 1
