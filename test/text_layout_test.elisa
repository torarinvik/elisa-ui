# Headless checks for UTF-8-safe line-break planning.

include "../src/widgets/ui_text_layout.elisa"
include "../src/widgets/ui_text_measure_layout.elisa"

extern puts(text: cstr) -> i64

# Pixel-measured layout uses the same backend metric hooks as widgets. Keep
# this fixture deterministic with one unit-width scalar and a unit line height;
# production backends replace these hooks with CoreText, SDL_ttf, or Skia.
def ui_measure_text_width(text: sview, size: f32) -> f32:
    return UiText::utf8_scalar_count(text).f32() * size

def ui_text_line_height(size: f32) -> f32:
    return size

def test_measure_provider(text: sview, size: f32) -> f32:
    return UiText::utf8_scalar_count(text).f32() * size

global mutable failures: i32 = 0

def check(name: cstr, ok: bool) -> void:
    return if ok
    failures <- failures + 1
    _ = puts(name)

def main() -> i64:
    planned: UiTextLayout::Layout = UiTextLayout::layout("one two three", 5)
    check("layout records wrapped line count", planned.line_count == 3 and not planned.overflowed)
    first: UiTextLayout::LineRange = UiTextLayout::line_at(0)
    second: UiTextLayout::LineRange = UiTextLayout::line_at(1)
    third: UiTextLayout::LineRange = UiTextLayout::line_at(2)
    check("layout breaks at whitespace", UiTextLayout::line_view("one two three", 0) == "one" and UiTextLayout::line_view("one two three", 1) == "two" and UiTextLayout::line_view("one two three", 2) == "three")
    check("line ranges preserve scalar columns", first.length == 3 and first.columns == 3 and second.offset == 4 and second.columns == 3 and third.offset == 8)

    newline: UiTextLayout::Layout = UiTextLayout::layout("top\r\nbottom", 40)
    check("CRLF produces two lines", newline.line_count == 2 and UiTextLayout::line_view("top\r\nbottom", 0) == "top" and UiTextLayout::line_view("top\r\nbottom", 1) == "bottom")
    long_word: UiTextLayout::Layout = UiTextLayout::layout("abcdefgh", 3)
    check("long words use a deterministic hard break", long_word.line_count == 3 and UiTextLayout::line_view("abcdefgh", 0) == "abc" and UiTextLayout::line_view("abcdefgh", 2) == "gh")

    unicode: UiTextLayout::Layout = UiTextLayout::layout("café 👍", 5)
    check("multibyte scalars count once", unicode.line_count == 2 and UiTextLayout::line_at(0).columns == 4 and UiTextLayout::utf8_scalar_bytes("é", 0) == 2)
    combining: UiTextLayout::Layout = UiTextLayout::layout("éx", 1)
    check("wrapping keeps combining marks with their base", combining.line_count == 2 and UiTextLayout::line_view("éx", 0) == "é" and UiTextLayout::line_view("éx", 1) == "x" and combining.max_columns == 1)
    emoji: UiTextLayout::Layout = UiTextLayout::layout("👩‍💻!", 1)
    check("wrapping keeps emoji ZWJ sequences intact", emoji.line_count == 2 and UiTextLayout::line_view("👩‍💻!", 0) == "👩‍💻")
    empty: UiTextLayout::Layout = UiTextLayout::layout("", 0)
    check("empty text still has one empty line", empty.line_count == 1 and empty.max_columns == 1 and UiTextLayout::line_at(0).length == 0)

    _ = UiTextLayout::layout("abcdef", 20)
    check("short replacement view cannot expose out of bounds bytes", UiTextLayout::line_view("a", 0) == "")
    _ = UiTextLayout::layout("ab/cd-ef", 4)
    check("wrapping preserves punctuation", UiTextLayout::line_count() == 3 and UiTextLayout::line_view("ab/cd-ef", 0) == "ab/" and UiTextLayout::line_view("ab/cd-ef", 1) == "cd-" and UiTextLayout::line_view("ab/cd-ef", 2) == "ef")
    _ = UiTextLayout::layout("a  b", 2)
    check("wrapping drops a complete whitespace run", UiTextLayout::line_view("a  b", 0) == "a" and UiTextLayout::line_view("a  b", 1) == "b")
    _ = UiTextLayout::layout("a\r\n", 20)
    check("terminal newline retains empty last line", UiTextLayout::line_count() == 2 and UiTextLayout::line_at(1).length == 0)
    missing_line: UiTextLayout::LineRange = UiTextLayout::line_at(99)
    check("out-of-range line reads fail closed", missing_line.offset == 0 and missing_line.length == 0 and missing_line.columns == 0)
    bytes: mutable u8[4] = zeroed
    bytes[0] <- 0xE2
    bytes[1] <- 65
    bytes[2] <- 66
    check("invalid continuation never consumes following ASCII", UiTextLayout::utf8_scalar_bytes(sview(&bytes[0], 0, 3), 0) == 1)
    bytes[0] <- 0xED
    bytes[1] <- 0xA0
    bytes[2] <- 0x80
    check("surrogate encoding is not a scalar", UiTextLayout::utf8_scalar_bytes(sview(&bytes[0], 0, 3), 0) == 1)
    malformed_view_words: mutable u64[2] = zeroed
    malformed_view_words[1] <- 4
    malformed_view_ref: mutable sview& = (&malformed_view_words[0]).cast[mutable sview&] can Unsafe.PointerCast
    null_view: sview = malformed_view_ref[0]
    check("text layout rejects null-backed scalar views", UiTextLayout::utf8_scalar_bytes(null_view, 0) == 0)
    bytes[0] <- 0xC2
    bytes[1] <- 65
    bytes[2] <- 0
    malformed: sview = sview(&bytes[0], 0, 2)
    check("shared scalar counter preserves following ASCII", UiText::utf8_scalar_count(malformed) == 2)
    bytes[0] <- 0xED
    bytes[1] <- 0xA0
    bytes[2] <- 0x80
    check("shared scalar counter rejects surrogate bytes", UiText::utf8_scalar_count(sview(&bytes[0], 0, 3)) == 3)
    large_bytes: mutable u8[UiCore::MAX_TEXT_BYTES + 8] = zeroed
    for index in 0..<UiCore::MAX_TEXT_BYTES + 8:
        large_bytes[index] <- 65
    large_view: sview = sview(&large_bytes[0], 0, (UiCore::MAX_TEXT_BYTES + 8).i64())
    check("shared scalar counter applies the text work cap", UiText::utf8_scalar_count(large_view) == UiCore::MAX_TEXT_BYTES and UiText::utf16_unit_count(large_view) == UiCore::MAX_TEXT_BYTES)
    check("shared scalar walker stops at the text work cap", UiText::utf8_scalar_bytes(large_view, UiCore::MAX_TEXT_BYTES) == 0)

    measured: UiTextMeasureLayout::Layout = UiTextMeasureLayout::layout("one two three", 5.0, 1.0)
    check("pixel layout wraps using backend width", measured.line_count == 3 and not measured.overflowed and measured.max_width == 5.0)
    check("pixel layout preserves measured ranges", UiTextMeasureLayout::line_view("one two three", 0) == "one" and UiTextMeasureLayout::line_view("one two three", 1) == "two" and UiTextMeasureLayout::line_at(2).width == 5.0)
    measured_unicode: UiTextMeasureLayout::Layout = UiTextMeasureLayout::layout("éx 👩‍💻", 2.0, 1.0)
    check("pixel layout keeps grapheme clusters intact", measured_unicode.line_count == 3 and UiTextMeasureLayout::line_view("éx 👩‍💻", 0) == "é" and UiTextMeasureLayout::line_view("éx 👩‍💻", 1) == "x" and UiTextMeasureLayout::line_view("éx 👩‍💻", 2) == "👩‍💻")
    oversized_cluster: UiTextMeasureLayout::Layout = UiTextMeasureLayout::layout("👩‍💻", 1.0, 1.0)
    check("pixel layout consumes an oversized cluster", oversized_cluster.line_count == 1 and UiTextMeasureLayout::line_at(0).width > 1.0)
    measured_newline: UiTextMeasureLayout::Layout = UiTextMeasureLayout::layout("top\r\nbottom", 20.0, 1.0)
    check("pixel layout preserves CRLF lines", measured_newline.line_count == 2 and UiTextMeasureLayout::line_view("top\r\nbottom", 1) == "bottom")
    measured_empty: UiTextMeasureLayout::Layout = UiTextMeasureLayout::layout("", 0.0, 0.0)
    check("pixel layout normalizes empty geometry", measured_empty.line_count == 1 and measured_empty.max_width == 1.0 and measured_empty.text_size == 1.0)
    provided: UiTextMeasureLayout::Layout = UiTextMeasureLayout::layout_with_measure("AB", 20.0, 1.0, test_measure_provider)
    check("pixel layout accepts an explicit metric provider", provided.line_count == 1 and UiTextMeasureLayout::line_at(0).width == 2.0)
    check("portable hit testing returns grapheme-safe offsets", UiTextMeasureLayout::hit_test("ABC", 20.0, 1.0, 0, 1.5) == 2 and UiTextMeasureLayout::hit_test("A🙂B", 20.0, 1.0, 0, 1.0) == 1)
    check("portable caret placement floors to grapheme starts", UiTextMeasureLayout::caret_x("ABC", 20.0, 1.0, 0, 2) == 2.0 and UiTextMeasureLayout::caret_x("A🙂B", 20.0, 1.0, 0, 2) == 1.0 and UiTextMeasureLayout::caret_x("A🙂B", 20.0, 1.0, 0, 99) == 3.0)
    measured_selection: UiTextMeasureLayout::SelectionRange = UiTextMeasureLayout::selection("ABC", 20.0, 1.0, 0, 1, 3)
    check("portable selection geometry follows grapheme carets", measured_selection.start == 1 and measured_selection.end == 3 and measured_selection.x == 1.0 and measured_selection.width == 2.0)
    emoji_selection: UiTextMeasureLayout::SelectionRange = UiTextMeasureLayout::selection("A🙂B", 20.0, 1.0, 0, 2, 3)
    check("portable selection floors an interior grapheme endpoint", emoji_selection.start == 1 and emoji_selection.end == 1 and emoji_selection.width == 0.0)
    hyphenated: UiTextMeasureLayout::Layout = UiTextMeasureLayout::layout_with_measure("ab-cd", 3.0, 1.0, test_measure_provider)
    check("pixel layout keeps hyphens at soft breaks", hyphenated.line_count == 2 and UiTextMeasureLayout::line_view("ab-cd", 0) == "ab-" and UiTextMeasureLayout::line_view("ab-cd", 1) == "cd" and UiTextMeasureLayout::line_at(0).width == 3.0)
    slashed: UiTextMeasureLayout::Layout = UiTextMeasureLayout::layout_with_measure("ab/cd", 3.0, 1.0, test_measure_provider)
    check("pixel layout keeps slashes at soft breaks", slashed.line_count == 2 and UiTextMeasureLayout::line_view("ab/cd", 0) == "ab/" and UiTextMeasureLayout::line_view("ab/cd", 1) == "cd")
    _ = UiTextMeasureLayout::layout("stale lines", 20.0, 1.0)
    empty_measured: UiTextMeasureLayout::Layout = UiTextMeasureLayout::empty_layout("unavailable", 0.0, 0.0)
    check("empty pixel layout clears shared line ranges", empty_measured.line_count == 0 and empty_measured.source_length == 11 and empty_measured.max_width == 1.0 and empty_measured.text_size == 1.0 and UiTextMeasureLayout::line_at(0).length == 0 and UiTextMeasureLayout::line_view("stale lines", 0).len == 0)
    if failures == 0:
        _ = puts("text layout: all checks passed")
        return 0
    _ = puts("text layout: FAILURES above")
    return 1
