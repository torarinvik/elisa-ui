# The flat boundary. Every kind must survive Event -> EventRecord -> Event with
# its ordinal and its payload intact, because that round trip is what the WIT
# host and a C caller see: neither can carry a variant, so both meet the library
# at EventRecord.
#
# The ordinals are asserted as LITERALS, not against the WIRE_* constants. They
# are a published encoding the host also hard-codes, so a test that reads them
# from the same constants it is checking would agree with any renumbering.

include "../src/core/ui_core.elisa"

extern puts(text: cstr) -> i64

global mutable test_failures: i32 = 0

def check(name: cstr, ok: bool) -> void:
    return if ok
    test_failures <- test_failures + 1
    _ = puts(name)

# One round trip: flatten, rebuild, flatten again. The two records must agree.
def round_trips(event: UiCore::Event, expected_kind: i32) -> bool:
    once: UiCore::EventRecord = UiCore::to_record(event)
    return false if once.kind.i32() != expected_kind
    return false if UiCore::wire_kind(event).i32() != expected_kind
    twice: UiCore::EventRecord = UiCore::to_record(UiCore::from_record(once))
    return false if twice.kind != once.kind
    return false if twice.x != once.x or twice.y != once.y
    return false if twice.dx != once.dx or twice.dy != once.dy
    return false if twice.code != once.code
    return true

def main() -> i64:
    check("None round-trips", round_trips((UiCore::Event.None), 0))
    check("Quit round-trips", round_trips((UiCore::Event.Quit), 1))
    check("Move round-trips", round_trips((UiCore::PointerEvent.Move(at: UiCore::Vec2(3.0, 4.0))), 2))
    check("Down round-trips", round_trips((UiCore::PointerEvent.Down(at: UiCore::Vec2(3.0, 4.0), button: 2)), 3))
    check("Up round-trips", round_trips((UiCore::PointerEvent.Up(at: UiCore::Vec2(5.0, 6.0), button: 1)), 4))
    check("Leave round-trips", round_trips((UiCore::PointerEvent.Leave), 5))
    check("KeyDown round-trips", round_trips((UiCore::KeyEvent.Down(code: UiCore::Key.A)), 6))
    check("KeyUp round-trips", round_trips((UiCore::KeyEvent.Up(code: UiCore::Key.Escape)), 7))
    check("Resize round-trips", round_trips((UiCore::Event.Resize(size: UiCore::Size(800.0, 600.0))), 8))
    negative_size: UiCore::Size = UiCore::Size(-3.0, -5.0)
    check("Size constructor normalizes extents", negative_size.width == 0.0 and negative_size.height == 0.0)
    negative_rect: UiCore::Rect = UiCore::Rect(2.0, 3.0, -4.0, -6.0)
    check("Rect constructor normalizes extents", negative_rect.size.width == 0.0 and negative_rect.size.height == 0.0)
    check("unit normalization clamps below zero", UiCore::normalized_unit(-0.25) == 0.0)
    check("unit normalization clamps above one", UiCore::normalized_unit(1.25) == 1.0)
    zero: f32 = 0.0
    nan: f32 = zero / zero
    infinity: f32 = 1.0 / zero
    check("unit normalization rejects NaN", UiCore::normalized_unit(nan) == 0.0)
    check("unit normalization rejects infinity", UiCore::normalized_unit(infinity) == 0.0)
    malformed_point: UiCore::Vec2 = UiCore::Vec2(nan, infinity)
    check("Vec2 construction sanitizes non-finite coordinates", malformed_point.x == 0.0 and malformed_point.y == 0.0)
    huge_point: UiCore::Vec2 = UiCore::Vec2(3.0e38, -3.0e38)
    check("Vec2 construction bounds finite coordinates", huge_point.x == UiCore::MAX_GEOMETRY_EXTENT and huge_point.y == -UiCore::MAX_GEOMETRY_EXTENT)
    malformed_box: UiCore::Rect = UiCore::Rect{origin: UiCore::Vec2{ x: infinity, y: nan }, size: UiCore::Size{width: infinity, height: nan}}
    check("right edge sanitizes malformed rectangles", UiCore::right_edge(malformed_box) == 0.0)
    check("bottom edge sanitizes malformed rectangles", UiCore::bottom_edge(malformed_box) == 0.0)
    check("contains rejects malformed rectangle input", not UiCore::contains(malformed_box, UiCore::Vec2(0.0, 0.0)))
    huge_scroll: UiCore::Event = UiCore::PointerEvent.Scroll(at: UiCore::Vec2(3.0e38, -3.0e38), delta: UiCore::Vec2(-3.0e38, 3.0e38))
    huge_scroll_record: UiCore::EventRecord = UiCore::to_record(huge_scroll)
    check("scroll event bounds finite pointer coordinates", huge_scroll_record.x == UiCore::MAX_GEOMETRY_EXTENT and huge_scroll_record.y == -UiCore::MAX_GEOMETRY_EXTENT)
    check("scroll event bounds finite deltas", huge_scroll_record.dx == -UiCore::MAX_GEOMETRY_EXTENT and huge_scroll_record.dy == UiCore::MAX_GEOMETRY_EXTENT)
    raw_pointer_record: UiCore::EventRecord = UiCore::EventRecord{kind: UiCore::WireKind.PointerMove, x: nan, y: 4.0, dx: 0.0, dy: 0.0, code: 0}
    check("raw pointer record rejects non-finite coordinates", UiCore::from_record(raw_pointer_record) == UiCore::Event.None)
    raw_scroll_record: UiCore::EventRecord = UiCore::EventRecord{kind: UiCore::WireKind.Scroll, x: 4.0, y: 4.0, dx: 0.0, dy: infinity, code: 0}
    check("raw scroll record rejects non-finite deltas", UiCore::from_record(raw_scroll_record) == UiCore::Event.None)
    raw_gamepad_button: UiCore::EventRecord = UiCore::EventRecord{kind: UiCore::WireKind.GamepadButton, x: 0.0, y: 0.0, dx: nan, dy: 0.0, code: UiCore::Pad.South.i32()}
    check("raw gamepad button rejects non-finite value", UiCore::from_record(raw_gamepad_button) == UiCore::Event.None)
    raw_gamepad_axis: UiCore::EventRecord = UiCore::EventRecord{kind: UiCore::WireKind.GamepadAxis, x: 0.0, y: 0.0, dx: infinity, dy: 0.0, code: UiCore::PadAxis.LeftX.i32()}
    check("raw gamepad axis rejects non-finite value", UiCore::from_record(raw_gamepad_axis) == UiCore::Event.None)
    UiCore::begin_frame()
    UiCore::request_frame_after(-1.0)
    check("negative frame delays are ignored", UiCore::frame_delay() == 0.0)
    UiCore::request_frame_after(nan)
    check("NaN frame delays are ignored", UiCore::frame_delay() == 0.0)
    UiCore::request_frame_after(infinity)
    check("infinite frame delays are ignored", UiCore::frame_delay() == 0.0)
    zero64: f64 = 0.0
    nan64: f64 = zero64 / zero64
    infinity64: f64 = 1.0 / zero64
    UiCore::set_frame_time(nan64)
    check("NaN frame times are ignored", UiCore::frame_time() == 0.0)
    UiCore::set_frame_time(infinity64)
    check("infinite frame times are ignored", UiCore::frame_time() == 0.0)
    text_run: UiCore::TextRun = UiCore::TextRun(UiCore::Vec2(0.0, 0.0), -4.0, "text")
    check("TextRun constructor normalizes font size", text_run.size == 0.0)
    huge_extent: f32 = 3.0e38
    huge_text_run: UiCore::TextRun = UiCore::TextRun(UiCore::Vec2(0.0, 0.0), huge_extent, "text")
    check("TextRun constructor bounds huge font sizes", huge_text_run.size == UiCore::MAX_GEOMETRY_EXTENT)
    malformed_text_origin: UiCore::TextRun = UiCore::TextRun(UiCore::Vec2{ x: infinity, y: nan }, 12.0, "text")
    check("TextRun constructor sanitizes origin", malformed_text_origin.origin.x == 0.0 and malformed_text_origin.origin.y == 0.0)
    bounded_text_bytes: mutable u8[UiCore::MAX_TEXT_BYTES + 8] = zeroed
    for index in 0..<UiCore::MAX_TEXT_BYTES + 8:
        bounded_text_bytes[index] <- 65
    oversized_text: sview = sview(&bounded_text_bytes[0], 0, (UiCore::MAX_TEXT_BYTES + 8).i64())
    bounded_run: UiCore::TextRun = UiCore::TextRun(UiCore::Vec2(0.0, 0.0), 12.0, oversized_text)
    check("TextRun bounds oversized counted text", bounded_run.text.len == UiCore::MAX_TEXT_BYTES.i64())
    bounded_text_bytes[UiCore::MAX_TEXT_BYTES - 2] <- 0xC3
    bounded_text_bytes[UiCore::MAX_TEXT_BYTES - 1] <- 0xA9
    boundary_run: UiCore::TextRun = UiCore::TextRun(UiCore::Vec2(0.0, 0.0), 12.0, oversized_text)
    check("TextRun preserves a scalar ending at the byte cap", boundary_run.text.len == UiCore::MAX_TEXT_BYTES.i64())
    bounded_text_bytes[UiCore::MAX_TEXT_BYTES - 2] <- 65
    bounded_text_bytes[UiCore::MAX_TEXT_BYTES - 1] <- 0xC3
    bounded_text_bytes[UiCore::MAX_TEXT_BYTES] <- 0xA9
    truncated_run: UiCore::TextRun = UiCore::TextRun(UiCore::Vec2(0.0, 0.0), 12.0, oversized_text)
    check("TextRun drops a scalar split by the byte cap", truncated_run.text.len == (UiCore::MAX_TEXT_BYTES - 1).i64())
    bounded_text_bytes[UiCore::MAX_TEXT_BYTES - 1] <- 65
    bounded_text_bytes[UiCore::MAX_TEXT_BYTES] <- 65
    malformed_bytes: mutable u8[3] = zeroed
    malformed_bytes[0] <- 65
    malformed_bytes[1] <- 0xC3
    malformed_bytes[2] <- 66
    malformed_view: sview = sview(&malformed_bytes[0], 0, 3)
    malformed_run: UiCore::TextRun = UiCore::TextRun(UiCore::Vec2(0.0, 0.0), 12.0, malformed_view)
    check("TextRun stops before malformed UTF-8", malformed_run.text.len == 1)
    null_text: sview = sview(null, 0, 3)
    check("counted text rejects null storage", UiCore::bounded_text(null_text).len == 0 and UiText::valid_utf8_prefix(null_text, 3) == 0 and UiText::utf8_scalar_count(null_text) == 0 and UiText::utf16_unit_count(null_text) == 0)
    UiCore::begin_frame()
    UiCore::accessibility(UiCore::AccessibilityRole.Label, oversized_text, oversized_text, UiCore::Rect(0.0, 0.0, 1.0, 1.0), 3, 0, true, false, false, 0.0, oversized_text, oversized_text, 0, 0, 0)
    bounded_node: UiCore::AccessibilityNode = UiCore::accessibility_at(0)
    check("accessibility bounds all counted text fields", bounded_node.label.len == UiCore::MAX_TEXT_BYTES.i64() and bounded_node.help.len == UiCore::MAX_TEXT_BYTES.i64() and bounded_node.text_value.len == UiCore::MAX_TEXT_BYTES.i64() and bounded_node.selected_text.len == UiCore::MAX_TEXT_BYTES.i64())
    UiCore::begin_frame()
    UiCore::fill(UiCore::Rect{origin: UiCore::Vec2{ x: nan, y: infinity }, size: UiCore::Size{width: nan, height: infinity}}, UiCore::rgb(1, 2, 3))
    match UiCore::command_at(0):
        UiCore::Command.FillRect(rect, color):
            check("fill sanitizes rectangle geometry", rect.origin.x == 0.0 and rect.origin.y == 0.0 and rect.size.width == 0.0 and rect.size.height == 0.0)
        _:
            check("fill records a rectangle command", false)
    UiCore::fill(UiCore::Circle{center: UiCore::Vec2{ x: infinity, y: nan }, radius: infinity}, UiCore::rgb(1, 2, 3))
    match UiCore::command_at(1):
        UiCore::Command.FillCircle(circle, color):
            check("fill sanitizes circle geometry", circle.center.x == 0.0 and circle.center.y == 0.0 and circle.radius == 0.0)
        _:
            check("fill records a circle command", false)
    UiCore::fill(UiCore::Rect(0.0, 0.0, huge_extent, huge_extent), UiCore::rgb(1, 2, 3))
    match UiCore::command_at(2):
        UiCore::Command.FillRect(rect, color):
            check("fill bounds huge rectangle extents", rect.size.width == UiCore::MAX_GEOMETRY_EXTENT and rect.size.height == UiCore::MAX_GEOMETRY_EXTENT)
        _:
            check("fill records a huge rectangle command", false)
    UiCore::fill(UiCore::Circle{center: UiCore::Vec2{ x: 0.0, y: 0.0 }, radius: huge_extent}, UiCore::rgb(1, 2, 3))
    match UiCore::command_at(3):
        UiCore::Command.FillCircle(circle, color):
            check("fill bounds huge circle radius", circle.radius == UiCore::MAX_GEOMETRY_EXTENT)
        _:
            check("fill records a huge circle command", false)
    UiCore::begin_frame()
    UiCore::push_command(UiCore::Command.FillRect(UiCore::Rect{origin: UiCore::Vec2{ x: infinity, y: -infinity }, size: UiCore::Size{width: huge_extent, height: huge_extent}}, UiCore::rgb(1, 2, 3)))
    match UiCore::command_at(0):
        UiCore::Command.FillRect(rect, color):
            check("raw command pushes sanitize geometry", rect.origin.x == 0.0 and rect.origin.y == 0.0 and rect.size.width == UiCore::MAX_GEOMETRY_EXTENT and rect.size.height == UiCore::MAX_GEOMETRY_EXTENT)
        _:
            check("raw command remains a rectangle", false)
    UiCore::push_command(UiCore::Command.DrawText(UiCore::TextRun{origin: UiCore::Vec2{x: infinity, y: -infinity}, size: huge_extent, text: oversized_text}, UiCore::rgb(1, 2, 3)))
    match UiCore::command_at(1):
        UiCore::Command.DrawText(run, color):
            check("raw text commands sanitize origin and size", run.origin.x == 0.0 and run.origin.y == 0.0 and run.size == UiCore::MAX_GEOMETRY_EXTENT)
            check("raw text commands bound counted text", run.text.len == UiCore::MAX_TEXT_BYTES.i64())
        _:
            check("raw command remains text", false)
    check("invalid command reads fail closed", UiCore::command_if_valid(99) == null)
    check("invalid clip reads fail closed", UiCore::command_clip_if_valid(99) == null)
    UiCore::begin_frame()
    UiCore::accessibility(UiCore::AccessibilityRole.Slider, "slider", "", UiCore::Rect{origin: UiCore::Vec2{ x: infinity, y: nan }, size: UiCore::Size{width: infinity, height: nan}}, 1, 1, true, false, false, infinity, "", "", 0, 0, 0)
    semantic: UiCore::AccessibilityNode = UiCore::accessibility_at(0)
    check("accessibility sanitizes semantic geometry and value", semantic.frame.origin.x == 0.0 and semantic.frame.origin.y == 0.0 and semantic.frame.size.width == 0.0 and semantic.frame.size.height == 0.0 and semantic.value == 0.0)
    UiCore::begin_frame()
    UiCore::accessibility(UiCore::AccessibilityRole.Button, "button", "", UiCore::Rect{origin: UiCore::Vec2{ x: -3.0, y: 4.0 }, size: UiCore::Size{width: -5.0, height: 6.0}}, 2, 2, true, false, false, 0.0, "", "", 0, 0, 0)
    negative_semantic: UiCore::AccessibilityNode = UiCore::accessibility_at(0)
    check("accessibility clamps negative frame extents", negative_semantic.frame.origin.x == -3.0 and negative_semantic.frame.origin.y == 4.0 and negative_semantic.frame.size.width == 0.0 and negative_semantic.frame.size.height == 6.0)
    check("invalid accessibility reads fail closed", UiCore::accessibility_if_valid(99) == null)
    malformed_event: UiCore::Event = UiCore::PointerEvent.Scroll(at: UiCore::Vec2{ x: nan, y: infinity }, delta: UiCore::Vec2{ x: infinity, y: nan })
    malformed_record: UiCore::EventRecord = UiCore::to_record(malformed_event)
    check("event flattening sanitizes pointer payloads", malformed_record.x == 0.0 and malformed_record.y == 0.0 and malformed_record.dx == 0.0 and malformed_record.dy == 0.0)
    far_event: UiCore::Event = UiCore::PointerEvent.Scroll(at: UiCore::Vec2{ x: huge_extent, y: -huge_extent }, delta: UiCore::Vec2{ x: huge_extent, y: -huge_extent })
    far_record: UiCore::EventRecord = UiCore::to_record(far_event)
    check("event flattening bounds pointer coordinates", far_record.x == UiCore::MAX_GEOMETRY_EXTENT and far_record.y == -UiCore::MAX_GEOMETRY_EXTENT and far_record.dx == UiCore::MAX_GEOMETRY_EXTENT and far_record.dy == -UiCore::MAX_GEOMETRY_EXTENT)
    match UiCore::from_record(far_record):
        UiCore::PointerEvent.Scroll(far_at, far_delta):
            check("event decoding preserves bounded pointer coordinates", far_at.x == UiCore::MAX_GEOMETRY_EXTENT and far_at.y == -UiCore::MAX_GEOMETRY_EXTENT and far_delta.x == UiCore::MAX_GEOMETRY_EXTENT and far_delta.y == -UiCore::MAX_GEOMETRY_EXTENT)
        _:
            check("bounded scroll record keeps its event kind", false)
    malformed_pad: UiCore::Event = UiCore::GamepadEvent.Axis(axis: UiCore::PadAxis.LeftX, value: nan)
    malformed_pad_record: UiCore::EventRecord = UiCore::to_record(malformed_pad)
    check("event flattening sanitizes gamepad values", malformed_pad_record.dx == 0.0)
    check("direct event normalization rejects non-finite gamepad values", UiCore::wire_kind(UiCore::normalize_event(malformed_pad)) == UiCore::WireKind.None)
    high_button: UiCore::EventRecord = UiCore::to_record((UiCore::GamepadEvent.Button(button: UiCore::Pad.South, value: 4.0)))
    check("event flattening clamps gamepad button values", high_button.dx == 1.0)
    high_axis: UiCore::EventRecord = UiCore::to_record((UiCore::GamepadEvent.Axis(axis: UiCore::PadAxis.LeftX, value: 4.0)))
    low_axis: UiCore::EventRecord = UiCore::to_record((UiCore::GamepadEvent.Axis(axis: UiCore::PadAxis.LeftY, value: -4.0)))
    check("event flattening clamps gamepad axis values", high_axis.dx == 1.0 and low_axis.dx == -1.0)
    hostile_record: UiCore::EventRecord = UiCore::EventRecord{
        kind: UiCore::WireKind.Scroll, x: nan, y: infinity, dx: infinity, dy: nan, code: 0,
    }
    check("event decoding rejects hostile scroll coordinates", UiCore::from_record(hostile_record) == UiCore::Event.None)
    hostile_resize: UiCore::EventRecord = UiCore::EventRecord{
        kind: UiCore::WireKind.Resize, x: -4.0, y: infinity, dx: 0.0, dy: 0.0, code: 0,
    }
    match UiCore::from_record(hostile_resize):
        UiCore::Event.Resize(size):
            check("event decoding clamps raw resize extents", size.width == 0.0 and size.height == 0.0)
        _:
            check("hostile resize record keeps its event kind", false)
    huge_resize: UiCore::EventRecord = UiCore::EventRecord{
        kind: UiCore::WireKind.Resize, x: huge_extent, y: huge_extent, dx: 0.0, dy: 0.0, code: 0,
    }
    match UiCore::from_record(huge_resize):
        UiCore::Event.Resize(size):
            check("event decoding bounds raw resize extents", size.width == UiCore::MAX_GEOMETRY_EXTENT and size.height == UiCore::MAX_GEOMETRY_EXTENT)
        _:
            check("bounded resize record keeps its event kind", false)
    check("Scroll round-trips", round_trips((UiCore::PointerEvent.Scroll(at: UiCore::Vec2(1.0, 2.0), delta: UiCore::Vec2(0.0, -3.0))), 9))
    check("GamepadButton round-trips", round_trips((UiCore::GamepadEvent.Button(button: UiCore::Pad.LeftBumper, value: 1.0)), 10))
    check("GamepadAxis round-trips", round_trips((UiCore::GamepadEvent.Axis(axis: UiCore::PadAxis.LeftY, value: -0.5)), 11))
    check("FocusGained round-trips", round_trips((UiCore::Event.FocusGained), 12))
    check("FocusLost round-trips", round_trips((UiCore::Event.FocusLost), 13))

    # The payload, not just the tag: a scroll must keep its position AND delta.
    scroll: UiCore::EventRecord = UiCore::to_record((UiCore::PointerEvent.Scroll(at: UiCore::Vec2(7.0, 8.0), delta: UiCore::Vec2(9.0, 10.0))))
    check("scroll keeps position", scroll.x == 7.0 and scroll.y == 8.0)
    check("scroll keeps delta", scroll.dx == 9.0 and scroll.dy == 10.0)

    down: UiCore::EventRecord = UiCore::to_record((UiCore::PointerEvent.Down(at: UiCore::Vec2(1.0, 2.0), button: 3)))
    check("pointer down keeps its button", down.code == 3)

    resize: UiCore::EventRecord = UiCore::to_record((UiCore::Event.Resize(size: UiCore::Size(1024.0, 768.0))))
    check("resize carries width and height", resize.x == 1024.0 and resize.y == 768.0)
    raw_resize: UiCore::EventRecord = UiCore::to_record((UiCore::Event.Resize(size: UiCore::Size{width: huge_extent, height: huge_extent})))
    check("resize wire records bound raw extents", raw_resize.x == UiCore::MAX_GEOMETRY_EXTENT and raw_resize.y == UiCore::MAX_GEOMETRY_EXTENT)

    # A NAMED code has to survive the flat form: it travels as its backing i32 and
    # comes back as the same member, or the typed payload is decoration.
    escape: UiCore::EventRecord = UiCore::to_record((UiCore::KeyEvent.Up(code: UiCore::Key.Escape)))
    check("a named key flattens to its value", escape.code == 256)
    match UiCore::from_record(escape):
        UiCore::KeyEvent.Up(code):
            check("a named key comes back named", code == UiCore::Key.Escape)
        _:
            check("a key-up rebuilds as a key-up", false)

    pad: UiCore::EventRecord = UiCore::to_record((UiCore::GamepadEvent.Axis(axis: UiCore::PadAxis.RightTrigger, value: 0.25)))
    check("a named axis flattens to its value", pad.code == 5 and pad.dx == 0.25)

    # An ordinal this library does not model is None, not a crash: the host is
    # free to grow its event set first.
    unknown: UiCore::EventRecord = UiCore::EventRecord{kind: 99.WireKind(), x: 0.0, y: 0.0, dx: 0.0, dy: 0.0, code: 0}
    check("an unknown ordinal decodes to None", UiCore::wire_kind(UiCore::from_record(unknown)) == 0)

    # Host records carry closed enum payloads as raw integers. Unknown values
    # must be rejected at the Elisa boundary instead of being cast into an
    # invalid typed event and reaching application code.
    invalid_key: UiCore::EventRecord = UiCore::EventRecord{kind: UiCore::WireKind.KeyDown.i32(), x: 0.0, y: 0.0, dx: 0.0, dy: 0.0, code: 31}
    check("unknown key payload decodes to None", UiCore::wire_kind(UiCore::from_record(invalid_key)) == 0)
    invalid_pad: UiCore::EventRecord = UiCore::EventRecord{kind: UiCore::WireKind.GamepadButton.i32(), x: 0.0, y: 0.0, dx: 1.0, dy: 0.0, code: 99}
    check("unknown gamepad payload decodes to None", UiCore::wire_kind(UiCore::from_record(invalid_pad)) == 0)
    invalid_axis: UiCore::EventRecord = UiCore::EventRecord{kind: UiCore::WireKind.GamepadAxis.i32(), x: 0.0, y: 0.0, dx: 1.0, dy: 0.0, code: -1}
    check("unknown gamepad axis payload decodes to None", UiCore::wire_kind(UiCore::from_record(invalid_axis)) == 0)
    invalid_pointer_down: UiCore::EventRecord = UiCore::EventRecord{kind: UiCore::WireKind.PointerDown.i32(), x: 0.0, y: 0.0, dx: 0.0, dy: 0.0, code: 99}
    check("unknown pointer button decodes to None", UiCore::wire_kind(UiCore::from_record(invalid_pointer_down)) == 0)
    invalid_pointer_up: UiCore::EventRecord = UiCore::EventRecord{kind: UiCore::WireKind.PointerUp.i32(), x: 0.0, y: 0.0, dx: 0.0, dy: 0.0, code: UiCore::NO_POINTER_BUTTON}
    check("missing pointer button decodes to None", UiCore::wire_kind(UiCore::from_record(invalid_pointer_up)) == 0)
    check("extra pointer buttons stay in the closed enum", UiCore::pointer_button_is_valid(UiCore::PointerButton.Forward.i32()))

    # Named enum casts can still be constructed deliberately from raw integers.
    # Flattening must reject those values too, so a C/WIT consumer never sees an
    # invalid key, button, or axis ordinal emitted by the Elisa side.
    invalid_key_out: UiCore::EventRecord = UiCore::to_record((UiCore::KeyEvent.Down(code: UiCore::Key(999))))
    check("invalid key flattening uses a rejected sentinel", invalid_key_out.code == -1 and UiCore::wire_kind(UiCore::from_record(invalid_key_out)) == 0)
    invalid_pad_out: UiCore::EventRecord = UiCore::to_record((UiCore::GamepadEvent.Button(button: UiCore::Pad(99), value: 1.0)))
    check("invalid gamepad button flattening uses a rejected sentinel", invalid_pad_out.code == -1 and UiCore::wire_kind(UiCore::from_record(invalid_pad_out)) == 0)
    invalid_axis_out: UiCore::EventRecord = UiCore::to_record((UiCore::GamepadEvent.Axis(axis: UiCore::PadAxis(-1), value: 1.0)))
    check("invalid gamepad axis flattening uses a rejected sentinel", invalid_axis_out.code == -1 and UiCore::wire_kind(UiCore::from_record(invalid_axis_out)) == 0)
    hostile_button_value: UiCore::EventRecord = UiCore::EventRecord{kind: UiCore::WireKind.GamepadButton, x: 0.0, y: 0.0, dx: 4.0, dy: 0.0, code: UiCore::Pad.South.i32()}
    hostile_axis_value: UiCore::EventRecord = UiCore::EventRecord{kind: UiCore::WireKind.GamepadAxis, x: 0.0, y: 0.0, dx: -4.0, dy: 0.0, code: UiCore::PadAxis.LeftX.i32()}
    match UiCore::from_record(hostile_button_value):
        UiCore::GamepadEvent.Button(button, value):
            check("event decoding clamps gamepad button values", value == 1.0)
        _:
            check("hostile gamepad button keeps its event kind", false)
    match UiCore::from_record(hostile_axis_value):
        UiCore::GamepadEvent.Axis(axis, value):
            check("event decoding clamps gamepad axis values", value == -1.0)
        _:
            check("hostile gamepad axis keeps its event kind", false)

    if test_failures == 0:
        _ = puts("event wire: all checks passed")
        return 0
    _ = puts("event wire: FAILURES above")
    return 1
