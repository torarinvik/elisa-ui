include "./widget_layout_support.elisa"
include "../src/platform/android/ui_android_ime.elisa"

def text_contact(id: u32, phase: UiCore::ContactPhase, time: f32, x: f32) -> void:
    can Ui.Input:
        fact: UiCore::Contact = UiCore::Contact{id: id, phase: phase, tool: UiCore::ContactTool.Finger, at: UiCore::Vec2(x, 10.0), timestamp: time}
        _ = UiGestures::observe(fact)
        android_ime_contact(fact)

def main() -> i64:
    UiMobileSurface::reset()
    _ = UiMobileSurface::start(400.0, 800.0, 2.0, UiResponsive::insets(0.0, 0.0, 0.0, 0.0))
    _ = UiMobileSurface::focus_gained()
    UiFlat::reset()
    field: usize = UiFlat::text_field(UiFlat::NONE, "Name", "", "Ada😀", 200.0, 40.0, 16.0, UiCore::rgb(255, 255, 255), UiCore::rgb(0, 0, 0))
    UiFlat::layout(400.0, 800.0)
    _ = UiFlat::request_focus(field)
    text_contact(1, UiCore::ContactPhase.Began, 1.0, 10.0)
    text_contact(1, UiCore::ContactPhase.Ended, 2.0, 10.0)
    check("long press selects focused document", UiFlat::widget(field).selection_anchor == 0 and UiFlat::widget(field).caret == 7)
    check("long press requests owner-bound menu once", android_ime_take_menu_request() == android_ime_owner() and android_ime_take_menu_request() == 0)
    UiFlat::set_selection(field, 1, 1)
    text_contact(2, UiCore::ContactPhase.Began, 3.0, 10.0)
    text_contact(2, UiCore::ContactPhase.Ended, 3.1, 10.0)
    check("tap does not select all", UiFlat::widget(field).caret == 1)
    text_contact(3, UiCore::ContactPhase.Began, 4.0, 10.0)
    text_contact(3, UiCore::ContactPhase.Ended, 5.0, 100.0)
    check("drag does not select all", UiFlat::widget(field).caret == 1)
    text_contact(4, UiCore::ContactPhase.Began, 6.0, 10.0)
    text_contact(5, UiCore::ContactPhase.Began, 6.1, 20.0)
    text_contact(5, UiCore::ContactPhase.Ended, 6.2, 20.0)
    text_contact(4, UiCore::ContactPhase.Ended, 7.0, 10.0)
    check("second contact retires text capture", UiFlat::widget(field).caret == 1)
    text_contact(6, UiCore::ContactPhase.Began, 8.0, 10.0)
    text_contact(6, UiCore::ContactPhase.Cancelled, 9.0, 10.0)
    check("cancel does not select all", UiFlat::widget(field).caret == 1)
    text_contact(7, UiCore::ContactPhase.Began, 10.0, 10.0)
    UiFlat::replace_text(field, "Changed")
    UiFlat::set_selection(field, 1, 1)
    text_contact(7, UiCore::ContactPhase.Ended, 11.0, 10.0)
    check("text revision retires long press", UiFlat::widget(field).caret == 1)
    text_contact(8, UiCore::ContactPhase.Began, 12.0, 10.0)
    UiFlat::clear_focus()
    _ = UiFlat::request_focus(field)
    text_contact(8, UiCore::ContactPhase.Ended, 13.0, 10.0)
    check("refocus retires long press", UiFlat::widget(field).caret == 1)
    text_contact(9, UiCore::ContactPhase.Began, 14.0, 10.0)
    _ = UiMobileSurface::focus_lost()
    _ = UiMobileSurface::focus_gained()
    text_contact(9, UiCore::ContactPhase.Ended, 15.0, 10.0)
    check("lifecycle round trip retires long press", UiFlat::widget(field).caret == 1)
    check("rejected presses do not request menu", android_ime_take_menu_request() == 0)
    UiFlat::replace_text(field, "")
    text_contact(10, UiCore::ContactPhase.Began, 16.0, 10.0)
    text_contact(10, UiCore::ContactPhase.Ended, 17.0, 10.0)
    check("empty document requests menu without selection", UiFlat::widget(field).caret == 0 and android_ime_take_menu_request() == android_ime_owner())
    text_contact(11, UiCore::ContactPhase.Began, 18.0, 10.0)
    text_contact(11, UiCore::ContactPhase.Ended, 19.0, 10.0)
    UiFlat::clear_focus()
    _ = UiFlat::request_focus(field)
    check("pending menu cannot cross refocus", android_ime_take_menu_request() == 0)
    return 1 if test_failures > 0
    _ = puts("android text gestures: all checks passed")
    return 0
