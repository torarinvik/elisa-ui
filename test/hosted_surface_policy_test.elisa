# Hosted-surface policy: panel rect clipping, renderer pixel sizes, when a
# frame needs a layer write, and pointer mapping into the panel. The native
# layer path is covered by test/appkit_canvas_hosted_surface_test.m.

include "../src/core/ui_hosted_surface.elisa"

extern puts(text: cstr) -> i64

global mutable hosted_failures: i32 = 0

def check(name: cstr, ok: bool) -> void:
    return if ok
    hosted_failures <- hosted_failures + 1
    _ = puts(name)

def r(x: f32, y: f32, w: f32, h: f32) -> UiHostedSurface::Rect:
    UiHostedSurface::Rect{x: x, y: y, width: w, height: h}

def same(a: UiHostedSurface::Rect, b: UiHostedSurface::Rect) -> bool:
    a.x == b.x and a.y == b.y and a.width == b.width and a.height == b.height

def main() -> i64:
    nan: f32 = 0.0 / 0.0
    inf: f32 = 1.0 / 0.0
    # Clipping.
    check("inside rect unchanged", same(UiHostedSurface::sanitize(r(10.0, 20.0, 300.0, 200.0), 800.0, 600.0), r(10.0, 20.0, 300.0, 200.0)))
    check("rect clipped to view", same(UiHostedSurface::sanitize(r(-10.0, 500.0, 300.0, 200.0), 800.0, 600.0), r(0.0, 500.0, 290.0, 100.0)))
    check("rect outside view is empty", UiHostedSurface::is_empty(UiHostedSurface::sanitize(r(900.0, 0.0, 50.0, 50.0), 800.0, 600.0)))
    check("NaN rect is empty", UiHostedSurface::is_empty(UiHostedSurface::sanitize(r(nan, 0.0, 50.0, 50.0), 800.0, 600.0)))
    check("infinite rect is empty", UiHostedSurface::is_empty(UiHostedSurface::sanitize(r(0.0, 0.0, inf, 50.0), 800.0, 600.0)))
    check("negative size is empty", UiHostedSurface::is_empty(UiHostedSurface::sanitize(r(10.0, 10.0, -5.0, 50.0), 800.0, 600.0)))
    check("zero view is empty", UiHostedSurface::is_empty(UiHostedSurface::sanitize(r(0.0, 0.0, 5.0, 5.0), 0.0, 600.0)))
    # Pixel sizes.
    check("retina doubles", UiHostedSurface::pixel_extent(300.0, 2.0) == 600)
    check("fractional points round", UiHostedSurface::pixel_extent(100.3, 1.5) == 150 and UiHostedSurface::pixel_extent(100.4, 1.5) == 151)
    check("collapsed panel keeps a pixel", UiHostedSurface::pixel_extent(0.0, 2.0) == 1 and UiHostedSurface::pixel_extent(-4.0, 2.0) == 1)
    check("NaN points keep a pixel", UiHostedSurface::pixel_extent(nan, 2.0) == 1)
    check("bad scale counts as 1", UiHostedSurface::pixel_extent(300.0, nan) == 300 and UiHostedSurface::pixel_extent(300.0, 0.0) == 300 and UiHostedSurface::pixel_extent(300.0, 100.0) == 300)
    check("huge panel capped", UiHostedSurface::pixel_extent(1.0e9, 2.0) == UiHostedSurface::MAX_EXTENT and UiHostedSurface::pixel_extent(inf, 1.0) == 1)
    # Decisions.
    mutable shown: UiHostedSurface::Shown = UiHostedSurface::empty()
    panel: UiHostedSurface::Rect = r(10.0, 20.0, 300.0, 200.0)
    check("nothing published, nothing shown", UiHostedSurface::decide(&shown, 0, 1, -1, panel) == UiHostedSurface::NONE)
    first: i32 = UiHostedSurface::decide(&shown, 4096, 1, 0, panel)
    check("first frame applies", first == UiHostedSurface::APPLY)
    UiHostedSurface::record(&shown, first, 4096, 1, 0, panel)
    check("same frame is idle", UiHostedSurface::decide(&shown, 4096, 1, 0, panel) == UiHostedSurface::NONE)
    check("new frame in same surface applies", UiHostedSurface::decide(&shown, 4096, 1, 3, panel) == UiHostedSurface::APPLY)
    check("other ring slot applies", UiHostedSurface::decide(&shown, 8192, 1, 1, panel) == UiHostedSurface::APPLY)
    check("new generation applies", UiHostedSurface::decide(&shown, 4096, 2, 0, panel) == UiHostedSurface::APPLY)
    check("moved panel applies", UiHostedSurface::decide(&shown, 4096, 1, 0, r(11.0, 20.0, 300.0, 200.0)) == UiHostedSurface::APPLY)
    check("unpublished removes", UiHostedSurface::decide(&shown, 0, 2, 0, panel) == UiHostedSurface::REMOVE)
    check("collapsed panel removes", UiHostedSurface::decide(&shown, 4096, 1, 0, r(0.0, 0.0, 0.0, 0.0)) == UiHostedSurface::REMOVE)
    UiHostedSurface::record(&shown, UiHostedSurface::REMOVE, 0, 0, 0, panel)
    check("removed slot is empty", shown.surface == 0 and shown.frame == -1)
    check("remove on empty is idle", UiHostedSurface::decide(&shown, 0, 2, 0, panel) == UiHostedSurface::NONE)
    UiHostedSurface::record(&shown, UiHostedSurface::NONE, 77, 9, 9, panel)
    check("NONE records nothing", shown.surface == 0)
    # Pointer mapping.
    check("inside", UiHostedSurface::contains(panel, 10.0, 20.0) and UiHostedSurface::contains(panel, 309.0, 219.0))
    check("edges exclusive", not UiHostedSurface::contains(panel, 310.0, 50.0) and not UiHostedSurface::contains(panel, 9.9, 50.0))
    check("NaN not inside", not UiHostedSurface::contains(panel, nan, 50.0))
    check("local pixels", UiHostedSurface::to_local_x(panel, 110.0, 2.0) == 200.0 and UiHostedSurface::to_local_y(panel, 30.0, 2.0) == 20.0)
    check("local clamps", UiHostedSurface::to_local_x(panel, 5000.0, 1.0) == 300.0 and UiHostedSurface::to_local_y(panel, -50.0, 1.0) == 0.0)
    check("local NaN", UiHostedSurface::to_local_x(panel, nan, 1.0) == 0.0)
    return hosted_failures.i64()
