# Real Skia off-screen fixture. The host owns the raster surface; Elisa owns
# the frame commands and invokes the narrow SkCanvas FFI.

include "../src/platform/skia/ui_skia.elisa"

def app_frame() -> void:
    UiCore::begin_frame()
    UiCore::clear(UiCore::rgb(18, 24, 32))
    # A zero-area retained clip is an intentional empty intersection. It must
    # suppress this fill while leaving the following unclipped primitives
    # unchanged; the off-screen host checks the resulting background pixel.
    UiCore::set_clip(UiCore::Rect(0.0, 0.0, 0.0, 10.0))
    UiCore::fill(UiCore::Rect(0.0, 0.0, 320.0, 200.0), UiCore::rgb(240, 40, 40))
    UiCore::clear_clip()
    UiCore::fill(UiCore::Rect(20.0, 20.0, 120.0, 60.0), UiCore::rgb(220, 80, 100))
    UiCore::fill(UiCore::Circle{center: UiCore::Vec2{x: 80.0, y: 130.0}, radius: 24.0}, UiCore::rgb(60, 180, 140))
    UiCore::fill(UiCore::Triangle{a: UiCore::Vec2{x: 190.0, y: 30.0}, b: UiCore::Vec2{x: 270.0, y: 30.0}, c: UiCore::Vec2{x: 230.0, y: 100.0}}, UiCore::rgb(70, 120, 220))
    UiCore::draw(UiCore::TextRun(UiCore::Vec2(20.0, 180.0), 18.0, "elisa-ui"), UiCore::rgb(240, 240, 245))
    # GLASS, over something worth seeing through. A field of hard-edged
    # stripes, with a translucent RAISED panel across its lower half: the
    # framework reads that alpha as "a panel floating above content" and asks
    # Skia to blur the backdrop inside the panel's outline. The host compares
    # the stripe contrast above the panel with the contrast under it, which is
    # the only way to assert a blur -- a colour at one point cannot tell a
    # blurred edge from a tinted one.
    for stripe in 0..<3:
        UiCore::fill(UiCore::Rect((232 + stripe * 26).f32(), 108.0, 16.0, 86.0), UiCore::rgb(245, 245, 250))
    UiCore::fill_elevated(UiCore::Rect(230.0, 150.0, 84.0, 44.0), UiCore::rgba(24, 28, 36, 120))

def skia_offscreen_render(canvas: usize, font: usize) -> i32 can[Ui.Draw, Ui.Text]:
    UiCapabilities::use_appkit_canvas()
    app_frame()
    if canvas == 0:
        return UiSkia::RenderStatus.SkippedNoSurface.i32()
    UiSkia::attach(canvas)
    status: UiSkia::RenderStatus = UiSkia::render_status_with_font(font)
    # An immediate primitive draws into the canvas as it is called. The retained
    # replay opens with a full-surface clear, so a shape drawn before it is
    # erased by definition -- the escape hatch is only observable after the
    # batch it is meant to add to.
    UiSkia::fill_linear_gradient(
        UiCore::Rect(120.0, 120.0, 100.0, 30.0),
        UiCore::rgb(20, 40, 80), UiCore::rgb(100, 180, 220), true)
    UiSkia::detach()
    return status.i32()

export fn elisa_skia_offscreen_render(canvas: usize, font: usize) -> i32 = skia_offscreen_render
