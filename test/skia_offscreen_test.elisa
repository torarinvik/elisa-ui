# Real Skia off-screen fixture. The host owns the raster surface; Elisa owns
# the frame commands and invokes the narrow SkCanvas FFI.

include "../src/platform/skia/ui_skia.elisa"

def app_frame() -> void:
    UiCore::begin_frame()
    UiCore::clear(UiCore::rgb(18, 24, 32))
    UiCore::fill(UiCore::Rect(20.0, 20.0, 120.0, 60.0), UiCore::rgb(220, 80, 100))
    UiCore::fill(UiCore::Circle{center: UiCore::Vec2{x: 80.0, y: 130.0}, radius: 24.0}, UiCore::rgb(60, 180, 140))
    UiCore::fill(UiCore::Triangle{a: UiCore::Vec2{x: 190.0, y: 30.0}, b: UiCore::Vec2{x: 270.0, y: 30.0}, c: UiCore::Vec2{x: 230.0, y: 100.0}}, UiCore::rgb(70, 120, 220))
    UiCore::draw(UiCore::TextRun(UiCore::Vec2(20.0, 180.0), 18.0, "elisa-ui"), UiCore::rgb(240, 240, 245))

def skia_offscreen_render(canvas: usize) -> i32 can[Ui.Draw, Ui.Text]:
    UiCapabilities::use_appkit_canvas()
    app_frame()
    return skia_render_frame_status_export(canvas)

export fn elisa_skia_offscreen_render(canvas: usize) -> i32 = skia_offscreen_render
