# Headless runtime contract for the Skia painter boundary. The C recorder is
# deliberately test-only; production hosts provide the same narrow symbols
# from Skia without changing this Elisa command/replay path.

include "../src/platform/skia/ui_skia.elisa"

extern puts(text: cstr) -> i64
extern skia_test_reset() -> void
extern skia_test_save_count() -> i32
extern skia_test_restore_count() -> i32
extern skia_test_scale_count() -> i32
extern skia_test_translate_count() -> i32
extern skia_test_rotate_count() -> i32
extern skia_test_clip_count() -> i32
extern skia_test_rounded_clip_count() -> i32
extern skia_test_clear_count() -> i32
extern skia_test_round_rect_count() -> i32
extern skia_test_stroke_round_rect_count() -> i32
extern skia_test_shadow_round_rect_count() -> i32
extern skia_test_gradient_count() -> i32
extern skia_test_last_gradient_horizontal() -> i32
extern skia_test_last_shadow_offset_x() -> f32
extern skia_test_last_shadow_offset_y() -> f32
extern skia_test_last_shadow_blur() -> f32
extern skia_test_last_stroke_width() -> f32
extern skia_test_last_circle_stroke_width() -> f32
extern skia_test_last_line_width() -> f32
extern skia_test_image_count() -> i32
extern skia_test_circle_count() -> i32
extern skia_test_stroke_circle_count() -> i32
extern skia_test_triangle_count() -> i32
extern skia_test_line_count() -> i32
extern skia_test_text_count() -> i32
extern skia_test_measure_width_count() -> i32
extern skia_test_last_text_size() -> f32
extern skia_test_last_round_radius() -> f32
extern skia_test_last_clip_radius() -> f32
extern skia_test_last_image_sampling() -> i32
extern skia_test_last_image_x() -> f32
extern skia_test_last_image_y() -> f32
extern skia_test_last_image_width() -> f32
extern skia_test_last_image_height() -> f32

global mutable failures: i32 = 0

def check(name: cstr, ok: bool) -> void:
    return if ok
    failures <- failures + 1
    _ = puts(name)

def main() -> i64:
    check("Skia ABI version is packed in Elisa", UiSkia::abi_version() == 0x000300 and elisa_skia_abi_version() == 0x000300)
    check("backing scale stays in Elisa", UiCore::backing_scale(320.0, 200.0, 640.0, 300.0) == 1.5 and UiCore::backing_scale(320.0, 200.0, 0.0, 300.0) == 0.0)
    UiCapabilities::use_appkit_canvas()
    check("custom profile starts with CoreGraphics fallback", UiCapabilities::renderer() == UiCapabilities::Renderer.CoreGraphics)
    UiCapabilities::use_wasm_browser()
    UiSkia::attach(6)
    check("hosted profile rejects Skia attachment", not UiSkia::is_attached() and UiCapabilities::renderer() == UiCapabilities::Renderer.Hosted)
    UiCapabilities::use_appkit_canvas()
    UiCore::begin_frame()
    UiCore::clear(UiCore::rgb(10, 20, 30))
    UiCore::set_clip(UiCore::Rect(1.0, 2.0, 30.0, 40.0))
    UiCore::fill_elevated(UiCore::Rect(2.0, 3.0, 100.0, 30.0), UiCore::rgb(40, 50, 60))
    UiCore::clear_clip()
    UiCore::fill(UiCore::Rect(2.0, 3.0, 100.0, 30.0), UiCore::rgb(45, 55, 65))
    UiCore::fill(UiCore::Circle{center: UiCore::Vec2{ x: 20.0, y: 20.0 }, radius: 4.0}, UiCore::rgb(70, 80, 90))
    UiCore::fill(UiCore::Triangle{a: UiCore::Vec2{ x: 1.0, y: 1.0 }, b: UiCore::Vec2{ x: 4.0, y: 1.0 }, c: UiCore::Vec2{ x: 2.0, y: 5.0 }}, UiCore::rgb(100, 110, 120))
    UiCore::fill(UiCore::Line{from_point: UiCore::Vec2{ x: 0.0, y: 0.0 }, to_point: UiCore::Vec2{ x: 8.0, y: 8.0 }}, UiCore::rgb(130, 140, 150))
    UiCore::draw(UiCore::TextRun(UiCore::Vec2(2.0, 12.0), 14.0, "Skia"), UiCore::rgb(160, 170, 180))
    UiCore::fill(UiCore::Rect(2.0, 3.0, 20.0, 10.0), UiCore::rgba(40, 50, 60, 0))
    UiCore::fill(UiCore::Circle{center: UiCore::Vec2{ x: 20.0, y: 20.0 }, radius: 4.0}, UiCore::rgba(70, 80, 90, 0))
    UiCore::fill(UiCore::Triangle{a: UiCore::Vec2{ x: 1.0, y: 1.0 }, b: UiCore::Vec2{ x: 4.0, y: 1.0 }, c: UiCore::Vec2{ x: 2.0, y: 5.0 }}, UiCore::rgba(100, 110, 120, 0))
    UiCore::fill(UiCore::Line{from_point: UiCore::Vec2{ x: 0.0, y: 0.0 }, to_point: UiCore::Vec2{ x: 8.0, y: 8.0 }}, UiCore::rgba(130, 140, 150, 0))
    UiCore::draw(UiCore::TextRun(UiCore::Vec2(2.0, 12.0), 14.0, "transparent"), UiCore::rgba(160, 170, 180, 0))
    check("elevation metadata is explicit", UiCore::command_is_elevated(1) and not UiCore::command_is_elevated(2))
    style: UiPaint::RoundedRectStyle = UiPaint::rounded_rect_style(UiCore::Rect(2.0, 3.0, 100.0, 30.0), true)
    plain_style: UiPaint::RoundedRectStyle = UiPaint::rounded_rect_style(UiCore::Rect(2.0, 3.0, 100.0, 30.0), false)
    check("custom painters share explicit rounded style policy", style.elevated and style.shadow_alpha == 61 and style.hairline_alpha == 33 and style.shadow_offset_x == 0.0 and style.shadow_offset_y == 2.0 and style.shadow_blur == 5.0 and style.hairline_width == 1.0 and not plain_style.elevated and plain_style.shadow_alpha == 0 and plain_style.hairline_alpha == 14)

    skia_test_reset()
    UiSkia::attach_scaled(7, 2.0)
    first_surface_generation: u32 = UiSkia::surface_generation()
    check("Skia attachment selects the renderer", UiSkia::is_attached() and first_surface_generation > 0 and UiCapabilities::supports_skia() and UiCapabilities::supports_scale_changes())
    check("Skia font policy clamps non-positive sizes", UiSkia::font_ascent(0.0) > 0.79 and UiSkia::font_ascent(0.0) < 0.81 and UiSkia::text_line_height(-4.0) > 1.19 and UiSkia::text_line_height(-4.0) < 1.21)
    skia_layout: UiTextMeasureLayout::Layout = UiSkia::layout_text("ABC DE", 20.0, 10.0)
    check("Skia layout uses its own width authority", skia_layout.line_count == 2 and UiTextMeasureLayout::line_view("ABC DE", 0) == "ABC" and UiTextMeasureLayout::line_view("ABC DE", 1) == "DE" and UiTextMeasureLayout::line_at(0).width == 15.0 and UiTextMeasureLayout::line_at(1).width == 10.0)
    width_queries_before_cache: i32 = skia_test_measure_width_count()
    cached_first: UiTextMeasureLayout::Layout = UiSkia::layout_text("cache-key", 100.0, 10.0)
    width_queries_after_first: i32 = skia_test_measure_width_count()
    cached_second: UiTextMeasureLayout::Layout = UiSkia::layout_text("cache-key", 100.0, 10.0)
    check("Skia metric cache reuses repeated grapheme widths", cached_first.line_count == cached_second.line_count and width_queries_after_first > width_queries_before_cache and skia_test_measure_width_count() == width_queries_after_first)
    check("Skia hit testing returns grapheme-safe offsets", UiSkia::hit_test_text_line("ABC DE", 20.0, 10.0, 0, 0.0) == 0 and UiSkia::hit_test_text_line("ABC DE", 20.0, 10.0, 0, 4.0) == 1 and UiSkia::hit_test_text_line("ABC DE", 20.0, 10.0, 0, 100.0) == 3 and UiSkia::hit_test_text_line("A🙂B", 40.0, 10.0, 0, 20.0) == 5)
    check("Skia caret placement uses measured grapheme edges", UiSkia::caret_x_text_line("ABC", 20.0, 10.0, 0, 2) == 10.0 and UiSkia::caret_x_text_line("A🙂B", 40.0, 10.0, 0, 2) == 5.0 and UiSkia::caret_x_text_line("A🙂B", 40.0, 10.0, 0, 5) == 25.0)
    UiSkia::draw_text_run(UiCore::TextRun(UiCore::Vec2(-100.0, 100.0), 0.0, "x"), UiCore::rgb(220, 220, 220))
    check("Skia draw policy clamps non-positive sizes", skia_test_last_text_size() == 1.0)
    text_calls_before_transparent: i32 = skia_test_text_count()
    UiSkia::draw_text_run(UiCore::TextRun(UiCore::Vec2(0.0, 0.0), 12.0, "transparent"), UiCore::rgba(220, 220, 220, 0))
    check("transparent direct text stays off the FFI", skia_test_text_count() == text_calls_before_transparent)
    initial_state: UiSkia::Snapshot = UiSkia::snapshot()
    check("Skia state snapshot starts balanced", initial_state.attached and initial_state.save_depth == 1 and initial_state.clip_depth == 0 and initial_state.transform_depth == 0 and UiSkia::is_balanced())
    transform_pushed: bool = UiSkia::push_transform(UiCore::Vec2(3.0, 4.0), UiCore::Vec2(1.5, 0.75))
    UiSkia::pop_transform()
    check("scoped transform crosses the narrow FFI", transform_pushed and skia_test_translate_count() == 1 and skia_test_scale_count() == 2)
    check("render status reports a complete batch", UiSkia::render_status() == UiSkia::RenderStatus.Complete)
    UiSkia::fill_rounded_rect(UiCore::Rect(12.0, 13.0, 40.0, 20.0), 6.0, UiCore::rgb(20, 30, 40))
    UiSkia::fill_rounded_rect(UiCore::Rect(12.0, 13.0, 40.0, 20.0), 100.0, UiCore::rgb(20, 30, 40))
    UiSkia::fill_linear_gradient(UiCore::Rect(12.0, 13.0, 40.0, 20.0), UiCore::rgb(20, 30, 40), UiCore::rgb(90, 100, 110), true)
    UiSkia::fill_linear_gradient(UiCore::Rect(12.0, 13.0, 40.0, 20.0), UiCore::rgba(20, 30, 40, 0), UiCore::rgba(90, 100, 110, 0), false)
    check("gradient policy stays in Elisa", skia_test_gradient_count() == 1 and skia_test_last_gradient_horizontal() == 1)
    check("direct rounded radius is constrained to its box", skia_test_last_round_radius() > 9.9 and skia_test_last_round_radius() < 10.1)
    UiSkia::stroke_rounded_rect(UiCore::Rect(12.0, 13.0, 40.0, 20.0), 100.0, 1.0, UiCore::rgb(20, 30, 40))
    UiSkia::fill_circle(UiCore::Circle{center: UiCore::Vec2(20.0, 24.0), radius: 5.0}, UiCore::rgb(20, 30, 40))
    UiSkia::stroke_circle(UiCore::Circle{center: UiCore::Vec2(20.0, 24.0), radius: 5.0}, 2.0, UiCore::rgb(20, 30, 40))
    UiSkia::stroke_circle(UiCore::Circle{center: UiCore::Vec2(20.0, 24.0), radius: 5.0}, 0.0, UiCore::rgb(20, 30, 40))
    UiSkia::fill_triangle(UiCore::Triangle{a: UiCore::Vec2(1.0, 1.0), b: UiCore::Vec2(4.0, 1.0), c: UiCore::Vec2(2.0, 5.0)}, UiCore::rgb(20, 30, 40))
    UiSkia::stroke_line(UiCore::Line{from_point: UiCore::Vec2(1.0, 2.0), to_point: UiCore::Vec2(8.0, 9.0)}, 1.0, UiCore::rgb(20, 30, 40))
    check("immediate custom shapes cross the Elisa-owned API", skia_test_stroke_round_rect_count() == 3 and skia_test_circle_count() == 2 and skia_test_stroke_circle_count() == 1 and skia_test_last_circle_stroke_width() == 2.0 and skia_test_triangle_count() == 2 and skia_test_line_count() == 2)
    UiSkia::fill_rounded_rect(UiCore::Rect(12.0, 13.0, 0.0, 20.0), 6.0, UiCore::rgb(20, 30, 40))
    UiResources::reset()
    logical_image: UiResources::ResourceHandle = UiResources::request("images/skia", 7)
    check("loading resource is not paintable", not UiSkia::draw_ready_image(0xBEEF, logical_image, UiCore::Rect(8.0, 9.0, 64.0, 48.0), 220))
    _ = UiResources::set_state(logical_image, UiResources::State.Ready)
    check("ready resource is paintable", UiSkia::draw_ready_image(0xBEEF, logical_image, UiCore::Rect(8.0, 9.0, 64.0, 48.0), 220))
    check("ready resource preserves image sampling", UiSkia::draw_ready_image_with_sampling(0xBEEF, logical_image, UiCore::Rect(8.0, 9.0, 64.0, 48.0), 220, UiSkia::ImageSampling.Nearest) and skia_test_last_image_sampling() == 0)
    check("ready resource rejects empty destination", not UiSkia::draw_ready_image(0xBEEF, logical_image, UiCore::Rect(8.0, 9.0, 0.0, 48.0), 220))
    check("ready image binds to its resource generation", UiSkia::bind_image(logical_image, 0xBEEF) and UiSkia::draw_bound_image(logical_image, UiCore::Rect(8.0, 9.0, 64.0, 48.0), 220))
    check("bound image preserves image sampling", UiSkia::draw_bound_image_with_sampling(logical_image, UiCore::Rect(8.0, 9.0, 64.0, 48.0), 220, UiSkia::ImageSampling.Nearest) and skia_test_last_image_sampling() == 0)
    check("unbound resource cannot draw", UiSkia::unbind_image(logical_image) and not UiSkia::draw_bound_image(logical_image, UiCore::Rect(8.0, 9.0, 64.0, 48.0), 220))
    check("disposed image binding is pruned", UiSkia::bind_image(logical_image, 0xBEEF) and UiResources::dispose(logical_image) and UiSkia::prune_bindings() == 1)
    recycled_image: UiResources::ResourceHandle = UiResources::request("images/recycled", 7)
    _ = UiResources::set_state(recycled_image, UiResources::State.Ready)
    check("resource binding index accepts a fresh image", UiSkia::bind_image(recycled_image, 0x1111) and UiSkia::draw_bound_image(recycled_image, UiCore::Rect(8.0, 9.0, 64.0, 48.0), 220))
    _ = UiResources::dispose(recycled_image)
    _ = UiSkia::prune_bindings()
    recycled_replacement: UiResources::ResourceHandle = UiResources::request("images/recycled", 7)
    _ = UiResources::set_state(recycled_replacement, UiResources::State.Ready)
    check("resource binding index accepts recycled generations", UiSkia::bind_image(recycled_replacement, 0x2222) and UiSkia::draw_bound_image(recycled_replacement, UiCore::Rect(8.0, 9.0, 64.0, 48.0), 220))
    check("stale resource generation cannot resolve a recycled binding", not UiSkia::draw_bound_image(recycled_image, UiCore::Rect(8.0, 9.0, 64.0, 48.0), 220))
    font_resource: UiResources::ResourceHandle = UiResources::request("fonts/ui", 7)
    check("loading font resource is not paintable", not UiSkia::draw_ready_text(0xCAFE, font_resource, UiCore::TextRun(UiCore::Vec2(4.0, 16.0), 12.0, "font"), UiCore::rgb(220, 220, 220)))
    _ = UiResources::set_state(font_resource, UiResources::State.Ready)
    check("ready font resource is paintable", UiSkia::draw_ready_text(0xCAFE, font_resource, UiCore::TextRun(UiCore::Vec2(4.0, 16.0), 12.0, "font"), UiCore::rgb(220, 220, 220)))
    ready_text_calls_before_transparent: i32 = skia_test_text_count()
    check("transparent ready text stays off the FFI", not UiSkia::draw_ready_text(0xCAFE, font_resource, UiCore::TextRun(UiCore::Vec2(4.0, 16.0), 12.0, "transparent"), UiCore::rgba(220, 220, 220, 0)) and skia_test_text_count() == ready_text_calls_before_transparent)
    check("ready font metrics use the borrowed typeface", UiSkia::measure_ready_text_width(0xCAFE, font_resource, "font", 12.0) > 28.7 and UiSkia::measure_ready_text_width(0xCAFE, font_resource, "font", 12.0) < 28.9 and UiSkia::ready_font_ascent(0xCAFE, font_resource, 12.0) > 10.1 and UiSkia::ready_font_ascent(0xCAFE, font_resource, 12.0) < 10.3 and UiSkia::ready_font_line_height(0xCAFE, font_resource, 12.0) > 14.9 and UiSkia::ready_font_line_height(0xCAFE, font_resource, 12.0) < 15.1)
    check("ready font binds to its resource generation", UiSkia::bind_font(font_resource, 0xCAFE) and UiSkia::draw_bound_text(font_resource, UiCore::TextRun(UiCore::Vec2(4.0, 16.0), 12.0, "font"), UiCore::rgb(220, 220, 220)))
    check("bound font metrics use the registered typeface", UiSkia::measure_bound_text_width(font_resource, "font", 12.0) > 28.7 and UiSkia::bound_font_ascent(font_resource, 12.0) > 10.1 and UiSkia::bound_font_line_height(font_resource, 12.0) > 14.9)
    bound_layout: UiTextMeasureLayout::Layout = UiSkia::layout_bound_text(font_resource, "ABC DE", 20.0, 10.0)
    check("bound font layout uses the registered typeface", bound_layout.line_count == 2 and UiTextMeasureLayout::line_at(0).width == 18.0 and UiTextMeasureLayout::line_at(1).width == 12.0)
    fallback_font_resource: UiResources::ResourceHandle = UiResources::request("fonts/fallback", 7)
    _ = UiResources::set_state(fallback_font_resource, UiResources::State.Ready)
    _ = UiSkia::bind_font(fallback_font_resource, 0xD00D)
    primary_loading_font: UiResources::ResourceHandle = UiResources::request("fonts/primary", 7)
    check("font fallback draws while primary loads", UiSkia::draw_bound_text_with_fallback(primary_loading_font, fallback_font_resource, UiCore::TextRun(UiCore::Vec2(4.0, 16.0), 12.0, "font"), UiCore::rgb(220, 220, 220)))
    check("font fallback metrics use the ready fallback", UiSkia::measure_bound_text_width_with_fallback(primary_loading_font, fallback_font_resource, "font", 12.0) > 28.7 and UiSkia::bound_font_ascent_with_fallback(primary_loading_font, fallback_font_resource, 12.0) > 10.1 and UiSkia::bound_font_line_height_with_fallback(primary_loading_font, fallback_font_resource, 12.0) > 14.9)
    _ = UiResources::set_state(primary_loading_font, UiResources::State.Ready)
    _ = UiSkia::bind_font(primary_loading_font, 0xFACE)
    check("ready primary font wins over fallback", UiSkia::draw_bound_text_with_fallback(primary_loading_font, fallback_font_resource, UiCore::TextRun(UiCore::Vec2(4.0, 16.0), 12.0, "font"), UiCore::rgb(220, 220, 220)) and UiSkia::measure_bound_text_width_with_fallback(primary_loading_font, fallback_font_resource, "font", 12.0) > 28.7)
    _ = UiResources::dispose(primary_loading_font)
    _ = UiResources::dispose(fallback_font_resource)
    check("unbound font cannot draw", UiSkia::unbind_font(font_resource) and not UiSkia::draw_bound_text(font_resource, UiCore::TextRun(UiCore::Vec2(4.0, 16.0), 12.0, "font"), UiCore::rgb(220, 220, 220)))
    check("disposed font binding is pruned", UiSkia::bind_font(font_resource, 0xCAFE) and UiResources::dispose(font_resource) and UiSkia::prune_bindings() == 1)
    shared_resource: UiResources::ResourceHandle = UiResources::request("assets/shared", 7)
    _ = UiResources::set_state(shared_resource, UiResources::State.Ready)
    check("one teardown clears image and font bindings", UiSkia::bind_image(shared_resource, 0xBEEF) and UiSkia::bind_font(shared_resource, 0xCAFE) and UiSkia::clear_resource_bindings(shared_resource) == 2)
    _ = UiResources::dispose(shared_resource)
    UiSkia::draw_image(0xBEEF, UiCore::Rect(8.0, 9.0, 64.0, 48.0), 220)
    UiSkia::draw_image_with_sampling(0xBEEF, UiCore::Rect(8.0, 9.0, 64.0, 48.0), 220, UiSkia::ImageSampling.Nearest)
    check("image sampling policy crosses FFI explicitly", skia_test_last_image_sampling() == 0)
    UiSkia::draw_image(0, UiCore::Rect(8.0, 9.0, 64.0, 48.0), 220)
    UiSkia::draw_image(0xBEEF, UiCore::Rect(8.0, 9.0, 0.0, 48.0), 220)
    check("frame, transform, and clip saves are balanced", skia_test_save_count() == 3 and skia_test_restore_count() == 2)
    UiSkia::detach()
    check("detach restores the frame transform", skia_test_restore_count() == 3)
    check("scale crosses the boundary for attachment and transform", skia_test_scale_count() == 2)
    check("clip crosses the boundary once", skia_test_clip_count() == 1)
    check("all commands replay through Skia", skia_test_clear_count() == 1 and skia_test_round_rect_count() == 4 and skia_test_stroke_round_rect_count() == 3 and skia_test_shadow_round_rect_count() == 1 and skia_test_image_count() == 8 and skia_test_circle_count() == 2 and skia_test_triangle_count() == 2 and skia_test_line_count() == 2 and skia_test_text_count() == 6)
    check("Skia shadow policy stays in Elisa", skia_test_last_shadow_offset_x() == 0.0 and skia_test_last_shadow_offset_y() == 2.0 and skia_test_last_shadow_blur() == 5.0)
    check("Skia hairline policy stays in Elisa", skia_test_last_stroke_width() == 1.0 and skia_test_last_line_width() == 1.0)
    check("detach clears the borrowed state", not UiSkia::is_attached())
    check("detached render status is explicit", UiSkia::render_status() == UiSkia::RenderStatus.SkippedNoSurface)

    skia_test_reset()
    UiSkia::attach(17)
    polygon: UiSkia::ConvexPolygon = UiSkia::empty_polygon()
    polygon_added: bool = UiSkia::polygon_add(polygon, UiCore::Vec2(1.0, 1.0)) and UiSkia::polygon_add(polygon, UiCore::Vec2(9.0, 1.0)) and UiSkia::polygon_add(polygon, UiCore::Vec2(9.0, 9.0)) and UiSkia::polygon_add(polygon, UiCore::Vec2(1.0, 9.0))
    limited_polygon: UiSkia::ConvexPolygon = UiSkia::empty_polygon()
    for index in 0..<UiSkia::MAX_POLYGON_POINTS:
        _ = UiSkia::polygon_add(limited_polygon, UiCore::Vec2(index.f32(), index.f32()))
    check("bounded polygon builder stays in Elisa", polygon_added and polygon.count == 4 and limited_polygon.count == UiSkia::MAX_POLYGON_POINTS and not UiSkia::polygon_add(limited_polygon, UiCore::Vec2(5.0, 5.0)))
    UiSkia::fill_convex_polygon(polygon, UiCore::rgb(120, 130, 140))
    check("convex polygon triangulates through existing primitives", skia_test_triangle_count() == 2)
    UiSkia::stroke_convex_polygon(polygon, 2.0, UiCore::rgb(120, 130, 140))
    check("convex polygon outlines reuse Elisa line policy", skia_test_line_count() == 4 and skia_test_last_line_width() == 2.0)
    block_layout: UiTextMeasureLayout::Layout = UiSkia::draw_text_block("ABC DE", UiCore::Rect(0.0, 0.0, 20.0, 40.0), 10.0, UiCore::rgb(220, 220, 220))
    check("Skia text block draws Elisa-planned lines", block_layout.line_count == 2 and skia_test_text_count() == 2 and skia_test_save_count() == 2 and skia_test_restore_count() == 1 and UiSkia::is_balanced())
    UiSkia::detach()
    check("Skia text block leaves the frame balanced", skia_test_restore_count() == 2 and UiSkia::is_balanced())

    alignment_box: UiCore::Rect = UiCore::Rect(10.0, 20.0, 100.0, 20.0)
    check("Skia text alignment stays in Elisa", UiSkia::aligned_text_origin(alignment_box, 20.0, UiSkia::HorizontalTextAlignment.Start) == 10.0 and UiSkia::aligned_text_origin(alignment_box, 20.0, UiSkia::HorizontalTextAlignment.Center) == 50.0 and UiSkia::aligned_text_origin(alignment_box, 20.0, UiSkia::HorizontalTextAlignment.End) == 90.0)
    check("Skia vertical text placement stays in Elisa", UiSkia::aligned_text_baseline(UiCore::Rect(0.0, 20.0, 100.0, 40.0), 8.0, 12.0, 2, UiSkia::VerticalTextAlignment.Top) == 28.0 and UiSkia::aligned_text_baseline(UiCore::Rect(0.0, 20.0, 100.0, 40.0), 8.0, 12.0, 2, UiSkia::VerticalTextAlignment.Center) == 36.0 and UiSkia::aligned_text_baseline(UiCore::Rect(0.0, 20.0, 100.0, 40.0), 8.0, 12.0, 2, UiSkia::VerticalTextAlignment.Bottom) == 44.0)

    block_font_resource: UiResources::ResourceHandle = UiResources::request("fonts/block", 7)
    _ = UiResources::set_state(block_font_resource, UiResources::State.Ready)
    _ = UiSkia::bind_font(block_font_resource, 0xB10C)
    skia_test_reset()
    UiSkia::attach(18)
    bound_block: UiTextMeasureLayout::Layout = UiSkia::draw_bound_text_block(block_font_resource, "ABC DE", UiCore::Rect(0.0, 0.0, 20.0, 40.0), 10.0, UiCore::rgb(220, 220, 220), UiSkia::HorizontalTextAlignment.Center, UiSkia::VerticalTextAlignment.Center)
    check("bound font text block draws through one scoped typeface", bound_block.line_count == 2 and skia_test_text_count() == 2 and skia_test_save_count() == 2 and skia_test_restore_count() == 1 and UiSkia::is_balanced())
    skia_test_reset()
    bound_selection: UiTextMeasureLayout::Layout = UiSkia::fill_bound_text_selection(block_font_resource, "ABC DE", UiCore::Rect(0.0, 0.0, 20.0, 40.0), 10.0, 1, 6, UiCore::rgba(70, 120, 220, 180), UiSkia::HorizontalTextAlignment.Start, UiSkia::VerticalTextAlignment.Top, 2.0)
    bound_caret: UiTextMeasureLayout::Layout = UiSkia::draw_bound_text_caret(block_font_resource, "ABC", UiCore::Rect(0.0, 0.0, 20.0, 20.0), 10.0, 0, 2, UiCore::rgb(220, 220, 220), UiSkia::HorizontalTextAlignment.Start, UiSkia::VerticalTextAlignment.Top, 2.0, 1.0)
    check("bound font selection retains measured lines", bound_selection.line_count == 2)
    check("bound font caret retains measured line", bound_caret.line_count == 1)
    check("bound font selection and caret paint through rounded primitives", skia_test_round_rect_count() == 3)
    check("bound font selection and caret own clip scopes", skia_test_clip_count() == 2 and skia_test_save_count() == 2 and skia_test_restore_count() == 2 and UiSkia::is_balanced())
    UiSkia::detach()
    _ = UiResources::dispose(block_font_resource)

    skia_test_reset()
    UiSkia::attach(19)
    clipped_block: UiTextMeasureLayout::Layout = UiSkia::draw_text_block_positioned("A\nB\nC", UiCore::Rect(0.0, 0.0, 20.0, 10.0), 10.0, UiCore::rgb(220, 220, 220), UiSkia::HorizontalTextAlignment.Start, UiSkia::VerticalTextAlignment.Top)
    check("Skia text blocks retain layout while culling offscreen lines", clipped_block.line_count == 3 and skia_test_text_count() == 1 and skia_test_save_count() == 2 and skia_test_restore_count() == 1)
    UiSkia::detach()

    selection_rect: UiCore::Rect = UiSkia::text_selection_rect("ABC DE", UiCore::Rect(0.0, 0.0, 20.0, 40.0), 10.0, 0, 1, 6, UiSkia::HorizontalTextAlignment.Start, UiSkia::VerticalTextAlignment.Top, 2.0)
    check("Skia selection geometry shares positioned text metrics", selection_rect.origin.x == 5.0 and selection_rect.origin.y == 2.0 and selection_rect.size.width == 10.0 and selection_rect.size.height == 8.0)
    skia_test_reset()
    UiSkia::attach(27)
    selected_block: UiTextMeasureLayout::Layout = UiSkia::fill_text_selection("ABC DE", UiCore::Rect(0.0, 0.0, 20.0, 40.0), 10.0, 1, 6, UiCore::rgba(70, 120, 220, 180), UiSkia::HorizontalTextAlignment.Start, UiSkia::VerticalTextAlignment.Top, 2.0)
    check("Skia selection painting stays in Elisa", selected_block.line_count == 2 and skia_test_round_rect_count() == 2 and skia_test_clip_count() == 1 and skia_test_save_count() == 2 and skia_test_restore_count() == 1 and UiSkia::is_balanced())
    UiSkia::detach()

    caret_rect: UiCore::Rect = UiSkia::text_caret_rect("ABC", UiCore::Rect(0.0, 0.0, 20.0, 20.0), 10.0, 0, 2, UiSkia::HorizontalTextAlignment.Start, UiSkia::VerticalTextAlignment.Top, 2.0, 1.0)
    check("Skia caret geometry shares grapheme and font metrics", caret_rect.origin.x == 10.0 and caret_rect.origin.y == 1.0 and caret_rect.size.width == 2.0 and caret_rect.size.height == 10.0)
    skia_test_reset()
    UiSkia::attach(28)
    caret_layout: UiTextMeasureLayout::Layout = UiSkia::draw_text_caret("ABC", UiCore::Rect(0.0, 0.0, 20.0, 20.0), 10.0, 0, 2, UiCore::rgb(220, 220, 220), UiSkia::HorizontalTextAlignment.Start, UiSkia::VerticalTextAlignment.Top, 2.0, 1.0)
    check("Skia caret painting stays in Elisa", caret_layout.line_count == 1 and skia_test_round_rect_count() == 1 and skia_test_clip_count() == 1 and skia_test_save_count() == 2 and skia_test_restore_count() == 1 and UiSkia::is_balanced())
    UiSkia::detach()

    fallback_selection_font: UiResources::ResourceHandle = UiResources::request("fonts/selection-fallback", 7)
    _ = UiResources::set_state(fallback_selection_font, UiResources::State.Ready)
    _ = UiSkia::bind_font(fallback_selection_font, 0xFA11)
    missing_selection_font: UiResources::ResourceHandle = UiResources::request("fonts/selection-primary", 7)
    skia_test_reset()
    UiSkia::attach(29)
    fallback_selection: UiTextMeasureLayout::Layout = UiSkia::fill_bound_text_selection_with_fallback(missing_selection_font, fallback_selection_font, "ABC", UiCore::Rect(0.0, 0.0, 20.0, 20.0), 10.0, 1, 3, UiCore::rgba(70, 120, 220, 180), UiSkia::HorizontalTextAlignment.Start, UiSkia::VerticalTextAlignment.Top, 1.0)
    fallback_caret: UiTextMeasureLayout::Layout = UiSkia::draw_bound_text_caret_with_fallback(missing_selection_font, fallback_selection_font, "ABC", UiCore::Rect(0.0, 0.0, 20.0, 20.0), 10.0, 0, 2, UiCore::rgb(220, 220, 220), UiSkia::HorizontalTextAlignment.Start, UiSkia::VerticalTextAlignment.Top, 2.0, 1.0)
    check("fallback font selection and caret stay resource-safe", fallback_selection.line_count == 1 and fallback_caret.line_count == 1 and skia_test_round_rect_count() == 2 and skia_test_clip_count() == 2 and skia_test_save_count() == 3 and skia_test_restore_count() == 2 and UiSkia::is_balanced())
    UiSkia::detach()
    _ = UiResources::dispose(missing_selection_font)
    _ = UiResources::dispose(fallback_selection_font)

    scale_font_resource: UiResources::ResourceHandle = UiResources::request("fonts/scale", 7)
    _ = UiResources::set_state(scale_font_resource, UiResources::State.Ready)
    _ = UiSkia::bind_font(scale_font_resource, 0x5CA1E)
    skia_test_reset()
    UiSkia::attach(20)
    _ = UiSkia::bind_font(scale_font_resource, 0x5CA1E)
    check("Skia diagnostics report the active scale", UiSkia::snapshot().surface_scale == 1.0 and UiSkia::snapshot().font_bindings == 1)
    _ = UiSkia::layout_text("scale-cache", 100.0, 10.0)
    width_queries_before_scale_reset: i32 = skia_test_measure_width_count()
    UiSkia::attach_scaled(20, 2.0)
    check("scale changes invalidate borrowed font bindings", UiSkia::snapshot().surface_scale == 2.0 and UiSkia::snapshot().font_bindings == 0)
    _ = UiSkia::layout_text("scale-cache", 100.0, 10.0)
    check("scale changes invalidate cached Skia metrics", skia_test_measure_width_count() > width_queries_before_scale_reset)
    UiSkia::detach()
    _ = UiResources::dispose(scale_font_resource)

    UiSkia::attach(9)
    generation_before_invalid_attach: u32 = UiSkia::surface_generation()
    UiSkia::attach(0)
    check("invalid attachment advances the surface generation", not UiSkia::is_attached() and UiSkia::surface_generation() != generation_before_invalid_attach)
    skia_render_frame_export(0)
    lost_surface_generation: u32 = UiSkia::surface_generation()
    check("invalid one-shot frame clears stale state", not UiSkia::is_attached() and lost_surface_generation != first_surface_generation)
    UiSkia::attach(11)
    check("surface recreation receives a new generation", UiSkia::is_attached() and UiSkia::surface_generation() != lost_surface_generation)
    UiSkia::surface_lost()
    check("explicit surface loss preserves renderer state", not UiSkia::is_attached() and UiCapabilities::supports_skia())
    UiCore::begin_frame()
    limit: usize = UiCore::MAX_COMMANDS + 1
    for index in 0..<limit:
        UiCore::clear(UiCore::rgb(1, 2, 3))
    UiSkia::attach(13)
    check("render status reports command overflow", UiSkia::render_status() == UiSkia::RenderStatus.CommandOverflow and not UiSkia::render_checked())
    surface_resource: UiResources::ResourceHandle = UiResources::request("images/surface", 7)
    _ = UiResources::set_state(surface_resource, UiResources::State.Ready)
    _ = UiSkia::bind_image(surface_resource, 0xBEEF)
    _ = UiSkia::bind_font(surface_resource, 0xCAFE)
    UiSkia::surface_lost()
    check("surface loss clears borrowed renderer bindings", not UiSkia::draw_bound_image(surface_resource, UiCore::Rect(8.0, 9.0, 64.0, 48.0), 220) and not UiSkia::draw_bound_text(surface_resource, UiCore::TextRun(UiCore::Vec2(4.0, 16.0), 12.0, "font"), UiCore::rgb(220, 220, 220)))
    lost_state: UiSkia::Snapshot = UiSkia::snapshot()
    check("surface loss snapshot is detached and empty", not lost_state.attached and lost_state.save_depth == 0 and lost_state.clip_depth == 0 and lost_state.transform_depth == 0 and lost_state.image_bindings == 0 and lost_state.font_bindings == 0 and UiSkia::is_balanced())
    _ = UiResources::dispose(surface_resource)
    skia_test_reset()
    UiSkia::attach(21)
    check("direct clip rejects empty geometry", not UiSkia::push_clip(UiCore::Rect(1.0, 2.0, 0.0, 4.0)))
    check("direct clip scope pushes", UiSkia::push_clip(UiCore::Rect(1.0, 2.0, 8.0, 9.0)))
    UiSkia::push_transform(UiCore::Vec2(1.0, 2.0), UiCore::Vec2(2.0, 2.0))
    check("mismatched clip pop is rejected", not UiSkia::pop_clip())
    UiSkia::pop_transform()
    check("typed scopes restore in LIFO order", UiSkia::pop_clip() and UiSkia::is_balanced())
    UiSkia::push_rotation(45.0)
    UiSkia::detach()
    check("detach restores forgotten clip and transform scopes", skia_test_save_count() == 4 and skia_test_restore_count() == 4 and skia_test_rotate_count() == 1)
    skia_test_reset()
    UiSkia::attach(23)
    scope_attempts: usize = UiSkia::MAX_SCOPE_DEPTH + 2
    accepted_scopes: usize =
        for _ in 0..<scope_attempts |accepted: usize = 0| -> accepted:
            accepted <- accepted + 1 if UiSkia::push_transform(UiCore::Vec2(1.0, 1.0), UiCore::Vec2(1.0, 1.0))
    bounded_scope_state: UiSkia::Snapshot = UiSkia::snapshot()
    check("direct Skia scopes stop at the depth budget", accepted_scopes == UiSkia::MAX_SCOPE_DEPTH - 1 and bounded_scope_state.save_depth == UiSkia::MAX_SCOPE_DEPTH and bounded_scope_state.transform_depth == accepted_scopes)
    check("rotation push reports budget rejection", not UiSkia::push_rotation(90.0) and skia_test_rotate_count() == 0)
    check("scope overflow does not cross the FFI", skia_test_save_count() == UiSkia::MAX_SCOPE_DEPTH.i32())
    UiSkia::detach()
    check("bounded scopes still detach cleanly", skia_test_restore_count() == UiSkia::MAX_SCOPE_DEPTH.i32() and UiSkia::is_balanced())
    UiCore::begin_frame()
    UiCore::set_clip(UiCore::Rect(1.0, 2.0, 8.0, 9.0))
    UiCore::fill(UiCore::Rect(1.0, 2.0, 8.0, 9.0), UiCore::rgb(4, 5, 6))
    skia_test_reset()
    UiSkia::attach(24)
    for _ in 0..<UiSkia::MAX_SCOPE_DEPTH - 1:
        _ = UiSkia::push_transform(UiCore::Vec2(1.0, 1.0), UiCore::Vec2(1.0, 1.0))
    check("retained replay reserves a clip scope at direct depth limit", UiSkia::render_status() == UiSkia::RenderStatus.Complete and skia_test_clip_count() == 1 and skia_test_save_count() == (UiSkia::MAX_SCOPE_DEPTH + 1).i32())
    UiSkia::detach()
    check("reserved replay clip restores without stealing a custom scope", skia_test_restore_count() == (UiSkia::MAX_SCOPE_DEPTH + 1).i32() and UiSkia::is_balanced())
    UiCore::begin_frame()
    UiCore::set_clip(UiCore::Rect(1.0, 2.0, 0.0, 4.0))
    UiCore::fill(UiCore::Rect(1.0, 2.0, 8.0, 9.0), UiCore::rgb(4, 5, 6))
    skia_test_reset()
    UiSkia::attach(22)
    check("retained empty clips still cross the Skia boundary", UiSkia::render_status() == UiSkia::RenderStatus.Complete and skia_test_clip_count() == 1)
    UiSkia::detach()
    check("retained empty clip restores its save scope", skia_test_save_count() == 2 and skia_test_restore_count() == 2 and UiSkia::is_balanced())
    skia_test_reset()
    UiSkia::attach(25)
    check("rounded clip rejects empty geometry", not UiSkia::push_rounded_clip(UiCore::Rect(1.0, 2.0, 0.0, 4.0), 4.0))
    check("rounded clip bounds radius in Elisa", UiSkia::push_rounded_clip(UiCore::Rect(1.0, 2.0, 8.0, 9.0), 100.0) and skia_test_rounded_clip_count() == 1 and not UiSkia::is_balanced() and UiSkia::snapshot().clip_depth == 1 and skia_test_last_clip_radius() == 4.0)
    check("rounded clip restores through the typed pop", UiSkia::pop_clip() and UiSkia::is_balanced())
    UiSkia::detach()
    check("rounded clip scope detaches cleanly", skia_test_save_count() == 2 and skia_test_restore_count() == 2)
    skia_test_reset()
    UiSkia::attach(26)
    UiSkia::fill_rounded_linear_gradient(UiCore::Rect(1.0, 2.0, 8.0, 9.0), 100.0, UiCore::rgb(20, 40, 80), UiCore::rgb(100, 180, 220), true)
    check("rounded gradients compose Elisa scopes", skia_test_rounded_clip_count() == 1 and skia_test_gradient_count() == 1 and skia_test_save_count() == 2 and skia_test_restore_count() == 1 and UiSkia::is_balanced())
    UiSkia::detach()
    check("rounded gradient scope detaches cleanly", skia_test_restore_count() == 2)
    UiCore::begin_frame()
    UiCore::clear(UiCore::rgb(4, 5, 6))
    check("one-shot status export reports complete", skia_render_frame_status_export(31) == UiSkia::RenderStatus.Complete.i32() and not UiSkia::is_attached())
    check("one-shot status export reports no surface", skia_render_frame_status_export(0) == UiSkia::RenderStatus.SkippedNoSurface.i32() and not UiSkia::is_attached())

    skia_test_reset()
    UiSkia::attach(30)
    source_size: UiCore::Size = UiCore::Size(100.0, 50.0)
    fit_box: UiCore::Rect = UiCore::Rect(10.0, 20.0, 100.0, 100.0)
    check("contain fit preserves aspect ratio in Elisa", UiSkia::draw_image_fitted(0xCAFE, fit_box, source_size, 255, UiSkia::ImageFit.Contain) and skia_test_last_image_x() == 10.0 and skia_test_last_image_y() == 45.0 and skia_test_last_image_width() == 100.0 and skia_test_last_image_height() == 50.0 and skia_test_clip_count() == 0)
    check("cover fit preserves aspect ratio and clips in Elisa", UiSkia::draw_image_fitted_with_sampling(0xCAFE, fit_box, source_size, 255, UiSkia::ImageFit.Cover, UiSkia::ImageSampling.Nearest) and skia_test_last_image_x() == -40.0 and skia_test_last_image_y() == 20.0 and skia_test_last_image_width() == 200.0 and skia_test_last_image_height() == 100.0 and skia_test_last_image_sampling() == 0 and skia_test_clip_count() == 1)
    check("invalid image source dimensions fail closed", not UiSkia::draw_image_fitted(0xCAFE, fit_box, UiCore::Size(0.0, 50.0), 255, UiSkia::ImageFit.Contain) and skia_test_image_count() == 2)
    UiSkia::detach()
    check("fitted image clip scope is balanced", skia_test_save_count() == 2 and skia_test_restore_count() == 2 and UiSkia::is_balanced())

    UiResources::reset()
    intrinsic_image: UiResources::ResourceHandle = UiResources::request("images/intrinsic-fit", 7)
    _ = UiResources::set_intrinsic_size(intrinsic_image, 100.0, 50.0)
    _ = UiResources::set_state(intrinsic_image, UiResources::State.Ready)
    _ = UiSkia::bind_image(intrinsic_image, 0xBEEF)
    skia_test_reset()
    UiSkia::attach(32)
    check("bound image fit can consume intrinsic metadata", UiSkia::draw_bound_image_fitted_intrinsic_with_sampling(intrinsic_image, fit_box, 255, UiSkia::ImageFit.Contain, UiSkia::ImageSampling.Nearest) and skia_test_last_image_x() == 10.0 and skia_test_last_image_y() == 45.0 and skia_test_last_image_width() == 100.0 and skia_test_last_image_height() == 50.0 and skia_test_last_image_sampling() == 0)
    UiSkia::detach()
    _ = UiResources::dispose(intrinsic_image)

    skia_test_reset()
    UiSkia::attach(33)
    interactive_layout: UiTextMeasureLayout::Layout = UiSkia::draw_text_block_interactive("A\nB", UiCore::Rect(0.0, 0.0, 30.0, 30.0), 10.0, UiCore::rgb(220, 220, 220), 0, 1, UiCore::rgba(70, 120, 220, 180), 1, 1, 2.0, UiCore::rgb(220, 220, 220), UiSkia::HorizontalTextAlignment.Start, UiSkia::VerticalTextAlignment.Top, 1.0)
    check("interactive text paints one measured selection/text/caret pass", interactive_layout.line_count == 2 and skia_test_round_rect_count() == 2 and skia_test_text_count() == 2 and skia_test_clip_count() == 1 and skia_test_save_count() == 2 and skia_test_restore_count() == 1 and UiSkia::is_balanced())
    UiSkia::detach()
    check("interactive text scope restores its frame", skia_test_restore_count() == 2 and UiSkia::is_balanced())

    if failures == 0:
        _ = puts("skia painter: all checks passed")
        return 0
    _ = puts("skia painter: FAILURES above")
    return 1
