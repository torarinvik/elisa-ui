# Headless runtime contract for the Skia painter boundary. The C recorder is
# deliberately test-only; production hosts provide the same narrow symbols
# from Skia without changing this Elisa command/replay path.

include "./skia_painter/support.elisa"
include "./skia_painter/abi_and_command_batch.elisa"
include "./skia_painter/immediate_painting.elisa"
include "./skia_painter/text_and_polygons.elisa"
include "./skia_painter/surface_lifecycle_and_scopes.elisa"
include "./skia_painter/image_fitting_and_deferred_images.elisa"
include "./skia_painter/deferred_scopes.elisa"
include "./skia_painter/vocabulary.elisa"

# The phases run in this order on purpose: each leaves the painter detached, and phase 4
# needs the surface generation phase 2 observed. Their files carry the checks themselves.
def main() -> i64:
    check_abi_and_command_batch()
    first_surface_generation: u32 = check_immediate_painting()
    check_text_and_polygons()
    check_surface_lifecycle_and_scopes(first_surface_generation)
    check_image_fitting_and_deferred_images()
    check_deferred_scopes()
    check_vocabulary()
    if failures == 0:
        _ = puts("skia painter: all checks passed")
        return 0
    _ = puts("skia painter: FAILURES above")
    return 1
