# Widget hierarchy: layout, hit testing, and sub-category typing.
#
# Needs no backend -- the widget layer depends only on the core, so the sizer
# maths and the pointer state machine run without a window. Text measurement is
# part of the platform contract, so this file supplies deterministic stubs
# rather than depending on whichever font a host loads.

include "../src/widgets/ui_ops.elisa"

using UiWidgets

extern puts(text: cstr) -> i64

global mutable test_failures: i32 = 0
global mutable test_last_click: UiWidgets::Widget? = null
global mutable test_click_count: i32 = 0
global mutable hostile_metrics: bool = false

# The application contract: the widget layer calls this when a press and its
# release land on the same widget.
def app_widget_event(widget: UiWidgets::Widget, event: i32) -> void:
    return if event != UiConst::WidgetEvent.Click.i32()
    test_last_click <- widget
    test_click_count <- test_click_count + 1

def ui_measure_text_width(text: sview, size: f32, weighted: bool) -> f32:
    return 3.0e38 if hostile_metrics
    return text.len.f32() * size * 0.5

def ui_measure_text_height(text: sview, size: f32) -> f32:
    return size

def ui_font_ascent(size: f32) -> f32:
    return size

def ui_text_line_height(size: f32) -> f32:
    return 3.0e38 if hostile_metrics
    return size

def check(name: cstr, actual: f32, expected: f32) -> void:
    delta: f32 = actual - expected if actual > expected else expected - actual
    return if delta < 0.01
    test_failures <- test_failures + 1
    _ = puts(name)

def expect(name: cstr, ok: bool) -> void:
    return if ok
    test_failures <- test_failures + 1
    _ = puts(name)

def grey(v: u8) -> UiCore::Color:
    return UiCore::Color{r: v, g: v, b: v, a: 255}

def command_rect_width(index: usize) -> f32:
    match UiCore::command_at(index):
        UiCore::Command.FillRect(rect, color):
            return rect.size.width
        _:
            return -1.0

def command_text_origin_x(index: usize) -> f32:
    match UiCore::command_at(index):
        UiCore::Command.DrawText(run, color):
            return run.origin.x
        _:
            return -1.0

def command_rect_origin_x(index: usize) -> f32:
    match UiCore::command_at(index):
        UiCore::Command.FillRect(rect, color):
            return rect.origin.x
        _:
            return -1.0

def command_text_size(index: usize) -> f32:
    match UiCore::command_at(index):
        UiCore::Command.DrawText(run, color):
            return run.size
        _:
            return -1.0

# A row of two buttons inside a padded panel:
#
#   Box(row, padding 10, spacing 5)
#     +-- Push "ok"     min 40 wide, grow 0
#     +-- Push "cancel" min 60 wide, grow 1   <- takes all the slack
#
# Surface is 200 wide, so inner width is 180, gaps 5, demand 100, slack 75.
def build() -> Widget:
    can Memory.Allocate, Abort.Panic:
        # The raw constructor form: every common by name, then the variant's own.
        ok: Widget = Button.Push(min_width: 40.0, min_height: 20.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "ok", rest: grey(60), hover: grey(90), press: grey(30))
        cancel: Widget = Button.Push(min_width: 60.0, min_height: 20.0, grow: 1.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "cancel", rest: grey(60), hover: grey(90), press: grey(30))
        row: Widget = Container.Box(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: ok, next_sibling: null, axis: UiConst::Axis.Row, padding: 10.0, spacing: 5.0, fill: grey(20))
        ok.next_sibling <- cancel
        return row

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        root: Widget = build()
        layout(root, 200.0, 60.0)

        check("root width", root.width, 200.0)
        check("root height", root.height, 60.0)

        first: Widget? = root.first_child
        if first is ok_node:
            # No grow: keeps its minimum, placed at the padding edge.
            check("ok x", ok_node.x, 10.0)
            check("ok width", ok_node.width, 40.0)
            # Cross axis: stretched to the inner height (60 - 2*10).
            check("ok height", ok_node.height, 40.0)
            # The growing sibling took the slack: 180 - 5 - 100 = 75 on top of 60.
            if ok_node.next_sibling is cancel_node:
                check("cancel width", cancel_node.width, 135.0)
                check("cancel x", cancel_node.x, 55.0)
            else:
                test_failures <- test_failures + 1
                _ = puts("no cancel")

        # A button is a Control is a Widget: all three types accept it, which is
        # the whole point of the sealed split.
        interactive: bool = is_interactive(root)
        test_failures <- test_failures + 1 if interactive

        # The panel is inert, so a click inside it falls through to the button.
        hit_widget: Widget? = hit(root, 20.0, 30.0)
        if hit_widget is hit_node:
            check("hit x", hit_node.x, 10.0)
        else:
            test_failures <- test_failures + 1
            _ = puts("no hit")

        # A click outside every widget hits nothing.
        miss: Widget? = hit(root, 500.0, 500.0)
        test_failures <- test_failures + 1 if miss != null

        # Press then release on the same widget is a click.
        pointer(root, (UiCore::PointerEvent.Down(at: UiCore::Vec2(20.0, 30.0), button: 0)))
        pointer(root, (UiCore::PointerEvent.Up(at: UiCore::Vec2(20.0, 30.0), button: 0)))
        test_failures <- test_failures + 1 if test_click_count != 1
        if test_click_count != 1:
            _ = puts("click not delivered")

        # Secondary-button presses are pointer input, not primary activation.
        # The hierarchy and flat layers must agree so a context-menu gesture
        # cannot accidentally invoke a button action.
        pointer(root, (UiCore::PointerEvent.Down(at: UiCore::Vec2(20.0, 30.0), button: UiCore::PointerButton.Secondary.i32())))
        pointer(root, (UiCore::PointerEvent.Up(at: UiCore::Vec2(20.0, 30.0), button: UiCore::PointerButton.Secondary.i32())))
        test_failures <- test_failures + 1 if test_click_count != 1

        # Press, then release somewhere else: cancelled, no second click.
        pointer(root, (UiCore::PointerEvent.Down(at: UiCore::Vec2(20.0, 30.0), button: 0)))
        pointer(root, (UiCore::PointerEvent.Up(at: UiCore::Vec2(500.0, 500.0), button: 0)))
        test_failures <- test_failures + 1 if test_click_count != 1
        if test_click_count != 1:
            _ = puts("drag-off should cancel")

        # Hover state follows the pointer and clears when it leaves.
        pointer(root, (UiCore::PointerEvent.Move(at: UiCore::Vec2(20.0, 30.0))))
        test_failures <- test_failures + 1 if hot() == null
        pointer(root, (UiCore::PointerEvent.Leave))
        test_failures <- test_failures + 1 if hot() != null

        # A scrolled viewport keeps its own frame while its content is shifted
        # along the declared axis. This must be layout data, not a backend-only
        # transform, so hit testing and every renderer agree on the result.
        scrolled_child: Widget = Button.Push(min_width: 40.0, min_height: 20.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "item", rest: grey(60), hover: grey(90), press: grey(30))
        scroll_view: Widget = Container.Scroll(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: scrolled_child, next_sibling: null, axis: UiConst::Axis.Column, offset: 12.0, fill: grey(20))
        layout(scroll_view, 100.0, 80.0)
        check("scroll viewport keeps its origin", scroll_view.y, 0.0)
        check("short scroll content stays at its leading edge", scrolled_child.y, 0.0)
        test_failures <- test_failures + 1 if scroll_to(scroll_view, 24.0)

        # Public enum constructors can bypass the convenience builder and
        # carry a finite offset far beyond the geometry envelope. Layout must
        # clamp that translation to the measured content end before it reaches
        # child coordinates, even though the immutable node cannot be updated.
        hostile_scroll_child: Widget = Button.Push(min_width: 40.0, min_height: 200.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "hostile", rest: grey(60), hover: grey(90), press: grey(30))
        hostile_scroll: Widget = Container.Scroll(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: hostile_scroll_child, next_sibling: null, axis: UiConst::Axis.Column, offset: 3.0e38, fill: grey(20))
        layout(hostile_scroll, 100.0, 80.0)
        check("immutable scroll offset clamps at content end", hostile_scroll_child.y, -120.0)

        # Stateful viewports keep their offset in caller-owned Elisa state, so
        # wheel input can mutate a packed hierarchy without any native policy.
        scroll_state: ScrollState = ScrollState{offset: 0.0}
        scroll_a: Widget = Button.Push(min_width: 40.0, min_height: 30.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "a", rest: grey(30), hover: grey(40), press: grey(20))
        scroll_b: Widget = Button.Push(min_width: 40.0, min_height: 30.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "b", rest: grey(30), hover: grey(40), press: grey(20))
        scroll_c: Widget = Button.Push(min_width: 40.0, min_height: 30.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "c", rest: grey(30), hover: grey(40), press: grey(20))
        scroll_a.next_sibling <- scroll_b
        scroll_b.next_sibling <- scroll_c
        stateful_scroll: Widget = Container.ScrollWithState(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, axis: UiConst::Axis.Column, state: &scroll_state, fill: grey(18))
        stateful_scroll.first_child <- scroll_a
        layout(stateful_scroll, 100.0, 50.0)
        check("stateful scroll starts at zero", scroll_state.offset, 0.0)
        check("stateful scroll reports content limit", scroll_limit(stateful_scroll), 40.0)
        UiCore::clear_all_invalidations()
        if not scroll_to(stateful_scroll, 12.0):
            test_failures <- test_failures + 1
        check("stateful scroll stores requested offset", scroll_state.offset, 12.0)
        scroll_invalidations: i32 = UiCore::invalidations()
        test_failures <- test_failures + 1 if (scroll_invalidations & UiCore::Invalidation.Layout.i32()) == 0
        test_failures <- test_failures + 1 if (scroll_invalidations & UiCore::Invalidation.Paint.i32()) == 0
        test_failures <- test_failures + 1 if (scroll_invalidations & UiCore::Invalidation.Semantics.i32()) == 0
        layout(stateful_scroll, 100.0, 50.0)
        check("stateful scroll lays out translated content", scroll_b.y, 18.0)
        pointer(stateful_scroll, (UiCore::PointerEvent.Move(at: UiCore::Vec2(10.0, 45.0))))
        hover_before_wheel: mutable bool = false
        if hot() is hot_before:
            match hot_before:
                Button.Push(label, rest, hover, press):
                    hover_before_wheel <- label == "b"
                _:
                    pass
        test_failures <- test_failures + 1 if not hover_before_wheel or not scroll_b.hovered
        pointer(stateful_scroll, (UiCore::PointerEvent.Scroll(at: UiCore::Vec2(10.0, 45.0), delta: UiCore::Vec2(0.0, -10.0))))
        check("wheel input refreshes hierarchy hover", scroll_state.offset, 22.0)
        hover_after_wheel: mutable bool = false
        if hot() is hot_after:
            match hot_after:
                Button.Push(label, rest, hover, press):
                    hover_after_wheel <- label == "c"
                _:
                    pass
        test_failures <- test_failures + 1 if not hover_after_wheel or not scroll_c.hovered or scroll_b.hovered
        _ = scroll_to(stateful_scroll, 12.0)
        layout(stateful_scroll, 100.0, 50.0)
        pointer(stateful_scroll, (UiCore::PointerEvent.Scroll(at: UiCore::Vec2(10.0, 10.0), delta: UiCore::Vec2(0.0, -10.0))))
        check("wheel input advances stateful scroll", scroll_state.offset, 22.0)
        check("wheel input reflows content", scroll_c.y, 38.0)
        pointer(stateful_scroll, (UiCore::PointerEvent.Scroll(at: UiCore::Vec2(10.0, 10.0), delta: UiCore::Vec2(0.0, -100.0))))
        check("wheel input clamps at content end", scroll_state.offset, 40.0)
        pointer(stateful_scroll, (UiCore::PointerEvent.Scroll(at: UiCore::Vec2(200.0, 10.0), delta: UiCore::Vec2(0.0, -10.0))))
        check("wheel outside viewport is ignored", scroll_state.offset, 40.0)

        # Direct typed hierarchy events must fail closed just like events that
        # arrive through UiEvents. A non-finite wheel delta must not turn into a
        # synthetic jump to either scroll endpoint.
        invalid_scroll_delta: f32 = 1.0 / 0.0
        before_invalid_wheel: f32 = scroll_state.offset
        pointer(stateful_scroll, (UiCore::PointerEvent.Scroll(at: UiCore::Vec2(10.0, 10.0), delta: UiCore::Vec2(0.0, invalid_scroll_delta))))
        check("typed hierarchy wheel rejects non-finite delta", scroll_state.offset, before_invalid_wheel)
        invalid_scroll_request: f32 = 0.0 / 0.0
        before_invalid_request: f32 = scroll_state.offset
        test_failures <- test_failures + 1 if scroll_to(stateful_scroll, invalid_scroll_request)
        check("typed scroll setter preserves state on invalid request", scroll_state.offset, before_invalid_request)

        # Nested stateful viewports bubble a wheel delta once the inner one is
        # edge-clamped. The inner viewport is manually constrained here to
        # model the common case where a parent supplies its visible height;
        # the hierarchy's root layout API otherwise sizes a scroll node from
        # its content when it is unconstrained.
        nested_outer_state: ScrollState = ScrollState{offset: 0.0}
        nested_inner_state: ScrollState = ScrollState{offset: 0.0}
        nested_a: Widget = Button.Push(min_width: 40.0, min_height: 30.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "a", rest: grey(30), hover: grey(40), press: grey(20))
        nested_b: Widget = Button.Push(min_width: 40.0, min_height: 30.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "b", rest: grey(30), hover: grey(40), press: grey(20))
        nested_c: Widget = Button.Push(min_width: 40.0, min_height: 30.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "c", rest: grey(30), hover: grey(40), press: grey(20))
        nested_a.next_sibling <- nested_b
        nested_b.next_sibling <- nested_c
        nested_inner: Widget = Container.ScrollWithState(min_width: 0.0, min_height: 50.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: nested_a, next_sibling: null, axis: UiConst::Axis.Column, state: &nested_inner_state, fill: grey(18))
        nested_outer_tail: Widget = Button.Push(min_width: 40.0, min_height: 80.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "tail", rest: grey(30), hover: grey(40), press: grey(20))
        nested_inner.next_sibling <- nested_outer_tail
        nested_outer: Widget = Container.ScrollWithState(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: nested_inner, next_sibling: null, axis: UiConst::Axis.Column, state: &nested_outer_state, fill: grey(18))
        layout(nested_outer, 100.0, 50.0)
        check("nested scroll keeps its parent-provided viewport", nested_inner.height, 50.0)
        _ = scroll_to(nested_inner, 40.0)
        layout(nested_inner, 100.0, 50.0)
        check("nested inner viewport reaches its edge", nested_inner_state.offset, 40.0)
        pointer(nested_outer, (UiCore::PointerEvent.Scroll(at: UiCore::Vec2(10.0, 10.0), delta: UiCore::Vec2(0.0, -20.0))))
        check("edge-clamped nested wheel bubbles to its parent", nested_inner_state.offset, 40.0)
        check("parent viewport consumes bubbled wheel", nested_outer_state.offset, 20.0)

        # Direct state edits are normalized by the next layout just like
        # scroll_to requests, so callers cannot leave a stale offset beyond
        # the current content range.
        nested_inner_state.offset <- 999.0
        layout(nested_inner, 100.0, 50.0)
        check("layout clamps direct scroll-state edits", nested_inner_state.offset, 40.0)

        # Hierarchy painting carries the same scroll-viewport clip metadata as
        # UiFlat, so translated children cannot bleed outside their container.
        clipped_a: Widget = Button.Push(min_width: 40.0, min_height: 30.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "a", rest: grey(30), hover: grey(40), press: grey(20))
        clipped_b: Widget = Button.Push(min_width: 40.0, min_height: 30.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "b", rest: grey(30), hover: grey(40), press: grey(20))
        clipped_a.next_sibling <- clipped_b
        clipped_scroll: Widget = Container.Scroll(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: clipped_a, next_sibling: null, axis: UiConst::Axis.Column, offset: 20.0, fill: grey(18))
        layout(clipped_scroll, 100.0, 40.0)
        UiCore::begin_frame()
        paint(clipped_scroll)
        clipped_commands: mutable i32 = 0
        clipped_geometry: mutable bool = false
        for command_index in 0..<UiCore::command_count():
            if UiCore::command_has_clip(command_index):
                clipped_commands <- clipped_commands + 1
                clip: UiCore::Rect = UiCore::command_clip_at(command_index)
                clipped_geometry <- true if clip.origin.x == 0.0 and clip.origin.y == 0.0 and clip.size.width == 100.0 and clip.size.height == 40.0
        test_failures <- test_failures + 1 if clipped_commands == 0
        test_failures <- test_failures + 1 if not clipped_geometry

        # A grid uses a fixed column count and uniform cells rather than
        # degenerating into a vertical box.
        grid_a: Widget = Button.Push(min_width: 20.0, min_height: 10.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "a", rest: grey(30), hover: grey(40), press: grey(20))
        grid_b: Widget = Button.Push(min_width: 40.0, min_height: 20.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "b", rest: grey(30), hover: grey(40), press: grey(20))
        grid_c: Widget = Button.Push(min_width: 30.0, min_height: 15.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "c", rest: grey(30), hover: grey(40), press: grey(20))
        grid_a.next_sibling <- grid_b
        grid_b.next_sibling <- grid_c
        grid: Widget = Container.Grid(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: grid_a, next_sibling: null, columns: 2, padding: 4.0, spacing: 2.0, fill: grey(15))
        layout(grid, 100.0, 80.0)
        check("grid keeps its viewport width", grid.width, 100.0)
        check("grid places the second item in the next column", grid_b.x, 51.0)
        check("grid places the third item on the next row", grid_c.y, 41.0)
        check("grid cells use the largest child minimum", grid_a.width, 45.0)

        # Raw grid constructors must report the same geometry that arrange
        # uses. Negative padding/spacing are valid inputs at the sealed enum
        # boundary, but both passes normalize them to zero instead of letting
        # the measured minimum disagree with the placed cell positions.
        malformed_grid_a: Widget = Button.Push(min_width: 20.0, min_height: 10.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "a", rest: grey(30), hover: grey(40), press: grey(20))
        malformed_grid_b: Widget = Button.Push(min_width: 30.0, min_height: 10.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "b", rest: grey(30), hover: grey(40), press: grey(20))
        malformed_grid_a.next_sibling <- malformed_grid_b
        malformed_grid: Widget = Container.Grid(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: malformed_grid_a, next_sibling: null, columns: 2, padding: -5.0, spacing: -7.0, fill: grey(15))
        layout(malformed_grid, 60.0, 10.0)
        check("grid measurement clamps negative padding and spacing", malformed_grid.min_width, 60.0)
        check("grid arrangement shares the normalized minimum", malformed_grid_b.x, 30.0)

        # Tight surfaces must not leak negative geometry to descendants. This
        # can happen when a raw hierarchy node's padding is larger than the
        # viewport (the builder normally supplies ordinary positive values).
        tight_child: Widget = Button.Push(min_width: 12.0, min_height: 8.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "tight", rest: grey(30), hover: grey(40), press: grey(20))
        tight_panel: Widget = Container.Box(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: tight_child, next_sibling: null, axis: UiConst::Axis.Column, padding: 20.0, spacing: 4.0, fill: grey(15))
        layout(tight_panel, 10.0, 8.0)
        test_failures <- test_failures + 1 if tight_panel.width < 0.0 or tight_panel.height < 0.0
        test_failures <- test_failures + 1 if tight_child.width < 0.0 or tight_child.height < 0.0

        # Grid cells follow the same invariant even when inter-cell gaps are
        # wider than the available content area and children have no minimum.
        empty_cell: Widget = Button.Push(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "", rest: grey(30), hover: grey(40), press: grey(20))
        tight_grid: Widget = Container.Grid(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: empty_cell, next_sibling: null, columns: 2, padding: 20.0, spacing: 100.0, fill: grey(15))
        layout(tight_grid, 5.0, 5.0)
        test_failures <- test_failures + 1 if empty_cell.width < 0.0 or empty_cell.height < 0.0

        # The public entry point also normalizes an invalid viewport, matching
        # UiFlat::layout and keeping hit testing's box invariant total.
        layout(tight_grid, -5.0, -3.0)
        test_failures <- test_failures + 1 if tight_grid.width < 0.0 or tight_grid.height < 0.0

        # Raw hierarchy constructors may also carry malformed minimums. The
        # measure pass sanitizes them before demand and arrangement math sees
        # the values, keeping child boxes nonnegative end to end.
        malformed_child: Widget = Button.Push(min_width: -12.0, min_height: -8.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "malformed", rest: grey(30), hover: grey(40), press: grey(20))
        malformed_panel: Widget = Container.Box(min_width: -1.0, min_height: -1.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: malformed_child, next_sibling: null, axis: UiConst::Axis.Row, padding: 0.0, spacing: 0.0, fill: grey(15))
        layout(malformed_panel, 20.0, 12.0)
        test_failures <- test_failures + 1 if malformed_panel.min_width < 0.0 or malformed_panel.min_height < 0.0
        test_failures <- test_failures + 1 if malformed_child.min_width < 0.0 or malformed_child.min_height < 0.0
        test_failures <- test_failures + 1 if malformed_child.width < 0.0 or malformed_child.height < 0.0

        # Public raw constructors can also carry finite values much larger
        # than a useful viewport. The layout pass saturates those inputs before
        # aggregation, so no valid f32 can become an infinite box after a
        # padding, spacing, growth, or child-size calculation.
        huge: f32 = 3.0e38
        huge_child: Widget = Button.Push(min_width: huge, min_height: huge, grow: huge, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "huge", rest: grey(30), hover: grey(40), press: grey(20))
        huge_panel: Widget = Container.Box(min_width: huge, min_height: huge, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: huge_child, next_sibling: null, axis: UiConst::Axis.Row, padding: huge, spacing: huge, fill: grey(15))
        layout(huge_panel, huge, huge)
        test_failures <- test_failures + 1 if huge_panel.width > UiConstraints::MAX_EXTENT or huge_panel.height > UiConstraints::MAX_EXTENT
        test_failures <- test_failures + 1 if huge_child.width > UiConstraints::MAX_EXTENT or huge_child.height > UiConstraints::MAX_EXTENT
        test_failures <- test_failures + 1 if huge_panel.width != huge_panel.width or huge_panel.height != huge_panel.height or huge_child.width != huge_child.width or huge_child.height != huge_child.height

        # Nested hostile padding must not make a stored child origin disagree
        # with the bounded box projection used by painting and native frames.
        nested_huge_leaf: Widget = Button.Push(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "nested", rest: grey(30), hover: grey(40), press: grey(20))
        nested_huge_inner: Widget = Container.Box(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: nested_huge_leaf, next_sibling: null, axis: UiConst::Axis.Column, padding: huge, spacing: 0.0, fill: grey(15))
        nested_huge_outer: Widget = Container.Box(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: nested_huge_inner, next_sibling: null, axis: UiConst::Axis.Column, padding: huge, spacing: 0.0, fill: grey(15))
        layout(nested_huge_outer, huge, huge)
        check("nested layout bounds child x", nested_huge_inner.x, UiConstraints::MAX_EXTENT)
        check("nested layout bounds grandchild x", nested_huge_leaf.x, UiConstraints::MAX_EXTENT)
        check("nested layout bounds child y", nested_huge_inner.y, UiConstraints::MAX_EXTENT)
        check("nested layout bounds grandchild y", nested_huge_leaf.y, UiConstraints::MAX_EXTENT)

        # Scroll-range arithmetic must sanitize raw coordinates before
        # subtraction. Opposite-signed finite f32 values otherwise overflow to
        # infinity and are misread as an empty content extent.
        extreme_scroll_state: ScrollState = ScrollState{offset: 0.0}
        extreme_scroll_child: Widget = Button.Push(min_width: 0.0, min_height: 0.0, grow: 0.0, x: huge, y: huge, width: huge, height: huge, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "extreme", rest: grey(30), hover: grey(40), press: grey(20))
        extreme_scroll: Widget = Container.ScrollWithState(min_width: 0.0, min_height: 0.0, grow: 0.0, x: -huge, y: -huge, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: extreme_scroll_child, next_sibling: null, axis: UiConst::Axis.Column, state: &extreme_scroll_state, fill: grey(18))
        check("scroll range survives extreme raw coordinates", scroll_limit(extreme_scroll), UiConstraints::MAX_EXTENT)

        # Growth weights are layout metrics too. A hostile negative weight must
        # not steal space from a valid sibling or poison the weighted pass.
        invalid_grow: Widget = Button.Push(min_width: 20.0, min_height: 8.0, grow: -4.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "invalid grow", rest: grey(30), hover: grey(40), press: grey(20))
        valid_grow: Widget = Button.Push(min_width: 20.0, min_height: 8.0, grow: 1.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "valid grow", rest: grey(30), hover: grey(40), press: grey(20))
        invalid_grow.next_sibling <- valid_grow
        growth_row: Widget = Container.Box(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: invalid_grow, next_sibling: null, axis: UiConst::Axis.Row, padding: 0.0, spacing: 0.0, fill: grey(15))
        layout(growth_row, 100.0, 12.0)
        check("negative growth keeps its minimum", invalid_grow.width, 20.0)
        check("valid growth receives the remaining space", valid_grow.width, 80.0)

        # Direct hierarchy painting follows the same normalized value contract
        # as native controls and UiFlat: a gauge cannot fill past its frame.
        gauge: Widget = Control.Gauge(min_width: 40.0, min_height: 10.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, fraction: 2.0, track: grey(20), bar: grey(200))
        layout(gauge, 100.0, 20.0)
        UiCore::begin_frame()
        paint(gauge)
        if UiCore::command_count() != 2:
            test_failures <- test_failures + 1
            _ = puts("gauge emits track and bar")
        if UiCore::command_count() > 1:
            bar_width: f32 = command_rect_width(1)
            if bar_width > gauge.width:
                test_failures <- test_failures + 1
                _ = puts("gauge bar is clamped to its frame")

        # Reversed slider ranges are normalized before the knob is positioned,
        # so an invalid range cannot place the knob outside its track.
        slider: Widget = Control.Slider(min_width: 40.0, min_height: 10.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, value: 5.0, low: 10.0, high: 0.0, track: grey(20), knob: grey(200))
        layout(slider, 100.0, 20.0)
        UiCore::begin_frame()
        paint(slider)
        if UiCore::command_count() > 1:
            knob_x: f32 = command_rect_origin_x(1)
            if knob_x < slider.x or knob_x + slider.height > slider.x + slider.width:
                test_failures <- test_failures + 1
                _ = puts("slider knob stays inside its frame")

        # BOTH WIDGET LAYERS READ THE SAME WAY. The sealed hierarchy has its
        # own painter and it had heard none of the direction work done in the
        # flat layer: every run was drawn at the box's left edge and every fill
        # grew from it. Two layers that disagree about which way the reader
        # reads is worse than one layer that is simply wrong, because the bug
        # becomes a property of which API the application happened to pick.
        quarter: Widget = Control.Gauge(min_width: 40.0, min_height: 10.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, fraction: 0.25, track: grey(20), bar: grey(200))
        layout(quarter, 100.0, 20.0)
        UiCore::begin_frame()
        paint(quarter)
        ltr_bar_x: f32 = command_rect_origin_x(1)
        ltr_bar_width: f32 = command_rect_width(1)
        _ = UiLocalization::set_locale("ar-SA")
        UiCore::begin_frame()
        paint(quarter)
        rtl_bar_x: f32 = command_rect_origin_x(1)
        rtl_bar_width: f32 = command_rect_width(1)
        expect("a gauge fills from the reader's start edge", ltr_bar_x < rtl_bar_x)
        expect("with the same width either way", ltr_bar_width == rtl_bar_width)
        expect("and ending at the far edge", rtl_bar_x + rtl_bar_width > quarter.x + quarter.width - 0.01)

        # A run is placed from the reader's own edge in this layer too.
        caption: Widget = Control.Label(min_width: 0.0, min_height: 20.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, text: "Save", size: 20.0, ink: grey(240))
        layout(caption, 200.0, 20.0)
        UiCore::begin_frame()
        paint(caption)
        rtl_caption_x: f32 = command_text_origin_x(0)
        _ = UiLocalization::set_locale("en-US")
        UiCore::begin_frame()
        paint(caption)
        ltr_caption_x: f32 = command_text_origin_x(0)
        expect("a label starts at the reader's own edge here as well", rtl_caption_x > ltr_caption_x)
        expect("and the default reader is unchanged", ltr_caption_x == caption.x)

        # The ratio calculation must retain a midpoint when the finite range
        # itself would overflow f32 subtraction.
        wide_slider: Widget = Control.Slider(min_width: 40.0, min_height: 10.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, value: 0.0, low: -3.0e38, high: 3.0e38, track: grey(20), knob: grey(200))
        layout(wide_slider, 100.0, 20.0)
        UiCore::begin_frame()
        paint(wide_slider)
        if UiCore::command_count() > 1:
            wide_knob_x: f32 = command_rect_origin_x(1)
            expected_wide_knob_x: f32 = wide_slider.x + (wide_slider.width - wide_slider.height) * 0.5
            check("wide slider preserves midpoint", wide_knob_x, expected_wide_knob_x)

        # Raw hierarchy text payloads use the same bounded typography contract
        # as convenience builders before they cross into a painter backend.
        huge_label: Widget = Control.Label(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, text: "huge", size: 3.0e38, ink: grey(220))
        layout(huge_label, 100.0, 20.0)
        hostile_metrics <- true
        UiCore::begin_frame()
        paint(huge_label)
        hostile_metrics <- false
        found_text: mutable bool = false
        for command_index in 0..<UiCore::command_count():
            if command_text_size(command_index) >= 0.0:
                found_text <- true
                test_failures <- test_failures + 1 if command_text_size(command_index) > UiConstraints::MAX_EXTENT or command_text_size(command_index) != command_text_size(command_index)
                match UiCore::command_at(command_index):
                    UiCore::Command.DrawText(run, color):
                        if run.origin.y > UiConstraints::MAX_EXTENT or run.origin.y < -UiConstraints::MAX_EXTENT or run.origin.y != run.origin.y:
                            test_failures <- test_failures + 1
                            _ = puts("hostile text metric escaped geometry bound")
                    _:
                        pass
        test_failures <- test_failures + 1 if not found_text

        # Hit testing must use the same bounded projection as painting. A raw
        # constructor can otherwise make a button with a near-infinite frame
        # capture pointers far outside any useful surface, or turn NaN/Inf
        # pointer coordinates into an accidental origin hit.
        hostile_hit: Widget = Button.Push(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 3.0e38, height: 3.0e38, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "hostile", rest: grey(30), hover: grey(40), press: grey(20))
        if hit(hostile_hit, 20000000.0, 20000000.0) != null:
            test_failures <- test_failures + 1
            _ = puts("hostile hit geometry was not bounded")
        zero_hit: f32 = 0.0
        nan_hit: f32 = zero_hit / zero_hit
        inf_hit: f32 = 1.0 / zero_hit
        if hit(hostile_hit, nan_hit, 1.0) != null:
            test_failures <- test_failures + 1
            _ = puts("NaN hit coordinate did not fail closed")
        if hit(hostile_hit, inf_hit, 1.0) != null:
            test_failures <- test_failures + 1
            _ = puts("infinite hit coordinate did not fail closed")
        edge_hit: Widget = Button.Push(min_width: 0.0, min_height: 0.0, grow: 0.0, x: UiCore::MAX_GEOMETRY_EXTENT, y: UiCore::MAX_GEOMETRY_EXTENT, width: 4.0, height: 4.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "edge", rest: grey(30), hover: grey(40), press: grey(20))
        if hit(edge_hit, UiCore::MAX_GEOMETRY_EXTENT + 1.0, UiCore::MAX_GEOMETRY_EXTENT + 1.0) != null:
            test_failures <- test_failures + 1
            _ = puts("derived hit edge escaped geometry bound")

        # Packed handles do not expose identity comparison, so a caller can
        # still construct a malformed self-link by writing a common directly.
        # Every hierarchy traversal must terminate instead of recursing until
        # the process stack is exhausted.
        cyclic: Widget = Container.Box(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, axis: UiConst::Axis.Column, padding: 0.0, spacing: 0.0, fill: UiCore::Color{r: 0, g: 0, b: 0, a: 0})
        cyclic.first_child <- cyclic
        layout(cyclic, 40.0, 20.0)
        check("cyclic layout keeps the root box", cyclic.width, 40.0)
        _ = hit(cyclic, 1.0, 1.0)
        UiCore::begin_frame()
        paint(cyclic)
        test_failures <- test_failures + 1 if UiCore::command_count() != 0

        # The sibling budget covers a cycle that does not increase recursion
        # depth (the common failure mode for a linked-list walk).
        sibling_cycle: Widget = Button.Push(min_width: 20.0, min_height: 8.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "cycle", rest: grey(30), hover: grey(40), press: grey(20))
        sibling_parent: Widget = Container.Box(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: sibling_cycle, next_sibling: null, axis: UiConst::Axis.Row, padding: 0.0, spacing: 0.0, fill: grey(15))
        sibling_cycle.next_sibling <- sibling_cycle
        layout(sibling_parent, 80.0, 20.0)
        check("sibling cycle keeps the parent box", sibling_parent.width, 80.0)
        _ = hit(sibling_parent, 1.0, 1.0)

        # A public raw constructor can still write a child into a leaf's
        # mutable common link. The builder rejects that shape, and the typed
        # traversals must fail closed in the same way instead of laying out,
        # painting, or hit-testing an unreachable descendant.
        malformed_leaf_child: Widget = Button.Push(min_width: 10.0, min_height: 10.0, grow: 0.0, x: 4.0, y: 4.0, width: 10.0, height: 10.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "hidden", rest: grey(30), hover: grey(40), press: grey(20))
        malformed_leaf: Widget = Control.Label(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: malformed_leaf_child, next_sibling: null, text: "leaf", size: 12.0, ink: grey(200))
        layout(malformed_leaf, 40.0, 20.0)
        check("leaf layout ignores raw child", malformed_leaf_child.x, 4.0)
        if hit(malformed_leaf, 6.0, 6.0) != null:
            test_failures <- test_failures + 1
            _ = puts("leaf hit exposed raw child")
        UiCore::begin_frame()
        paint(malformed_leaf)
        if UiCore::command_count() != 1:
            test_failures <- test_failures + 1
            _ = puts("leaf paint exposed raw child")

        return test_failures.i64()
