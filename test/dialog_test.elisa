# Headless regression for modal dialog lifecycle and back-navigation policy.

include "../src/widgets/ui_dialog.elisa"

extern puts(text: cstr) -> i64
global mutable failures: i32 = 0

def check(name: cstr, ok: bool) -> void:
    return if ok
    failures <- failures + 1
    _ = puts(name)

def main() -> i64:
    UiDialog::reset()
    invalid_kind: UiDialog::Kind = (-1).i32().Kind()
    rejected_kind: UiDialog::Handle = UiDialog::open(invalid_kind, "Invalid", "", "OK", "", 1)
    check("invalid dialog kinds are rejected", not UiDialog::is_valid(rejected_kind) and UiDialog::snapshot().active == 0)
    first: UiDialog::Handle = UiDialog::open(UiDialog::Kind.Confirm, "Delete item", "This cannot be undone.", "Delete", "Keep", 10)
    check("dialog opens with a valid handle", UiDialog::is_valid(first) and UiDialog::is_open(first))
    check("dialog copies title and actions", UiDialog::title(first) == "Delete item" and UiDialog::message(first) == "This cannot be undone." and UiDialog::primary_label(first) == "Delete" and UiDialog::secondary_label(first) == "Keep")
    check("dialog reports owner and kind", UiDialog::owner(first) == 10 and UiDialog::kind(first) == UiDialog::Kind.Confirm)
    malformed_dialog_text: mutable u8[3] = zeroed
    malformed_dialog_text[0] <- 65
    malformed_dialog_text[1] <- 255
    malformed_dialog_text[2] <- 66
    malformed_dialog_view: sview = sview(&malformed_dialog_text[0], 0, 3)
    sanitized: UiDialog::Handle = UiDialog::open(UiDialog::Kind.Alert, malformed_dialog_view, malformed_dialog_view, "OK", "", 11)
    check("dialog storage rejects malformed UTF-8", UiDialog::title(sanitized) == "A" and UiDialog::message(sanitized) == "A")
    _ = UiDialog::dispose(sanitized)
    check("snapshot counts open dialog", UiDialog::snapshot().active == 1 and UiDialog::snapshot().closed == 0)
    semantic: UiDialog::Semantics = UiDialog::semantics(first, true)
    check("dialog projects a portable semantic role", semantic.role == UiCore::AccessibilityRole.Dialog and semantic.label == "Delete item" and semantic.help == "This cannot be undone." and semantic.identity == first.slot.usize() + 1 and semantic.focused and semantic.dismissible)
    UiCore::begin_frame()
    UiDialog::emit_accessibility(first, UiCore::Rect(4.0, 8.0, 240.0, 120.0), true, UiCore::MAX_ACCESSIBILITY_NODES, UiCore::MAX_ACCESSIBILITY_NODES, UiCore::MAX_ACCESSIBILITY_NODES)
    node: UiCore::AccessibilityNode = UiCore::accessibility_at(0)
    check("dialog emits copied labels into the semantic frame", UiCore::accessibility_count() == 1 and node.role == UiCore::AccessibilityRole.Dialog and node.label == "Delete item" and node.help == "This cannot be undone." and node.focused)

    # A title is optional, but a message-only dialog still needs an accessible
    # name so assistive navigation can discover and describe the modal.
    message_only: UiDialog::Handle = UiDialog::open(UiDialog::Kind.Alert, "", "Network unavailable", "OK", "", 30)
    message_semantic: UiDialog::Semantics = UiDialog::semantics(message_only, true)
    check("message-only dialog promotes its message to the semantic label", message_semantic.label == "Network unavailable" and message_semantic.help == "")
    UiCore::begin_frame()
    UiDialog::emit_accessibility(message_only, UiCore::Rect(4.0, 8.0, 240.0, 120.0), true, UiCore::MAX_ACCESSIBILITY_NODES, UiCore::MAX_ACCESSIBILITY_NODES, UiCore::MAX_ACCESSIBILITY_NODES)
    message_node: UiCore::AccessibilityNode = UiCore::accessibility_at(0)
    check("message-only dialog remains in the semantic frame", UiCore::accessibility_count() == 1 and message_node.role == UiCore::AccessibilityRole.Dialog and message_node.label == "Network unavailable" and message_node.help == "")
    _ = UiDialog::cancel(message_only)
    _ = UiDialog::dispose(message_only)

    second: UiDialog::Handle = UiDialog::open(UiDialog::Kind.Alert, "Offline", "Try again later.", "OK", "", 20)
    check("top returns newest dialog", UiDialog::top().slot == second.slot)
    check("back closes only the top dialog", UiDialog::back() and UiDialog::result(second) == UiDialog::Result.Back and not UiDialog::is_open(second) and UiDialog::is_open(first))
    check("top skips closed results", UiDialog::top().slot == first.slot)
    check("closed result remains readable", UiDialog::snapshot().active == 1 and UiDialog::snapshot().closed == 1)
    check("closed dialog rejects a second result", not UiDialog::cancel(second))
    invalid_result: UiDialog::Result = (-1).i32().Result()
    check("invalid dialog results are rejected", not UiDialog::choose(first, invalid_result) and UiDialog::is_open(first) and UiDialog::result(first) == UiDialog::Result.None)

    check("primary choice closes dialog", UiDialog::choose(first, UiDialog::Result.Primary) and UiDialog::result(first) == UiDialog::Result.Primary and not UiDialog::is_open(first))
    check("owner dismissal has no already-closed work", UiDialog::dismiss_owner(10) == 0)
    check("owner dismissal cancels open dialogs", UiDialog::dismiss_owner(20) == 0)
    check("disposing closed handles frees them", UiDialog::dispose(first) and UiDialog::dispose(second) and UiDialog::snapshot().active == 0 and UiDialog::snapshot().closed == 0)
    check("disposed handles are stale", not UiDialog::is_valid(first) and UiDialog::result(first) == UiDialog::Result.None)

    # Capacity exhaustion is explicit, never an alias to an existing modal.
    handles: UiDialog::Handle[UiDialog::MAX_DIALOGS] = zeroed
    for index in 0..<UiDialog::MAX_DIALOGS:
        handles[index] <- UiDialog::open(UiDialog::Kind.Sheet, "Sheet", "", "Close", "", index.u32())
    overflow: UiDialog::Handle = UiDialog::open(UiDialog::Kind.Alert, "Overflow", "", "OK", "", 99)
    check("dialog capacity reports overflow", not UiDialog::is_valid(overflow) and UiDialog::snapshot().overflowed and UiDialog::snapshot().active == UiDialog::MAX_DIALOGS)
    for index in 0..<UiDialog::MAX_DIALOGS:
        _ = UiDialog::cancel(handles[index])
        _ = UiDialog::dispose(handles[index])

    if failures == 0:
        _ = puts("dialog: all checks passed")
        return 0
    _ = puts("dialog: FAILURES above")
    return 1
