# Headless regression for the Elisa-owned frame-local text metric cache.

include "../src/widgets/ui_text_metrics.elisa"

extern puts(text: cstr) -> i64

global mutable failures: i32 = 0
global mutable backend_calls: usize = 0
global mutable width_calls: usize = 0

def ui_text_line_height(size: f32) -> f32:
    backend_calls <- backend_calls + 1
    return size * 1.25

def ui_measure_text_width(text: sview, size: f32) -> f32:
    width_calls <- width_calls + 1
    return text.len.f32() * size * 0.5

def check(name: cstr, ok: bool) -> void:
    return if ok
    failures <- failures + 1
    _ = puts(name)

def main() -> i64:
    UiTextMetrics::reset()
    check("initial metric context is stable", not UiTextMetrics::set_context(0, 0))
    first: f32 = UiTextMetrics::line_height(16.0)
    second: f32 = UiTextMetrics::line_height(16.0)
    check("line-height cache preserves the backend metric", first == 20.0 and second == 20.0)
    check("repeated size crosses FFI once", backend_calls == 1 and UiTextMetrics::query_count() == 2 and UiTextMetrics::miss_count() == 1)

    _ = UiTextMetrics::line_height(20.0)
    check("new size fills one cache entry", backend_calls == 2 and UiTextMetrics::miss_count() == 2)
    UiTextMetrics::reset()
    _ = UiTextMetrics::line_height(16.0)
    check("reset invalidates frame-local metrics", backend_calls == 3 and UiTextMetrics::miss_count() == 1)

    UiTextMetrics::reset()
    first_width: f32 = UiTextMetrics::width("cached", 10.0)
    second_width: f32 = UiTextMetrics::width("cached", 10.0)
    check("width cache preserves the backend metric", first_width == 30.0 and second_width == 30.0)
    check("repeated text crosses width FFI once", width_calls == 1 and UiTextMetrics::width_query_count() == 2 and UiTextMetrics::width_miss_count() == 1)
    _ = UiTextMetrics::width("cached", 12.0)
    check("width size participates in identity", width_calls == 2 and UiTextMetrics::width_miss_count() == 2)
    UiTextMetrics::reset()
    _ = UiTextMetrics::width("cached", 10.0)
    check("reset invalidates cached widths", width_calls == 3 and UiTextMetrics::width_miss_count() == 1)
    check("font and scale generations invalidate together", UiTextMetrics::set_context(1, 2) and UiTextMetrics::line_height(10.0) == 12.5 and backend_calls == 4)
    check("same metric context is idempotent", not UiTextMetrics::set_context(1, 2) and UiTextMetrics::line_height(10.0) == 12.5 and backend_calls == 4)
    context_snapshot: UiTextMetrics::Snapshot = UiTextMetrics::snapshot()
    check("metric snapshot reports context", context_snapshot.font_generation == 1 and context_snapshot.scale_generation == 2)
    check("metric snapshot reports counters", context_snapshot.line_height_queries == 2 and context_snapshot.line_height_misses == 1)

    large: mutable u8[UiTextMetrics::WIDTH_TEXT_CAPACITY + 1] = zeroed
    for index in 0..<UiTextMetrics::WIDTH_TEXT_CAPACITY + 1:
        large[index] <- 65
    large_view: sview = sview(&large[0], 0, (UiTextMetrics::WIDTH_TEXT_CAPACITY + 1).i64())
    misses_before_large: usize = UiTextMetrics::width_miss_count()
    _ = UiTextMetrics::width(large_view, 10.0)
    check("oversized text crosses backend", width_calls > 2)
    check("oversized text records a miss", UiTextMetrics::width_miss_count() == misses_before_large + 1)

    if failures == 0:
        _ = puts("text metrics cache: all checks passed")
        return 0
    _ = puts("text metrics cache: FAILURES above")
    return 1
