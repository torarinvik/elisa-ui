# Headless regression for direction, mirrored geometry, and plural policy.

include "../src/widgets/ui_localization.elisa"

extern puts(text: cstr) -> i64
global mutable failures: i32 = 0

def check(name: cstr, ok: bool) -> void:
    return if ok
    failures <- failures + 1
    _ = puts(name)

def main() -> i64:
    UiLocalization::reset()
    UiCore::clear_all_invalidations()
    check("locale starts empty", UiLocalization::current_locale().len == 0 and UiLocalization::revision() == 0)
    check("first locale is copied and canonicalized", UiLocalization::set_locale("EN_us") and UiLocalization::current_locale() == "en-us" and UiLocalization::revision() == 1)
    first_sequence: u32 = UiCore::invalidation_sequence()
    first_mask: i32 = UiCore::invalidations()
    check("locale change invalidates layout paint and semantics", first_mask == UiCore::Invalidation.Layout.i32() | UiCore::Invalidation.Paint.i32() | UiCore::Invalidation.Semantics.i32() and first_sequence > 0)
    check("same canonical locale is idempotent", not UiLocalization::set_locale("en-US") and UiLocalization::revision() == 1 and UiCore::invalidation_sequence() == first_sequence)
    null_locale: sview = sview(null, 0, 2)
    check("null-backed locale fails closed", UiLocalization::set_locale(null_locale) and UiLocalization::current_locale().len == 0)
    check("region changes are observable", UiLocalization::set_locale("en-GB") and UiLocalization::revision() == 3 and UiLocalization::current_locale() == "en-gb")
    check("active locale exposes direction", UiLocalization::set_locale("AR_sa") and UiLocalization::current_direction() == UiLocalization::Direction.RightToLeft and UiLocalization::snapshot().direction == UiLocalization::Direction.RightToLeft)
    check("long locale tags are bounded", UiLocalization::set_locale("abcdefghijklmnopqrstuvwxyz-ABCDEFGHIJKLMNOPQRSTUVWXYZ-0123456789") and UiLocalization::is_truncated() and UiLocalization::current_locale().len.usize() == UiLocalization::MAX_LOCALE_BYTES - 1)

    check("English defaults to left-to-right", UiLocalization::direction("en-US") == UiLocalization::Direction.LeftToRight and not UiLocalization::is_rtl("en-US"))
    check("Arabic selects right-to-left", UiLocalization::direction("ar-SA") == UiLocalization::Direction.RightToLeft and UiLocalization::is_rtl("AR"))
    check("Hebrew start maps to end", UiLocalization::start_alignment("he") == UiConst::CrossAlignment.End and UiLocalization::end_alignment("he") == UiConst::CrossAlignment.Start)
    check("LTR start maps to start", UiLocalization::start_alignment("en") == UiConst::CrossAlignment.Start and UiLocalization::end_alignment("en") == UiConst::CrossAlignment.End)

    check("RTL mirrors item origin", UiLocalization::mirror_x("ar", 300.0, 40.0, 80.0) == 180.0)
    check("LTR keeps item origin", UiLocalization::mirror_x("en", 300.0, 40.0, 80.0) == 40.0)
    check("mirrored origin clips malformed geometry", UiLocalization::mirror_x("ar", 100.0, 200.0, 20.0) == 0.0)
    huge: f32 = 3.0e38
    mirrored_huge: f32 = UiLocalization::mirror_x("ar", huge, -huge, huge)
    check("mirrored geometry stays inside the finite envelope", mirrored_huge == UiCore::MAX_GEOMETRY_EXTENT)

    check("English one/other", UiLocalization::plural("en", 1) == UiLocalization::PluralCategory.One and UiLocalization::plural("en", 2) == UiLocalization::PluralCategory.Other)
    check("French treats zero as one", UiLocalization::plural("fr", 0) == UiLocalization::PluralCategory.One)
    check("Arabic exposes zero/one/two/few/many", UiLocalization::plural("ar", 0) == UiLocalization::PluralCategory.Zero and UiLocalization::plural("ar", 1) == UiLocalization::PluralCategory.One and UiLocalization::plural("ar", 2) == UiLocalization::PluralCategory.Two and UiLocalization::plural("ar", 7) == UiLocalization::PluralCategory.Few and UiLocalization::plural("ar", 20) == UiLocalization::PluralCategory.Many)
    check("Russian handles one/few/many", UiLocalization::plural("ru", 21) == UiLocalization::PluralCategory.One and UiLocalization::plural("ru", 24) == UiLocalization::PluralCategory.Few and UiLocalization::plural("ru", 25) == UiLocalization::PluralCategory.Many)
    check("Polish keeps zero in other", UiLocalization::plural("pl", 0) == UiLocalization::PluralCategory.Other and UiLocalization::plural("pl", 3) == UiLocalization::PluralCategory.Few)
    check("negative counts fail closed", UiLocalization::plural("en", -1) == UiLocalization::PluralCategory.Other)

    check("three letter language is not a two letter prefix", not UiLocalization::is_rtl("arn") and not UiLocalization::is_rtl("fil"))
    before_reset: u32 = UiLocalization::revision()
    UiLocalization::reset()
    check("reset advances locale revision", UiLocalization::revision() > before_reset and UiLocalization::current_locale().len == 0)
    after_reset: u32 = UiLocalization::revision()
    UiCore::clear_all_invalidations()
    UiLocalization::reset()
    check("repeated locale reset is idle", UiLocalization::revision() == after_reset and UiCore::invalidations() == 0)

    if failures == 0:
        _ = puts("localization: all checks passed")
        return 0
    _ = puts("localization: FAILURES above")
    return 1
