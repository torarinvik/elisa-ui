# Bounded UAX #29 extended-grapheme conformance corpus.
#
# The rows are copied from the categories exercised by Unicode's
# GraphemeBreakTest data: combining marks, emoji ZWJ/modifier sequences,
# regional indicators, Indic linker context, Hangul joins, CRLF, and a short
# right-to-left sample. This is intentionally data-driven rather than another
# collection of one-off helper assertions. Full script shaping and bidi order
# remain the host font/shaper contract; these rows verify the framework's byte
# and caret boundaries before a host is involved.

include "../src/core/ui_core.elisa"

extern puts(text: cstr) -> i64

global mutable failures: i32 = 0

struct GraphemeCase:
    text: sview
    first: usize
    second: usize
    third: usize
    fourth: usize
    count: usize

const UNICODE_GRAPHEME_DATA_VERSION: sview = "15.1.0"

def check(name: cstr, ok: bool) -> void:
    return if ok
    failures <- failures + 1
    _ = puts(name)

def expected_boundary(case: GraphemeCase, index: usize) -> usize:
    return case.first if index == 0
    return case.second if index == 1
    return case.third if index == 2
    return case.fourth if index == 3
    return 0

def row_name(index: usize) -> cstr:
    return "Unicode row 00 combining" if index == 0
    return "Unicode row 01 emoji ZWJ" if index == 1
    return "Unicode row 02 regional pair" if index == 2
    return "Unicode row 03 emoji modifier" if index == 3
    return "Unicode row 04 Indic linker" if index == 4
    return "Unicode row 05 Hangul" if index == 5
    return "Unicode row 06 CRLF" if index == 6
    return "Unicode row 07 RTL" if index == 7
    return "Unicode row 08 Prepend" if index == 8
    return "Unicode row 09 Prepend Extend" if index == 9
    return "Unicode row 10 SpacingMark" if index == 10
    return "Unicode row 11 Hangul LV" if index == 11
    return "Unicode row 12 regional triple" if index == 12
    return "Unicode row 13 ZWJ non-EP" if index == 13
    return "Unicode row 14 control" if index == 14
    return "Unicode row 15 Prepend pair" if index == 15
    return "Unicode row 16 SpacingMark pair" if index == 16
    return "Unicode row 17 keycap" if index == 17
    return "Unicode row 18 variation selector" if index == 18
    return "Unicode row 19 emoji family" if index == 19
    return "Unicode row 20 Prepend then plain" if index == 20
    return "Unicode row 21 plain then Prepend" if index == 21
    return "Unicode row 22 Prepend then CR"

def row_termination_name(index: usize) -> cstr:
    return "Unicode row 00 termination" if index == 0
    return "Unicode row 01 termination" if index == 1
    return "Unicode row 02 termination" if index == 2
    return "Unicode row 03 termination" if index == 3
    return "Unicode row 04 termination" if index == 4
    return "Unicode row 05 termination" if index == 5
    return "Unicode row 06 termination" if index == 6
    return "Unicode row 07 termination" if index == 7
    return "Unicode row 08 termination" if index == 8
    return "Unicode row 09 termination" if index == 9
    return "Unicode row 10 termination" if index == 10
    return "Unicode row 11 termination" if index == 11
    return "Unicode row 12 termination" if index == 12
    return "Unicode row 13 termination" if index == 13
    return "Unicode row 14 termination" if index == 14
    return "Unicode row 15 termination" if index == 15
    return "Unicode row 16 termination" if index == 16
    return "Unicode row 17 termination" if index == 17
    return "Unicode row 18 termination" if index == 18
    return "Unicode row 19 termination" if index == 19
    return "Unicode row 20 termination" if index == 20
    return "Unicode row 21 termination" if index == 21
    return "Unicode row 22 termination"

def check_case(case: GraphemeCase, row: usize) -> void:
    position: mutable usize = 0
    for index in 0..<case.count:
        next: usize = UiText::next_grapheme(case.text, position)
        check(row_name(row), next == expected_boundary(case, index) and next > position)
        position <- next
    check(row_termination_name(row), position == case.text.len.usize())

def main() -> i64:
    # Expected offsets are UTF-8 byte positions, the unit used by the editor's
    # internal caret storage. Each row is a complete boundary sequence. The
    # corpus mirrors the rule families in Unicode's GraphemeBreakTest.txt;
    # keeping the data versioned makes a property-table refresh auditable.
    cases: GraphemeCase[23] = zeroed
    cases[0] <- GraphemeCase{text: "a̐éö̲", first: 3, second: 6, third: 11, fourth: 0, count: 3}
    cases[1] <- GraphemeCase{text: "👩‍💻", first: 11, second: 0, third: 0, fourth: 0, count: 1}
    cases[2] <- GraphemeCase{text: "🇺🇸", first: 8, second: 0, third: 0, fourth: 0, count: 1}
    cases[3] <- GraphemeCase{text: "👍🏽", first: 8, second: 0, third: 0, fourth: 0, count: 1}
    cases[4] <- GraphemeCase{text: "क्‍ष", first: 12, second: 0, third: 0, fourth: 0, count: 1}
    cases[5] <- GraphemeCase{text: "각", first: 9, second: 0, third: 0, fourth: 0, count: 1}
    cases[6] <- GraphemeCase{text: "A\r\nB", first: 1, second: 3, third: 4, fourth: 0, count: 3}
    cases[7] <- GraphemeCase{text: "אA", first: 2, second: 3, third: 0, fourth: 0, count: 2}
    cases[8] <- GraphemeCase{text: "؀A", first: 3, second: 0, third: 0, fourth: 0, count: 1}
    cases[9] <- GraphemeCase{text: "؀́A", first: 4, second: 5, third: 0, fourth: 0, count: 2}
    cases[10] <- GraphemeCase{text: "का", first: 6, second: 0, third: 0, fourth: 0, count: 1}
    cases[11] <- GraphemeCase{text: "가", first: 6, second: 0, third: 0, fourth: 0, count: 1}
    cases[12] <- GraphemeCase{text: "🇺🇸🇨", first: 8, second: 12, third: 0, fourth: 0, count: 2}
    cases[13] <- GraphemeCase{text: "👩‍A", first: 7, second: 8, third: 0, fourth: 0, count: 2}
    cases[14] <- GraphemeCase{text: "A\u0000B", first: 1, second: 2, third: 3, fourth: 0, count: 3}
    cases[15] <- GraphemeCase{text: "؀؁A", first: 5, second: 0, third: 0, fourth: 0, count: 1}
    cases[16] <- GraphemeCase{text: "काि", first: 9, second: 0, third: 0, fourth: 0, count: 1}
    cases[17] <- GraphemeCase{text: "1️⃣", first: 7, second: 0, third: 0, fourth: 0, count: 1}
    cases[18] <- GraphemeCase{text: "✈️", first: 6, second: 0, third: 0, fourth: 0, count: 1}
    cases[19] <- GraphemeCase{text: "👨‍👩‍👧‍👦", first: 25, second: 0, third: 0, fourth: 0, count: 1}
    cases[20] <- GraphemeCase{text: "؀AB", first: 3, second: 4, third: 0, fourth: 0, count: 2}
    cases[21] <- GraphemeCase{text: "A؀B", first: 1, second: 4, third: 0, fourth: 0, count: 2}
    cases[22] <- GraphemeCase{text: "؀\r", first: 2, second: 3, third: 0, fourth: 0, count: 2}
    for index in 0..<23:
        check_case(cases[index], index)

    malformed: mutable u8[4] = zeroed
    malformed[0] <- 0xE2
    malformed[1] <- 65
    malformed[2] <- 0
    check("Unicode malformed input recovers one byte at a time", UiText::next_grapheme(sview(&malformed[0], 0, 3), 0) == 1 and UiText::next_grapheme(sview(&malformed[0], 0, 3), 1) == 2)
    if failures == 0:
        _ = puts("unicode conformance UAX #29 15.1.0: all rows passed")
        return 0
    _ = puts("unicode conformance: FAILURES above")
    return 1
