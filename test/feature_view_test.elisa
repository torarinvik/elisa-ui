# Headless regression for the optional feature-view lifecycle contract.

include "../src/widgets/ui_feature_view.elisa"

extern puts(text: cstr) -> i64
global mutable failures: i32 = 0

def check(name: cstr, ok: bool) -> void:
    return if ok
    failures <- failures + 1
    _ = puts(name)

def main() -> i64:
    UiFeatureView::reset()
    UiCore::clear_all_invalidations()
    check("feature reset is empty", UiFeatureView::snapshot().total == 0 and not UiFeatureView::overflowed())

    requested: mutable UiFeatureView::FeatureHandle = UiFeatureView::request(7, 1, "2.0.0", 42)
    check("feature request stores identity", UiFeatureView::is_valid(requested) and UiFeatureView::feature_id(requested) == 7 and UiFeatureView::interface_version(requested) == 1 and UiFeatureView::package_version(requested) == "2.0.0" and UiFeatureView::owner(requested) == 42)
    check("feature starts requested", UiFeatureView::state(requested) == UiFeatureView::FeatureState.Requested and UiFeatureView::activation_id(requested) == 0)
    requested_view: UiFeatureView::View = UiFeatureView::view(requested)
    check("feature view exposes a cancellable loading action", requested_view.state == UiFeatureView::FeatureState.Requested and requested_view.action == UiFeatureView::ViewAction.Cancel)
    check("feature back cancels before activation", UiFeatureView::back(requested) and UiFeatureView::state(requested) == UiFeatureView::FeatureState.Cancelled)
    requested <- UiFeatureView::request(7, 1, "2.0.0", 42)
    duplicate: UiFeatureView::FeatureHandle = UiFeatureView::request(7, 1, "2.0.0", 99)
    check("same feature request is idempotent", duplicate.slot == requested.slot and duplicate.generation == requested.generation and UiFeatureView::owner(duplicate) == 99)
    check("invalid package is rejected", not UiFeatureView::is_valid(UiFeatureView::request(7, 1, "", 42)))

    check("activation requires a token", not UiFeatureView::activate(requested, 0) and UiFeatureView::activate(requested, 123))
    check("activation enters loading", UiFeatureView::state(requested) == UiFeatureView::FeatureState.Loading and UiFeatureView::activation_id(requested) == 123)
    check("stale activation result is rejected", not UiFeatureView::resolve(requested, 122, UiFeatureView::FeatureState.Ready, UiFeatureView::FeatureFailureKind.Unknown))
    check("repeated loading result is rejected", not UiFeatureView::resolve(requested, 123, UiFeatureView::FeatureState.Loading, UiFeatureView::FeatureFailureKind.Unknown) and UiFeatureView::state(requested) == UiFeatureView::FeatureState.Loading)
    check("ready result rejects contradictory failure", not UiFeatureView::resolve(requested, 123, UiFeatureView::FeatureState.Ready, UiFeatureView::FeatureFailureKind.Retryable) and UiFeatureView::state(requested) == UiFeatureView::FeatureState.Loading)
    check("feature reaches ready", UiFeatureView::resolve(requested, 123, UiFeatureView::FeatureState.Ready, UiFeatureView::FeatureFailureKind.Unknown) and UiFeatureView::is_ready(requested))
    check("ready feature cannot be retried", not UiFeatureView::is_valid(UiFeatureView::retry(requested)))

    offline: UiFeatureView::FeatureHandle = UiFeatureView::request(8, 2, "1.4.0", 77)
    _ = UiFeatureView::activate(offline, 456)
    check("offline result is visible", UiFeatureView::resolve(offline, 456, UiFeatureView::FeatureState.UnavailableOffline, UiFeatureView::FeatureFailureKind.Offline) and UiFeatureView::can_retry(offline))
    denied: UiFeatureView::FeatureHandle = UiFeatureView::request(10, 2, "1.0.0", 77)
    _ = UiFeatureView::activate(denied, 654)
    check("denied result rejects mismatched failure", not UiFeatureView::resolve(denied, 654, UiFeatureView::FeatureState.Denied, UiFeatureView::FeatureFailureKind.Offline) and UiFeatureView::state(denied) == UiFeatureView::FeatureState.Loading)
    check("denied result records matching failure", UiFeatureView::resolve(denied, 654, UiFeatureView::FeatureState.Denied, UiFeatureView::FeatureFailureKind.Denied) and UiFeatureView::failure(denied) == UiFeatureView::FeatureFailureKind.Denied)
    offline_view: UiFeatureView::View = UiFeatureView::view(offline)
    check("offline feature view exposes retry", offline_view.state == UiFeatureView::FeatureState.UnavailableOffline and offline_view.action == UiFeatureView::ViewAction.Retry)
    check("back forwards from terminal feature state", not UiFeatureView::back(offline))
    retried: UiFeatureView::FeatureHandle = UiFeatureView::retry(offline)
    check("retry rotates generation", UiFeatureView::is_valid(retried) and retried.generation != offline.generation and UiFeatureView::state(retried) == UiFeatureView::FeatureState.Requested and not UiFeatureView::is_valid(offline))
    _ = UiFeatureView::activate(retried, 789)
    check("failed feature records typed failure", UiFeatureView::resolve(retried, 789, UiFeatureView::FeatureState.Failed, UiFeatureView::FeatureFailureKind.Retryable) and UiFeatureView::failure(retried) == UiFeatureView::FeatureFailureKind.Retryable)
    cancellable: UiFeatureView::FeatureHandle = UiFeatureView::request(9, 1, "1.0.0", 77)
    _ = UiFeatureView::activate(cancellable, 987)
    check("cancel preserves host token for deactivation", UiFeatureView::cancel(cancellable) and UiFeatureView::state(cancellable) == UiFeatureView::FeatureState.Cancelled and UiFeatureView::activation_id(cancellable) == 987)

    _ = UiFeatureView::dispose_owner(77)
    counts: UiFeatureView::FeatureSnapshot = UiFeatureView::snapshot()
    check("owner disposal removes all owned views", counts.total == 1 and counts.ready == 1)
    check("feature changes invalidate presentation", UiCore::is_invalidated(UiCore::Invalidation.Paint) and UiCore::is_invalidated(UiCore::Invalidation.Semantics))

    if failures == 0:
        _ = puts("feature view: all checks passed")
        return 0
    _ = puts("feature view: FAILURES above")
    return 1
