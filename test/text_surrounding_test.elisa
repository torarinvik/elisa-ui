include "./widget_layout_support.elisa"

def main() -> i64:
    UiFlat::reset()
    field: usize = UiFlat::text_field(UiFlat::NONE, "Name", "", "ABmiddleYZ", 200.0, 40.0, 16.0, UiCore::rgb(255, 255, 255), UiCore::rgb(0, 0, 0))
    _ = UiFlat::request_focus(field)
    UiFlat::set_selection(field, 8, 2)
    UiFlat::delete_surrounding_utf16(1, 1)
    check("surrounding deletion protects reversed selection", UiFlat::text_value(field) == "AmiddleZ" and UiFlat::widget(field).selection_anchor == 7 and UiFlat::widget(field).caret == 1)
    check("surrounding deletion is undoable", UiFlat::undo_text() and UiFlat::text_value(field) == "ABmiddleYZ")
    UiFlat::replace_text(field, "A😀éZ")
    UiFlat::set_selection_utf16(field, 3, 0)
    UiFlat::delete_surrounding_utf16(1, 1)
    check("surrounding deletion removes whole graphemes", UiFlat::text_value(field) == "AZ" and UiFlat::widget(field).caret == 1)
    UiFlat::replace_text(field, "ABniYZ")
    UiFlat::set_marked(field, 2, 4)
    UiFlat::set_selection(field, 3, 3)
    UiFlat::delete_surrounding_utf16(1, 1)
    check("surrounding deletion preserves composing run", UiFlat::text_value(field) == "AniZ" and UiFlat::marked_utf16_location(field) == 1 and UiFlat::marked_utf16_length(field) == 2 and UiFlat::widget(field).caret == 2)
    UiFlat::delete_surrounding_utf16(2147483647, 2147483647)
    check("large surrounding lengths clamp around composition", UiFlat::text_value(field) == "ni" and UiFlat::marked_utf16_length(field) == 2)
    revision: u64 = UiFlat::widget(field).text_revision
    UiFlat::delete_surrounding_utf16(0, 0)
    check("empty deletion preserves revision", UiFlat::widget(field).text_revision == revision)
    UiFlat::clear_focus()
    UiFlat::delete_surrounding_utf16(1, 1)
    check("missing editor cannot delete", UiFlat::text_value(field) == "ni")
    _ = UiFlat::request_focus(field)
    UiFlat::replace_text(field, "ABYZ")
    UiFlat::set_selection(field, 2, 2)
    UiFlat::update_marked_text("ni", 1, 0, 0, 0, false)
    UiFlat::delete_surrounding_utf16(1, 1)
    UiFlat::unmark_text()
    check("surrounding edits join active composition undo", UiFlat::text_value(field) == "AniZ" and UiFlat::undo_text() and UiFlat::text_value(field) == "ABYZ")
    UiFlat::set_secure(field, true)
    UiFlat::set_selection(field, 2, 2)
    UiFlat::delete_surrounding_utf16(1, 1)
    check("secure surrounding deletion stays undo-ineligible", UiFlat::text_value(field) == "AZ" and not UiFlat::can_undo_text())
    UiFlat::set_secure(field, false)
    UiFlat::replace_text(field, "AB😀Z")
    UiFlat::set_selection_utf16(field, 4, 0)
    UiFlat::delete_surrounding_codepoints(2, 0)
    check("scalar count differs from UTF-16 count", UiFlat::text_value(field) == "AZ" and UiFlat::widget(field).caret == 1)
    UiFlat::replace_text(field, "A😀BZ")
    UiFlat::set_selection(field, 1, 1)
    UiFlat::delete_surrounding_codepoints(0, 2)
    check("forward scalar deletion counts supplementary characters once", UiFlat::text_value(field) == "AZ")
    UiFlat::replace_text(field, "A👩‍👩‍👧‍👦Z")
    UiFlat::set_selection_utf16(field, 12, 0)
    UiFlat::delete_surrounding_codepoints(1, 0)
    check("partial ZWJ scalar deletion expands to whole grapheme", UiFlat::text_value(field) == "AZ")
    UiFlat::set_selection(field, 1, 1)
    UiFlat::delete_surrounding_codepoints(2147483647, 2147483647)
    check("extreme scalar counts clamp with bounded traversal", UiFlat::text_value(field) == "")
    if test_failures == 0:
        _ = puts("text surrounding deletion: all checks passed")
        return 0
    return 1
