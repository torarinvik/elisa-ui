# Lifecycle regressions for the SDL3 host loop. Applications may stop during
# initialization or while producing a frame; neither path should present more
# native work after the lifecycle has become unavailable.

include "../src/platform/sdl3/ui_sdl3.elisa"

extern SDL_setenv_unsafe(name: cstr, value: cstr, overwrite: i32) -> i32
extern SDL_PushEvent(event: void&) -> bool
extern puts(text: cstr) -> i64

global mutable stop_in_init: bool = true
global mutable stop_in_frame: bool = false
global mutable stop_on_event: bool = false
global mutable frame_calls: i32 = 0
global mutable event_calls: i32 = 0
global mutable init_commands: usize = 0
global mutable init_semantics: usize = 0
global mutable init_frame_delay: f32 = -1.0
global mutable failures: i32 = 0

def push_key() -> void:
    event: mutable u64[16] = zeroed
    fields: mutable u32& = (&event[0]).cast[mutable u32&] can Unsafe.PointerCast
    fields[0] <- 0x300
    fields[7] <- 97
    pointer: void& = (&event[0]).cast[void&] can Unsafe.PointerCast
    if not SDL_PushEvent(pointer):
        failures <- failures + 1

def app_init() -> void:
    init_commands <- UiCore::command_count()
    init_semantics <- UiCore::accessibility_count()
    init_frame_delay <- UiCore::frame_delay()
    UiLifecycle::stop() if stop_in_init
    if stop_on_event:
        push_key()
        push_key()

def app_frame() -> void:
    frame_calls <- frame_calls + 1
    UiLifecycle::stop() if stop_in_frame

def app_event(event: UiCore::Event) -> void:
    match event:
        UiCore::KeyEvent.Down(code):
            event_calls <- event_calls + 1
            UiLifecycle::stop() if stop_on_event and event_calls == 1
        _:
            pass

def app_text_input(text: sview) -> void:
    pass

def app_text_editing(text: sview, start: i32, length: i32) -> void:
    pass

def check(name: cstr, ok: bool) -> void:
    return if ok
    failures <- failures + 1
    _ = puts(name)

def main() -> i64:
    _ = SDL_setenv_unsafe("SDL_VIDEODRIVER", "dummy", 1)

    first: i64 = UiSdl3::run("startup stop", 64, 64, 1)
    check("startup stop returns cleanly", first == 0)
    check("startup stop skips the first frame", frame_calls == 0)

    # Seed a retired batch before the next run. The replacement app_init must
    # see a blank Core frame, before its first frame callback can clear it.
    UiCore::clear(UiCore::rgb(4, 8, 12))
    UiCore::accessibility(UiCore::AccessibilityRole.Label, "retired", "", UiCore::Rect(0.0, 0.0, 10.0, 10.0), 3, 0, true, false, false, 0.0, "", "", 0, 0, 0)
    UiCore::request_frame_after(0.5)
    stop_in_init <- false
    stop_in_frame <- true
    frame_calls <- 0
    second: i64 = UiSdl3::run("frame stop", 64, 64, 1)
    check("frame stop returns cleanly", second == 0)
    check("SDL restart discards retired commands before app_init", init_commands == 0)
    check("SDL restart discards retired semantics before app_init", init_semantics == 0)
    check("SDL restart clears retired frame scheduling before app_init", init_frame_delay == 0.0)
    check("frame stop runs one application frame", frame_calls == 1)
    check("frame stop leaves lifecycle stopped", UiLifecycle::phase() == UiLifecycle::Phase.Stopped)

    stop_in_frame <- false
    stop_on_event <- true
    frame_calls <- 0
    event_calls <- 0
    third: i64 = UiSdl3::run("event stop", 64, 64, 1)
    check("event stop returns cleanly", third == 0)
    check("event stop delivers only the current event", event_calls == 1)
    check("event stop skips the following frame", frame_calls == 0)
    check("event stop leaves lifecycle stopped", UiLifecycle::phase() == UiLifecycle::Phase.Stopped)

    if failures == 0:
        _ = puts("SDL lifecycle stop: passed")
    return failures.i64()
