# The UIKit native-controls realization, asserted without a device.
#
# Which UIKit control each widget kind becomes, where it is attached, what text
# and state it carries, and the order handles are released in are all Elisa's
# decisions. They run here against C stand-ins for the shim, so the mapping is
# pinned rather than discovered on a device.

include "../src/platform/uikit/ui_uikit_controls.elisa"

using UiWidgets

extern puts(text: cstr) -> i64
extern elisa_uikit_controls_stub_reset() -> void
extern elisa_uikit_controls_stub_count() -> i32
extern elisa_uikit_controls_stub_released_count() -> i32
extern elisa_uikit_controls_stub_kind(slot: i32) -> i32
extern elisa_uikit_controls_stub_selectable(slot: i32) -> i32
extern elisa_uikit_controls_stub_parent(slot: i32) -> usize
extern elisa_uikit_controls_stub_handle(slot: i32) -> usize
extern elisa_uikit_controls_stub_width(slot: i32) -> f32
extern elisa_uikit_controls_stub_height(slot: i32) -> f32
extern elisa_uikit_controls_stub_has_title(slot: i32) -> i32
extern elisa_uikit_controls_stub_has_label_text(slot: i32) -> i32
extern elisa_uikit_controls_stub_has_field_text(slot: i32) -> i32
extern elisa_uikit_controls_stub_has_accessibility_label(slot: i32) -> i32
extern elisa_uikit_controls_stub_selected(slot: i32) -> i32
extern elisa_uikit_controls_stub_progress(slot: i32) -> f32
extern elisa_uikit_controls_stub_content_width(slot: i32) -> f32
extern elisa_uikit_controls_stub_released(order: i32) -> usize
extern elisa_uikit_controls_stub_action(slot: i32) -> i32

global mutable failures: i32 = 0

# The stub's control tokens.
const STUB_VIEW: i32 = 1
const STUB_SCROLL: i32 = 2
const STUB_LABEL: i32 = 3
const STUB_BUTTON: i32 = 4
const STUB_FIELD: i32 = 5
const STUB_SLIDER: i32 = 6
const STUB_PROGRESS: i32 = 7

def check(name: cstr, ok: bool) -> void:
    return if ok
    failures <- failures + 1
    _ = puts(name)

def app_widget_event(widget: UiWidgets::Widget, event: i32) -> void:
    pass

global mutable control_events: i32 = 0
global mutable last_control_index: i32 = -1
global mutable last_control_event: i32 = -1

def app_control_event(index: i32, event: i32) -> void:
    control_events <- control_events + 1
    last_control_index <- index
    last_control_event <- event

# UIKit measures its own controls, so layout only needs something consistent.
def ui_measure_text_width(text: sview, size: f32) -> f32:
    return text.len.f32() * size * 0.55
def ui_measure_text_height(text: sview, size: f32) -> f32:
    return size
def ui_font_ascent(size: f32) -> f32:
    return size
def ui_text_line_height(size: f32) -> f32:
    return size * 1.3

def grey(v: u8) -> UiCore::Color:
    return UiCore::Color{r: v, g: v, b: v, a: 255}

# One window holding every kind the protocol names, so the whole mapping is
# covered by a single realization.
def build() -> Widget:
    can Memory.Allocate, Abort.Panic:
        push: Widget = Button.Push(min_width: 90.0, min_height: 44.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "Open", rest: grey(60), hover: grey(90), press: grey(30))
        checked: Widget = Button.Check(min_width: 120.0, min_height: 44.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "Wrap lines", checked: true, rest: grey(60), hover: grey(90), press: grey(30))
        push.next_sibling <- checked

        toolbar: Widget = Container.Box(min_width: 0.0, min_height: 60.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: push, next_sibling: null, axis: UiConst::Axis.Row, padding: 8.0, spacing: 8.0, fill: grey(30))

        field: Widget = Control.TextBox(min_width: 0.0, min_height: 44.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, text: "Ada", caret: 0, size: 15.0, ink: grey(230), fill: grey(45))
        gauge: Widget = Control.Gauge(min_width: 0.0, min_height: 20.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, fraction: 0.25, track: grey(50), bar: grey(120))
        status: Widget = Control.Label(min_width: 0.0, min_height: 20.0, grow: 1.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, text: "Ready", size: 15.0, ink: grey(210))
        field.next_sibling <- gauge
        gauge.next_sibling <- status

        body: Widget = Container.Box(min_width: 0.0, min_height: 0.0, grow: 1.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: field, next_sibling: null, axis: UiConst::Axis.Column, padding: 16.0, spacing: 12.0, fill: grey(38))
        toolbar.next_sibling <- body

        return Window.Top(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: toolbar, next_sibling: null, title: "elisa-ui on UIKit", resizable: true)

def app_controls_realize() -> void:
    pass

def realize_tree() -> void can[Memory.Allocate, Abort.Panic, Ui.Controls, Unsafe.PointerCast]:
    root: Widget = build()
    layout(root, 393.0, 852.0)
    UiUIKitControls::realize(root)

def check_capability_profile() -> void:
    UiUIKitControls::start()
    profile: UiCapabilities::Snapshot = UiCapabilities::snapshot()
    check("the controls backend selects itself", profile.backend == UiCapabilities::Backend.UiKitControls)
    # UIKit owns every pixel here, so the framework must not claim custom paint
    # or an off-screen frame it cannot produce.
    check("the controls backend paints nothing", profile.native_controls and not profile.custom_paint and not profile.offscreen)
    check("the controls backend still has text input and semantics", profile.text_input and profile.composition and profile.semantics)

def check_mapping() -> void:
    check("every widget became a control", elisa_uikit_controls_stub_count() == 8)
    # The list is emitted parent-first, so a window is slot zero.
    check("a window becomes a plain view", elisa_uikit_controls_stub_kind(0) == STUB_VIEW)
    check("a container becomes a plain view", elisa_uikit_controls_stub_kind(1) == STUB_VIEW)
    check("a push button becomes a button", elisa_uikit_controls_stub_kind(2) == STUB_BUTTON)
    check("a check box becomes a button too", elisa_uikit_controls_stub_kind(3) == STUB_BUTTON)
    # A UISwitch carries no caption. A selectable button keeps the widget's
    # text visible, which is why a labelled boolean is not a switch here.
    check("a push button is not selectable", elisa_uikit_controls_stub_selectable(2) == 0)
    check("a check box is selectable", elisa_uikit_controls_stub_selectable(3) == 1)
    check("a text box becomes a text field", elisa_uikit_controls_stub_kind(5) == STUB_FIELD)
    check("a gauge becomes a progress view", elisa_uikit_controls_stub_kind(6) == STUB_PROGRESS)
    check("a label becomes a label", elisa_uikit_controls_stub_kind(7) == STUB_LABEL)

def check_hierarchy_and_geometry() -> void:
    # Attaching the realized root to the scene's view is the one step the
    # hierarchy walk cannot do, because that view belongs to UIKit.
    check("the root is attached to the scene view", elisa_uikit_controls_stub_parent(0) == UiUIKitControls::scene_root())
    check("the toolbar is attached to the window", elisa_uikit_controls_stub_parent(1) == elisa_uikit_controls_stub_handle(0))
    check("a button is attached to its toolbar", elisa_uikit_controls_stub_parent(2) == elisa_uikit_controls_stub_handle(1))
    # Without a scene geometry there is no safe area to move the root into, so
    # the laid-out frame stands rather than being overridden with zero.
    check("the window keeps its laid-out width when the scene is unknown", elisa_uikit_controls_stub_width(0) == 393.0)
    check("a control is placed too", elisa_uikit_controls_stub_width(2) > 0.0)
    # A plain view is not a scroll view, so it is never given content size.
    check("a plain view gets no content size", elisa_uikit_controls_stub_content_width(1) < 0.0)

def check_text_and_state() -> void:
    check("a button gets a title", elisa_uikit_controls_stub_has_title(2) == 1)
    check("a label gets label text", elisa_uikit_controls_stub_has_label_text(7) == 1)
    check("a text field gets field text", elisa_uikit_controls_stub_has_field_text(5) == 1)
    # A button's caption is its title, not an accessibility override.
    check("a button gets no accessibility override", elisa_uikit_controls_stub_has_accessibility_label(2) == 0)
    # A window has no title bar on iOS and a gauge has no caption, so their
    # text becomes what VoiceOver reads instead of being dropped.
    check("a window's title is spoken", elisa_uikit_controls_stub_has_accessibility_label(0) == 1)
    check("a checked box is selected", elisa_uikit_controls_stub_selected(3) == 1)
    check("a push button is never selected", elisa_uikit_controls_stub_selected(2) == -1)
    # UIProgressView has no range, so Elisa normalizes before the boundary.
    check("a gauge is normalized to a fraction", elisa_uikit_controls_stub_progress(6) == 0.25)

# Which controls report, what they report, and what the application sees.
def check_actions() -> void:
    # A panel and a label have nothing to report, so no action is installed on
    # them at all -- asking a toolkit to would be ignored at best.
    check("a view gets no action", elisa_uikit_controls_stub_action(1) == -1)
    check("a label gets no action", elisa_uikit_controls_stub_action(7) == -1)
    check("a button gets a primary action", elisa_uikit_controls_stub_action(2) == 0)
    check("a check box gets a primary action", elisa_uikit_controls_stub_action(3) == 0)
    # A slider drags and a field types: both report each step, not only a
    # final commit.
    check("a text field reports value changes", elisa_uikit_controls_stub_action(5) == 1)

    control_events <- 0
    button: usize = elisa_uikit_controls_stub_handle(2)
    check("a button action reaches the application",
        UiUIKitControls::controls_action(button, 0.0, false) == 2 and control_events == 1)
    check("a button reports a click", last_control_event == UiConst::WidgetEvent.Click.i32() and last_control_index == 2)
    # A handle belonging to no live control is what a late callback from a
    # torn-down tree looks like; it must not reach the application.
    check("an unknown handle reports nothing",
        UiUIKitControls::controls_action(999999, 0.0, false) == UiControls::NO_PARENT and control_events == 1)
    # Acting on a control records the new state before the callback runs, so a
    # callback that reads the control observes what the user just did.
    check("a check box records its new selection",
        UiUIKitControls::controls_action(elisa_uikit_controls_stub_handle(3), 0.0, true) == 3
        and UiControls::state_at(3).selected)
    check("unchecking records too",
        UiUIKitControls::controls_action(elisa_uikit_controls_stub_handle(3), 0.0, false) == 3
        and not UiControls::state_at(3).selected)
    field: usize = elisa_uikit_controls_stub_handle(5)
    check("a text field reports a change",
        UiUIKitControls::controls_action(field, 0.0, false) == 5 and last_control_event == UiConst::WidgetEvent.Change.i32())

def check_rerealization() -> void can[Memory.Allocate, Abort.Panic, Ui.Controls, Unsafe.PointerCast]:
    first_root: usize = elisa_uikit_controls_stub_handle(0)
    last: usize = elisa_uikit_controls_stub_handle(elisa_uikit_controls_stub_count() - 1)
    realize_tree()
    check("the previous tree was released", elisa_uikit_controls_stub_released_count() == 8)
    # Parents are emitted before children, so they are released in reverse: a
    # parent's deallocation must not invalidate a child handle Elisa still has
    # to release.
    check("children are released before their parents",
        elisa_uikit_controls_stub_released(0) == last and elisa_uikit_controls_stub_released(7) == first_root)

# Once the scene reports its geometry, the tree is laid out against the usable
# part of it and the root is moved to where the safe area starts -- so a
# toolbar does not end up under the clock.
def check_scene_geometry() -> void can[Memory.Allocate, Abort.Panic, Ui.Controls, Unsafe.PointerCast]:
    check("a real scene geometry is accepted", UiUIKitControls::set_scene_geometry(402.0, 874.0, 62.0, 0.0, 34.0, 0.0))
    check("the scene geometry is known", UiUIKitControls::scene_geometry_is_known())
    check("the content excludes the notch and the home indicator",
        UiUIKitControls::content_width() == 402.0 and UiUIKitControls::content_height() == 778.0)
    check("the content starts below the notch",
        UiUIKitControls::content_origin_y() == 62.0 and UiUIKitControls::content_origin_x() == 0.0)
    elisa_uikit_controls_stub_reset()
    realize_tree()
    check("the root is placed inside the safe area",
        elisa_uikit_controls_stub_width(0) == 402.0 and elisa_uikit_controls_stub_height(0) == 778.0)

def main() -> i64 can[Memory.Allocate, Abort.Panic, Ui.Controls, Unsafe.PointerCast]:
    check_capability_profile()
    check("a scene root is required", not UiUIKitControls::set_scene_root(0))
    check("a scene root is accepted", UiUIKitControls::set_scene_root(4242))
    check("a malformed scene geometry is rejected", not UiUIKitControls::set_scene_geometry(0.0, 874.0, 0.0, 0.0, 0.0, 0.0))
    check("a negative safe area is rejected", not UiUIKitControls::set_scene_geometry(402.0, 874.0, -1.0, 0.0, 0.0, 0.0))
    check("no geometry means no safe area to place into", not UiUIKitControls::scene_geometry_is_known())
    elisa_uikit_controls_stub_reset()
    realize_tree()
    check_mapping()
    check_hierarchy_and_geometry()
    check_text_and_state()
    check_actions()
    check_rerealization()
    check_scene_geometry()
    if failures == 0:
        _ = puts("uikit controls: all checks passed")
        return 0
    _ = puts("uikit controls: FAILURES above")
    return 1
