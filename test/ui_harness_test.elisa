# Headless regression for deterministic clock/event injection. The harness
# drives the ordinary app contract and the app records what it received.

include "../src/test/ui_harness.elisa"

extern puts(text: cstr) -> i64

global mutable failures: i32 = 0
global mutable init_calls: i32 = 0
global mutable event_calls: i32 = 0
global mutable frame_calls: i32 = 0
global mutable last_event_kind: i32 = -1
global mutable observed_time: f64 = -1.0
global mutable stop_during_dispatch: bool = false
global mutable nested_dispatch_on_event: bool = false
global mutable nested_dispatch_sent: bool = false

# UiHarness itself is backend-neutral, but it deliberately exercises the same
# retained widget stack that production apps use. Supply deterministic metric,
# clipboard, and callback hooks so this test remains a complete standalone
# application rather than depending on another fixture's declarations.
def ui_measure_text_width(text: sview, size: f32, weighted: bool) -> f32:
    _ = weighted
    return text.len.f32() * size * 0.5

def ui_measure_text_height(text: sview, size: f32) -> f32:
    _ = text
    return size

def ui_font_ascent(size: f32) -> f32:
    return size

def ui_text_line_height(size: f32) -> f32:
    return size

def ui_clipboard_has_text() -> bool:
    return false

def ui_clipboard_write(bytes: u8&, length: usize) -> bool:
    _ = bytes
    _ = length
    return false

def ui_clipboard_read(buffer: mutable u8&, capacity: usize) -> usize:
    _ = buffer
    _ = capacity
    return 0

def app_init() -> void:
    init_calls <- init_calls + 1

def app_event(event: UiCore::Event) -> void:
    event_calls <- event_calls + 1
    last_event_kind <- UiCore::wire_kind(event).i32()
    if nested_dispatch_on_event and not nested_dispatch_sent:
        nested_dispatch_sent <- true
        UiHarness::dispatch(UiCore::KeyEvent.Down(code: UiCore::Key.A))
    if stop_during_dispatch:
        stop_during_dispatch <- false
        _ = UiEvents::enqueue(UiCore::KeyEvent.Down(code: UiCore::Key.A))
        UiHarness::stop()

def app_widget_event(widget: usize, event: i32) -> void:
    _ = widget
    _ = event

def app_frame() -> void:
    frame_calls <- frame_calls + 1
    observed_time <- UiCore::frame_time()
    UiCore::clear(UiCore::rgb(12, 18, 28))
    UiCore::request_frame_after(0.20)
    UiCore::request_frame_after(0.05)

def check(name: cstr, ok: bool) -> void:
    return if ok
    failures <- failures + 1
    _ = puts(name)

def main() -> i64:
    UiHarness::start(320.0, 200.0)
    check("harness starts the app once", init_calls == 1)
    check("harness starts at deterministic time zero", UiHarness::time() == 0.0 and UiCore::frame_time() == 0.0)
    check("harness stores the injected viewport", UiCore::viewport_width() == 320.0 and UiCore::viewport_height() == 200.0)
    remote_offer: UiRemote::Offer = UiRemote::Offer{typed_commands: true, framebuffer: false, video: false, physical_width: 640, physical_height: 400, scale: 2.0, text_input: true, ime: true, semantics: true, clipboard: true, file_dialogs: true}
    check("harness injects remote negotiation", UiHarness::connect_remote(remote_offer, UiRemote::Presentation.TypedCommands) and UiHarness::remote_snapshot().selection.logical_width == 320.0)
    remote_generation: u32 = UiHarness::remote_snapshot().generation
    remote_input: UiRemote::InputResult = UiHarness::submit_remote_input(remote_generation, 1)
    check("harness injects generation-safe remote input", remote_input.accepted and UiHarness::acknowledge_remote_input(remote_generation, 1))
    check("harness injects remote suspension", UiHarness::suspend_remote() and UiHarness::remote_snapshot().overlay_visible)
    check("harness resumes remote input", UiHarness::resume_remote() and UiHarness::remote_snapshot().state == UiRemote::ConnectionState.Connected)

    resource: UiResources::ResourceHandle = UiHarness::request_resource("images/test", 5)
    check("harness injects a logical resource request", UiResources::resource_is_valid(resource) and UiHarness::resource_state(resource) == UiResources::State.Requested)
    check("harness injects visibility demand hints", UiHarness::set_resource_demand(resource, 4) and UiResources::demand_priority(resource) == 4 and UiHarness::clear_resource_demand(resource))
    check("harness injects independent resource progress", UiHarness::set_resource_progress(resource, 0.8, 0.25) and UiResources::downloaded_progress(resource) == 0.8 and UiResources::decoded_progress(resource) == 0.25)
    check("harness injects renderer-upload progress", UiHarness::set_resource_upload_progress(resource, 0.4) and UiResources::uploaded_progress(resource) == 0.4)
    check("harness injects resource completion", UiHarness::set_resource_state(resource, UiResources::State.Ready) and UiHarness::resource_state(resource) == UiResources::State.Ready)
    operation_resource: UiResources::ResourceHandle = UiHarness::request_resource("images/operation", 5)
    check("harness binds a generation-safe resource operation", UiHarness::bind_resource_operation(operation_resource, 601) and UiResources::operation_for(operation_resource) == 601)
    check("harness polls through the operation association", UiHarness::poll_resource_operation(operation_resource, 601, 0.45, 0.2) and UiResources::downloaded_progress(operation_resource) == 0.45)
    check("harness polls upload through the operation association", UiHarness::poll_resource_upload_operation(operation_resource, 601, 0.35) and UiResources::uploaded_progress(operation_resource) == 0.35)
    check("harness rejects a foreign upload operation", not UiHarness::poll_resource_upload_operation(operation_resource, 602, 0.9))
    check("harness rejects a foreign operation result", not UiHarness::poll_resource_operation(operation_resource, 602, 0.9, 0.9))
    check("harness completes through the operation association", UiHarness::complete_resource_operation(operation_resource, 601, UiResources::State.Ready, UiResources::FailureKind.Unknown) and UiResources::state(operation_resource) == UiResources::State.Ready)
    cancelled_operation: UiResources::ResourceHandle = UiHarness::request_resource("images/operation-cancel", 5)
    _ = UiHarness::bind_resource_operation(cancelled_operation, 603)
    check("harness returns the cancellation token", UiHarness::cancel_resource_operation(cancelled_operation) == 603 and UiResources::state(cancelled_operation) == UiResources::State.Cancelled)
    check("harness forgets the terminal host operation", UiHarness::forget_resource_operation(603) and UiResources::operation_count() == 0)
    _ = UiHarness::dispose_resource(operation_resource)
    _ = UiHarness::dispose_resource(cancelled_operation)
    second_resource: UiResources::ResourceHandle = UiHarness::request_resource("images/second", 5)
    check("harness cancels resources by owner", UiHarness::cancel_resources_for_owner(5) == 2 and UiHarness::resource_state(resource) == UiResources::State.Cancelled and UiHarness::resource_state(second_resource) == UiResources::State.Cancelled)
    check("cancelled resources remain valid without an owner lease", UiHarness::dispose_resources_for_owner(5) == 0 and UiResources::resource_is_valid(resource) and UiResources::resource_is_valid(second_resource))
    disposable_resource: UiResources::ResourceHandle = UiHarness::request_resource("images/dispose-first", 6)
    second_disposable_resource: UiResources::ResourceHandle = UiHarness::request_resource("images/dispose-second", 6)
    check("harness disposes resources by owner", UiHarness::dispose_resources_for_owner(6) == 2 and not UiResources::resource_is_valid(disposable_resource) and not UiResources::resource_is_valid(second_disposable_resource))

    feature: UiFeatureView::FeatureHandle = UiHarness::request_feature(3, 1, "1.0.0", 6)
    check("harness injects a feature request", UiFeatureView::is_valid(feature) and UiFeatureView::state(feature) == UiFeatureView::FeatureState.Requested)
    check("harness injects activation and polling", UiHarness::activate_feature(feature, 44) and UiHarness::resolve_feature(feature, 44, UiFeatureView::FeatureState.Ready, UiFeatureView::FeatureFailureKind.Unknown) and UiFeatureView::is_ready(feature))
    oversized_feature_payload: mutable u8[UiFeatureView::FEATURE_PAYLOAD_CAPACITY + 2] = zeroed
    for index in 0..<UiFeatureView::FEATURE_PAYLOAD_CAPACITY + 1:
        oversized_feature_payload[index] <- 65
    oversized_feature_payload[UiFeatureView::FEATURE_PAYLOAD_CAPACITY + 1] <- 0
    oversized_feature_payload_view: sview = UiText::fixed_bytes_view_range[1026](oversized_feature_payload, 0, UiFeatureView::FEATURE_PAYLOAD_CAPACITY + 1)
    check("harness publishes bounded feature payloads", UiHarness::publish_feature_payload(feature, 44, 1, sview("xoverlay:ready!", 1, 14)) and UiFeatureView::payload_info(feature).available and UiFeatureView::payload_info(feature).length == 13 and UiFeatureView::payload_byte_at(feature, 1, 0) == 111)
    check("harness rejects stale feature activation and sequence", not UiHarness::publish_feature_payload(feature, 43, 2, "stale") and not UiHarness::publish_feature_payload(feature, 44, 1, "replayed"))
    empty_string_view: sview = ""
    check("empty string source produces an empty payload view", empty_string_view.len == 0)
    check("harness rejects oversized feature payload", not UiHarness::publish_feature_payload(feature, 44, 2, oversized_feature_payload_view) and UiFeatureView::payload_info(feature).sequence == 1)
    cancellable_feature: UiFeatureView::FeatureHandle = UiHarness::request_feature(4, 1, "1.0.0", 6)
    _ = UiHarness::activate_feature(cancellable_feature, 45)
    check("harness routes feature cancellation acknowledgement", UiHarness::cancel_feature(cancellable_feature) and UiFeatureView::activation_id(cancellable_feature) == 45 and UiHarness::acknowledge_feature_deactivation(cancellable_feature, 45) and UiFeatureView::activation_id(cancellable_feature) == 0)

    UiHarness::dispatch(UiCore::Event.FocusGained)
    check("harness forwards typed events", event_calls == 1 and last_event_kind == UiCore::WireKind.FocusGained.i32())
    UiHarness::resize(640.0, 480.0)
    check("harness updates viewport before resize event", UiCore::viewport_width() == 640.0 and UiCore::viewport_height() == 480.0)
    check("resize is delivered through app contract", event_calls == 2 and last_event_kind == UiCore::WireKind.Resize.i32())

    UiHarness::set_time(1.25)
    UiHarness::frame()
    check("frame uses the injected absolute time", frame_calls == 1 and observed_time == 1.25)
    check("frame emits a command without a renderer", UiHarness::command_count() == 1 and not UiHarness::command_overflowed())
    check("frame coalesces the earliest wake", UiHarness::next_frame_delay() == 0.05)

    UiHarness::advance_time(-4.0)
    check("clock injection never moves backwards", UiHarness::time() == 1.25)
    UiHarness::run_frames(2, 0.25)
    check("run_frames drives the app repeatedly", frame_calls == 3)
    check("relative clock injection is deterministic", observed_time == 1.5)
    check("each frame starts with a fresh command batch", UiHarness::command_count() == 1)

    # Starting a replacement session must discard the old frame before the
    # new app has produced any commands or semantic nodes.
    UiCore::accessibility(UiCore::AccessibilityRole.Label, "retired", "", UiCore::Rect(0.0, 0.0, 20.0, 20.0), 7, 0, true, false, false, 0.0, "", "", 0, 0, 0)
    UiCore::request_frame_after(0.5)
    UiHarness::start(320.0, 200.0)
    check("restarting harness discards retired commands", UiHarness::command_count() == 0)
    check("restarting harness discards retired semantics", UiHarness::semantic_count() == 0)
    check("restarting harness clears retired frame scheduling", UiHarness::next_frame_delay() == 0.0)
    prior_deactivation: UiFeatureView::Deactivation = UiHarness::feature_deactivation_at(0)
    check("restarting harness retires payload but preserves host deactivation", UiFeatureView::is_valid(feature) and UiFeatureView::state(feature) == UiFeatureView::FeatureState.Cancelled and not UiFeatureView::payload_info(feature).available and prior_deactivation.handle.generation == feature.generation and prior_deactivation.activation_id == 44)
    check("replacement session can acknowledge the prior deactivation", UiHarness::acknowledge_feature_deactivation(feature, 44) and not UiFeatureView::is_valid(feature) and UiHarness::feature_deactivation_count() == 0)

    UiHarness::focus_lost()
    check("lifecycle helper forwards focus loss", event_calls == 3 and last_event_kind == UiCore::WireKind.FocusLost.i32())
    stopping_resource: UiResources::ResourceHandle = UiHarness::request_resource("images/stop-pending", 15)
    check("harness binds work that remains pending at stop", UiHarness::bind_resource_operation(stopping_resource, 604))
    stopping_feature: UiFeatureView::FeatureHandle = UiHarness::request_feature(22, 1, "2.0.0", 15)
    _ = UiHarness::activate_feature(stopping_feature, 605)
    _ = UiHarness::resolve_feature(stopping_feature, 605, UiFeatureView::FeatureState.Ready, UiFeatureView::FeatureFailureKind.Unknown)
    UiHarness::stop()
    UiHarness::dispatch(UiCore::Event.FocusGained)
    UiHarness::frame()
    check("stopped harness ignores late input and frames", event_calls == 3 and frame_calls == 3)
    check("stopped harness invalidates resource callbacks", not UiResources::resource_is_valid(resource) and not UiHarness::set_resource_state(resource, UiResources::State.Failed))
    stopped_operation: UiResources::Operation = UiHarness::resource_operation_at(0)
    check("stopping retains a cancellation tombstone for host cleanup", stopped_operation.operation_id == 604 and stopped_operation.cancellation_requested and UiHarness::resource_operation_count() == 1)
    check("host can acknowledge resource cleanup after stop", UiHarness::forget_resource_operation(604) and UiHarness::resource_operation_count() == 0)
    stopped_deactivation: UiFeatureView::Deactivation = UiHarness::feature_deactivation_at(0)
    check("stopping retains feature deactivation after owner reset", UiHarness::feature_deactivation_count() == 1 and stopped_deactivation.handle.generation == stopping_feature.generation and stopped_deactivation.activation_id == 605)
    check("host can acknowledge feature cleanup after stop", UiHarness::acknowledge_feature_deactivation(stopping_feature, 605) and not UiFeatureView::is_valid(stopping_feature) and UiHarness::feature_deactivation_count() == 0)
    check("stopped harness invalidates feature callbacks", not UiFeatureView::is_valid(feature) and not UiHarness::resolve_feature(feature, 44, UiFeatureView::FeatureState.Ready, UiFeatureView::FeatureFailureKind.Unknown) and not UiHarness::publish_feature_payload(feature, 44, 2, "late"))

    UiHarness::start(320.0, 200.0)
    before_turnover_events: i32 = event_calls
    # Nested harness dispatches must be queued onto the same iterative drain,
    # not recurse into app_event. The session is active so the nested key is a
    # valid physical input event.
    UiHarness::focus_gained()
    nested_dispatch_on_event <- true
    nested_dispatch_sent <- false
    before_nested_events: i32 = event_calls
    UiHarness::dispatch(UiCore::Event.FocusGained)
    check("harness drains nested events iteratively", nested_dispatch_sent and event_calls == before_nested_events + 2 and last_event_kind == UiCore::WireKind.KeyDown.i32())
    nested_dispatch_on_event <- false
    stop_during_dispatch <- true
    UiHarness::dispatch(UiCore::Event.FocusGained)
    check("harness drops queued events after lifecycle stop", event_calls == before_turnover_events + 4 and UiLifecycle::phase() == UiLifecycle::Phase.Stopped)

    if failures == 0:
        _ = puts("ui harness: all checks passed")
        return 0
    _ = puts("ui harness: FAILURES above")
    return 1
