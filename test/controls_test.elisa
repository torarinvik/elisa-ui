# The native-controls seam, with no window, no OS control and no platform.
#
# A RECORDING Controls backend stands in for AppKit or Win32: it hands out
# integer handles and writes down every create, frame and text it is asked for.
# That is enough to assert the things a native backend must get right and that
# no screenshot would tell you -- that the OS tree has the same SHAPE as the
# widget tree, that every control is placed at the box layout computed, and that
# each widget kind maps to the control a platform actually has.
#
# Text measurement is part of the platform contract, so this supplies
# deterministic stubs rather than depending on a host's fonts.

include "../src/widgets/ui_controls.elisa"

using UiWidgets
# The impl header below names `Controls` unqualified, as every backend does.
using UiControls

extern puts(text: cstr) -> i64

global mutable test_failures: i32 = 0

def check(name: cstr, ok: bool) -> void:
    return if ok
    test_failures <- test_failures + 1
    _ = puts(name)

def app_widget_event(widget: UiWidgets::Widget, event: i32) -> void:
    pass

def ui_measure_text_width(text: sview, size: f32, weighted: bool) -> f32:
    return text.len.f32() * size * 0.5

def ui_measure_text_height(text: sview, size: f32) -> f32:
    return size

def ui_font_ascent(size: f32) -> f32:
    return size

def ui_text_line_height(size: f32) -> f32:
    return size

# ---------------------------------------------------------------- the recorder

const LOG_CAP: usize = 64

global mutable log_kind: i32[LOG_CAP] = zeroed
global mutable log_window_mode: i32[LOG_CAP] = zeroed
global mutable log_axis: i32[LOG_CAP] = zeroed
global mutable log_state_value: f32[LOG_CAP] = zeroed
global mutable log_state_low: f32[LOG_CAP] = zeroed
global mutable log_state_high: f32[LOG_CAP] = zeroed
global mutable log_state_selected: bool[LOG_CAP] = zeroed
global mutable log_parent: i32[LOG_CAP] = zeroed
global mutable log_x: f32[LOG_CAP] = zeroed
global mutable log_y: f32[LOG_CAP] = zeroed
global mutable log_w: f32[LOG_CAP] = zeroed
global mutable log_h: f32[LOG_CAP] = zeroed
global mutable log_total: usize = 0
global mutable log_action: i32[LOG_CAP] = zeroed
global mutable action_calls: i32 = 0
global mutable control_events: i32 = 0
global mutable last_control_index: i32 = -1
global mutable last_control_event: i32 = -1
global mutable frame_calls: usize = 0
global mutable text_calls: usize = 0
global mutable state_calls: usize = 0
global mutable borrowed_caption: u8[8] = zeroed

# A backend keeps its own index -> handle table; this one keeps a log instead,
# which is the same thing with the native part left out.
struct RecordingControls:
    unused: i32

impl Controls for RecordingControls:
    def create(index: i32, kind: UiControls::Kind, parent: i32, window_mode: UiControls::WindowMode, axis: UiConst::Axis, state: UiControls::ControlState) -> void can[Ui.Controls]:
        return if index < 0 or index.usize() >= LOG_CAP
        row: usize = index.usize()
        log_total <- log_total + 1
        log_kind[row] <- kind.i32()
        log_window_mode[row] <- window_mode.i32()
        log_axis[row] <- axis.i32()
        log_parent[row] <- parent

    def set_frame(index: i32, kind: UiControls::Kind, box: UiCore::Rect) -> void can[Ui.Controls]:
        frame_calls <- frame_calls + 1
        return if index < 0 or index.usize() >= LOG_CAP
        row: usize = index.usize()
        log_x[row] <- box.origin.x
        log_y[row] <- box.origin.y
        log_w[row] <- box.size.width
        log_h[row] <- box.size.height

    def set_text(index: i32, kind: UiControls::Kind, text: sview) -> void can[Ui.Controls]:
        text_calls <- text_calls + 1

    def set_state(index: i32, kind: UiControls::Kind, value: f32, low: f32, high: f32, selected: bool) -> void can[Ui.Controls]:
        state_calls <- state_calls + 1
        return if index < 0 or index.usize() >= LOG_CAP
        row: usize = index.usize()
        log_state_value[row] <- value
        log_state_low[row] <- low
        log_state_high[row] <- high
        log_state_selected[row] <- selected

    def set_action(index: i32, kind: UiControls::Kind) -> void can[Ui.Controls]:
        action_calls <- action_calls + 1
        return if index < 0 or index.usize() >= LOG_CAP
        log_action[index.usize()] <- kind.i32()

def app_control_event(index: i32, event: i32) -> void:
    control_events <- control_events + 1
    last_control_index <- index
    last_control_event <- event

def kind_at(row: usize) -> i32:
    return log_kind[row]

def grey(v: u8) -> UiCore::Color:
    return UiCore::Color{r: v, g: v, b: v, a: 255}

# A window over a row of two buttons, plus a caption:
#
#   Window.Top "Demo"
#     +-- Container.Box (row)
#     |     +-- Button.Push "Left"
#     |     +-- Button.Push "Right"
#     +-- Control.Label "Caption"
#
# Parent-first depth-first realization must therefore produce handles
# 0..4 as root, bar, Left, Right, caption.
def build() -> Widget:
    can Memory.Allocate, Abort.Panic:
        left: Widget = Button.Push(min_width: 40.0, min_height: 20.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "Left", rest: grey(60), hover: grey(90), press: grey(30))
        right: Widget = Button.Check(min_width: 60.0, min_height: 20.0, grow: 1.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "Right", checked: true, rest: grey(60), hover: grey(90), press: grey(30))
        left.next_sibling <- right
        bar: Widget = Container.Box(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: left, next_sibling: null, axis: UiConst::Axis.Row, padding: 0.0, spacing: 0.0, fill: grey(20))
        caption: Widget = Control.Label(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, text: "Caption", size: 12.0, ink: grey(200))
        bar.next_sibling <- caption
        root: Widget = Window.Top(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: bar, next_sibling: null, title: "Demo", resizable: true)
        return root

def main() -> i64:
    can Ui.Controls, Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        root: Widget = build()
        floating: Widget = Window.Floating(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, title: "Palette")
        fixed: Widget = Window.Top(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, title: "Fixed", resizable: false)
        checked_widget: Widget = Button.Check(min_width: 1.0, min_height: 1.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "Checked", checked: true, rest: grey(20), hover: grey(40), press: grey(10))
        check("floating windows carry floating mode", UiControls::window_mode_of(floating) == UiControls::WindowMode.Floating)
        check("fixed top windows carry fixed mode", UiControls::window_mode_of(fixed) == UiControls::WindowMode.Fixed)
        check("checkbox state extraction keeps checked", UiControls::state_of(checked_widget).selected)
        invalid_axis: UiConst::Axis = (-1).i32().Axis()
        malformed_container: Widget = Container.Box(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, axis: invalid_axis, padding: 0.0, spacing: 0.0, fill: grey(20))
        check("raw hierarchy axis normalizes before native realization", UiWidgets::axis_of(malformed_container) == UiConst::Axis.Column)
        layout(root, 200.0, 100.0)
        UiControls::reset()
        UiControls::realize(root, UiControls::NO_PARENT, 0)
        UiControls::apply[RecordingControls]()

        # One control per widget, every one placed and captioned.
        check("a control per widget", log_total == 5)
        check("a complete tree does not report overflow", not UiControls::overflowed())
        check("out-of-range native handle reads fail closed", UiControls::native_handle_at(UiControls::count()) == 0)
        check("out-of-range control kind reads fail closed", UiControls::kind_at(UiControls::count()) == UiControls::Kind.Panel)
        check("out-of-range control text reads fail closed", UiControls::text_at(UiControls::count()).len == 0)
        check("every control is framed", frame_calls == 5)
        check("every control is given its text", text_calls == 5)
        check("every control receives initial state", state_calls == 5)

        # PARENT FIRST, and the OS tree has the widget tree's shape.
        check("the root has no parent", log_parent[0] == UiControls::NO_PARENT)
        check("the bar hangs off the root", log_parent[1] == 0)
        check("the left button hangs off the bar", log_parent[2] == 1)
        check("the right button hangs off the bar", log_parent[3] == 1)
        check("the caption hangs off the root", log_parent[4] == 0)

        # Each widget kind became a control a platform actually has.
        check("a window realizes a Window", kind_at(0) == UiControls::Kind.Window.i32())
        check("a resizable top window carries its mode", log_window_mode[0] == UiControls::WindowMode.Resizable.i32())
        check("the window carries its column axis", log_axis[0] == UiConst::Axis.Column.i32())
        check("a box realizes a Panel", kind_at(1) == UiControls::Kind.Panel.i32())
        check("non-window controls carry neutral window mode", log_window_mode[1] == UiControls::WindowMode.Fixed.i32())
        check("the row carries its row axis", log_axis[1] == UiConst::Axis.Row.i32())
        check("a push button realizes a PushButton", kind_at(2) == UiControls::Kind.PushButton.i32())
        check("a checkbox carries its selected state", log_state_selected[3])
        check("a label realizes a Label", kind_at(4) == UiControls::Kind.Label.i32())

        # Control records own their captions. A backend may consume the list
        # after the builder's source buffer has been reused, so the retained
        # view must not point back into application-owned scratch storage.
        borrowed_caption[0] <- 79
        borrowed_caption[1] <- 119
        borrowed_caption[2] <- 110
        borrowed_caption[3] <- 101
        borrowed_caption[4] <- 100
        owned_label: Widget = Control.Label(min_width: 1.0, min_height: 1.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, text: sview(&borrowed_caption[0], 0, 5), size: 10.0, ink: grey(200))
        UiControls::reset()
        UiControls::realize(owned_label, UiControls::NO_PARENT, 0)
        borrowed_caption[0] <- 88
        check("control text is copied into Elisa storage", UiControls::text_at(0) == "Owned")

        gauge: Widget = Control.Gauge(min_width: 1.0, min_height: 1.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, fraction: 2.0, track: grey(20), bar: grey(200))
        gauge_state: UiControls::ControlState = UiControls::state_of(gauge)
        check("gauge state clamps to its normalized range", gauge_state.value == 1.0 and gauge_state.low == 0.0 and gauge_state.high == 1.0)

        slider: Widget = Control.Slider(min_width: 1.0, min_height: 1.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, value: 7.0, low: -2.0, high: 12.0, track: grey(20), knob: grey(200))
        slider_state: UiControls::ControlState = UiControls::state_of(slider)
        check("slider state carries its value", slider_state.value == 7.0)
        check("slider state carries its range", slider_state.low == -2.0 and slider_state.high == 12.0)

        reversed_slider: Widget = Control.Slider(min_width: 1.0, min_height: 1.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, value: 99.0, low: 12.0, high: -2.0, track: grey(20), knob: grey(200))
        reversed_state: UiControls::ControlState = UiControls::state_of(reversed_slider)
        check("slider state orders and clamps its range", reversed_state.low == -2.0 and reversed_state.high == 12.0 and reversed_state.value == 12.0)

        # NaN is a valid IEEE-754 payload that can arrive through an FFI
        # callback. Slider state must not let it escape into a native setter.
        zero: f32 = 0.0
        nan: f32 = zero / zero
        infinity: f32 = 1.0 / zero
        check("core finite helper catches NaN", UiCore::finite_or_zero(nan) == 0.0)
        check("core finite helper catches infinity", UiCore::finite_or_zero(infinity) == 0.0)
        check("core extent helper catches NaN", UiCore::nonnegative_extent(nan) == 0.0)
        malformed_slider: Widget = Control.Slider(min_width: 1.0, min_height: 1.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, value: nan, low: nan, high: 10.0, track: grey(20), knob: grey(200))
        malformed_state: UiControls::ControlState = UiControls::state_of(malformed_slider)
        check("slider state sanitizes NaN low", malformed_state.low == 0.0)
        check("slider state preserves finite high", malformed_state.high == 10.0)
        check("slider state sanitizes NaN value", malformed_state.value == 0.0)

        # Finite f32 values can still be far outside the coordinate range a
        # native control can represent safely. Slider ranges use the same
        # signed cap as frames so hostile FFI data cannot reach AppKit with an
        # enormous min/max/value.
        huge: f32 = 3.0e38
        extreme_slider: Widget = Control.Slider(min_width: 1.0, min_height: 1.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, value: huge, low: -huge, high: huge, track: grey(20), knob: grey(200))
        extreme_state: UiControls::ControlState = UiControls::state_of(extreme_slider)
        check("slider state bounds extreme low", extreme_state.low == -UiCore::MAX_GEOMETRY_EXTENT)
        check("slider state bounds extreme high", extreme_state.high == UiCore::MAX_GEOMETRY_EXTENT)
        check("slider state bounds extreme value", extreme_state.value == UiCore::MAX_GEOMETRY_EXTENT)

        # The shared box projection is also the native-control boundary. A
        # raw hierarchy value must not pass a giant finite extent through to a
        # platform frame setter when realization happens before layout.
        malformed_box: Widget = Control.Label(min_width: 0.0, min_height: 0.0, grow: 0.0, x: huge, y: -huge, width: huge, height: huge, hovered: false, pressed: false, first_child: null, next_sibling: null, text: "raw", size: 12.0, ink: grey(200))
        safe_box: UiCore::Rect = UiWidgets::box_of(malformed_box)
        check("raw box bounds origin", safe_box.origin.x == UiCore::MAX_GEOMETRY_EXTENT and safe_box.origin.y == -UiCore::MAX_GEOMETRY_EXTENT)
        check("raw box bounds width", safe_box.size.width == UiConstraints::MAX_EXTENT)
        check("raw box bounds height", safe_box.size.height == UiConstraints::MAX_EXTENT)

        # ABSOLUTE PLACEMENT: a control sits at the box layout computed for its
        # widget, not somewhere the backend invented.
        root_box: UiCore::Rect = box_of(root)
        check("the root control matches its laid-out box", log_x[0] == root_box.origin.x and log_w[0] == root_box.size.width)
        check("the root fills the viewport width", log_w[0] == 200.0)
        left_box: UiCore::Rect = box_of(root)
        check("the two buttons are laid out side by side", log_x[3] > log_x[2])
        check("both buttons share the row's top", log_y[2] == log_y[3])

        # Capacity failure is explicit: a 300-sibling chain keeps the first
        # MAX_CONTROLS records intact and reports that the remainder was dropped.
        UiControls::reset()
        overflow_root: Widget = Window.Top(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, title: "Overflow", resizable: true)
        first: Widget = Control.Label(min_width: 1.0, min_height: 1.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, text: "x", size: 10.0, ink: grey(200))
        last: mutable Widget = first
        for index in 1..<300:
            node: Widget = Control.Label(min_width: 1.0, min_height: 1.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, text: "x", size: 10.0, ink: grey(200))
            last.next_sibling <- node
            last <- node
        overflow_root.first_child <- first
        UiControls::realize(overflow_root, UiControls::NO_PARENT, 0)
        check("an overflowing tree reports dropped controls", UiControls::overflowed())
        check("an overflowing tree keeps the arena bounded", UiControls::count() == 256)

        # A malformed hierarchy must fail closed before a native backend sees
        # an unbounded stream of duplicate controls. The cycle is deliberately
        # built through the public mutable link, just like an FFI caller could
        # provide one.
        UiControls::reset()
        cycle_root: Widget = Window.Top(min_width: 0.0, min_height: 0.0, grow: 0.0, x: 0.0, y: 0.0, width: 0.0, height: 0.0, hovered: false, pressed: false, first_child: null, next_sibling: null, title: "Cycle", resizable: true)
        cycle_root.first_child <- cycle_root
        UiControls::realize(cycle_root, UiControls::NO_PARENT, 0)
        check("a cyclic hierarchy reports dropped controls", UiControls::overflowed())
        check("a cyclic hierarchy keeps realization bounded", UiControls::count() <= UiControls::capacity())

        # A raw leaf can carry a malformed first-child link because the
        # hierarchy common is public. Realization must enforce the same
        # container-only nesting rule as the builder and leave that descendant
        # out of the native control list.
        UiControls::reset()
        hidden_child: Widget = Button.Push(min_width: 10.0, min_height: 10.0, grow: 0.0, x: 0.0, y: 0.0, width: 10.0, height: 10.0, hovered: false, pressed: false, first_child: null, next_sibling: null, label: "hidden", rest: grey(30), hover: grey(40), press: grey(20))
        malformed_leaf: Widget = Control.Label(min_width: 10.0, min_height: 10.0, grow: 0.0, x: 0.0, y: 0.0, width: 10.0, height: 10.0, hovered: false, pressed: false, first_child: hidden_child, next_sibling: null, text: "leaf", size: 12.0, ink: grey(200))
        UiControls::realize(malformed_leaf, UiControls::NO_PARENT, 0)
        check("leaf realization ignores raw child", UiControls::count() == 1 and not UiControls::overflowed())

        if test_failures == 0:
            _ = puts("controls: all checks passed")
            return 0
        return 1
