# THE RETAINED TREE, REALIZED AS NATIVE CONTROLS -- with no OS control in sight.
#
# controls_test.elisa asserts the other application layer: the immediate
# UiWidgets hierarchy. This one asserts the layer every application in this
# repository actually uses, and the one both mobile backends run -- and which
# had no test at all, so the seam that turns a UiHandles tree into UILabels and
# android.widget.Buttons was covered only by looking at a phone.
#
# A RECORDING backend stands in for UIKit and Android. That is enough for the
# things a screenshot cannot tell you: that the control tree has the same shape
# as the widget tree, that every kind maps to the control a platform has, and
# -- the part this file was written for -- that what a user types into a native
# field arrives back in the retained widget, exactly once.

include "../src/widgets/ui_controls_flat.elisa"

using UiControls

extern puts(text: cstr) -> i64

global mutable test_failures: i32 = 0
global mutable widget_events: i32 = 0
global mutable last_widget: usize = UiFlat::NONE
global mutable last_widget_event: i32 = -1

def near(actual: f32, expected: f32) -> bool:
    delta: f32 = actual - expected if actual > expected else expected - actual
    return delta < 0.01

def check(name: cstr, ok: bool) -> void:
    return if ok
    test_failures <- test_failures + 1
    _ = puts(name)

def app_widget_event(index: usize, event: i32) -> void:
    widget_events <- widget_events + 1
    last_widget <- index
    last_widget_event <- event

# The retained layer calls this when a CONTROL acts; an application routes it
# into retained_action. The tests below call retained_action directly, so this
# only has to exist.
def app_control_event(index: i32, event: i32) -> void:
    pass

# Text measurement is part of the platform contract; a test with no backend
# supplies deterministic stubs rather than depending on a host's fonts.
def ui_measure_text_width(text: sview, size: f32, weighted: bool) -> f32:
    return text.len.f32() * size * 0.5

def ui_measure_text_height(text: sview, size: f32) -> f32:
    return size

def ui_font_ascent(size: f32) -> f32:
    return size

def ui_text_line_height(size: f32) -> f32:
    return size

def ui_clipboard_has_text() -> bool:
    return false

def ui_clipboard_write(bytes: u8&, length: usize) -> bool:
    return false

def ui_clipboard_read(buffer: mutable u8&, capacity: usize) -> usize:
    return 0

# ---------------------------------------------------------------- the recorder

const LOG_CAP: usize = 64

global mutable log_kind: i32[LOG_CAP] = zeroed
global mutable log_parent: i32[LOG_CAP] = zeroed
global mutable log_x: f32[LOG_CAP] = zeroed
global mutable log_y: f32[LOG_CAP] = zeroed
global mutable log_text_len: i64[LOG_CAP] = zeroed
global mutable log_text_first: u8[LOG_CAP] = zeroed
global mutable created: usize = 0
global mutable released: usize = 0
global mutable log_state_writes: i32[LOG_CAP] = zeroed
global mutable log_color_writes: i32[LOG_CAP] = zeroed
global mutable log_ink: u8[LOG_CAP] = zeroed
global mutable log_prompt_len: i64[LOG_CAP] = zeroed
global mutable log_help_len: i64[LOG_CAP] = zeroed
global mutable log_secure: bool[LOG_CAP] = zeroed
global mutable log_enabled: bool[LOG_CAP] = zeroed
global mutable log_text_writes: i32[LOG_CAP] = zeroed

struct RecordingControls:
    unused: i32

impl Controls for RecordingControls:
    def create(index: i32, kind: UiControls::ControlKind, parent: i32, window_mode: UiControls::WindowMode, axis: UiConst::Axis, state: UiControls::ControlState) -> void can[Ui.Controls]:
        return if index < 0 or index.usize() >= LOG_CAP
        created <- created + 1
        log_kind[index.usize()] <- kind.i32()
        log_parent[index.usize()] <- parent
        # A backend's own identity. Index + 1 so that zero stays "no handle",
        # which is the contract the seam's handle table keeps.
        UiControls::set_native_handle(index.usize(), index.usize() + 1)

    def set_frame(index: i32, kind: UiControls::ControlKind, box: UiCore::Rect) -> void can[Ui.Controls]:
        return if index < 0 or index.usize() >= LOG_CAP
        log_x[index.usize()] <- box.origin.x
        log_y[index.usize()] <- box.origin.y

    def set_colors(index: i32, kind: UiControls::ControlKind, ink: UiCore::Color, fill: UiCore::Color) -> void can[Ui.Controls]:
        return if index < 0 or index.usize() >= LOG_CAP
        log_color_writes[index.usize()] <- log_color_writes[index.usize()] + 1
        log_ink[index.usize()] <- ink.r

    def set_text(index: i32, kind: UiControls::ControlKind, text: sview) -> void can[Ui.Controls]:
        return if index < 0 or index.usize() >= LOG_CAP
        log_text_len[index.usize()] <- text.len
        log_text_first[index.usize()] <- text.data[0] if text.len > 0 else 0
        log_text_writes[index.usize()] <- log_text_writes[index.usize()] + 1

    def set_state(index: i32, kind: UiControls::ControlKind, state: UiControls::ControlState) -> void can[Ui.Controls]:
        return if index < 0 or index.usize() >= LOG_CAP
        log_state_writes[index.usize()] <- log_state_writes[index.usize()] + 1
        log_secure[index.usize()] <- state.secure
        log_enabled[index.usize()] <- state.enabled

    def set_help(index: i32, kind: UiControls::ControlKind, placeholder: sview, help: sview) -> void can[Ui.Controls]:
        return if index < 0 or index.usize() >= LOG_CAP
        log_prompt_len[index.usize()] <- placeholder.len
        log_help_len[index.usize()] <- help.len

    def set_action(index: i32, kind: UiControls::ControlKind) -> void can[Ui.Controls]:
        pass

# The control slot a given retained widget was realized into. A test asserts
# about widgets; the seam's own map runs the other way.
def slot_for_widget(widget: usize) -> usize:
    for slot in 0..<UiControls::count():
        return slot if UiControls::retained_index_at(slot) == widget
    return UiControls::capacity()

def grey(level: u8) -> UiCore::Color:
    return UiCore::rgba(level, level, level, 255)

# What a native backend's realize_retained does, with the platform left out:
# move the old list aside, build the new one, adopt what did not change, and
# release only the rest.
def realize_reconciling() -> void can[Ui.Controls, Memory.Allocate, Abort.Panic, Ui.Draw, Ui.Text, Ui.Input, Ui.Window, Unsafe.PointerCast]:
    UiControls::begin_reconcile()
    UiControls::realize_retained()
    UiControls::adopt_unchanged()
    count: usize = UiControls::discarded_count()
    index: mutable usize = count
    for _ in 0..<count:
        index <- index - 1
        released <- released + 1 if UiControls::discarded_handle_at(index) != 0
    UiControls::apply[RecordingControls]()

def main() -> i64:
    can Memory.Allocate, Abort.Panic, Ui.Controls, Ui.Draw, Ui.Text, Ui.Input, Ui.Window, Unsafe.PointerCast:
        UiFlat::reset()
        UiControls::reset()

        root: UiHandles::Handle = UiHandles::column(UiHandles::root_parent(), 10.0, 6.0, grey(20))
        caption: UiHandles::Handle = UiHandles::label(root, "Name", 12.0, grey(200))
        field: UiHandles::Handle = UiHandles::text_field(root, "Name", "who?", "ada", 200.0, 30.0, 12.0, grey(230), grey(40))
        press: UiHandles::Handle = UiHandles::button(root, 80.0, 30.0, grey(60), grey(70), grey(50))
        first_choice: UiHandles::Handle = UiHandles::radio_button(root, 60.0, 24.0, grey(60), grey(70), grey(50))
        second_choice: UiHandles::Handle = UiHandles::radio_button(root, 60.0, 24.0, grey(60), grey(70), grey(50))
        knob: UiHandles::Handle = UiHandles::slider(root, 120.0, 24.0, 0.25, grey(40), grey(120), grey(200))

        UiHandles::set_selected(first_choice, true)
        UiHandles::layout(320.0, 480.0)

        UiControls::realize_retained()
        UiControls::apply[RecordingControls]()

        # ---- the tree arrives, with the shape it had -------------------------
        check("every visible widget became a control", UiControls::count() == 7)
        check("the backend was asked to create each one", created == UiControls::count())
        check("the first root is a window", log_kind[0] == UiControls::ControlKind.Window.i32())
        check("the window has no parent", log_parent[0] == UiControls::NO_PARENT)

        field_slot: usize = slot_for_widget(UiHandles::index(field))
        press_slot: usize = slot_for_widget(UiHandles::index(press))
        first_slot: usize = slot_for_widget(UiHandles::index(first_choice))
        second_slot: usize = slot_for_widget(UiHandles::index(second_choice))
        knob_slot: usize = slot_for_widget(UiHandles::index(knob))
        caption_slot: usize = slot_for_widget(UiHandles::index(caption))

        check("a retained field becomes a native field", log_kind[field_slot] == UiControls::ControlKind.TextField.i32())
        check("a retained button becomes a push button", log_kind[press_slot] == UiControls::ControlKind.PushButton.i32())
        check("a retained radio becomes a radio button", log_kind[first_slot] == UiControls::ControlKind.RadioButton.i32())
        check("a retained slider becomes a slider", log_kind[knob_slot] == UiControls::ControlKind.Slider.i32())
        check("a retained label becomes a label", log_kind[caption_slot] == UiControls::ControlKind.Label.i32())

        # A CHILD IS PLACED INSIDE ITS PARENT. The layout computes absolute
        # boxes and every toolkit here takes a child's frame in its parent's
        # coordinates, so a control must arrive at the difference.
        absolute: UiCore::Rect = UiControls::box_at(field_slot)
        container: UiCore::Rect = UiControls::box_at(UiControls::parent_at(field_slot).usize())
        check("a child is placed inside its parent", near(log_x[field_slot], absolute.origin.x - container.origin.x) and near(log_y[field_slot], absolute.origin.y - container.origin.y))

        # A FIELD SHOWS ITS VALUE, NOT ITS CAPTION. Both are strings on the
        # widget and only one of them is what a native field displays.
        check("a field is realized with its value", log_text_len[field_slot] == 3 and log_text_first[field_slot] == 97)

        # ---- what the user types comes back ----------------------------------
        #
        # THE POINT OF THE FILE. A native field runs the IME, autocorrect and
        # dictation and then reports the finished string; until the text
        # channel existed the action carried a float and a flag and the words
        # were dropped on the floor.
        widget_events <- 0
        handle: usize = UiControls::native_handle_at(field_slot)
        check("a realized control has a backend handle", handle != 0)
        resolved: i32 = UiControls::dispatch_native_text(handle, "grace")
        check("a text action resolves to its control", resolved == field_slot.i32())
        check("the control list holds what was typed", UiControls::text_at(field_slot).len == 5)

        # The seam wrote it into the list; retained_action carries it the last
        # step, into the widget the application owns.
        check("the widget takes the typed text", UiControls::retained_action(field_slot.i32(), UiConst::WidgetEvent.Change.i32()))
        typed: sview = UiFlat::text_value(UiHandles::index(field))
        check("the retained field holds the new text", typed.len == 5 and typed.data[0] == 103)
        # replace_text emits the Change itself, so the field must not also fall
        # through to the shared event below: one keystroke is one edit.
        check("one edit reaches the application once", widget_events == 1)
        check("the edit names the field", last_widget == UiHandles::index(field) and last_widget_event == UiConst::WidgetEvent.Change.i32())

        # AN UNCHANGED EDIT IS NOT AN EDIT. A backend that re-realizes on every
        # event would otherwise chase its own tail: realize writes the text
        # back into the native field, which reports it, which realizes again.
        widget_events <- 0
        _ = UiControls::dispatch_native_text(handle, "grace")
        check("re-reporting the same text carries it", UiControls::retained_action(field_slot.i32(), UiConst::WidgetEvent.Change.i32()))
        check("an unchanged edit raises no event", widget_events == 0)

        # A caption is the application's to set. A toolkit reporting one back
        # would be a loop and not an edit, so the seam refuses it by kind.
        check("a label refuses a text write-back", not UiControls::note_text(caption_slot, "hijacked"))
        check("a label keeps its own words", UiControls::text_at(caption_slot).len == 4)

        # A report from a handle no live control owns is what a late callback
        # from a torn-down tree looks like, and must not reach the application.
        widget_events <- 0
        check("an unknown handle resolves to nothing", UiControls::dispatch_native_text(0, "x") == UiControls::NO_PARENT)
        check("a stale handle raises no event", widget_events == 0)
        check("the field kept its text", UiFlat::text_value(UiHandles::index(field)).len == 5)

        # CLEARING A FIELD IS A REAL EDIT. A user who selects everything and
        # deletes has said something, and an empty string is what they said --
        # so this is the one write-back that must NOT be mistaken for a bridge
        # reporting nothing.
        widget_events <- 0
        _ = UiControls::dispatch_native_text(handle, "")
        check("an emptied field carries an empty string", UiControls::text_at(field_slot).len == 0)
        check("the emptied edit reaches the widget", UiControls::retained_action(field_slot.i32(), UiConst::WidgetEvent.Change.i32()))
        check("the retained field is now empty", UiFlat::text_value(UiHandles::index(field)).len == 0)
        check("clearing raises exactly one event", widget_events == 1)
        # Put it back, so the checks below read a field with content.
        _ = UiControls::dispatch_native_text(handle, "grace")
        _ = UiControls::retained_action(field_slot.i32(), UiConst::WidgetEvent.Change.i32())

        # ---- the numeric channel still works ---------------------------------
        widget_events <- 0
        knob_handle: usize = UiControls::native_handle_at(knob_slot)
        _ = UiControls::dispatch_native_action(knob_handle, UiConst::WidgetEvent.Change, 0.75, false)
        check("a slider drag carries its value", UiControls::retained_action(knob_slot.i32(), UiConst::WidgetEvent.Change.i32()))
        check("the retained slider follows the native one", near(UiFlat::widget(UiHandles::index(knob)).value, 0.75))

        # A radio group is the list's knowledge, not the toolkit's: turning one
        # on turns its siblings off before the application ever sees the click.
        second_handle: usize = UiControls::native_handle_at(second_slot)
        _ = UiControls::dispatch_native_action(second_handle, UiConst::WidgetEvent.Click, 0.0, true)
        check("the clicked radio is selected", UiControls::state_at(second_slot).selected)
        check("its sibling was turned off", not UiControls::state_at(first_slot).selected)

        # ---- a hidden widget is not a control --------------------------------
        UiHandles::set_visible(press, false)
        UiControls::realize_retained()
        check("a hidden widget is left out", UiControls::count() == 6)

        # ---- realizing again keeps the controls that did not change ---------
        #
        # WHY THIS MATTERS. An application that lays out again when its text
        # changes turns every keystroke into a realization. Rebuilding the
        # whole native tree for one of those destroys the field being typed
        # into -- the keyboard drops, the caret goes, and a character that
        # arrives mid-rebuild lands on a view that no longer exists. Measured
        # on a Pixel 9 before this: typing five characters left three.
        UiHandles::set_visible(press, true)
        UiFlat::layout(320.0, 480.0)
        UiControls::reset()
        created <- 0
        UiControls::realize_retained()
        UiControls::apply[RecordingControls]()
        total_controls: usize = UiControls::count()
        check("a first realization creates everything", created == total_controls)

        # The same tree again: nothing changed, so nothing is built and nothing
        # is released.
        created <- 0
        released <- 0
        realize_reconciling()
        check("an unchanged tree creates nothing", created == 0)
        check("an unchanged tree releases nothing", released == 0)
        check("every control was adopted", UiControls::adopted_count() == total_controls)
        check("the tree is still all there", UiControls::count() == total_controls)

        # A value change is not a structural change: the slider moves, the
        # controls stay. This is the keystroke case.
        created <- 0
        released <- 0
        UiHandles::set_value(knob, 0.5)
        UiFlat::layout(320.0, 480.0)
        realize_reconciling()
        check("a value change rebuilds nothing", created == 0 and released == 0)

        # Hiding a widget removes a control. What is left keeps its identity up
        # to the point where the shape diverges; the rest is rebuilt, which is
        # correct and only slower.
        created <- 0
        released <- 0
        UiHandles::set_visible(press, false)
        UiFlat::layout(320.0, 480.0)
        realize_reconciling()
        check("a removed widget leaves one fewer control", UiControls::count() == total_controls - 1)
        check("a shape change releases something", released > 0)

        # A CHILD IS NEVER ADOPTED INTO A PARENT THAT WAS REBUILT. Every
        # toolkit here holds a child inside its parent, so a rebuilt parent has
        # no children, and an adopted child would be a live native object
        # attached to a view being released. The label below keeps its own kind
        # AND its own parent index across the two trees -- only what the parent
        # IS changes -- so nothing but the inherited rule can catch it.
        UiFlat::reset()
        UiControls::reset()
        panel_root: UiHandles::Handle = UiHandles::column(UiHandles::root_parent(), 10.0, 6.0, grey(20))
        middle: UiHandles::Handle = UiHandles::column(panel_root, 4.0, 4.0, grey(30))
        _ = UiHandles::label(middle, "deep", 12.0, grey(200))
        UiHandles::layout(320.0, 480.0)
        UiControls::realize_retained()
        UiControls::apply[RecordingControls]()
        nested: usize = UiControls::count()
        check("the nested tree realized", nested == 3)

        # The same shape with a SCROLL in the middle: slot for slot identical
        # except for that one kind. The control list is deliberately NOT reset
        # here -- begin_reconcile is what moves it aside, and resetting first
        # would throw away the very realization this is meant to compare
        # against. (It did, and two mutations walked straight through.)
        UiFlat::reset()
        scroll_root: UiHandles::Handle = UiHandles::column(UiHandles::root_parent(), 10.0, 6.0, grey(20))
        scroller: UiHandles::Handle = UiHandles::scroll(scroll_root, UiConst::Axis.Column, 4.0, 4.0, grey(30))
        _ = UiHandles::label(scroller, "deep", 12.0, grey(200))
        UiHandles::layout(320.0, 480.0)
        created <- 0
        released <- 0
        realize_reconciling()
        # The root is unchanged and keeps its control; the container whose
        # KIND changed is rebuilt, and its label goes with it even though the
        # label's own kind and parent index are identical in both trees. Two
        # of the three, exactly.
        check("a changed parent is rebuilt", created > 0)
        check("its child is rebuilt with it", created == UiControls::count() - 1)

        # A CONTROL THAT CHANGED PARENTS IS NOT THE SAME CONTROL. Position and
        # kind can both match while the thing it hangs from has changed, and a
        # native control adopted across that ends up inside the wrong view --
        # visibly, at the wrong place on screen. Both trees below emit
        # root, A, L, M in that order with M a Label either way; only M's
        # parent differs.
        UiFlat::reset()
        UiControls::reset()
        home: UiHandles::Handle = UiHandles::column(UiHandles::root_parent(), 0.0, 0.0, grey(20))
        box_a: UiHandles::Handle = UiHandles::column(home, 0.0, 0.0, grey(30))
        _ = UiHandles::label(box_a, "L", 12.0, grey(200))
        _ = UiHandles::label(box_a, "M", 12.0, grey(200))
        UiHandles::layout(320.0, 480.0)
        UiControls::realize_retained()
        UiControls::apply[RecordingControls]()
        check("the move tree realized four controls", UiControls::count() == 4)
        moved_slot: usize = 3
        check("the moving control starts under the inner box", UiControls::parent_at(moved_slot) == 1)

        UiFlat::reset()
        home_again: UiHandles::Handle = UiHandles::column(UiHandles::root_parent(), 0.0, 0.0, grey(20))
        box_again: UiHandles::Handle = UiHandles::column(home_again, 0.0, 0.0, grey(30))
        _ = UiHandles::label(box_again, "L", 12.0, grey(200))
        _ = UiHandles::label(home_again, "M", 12.0, grey(200))
        UiHandles::layout(320.0, 480.0)
        created <- 0
        released <- 0
        realize_reconciling()
        check("the control did move parents", UiControls::parent_at(moved_slot) == 0)
        check("a control that moved parents is rebuilt", created == 1)

        # ---- a skipped setter must never skip a real change -----------------
        #
        # THE BUG THIS WAS WRITTEN FOR. Skipping a setter whose value has not
        # changed needs a record of what each control was actually GIVEN. The
        # first version compared against the control LIST instead, and
        # note_selection turns a radio's siblings off in the list without
        # telling those controls -- so the list already agreed, the un-check was
        # skipped, and both tabs read as selected in Android's own view dump.
        UiFlat::reset()
        UiControls::reset()
        tabs_root: UiHandles::Handle = UiHandles::column(UiHandles::root_parent(), 0.0, 0.0, grey(20))
        tab_one: UiHandles::Handle = UiHandles::radio_button(tabs_root, 60.0, 24.0, grey(60), grey(70), grey(50))
        tab_two: UiHandles::Handle = UiHandles::radio_button(tabs_root, 60.0, 24.0, grey(60), grey(70), grey(50))
        UiHandles::set_selected(tab_one, true)
        UiHandles::layout(320.0, 480.0)
        UiControls::realize_retained()
        UiControls::apply[RecordingControls]()
        one_slot: usize = slot_for_widget(UiHandles::index(tab_one))
        two_slot: usize = slot_for_widget(UiHandles::index(tab_two))
        check("the first tab starts selected", UiControls::state_at(one_slot).selected)

        # The user picks the other one. The toolkit told us about the control
        # they touched; the one that must go dark was never told anything.
        _ = UiControls::dispatch_native_action(UiControls::native_handle_at(two_slot), UiConst::WidgetEvent.Click, 0.0, true)
        _ = UiControls::retained_action(two_slot.i32(), UiConst::WidgetEvent.Click.i32())
        log_state_writes[one_slot] <- 0
        log_state_writes[two_slot] <- 0
        UiFlat::layout(320.0, 480.0)
        realize_reconciling()
        check("the tab that was turned off is told", log_state_writes[one_slot] == 1)
        check("it is actually off", not UiControls::state_at(one_slot).selected)
        # The control the user touched already holds what it reported, so
        # writing it back would be the framework arguing with the toolkit.
        check("the tab the user touched is not rewritten", log_state_writes[two_slot] == 0)

        # And the same rule for text: a field that reported its own edit must
        # not be handed that edit back, because setText moves the caret.
        UiFlat::reset()
        UiControls::reset()
        field_root: UiHandles::Handle = UiHandles::column(UiHandles::root_parent(), 0.0, 0.0, grey(20))
        typed_field: UiHandles::Handle = UiHandles::text_field(field_root, "n", "p", "", 200.0, 30.0, 12.0, grey(230), grey(40))
        UiHandles::layout(320.0, 480.0)
        UiControls::realize_retained()
        UiControls::apply[RecordingControls]()
        typed_slot: usize = slot_for_widget(UiHandles::index(typed_field))
        _ = UiControls::dispatch_native_text(UiControls::native_handle_at(typed_slot), "Grace")
        _ = UiControls::retained_action(typed_slot.i32(), UiConst::WidgetEvent.Change.i32())
        log_text_writes[typed_slot] <- 0
        UiFlat::layout(320.0, 480.0)
        realize_reconciling()
        check("a field is not handed back its own edit", log_text_writes[typed_slot] == 0)
        check("and it still holds it", UiFlat::text_value(UiHandles::index(typed_field)).len == 5)

        # A COLOUR THAT CHANGED MUST REACH THE CONTROL. The showcase recolours
        # a validation message without touching its words, and a realization
        # that treats colour as decoration says "Email looks good." in red --
        # which is what it did, on a phone, before this assertion existed.
        UiFlat::reset()
        UiControls::reset()
        note_root: UiHandles::Handle = UiHandles::column(UiHandles::root_parent(), 0.0, 0.0, grey(20))
        status: UiHandles::Handle = UiHandles::label(note_root, "Checking", 12.0, grey(200))
        UiHandles::layout(320.0, 480.0)
        UiControls::realize_retained()
        UiControls::apply[RecordingControls]()
        status_slot: usize = slot_for_widget(UiHandles::index(status))

        # Same words, different colour.
        log_color_writes[status_slot] <- 0
        UiHandles::set_text(status, "Checking", 12.0, UiCore::rgba(40, 200, 90, 255))
        UiFlat::layout(320.0, 480.0)
        realize_reconciling()
        check("a recoloured label is told", log_color_writes[status_slot] == 1)
        check("and told the new colour", log_ink[status_slot] == 40)

        # Nothing changed at all: it is not told again.
        log_color_writes[status_slot] <- 0
        UiFlat::layout(320.0, 480.0)
        realize_reconciling()
        check("an unchanged colour is not rewritten", log_color_writes[status_slot] == 0)

        # ---- a password field is not a plain field --------------------------
        #
        # UiHandles::secure_text_field exists and the painted backends mask it.
        # The native backends carried no such fact at all, so the showcase's
        # password field was a plain UITextField and a plain EditText with the
        # characters in the clear. A screenshot would not have told you; the
        # platform's own view dump did -- password="false" on all three.
        UiFlat::reset()
        UiControls::reset()
        form: UiHandles::Handle = UiHandles::column(UiHandles::root_parent(), 0.0, 0.0, grey(20))
        plain: UiHandles::Handle = UiHandles::text_field(form, "Email", "you@example.org", "", 200.0, 30.0, 12.0, grey(230), grey(40))
        secret: UiHandles::Handle = UiHandles::secure_text_field(form, "Password", "at least 8", "", 200.0, 30.0, 12.0, grey(230), grey(40))
        UiHandles::set_enabled(plain, false)
        UiHandles::layout(320.0, 480.0)
        UiControls::realize_retained()
        UiControls::apply[RecordingControls]()
        plain_slot: usize = slot_for_widget(UiHandles::index(plain))
        secret_slot: usize = slot_for_widget(UiHandles::index(secret))
        check("a secure field crosses as secure", log_secure[secret_slot])
        check("an ordinary field does not", not log_secure[plain_slot])
        check("a disabled widget crosses as disabled", not log_enabled[plain_slot])
        check("an ordinary widget stays enabled", log_enabled[secret_slot])

        # A placeholder is the platform's own affordance; before this it was
        # dropped and every native field showed an empty hint.
        check("a field's placeholder crosses", log_prompt_len[secret_slot] == 10)
        check("and its help text crosses", log_help_len[secret_slot] >= 0)

        # Turning secure OFF is what a "show password" toggle does, and it has
        # to reach the control like any other state change.
        log_state_writes[secret_slot] <- 0
        UiHandles::set_secure(secret, false)
        UiFlat::layout(320.0, 480.0)
        realize_reconciling()
        check("clearing secure reaches the control", log_state_writes[secret_slot] == 1)
        check("and the control is no longer secure", not log_secure[secret_slot])

        if test_failures == 0:
            _ = puts("controls flat: all checks passed")
            return 0
        return 1
