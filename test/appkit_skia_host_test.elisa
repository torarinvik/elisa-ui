# AppKit/Skia compositor fixture. The host supplies a CoreGraphics context;
# Elisa supplies the retained commands and a borrowed Skia canvas/typeface.

include "../src/platform/skia/ui_skia.elisa"

global mutable appkit_skia_force_presentation_failure: bool = false

def appkit_skia_replay(window_handle: usize, canvas: usize, scale: f32, font: usize) -> i32 can[Ui.Draw, Ui.Text]:
    _ = window_handle
    UiCapabilities::use_appkit_canvas()
    UiCore::begin_frame()
    UiCore::clear(UiCore::rgb(18, 24, 32))
    UiCore::fill(UiCore::Rect(20.0, 20.0, 120.0, 60.0), UiCore::rgb(220, 80, 100))
    UiCore::fill(UiCore::Circle{center: UiCore::Vec2{x: 80.0, y: 130.0}, radius: 24.0}, UiCore::rgb(60, 180, 140))
    UiCore::fill(UiCore::Triangle{a: UiCore::Vec2{x: 190.0, y: 30.0}, b: UiCore::Vec2{x: 270.0, y: 30.0}, c: UiCore::Vec2{x: 230.0, y: 100.0}}, UiCore::rgb(70, 120, 220))
    UiCore::draw(UiCore::TextRun(UiCore::Vec2(20.0, 180.0), 18.0, "elisa-ui"), UiCore::rgb(240, 240, 245))
    UiSkia::attach_scaled(canvas, scale)
    status: UiSkia::RenderStatus = UiSkia::render_status_with_font(font)
    UiSkia::detach()
    # The native compositor uses a negative status to model a presentation
    # failure after this callback has already consumed app_frame. That lets a
    # host distinguish it from a pre-frame Skia rejection without replaying
    # application mutations through the CoreGraphics fallback.
    return -1 if appkit_skia_force_presentation_failure
    return status.i32()

export fn elisa_appkit_canvas_skia_replay(window_handle: usize, canvas: usize, scale: f32, font: usize) -> i32 = appkit_skia_replay

def set_appkit_skia_force_presentation_failure(value: i32) -> void:
    appkit_skia_force_presentation_failure <- value == 1

export fn elisa_appkit_skia_test_force_failure(value: i32) -> void = set_appkit_skia_force_presentation_failure
